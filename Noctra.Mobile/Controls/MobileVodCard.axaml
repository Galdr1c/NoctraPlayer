<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Controls.MobileVodCard"
             x:Name="VodCardControl"
             x:DataType="models:Channel"
             ClipToBounds="False"
             HorizontalAlignment="Stretch">
  <UserControl.Resources>
    <MenuFlyout x:Key="CardActionsFlyout">
      <MenuItem Header="{loc:Translate Context.MyList.Toggle}"
                Click="Context_AddToMyList_Click"
                IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
      <MenuItem Header="{loc:Translate MyList.Remove}"
                Click="Context_RemoveFromMyList_Click"
                IsVisible="{Binding #VodCardControl.ShowRemoveMyListMenu}">
        <MenuItem.Icon>
          <icons:MaterialIcon Kind="BookmarkRemoveOutline" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="{loc:Translate Context.Favorite.Toggle}"
                Click="Context_ToggleFavorite_Click"
                IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
      <MenuItem Header="{loc:Translate Context.Favorite.Toggle}"
                Click="Context_RemoveFromFavorites_Click"
                IsVisible="{Binding #VodCardControl.ShowRemoveFavoriteMenu}">
        <MenuItem.Icon>
          <icons:MaterialIcon Kind="HeartRemoveOutline" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="{loc:Translate History.Remove}"
                Click="Context_RemoveFromHistory_Click"
                IsVisible="{Binding #VodCardControl.ShowHistoryMenu}">
        <MenuItem.Icon>
          <icons:MaterialIcon Kind="DeleteOutline" />
        </MenuItem.Icon>
      </MenuItem>
    </MenuFlyout>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Touch feedback: pressed state dims the card and scales it down slightly -->
    <Style Selector="Border.CardContainer">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.CardContainer:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>

  </UserControl.Styles>

  <!-- CardContainer_Tapped executes SelectMediaCommand from the parent MainViewModel. -->
  <Border Classes="CardContainer"
          Background="Transparent"
          Tapped="CardContainer_Tapped">
    <Border.ContextFlyout>
      <StaticResource ResourceKey="CardActionsFlyout" />
    </Border.ContextFlyout>

    <Border Background="Transparent">
      <Grid>
        <Border Background="{DynamicResource SurfaceLightBrush}">
          <Border.IsVisible>
            <Binding Path="#PosterImage.IsImageLoaded" Converter="{StaticResource InverseBoolConverter}"/>
          </Border.IsVisible>
        </Border>
        <controls:RemoteImage x:Name="PosterImage"
                                    Url="{Binding CoverUrl}"
                                    Stretch="UniformToFill"
                                    RenderOptions.BitmapInterpolationMode="MediumQuality" />
        
        <!-- Bottom Section: Info + Progress -->
        <StackPanel VerticalAlignment="Bottom">
          <!-- Bottom Solid Overlay -->
          <Border Background="{DynamicResource PlayerBottomGradientBrush}" Padding="8">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Name}"
                         Foreground="{DynamicResource PlayerOverlayTextBrush}"
                         FontSize="{DynamicResource FCaption}"
                         FontWeight="Bold"
                         TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding ReleaseYear}"
                           Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                           FontSize="{DynamicResource FOverline}"
                           IsVisible="{Binding ReleaseYear, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Ellipse Width="3"
                         Height="3"
                         Fill="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                         VerticalAlignment="Center"
                         IsVisible="{Binding ReleaseYear, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding GroupTitle}"
                           Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                           FontSize="{DynamicResource FOverline}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </Border>

          <ProgressBar Height="5"
                       CornerRadius="0"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding WatchedPercentage}"
                       IsVisible="{Binding ., Converter={StaticResource WatchedProgressVisibilityConverter}}"
                       Foreground="{DynamicResource AccentBrush}"
                       Background="{DynamicResource OverlayHoverScrimBrush}"
                       BorderThickness="0" />
        </StackPanel>

        
      </Grid>
    </Border>
  </Border>
</UserControl>
