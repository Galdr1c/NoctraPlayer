<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Controls.MobileVodCard"
             x:Name="VodCardControl"
             x:DataType="models:Channel"
             MinHeight="220"
             ClipToBounds="False"
             HorizontalAlignment="Stretch">
  <UserControl.Resources>
    <MenuFlyout x:Key="CardActionsFlyout">
      <MenuItem Header="{loc:Translate Context.MyList.Toggle}"
                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AddToMyListCommand}"
                CommandParameter="{Binding}"
                IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
      <MenuItem Header="{loc:Translate MyList.Remove}"
                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveFromMyListCommand}"
                CommandParameter="{Binding}"
                IsVisible="{Binding #VodCardControl.ShowRemoveMyListMenu}">
        <MenuItem.Icon>
          <icons:MaterialIcon Kind="BookmarkRemoveOutline" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="{loc:Translate Context.Favorite.Toggle}"
                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                CommandParameter="{Binding}"
                IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
      <MenuItem Header="{loc:Translate Context.Favorite.Toggle}"
                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveFromFavoritesCommand}"
                CommandParameter="{Binding}"
                IsVisible="{Binding #VodCardControl.ShowRemoveFavoriteMenu}">
        <MenuItem.Icon>
          <icons:MaterialIcon Kind="HeartRemoveOutline" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="{loc:Translate History.Remove}"
                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveFromHistoryCommand}"
                CommandParameter="{Binding}"
                IsVisible="{Binding #VodCardControl.ShowHistoryMenu}">
        <MenuItem.Icon>
          <icons:MaterialIcon Kind="DeleteOutline" />
        </MenuItem.Icon>
      </MenuItem>
    </MenuFlyout>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Touch feedback: pressed state dims the card and scales it down slightly -->
    <Style Selector="Border.CardContainer">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.CardContainer:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
  </UserControl.Styles>

  <!-- CardContainer_Tapped executes SelectMediaCommand from the parent MainViewModel. -->
  <Border Classes="CardContainer"
          Background="Transparent"
          Tapped="CardContainer_Tapped">
    <Border.ContextFlyout>
      <StaticResource ResourceKey="CardActionsFlyout" />
    </Border.ContextFlyout>

    <Border CornerRadius="{DynamicResource RadiusSmall}"
            ClipToBounds="True"
            Background="{DynamicResource Surface0Brush}"
            BoxShadow="{DynamicResource CardShadow}">
      <Grid>
        <Border Background="{DynamicResource SurfaceLightBrush}">
          <Grid>
            <icons:MaterialIcon Kind="Movie"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Width="48"
                                Height="48"
                                Opacity="0.32" />
            <controls:RemoteImage Url="{Binding CoverUrl}"
                                        Stretch="UniformToFill"
                                        RenderOptions.BitmapInterpolationMode="MediumQuality" />
          </Grid>
        </Border>

        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="6"
                MinWidth="44"
                MinHeight="44"
                Padding="0"
                Background="{DynamicResource OverlayButtonScrimBrush}"
                BorderThickness="0"
                CornerRadius="22"
                Flyout="{StaticResource CardActionsFlyout}">
          <icons:MaterialIcon Kind="DotsVertical" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
        </Button>

        <StackPanel VerticalAlignment="Bottom">
          <Border Background="{DynamicResource OverlayScrimBrush}" Padding="10,8">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Name}"
                         Foreground="{DynamicResource PlayerOverlayTextBrush}"
                         FontSize="12"
                         FontWeight="Bold"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding ReleaseYear}"
                           Foreground="#A6FFFFFF"
                           FontSize="10"
                           IsVisible="{Binding ReleaseYear, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Ellipse Width="3"
                         Height="3"
                         Fill="#66FFFFFF"
                         VerticalAlignment="Center"
                         IsVisible="{Binding ReleaseYear, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding GroupTitle}"
                           Foreground="#A6FFFFFF"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </Border>

          <ProgressBar Height="5"
                       CornerRadius="0"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding WatchedPercentage}"
                       IsVisible="{Binding ., Converter={StaticResource WatchedProgressVisibilityConverter}}"
                       Foreground="{DynamicResource AccentBrush}"
                       Background="{DynamicResource OverlayHoverScrimBrush}"
                       BorderThickness="0" />
        </StackPanel>
      </Grid>
    </Border>
  </Border>
</UserControl>
