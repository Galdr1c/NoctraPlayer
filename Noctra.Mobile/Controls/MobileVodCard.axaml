<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Controls.MobileVodCard"
             x:Name="VodCardControl"
             x:DataType="models:Channel"
             ClipToBounds="False"
             HorizontalAlignment="Stretch">
  <UserControl.Styles>
    <!-- Touch feedback: pressed state dims the card and scales it down slightly -->
    <Style Selector="controls|MobilePressableCard.CardContainer">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="controls|MobilePressableCard.CardContainer:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>

  </UserControl.Styles>

  <!-- CardContainer_Tapped executes SelectMediaCommand from the parent MainViewModel. -->
  <controls:MobilePressableCard Classes="CardContainer"
                                Background="Transparent"
                                LongPressed="CardContainer_LongPressed"
                                Tapped="CardContainer_Tapped">
    <Border Background="Transparent"
            ClipToBounds="True">
      <Grid>
        <Border Background="{DynamicResource SurfaceLightBrush}">
          <Border.IsVisible>
            <Binding Path="#PosterImage.IsImageLoaded" Converter="{StaticResource InverseBoolConverter}"/>
          </Border.IsVisible>
        </Border>
        <controls:RemoteImage x:Name="PosterImage"
                              Url="{Binding CoverUrl}"
                              Stretch="UniformToFill"
                              RenderOptions.BitmapInterpolationMode="MediumQuality" />
        
        <!-- Bottom Section: Info + Progress -->
        <StackPanel VerticalAlignment="Bottom">
          <!-- Bottom Solid Overlay -->
          <Border Background="{DynamicResource PlayerBottomGradientBrush}" Padding="8">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Name}"
                         Foreground="{DynamicResource PlayerOverlayTextBrush}"
                         FontSize="{DynamicResource FCaption}"
                         FontWeight="Bold"
                         TextTrimming="CharacterEllipsis"/>
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding GroupTitle}"
                           Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                           FontSize="{DynamicResource FOverline}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </Border>

          <ProgressBar Height="4"
                       HorizontalAlignment="Stretch"
                       ClipToBounds="True"
                       CornerRadius="0"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding WatchedPercentage}"
                       Foreground="{DynamicResource AccentBrush}"
                       Background="{DynamicResource ThemePreviewDarkText}"
                       BorderThickness="0">
            <ProgressBar.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="#VodCardControl.ShowHistoryMenu" />
                <Binding Path="." Converter="{StaticResource WatchedProgressVisibilityConverter}" />
              </MultiBinding>
            </ProgressBar.IsVisible>
          </ProgressBar>
        </StackPanel>

        
      </Grid>
    </Border>
  </controls:MobilePressableCard>
</UserControl>
