<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Controls.MobileSeriesCard"
             x:Name="SeriesCardControl"
             x:DataType="models:Series"
             ClipToBounds="False"
             HorizontalAlignment="Stretch">
  <UserControl.Styles>
    <!-- Touch feedback: pressed state dims the card and scales it down slightly -->
    <Style Selector="controls|MobilePressableCard.CardContainer">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="controls|MobilePressableCard.CardContainer:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
  </UserControl.Styles>

  <!-- CardContainer_Tapped executes SelectMediaCommand from the parent MainViewModel. -->
  <controls:MobilePressableCard Classes="CardContainer"
                                Background="Transparent"
                                LongPressed="CardContainer_LongPressed"
                                Tapped="CardContainer_Tapped">
    <Border Background="Transparent">
      <Grid>
        <Border Background="{DynamicResource SurfaceLightBrush}">
          <Border.IsVisible>
            <Binding Path="#SeriesPoster.IsImageLoaded" Converter="{StaticResource InverseBoolConverter}"/>
          </Border.IsVisible>
        </Border>
        <controls:RemoteImage x:Name="SeriesPoster"
                              Url="{Binding CoverUrl}"
                              Stretch="UniformToFill"
                              RenderOptions.BitmapInterpolationMode="MediumQuality" />

        <Border VerticalAlignment="Bottom" Background="{DynamicResource OverlayScrimBrush}" Padding="8">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Name}"
                       Foreground="{DynamicResource PlayerOverlayTextBrush}"
                       FontSize="{DynamicResource FCaption}"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1" />
            <TextBlock Text="{Binding DisplayCategory}"
                       Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                       FontSize="{DynamicResource FOverline}"
                       TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding DisplayCategory, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </controls:MobilePressableCard>
</UserControl>
