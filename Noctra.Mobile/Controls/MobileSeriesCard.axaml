<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Controls.MobileSeriesCard"
             x:Name="SeriesCardControl"
             x:DataType="models:Series"
             MinHeight="220"
             ClipToBounds="False"
             HorizontalAlignment="Stretch">
  <UserControl.Resources>
    <MenuFlyout x:Key="CardActionsFlyout">
      <MenuItem Header="{loc:Translate Context.MyList.Toggle}"
                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AddToMyListCommand}"
                CommandParameter="{Binding}"
                IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
      <MenuItem Header="{loc:Translate Context.Favorite.Toggle}"
                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                CommandParameter="{Binding}"
                IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
    </MenuFlyout>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.CardContainer:pointerover">
      <Setter Property="ZIndex" Value="10" />
      <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="Button.CardContainer:pointerover Border.HoverOverlay">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.HoverOverlay">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </UserControl.Styles>

  <Button Classes="CardContainer"
          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
          CommandParameter="{Binding}"
          Background="Transparent"
          BorderThickness="0"
          Padding="0"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch">
    <Button.Transitions>
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Button.Transitions>
    <Button.ContextFlyout>
      <StaticResource ResourceKey="CardActionsFlyout" />
    </Button.ContextFlyout>

    <Border CornerRadius="{DynamicResource RadiusSmall}"
            ClipToBounds="True"
            Background="{DynamicResource Surface0Brush}"
            BoxShadow="{DynamicResource CardShadow}">
      <Grid>
        <Border Background="{DynamicResource SurfaceLightBrush}">
          <Grid>
            <icons:MaterialIcon Kind="TelevisionPlay"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Width="48"
                                Height="48"
                                Opacity="0.32" />
            <controls:RemoteImage Url="{Binding CoverUrl}"
                                        Stretch="UniformToFill"
                                        RenderOptions.BitmapInterpolationMode="MediumQuality" />
          </Grid>
        </Border>

        <Border Classes="HoverOverlay" Background="#4D000000" IsHitTestVisible="False" />

        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="6"
                MinWidth="44"
                MinHeight="44"
                Padding="0"
                Background="#99000000"
                BorderThickness="0"
                CornerRadius="22"
                Flyout="{StaticResource CardActionsFlyout}">
          <icons:MaterialIcon Kind="DotsVertical" Width="20" Height="20" Foreground="White" />
        </Button>

        <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="10,8">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Name}"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1" />
            <TextBlock Text="{Binding DisplayCategory}"
                       Foreground="#A6FFFFFF"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Button>
</UserControl>
