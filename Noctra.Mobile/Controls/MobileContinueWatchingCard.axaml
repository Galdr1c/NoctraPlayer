<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Controls.MobileContinueWatchingCard"
             x:DataType="models:Channel"
             MinHeight="120"
             ClipToBounds="False"
             HorizontalAlignment="Stretch">
  <UserControl.Resources>
    <MenuFlyout x:Key="CardActionsFlyout">
      <MenuItem Header="{loc:Translate Context.MyList.Toggle}"
                Click="Context_AddToMyList_Click"
                IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
      <MenuItem Header="{loc:Translate Context.Favorite.Toggle}"
                Click="Context_ToggleFavorite_Click"
                IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
    </MenuFlyout>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Touch feedback: pressed state dims the card and scales it down slightly -->
    <Style Selector="controls|MobilePressableCard.CardContainer">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="controls|MobilePressableCard.CardContainer:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
  </UserControl.Styles>

  <!-- CardContainer_Tapped executes SelectMediaCommand from the parent MainViewModel. -->
  <controls:MobilePressableCard Classes="CardContainer"
                                Background="Transparent"
                                Tapped="CardContainer_Tapped">
    <controls:MobilePressableCard.ContextFlyout>
      <StaticResource ResourceKey="CardActionsFlyout" />
    </controls:MobilePressableCard.ContextFlyout>

    <Border CornerRadius="0"
            ClipToBounds="True"
            Background="{DynamicResource Surface0Brush}"
            BoxShadow="{DynamicResource CardShadow}">
      <Grid>
        <Border x:Name="PlaceholderBorder" Background="{DynamicResource SurfaceLightBrush}">
          <Border.IsVisible>
            <Binding Path="#BackdropImage.IsImageLoaded" Converter="{StaticResource InverseBoolConverter}" />
          </Border.IsVisible>
        </Border>

        <controls:RemoteImage x:Name="BackdropImage"
                              Url="{Binding CoverUrl}"
                              Stretch="UniformToFill"
                              RenderOptions.BitmapInterpolationMode="MediumQuality" />

        <StackPanel VerticalAlignment="Bottom" Spacing="0">
          <Border Padding="10,20,10,10"
                  Background="{DynamicResource PlayerBottomGradientBrush}">
            <StackPanel Spacing="1">
              <TextBlock Text="{Binding Name}"
                         Foreground="{DynamicResource PlayerOverlayTextBrush}"
                         FontSize="{DynamicResource FCaption}"
                         FontWeight="Bold"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1" />
              <TextBlock Text="{Binding GroupTitle}"
                         Foreground="#A6FFFFFF"
                         FontSize="{DynamicResource FOverline}"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1"
                         Opacity="0.8" />
            </StackPanel>
          </Border>
          <ProgressBar Height="4"
                       CornerRadius="0"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding WatchedPercentage}"
                       Foreground="{DynamicResource AccentBrush}"
                       Background="{DynamicResource ThemePreviewDarkText}"
                       BorderThickness="0"
                       IsVisible="{Binding ., Converter={StaticResource WatchedProgressVisibilityConverter}}" />
        </StackPanel>
      </Grid>
    </Border>
  </controls:MobilePressableCard>
</UserControl>
