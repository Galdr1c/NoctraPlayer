<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Controls.MobileContinueWatchingCard"
             x:DataType="models:Channel"
             MinHeight="120"
             ClipToBounds="False"
             HorizontalAlignment="Stretch">
  <UserControl.Resources>
    <MenuFlyout x:Key="CardActionsFlyout">
      <MenuItem Header="{loc:Translate Context.MyList.Toggle}"
                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AddToMyListCommand}"
                CommandParameter="{Binding}"
                IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
      <MenuItem Header="{loc:Translate Context.Favorite.Toggle}"
                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                CommandParameter="{Binding}"
                IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
    </MenuFlyout>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.CardContainer:pointerover">
      <Setter Property="ZIndex" Value="10" />
      <Setter Property="RenderTransform" Value="scale(1.02)" />
    </Style>
    <Style Selector="Button.CardContainer:pointerover Border.HoverOverlay">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.HoverOverlay">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.CardContainer:pointerover icons|MaterialIcon.PlayIcon">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
  </UserControl.Styles>

  <Button Classes="CardContainer"
          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
          CommandParameter="{Binding}"
          Background="Transparent"
          BorderThickness="0"
          Padding="0"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch">
    <Button.Transitions>
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Button.Transitions>
    <Button.ContextFlyout>
      <StaticResource ResourceKey="CardActionsFlyout" />
    </Button.ContextFlyout>

    <Border CornerRadius="{DynamicResource RadiusSmall}"
            ClipToBounds="True"
            Background="{DynamicResource Surface0Brush}"
            BoxShadow="{DynamicResource CardShadow}">
      <Grid>
        <Border x:Name="PlaceholderBorder" Background="{DynamicResource SurfaceLightBrush}">
          <Border.IsVisible>
            <Binding Path="#BackdropImage.IsImageLoaded" Converter="{StaticResource InverseBoolConverter}" />
          </Border.IsVisible>
          <icons:MaterialIcon Kind="MoviePlay"
                              Foreground="{DynamicResource TextMutedBrush}"
                              Width="34"
                              Height="34"
                              Opacity="0.32"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
        </Border>

        <controls:RemoteImage x:Name="BackdropImage"
                              Url="{Binding CoverUrl}"
                              Stretch="UniformToFill"
                              RenderOptions.BitmapInterpolationMode="MediumQuality" />

        <Border Classes="HoverOverlay" Background="#80000000" IsHitTestVisible="False">
          <icons:MaterialIcon Kind="PlayCircle"
                              Classes="PlayIcon"
                              Width="40"
                              Height="40"
                              Foreground="White"
                              Opacity="0"
                              RenderTransform="scale(0.8)" />
        </Border>

        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="6"
                MinWidth="44"
                MinHeight="44"
                Padding="0"
                Background="#99000000"
                BorderThickness="0"
                CornerRadius="22"
                Flyout="{StaticResource CardActionsFlyout}">
          <icons:MaterialIcon Kind="DotsVertical" Width="20" Height="20" Foreground="White" />
        </Button>

        <StackPanel VerticalAlignment="Bottom" Spacing="0">
          <Border Padding="10,20,10,10">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                <GradientStop Offset="0" Color="#CC000000" />
                <GradientStop Offset="1" Color="#00000000" />
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel Spacing="1">
              <TextBlock Text="{Binding Name}"
                         Foreground="White"
                         FontSize="13"
                         FontWeight="Bold"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1" />
              <TextBlock Text="{Binding GroupTitle}"
                         Foreground="#A6FFFFFF"
                         FontSize="10"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1"
                         Opacity="0.8" />
            </StackPanel>
          </Border>
          <ProgressBar Height="4"
                       CornerRadius="0"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding WatchedPercentage}"
                       Foreground="{DynamicResource AccentBrush}"
                       Background="#4D000000"
                       BorderThickness="0"
                       IsVisible="{Binding ., Converter={StaticResource WatchedProgressVisibilityConverter}}" />
        </StackPanel>
      </Grid>
    </Border>
  </Button>
</UserControl>
