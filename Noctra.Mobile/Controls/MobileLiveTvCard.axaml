<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Controls.MobileLiveTvCard"
             x:Name="LiveTvCardControl"
             x:DataType="models:Channel"
             HorizontalAlignment="Stretch"
             ClipToBounds="False">
  <UserControl.Styles>
    <!-- Touch feedback: the card responds while preserving vertical scrolling. -->
    <Style Selector="controls|MobilePressableCard.CardContainer">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="controls|MobilePressableCard.CardContainer:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Border.CardSurface">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style Selector="Button.FavoriteBtn">
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.FavoriteBtn:pressed">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>
    <Style Selector="Button.FavoriteBtn:pressed /template/ ContentPresenter">
      <!-- Do not let FluentTheme paint a grey pressed surface over the heart. -->
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.FavoriteBtn.active">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <!-- CardContainer_Tapped executes SelectMediaCommand from the parent MainViewModel. -->
  <controls:MobilePressableCard Classes="CardContainer"
                                Background="Transparent"
                                LongPressed="CardContainer_LongPressed"
                                Tapped="CardContainer_Tapped">
    <Border Classes="CardSurface" >
      <Grid RowDefinitions="Auto,Auto,Auto"
            RowSpacing="4">
        <Grid Grid.Row="0"
              ColumnDefinitions="42,*,Auto"
              ColumnSpacing="8">
          <Border Width="36"
                  Height="36"
                  Background="{DynamicResource PlaceHolderBrush}"
                  IsHitTestVisible="False">
            <Grid>
              <Border Background="{DynamicResource SurfaceLightBrush}" 
                      CornerRadius="0">
                <Border.IsVisible>
                  <Binding Path="#ChannelLogo.IsImageLoaded" Converter="{StaticResource InverseBoolConverter}"/>
                </Border.IsVisible>
              </Border>
              <controls:RemoteImage x:Name="ChannelLogo"
                                    Url="{Binding CoverUrl}"
                                    Width="36" Height="36"
                                    Stretch="Uniform"
                                    RenderOptions.BitmapInterpolationMode="MediumQuality" />
            </Grid>
          </Border>
          <!-- Content -->
          <StackPanel Grid.Column="1"
                      Spacing="3"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="{DynamicResource FBody}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="2" />
            <TextBlock Text="{Binding GroupTitle}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="{DynamicResource FOverline}"
                       TextTrimming="CharacterEllipsis" Opacity="0.8" />
          </StackPanel>
          
          <!-- Favorite -->
          <Button Grid.Column="2"
                  Classes="FavoriteBtn"
                  Classes.active="{Binding IsFavorite}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="6"
                  VerticalAlignment="Center"
                  Tapped="FavoriteBtn_Tapped"
                  IsVisible="{Binding #LiveTvCardControl.ShowFavoriteMenu}">
            <Grid>
              <icons:MaterialIcon Kind="Heart"
                                  Width="20"
                                  Height="20"
                                  Foreground="#E50914"
                                  IsVisible="{Binding IsFavorite}" />
              <icons:MaterialIcon Kind="HeartOutline"
                                  Width="20"
                                  Height="20"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  IsVisible="{Binding !IsFavorite}" />
            </Grid>
          </Button>

        </Grid>

        <!-- EPG Title Section -->

        <TextBlock Grid.Row="1"
                   Text="{Binding CurrentProgramTitle}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="{DynamicResource FCaption}"
                   FontWeight="Medium"
                   TextTrimming="CharacterEllipsis"
                   Opacity="0.85"
                   Margin="0,2,0,0"
                   IsVisible="{Binding CurrentProgramTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

        <ProgressBar Grid.Row="2"
                     ClipToBounds="True"
                     Value="{Binding EpgProgress}"
                     Minimum="0"
                     Maximum="100"
                     Height="5"
                     Background="{DynamicResource SurfaceLightBrush}"
                     Foreground="{DynamicResource AccentBrush}"
                     BorderThickness="0"
                     CornerRadius="1.5"
                     IsVisible="{Binding CurrentProgramTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
      </Grid>
    </Border>
  </controls:MobilePressableCard>
</UserControl>
