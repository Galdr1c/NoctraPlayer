<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Bg0Color">#0A0A0A</Color>
  <Color x:Key="Bg1Color">#121212</Color>
  <Color x:Key="Surface0Color">#1A1A1A</Color>
  <Color x:Key="Surface1Color">#242424</Color>
  <Color x:Key="BorderColor">#333333</Color>

  <Color x:Key="Accent300Color">#B7A6F6</Color>
  <Color x:Key="Accent500Color">#8B5CF6</Color>
  <Color x:Key="Accent600Color">#7C3AED</Color>
  <Color x:Key="Accent700Color">#6D28D9</Color>
  <Color x:Key="GlowColor">#8B5CF6</Color>

  <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
  <Color x:Key="TextSecondaryColor">#E5E5E5</Color>
  <Color x:Key="TextMutedColor">#A7A7CC</Color>
  <Color x:Key="TextDisabledColor">#666680</Color>

  <Color x:Key="SuccessColor">#46D369</Color>
  <Color x:Key="WarningColor">#FFA00A</Color>
  <Color x:Key="ErrorColor">#E50914</Color>
  <Color x:Key="InfoColor">#936AF5</Color>
  <Color x:Key="LiveRedColor">#E50914</Color>

  <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0Color}" />
  <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1Color}" />
  <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0Color}" />
  <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent500Color}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Accent600Color}" />
  <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource Accent300Color}" />
  <SolidColorBrush x:Key="GlowBrush" Color="{StaticResource GlowColor}" />
  <SolidColorBrush x:Key="TextSelectionBrush" Color="#997C3AED" />
  <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#268B5CF6" />
  <SolidColorBrush x:Key="PlaceHolderBrush" Color="#2A2A2A" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource SuccessColor}" Opacity="0.15" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
  <SolidColorBrush x:Key="LiveRedBrush" Color="{StaticResource LiveRedColor}" />

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Bg0Color}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface0Color}" />
  <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource Surface1Color}" />
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource Surface0Color}" />
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource Surface1Color}" />
  <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="InteractiveHoverBrush" Color="#2A2A2A" />
  <SolidColorBrush x:Key="InteractivePressedBrush" Color="#333333" />
  <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#444444" Opacity="0.6" />
  <SolidColorBrush x:Key="ScrollBarHoverBrush" Color="{StaticResource Accent300Color}" />
  <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#8B5CF6" />

  <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#8B5CF6" Offset="0.0" />
    <GradientStop Color="#6D28D9" Offset="1.0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="IconGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#2A2640" Offset="0.0" />
    <GradientStop Color="#1E1636" Offset="1.0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#141414" Offset="0.0" />
    <GradientStop Color="#1A1A1A" Offset="0.4" />
    <GradientStop Color="#0A0A0A" Offset="0.7" />
    <GradientStop Color="#050505" Offset="1.0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#141414" Offset="0.0" />
    <GradientStop Color="#1A1A1A" Offset="1.0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CardHoverGradientBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#2A2640" Offset="0.0" />
    <GradientStop Color="#363252" Offset="1.0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PremiumCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource Surface0Color}" Offset="0.0" />
    <GradientStop Color="#1E1636" Offset="1.0" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="PremiumCardForegroundBrush" Color="White" />

  <!-- Premium Badge - Base -->
  <LinearGradientBrush x:Key="PremiumBadgeBrush"
                      StartPoint="0%,0%"
                      EndPoint="100%,100%">
      <GradientStop Color="#F5D0FE" Offset="0.00" />
      <GradientStop Color="#C084FC" Offset="0.16" />
      <GradientStop Color="#9333EA" Offset="0.38" />
      <GradientStop Color="#7C3AED" Offset="0.62" />
      <GradientStop Color="#4C1D95" Offset="0.84" />
      <GradientStop Color="#1E103F" Offset="1.00" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="PremiumBadgeTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="PremiumBadgeMutedTextBrush" Color="#F3E8FF" />
  <SolidColorBrush x:Key="PremiumBadgeGlowBrush" Color="#A855F7" />


  <!-- Overlay brushes for semi-transparent panels -->
  <SolidColorBrush x:Key="OverlayDarkBrush" Color="#CC090B10" />
  <SolidColorBrush x:Key="OverlayDimBrush" Color="#AA000000" />
  <SolidColorBrush x:Key="OverlayModalDimBrush" Color="#E6000000" />
  <SolidColorBrush x:Key="OverlayScrimBrush" Color="#CC000000" />
  <SolidColorBrush x:Key="OverlayHoverScrimBrush" Color="#4D000000" />
  <SolidColorBrush x:Key="OverlayButtonScrimBrush" Color="#99000000" />
  <SolidColorBrush x:Key="OverlayPanelBrush" Color="#E60A0A0A" />
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="#1AE50914" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ErrorColor}" />

  <!-- Player overlays intentionally stay dark in every app theme for video readability. -->
  <SolidColorBrush x:Key="PlayerSurfaceBrush" Color="#000000" />
  <SolidColorBrush x:Key="PlayerOverlayPanelBrush" Color="#E60A0A0A" />
  <SolidColorBrush x:Key="PlayerOverlaySheetBrush" Color="#F20A0A0A" />
  <SolidColorBrush x:Key="PlayerOverlayButtonBrush" Color="#99000000" />
  <SolidColorBrush x:Key="PlayerOverlayStrongBrush" Color="#E6000000" />
  <SolidColorBrush x:Key="PlayerOverlayShieldBrush" Color="#B3000000" />
  <SolidColorBrush x:Key="PlayerOverlayTextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="PlayerOverlaySecondaryTextBrush" Color="#CCFFFFFF" />
  <SolidColorBrush x:Key="PlayerOverlayBorderBrush" Color="#40FFFFFF" />
  <LinearGradientBrush x:Key="PlayerTopGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="#CC000000" Offset="0" />
    <GradientStop Color="#00000000" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PlayerBottomGradientBrush" StartPoint="0%,100%" EndPoint="0%,0%">
    <GradientStop Color="#D9000000" Offset="0" />
    <GradientStop Color="#00000000" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemePreviewDarkBg" Color="#141414" />
  <SolidColorBrush x:Key="ThemePreviewDarkInnerBg" Color="#1A1A1A" />
  <SolidColorBrush x:Key="ThemePreviewDarkText" Color="#404040" />
  <SolidColorBrush x:Key="ThemePreviewLightBg" Color="#F5F5F5" />
  <SolidColorBrush x:Key="ThemePreviewLightInnerBg" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemePreviewLightText" Color="#CCCCCC" />
  <SolidColorBrush x:Key="ThemePreviewDarkLabelBrush" Color="White" />
  <SolidColorBrush x:Key="ThemePreviewLightLabelBrush" Color="#666666" />

  <BoxShadows x:Key="DefaultShadow">0 2 10 0 #30000000</BoxShadows>
  <BoxShadows x:Key="CardShadow">0 4 20 0 #40000000</BoxShadows>
  <BoxShadows x:Key="FocusGlow">0 0 8 0 #308B5CF6</BoxShadows>
  <BoxShadows x:Key="OverlaySheetShadow">0 -10 35 0 #80000000</BoxShadows>

  <x:Double x:Key="FontSizeH1">32</x:Double>
  <x:Double x:Key="FontSizeH2">24</x:Double>
  <x:Double x:Key="FontSizeH3">20</x:Double>
  <x:Double x:Key="FontSizeBody">14</x:Double>
  <x:Double x:Key="FontSizeBodyLarge">16</x:Double>
  <x:Double x:Key="FontSizeCaption">12</x:Double>
  <x:Double x:Key="FontSizeSmall">11</x:Double>

  <Thickness x:Key="PagePadding">16</Thickness>
  <Thickness x:Key="SectionPadding">16</Thickness>
  <Thickness x:Key="CardPadding">12</Thickness>
  <Thickness x:Key="ItemPadding">8</Thickness>
  <Thickness x:Key="SmallPadding">6</Thickness>
  <x:Double x:Key="CardGap">12</x:Double>

  <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
  <CornerRadius x:Key="RadiusXLarge">24</CornerRadius>
  <CornerRadius x:Key="RadiusPill">100</CornerRadius>
</ResourceDictionary>
