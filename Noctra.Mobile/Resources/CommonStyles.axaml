<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

  <!-- Shared mobile design language. Keep selector/class styles here; resource ControlThemes stay in Styles.axaml. -->

  <Style Selector="Border.NoctraCard">
    <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="BoxShadow" Value="{DynamicResource DefaultShadow}" />
  </Style>

  <Style Selector="Border.PosterCard">
    <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.PosterCard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Border.EmptyState">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
  </Style>

  <Style Selector="Border.Badge">
    <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <Style Selector="Border.AccentBadge">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <Style Selector="Border.BottomSheetPanel">
    <Setter Property="Background" Value="#E60A0A0A" />
    <Setter Property="BorderBrush" Value="#26FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="0 -8 32 0 #80000000" />
  </Style>

  <Style Selector="StackPanel.NoctraSectionHeader">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="8" />
  </Style>

  <Style Selector="TextBlock.NoctraSectionTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.NoctraPageTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="Button.ShellNavItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="MinHeight" Value="52" />
  </Style>
  <Style Selector="Button.ShellNavItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}" />
  </Style>

  <Style Selector="Border.NavPill">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Border.NavPill.active">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>

  <Style Selector="ProgressBar.NoctraProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="materialIcons|MaterialIcon.NavIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.NavLabel">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
</Styles>
