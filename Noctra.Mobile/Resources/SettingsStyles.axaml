<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        
  <Style Selector="Border.SettingsSectionCard">
    <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="{DynamicResource DefaultShadow}" />
  </Style>

  <Style Selector="Border.SettingsStatusBadge">
    <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <Style Selector="Button.SettingsActionButton">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.SettingsActionButton:pressed">
    <Setter Property="Background" Value="{DynamicResource InteractivePressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.SettingsPrimaryActionButton">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.SettingsPrimaryActionButton:pressed">
    <Setter Property="Opacity" Value="0.82" />
  </Style>

  <Style Selector="Button.SettingsDangerActionButton">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.SettingsDangerActionButton:pressed /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.UpgradeButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PremiumBadgeBrush}" />
  </Style>
</Styles>
