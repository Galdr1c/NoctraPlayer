<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:loc="using:Noctra.Mobile.Localization"
             x:Class="Noctra.Mobile.Views.AvatarPickerView"
             x:Name="AvatarPickerRoot"
             x:DataType="vm:AvatarPickerViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="500">
  <Border Background="#151923"
          CornerRadius="18"
          Padding="18">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Text="{loc:Translate AvatarPicker.SelectProfilePicture}"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="#FFFFFF" />

      <ScrollViewer Grid.Row="1" Margin="0,16">
        <ItemsControl ItemsSource="{Binding Avatars}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding #AvatarPickerRoot.DataContext.SelectAvatarCommand}"
                      CommandParameter="{Binding}"
                      Width="72"
                      Height="72"
                      Margin="6"
                      Padding="0"
                      Background="#252B3D"
                      BorderThickness="0"
                      CornerRadius="14">
                <Image Source="{Binding Converter={StaticResource AvatarPathConverter}}"
                       Stretch="UniformToFill" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Grid.Row="2"
                 Text="{loc:Translate AvatarPicker.Hint}"
                 Foreground="#AEB5C5"
                 TextWrapping="Wrap" />
    </Grid>
  </Border>
</UserControl>
