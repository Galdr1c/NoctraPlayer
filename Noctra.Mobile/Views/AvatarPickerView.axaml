<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.AvatarPickerView"
             x:Name="AvatarPickerRoot"
             x:DataType="vm:AvatarPickerViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d">
  <UserControl.Styles>
    <Style Selector="Button.AvatarItemBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="8" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Touch feedback: scale down + dim on press -->
    <Style Selector="Button.AvatarItemBtn:pressed">
      <Setter Property="RenderTransform" Value="scale(0.93)" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" RowSpacing="20"
        Background="Transparent"
        Margin="24">
      <!-- Header: matches desktop avatar picker typography, adapted for mobile -->
      <StackPanel Spacing="6">
        <TextBlock Text="{loc:Translate AvatarPicker.SelectProfilePicture}"
                   FontSize="{DynamicResource FHeadline}"
                   FontWeight="Bold"
                   LetterSpacing="1"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{loc:Translate AvatarPicker.Hint}"
                   FontSize="{DynamicResource FCaption}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Avatar Grid -->
      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Avatars}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="AvatarItemBtn"
                      Command="{Binding #AvatarPickerRoot.DataContext.SelectAvatarCommand}"
                      CommandParameter="{Binding}"
                      Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=avatarTile}"
                      Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=avatarTile}">
                <Border BorderBrush="Transparent"
                        BorderThickness="2"
                        Background="Transparent"
                        ClipToBounds="False">
                  <Image Source="{Binding Converter={StaticResource AvatarPathConverter}}"
                         Stretch="Uniform"
                         RenderOptions.BitmapInterpolationMode="HighQuality" />
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
</UserControl>
