<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:views="using:Noctra.Mobile.Views"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.ProfileSetupView"
             x:DataType="vm:AddProfileViewModel"
             x:CompileBindings="True"
             mc:Ignorable="d">

  <UserControl.Styles>

    <!-- TextBox uses NoctraTextBox ControlTheme from Styles.axaml.
         No local overrides needed — all visual props are in the unified theme. -->

    <!-- Bölüm kart stili -->
    <Style Selector="Border.Section">
      <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Satır ayırıcı -->
    <Style Selector="Border.Divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Margin" Value="16,0" />
    </Style>

    <!-- Bölüm satırı dokunma hedefi -->
    <Style Selector="Button.SectionRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.SectionRow:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Header aksiyon butonu (İptal / Kaydet) — 48dp dokunma alanı -->
    <Style Selector="Button.HeaderAction">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,12" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.HeaderAction:pressed">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    </Style>

    <!-- Avatar düzenleme butonu -->
    <Style Selector="Button.AvatarBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.AvatarBtn:pressed">
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- Kalem simgesi stili -->
    <Style Selector="Border.EditIcon">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    </Style>

    <!-- Etiket metin stili -->
    <Style Selector="TextBlock.FieldLabel">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Margin" Value="4,0,0,6" />
    </Style>

  </UserControl.Styles>

  <!--
    ┌─────────────────────────────────────────────────────────────┐
    │  Satır 0 : Netflix-tarzı 3-parça header                     │
    │            [← İptal]  [Profil Ekle / Düzenle]  [Kaydet]   │
    │  Satır 1 : Kaydırılabilir form içeriği                      │
    │  Satır 2 : Durum mesajı (klavye açıkken bile görünür)       │
    │  Satır * : Avatar seçici overlay                            │
    └─────────────────────────────────────────────────────────────┘
  -->
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ════════════════════════════════════════════════════════
         HEADER — İptal | Başlık | Kaydet
         ════════════════════════════════════════════════════════ -->
    <Border Grid.Row="0"
            Padding="8,8,8,8"
            Background="{DynamicResource Bg0Brush}">
      <Grid ColumnDefinitions="1*,Auto,1*">

        <!-- Sol: İptal (← ok) — 48dp dokunma alanı -->
        <Button Grid.Column="0"
                Classes="HeaderAction"
                Command="{Binding CancelCommand}"
                HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <icons:MaterialIcon Kind="ChevronLeft" Width="20" Height="20"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                VerticalAlignment="Center" />
            <TextBlock Text="{loc:Translate Profiles.Add.Cancel}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Orta: Başlık — gerçek merkezde, negatif margin yok -->
        <TextBlock Grid.Column="1"
                   FontSize="{DynamicResource FTitleM}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
          <TextBlock.Styles>
            <Style Selector="TextBlock">
              <Setter Property="Text" Value="{loc:Translate Profiles.Add.Title}" />
            </Style>
          </TextBlock.Styles>
        </TextBlock>

        <!-- Sağ: Kaydet (mavi/accent ile vurgulu) — 48dp dokunma alanı -->
        <Button Grid.Column="2"
                Classes="HeaderAction"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding !IsSaving}"
                HorizontalAlignment="Right">
          <Panel>
            <!-- Saving spinner -->
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        IsVisible="{Binding IsSaving}">
              <ProgressBar IsIndeterminate="True"
                           Width="14" Height="14"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{loc:Translate Profiles.Add.Save}"
                         Foreground="{DynamicResource AccentBrush}"
                         FontWeight="SemiBold"
                         FontSize="{DynamicResource FTitleM}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <!-- Normal label -->
            <TextBlock Text="{loc:Translate Profiles.Add.Save}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource FTitleM}"
                       IsVisible="{Binding !IsSaving}" />
          </Panel>
        </Button>
      </Grid>
    </Border>

    <!-- ════════════════════════════════════════════════════════
         FORM İÇERİĞİ — Kaydırılabilir alan
         ════════════════════════════════════════════════════════ -->
    <ScrollViewer Grid.Row="1"
                  x:Name="ProfileFormScrollViewer"
                  BringIntoViewOnFocusChange="True"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="60,48,60,120"
                  Spacing="20">

        <!-- ── Avatar bölümü ─────────────────────────────────────
             Netflix: büyük kare avatar ortalanmış,
             sağ alt köşede kalem badge'i
        ──────────────────────────────────────────────────────── -->
        <StackPanel HorizontalAlignment="Center"
                    Spacing="14">
          <Button Classes="AvatarBtn"
                  Command="{Binding OpenAvatarPickerCommand}"
                  HorizontalAlignment="Center">
            <Grid Width="120" Height="120" HorizontalAlignment="Center">

              <!-- Asıl avatar -->
              <Border Width="120" Height="120"
                      CornerRadius="12"
                      ClipToBounds="True"
                      Background="{DynamicResource IconGradientBrush}">
                <Image Source="{Binding SelectedAvatar, Converter={StaticResource AvatarPathConverter}}"
                       Stretch="UniformToFill" />
              </Border>

              <!-- Kalem badge — sağ alt köşe -->
              <Border Classes="EditIcon"
                      Width="34" Height="34"
                      CornerRadius="10"
                      Background="{DynamicResource Surface1Brush}"
                      BorderBrush="{DynamicResource Bg0Brush}"
                      BorderThickness="2"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,4,4">
                <icons:MaterialIcon Kind="PencilOutline"
                                    Width="18" Height="18"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Button>

          <!-- Düzenleme yardımı etiketi -->
          <TextBlock Text="{loc:Translate AvatarPicker.Title}"
                     FontSize="{DynamicResource FCaption}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- ── Profil adı ─────────────────────────────────────── -->
        <StackPanel Spacing="6">
          <TextBlock Classes="FieldLabel"
                     Text="{loc:Translate Profiles.Add.ProfileName}" />
          <TextBox x:Name="ProfileNameTextBox"
                   Text="{Binding ProfileName}"
                   Classes.error="{Binding ProfileNameError, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                   LostFocus="ProfileName_LostFocus"
                   TextInputOptions.ReturnKeyType="Next"
                   PlaceholderText="{loc:Translate Profiles.Add.ProfileNamePlaceholder}" />
          <TextBlock Text="{Binding ProfileNameError}"
                     Foreground="{DynamicResource ErrorBrush}"
                     FontSize="{DynamicResource FCaption}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding ProfileNameError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
        </StackPanel>

        <!-- ── Çocuk profili toggle ───────────────────────────────
             Netflix: kart içinde başlık + açıklama + toggle yan yana
        ──────────────────────────────────────────────────────── -->
        <Border Classes="Section"
                IsVisible="{Binding IsChildVisible}">
          <Border Padding="16,14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                <TextBlock Text="{loc:Translate Profiles.Add.IsChild}"
                           FontSize="{DynamicResource FBodyL}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{loc:Translate Profiles.Add.IsChildTooltip}"
                           FontSize="{DynamicResource FOverline}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding IsChild}"
                          IsEnabled="{Binding CanEditIsChild}"
                          VerticalAlignment="Center"
                          OnContent=""
                          OffContent="" />
          </Grid>
          </Border>
        </Border>

        <!-- ── Hesap Ayarları bölümü ─────────────────────────────
             Sağlayıcı tipi + URL + kullanıcı adı / şifre
        ──────────────────────────────────────────────────────── -->
        <StackPanel Spacing="8">
          <TextBlock Text="{loc:Translate Profiles.Account.Settings}"
                     FontSize="{DynamicResource FCaption}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Margin="4,0,0,2" />

          <Border Classes="Section">
            <StackPanel>

              <!-- Sağlayıcı tipi seçici: segmented control — kayan indicator ile -->
              <Border Margin="16,14"
                      Padding="4"
                      CornerRadius="10"
                      ClipToBounds="True"
                      Background="{DynamicResource Surface1Brush}"
                      IsVisible="{Binding IsRemoteProviderSource}"
                      IsEnabled="{Binding CanSwitchProviderType}">
                <Grid x:Name="SegmentedControlGrid" ColumnDefinitions="*,*,*">
                  <!-- Kayan indicator — RadioButton'ların arkasında, Grid.Column=0'da
                       başlar, RenderTransform ile sağa/sola kayar.
                       Transitions otomatik olarak smooth animasyon sağlar. -->
                  <Border x:Name="SegmentIndicator"
                          Grid.Column="0"
                          Background="{DynamicResource AccentBrush}"
                          CornerRadius="8,0,0,8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsHitTestVisible="False"
                          RenderTransformOrigin="0,0">
                    <Border.RenderTransform>
                      <TranslateTransform X="0">
                        <TranslateTransform.Transitions>
                          <Transitions>
                            <DoubleTransition Property="X"
                                              Duration="0:0:0.25"
                                              Easing="CubicEaseInOut" />
                          </Transitions>
                        </TranslateTransform.Transitions>
                      </TranslateTransform>
                    </Border.RenderTransform>
                    <Border.Transitions>
                      <Transitions>
                        <CornerRadiusTransition Property="CornerRadius"
                                                Duration="0:0:0.2"
                                                Easing="CubicEaseInOut" />
                      </Transitions>
                    </Border.Transitions>
                  </Border>

                  <!-- RadioButton'lar — artık kendi arka planlarını değiştirmezler -->
                  <RadioButton Grid.Column="0"
                               x:Name="SegmentXtream"
                               Theme="{StaticResource SegmentedRadioButtonTransparent}"
                               Content="Xtream"
                               GroupName="ProviderType"
                               IsChecked="{Binding IsXtream, Mode=TwoWay}" />
                  <RadioButton Grid.Column="1"
                               x:Name="SegmentM3U"
                               Theme="{StaticResource SegmentedRadioButtonTransparent}"
                               Content="M3U"
                               GroupName="ProviderType"
                               IsChecked="{Binding IsM3U, Mode=TwoWay}" />
                  <RadioButton Grid.Column="2"
                               x:Name="SegmentStalker"
                               Theme="{StaticResource SegmentedRadioButtonTransparent}"
                               Content="Stalker"
                               GroupName="ProviderType"
                               IsChecked="{Binding IsStalker, Mode=TwoWay}" />
                </Grid>
              </Border>

              <Border Classes="Divider" />

              <!-- Local M3U dosya kartı: URL textbox yerine read-only dosya durumu. -->
              <Border Margin="16,14"
                      Padding="14"
                      CornerRadius="14"
                      Background="{DynamicResource Surface1Brush}"
                      IsVisible="{Binding ShowLocalM3uFileActions}">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{DynamicResource AccentLightBrush}">
                      <icons:MaterialIcon Kind="FileDocumentOutline"
                                          Width="22"
                                          Height="22"
                                          Foreground="{DynamicResource AccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="{loc:Translate Profiles.Account.LocalM3uFile}"
                                 FontSize="{DynamicResource FBody}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock Text="{loc:Translate Profiles.Account.LocalM3uDescription}"
                                 FontSize="{DynamicResource FCaption}"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>

                  <Border Padding="12,10"
                          CornerRadius="10"
                          Background="{DynamicResource Surface0Brush}">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{loc:Translate Profiles.Account.SelectedFile}"
                                 FontSize="{DynamicResource FOverline}"
                                 Foreground="{DynamicResource TextMutedBrush}" />
                      <TextBlock Text="{Binding Url}"
                                 FontSize="{DynamicResource FCaption}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextWrapping="Wrap"
                                 MaxLines="3" />
                    </StackPanel>
                  </Border>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Command="{Binding PickM3uFileCommand}"
                            Content="{loc:Translate Profiles.Account.ChangeM3uFile}"
                            MinHeight="42"
                            CornerRadius="8"
                            Background="{DynamicResource AccentLightBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            HorizontalContentAlignment="Center" />
                    <Button Grid.Column="1"
                            Command="{Binding ValidateLocalM3uFileCommand}"
                            Content="{loc:Translate Profiles.Account.ValidateM3uFile}"
                            IsEnabled="{Binding !IsAnalyzingConnection}"
                            MinHeight="42"
                            CornerRadius="8"
                            Background="Transparent"
                            Foreground="{DynamicResource AccentBrush}"
                            HorizontalContentAlignment="Center" />
                  </Grid>

                  <!-- Local M3U Doğrulama Sonucu -->
                  <Border Background="{DynamicResource Surface0Brush}"
                          CornerRadius="8"
                          Padding="12,10"
                          IsVisible="{Binding ConnectionHealth,
                                              Converter={StaticResource ConnectionHealthToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <icons:MaterialIcon Kind="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToIconConverter}}"
                                          Width="18" Height="18"
                                          Foreground="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToBrushConverter}}"
                                          VerticalAlignment="Center" />
                      <TextBlock Text="{Binding DetailedStatus}"
                                 Foreground="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToBrushConverter}}"
                                 FontSize="{DynamicResource FCaption}"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>

                  <Button Command="{Binding ChangeLocalM3uSourceTypeCommand}"
                          Content="{loc:Translate Profiles.Account.ChangeSourceType}"
                          IsEnabled="{Binding !IsAnalyzingConnection}"
                          MinHeight="42"
                          CornerRadius="8"
                          Background="Transparent"
                          Foreground="{DynamicResource TextMutedBrush}"
                          HorizontalContentAlignment="Center" />
                </StackPanel>
              </Border>

              <!-- URL / M3U link alanı -->
              <StackPanel Margin="16,14"
                          Spacing="8"
                          IsVisible="{Binding IsRemoteProviderSource}">
                <Panel>
                  <TextBlock Classes="FieldLabel"
                             Text="{loc:Translate Profiles.Account.M3uLink}"
                             IsVisible="{Binding IsM3U}" />
                  <TextBlock Classes="FieldLabel"
                             Text="{loc:Translate Profiles.Account.ServerUrl}"
                             IsVisible="{Binding !IsM3U}" />
                </Panel>
                <TextBox x:Name="UrlTextBox"
                         Classes="url"
                         Text="{Binding Url}"
                         LostFocus="Url_LostFocus"
                         Classes.error="{Binding ServerUrlError, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                         TextInputOptions.ReturnKeyType="Next"
                         IsEnabled="{Binding CanEditProviderUrl}"
                         PlaceholderText="{loc:Translate Profiles.Account.ServerUrlPlaceholder}" />
                <TextBlock Text="{Binding ServerUrlError}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="{DynamicResource FCaption}"
                           TextWrapping="Wrap"
                           Margin="4,2,0,0"
                           IsVisible="{Binding ServerUrlError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                <!-- M3U dosya seçici butonu -->
                <Button Command="{Binding PickM3uFileCommand}"
                        Content="{loc:Translate Profiles.Account.SelectM3uFile}"
                        IsVisible="{Binding IsM3U}"
                        MinHeight="44"
                        CornerRadius="8"
                        Background="{DynamicResource AccentLightBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center" />
              </StackPanel>

              <!-- Kullanıcı adı (Xtream) / MAC adresi (Stalker) -->
              <Border Classes="Divider" IsVisible="{Binding !IsM3U}" />
              <StackPanel Margin="16,14"
                          Spacing="8"
                          IsVisible="{Binding !IsM3U}">
                <Panel>
                  <TextBlock Classes="FieldLabel"
                             Text="{loc:Translate Profiles.Account.Username}"
                             IsVisible="{Binding IsXtream}" />
                  <TextBlock Classes="FieldLabel"
                             Text="{loc:Translate Profiles.Account.MacAddress}"
                             IsVisible="{Binding IsStalker}" />
                </Panel>
                <TextBox x:Name="UsernameTextBox"
                         Text="{Binding Username}"
                         LostFocus="Username_LostFocus"
                         TextChanged="UsernameTextBox_TextChanged"
                         Classes.error="{Binding UsernameError, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                         IsEnabled="{Binding CanEditProviderCredentials}"
                         TextInputOptions.ReturnKeyType="Next"
                         PlaceholderText="{loc:Translate Profiles.Account.UsernamePlaceholder}" />
                <TextBlock Text="{Binding UsernameError}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="{DynamicResource FCaption}"
                           TextWrapping="Wrap"
                           Margin="4,2,0,0"
                           IsVisible="{Binding UsernameError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                <TextBlock Text="{Binding MacAddressError}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="{DynamicResource FCaption}"
                           TextWrapping="Wrap"
                           Margin="4,2,0,0"
                           IsVisible="{Binding MacAddressError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
              </StackPanel>                <!-- Şifre (sadece Xtream) -->
              <Border Classes="Divider" IsVisible="{Binding IsXtream}" />
              <StackPanel Margin="16,14"
                          Spacing="8"
                          IsVisible="{Binding IsXtream}">
                <TextBlock Classes="FieldLabel"
                           Text="{loc:Translate Profiles.Account.Password}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox x:Name="PasswordTextBox"
                           Grid.Column="0"
                           Classes="password"
                           Text="{Binding Password}"
                           Classes.error="{Binding PasswordError, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                           LostFocus="Password_LostFocus"
                           IsEnabled="{Binding CanEditProviderCredentials}"
                           TextInputOptions.ContentType="Password"
                           TextInputOptions.ReturnKeyType="Done"
                           PlaceholderText="{loc:Translate Profiles.Account.PasswordPlaceholder}" />
                  <Button Grid.Column="1"
                          Theme="{StaticResource RevealBtn}"
                          Command="{Binding TogglePasswordRevealCommand}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="{Binding PasswordToggleA11yName}"
                          AutomationProperties.Name="{Binding PasswordToggleA11yName}">
                    <icons:MaterialIcon Kind="{Binding PasswordToggleIcon}"
                                        Width="24" Height="24"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        VerticalAlignment="Center" />
                  </Button>
                </Grid>
                <TextBlock Text="{Binding PasswordError}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="{DynamicResource FCaption}"
                           TextWrapping="Wrap"
                           Margin="4,2,0,0"
                           IsVisible="{Binding PasswordError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
              </StackPanel>



              <!-- Bağlantı test butonu: sadece uzak sağlayıcılar için -->
              <Border Classes="Divider" IsVisible="{Binding ShowConnectionAnalysis}" />
              <StackPanel Spacing="0"
                          IsVisible="{Binding ShowConnectionAnalysis}">
                <Button Command="{Binding AnalyzeConnectionCommand}"
                        IsEnabled="{Binding !IsAnalyzingConnection}"
                        MinHeight="44"
                        MaxWidth="200"
                        CornerRadius="8"
                        Background="Transparent"
                        Foreground="{DynamicResource AccentBrush}"
                        FontWeight="Medium"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="16,12">
                  <Panel>
                    <TextBlock Text="{loc:Translate AddProfile.Status.Analyzing}"
                               HorizontalAlignment="Center"
                               FontWeight="Medium"
                               IsVisible="{Binding IsAnalyzingConnection}" />
                    <TextBlock Text="{loc:Translate Profiles.Account.TestConnection}"
                               HorizontalAlignment="Center"
                               FontWeight="Medium"
                               IsVisible="{Binding !IsAnalyzingConnection}" />
                  </Panel>
                </Button>
                <TextBlock Text="{loc:Translate Profiles.Account.TestConnectionHint}"
                           FontSize="{DynamicResource FOverline}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,0,14"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
              </StackPanel>

              <!-- Bağlantı sağlığı göstergesi -->
              <Border Margin="16,0,16,14"
                      Background="{DynamicResource Surface1Brush}"
                      CornerRadius="8"
                      Padding="12,10"
                      IsVisible="{Binding ConnectionHealth,
                                          Converter={StaticResource ConnectionHealthToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="10" >
                  <icons:MaterialIcon Kind="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToIconConverter}}"
                                      Width="18" Height="18"
                                      Foreground="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToBrushConverter}}"
                                      ToolTip.Tip="{loc:Translate Profiles.Account.HealthTooltip}"
                                      VerticalAlignment="Center" />
                  <TextBlock Text="{Binding DetailedStatus}"
                             Foreground="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToBrushConverter}}"
                             FontSize="{DynamicResource FCaption}"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ── PIN Kilidi bölümü ──────────────────────────────── -->
        <StackPanel Spacing="8">
          <TextBlock Text="{loc:Translate Profiles.Add.PinLock}"
                     FontSize="{DynamicResource FCaption}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Margin="4,0,0,2" />

          <Border Classes="Section">
            <StackPanel>

              <!-- PIN açma / kapama satırı -->
              <!-- Premium yokken satırın tamamı tıklanabilir → upsell açar -->
              <Button Classes="SectionRow"
                      Command="{Binding RequestPremiumUpgradeCommand}"
                      IsVisible="{Binding !IsPinAvailable}"
                      AutomationProperties.Name="{loc:Translate Profiles.Add.PinLockPremiumA11y}"
                      Padding="16,14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <icons:MaterialIcon Kind="Lock" Width="22" Height="22" Margin="0"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Center"/>
                      <TextBlock Text="{loc:Translate Profiles.Add.PinLock}"
                                 FontSize="{DynamicResource FBodyL}"
                                 FontWeight="Medium"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                      <!-- Premium rozeti -->
                      <Border Background="{DynamicResource PremiumBadgeBrush}"
                              CornerRadius="4"
                              Padding="6,2"
                              VerticalAlignment="Center">
                        <TextBlock Text="PREMIUM"
                                   FontSize="{DynamicResource FOverline}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PremiumBadgeTextBrush}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{loc:Translate Profiles.Add.PinLockDescription}"
                               FontSize="{DynamicResource FOverline}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <icons:MaterialIcon Kind="ChevronRight"
                                      Width="20" Height="20"
                                      Foreground="{DynamicResource TextMutedBrush}"
                                      HorizontalAlignment="Right" />
                </Grid>
              </Button>

              <!-- PIN açma / kapama satırı — premium ise normal toggle -->
              <Border Padding="16,14"
                      IsVisible="{Binding IsPinAvailable}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <icons:MaterialIcon Kind="Lock" Width="22" Height="22" Margin="0"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Center"/>
                      <TextBlock Text="{loc:Translate Profiles.Add.PinLock}"
                                 FontSize="{DynamicResource FBodyL}"
                                 FontWeight="Medium"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{loc:Translate Profiles.Add.PinLockDescription}"
                               FontSize="{DynamicResource FOverline}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                IsChecked="{Binding HasPin}"
                                VerticalAlignment="Center"
                                OnContent=""
                                OffContent="" />
                </Grid>
              </Border>

              <!-- PIN giriş alanları (HasPin=True olunca görünür) -->
              <StackPanel IsVisible="{Binding HasPin}">
                <Border Classes="Divider" />
                <StackPanel Margin="16,14" Spacing="12">

                  <!-- Mevcut PIN aktif uyarısı -->
                  <StackPanel IsVisible="{Binding HasExistingPin}"
                              Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <icons:MaterialIcon Kind="ShieldCheckOutline"
                                          Width="16" Height="16"
                                          Foreground="{DynamicResource SuccessBrush}"
                                          VerticalAlignment="Center" />
                      <TextBlock Text="{loc:Translate Profiles.Add.PinActive}"
                                 Foreground="{DynamicResource SuccessBrush}"
                                 FontSize="{DynamicResource FCaption}"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{loc:Translate Profiles.Add.PinChangeInfo}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="{DynamicResource FCaption}"
                               TextWrapping="Wrap" />
                  </StackPanel>

                  <!-- Yeni PIN -->
                  <StackPanel Spacing="6">
                    <Panel>
                      <TextBlock Classes="FieldLabel"
                                 Text="{loc:Translate Profiles.Add.NewPin}"
                                 IsVisible="{Binding HasExistingPin}" />
                      <TextBlock Classes="FieldLabel"
                                 Text="{loc:Translate Profiles.Add.Pin}"
                                 IsVisible="{Binding !HasExistingPin}" />
                    </Panel>
                    <TextBox x:Name="PinCodeTextBox"
                             Classes="pin"
                             Text="{Binding PinCode}"
                             PasswordChar="&#x2022;"
                             MaxLength="4"
                             TextInputOptions.ContentType="Digits"
                             Classes.error="{Binding PinError, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                             LostFocus="PinCode_LostFocus"
                             TextInputOptions.ReturnKeyType="Next"
                             PlaceholderText="&#x2022;&#x2022;&#x2022;&#x2022;" />
                    <TextBlock Text="{Binding PinError}"
                               Foreground="{DynamicResource ErrorBrush}"
                               FontSize="{DynamicResource FCaption}"
                               TextWrapping="Wrap"
                               Margin="4,2,0,0"
                               IsVisible="{Binding PinError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                  </StackPanel>

                  <!-- PIN onayı -->
                  <StackPanel Spacing="6">
                    <Panel>
                      <TextBlock Classes="FieldLabel"
                                 Text="{loc:Translate Profiles.Add.ConfirmNewPin}"
                                 IsVisible="{Binding HasExistingPin}" />
                      <TextBlock Classes="FieldLabel"
                                 Text="{loc:Translate Profiles.Add.ConfirmPin}"
                                 IsVisible="{Binding !HasExistingPin}" />
                    </Panel>
                    <TextBox x:Name="PinConfirmTextBox"
                             Classes="pin"
                             Text="{Binding PinConfirm}"
                             PasswordChar="&#x2022;"
                             MaxLength="4"
                             TextInputOptions.ContentType="Digits"
                             Classes.error="{Binding PinConfirmationError, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                             LostFocus="PinConfirm_LostFocus"
                             TextInputOptions.ReturnKeyType="Done"
                             PlaceholderText="&#x2022;&#x2022;&#x2022;&#x2022;" />
                    <TextBlock Text="{Binding PinConfirmationError}"
                               Foreground="{DynamicResource ErrorBrush}"
                               FontSize="{DynamicResource FCaption}"
                               TextWrapping="Wrap"
                               Margin="4,2,0,0"
                               IsVisible="{Binding PinConfirmationError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                  </StackPanel>



                  <!-- PIN yalnızca yerel profil kilididir (yüksek güvenlikli kimlik doğrulaması değildir) -->
                  <TextBlock Text="{loc:Translate Profiles.Add.PinLocalOnly}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="{DynamicResource FOverline}"
                             TextWrapping="Wrap" />

                  <!-- PIN uyarısı -->
                  <TextBlock Text="{loc:Translate Profiles.Add.PinWarning}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="{DynamicResource FOverline}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!--
          ── Profili Sil butonu (SADECE DÜZENLEME MODUNDA) ────────
          Netflix: "Delete Profile" ikonlu, kırmızı, en alt satırda.
          Silinebilecek bir profil (EditingProfile != null) varsa görünür.
        -->
        <Button Command="{Binding DeleteProfileCommand}"
                CommandParameter="{Binding EditingProfile}"
                IsVisible="{Binding EditingProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Theme="{StaticResource DangerButtonStyle}">
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Spacing="10">
            <icons:MaterialIcon Kind="TrashCanOutline"
                                Width="24" Height="24"
                                Foreground="{DynamicResource ErrorBrush}"
                                VerticalAlignment="Center" />
            <TextBlock Text="{loc:Translate Profiles.Add.DeleteProfile}"
                       Foreground="{DynamicResource ErrorBrush}"
                       FontSize="{DynamicResource FTitleM}"
                       FontWeight="Medium"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>

      </StackPanel>
    </ScrollViewer>

    <!-- ════════════════════════════════════════════════════════
         DURUM MESAJI — ScrollViewer dışında, klavye açıkken bile görünür
         ════════════════════════════════════════════════════════ -->
    <Border Grid.Row="2"
            IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
            Margin="16,0,16,8"
            Padding="12,8"
            CornerRadius="8">
      <Border.Styles>
        <Style Selector="Border">
          <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
        </Style>
        <Style Selector="Border[Tag=Success]">
          <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
        </Style>
        <Style Selector="Border[Tag=Warning]">
          <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
        </Style>
        <Style Selector="Border[Tag=Error]">
          <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
        </Style>
      </Border.Styles>
      <Border.Tag>
        <Binding Path="StatusKind" Converter="{StaticResource EnumToStringConverter}" />
      </Border.Tag>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <!-- Progress spinner -->
        <ProgressBar IsIndeterminate="True"
                     Width="14" Height="14"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     IsVisible="{Binding StatusKind,
                                        Converter={StaticResource EnumEqualConverter},
                                        ConverterParameter={x:Static vm:FormStatusKind.Progress}}" />
        <!-- Success icon -->
        <icons:MaterialIcon Kind="CheckCircle"
                            Width="16" Height="16"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource SuccessBrush}"
                            IsVisible="{Binding StatusKind,
                                               Converter={StaticResource EnumEqualConverter},
                                               ConverterParameter={x:Static vm:FormStatusKind.Success}}" />
        <!-- Warning icon -->
        <icons:MaterialIcon Kind="AlertCircle"
                            Width="16" Height="16"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource WarningBrush}"
                            IsVisible="{Binding StatusKind,
                                               Converter={StaticResource EnumEqualConverter},
                                               ConverterParameter={x:Static vm:FormStatusKind.Warning}}" />
        <!-- Error icon -->
        <icons:MaterialIcon Kind="AlertCircleOutline"
                            Width="16" Height="16"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ErrorBrush}"
                            IsVisible="{Binding StatusKind,
                                               Converter={StaticResource EnumEqualConverter},
                                               ConverterParameter={x:Static vm:FormStatusKind.Error}}" />
        <TextBlock Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FCaption}"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
      </StackPanel>
    </Border>

    <!-- ════════════════════════════════════════════════════════
         AVATAR SEÇİCİ OVERLAY
         ════════════════════════════════════════════════════════ -->
    <Border x:Name="AvatarPickerHost"
            Grid.RowSpan="3"
            Background="{DynamicResource Bg0Brush}"
            Padding="0"
            IsVisible="False">
      <Grid RowDefinitions="Auto,*,Auto">

        <!-- Avatar seçici başlık -->
        <Border Grid.Row="0"
                Padding="16,14"
                Background="{DynamicResource Bg0Brush}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0"
                    x:Name="AvatarPickerCloseButton"
                    Classes="HeaderAction"
                    Click="OnCloseAvatarPicker"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <icons:MaterialIcon Kind="ChevronLeft" Width="20" Height="20"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{loc:Translate Profiles.Add.Cancel}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Button>
            <TextBlock Grid.Column="1"
                       Text="{loc:Translate AvatarPicker.Title}"
                       FontSize="{DynamicResource FTitleM}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Avatar seçici içeriği -->
        <views:AvatarPickerView Grid.Row="1"
                                x:Name="AvatarPickerContent" />
      </Grid>
    </Border>

  </Grid>
</UserControl>
