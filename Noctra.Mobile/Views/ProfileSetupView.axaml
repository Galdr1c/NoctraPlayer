<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:views="using:Noctra.Mobile.Views"
             xmlns:loc="using:Noctra.Mobile.Localization"
             x:Class="Noctra.Mobile.Views.ProfileSetupView"
             x:DataType="vm:AddProfileViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="844"
             Background="{DynamicResource Bg0Brush}">
  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Padding="16,14" Background="{DynamicResource Bg1Brush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="action"
                Command="{Binding CancelCommand}"
                Content="{loc:Translate Profiles.Add.Cancel}"
                Background="Transparent"
                Foreground="{DynamicResource TextPrimaryBrush}" />
        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Center"
                    Spacing="2">
          <TextBlock Text="{loc:Translate Profiles.Add.Title}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{loc:Translate Profiles.Add.Description}"
                     FontSize="11"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
        <Button Grid.Column="2"
                Classes="action"
                Command="{Binding SaveCommand}"
                Content="{loc:Translate Profiles.Add.Save}"
                Background="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                IsEnabled="{Binding !IsSaving}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel MaxWidth="560"
                  Margin="16,18,16,32"
                  HorizontalAlignment="Center"
                  Spacing="16">
        <Border Classes="section">
          <StackPanel Spacing="10">
            <Button Command="{Binding OpenAvatarPickerCommand}"
                    Background="{DynamicResource Surface1Brush}"
                    BorderThickness="0"
                    CornerRadius="16"
                    Padding="14">
              <StackPanel Spacing="6">
                <Border Width="72"
                        Height="72"
                        CornerRadius="18"
                        Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Center">
                  <Image Source="{Binding SelectedAvatar, Converter={StaticResource AvatarPathConverter}}"
                         Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="{loc:Translate AvatarPicker.Title}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Button>
            <TextBlock Classes="label" Text="{loc:Translate Profiles.Add.ProfileName}" />
            <TextBox Text="{Binding ProfileName}"
                     PlaceholderText="{loc:Translate Profiles.Add.ProfileNamePlaceholder}" />
            <TextBlock Text="{Binding ProfileNameError}"
                       Foreground="{DynamicResource ErrorBrush}"
                       TextWrapping="Wrap" />
            <CheckBox Content="{loc:Translate Profiles.Add.IsChild}"
                      IsChecked="{Binding IsChild}"
                      IsEnabled="{Binding CanEditIsChild}"
                      IsVisible="{Binding IsChildVisible}" />
          </StackPanel>
        </Border>

        <Border Classes="section">
          <StackPanel Spacing="12">
            <TextBlock Text="{loc:Translate Profiles.Account.Settings}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
              <RadioButton Content="Xtream"
                           GroupName="ProviderType"
                           IsChecked="{Binding IsXtream}" />
              <RadioButton Grid.Column="1"
                           Content="M3U"
                           GroupName="ProviderType"
                           IsChecked="{Binding IsM3U}" />
              <RadioButton Grid.Column="2"
                           Content="Stalker"
                           GroupName="ProviderType"
                           IsChecked="{Binding IsStalker}" />
            </Grid>

            <TextBlock Classes="label"
                       Text="{loc:Translate Profiles.Account.ServerUrl}" />
            <TextBox Text="{Binding Url}"
                     PlaceholderText="{loc:Translate Profiles.Account.ServerUrlPlaceholder}" />

            <Button Classes="action"
                    Command="{Binding PickM3uFileCommand}"
                    Content="{loc:Translate Profiles.Account.SelectM3uFile}"
                    IsVisible="{Binding IsM3U}"
                    Background="{DynamicResource Surface1Brush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" />

            <TextBlock Classes="label"
                       Text="{loc:Translate Profiles.Account.Username}"
                       IsVisible="{Binding IsXtream}" />
            <TextBlock Classes="label"
                       Text="{loc:Translate Profiles.Account.MacAddress}"
                       IsVisible="{Binding IsStalker}" />
            <TextBox Text="{Binding Username}"
                     PlaceholderText="{loc:Translate Profiles.Account.UsernamePlaceholder}"
                     IsVisible="{Binding !IsM3U}" />

            <TextBlock Classes="label"
                       Text="{loc:Translate Profiles.Account.Password}"
                       IsVisible="{Binding IsXtream}" />
            <TextBox Text="{Binding Password}"
                     PasswordChar="*"
                     PlaceholderText="{loc:Translate Profiles.Account.PasswordPlaceholder}"
                     IsVisible="{Binding IsXtream}" />

            <TextBlock Text="{Binding UrlError}"
                       Foreground="{DynamicResource ErrorBrush}"
                       TextWrapping="Wrap" />

            <Button Classes="action"
                    Command="{Binding AnalyzeConnectionCommand}"
                    Content="{loc:Translate Profiles.Account.Analyze}"
                    IsEnabled="{Binding !IsAnalyzingConnection}"
                    Background="{DynamicResource Surface1Brush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding DetailedStatus}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="section">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{loc:Translate Profiles.Add.PinLock}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{loc:Translate Profiles.Add.PinLockDescription}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding HasPin}"
                            IsEnabled="{Binding IsPinAvailable}" />
            </Grid>
            <StackPanel IsVisible="{Binding HasPin}" Spacing="10">
              <TextBlock Classes="label" Text="{loc:Translate Profiles.Add.Pin}" />
              <TextBox Text="{Binding PinCode}"
                       MaxLength="4"
                       PasswordChar="*" />
              <TextBlock Classes="label" Text="{loc:Translate Profiles.Add.ConfirmPin}" />
              <TextBox Text="{Binding PinConfirm}"
                       MaxLength="4"
                       PasswordChar="*" />
              <TextBlock Text="{Binding PinError}"
                         Foreground="{DynamicResource ErrorBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
        <Button Classes="action"
                Command="{Binding SaveCommand}"
                Content="{loc:Translate Profiles.Add.Save}"
                Background="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                IsEnabled="{Binding !IsSaving}" />
        <Button Classes="action"
                Command="{Binding CancelCommand}"
                Content="{loc:Translate Profiles.Add.Cancel}"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Foreground="{DynamicResource TextPrimaryBrush}" />
        <Button Classes="action"
                Command="{Binding DeleteProfileCommand}"
                CommandParameter="{Binding EditingProfile}"
                Content="{loc:Translate Profiles.Add.DeleteProfile}"
                Background="Transparent"
                BorderBrush="{DynamicResource ErrorBrush}"
                BorderThickness="1"
                Foreground="{DynamicResource ErrorBrush}"
                IsVisible="{Binding EditingProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                Margin="0,16,0,0" />
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="AvatarPickerHost"
            Grid.RowSpan="2"
            Background="{DynamicResource OverlayDarkBrush}"
            Padding="18"
            IsVisible="False">
      <Grid RowDefinitions="*,Auto">
        <views:AvatarPickerView x:Name="AvatarPickerContent"
                                VerticalAlignment="Center" />
        <Button Grid.Row="1"
                Content="{loc:Translate Profiles.Add.Cancel}"
                Click="OnCloseAvatarPicker"
                Margin="0,12,0,0"
                MinHeight="48"
                Background="{DynamicResource Surface0Brush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
