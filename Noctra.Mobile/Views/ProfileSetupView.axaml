<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:views="using:Noctra.Mobile.Views"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.ProfileSetupView"
             x:DataType="vm:AddProfileViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="844"
             Background="{DynamicResource BackgroundGradientBrush}">
  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.AvatarBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Border.EditIcon">
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.AvatarBtn:pointerover Border.EditIcon">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Padding="24,20" Background="Transparent">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="action"
                Command="{Binding CancelCommand}"
                Content="{loc:Translate Profiles.Add.Cancel}"
                Background="Transparent"
                Foreground="{DynamicResource TextPrimaryBrush}" />
        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Center"
                    Spacing="2">
          <TextBlock Text="{loc:Translate Profiles.Add.Title}"
                     FontSize="28"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{loc:Translate Profiles.Add.Description}"
                     FontSize="13"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
        <Button Grid.Column="2"
                Classes="action"
                Command="{Binding SaveCommand}"
                Content="{loc:Translate Profiles.Add.Save}"
                Background="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                IsEnabled="{Binding !IsSaving}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel MaxWidth="560"
                  Margin="24,22,24,36"
                  HorizontalAlignment="Center"
                  Spacing="20">
        <Border Classes="section">
          <StackPanel Spacing="10">
            <Button Command="{Binding OpenAvatarPickerCommand}"
                    Classes="AvatarBtn"
                    Background="{DynamicResource Surface1Brush}"
                    BorderThickness="0"
                    CornerRadius="16"
                    Padding="14">
              <StackPanel Spacing="6">
                <Grid Width="104"
                      Height="104"
                      HorizontalAlignment="Center">
                  <Border Width="96"
                          Height="96"
                          CornerRadius="18"
                          ClipToBounds="True"
                          Background="{DynamicResource IconGradientBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                    <Image Source="{Binding SelectedAvatar, Converter={StaticResource AvatarPathConverter}}"
                           Stretch="UniformToFill" />
                  </Border>
                  <Border Classes="EditIcon"
                          Width="34"
                          Height="34"
                          CornerRadius="17"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom">
                    <icons:MaterialIcon Kind="PencilOutline"
                                        Width="18"
                                        Height="18"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                  </Border>
                </Grid>
                <TextBlock Text="{loc:Translate AvatarPicker.Title}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Button>
            <TextBlock Classes="label" Text="{loc:Translate Profiles.Add.ProfileName}" />
            <TextBox Text="{Binding ProfileName}"
                     PlaceholderText="{loc:Translate Profiles.Add.ProfileNamePlaceholder}" />
            <TextBlock Text="{Binding ProfileNameError}"
                       Foreground="{DynamicResource ErrorBrush}"
                       TextWrapping="Wrap" />
            <CheckBox Content="{loc:Translate Profiles.Add.IsChild}"
                      IsChecked="{Binding IsChild}"
                      IsEnabled="{Binding CanEditIsChild}"
                      IsVisible="{Binding IsChildVisible}" />
          </StackPanel>
        </Border>

        <Border Classes="section">
          <StackPanel Spacing="12">
            <TextBlock Text="{loc:Translate Profiles.Account.Settings}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
              <RadioButton Content="Xtream"
                           GroupName="ProviderType"
                           IsChecked="{Binding IsXtream}" />
              <RadioButton Grid.Column="1"
                           Content="M3U"
                           GroupName="ProviderType"
                           IsChecked="{Binding IsM3U}" />
              <RadioButton Grid.Column="2"
                           Content="Stalker"
                           GroupName="ProviderType"
                           IsChecked="{Binding IsStalker}" />
            </Grid>

            <Panel>
              <TextBlock Classes="label"
                         Text="{loc:Translate Profiles.Account.M3uLink}"
                         IsVisible="{Binding IsM3U}" />
              <TextBlock Classes="label"
                         Text="{loc:Translate Profiles.Account.ServerUrl}"
                         IsVisible="{Binding !IsM3U}" />
            </Panel>
            <TextBox Text="{Binding Url}"
                     PlaceholderText="{loc:Translate Profiles.Account.ServerUrlPlaceholder}" />

            <Button Classes="action"
                    Command="{Binding PickM3uFileCommand}"
                    Content="{loc:Translate Profiles.Account.SelectM3uFile}"
                    IsVisible="{Binding IsM3U}"
                    Background="{DynamicResource Surface1Brush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" />

            <TextBlock Classes="label"
                       Text="{loc:Translate Profiles.Account.Username}"
                       IsVisible="{Binding IsXtream}" />
            <TextBlock Classes="label"
                       Text="{loc:Translate Profiles.Account.MacAddress}"
                       IsVisible="{Binding IsStalker}" />
            <TextBox Text="{Binding Username}"
                     PlaceholderText="{loc:Translate Profiles.Account.UsernamePlaceholder}"
                     IsVisible="{Binding !IsM3U}" />

            <TextBlock Classes="label"
                       Text="{loc:Translate Profiles.Account.Password}"
                       IsVisible="{Binding IsXtream}" />
             <TextBox Text="{Binding Password}"
                      PasswordChar="&#x2022;"
                      PlaceholderText="{loc:Translate Profiles.Account.PasswordPlaceholder}"
                      IsVisible="{Binding IsXtream}" />

            <TextBlock Text="{Binding UrlError}"
                       Foreground="{DynamicResource ErrorBrush}"
                       TextWrapping="Wrap" />

            <Button Classes="action"
                    Command="{Binding AnalyzeConnectionCommand}"
                    Content="{loc:Translate Profiles.Account.Analyze}"
                    IsEnabled="{Binding !IsAnalyzingConnection}"
                    Background="{DynamicResource Surface1Brush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding DetailedStatus}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="section">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{loc:Translate Profiles.Add.PinLock}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{loc:Translate Profiles.Add.PinLockDescription}"
                             FontSize="12"
                             Foreground="{DynamicResource TextMutedBrush}" />
                  <Border Background="#FFD700"
                          CornerRadius="4"
                          Padding="6,2"
                          IsVisible="{Binding !IsPinAvailable}">
                    <TextBlock Text="PREMIUM"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#1A1A2E" />
                  </Border>
                </StackPanel>
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding HasPin}"
                            IsEnabled="{Binding IsPinAvailable}" />
            </Grid>
            <StackPanel IsVisible="{Binding HasPin}" Spacing="10">
              <StackPanel IsVisible="{Binding HasExistingPin}" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <icons:MaterialIcon Kind="ShieldCheckOutline"
                                      Width="18"
                                      Height="18"
                                      Foreground="{DynamicResource SuccessBrush}"
                                      VerticalAlignment="Center" />
                  <TextBlock Text="{loc:Translate Profiles.Add.PinActive}"
                             Foreground="{DynamicResource SuccessBrush}"
                             FontSize="13"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{loc:Translate Profiles.Add.PinChangeInfo}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Panel>
                <TextBlock Classes="label"
                           Text="{loc:Translate Profiles.Add.NewPin}"
                           IsVisible="{Binding HasExistingPin}" />
                <TextBlock Classes="label"
                           Text="{loc:Translate Profiles.Add.Pin}"
                           IsVisible="{Binding !HasExistingPin}" />
              </Panel>
              <TextBox Text="{Binding PinCode}"
                       MaxLength="4"
                       PasswordChar="&#x2022;"
                       PlaceholderText="&#x2022;&#x2022;&#x2022;&#x2022;"
                       LetterSpacing="8"
                       HorizontalContentAlignment="Center" />
              <Panel>
                <TextBlock Classes="label"
                           Text="{loc:Translate Profiles.Add.ConfirmNewPin}"
                           IsVisible="{Binding HasExistingPin}" />
                <TextBlock Classes="label"
                           Text="{loc:Translate Profiles.Add.ConfirmPin}"
                           IsVisible="{Binding !HasExistingPin}" />
              </Panel>
              <TextBox Text="{Binding PinConfirm}"
                       MaxLength="4"
                       PasswordChar="&#x2022;"
                       PlaceholderText="&#x2022;&#x2022;&#x2022;&#x2022;"
                       LetterSpacing="8"
                       HorizontalContentAlignment="Center" />
              <TextBlock Text="{Binding PinError}"
                         Foreground="{DynamicResource ErrorBrush}"
                         IsVisible="{Binding PinError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{loc:Translate Profiles.Add.PinWarning}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="11"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
        <Button Classes="action"
                Command="{Binding SaveCommand}"
                Content="{loc:Translate Profiles.Add.Save}"
                Background="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                IsEnabled="{Binding !IsSaving}" />
        <Button Classes="action"
                Command="{Binding CancelCommand}"
                Content="{loc:Translate Profiles.Add.Cancel}"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Foreground="{DynamicResource TextPrimaryBrush}" />
        <Button Classes="action"
                Command="{Binding DeleteProfileCommand}"
                CommandParameter="{Binding EditingProfile}"
                Background="Transparent"
                BorderBrush="{DynamicResource ErrorBrush}"
                BorderThickness="1"
                Foreground="{DynamicResource ErrorBrush}"
                IsVisible="{Binding EditingProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                Margin="0,16,0,0">
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Spacing="8">
            <icons:MaterialIcon Kind="TrashCanOutline"
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource ErrorBrush}" />
            <TextBlock Text="{loc:Translate Profiles.Add.DeleteProfile}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="AvatarPickerHost"
            Grid.RowSpan="2"
            Background="{DynamicResource OverlayDarkBrush}"
            Padding="18"
            IsVisible="False">
      <Grid RowDefinitions="*,Auto">
        <views:AvatarPickerView x:Name="AvatarPickerContent"
                                VerticalAlignment="Center" />
        <Button Grid.Row="1"
                Content="{loc:Translate Profiles.Add.Cancel}"
                Click="OnCloseAvatarPicker"
                Margin="0,12,0,0"
                MinHeight="48"
                Background="{DynamicResource Surface0Brush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
