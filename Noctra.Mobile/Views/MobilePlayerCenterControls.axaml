<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobilePlayerCenterControls"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <UserControl.Styles>
    <!-- Touch feedback for skip buttons -->
    <Style Selector="Button.skipBtn">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.skipBtn:pressed">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="RenderTransform" Value="scale(0.90)" />
    </Style>
    <!-- Touch feedback for play/pause button -->
    <Style Selector="Button.playBtn">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.playBtn:pressed">
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="RenderTransform" Value="scale(0.93)" />
    </Style>
  </UserControl.Styles>

  <StackPanel Orientation="Horizontal"
              Spacing="18">
    <Button Classes="skipBtn"
            Command="{Binding SkipBackwardCommand}"
            CommandParameter="10"
            Width="56"
            Height="56"
            Padding="0"
            CornerRadius="28"
            Background="{DynamicResource PlayerOverlayButtonBrush}"
            BorderThickness="0"
            IsVisible="{Binding !IsLiveContent}">
      <icons:MaterialIcon Kind="Rewind10" Width="28" Height="28" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
    </Button>
    <Button Classes="skipBtn"
            Command="{Binding PlayPreviousLiveChannelCommand}"
            Width="56"
            Height="56"
            Padding="0"
            CornerRadius="28"
            Background="{DynamicResource PlayerOverlayButtonBrush}"
            BorderThickness="0"
            IsVisible="{Binding IsLiveContent}">
      <icons:MaterialIcon Kind="SkipPrevious" Width="24" Height="24" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
    </Button>

    <Button Classes="playBtn"
            Command="{Binding PlayPauseCommand}"
            Width="72"
            Height="72"
            Padding="0"
            CornerRadius="36"
            Background="{DynamicResource AccentBrush}"
            BorderThickness="0">
      <Grid Width="40" Height="40">
        <icons:MaterialIcon Kind="Pause" Width="40" Height="40"
                            Foreground="{DynamicResource PlayerOverlayTextBrush}"
                            IsVisible="{Binding IsPlaying}" />
        <icons:MaterialIcon Kind="Play" Width="40" Height="40"
                            Foreground="{DynamicResource PlayerOverlayTextBrush}"
                            IsVisible="{Binding IsPlaying, Converter={StaticResource InverseBoolConverter}}" />
      </Grid>
    </Button>

    <Button Classes="skipBtn"
            Command="{Binding SkipForwardCommand}"
            CommandParameter="10"
            Width="56"
            Height="56"
            Padding="0"
            CornerRadius="28"
            Background="{DynamicResource PlayerOverlayButtonBrush}"
            BorderThickness="0"
            IsVisible="{Binding !IsLiveContent}">
      <icons:MaterialIcon Kind="FastForward10" Width="28" Height="28" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
    </Button>
    <Button Classes="skipBtn"
            Command="{Binding PlayNextLiveChannelCommand}"
            Width="56"
            Height="56"
            Padding="0"
            CornerRadius="28"
            Background="{DynamicResource PlayerOverlayButtonBrush}"
            BorderThickness="0"
            IsVisible="{Binding IsLiveContent}">
      <icons:MaterialIcon Kind="SkipNext" Width="24" Height="24" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
    </Button>
  </StackPanel>
</UserControl>
