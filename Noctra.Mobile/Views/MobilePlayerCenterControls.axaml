<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobilePlayerCenterControls"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <StackPanel Orientation="Horizontal"
              Spacing="18">
    <Button Command="{Binding SkipBackwardCommand}"
            CommandParameter="10"
            Width="56"
            Height="56"
            Padding="0"
            CornerRadius="28"
            Background="{DynamicResource PlayerOverlayButtonBrush}"
            BorderThickness="0"
            IsVisible="{Binding !IsLiveContent}">
      <icons:MaterialIcon Kind="Rewind10" Width="28" Height="28" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
    </Button>

    <Button Command="{Binding PlayPauseCommand}"
            Width="72"
            Height="72"
            Padding="0"
            CornerRadius="36"
            Background="{DynamicResource AccentBrush}"
            BorderThickness="0">
      <Grid Width="40" Height="40">
        <icons:MaterialIcon Kind="Pause" Width="40" Height="40"
                            Foreground="{DynamicResource PlayerOverlayTextBrush}"
                            IsVisible="{Binding IsPlaying}" />
        <icons:MaterialIcon Kind="Play" Width="40" Height="40"
                            Foreground="{DynamicResource PlayerOverlayTextBrush}"
                            IsVisible="{Binding IsPlaying, Converter={StaticResource InverseBoolConverter}}" />
      </Grid>
    </Button>

    <Button Command="{Binding SkipForwardCommand}"
            CommandParameter="10"
            Width="56"
            Height="56"
            Padding="0"
            CornerRadius="28"
            Background="{DynamicResource PlayerOverlayButtonBrush}"
            BorderThickness="0"
            IsVisible="{Binding !IsLiveContent}">
      <icons:MaterialIcon Kind="FastForward10" Width="28" Height="28" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
    </Button>
  </StackPanel>
</UserControl>
