<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileLiveView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <ScrollViewer x:Name="LiveScrollViewer"
                ScrollChanged="LiveScrollViewer_ScrollChanged">
    <StackPanel Margin="20" Spacing="14">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{loc:Translate Live.Title}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <ComboBox Grid.Column="1"
                  Width="150"
                  ItemsSource="{Binding SortOptions}"
                  SelectedValue="{Binding SelectedSortOrder}"
                  SelectedValueBinding="{Binding Key}"
                  DisplayMemberBinding="{Binding Value}"
                  IsVisible="{Binding ShowContentFilters}" />
      </Grid>
      <ComboBox ItemsSource="{Binding Groups}"
                SelectedItem="{Binding SelectedGroup}"
                PlaceholderText="{loc:Translate Common.All}"
                IsVisible="{Binding ShowGroupFilter}" />

      <ItemsControl ItemsSource="{Binding FilteredChannels}"
                    IsVisible="{Binding !IsContentLoading}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Channel">
            <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                    CommandParameter="{Binding}"
                    Background="{DynamicResource Surface0Brush}"
                    BorderThickness="0"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="56,*">
                <Border Width="44"
                        Height="44"
                        CornerRadius="12"
                        ClipToBounds="True"
                        Background="{DynamicResource Surface1Brush}">
                  <Grid>
                    <icons:MaterialIcon Kind="Television"
                                        Foreground="{DynamicResource AccentBrush}"
                                        Width="20"
                                        Height="20" />
                    <controls:RemoteImage Url="{Binding CoverUrl}" Stretch="Uniform" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1"
                            Spacing="3">
                  <TextBlock Text="{Binding Name}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding GroupTitle}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="10"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding IsContentLoading}">
        <controls:PremiumSpinner Width="56" Height="56" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:Translate Live.Loading}"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>

      <StackPanel Spacing="8"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding ShowEmptyChannels}">
        <TextBlock Text="{loc:Translate Live.Empty.Title}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Text="{loc:Translate Live.Empty.Description}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
