<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileLiveView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <UserControl.Resources>
    <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
  </UserControl.Resources>

  <ScrollViewer x:Name="LiveScrollViewer"
                ScrollChanged="LiveScrollViewer_ScrollChanged">
    <StackPanel Margin="20" Spacing="14">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{loc:Translate Live.Title}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <ComboBox Grid.Column="1"
                  Width="150"
                  MinHeight="48"
                  CornerRadius="12"
                  ItemsSource="{Binding SortOptions}"
                  SelectedValue="{Binding SelectedSortOrder}"
                  SelectedValueBinding="{Binding Key}"
                  DisplayMemberBinding="{Binding Value}"
                  IsVisible="{Binding ShowContentFilters}" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="8"
            IsVisible="{Binding ShowGroupFilter}">
        <ComboBox Grid.Column="0"
                  ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedGroup}"
                  PlaceholderText="{loc:Translate Common.All}"
                  MinHeight="48"
                  CornerRadius="12" />
        <Button Grid.Column="1"
                MinWidth="48"
                MinHeight="48"
                Padding="12"
                CornerRadius="12"
                Background="{DynamicResource Surface0Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                Command="{Binding HideGroupCommand}"
                CommandParameter="{Binding SelectedGroup}"
                IsVisible="{Binding SelectedGroup, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                ToolTip.Tip="{loc:Translate Live.HideCategory.Tooltip}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <icons:MaterialIcon Kind="EyeOffOutline"
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Translate Live.HideCategory.Tooltip}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="13"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <ItemsControl ItemsSource="{Binding FilteredChannels}"
                    IsVisible="{Binding !IsContentLoading}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Channel">
            <Border Background="{DynamicResource Surface0Brush}"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
              <Grid RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="4">
                <!-- Row 0: Logo + Info + Favorite -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="56,*,Auto"
                      ColumnSpacing="10">
                  <Button Grid.ColumnSpan="3"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

                  <!-- Logo -->
                  <Border Width="44"
                          Height="44"
                          CornerRadius="12"
                          ClipToBounds="True"
                          Background="{DynamicResource Surface1Brush}"
                          IsHitTestVisible="False">
                    <Grid>
                      <icons:MaterialIcon Kind="Television"
                                          Foreground="{DynamicResource AccentBrush}"
                                          Width="20"
                                          Height="20" />
                      <controls:RemoteImage Url="{Binding CoverUrl}"
                                            Stretch="Uniform" />
                    </Grid>
                  </Border>

                  <!-- Name + Group -->
                  <StackPanel Grid.Column="1"
                              Spacing="3"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GroupTitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <!-- Favorite Button -->
                  <Button Grid.Column="2"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="14"
                          MinHeight="48"
                          MinWidth="48"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                          CommandParameter="{Binding}"
                          ZIndex="10">
                    <Grid>
                      <icons:MaterialIcon Kind="Heart"
                                          Width="20"
                                          Height="20"
                                          Foreground="#E50914"
                                          IsVisible="{Binding IsFavorite}" />
                      <icons:MaterialIcon Kind="HeartOutline"
                                          Width="20"
                                          Height="20"
                                          Foreground="{DynamicResource TextMutedBrush}"
                                          IsVisible="{Binding !IsFavorite}" />
                    </Grid>
                  </Button>
                </Grid>

                <!-- Row 1: EPG Title -->
                <TextBlock Grid.Row="1"
                           Text="{Binding CurrentProgramTitle}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12"
                           FontWeight="Medium"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.85"
                           Margin="0,2,0,0"
                           IsVisible="{Binding CurrentProgramTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                <!-- Row 2: EPG Progress Bar -->
                <ProgressBar Grid.Row="2"
                             Value="{Binding EpgProgress}"
                             Minimum="0"
                             Maximum="100"
                             Height="3"
                             Background="{DynamicResource Surface1Brush}"
                             Foreground="{DynamicResource AccentBrush}"
                             BorderThickness="0"
                             CornerRadius="1.5"
                             IsVisible="{Binding CurrentProgramTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="10"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding IsContentLoading}">
        <controls:PremiumSpinner Width="56" Height="56" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:Translate Live.Loading}"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>

      <StackPanel Spacing="8"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding ShowEmptyChannels}">
        <TextBlock Text="{loc:Translate Live.Empty.Title}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Text="{loc:Translate Live.Empty.Description}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
