<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:models="using:Noctra.Models"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileLiveView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <UserControl.Resources>
    <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
  </UserControl.Resources>

  <ScrollViewer x:Name="LiveScrollViewer"
                ScrollChanged="LiveScrollViewer_ScrollChanged">
    <!-- Increase margins and spacing to better emulate the desktop layout -->
    <StackPanel Margin="24" Spacing="20">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Desktop-inspired title styling: bold with subtle letter spacing -->
        <TextBlock Text="{loc:Translate Live.Title}"
                   FontSize="24"
                   FontWeight="Bold"
                   LetterSpacing="1"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <ComboBox Grid.Column="1"
                  Theme="{StaticResource ModernComboBox}"
                  Width="150"
                  MinHeight="48"
                  CornerRadius="12"
                  ItemsSource="{Binding SortOptions}"
                  SelectedValue="{Binding SelectedSortOrder}"
                  SelectedValueBinding="{Binding Key}"
                  DisplayMemberBinding="{Binding Value}"
                  IsVisible="{Binding ShowContentFilters}" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="8"
            IsVisible="{Binding ShowGroupFilter}">
        <ComboBox Grid.Column="0"
                  x:Name="GroupFilterComboBox"
                  Theme="{StaticResource ModernComboBox}"
                  ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedGroup}"
                  PlaceholderText="{loc:Translate Common.All}"
                  MinHeight="48"
                  CornerRadius="12">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}"
                         VerticalAlignment="Center"
                         Padding="12,8" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1"
                Content="{loc:Translate Common.All}"
                MinWidth="64"
                MinHeight="48"
                Padding="12"
                CornerRadius="12"
                Background="{DynamicResource Surface0Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                Click="ClearGroupSelection_Click" />
      </Grid>

      <ItemsControl ItemsSource="{Binding FilteredChannels}"
                    IsVisible="{Binding !IsContentLoading}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Channel">
            <controls:MobileLiveTvCard Margin="0,0,16,0"
                                       Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=liveWidth}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Loading state: mirror desktop with two lines of status text -->
      <StackPanel Spacing="16"
                  Margin="0,80,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding IsContentLoading}">
        <controls:PremiumSpinner Width="56" Height="56" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:Translate Live.Loading}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextAlignment="Center" />
        <TextBlock Text="{loc:Translate Live.LoadingDetail}"
                   FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Opacity="0.6"
                   TextAlignment="Center" />
      </StackPanel>

      <StackPanel Spacing="12"
                  Margin="0,96,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding ShowEmptyChannels}">
        <!-- Add a television icon similar to desktop empty state -->
        <icons:MaterialIcon Kind="Television"
                            Width="64"
                            Height="64"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Opacity="0.5" />
        <TextBlock Text="{loc:Translate Live.Empty.Title}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   LetterSpacing="1"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextAlignment="Center" />
        <TextBlock Text="{loc:Translate Live.Empty.Description}"
                   FontSize="14"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
