<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:player="using:Noctra.UI.Views.Player"
             x:Class="Noctra.Mobile.Views.MobilePlayerTopOverlay"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <player:PlayerTopOverlay DataContext="{Binding}"
                           ShowLockAction="True"
                           ShowPiPAction="True" />
</UserControl>
