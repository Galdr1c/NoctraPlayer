<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobilePlayerTopOverlay"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <!--
    Mirrors the desktop top bar (Noctra.Avalonia/Views/VideoOverlayView.axaml):
    back/close + title on the left, network status + live clock on the right.
    PiP/Fullscreen live in the bottom control row on desktop, so they live in
    MobilePlayerCompactControls here too - not up here.
  -->
  <UserControl.Styles>
    <Style Selector="Button.topFlatIcon">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.topFlatIcon:pressed">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,1*,Auto" ColumnSpacing="6" Margin="10,14,16,0">
    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
      <Button Classes="topFlatIcon" Command="{Binding CloseCommand}">
        <icons:MaterialIcon Kind="KeyboardBackspace" Width="24" Height="24" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
      </Button>
      <StackPanel Spacing="2" VerticalAlignment="Center" Margin="2,0,0,0">
        <TextBlock Text="{Binding CurrentChannel.Name}"
                   Foreground="{DynamicResource PlayerOverlayTextBrush}"
                   FontSize="17"
                   FontWeight="Bold"
                   LetterSpacing="0.1"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="190"
                   MaxLines="1" />
        <TextBlock Text="{Binding ConnectionStatus}"
                   Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                   FontSize="11"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="190"
                   MaxLines="1" />
      </StackPanel>
    </StackPanel>

    <!-- Quality badge: mobile-only touch (desktop shows this inline in its quality button instead). -->
    <StackPanel Grid.Column="2"
                Orientation="Horizontal"
                Spacing="14"
                VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal"
                  Spacing="4"
                  IsVisible="{Binding HasTopQualityBadgesReady}">
        <icons:MaterialIcon Kind="HighDefinition" Width="16" Height="16" Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}" />
        <TextBlock Text="{Binding QualityResolutionText}"
                   Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>

      <!-- Network status, same as desktop's top-right cluster. -->
      <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Opacity="0.85">
        <icons:MaterialIcon Kind="{Binding NetworkIcon}" Width="15" Height="15" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
        <TextBlock Text="{Binding NetworkStatus}"
                   Foreground="{DynamicResource PlayerOverlayTextBrush}"
                   FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Live clock, same as desktop's CurrentTimeStr. -->
      <TextBlock Text="{Binding CurrentTimeStr}"
                 Foreground="{DynamicResource PlayerOverlayTextBrush}"
                 FontSize="15" FontWeight="Bold"
                 VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
