<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:Noctra.Mobile.Localization"
             x:Class="Noctra.Mobile.Views.MobileLegalDocumentView"
             mc:Ignorable="d">
  <Grid Background="{DynamicResource OverlayModalDimBrush}">
    <Border Background="{DynamicResource BackgroundGradientBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="24,44,24,44"
            ClipToBounds="True"
            MaxWidth="520">
      <Grid RowDefinitions="Auto,*,Auto"
            Margin="22">
        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12"
              Margin="0,0,0,16">
          <icons:MaterialIcon Kind="FileDocumentOutline"
                              Width="28"
                              Height="28"
                              Foreground="{DynamicResource AccentBrush}"
                              VerticalAlignment="Center" />
          <TextBlock x:Name="TitleTextBlock"
                     Grid.Column="1"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="{DynamicResource FTitleM}"
                     FontWeight="Bold"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <Button Grid.Column="2"
                  Width="44"
                  Height="44"
                  Padding="0"
                  Background="Transparent"
                  BorderThickness="0"
                  Click="Close_Click"
                  AutomationProperties.Name="{loc:Translate Common.Close}"
                  AutomationProperties.HelpText="{loc:Translate Common.Close}">
            <icons:MaterialIcon Kind="Close"
                                Width="20"
                                Height="20"
                                Foreground="{DynamicResource TextMutedBrush}" />
          </Button>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="BodyTextBlock"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="{DynamicResource FCaption}"
                       LineHeight="15"
                       TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>

        <Button Grid.Row="2"
                Content="{loc:Translate Dialog.Ok}"
                Classes="SettingsPrimaryActionButton"
                Margin="0,16,0,0"
                FontWeight="SemiBold"
                Click="Close_Click" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
