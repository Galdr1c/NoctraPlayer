<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:models="using:Noctra.Models"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:avaloniaConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:behaviors="using:Noctra.Mobile.Behaviors"
             xmlns:views="using:Noctra.Mobile.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileDownloadsView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True"
             mc:Ignorable="d">
  <UserControl.Resources>
    <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Touch feedback for whole-card open buttons -->
    <Style Selector="Button:pressed Border#EpBgLayer">
      <Setter Property="Background" Value="{DynamicResource InteractivePressedBrush}" />
      <Setter Property="Opacity" Value="1.0" />
    </Style>
  </UserControl.Styles>

  <Grid>
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="20">

      <!-- Title -->
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Translate Downloads.Title}"
                   FontSize="{DynamicResource FDisplaySmall}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding TotalDownloadsInfoText}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="{DynamicResource FCaption}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasDownloadedItems}" />
      </StackPanel>

      <!-- Storage Card (always visible, buttons hidden when empty) -->
      <Border Background="{DynamicResource Surface0Brush}"
              CornerRadius="8"
              Padding="20"
              Margin="0,0,0,24"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              ClipToBounds="True"
              IsVisible="{Binding StorageUsageDetailText, Converter={x:Static avaloniaConverters:StringConverters.IsNotNullOrEmpty}}">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
          <!-- Icon -->
          <icons:MaterialIcon Kind="Database"
                                Foreground="{DynamicResource AccentBrush}"
                                Width="48"
                                Height="48" />
          <StackPanel Grid.Column="1"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{loc:Translate Downloads.Storage.Title}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontWeight="SemiBold"
                         FontSize="{DynamicResource FTitleL}" />
            </Grid>
            <!-- Progress Bar -->
            <Border Height="8"
                    Background="{DynamicResource Bg1Brush}"
                    CornerRadius="2"
                    ClipToBounds="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding StorageOtherPercent, Converter={StaticResource DoubleToStarGridLengthConverter}}" />
                  <ColumnDefinition Width="{Binding StorageNoctraPercent, Converter={StaticResource DoubleToStarGridLengthConverter}}" />
                  <ColumnDefinition Width="{Binding StoragePendingPercent, Converter={StaticResource DoubleToStarGridLengthConverter}}" />
                  <ColumnDefinition Width="{Binding StorageFreePercent, Converter={StaticResource DoubleToStarGridLengthConverter}}" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Fill="{DynamicResource AccentLightBrush}" />
                <Rectangle Grid.Column="1" Fill="{DynamicResource AccentBrush}" />
                <Rectangle Grid.Column="2" Fill="{DynamicResource AccentBrush}" Opacity="0.5" />
                <Rectangle Grid.Column="3" Fill="Transparent" />
              </Grid>
            </Border>
            <WrapPanel HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,0">
                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentLightBrush}" />
                <TextBlock Text="{loc:Translate Downloads.Storage.Other}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FOverline}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,0">
                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                <TextBlock Text="{loc:Translate Downloads.Storage.Noctra}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FOverline}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,0">
                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.5" />
                <TextBlock Text="{loc:Translate Downloads.Storage.Pending}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FOverline}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="10" Height="10" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource TextMutedBrush}" Opacity="0.3" />
                <TextBlock Text="{loc:Translate Downloads.Storage.Free}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FOverline}" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
          <StackPanel Grid.Column="2"
                      Orientation="Vertical"
                      Spacing="8"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center">
            <Button Command="{Binding DeleteAllDownloadsCommand}"
                    Theme="{StaticResource DangerButtonStyle}"
                    FontSize="{DynamicResource FCaption}"
                    Padding="8,2"
                    IsVisible="{Binding HasDownloadedItems}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <icons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
                <TextBlock Text="{loc:Translate Downloads.Action.DeleteAll}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Storage Warning -->
      <Border Background="{DynamicResource DangerSubtleBrush}"
              CornerRadius="6"
              Padding="10,6"
              IsVisible="{Binding ShowStorageWarning}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <icons:MaterialIcon Kind="AlertCircleOutline"
                              Width="14"
                              Height="14"
                              Foreground="{DynamicResource ErrorBrush}" />
          <TextBlock Text="{loc:Translate Downloads.Storage.Warning}"
                     Foreground="{DynamicResource ErrorBrush}"
                     FontSize="{DynamicResource FCaption}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Empty State (shown when no downloads) -->
      <controls:MobileEmptyStateView
                  IsVisible="{Binding ShowDownloadsEmptyState}"
                  IconKind="DownloadOffOutline"
                  Title="{loc:Translate Downloads.Empty.Title}"
                  Description="{loc:Translate Downloads.Empty.Description}" />

      <!-- Download content tabs (hidden when empty) -->
      <TabControl SelectedIndex="{Binding DownloadTabIndex, Mode=TwoWay}"
                  behaviors:MobileTabSlideTransitionBehavior.IsEnabled="True"
                  Background="Transparent"
                  Padding="0"
                  IsVisible="{Binding HasAnyDownloadState}">
        <TabItem Classes="downloadTab" Header="{loc:Translate Downloads.Tabs.Library}">
          <StackPanel Spacing="14"
                      Margin="0,14,0,0">

            <!-- Sort -->
            <Button x:Name="DownloadSortSelectionButton"
                    Classes="SortIconButton"
                    Click="OpenDownloadSortSheet_Click"
                    AutomationProperties.Name="{loc:Translate Downloads.Sort.Title}"
                    AutomationProperties.HelpText="{loc:Translate Downloads.Sort.Title}">
              <icons:MaterialIcon x:Name="DownloadSortSelectionIcon"
                                  Kind="Sort"
                                  Width="24"
                                  Height="24"
                                  Foreground="{DynamicResource TextPrimaryBrush}" />
            </Button>

            <!-- Series Section -->
            <StackPanel Spacing="12"
                        IsVisible="{Binding DownloadedSeriesItems.Count, Converter={StaticResource CountToVisibility}}">
              <TextBlock Text="{loc:Translate History.Series}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="{DynamicResource FTitleL}"
                         FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding DownloadedSeriesItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:Series">
                    <!-- Card: the WHOLE card opens the item; only the trash
                         button is a separate hit target (no dead zones). -->
                    <Border Background="{DynamicResource Surface0Brush}"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,16">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="2">
                        <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                          <Panel>
                            <!-- No local Background here: an inline value would
                                 out-prioritize the :pressed style setter. -->
                            <Border x:Name="EpBgLayer" CornerRadius="2" />
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10">
                              <Border Width="48"
                                      Height="56"
                                      CornerRadius="2"
                                      ClipToBounds="True"
                                      Background="{DynamicResource Surface1Brush}">
                                <Grid>
                                  <controls:RemoteImage Url="{Binding CoverUrl}"
                                                        Stretch="UniformToFill"
                                                        RenderOptions.BitmapInterpolationMode="MediumQuality" />
                                </Grid>
                              </Border>
                              <StackPanel Grid.Column="1"
                                          Spacing="4"
                                          VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LocalSizeText}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="{DynamicResource FCaption}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <icons:MaterialIcon Grid.Column="2"
                                                  Kind="ChevronRight"
                                                  Foreground="{DynamicResource TextMutedBrush}"
                                                  Width="24"
                                                  Height="24"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                            </Grid>
                          </Panel>
                        </Button>
                        <Button Grid.Column="1"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteDownloadedMediaCommand}"
                                CommandParameter="{Binding}"
                                BorderThickness="0"
                                Padding="8,0"
                                MinHeight="48"
                                Theme="{StaticResource DangerButtonStyle}"
                                FontSize="{DynamicResource FCaption}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="TrashCanOutline" Width="18" Height="18" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Movies Section -->
            <StackPanel Spacing="12"
                        IsVisible="{Binding DownloadedVodChannels.Count, Converter={StaticResource CountToVisibility}}">
              <TextBlock Text="{loc:Translate History.Movies}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="{DynamicResource FTitleL}"
                         FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding DownloadedVodChannels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:Channel">
                    <!-- Card: the WHOLE card opens the item; only the trash
                         button is a separate hit target (no dead zones). -->
                    <Border Background="{DynamicResource Surface0Brush}"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,16">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="2">
                        <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                          <Panel>
                            <!-- No local Background here: an inline value would
                                 out-prioritize the :pressed style setter. -->
                            <Border x:Name="EpBgLayer" CornerRadius="2" />
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10">
                              <Border Width="48"
                                      Height="64"
                                      CornerRadius="2"
                                      ClipToBounds="True"
                                      Background="{DynamicResource Surface1Brush}">
                                <Grid>
                                  <controls:RemoteImage Url="{Binding CoverUrl}"
                                                        Stretch="UniformToFill"
                                                        RenderOptions.BitmapInterpolationMode="MediumQuality" />
                                </Grid>
                              </Border>
                              <StackPanel Grid.Column="1"
                                          Spacing="4"
                                          VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LocalSizeText}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="{DynamicResource FCaption}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <icons:MaterialIcon Grid.Column="2"
                                                  Kind="PlayOutline"
                                                  Foreground="{DynamicResource TextMutedBrush}"
                                                  Width="24"
                                                  Height="24"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                            </Grid>
                          </Panel>
                        </Button>
                        <Button Grid.Column="1"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteDownloadedMediaCommand}"
                                CommandParameter="{Binding}"
                                BorderThickness="0"
                                Padding="8,0"
                                MinHeight="48"
                                Theme="{StaticResource DangerButtonStyle}"
                                FontSize="{DynamicResource FCaption}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="TrashCanOutline" Width="18" Height="18" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

          </StackPanel>
        </TabItem>
        <!-- TABS CONTENT: DOWNLOAD CENTER -->
        <TabItem Classes="downloadTab">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <TextBlock Text="{loc:Translate Downloads.Tabs.Center}" />
              <Border Classes="AccentBadge"
                      IsVisible="{Binding ActiveDownloadCount, Converter={StaticResource CountToVisibility}}">
                <TextBlock Text="{Binding ActiveDownloadCount}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="{DynamicResource FOverline}"
                           FontWeight="Bold" />
              </Border>
            </StackPanel>
          </TabItem.Header>

          <StackPanel Spacing="14"
                      Margin="0,14,0,0">
            <!-- Ongoing Section -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10"
                  IsVisible="{Binding ActiveDownloadingItems.Count, Converter={StaticResource CountToVisibility}}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{loc:Translate Downloads.Ongoing.Title}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="{DynamicResource FTitleL}"
                           FontWeight="Bold" />
                <Border Classes="Badge"
                        VerticalAlignment="Center"
                        IsVisible="{Binding ActiveDownloadingItems.Count, Converter={StaticResource CountToVisibility}}">
                  <TextBlock Text="{Binding ActiveDownloadingItems.Count, Converter={StaticResource StringFormatConverter}, ConverterParameter='Downloads.Ongoing.Count.Format'}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="{DynamicResource FCaption}" />
                </Border>
              </StackPanel>
              <Button Grid.Column="1"
                      Command="{Binding StopAllDownloadsCommand}"
                      Theme="{StaticResource DangerButtonStyle}"
                      Padding="8,0"
                      FontSize="{DynamicResource FCaption}"
                      IsVisible="{Binding ActiveDownloadCount, Converter={StaticResource CountToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:MaterialIcon Kind="Close" Width="16" Height="16" />
                  <TextBlock Text="{loc:Translate Downloads.Action.StopAll}" />
                </StackPanel>
              </Button>
            </Grid>

            <controls:MobileEmptyStateView
                        IsVisible="{Binding ActiveDownloadCount, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"
                        IconKind="ProgressDownload"
                        Title="{loc:Translate Downloads.Ongoing.Empty.Title}"
                        Description="{loc:Translate Downloads.Ongoing.Empty.Description}" />

            <ItemsControl ItemsSource="{Binding ActiveDownloadingItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadItem">
                  <Border Background="{DynamicResource Surface0Brush}"
                          CornerRadius="8"
                          Padding="16"
                          Margin="0,0,0,12">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10">
                        <Border Width="48"
                                Height="64"
                                CornerRadius="6"
                                ClipToBounds="True"
                                Background="{DynamicResource Surface1Brush}">
                          <Grid>
                            <icons:MaterialIcon Kind="Download"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Width="24"
                                                Height="24"
                                                Opacity="0.35" />
                            <controls:RemoteImage Url="{Binding PosterUrl}"
                                                  Stretch="UniformToFill"
                                                  RenderOptions.BitmapInterpolationMode="MediumQuality" />
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{Binding BaseDisplayName}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding ., Converter={StaticResource DownloadStatusToLocalizedTextConverter}}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     FontSize="{DynamicResource FCaption}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ProgressText}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" />
                      </Grid>

                      <ProgressBar Minimum="0"
                                   Maximum="100"
                                   Height="6"
                                   Value="{Binding ProgressPercent}"
                                   Foreground="{Binding Status, Converter={StaticResource DownloadStatusToBrushConverter}}" />

                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding SizeText}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     FontSize="{DynamicResource FCaption}" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding ., Converter={StaticResource DownloadSpeedTextConverter}}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="{DynamicResource FCaption}" />
                            <TextBlock Text="•"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="{DynamicResource FCaption}"
                                       Opacity="0.5"
                                       IsVisible="{Binding SpeedBytesPerSecond, Converter={StaticResource CountToVisibility}}" />
                            <TextBlock Text="{Binding ., Converter={StaticResource DownloadEtaTextConverter}}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="{DynamicResource FCaption}" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                          <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).TogglePauseDownloadCommand}"
                                  CommandParameter="{Binding}"
                                  Classes="SettingsActionButton"
                                  MinHeight="48"
                                  Padding="4,0"
                                  FontSize="{DynamicResource FCaption}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="{Binding IsPaused, Converter={StaticResource BoolToMaterialIconKindConverter}, ConverterParameter='Play|Pause'}"
                                                  Width="16"
                                                  Height="16" />
                              <TextBlock Text="{Binding IsPaused, Converter={StaticResource BoolToLocalizedStringConverter}, ConverterParameter='Downloads.Action.Resume|Downloads.Action.Pause'}" />
                            </StackPanel>
                          </Button>
                          <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CancelDownloadCommand}"
                                  CommandParameter="{Binding}"
                                  Theme="{StaticResource DangerButtonStyle}"
                                  MinHeight="48"
                                  Padding="4,0"
                                  FontSize="{DynamicResource FCaption}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="Close" Width="16" Height="16" />
                              <TextBlock Text="{loc:Translate Downloads.Action.Cancel}" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Queue Section -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10"
                  IsVisible="{Binding QueuedDownloadItems.Count, Converter={StaticResource CountToVisibility}}">
              <TextBlock Text="{loc:Translate Downloads.Queue.Title}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="{DynamicResource FTitleL}"
                         FontWeight="SemiBold" />
              <Button Grid.Column="1"
                      Command="{Binding ClearQueueCommand}"
                      MinHeight="44"
                      Padding="12,0"
                      Background="{DynamicResource Surface1Brush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0"
                      CornerRadius="6"
                      FontSize="{DynamicResource FCaption}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:MaterialIcon Kind="Close" Width="16" Height="16" />
                  <TextBlock Text="{loc:Translate Downloads.Action.ClearQueue}" />
                </StackPanel>
              </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding QueuedDownloadItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadItem">
                  <Border Background="{DynamicResource Surface0Brush}"
                          CornerRadius="8"
                          Padding="12"
                          Margin="0,0,0,8"
                          Opacity="0.8">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                          ColumnSpacing="10">
                      <TextBlock Text="{Binding QueueOrder}"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center" />
                      <Border Grid.Column="1"
                              Width="32"
                              Height="32"
                              CornerRadius="6"
                              ClipToBounds="True"
                              Background="{DynamicResource Surface1Brush}">
                        <Grid>
                          <icons:MaterialIcon Kind="Download"
                                              Foreground="{DynamicResource TextMutedBrush}"
                                              Width="16"
                                              Height="16"
                                              Opacity="0.35" />
                          <controls:RemoteImage Url="{Binding PosterUrl}"
                                                Stretch="UniformToFill"
                                                RenderOptions.BitmapInterpolationMode="MediumQuality" />
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="2"
                                  Spacing="2">
                        <TextBlock Text="{Binding BaseDisplayName}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ., Converter={StaticResource DownloadStatusToLocalizedTextConverter}}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="{DynamicResource FCaption}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="3"
                                  Orientation="Horizontal"
                                  Spacing="10"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding BytesTotal, Converter={StaticResource BytesToHumanConverter}}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="{DynamicResource FCaption}"
                                   VerticalAlignment="Center" />
                        <Button
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CancelDownloadCommand}"
                              CommandParameter="{Binding}"
                              MinHeight="48"
                              Padding="10,0"
                              Background="Transparent"
                              Foreground="{DynamicResource ErrorBrush}"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource ErrorBrush}"
                              CornerRadius="8"
                              FontSize="{DynamicResource FCaption}">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                            <TextBlock Text="{loc:Translate Downloads.Action.Cancel}" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Failed Section -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10"
                  IsVisible="{Binding FailedDownloadItems.Count, Converter={StaticResource CountToVisibility}}">
              <TextBlock Text="{loc:Translate Downloads.Failed.Title}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="{DynamicResource FTitleL}"
                         FontWeight="SemiBold" />
            </Grid>

            <ItemsControl ItemsSource="{Binding FailedDownloadItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadItem">
                  <Border Background="{DynamicResource Surface0Brush}"
                          CornerRadius="8"
                          Padding="12"
                          Margin="0,0,0,8">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10">
                        <Border Width="48"
                                Height="64"
                                CornerRadius="6"
                                ClipToBounds="True"
                                Background="{DynamicResource Surface1Brush}">
                          <Grid>
                            <icons:MaterialIcon Kind="AlertCircleOutline"
                                                Foreground="{DynamicResource ErrorBrush}"
                                                Width="24"
                                                Height="24"
                                                Opacity="0.7" />
                            <controls:RemoteImage Url="{Binding PosterUrl}"
                                                  Stretch="UniformToFill"
                                                  RenderOptions.BitmapInterpolationMode="MediumQuality" />
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding BaseDisplayName}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding ErrorMessage}"
                                     Foreground="{DynamicResource ErrorBrush}"
                                     FontSize="{DynamicResource FCaption}"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding ErrorMessage, Converter={x:Static avaloniaConverters:StringConverters.IsNotNullOrEmpty}}" />
                          <TextBlock Text="{Binding SizeText, Converter={StaticResource StringFormatConverter}, ConverterParameter='Downloads.Failed.SizeFormat'}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     FontSize="{DynamicResource FCaption}" />
                        </StackPanel>
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">
                        <TextBlock Text="{Binding ., Converter={StaticResource DownloadStatusToLocalizedTextConverter}}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="{DynamicResource FCaption}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                          <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RetryDownloadCommand}"
                                  CommandParameter="{Binding}"
                                  Theme="{StaticResource PrimaryButtonStyle}"
                                  VerticalContentAlignment="Center"
                                  FontSize="{DynamicResource FCaption}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                              <TextBlock Text="{loc:Translate Downloads.Failed.Retry}" />
                            </StackPanel>
                          </Button>
                          <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CancelDownloadCommand}"
                                  CommandParameter="{Binding}"
                                  Theme="{StaticResource DangerButtonStyle}"
                                  FontSize="{DynamicResource FCaption}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="Close" Width="16" Height="16" />
                              <TextBlock Text="{loc:Translate Downloads.Action.Delete}" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
  <views:MobileSelectionSheet x:Name="SelectionSheetHost"
                              ZIndex="{x:Static controls:MobileZIndex.SelectionSheet}"
                              IsVisible="False" />
  </Grid>
</UserControl>
