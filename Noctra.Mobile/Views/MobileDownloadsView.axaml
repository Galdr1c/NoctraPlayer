<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:avaloniaConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:behaviors="using:Noctra.Mobile.Behaviors"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileDownloadsView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <UserControl.Resources>
    <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Translate Downloads.Title}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding TotalDownloadsInfoText}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   TextWrapping="Wrap" />
      </StackPanel>

      <TabControl SelectedIndex="{Binding DownloadTabIndex, Mode=TwoWay}"
                  behaviors:MobileTabSlideTransitionBehavior.IsEnabled="True"
                  Background="Transparent"
                  Padding="0">
        <TabItem Header="{loc:Translate Downloads.Tabs.Library}">
          <StackPanel Spacing="14"
                      Margin="0,14,0,0">

            <!-- Storage Info -->
            <Border Background="{DynamicResource Surface0Brush}"
                    CornerRadius="16"
                    Padding="16"
                    IsVisible="{Binding StorageUsageDetailText, Converter={x:Static avaloniaConverters:StringConverters.IsNotNullOrEmpty}}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="36"
                        Height="36"
                        CornerRadius="18"
                        Background="{DynamicResource Surface1Brush}">
                  <icons:MaterialIcon Kind="Harddisk"
                                      Foreground="{DynamicResource AccentBrush}"
                                      Width="20"
                                      Height="20" />
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="12,0"
                            VerticalAlignment="Center"
                            Spacing="4">
                  <TextBlock Text="{Binding StorageUsageDetailText}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontWeight="SemiBold"
                             FontSize="13" />
                  <TextBlock Text="{Binding StorageNoctraDetailText}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="11" />
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding OpenDownloadsFolderCommand}"
                        MinHeight="34"
                        Padding="12,0"
                        Background="{DynamicResource Surface1Brush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderThickness="0"
                        CornerRadius="8"
                        FontSize="12">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                    <TextBlock Text="{loc:Translate Downloads.Action.OpenFolder}" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Border Background="#33FF4444"
                    CornerRadius="10"
                    Padding="10,7"
                    IsVisible="{Binding ShowStorageWarning}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <icons:MaterialIcon Kind="AlertCircleOutline"
                                    Width="16"
                                    Height="16"
                                    Foreground="{DynamicResource ErrorBrush}" />
                <TextBlock Text="{loc:Translate Downloads.Storage.Warning}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- Delete All -->
            <Button Command="{Binding DeleteAllDownloadsCommand}"
                    HorizontalAlignment="Right"
                    MinHeight="34"
                    Padding="14,0"
                    Background="Transparent"
                    Foreground="{DynamicResource ErrorBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ErrorBrush}"
                    CornerRadius="8"
                    FontSize="12">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
                <TextBlock Text="{loc:Translate Downloads.Action.DeleteAll}" />
              </StackPanel>
            </Button>

            <!-- Sort -->
            <ComboBox SelectedIndex="{Binding SelectedDownloadSortOrder}"
                      MinHeight="44"
                      PlaceholderText="{loc:Translate Downloads.Sort.Recent}">
              <ComboBoxItem Content="{loc:Translate Downloads.Sort.Recent}" />
              <ComboBoxItem Content="{loc:Translate Downloads.Sort.Name}" />
              <ComboBoxItem Content="{loc:Translate Downloads.Sort.Size}" />
            </ComboBox>

            <!-- Series Section -->
            <StackPanel Spacing="8"
                        IsVisible="{Binding DownloadedSeriesItems.Count, Converter={StaticResource CountToVisibility}}">
              <TextBlock Text="{loc:Translate History.Series}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="12"
                         FontWeight="Bold"
                         LetterSpacing="1" />
              <ItemsControl ItemsSource="{Binding DownloadedSeriesItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:Series">
                    <Border Background="{DynamicResource Surface0Brush}"
                            CornerRadius="16"
                            Padding="14"
                            Margin="0,0,0,10">
                      <Grid ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="10">
                        <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalContentAlignment="Stretch">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LocalSizeText}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteDownloadedMediaCommand}"
                                CommandParameter="{Binding}"
                                MinHeight="34"
                                Padding="12,0"
                                Background="Transparent"
                                Foreground="{DynamicResource ErrorBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ErrorBrush}"
                                CornerRadius="8"
                                FontSize="12">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
                            <TextBlock Text="{loc:Translate Downloads.Action.Delete}" />
                          </StackPanel>
                        </Button>
                        <icons:MaterialIcon Grid.Column="2"
                                            Kind="ChevronRight"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Width="18"
                                            Height="18"
                                            Opacity="0.55"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Movies Section -->
            <StackPanel Spacing="8"
                        IsVisible="{Binding DownloadedVodChannels.Count, Converter={StaticResource CountToVisibility}}">
              <TextBlock Text="{loc:Translate History.Movies}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="12"
                         FontWeight="Bold"
                         LetterSpacing="1" />
              <ItemsControl ItemsSource="{Binding DownloadedVodChannels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:Channel">
                    <Border Background="{DynamicResource Surface0Brush}"
                            CornerRadius="16"
                            Padding="14"
                            Margin="0,0,0,10">
                      <Grid ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="10">
                        <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalContentAlignment="Stretch">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LocalSizeText}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteDownloadedMediaCommand}"
                                CommandParameter="{Binding}"
                                MinHeight="34"
                                Padding="12,0"
                                Background="Transparent"
                                Foreground="{DynamicResource ErrorBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ErrorBrush}"
                                CornerRadius="8"
                                FontSize="12">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
                            <TextBlock Text="{loc:Translate Downloads.Action.Delete}" />
                          </StackPanel>
                        </Button>
                        <icons:MaterialIcon Grid.Column="2"
                                            Kind="PlayCircleOutline"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Width="20"
                                            Height="20"
                                            Opacity="0.8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Empty State -->
            <StackPanel Spacing="8"
                        Margin="0,60,0,0"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding ShowDownloadsEmptyState}">
              <icons:MaterialIcon Kind="DownloadOffOutline"
                                  Width="64"
                                  Height="64"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  Opacity="0.5"
                                  HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Translate Downloads.Empty.Title}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="{loc:Translate Downloads.Empty.Description}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </TabItem>

        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
              <TextBlock Text="{loc:Translate Downloads.Tabs.Center}" />
              <Border Background="{DynamicResource AccentHoverBrush}"
                      CornerRadius="10"
                      Padding="6,1">
                <TextBlock Text="{Binding ActiveDownloadCount}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="10"
                           FontWeight="Bold" />
              </Border>
            </StackPanel>
          </TabItem.Header>

          <StackPanel Spacing="14"
                      Margin="0,14,0,0">
            <Border Background="{DynamicResource Surface0Brush}"
                    CornerRadius="16"
                    Padding="14">
              <Grid ColumnDefinitions="Auto,*,Auto"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="10"
                    RowSpacing="4">
                <icons:MaterialIcon Grid.RowSpan="2"
                                    Kind="Speedometer"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{loc:Translate Downloads.Stats.Speed.Label}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ActiveDownloadCount, Converter={StaticResource StringFormatConverter}, ConverterParameter='Downloads.Stats.Active.Format'}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding ActiveDownloadsTotalSpeedText}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12" />
              </Grid>
            </Border>

            <!-- Ongoing Section -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
              <TextBlock Text="{loc:Translate Downloads.Ongoing.Title}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <Button Grid.Column="1"
                      Command="{Binding StopAllDownloadsCommand}"
                      MinHeight="34"
                      Padding="12,0"
                      Background="{DynamicResource Surface1Brush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0"
                      CornerRadius="8"
                      FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:MaterialIcon Kind="Close" Width="16" Height="16" />
                  <TextBlock Text="{loc:Translate Downloads.Action.StopAll}" />
                </StackPanel>
              </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding ActiveDownloadingItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadItem">
                  <Border Background="{DynamicResource Surface0Brush}"
                          CornerRadius="16"
                          Padding="14"
                          Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding BaseDisplayName}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding StatusText}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     FontSize="12"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProgressText}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" />
                      </Grid>

                      <ProgressBar Minimum="0"
                                   Maximum="100"
                                   Height="6"
                                   Value="{Binding ProgressPercent}" />

                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding SizeText}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     FontSize="12" />
                          <TextBlock Text="{Binding SpeedText}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                          <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).TogglePauseDownloadCommand}"
                                  CommandParameter="{Binding}"
                                  MinHeight="34"
                                  Padding="12,0"
                                  Background="{DynamicResource Surface1Brush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderThickness="0"
                                  CornerRadius="8"
                                  FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="Play" Width="16" Height="16" IsVisible="{Binding IsPaused}" />
                              <icons:MaterialIcon Kind="Pause" Width="16" Height="16" IsVisible="{Binding !IsPaused}" />
                              <TextBlock Text="{loc:Translate Downloads.Action.Pause}" />
                            </StackPanel>
                          </Button>
                          <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CancelDownloadCommand}"
                                  CommandParameter="{Binding}"
                                  MinHeight="34"
                                  Padding="12,0"
                                  Background="Transparent"
                                  Foreground="{DynamicResource ErrorBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource ErrorBrush}"
                                  CornerRadius="8"
                                  FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <icons:MaterialIcon Kind="Close" Width="16" Height="16" />
                              <TextBlock Text="{loc:Translate Downloads.Action.Cancel}" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Queue Section -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10"
                  IsVisible="{Binding QueuedDownloadItems.Count, Converter={StaticResource CountToVisibility}}">
              <TextBlock Text="{loc:Translate Downloads.Queue.Title}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <Button Grid.Column="1"
                      Command="{Binding ClearQueueCommand}"
                      MinHeight="34"
                      Padding="12,0"
                      Background="{DynamicResource Surface1Brush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0"
                      CornerRadius="8"
                      FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:MaterialIcon Kind="Close" Width="16" Height="16" />
                  <TextBlock Text="{loc:Translate Downloads.Action.ClearQueue}" />
                </StackPanel>
              </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding QueuedDownloadItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadItem">
                  <Border Background="{DynamicResource Surface0Brush}"
                          CornerRadius="14"
                          Padding="12"
                          Margin="0,0,0,8"
                          Opacity="0.8">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10">
                      <TextBlock Text="{Binding QueueOrder}"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1"
                                  Spacing="2">
                        <TextBlock Text="{Binding BaseDisplayName}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="2"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CancelDownloadCommand}"
                              CommandParameter="{Binding}"
                              MinHeight="32"
                              Padding="10,0"
                              Background="Transparent"
                              Foreground="{DynamicResource ErrorBrush}"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource ErrorBrush}"
                              CornerRadius="8"
                              FontSize="11">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                          <TextBlock Text="{loc:Translate Downloads.Action.Cancel}" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
