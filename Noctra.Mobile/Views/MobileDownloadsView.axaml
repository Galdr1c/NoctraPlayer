<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             x:Class="Noctra.Mobile.Views.MobileDownloadsView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14">
      <StackPanel Spacing="4">
        <TextBlock Text="Downloads"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF" />
        <TextBlock Text="{Binding TotalDownloadsInfoText}"
                   Foreground="#AEB5C5"
                   FontSize="12"
                   TextWrapping="Wrap" />
      </StackPanel>

      <ComboBox SelectedIndex="{Binding SelectedDownloadSortOrder}"
                MinHeight="44">
        <ComboBoxItem Content="Recent" />
        <ComboBoxItem Content="Name" />
        <ComboBoxItem Content="Size" />
      </ComboBox>

      <TextBlock Text="Series"
                 Foreground="#AEB5C5"
                 FontSize="12"
                 FontWeight="Bold" />
      <ItemsControl ItemsSource="{Binding DownloadedSeriesItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Series">
            <Border Background="#151923"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">
                <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                        CommandParameter="{Binding}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Name}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LocalSizeText}"
                               Foreground="#AEB5C5"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Content="Delete"
                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteDownloadedMediaCommand}"
                        CommandParameter="{Binding}"
                        MinHeight="38" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Movies"
                 Foreground="#AEB5C5"
                 FontSize="12"
                 FontWeight="Bold" />
      <ItemsControl ItemsSource="{Binding DownloadedVodChannels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Channel">
            <Border Background="#151923"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">
                <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                        CommandParameter="{Binding}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Name}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LocalSizeText}"
                               Foreground="#AEB5C5"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Content="Delete"
                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteDownloadedMediaCommand}"
                        CommandParameter="{Binding}"
                        MinHeight="38" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="8"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding ShowDownloadsEmptyState}">
        <TextBlock Text="No downloads"
                   Foreground="#FFFFFF"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Text="Downloaded movies and series will appear here."
                   Foreground="#AEB5C5"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
