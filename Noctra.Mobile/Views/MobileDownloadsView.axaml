<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             x:Class="Noctra.Mobile.Views.MobileDownloadsView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14">
      <StackPanel Spacing="4">
        <TextBlock Text="Downloads"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF" />
        <TextBlock Text="{Binding TotalDownloadsInfoText}"
                   Foreground="#AEB5C5"
                   FontSize="12"
                   TextWrapping="Wrap" />
      </StackPanel>

      <TabControl SelectedIndex="{Binding DownloadTabIndex, Mode=TwoWay}"
                  Background="Transparent"
                  Padding="0">
        <TabItem Header="Library">
          <StackPanel Spacing="14"
                      Margin="0,14,0,0">
            <ComboBox SelectedIndex="{Binding SelectedDownloadSortOrder}"
                      MinHeight="44">
              <ComboBoxItem Content="Recent" />
              <ComboBoxItem Content="Name" />
              <ComboBoxItem Content="Size" />
            </ComboBox>

            <TextBlock Text="Series"
                       Foreground="#AEB5C5"
                       FontSize="12"
                       FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding DownloadedSeriesItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Series">
                  <Border Background="#151923"
                          CornerRadius="16"
                          Padding="14"
                          Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                      <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                              CommandParameter="{Binding}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding Name}"
                                     Foreground="#FFFFFF"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding LocalSizeText}"
                                     Foreground="#AEB5C5"
                                     FontSize="12"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="1"
                              Content="Delete"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteDownloadedMediaCommand}"
                              CommandParameter="{Binding}"
                              MinHeight="38" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Movies"
                       Foreground="#AEB5C5"
                       FontSize="12"
                       FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding DownloadedVodChannels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Channel">
                  <Border Background="#151923"
                          CornerRadius="16"
                          Padding="14"
                          Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                      <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                              CommandParameter="{Binding}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding Name}"
                                     Foreground="#FFFFFF"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding LocalSizeText}"
                                     Foreground="#AEB5C5"
                                     FontSize="12"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="1"
                              Content="Delete"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteDownloadedMediaCommand}"
                              CommandParameter="{Binding}"
                              MinHeight="38" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="8"
                        Margin="0,60,0,0"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding ShowDownloadsEmptyState}">
              <TextBlock Text="No downloads"
                         Foreground="#FFFFFF"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="Downloaded movies and series will appear here."
                         Foreground="#AEB5C5"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </TabItem>

        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
              <TextBlock Text="Center" />
              <Border Background="#7C3AED"
                      CornerRadius="10"
                      Padding="6,1">
                <TextBlock Text="{Binding ActiveDownloadCount}"
                           Foreground="#FFFFFF"
                           FontSize="10"
                           FontWeight="Bold" />
              </Border>
            </StackPanel>
          </TabItem.Header>

          <StackPanel Spacing="14"
                      Margin="0,14,0,0">
            <Border Background="#151923"
                    CornerRadius="16"
                    Padding="14">
              <Grid ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="4">
                <TextBlock Text="Download Center"
                           Foreground="#FFFFFF"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ActiveDownloadCount, StringFormat='{}{0} active'}"
                           Foreground="#AEB5C5"
                           FontSize="12" />
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding ActiveDownloadsTotalSpeedText}"
                           Foreground="#AEB5C5"
                           FontSize="12" />
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
              <TextBlock Text="Ongoing"
                         Foreground="#FFFFFF"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <Button Grid.Column="1"
                      Content="Stop all"
                      Command="{Binding StopAllDownloadsCommand}"
                      MinHeight="38" />
            </Grid>

            <ItemsControl ItemsSource="{Binding ActiveDownloadingItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadItem">
                  <Border Background="#151923"
                          CornerRadius="16"
                          Padding="14"
                          Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding BaseDisplayName}"
                                     Foreground="#FFFFFF"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding StatusText}"
                                     Foreground="#AEB5C5"
                                     FontSize="12"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProgressText}"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold" />
                      </Grid>

                      <ProgressBar Minimum="0"
                                   Maximum="100"
                                   Height="6"
                                   Value="{Binding ProgressPercent}" />

                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding SizeText}"
                                     Foreground="#AEB5C5"
                                     FontSize="12" />
                          <TextBlock Text="{Binding SpeedText}"
                                     Foreground="#AEB5C5"
                                     FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                          <Button Content="Pause"
                                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).TogglePauseDownloadCommand}"
                                  CommandParameter="{Binding}"
                                  MinHeight="38" />
                          <Button Content="Cancel"
                                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CancelDownloadCommand}"
                                  CommandParameter="{Binding}"
                                  MinHeight="38" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
              <TextBlock Text="Queue"
                         Foreground="#FFFFFF"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <Button Grid.Column="1"
                      Content="Clear"
                      Command="{Binding ClearQueueCommand}"
                      MinHeight="38" />
            </Grid>

            <ItemsControl ItemsSource="{Binding QueuedDownloadItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadItem">
                  <Border Background="#151923"
                          CornerRadius="14"
                          Padding="12"
                          Margin="0,0,0,8"
                          Opacity="0.8">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10">
                      <TextBlock Text="{Binding QueueOrder}"
                                 Foreground="#AEB5C5"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1"
                                  Spacing="2">
                        <TextBlock Text="{Binding BaseDisplayName}"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#AEB5C5"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="2"
                              Content="Cancel"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CancelDownloadCommand}"
                              CommandParameter="{Binding}"
                              MinHeight="36" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
