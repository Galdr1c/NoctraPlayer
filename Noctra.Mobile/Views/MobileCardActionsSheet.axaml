<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileCardActionsSheet"
             x:CompileBindings="False"
             Focusable="True"
             KeyDown="Sheet_KeyDown">
  <UserControl.Styles>
    <Style Selector="Button.CardActionRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.CardActionRow:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InteractivePressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.CardActionRow TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.CardActionRow icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.CardActionRow.destructive TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.CardActionRow.destructive icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Border x:Name="ScrimLayer"
            Background="{DynamicResource OverlayDimBrush}"
            PointerPressed="Scrim_PointerPressed" />

    <Border x:Name="SheetSurface"
            MaxWidth="520"
            Background="{DynamicResource Bg0Brush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,1,1,0"
            CornerRadius="8,8,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Margin="16,0"
            Padding="12,8"          
            BoxShadow="{DynamicResource OverlaySheetShadow}"
            MaxHeight="{DynamicResource SheetMaxHeight}">
      <Border.RenderTransform>
        <TranslateTransform />
      </Border.RenderTransform>

      <Grid RowDefinitions="Auto,*">
        <Grid RowDefinitions="Auto,Auto"
              Margin="0,0,0,4">
          <Border x:Name="DragHandle"
                  Grid.Row="0"
                  Height="28"
                  Background="Transparent"
                  PointerPressed="DragHandle_PointerPressed"
                  PointerMoved="DragHandle_PointerMoved"
                  PointerReleased="DragHandle_PointerReleased"
                  PointerCaptureLost="DragHandle_PointerCaptureLost">
            <Border Width="36"
                    Height="4"
                    Background="{DynamicResource BorderBrush}"
                    CornerRadius="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
          </Border>

          <Grid Grid.Row="1"
                ColumnDefinitions="*,Auto">
            <TextBlock x:Name="TitleTextBlock"
                       Margin="8,0,8,0"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="{DynamicResource FTitleL}"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Width="48"
                    Height="48"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Close_Click"
                    AutomationProperties.Name="{loc:Translate Common.Close}"
                    AutomationProperties.HelpText="{loc:Translate Common.Close}">
              <icons:MaterialIcon Kind="Close"
                                  Width="22"
                                  Height="22"
                                  Foreground="{DynamicResource TextMutedBrush}" />
            </Button>
          </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      MaxHeight="{DynamicResource SheetMaxHeight}"
                      ScrollViewer.IsScrollChainingEnabled="False">
          <ItemsControl x:Name="ActionsList"
                        ItemsSource="{Binding Actions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="CardActionRow"
                        Classes.destructive="{Binding IsDestructive}"
                        Tag="{Binding}"
                        Click="Action_Click"
                        AutomationProperties.Name="{Binding Label}"
                        AutomationProperties.HelpText="{Binding Label}">
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="14">
                    <icons:MaterialIcon Kind="{Binding Icon}"
                                        Width="22"
                                        Height="22"
                                        VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Label}"
                               FontSize="{DynamicResource FBodyL}"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
