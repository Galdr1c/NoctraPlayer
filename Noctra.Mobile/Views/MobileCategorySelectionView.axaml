<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileCategorySelectionView"
             x:Name="CategorySelectionRoot"
             x:CompileBindings="False"
             Background="{DynamicResource Bg0Brush}"
             IsVisible="False">
  <UserControl.Styles>
    <Style Selector="Button.CategorySelectionRow">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.CategorySelectionRow:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.AllCategory">
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="MinHeight" Value="50" />
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.AllCategory:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InteractivePressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.CategoryHideButton">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.CategoryHideButton:pressed">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="ListBox#CategoryListBox > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1.5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBox#CategoryListBox > ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}" />
    </Style>
    <Style Selector="ListBox#CategoryListBox > ListBoxItem:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InteractivePressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBox#CategoryListBox > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*"
        Background="{DynamicResource Bg0Brush}"
        ClipToBounds="True">
    <Border Grid.Row="0"
            Background="{DynamicResource Surface0Brush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <Grid x:Name="HeaderContent"
            ColumnDefinitions="48,*"
            ColumnSpacing="8">
        <Button Width="48"
                Height="48"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="Back_Click"
                AutomationProperties.Name="{loc:Translate Player.Overlay.Back}"
                AutomationProperties.HelpText="{loc:Translate Player.Overlay.Back}"
                ToolTip.Tip="{loc:Translate Player.Overlay.Back}">
          <icons:MaterialIcon Kind="ArrowLeft"
                              Width="26"
                              Height="26"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
        </Button>
        <TextBlock x:Name="TitleTextBlock"
                   Grid.Column="1"
                   FontSize="{DynamicResource FTitleL}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid x:Name="CategorySafeAreaHost"
          Grid.Row="1">
      <Grid MaxWidth="720"
            Margin="16,18,16,16"
            RowDefinitions="Auto,*"
            HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="8"
              Margin="0,0,0,8">
            <Button x:Name="AllCategoriesButton"
                    Classes="AllCategory"
                    Click="SelectCategory_Click">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                <TextBlock Text="{loc:Translate Common.All}"
                           FontSize="{DynamicResource FBodyL}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <icons:MaterialIcon x:Name="AllCategoriesCheck"
                                    Grid.Column="1"
                                    Kind="RadioboxMarked"
                                    Width="22"
                                    Height="22"
                                    Foreground="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center" />
              </Grid>
            </Button>

          <Border Grid.Column="1"
                  Background="{DynamicResource Surface1Brush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <icons:MaterialIcon Kind="Magnify"
                                  Width="28"
                                  Height="28"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  IsHitTestVisible="False" />

              <TextBox x:Name="CategorySearchTextBox"
                       Grid.Column="1"
                       Classes="search"
                       PlaceholderText="{loc:Translate Shell.Search.Tooltip}"
                       VerticalContentAlignment="Center"
                       TextInputOptions.ReturnKeyType="Done"
                       KeyDown="CategorySearchTextBox_KeyDown"
                       TextChanged="CategorySearchTextBox_TextChanged" />

              <Button x:Name="ClearCategorySearchButton"
                      Grid.Column="2"
                      Theme="{StaticResource Searchicon}"
                      IsVisible="False"
                      Click="ClearCategorySearch_Click"
                      AutomationProperties.Name="Clear category search"
                      AutomationProperties.HelpText="Clears the entered category filter">
                <icons:MaterialIcon Kind="CloseCircleOutline"
                                    Width="28"
                                    Height="28"
                                    Foreground="{DynamicResource TextMutedBrush}" />
              </Button>
            </Grid>
          </Border>
        </Grid>

        <!-- Boş durum: arama sonucu yoksa görünür -->
        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    IsVisible="False">
          <icons:MaterialIcon Kind="MagnifyRemoveOutline"
                              Width="48" Height="48"
                              Foreground="{DynamicResource TextMutedBrush}"
                              HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Translate Mobile.Categories.EmptyTitle}"
                     FontSize="{DynamicResource FTitleL}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Translate Mobile.Categories.EmptySubtitle}"
                     FontSize="{DynamicResource FCaption}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Undo snackbar: BackExitToast ile aynı tasarım -->
        <Border x:Name="UndoSnackbar"
                Grid.RowSpan="2"
                ZIndex="49000"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="20,0,20,96"
                Padding="8"
                CornerRadius="8"
                Background="{DynamicResource CardHoverGradientBrush}"
                IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock x:Name="UndoSnackbarText"
                       Foreground="{DynamicResource PlayerOverlayTextBrush}"
                       FontSize="{DynamicResource FBody}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />        
            <Button Click="UndoHide_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    MinWidth="48" MinHeight="36"
                    VerticalContentAlignment="Center"
                    HorizontalAlignment="Center" 
                    CornerRadius="6"
                    Margin="0">
              <TextBlock Text="{loc:Translate Common.Undo}"
                         FontSize="{DynamicResource FBody}"
                         FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" />          
            </Button>  
          </StackPanel>
        </Border>

        <!-- Error snackbar: Hata durumunda kısa süreli gösterilir -->
        <Border x:Name="ErrorSnackbar"
                Grid.RowSpan="2"
                ZIndex="49001"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="20,0,20,96"
                Padding="12,10"
                CornerRadius="8"
                Background="{DynamicResource PlayerOverlayStrongBrush}"
                IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="AlertCircleOutline"
                                Width="20" Height="20"
                                Foreground="{DynamicResource ErrorBrush}"
                                VerticalAlignment="Center" />
            <TextBlock x:Name="ErrorSnackbarText"
                       Foreground="{DynamicResource PlayerOverlayTextBrush}"
                       FontSize="{DynamicResource FBody}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <ListBox x:Name="CategoryListBox"
                 Grid.Row="1"
                 ItemsSource="{Binding Categories}"
                 ItemContainerTheme="{StaticResource TransparentListBoxItemTheme}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 SelectionChanged="ClearTransientSelection"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.IsScrollChainingEnabled="False">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel CacheLength="1.5" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0"
                        Classes="CategorySelectionRow"
                        Tag="{Binding}"
                        Click="SelectCategory_Click">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">
                    <TextBlock Text="{Binding Name}"
                               FontSize="{DynamicResource FBodyL}"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <icons:MaterialIcon Grid.Column="1"
                                        Kind="RadioboxMarked"
                                        Width="22"
                                        Height="22"
                                        Foreground="{DynamicResource AccentBrush}"
                                        IsVisible="{Binding IsSelected}"
                                        VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Grid.Column="1"
                        Theme="{StaticResource RevealBtn}"
                        Tag="{Binding}"
                        Margin="12,0"
                        Click="HideCategory_Click"
                        AutomationProperties.Name="{loc:Translate Mobile.Categories.Hide}"
                        AutomationProperties.HelpText="{loc:Translate Mobile.Categories.Hide}"
                        ToolTip.Tip="{loc:Translate Mobile.Categories.Hide}">
                  <icons:MaterialIcon Kind="EyeOffOutline"
                                      Width="22"
                                      Height="22"
                                      Foreground="{DynamicResource TextMutedBrush}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
