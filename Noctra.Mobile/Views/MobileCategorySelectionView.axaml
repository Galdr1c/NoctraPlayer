<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileCategorySelectionView"
             x:Name="CategorySelectionRoot"
             x:CompileBindings="False"
             Background="{DynamicResource Bg0Brush}"
             IsVisible="False">
  <UserControl.Styles>
    <Style Selector="Button.CategorySelectionRow">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="16,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.CategorySelectionRow:pressed">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="Button.CategoryHideButton">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.CategoryHideButton:pressed">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="ListBox#CategoryListBox > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBox#CategoryListBox > ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*"
        Background="{DynamicResource Bg0Brush}"
        ClipToBounds="True">
    <Border Grid.Row="0"
            Background="{DynamicResource Surface0Brush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <Grid x:Name="HeaderContent"
            ColumnDefinitions="48,*"
            ColumnSpacing="8">
        <Button Width="48"
                Height="48"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="Back_Click"
                ToolTip.Tip="{loc:Translate Player.Overlay.Back}">
          <icons:MaterialIcon Kind="ArrowLeft"
                              Width="26"
                              Height="26"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
        </Button>
        <TextBlock x:Name="TitleTextBlock"
                   Grid.Column="1"
                   FontSize="{DynamicResource FTitleL}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid x:Name="CategorySafeAreaHost"
          Grid.Row="1">
      <Grid MaxWidth="720"
            Margin="16,18,16,16"
            RowDefinitions="Auto,*"
            HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="8"
              Margin="0,0,0,8">
          <Border MinWidth="104"
                  Background="{DynamicResource Surface1Brush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <Button x:Name="AllCategoriesButton"
                    Classes="CategorySelectionRow"
                    Click="SelectCategory_Click">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                <TextBlock Text="{loc:Translate Common.All}"
                           FontSize="{DynamicResource FBodyL}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <icons:MaterialIcon x:Name="AllCategoriesCheck"
                                    Grid.Column="1"
                                    Kind="RadioboxMarked"
                                    Width="22"
                                    Height="22"
                                    Foreground="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center" />
              </Grid>
            </Button>
          </Border>

          <Border Grid.Column="1"
                  Background="{DynamicResource Surface1Brush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <icons:MaterialIcon Kind="Magnify"
                                  Width="20"
                                  Height="20"
                                  Margin="14,0,0,0"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  IsHitTestVisible="False" />

              <TextBox x:Name="CategorySearchTextBox"
                       Grid.Column="1"
                       Classes="search"
                       PlaceholderText="{loc:Translate Shell.Search.Tooltip}"
                       VerticalContentAlignment="Center"
                       TextChanged="CategorySearchTextBox_TextChanged" />

              <Button x:Name="ClearCategorySearchButton"
                      Grid.Column="2"
                      MinWidth="48"
                      MinHeight="48"
                      Padding="12,0"
                      Background="Transparent"
                      BorderThickness="0"
                      IsVisible="False"
                      Click="ClearCategorySearch_Click">
                <icons:MaterialIcon Kind="Close"
                                    Width="18"
                                    Height="18"
                                    Foreground="{DynamicResource TextMutedBrush}" />
              </Button>
            </Grid>
          </Border>
        </Grid>

        <ListBox x:Name="CategoryListBox"
                 Grid.Row="1"
                 ItemsSource="{Binding Categories}"
                 ItemContainerTheme="{StaticResource TransparentListBoxItemTheme}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 SelectionChanged="ClearTransientSelection"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.IsScrollChainingEnabled="False">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel CacheLength="1.5" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8"
                      Background="Transparent"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,0,0,1.5"
                      CornerRadius="6">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Grid.Column="0"
                          Classes="CategorySelectionRow"
                          Tag="{Binding}"
                          Click="SelectCategory_Click">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="{DynamicResource FBodyL}"
                                 FontWeight="Normal"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                      <icons:MaterialIcon Grid.Column="1"
                                          Kind="RadioboxMarked"
                                          Width="22"
                                          Height="22"
                                          Foreground="{DynamicResource AccentBrush}"
                                          IsVisible="{Binding IsSelected}"
                                          VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <Button Grid.Column="1"
                          Classes="CategoryHideButton"
                          Tag="{Binding}"
                          Click="HideCategory_Click"
                          ToolTip.Tip="{loc:Translate Mobile.Categories.Hide}">
                    <icons:MaterialIcon Kind="EyeOffOutline"
                                        Width="22"
                                        Height="22"
                                        Foreground="{DynamicResource TextMutedBrush}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
