<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileUpsellView"
             x:CompileBindings="False">

  <Grid Background="{DynamicResource OverlayDimBrush}">
    <Border Background="{DynamicResource BackgroundGradientBrush}"
            BorderBrush="{DynamicResource PremiumBadgeBrush}"
            BorderThickness="0,1.5,0,0"
            CornerRadius="0"
            Padding="22,20,22,18"
            VerticalAlignment="Bottom"
            BoxShadow="{DynamicResource OverlaySheetShadow}">
      <Grid RowDefinitions="Auto,*">
        <ScrollViewer Grid.Row="0"
                      MaxHeight="{DynamicResource SheetMaxHeight}">
          <StackPanel Spacing="16">
            <StackPanel Spacing="6"
                        HorizontalAlignment="Center"
                        Margin="28,0">
              <Border Background="{DynamicResource NavActiveBackgroundBrush}"
                      CornerRadius="8"
                      Padding="12,6"
                      HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                  <icons:MaterialIcon Kind="Crown"
                                      Width="17"
                                      Height="17"
                                      Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{loc:Translate Upsell.Badge}"
                             Foreground="{DynamicResource AccentBrush}"
                             FontSize="{DynamicResource FCaption}"
                             FontWeight="Bold"/>
                </StackPanel>
              </Border>

              <TextBlock Text="{loc:Translate Upsell.Headline}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="{DynamicResource FHeadline}"
                         FontWeight="Bold"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
              <TextBlock Text="{loc:Translate Upsell.Subheadline}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="{DynamicResource FCaption}"
                         TextAlignment="Center"
                         TextWrapping="Wrap"  Margin="0,4,0,0"/>
            </StackPanel>

            <Border Background="{DynamicResource PremiumCardBackgroundBrush}"
                    BorderBrush="{DynamicResource PremiumBadgeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{loc:Translate Upsell.Premium.Title}"
                               Foreground="{DynamicResource PremiumCardForegroundBrush}"
                               FontSize="{DynamicResource FBodyL}"
                               FontWeight="Bold" />
                    <TextBlock Text="{loc:Translate Upsell.Premium.Subtitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="{DynamicResource FOverline}"/>
                  </StackPanel>
                  <Border Grid.Column="1"
                          Background="{DynamicResource PremiumBadgeBrush}"
                          CornerRadius="8"
                          Padding="10"
                          VerticalAlignment="Top">
                    <TextBlock Text="{loc:Translate Upsell.Premium.Recommended}"
                               Foreground="{DynamicResource PremiumBadgeTextBrush}"
                               FontSize="{DynamicResource S2}"
                               FontWeight="Bold" />
                  </Border>
                </Grid>

                <UniformGrid Columns="1" RowSpacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="CheckCircle" Width="17" Height="17" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{loc:Translate Upsell.Premium.Feature1}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="{DynamicResource FCaption}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="CheckCircle" Width="17" Height="17" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{loc:Translate Upsell.Premium.Feature2}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="{DynamicResource FCaption}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="CheckCircle" Width="17" Height="17" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{loc:Translate Upsell.Premium.Feature3}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="{DynamicResource FCaption}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="CheckCircle" Width="17" Height="17" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{loc:Translate Upsell.Premium.Feature4}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="{DynamicResource FCaption}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="CheckCircle" Width="17" Height="17" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{loc:Translate Upsell.Premium.Feature5}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="{DynamicResource FCaption}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="CheckCircle" Width="17" Height="17" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{loc:Translate Upsell.Premium.Feature6}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="{DynamicResource FCaption}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="CheckCircle" Width="17" Height="17" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{loc:Translate Upsell.Premium.Feature7}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="{DynamicResource FCaption}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="CheckCircle" Width="17" Height="17" Foreground="{DynamicResource AccentLightBrush}" />
                    <TextBlock Text="{loc:Translate Upsell.Premium.Feature8}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="{DynamicResource FCaption}" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>

            <Button Classes="UpgradeButton"
                    MinHeight="52"
                    Click="Buy_Click">
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          Spacing="8">
                <icons:MaterialIcon Kind="Crown" Width="18" Height="18"/>
                <TextBlock Text="{loc:Translate Upsell.Action.Buy}"
                           FontSize="{DynamicResource FBodyL}"
                           FontWeight="Bold" />
              </StackPanel>
            </Button>

            <Button Background="Transparent"
                    BorderThickness="0"
                    Click="Close_Click"
                    HorizontalAlignment="Center">
              <TextBlock Text="{loc:Translate Upsell.Action.Dismiss}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="{DynamicResource FCaption}"
                         FontWeight="SemiBold" />
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
