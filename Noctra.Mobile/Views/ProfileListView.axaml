<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:views="using:Noctra.Mobile.Views"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.ProfileListView"
             x:Name="ProfileListRoot"
             x:DataType="vm:ProfilesViewModel"
             x:CompileBindings="True"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundGradientBrush}">

  <UserControl.Styles>

    <!-- ── Profil kart/buton stili ── -->
    <Style Selector="Button.ProfileCardStyle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ProfileCardStyle:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Button.ProfileCardStyle:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.ProfileCardStyle /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.ProfileCardStyle:focus /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource FocusGlow}" />
    </Style>

    <!-- ── Add Profile kart alanı ── -->
    <Style Selector="Border.AddProfileCard">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <!-- ── Üst çubuk: buton (pencil / Done) ── -->
    <Style Selector="Button.HeaderIconBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.HeaderIconBtn:pressed">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    </Style>

    <!-- ── Done metin butonu ── -->
    <Style Selector="Button.DoneBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.DoneBtn:pressed">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    </Style>

  </UserControl.Styles>

  <!--
    ┌─────────────────────────────────────────────────────────────┐
    │  Satır 0 : Üst başlık (normal ↔ yönet modu)                 │
    │  Satır 1 : Kaydırılabilir içerik (başlık + kartlar)         │
    │  Satır * : Overlay katmanları (ProfileSetup/Pin/Loading)    │
    └─────────────────────────────────────────────────────────────┘
  -->
  <Grid RowDefinitions="Auto,*">

    <!-- ════════════════════════════════════════════════════════
         SATIR 0 — ÜST BAŞLIK
         Normal  : [Logo + Uygulama adı]        [✏ Kalem simgesi]
         Yönet   : [← geri (boş)]   Profilleri Yönet   [Bitti]
         ════════════════════════════════════════════════════════ -->
    <Grid Grid.Row="0" Height="56" Margin="8,0">

      <!-- ── NORMAL MOD başlığı ── -->
      <Grid ColumnDefinitions="*,Auto"
            IsVisible="{Binding !IsManageMode}"
            VerticalAlignment="Center">

        <!-- Sol: Uygulama logosu + adı -->
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="8,0">
          <Image Source="avares://Noctra.Mobile/Assets/Square150x150Logo.png"
                 Width="32" Height="32"
                 Stretch="Uniform"
                 VerticalAlignment="Center" />
          <TextBlock Text="NOCTRA"
                     FontSize="{DynamicResource FTitleL}"
                     FontWeight="Bold"
                     Foreground="{DynamicResource AccentBrush}"
                     LetterSpacing="1.5"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Sağ: Kalem (yönet modunu aç/kapa)
             Handler executes ToggleManageModeCommand through the bound ProfilesViewModel. -->
        <Button Grid.Column="1"
                Classes="HeaderIconBtn"
                Click="ToggleManage_Click"
                VerticalAlignment="Center">
          <icons:MaterialIcon Kind="PencilOutline"
                              Width="22" Height="22"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
        </Button>

      </Grid>

      <!-- ── YÖNET MOD başlığı ── -->

      <Grid ColumnDefinitions="Auto,*,Auto"
            IsVisible="{Binding IsManageMode}"
            VerticalAlignment="Center">

        <!-- Sol: Boş denge alanı -->
        <!-- Sol: Uygulama logosu + adı -->
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="8,0">
          <Image Source="avares://Noctra.Mobile/Assets/Square150x150Logo.png"
                 Width="32" Height="32"
                 Stretch="Uniform"
                 VerticalAlignment="Center" />
          <TextBlock Text="NOCTRA"
                     FontSize="{DynamicResource FTitleL}"
                     FontWeight="Bold"
                     Foreground="{DynamicResource AccentBrush}"
                     LetterSpacing="1.5"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Orta: "Profilleri Yönet" -->
        <TextBlock Grid.Column="1"
                   Text="{loc:Translate Profiles.ManageMode.Title}"
                   FontSize="{DynamicResource FTitleM}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="1"
                   VerticalAlignment="Center" />

        <!-- Sağ: Bitti -->
        <Button Grid.Column="2"
                Classes="DoneBtn"
                Click="ToggleManage_Click"
                VerticalAlignment="Center"
                Content="{loc:Translate Profiles.ManageMode.Done}" />
      </Grid>
    </Grid>

    <!-- ════════════════════════════════════════════════════════
         SATIR 1 — KAYDIRILAB. İÇERİK
         ════════════════════════════════════════════════════════ -->
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <!-- ── "Kimin izlediğini seç?" büyük başlık (sadece normal modda) ── -->
        <TextBlock Text="{loc:Translate Profiles.Title}"
                   FontSize="{DynamicResource FDisplay}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxLines="2"
                   Margin="16,24,16,4"
                   IsVisible="{Binding !IsManageMode}" />

        <TextBlock Text="{loc:Translate Profiles.SelectProfile}"
                   FontSize="{DynamicResource S4}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="24,0,24,28"
                   IsVisible="{Binding !IsManageMode}" />

        <!-- ── Yönet modu üst boşluk ── -->
        <Border Height="20" IsVisible="{Binding IsManageMode}" />

        <!--
          ── PROFİL KARTLARI + "Profil Ekle" —————————————————————
          WrapPanel: 2 kart yan yana (telefon); tablet/geniş ekranda otomatik 3+
          Her kart: kare avatar (150×150) + ad etiketi
          "Profil Ekle" kartı sadece normal modda görünür
          ──────────────────────────────────────────────────────────
        -->
        <ItemsControl x:Name="ProfileItemsControl"
                      ItemsSource="{Binding DisplayItems}"
                      Margin="12,0,12,24">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <!--
                WrapPanel yerine bir Grid'li yaklaşım düşünüldü fakat
                WrapPanel en esnek çözüm. Kart genişliği converter ile
                hesaplanıyor → telefonda 2 sütun, tablette 3–4 sütun.
              -->
              <WrapPanel HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.DataTemplates>

            <!-- ── 1. Mevcut profil kartı ── -->
            <DataTemplate DataType="models:Profile">
              <Button Classes="ProfileCardStyle"
                      Click="SelectProfile_Click"
                      Width="{Binding Bounds.Width,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl},
                                      Converter={StaticResource ResponsiveCardMetricConverter},
                                      ConverterParameter=profileWidth}"
                      Margin="8,8">
                <StackPanel Spacing="10">

                  <!--
                    ── Kare Avatar Alanı ──────────────────────────────
                    Netflix: avatar karesi ↔ etiket alanının genişliği.
                    150×150 sabit boyut telefonda 2 kart yan yana sığar,
                    tablette converter daha geniş genişlik döndürünce otomatik uyum sağlar.
                  -->
                  <Grid Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=profileWidth}"
                        Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=profileHeight}"
                        HorizontalAlignment="Center"
                        ClipToBounds="False">

                    <!-- Çocuk profili çerçevesi (gradyan kenarlık) -->
                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Margin="1"
                            CornerRadius="14"
                            BorderThickness="3.5"
                            IsVisible="{Binding IsChild}"
                            IsHitTestVisible="False"
                            BoxShadow="0 0 16 0 #708B5CF6">
                      <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                          <GradientStop Color="#FFB7A6F6" Offset="0" />
                          <GradientStop Color="#FF8B5CF6" Offset="0.5" />
                          <GradientStop Color="#FF7C3AED" Offset="1" />
                        </LinearGradientBrush>
                      </Border.BorderBrush>
                    </Border>

                    <!-- Avatar resmi -->
                    <Border Width="140" Height="140"
                            CornerRadius="12"
                            ClipToBounds="True"
                            Background="{DynamicResource IconGradientBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                      <Grid>

                        <!-- Asıl avatar görseli -->
                        <Image Source="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}"
                               Stretch="UniformToFill" />

                        <!--
                          ── YÖNET MODU kalem overlay'i ──────────────────
                          Tıklanabilir yönet overlay: yarı saydam siyah + kalem
                        -->
                        <Border CornerRadius="11"
                                Background="#000000" Opacity="0.7" 
                                IsVisible="{Binding #ProfileListRoot.DataContext.IsManageMode}">
                          <Border Width="48" Height="48"
                                  CornerRadius="12"
                                  BorderBrush="White"
                                  BorderThickness="2"
                                  Background="Transparent"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                            <icons:MaterialIcon Kind="PencilOutline"
                                                Width="20" Height="20"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                          </Border>
                        </Border>

                        <!-- Silme geri sayım overlay'i -->
                        <Border CornerRadius="8"
                                ClipToBounds="True"
                                IsVisible="{Binding IsPendingDeletion}">
                          <Border.Background>
                              <SolidColorBrush Color="#000000" Opacity="0.5" />
                          </Border.Background>      
                          <StackPanel VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Spacing="6">
                            <icons:MaterialIcon Kind="TimerSand"
                                                Width="28" Height="28"
                                                Foreground="{Binding DeletionUrgency, Converter={StaticResource UrgencyToColorConverter}}"
                                                HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TimeUntilDeletion, Converter={StaticResource TimeSpanToCountdownConverter}}"
                                       FontSize="{DynamicResource FOverline}" FontWeight="Bold"
                                       Foreground="{Binding DeletionUrgency, Converter={StaticResource UrgencyToColorConverter}}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                          </StackPanel>
                        </Border>

                        <!-- PIN kilit simgesi (sağ üst köşe) -->
                        <icons:MaterialIcon Kind="Lock"
                                            Width="24" Height="24"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="8"
                                            IsVisible="{Binding PinHash, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                      </Grid>
                    </Border>
                  </Grid>

                  <!-- Profil adı etiketi -->
                  <TextBlock Text="{Binding Name}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="{DynamicResource FBodyL}"
                             FontWeight="Medium"
                             TextAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="150"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>

            <!-- ── 2. "Profil Ekle" kartı (sadece normal modda görünür) ── -->
            <DataTemplate DataType="vm:AddProfilePlaceholder">
              <!--
                Netflix: "Add Profile" kartı profil kartlarıyla aynı boyutta;
                içinde artı simgesi ve "Profil Ekle" yazısı.
                Yönet modunda bu kart gizlenir.
              -->
              <Button Classes="ProfileCardStyle"
                      Click="AddProfile_Click"
                      Width="{Binding Bounds.Width,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl},
                                      Converter={StaticResource ResponsiveCardMetricConverter},
                                      ConverterParameter=profileWidth}"
                      Margin="8,6"
                      IsVisible="{Binding !#ProfileListRoot.DataContext.IsManageMode}">
                <StackPanel Spacing="10">

                  <!-- Artı kutusu: noktalı kenarlıklı (StrokeDashArray="3,2") -->
                  <Grid Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=profileWidth}"
                        Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=profileHeight}"
                        HorizontalAlignment="Center"
                        Margin="5">
                    <Rectangle RadiusX="12" RadiusY="12"
                               Stroke="{DynamicResource BorderBrush}"
                               StrokeThickness="2"
                               StrokeDashArray="3,2"
                               Fill="Transparent" />
                    <icons:MaterialIcon Kind="Plus"
                                        Width="42" Height="42"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                  </Grid>

                  <!-- "Profil Ekle" etiketi -->
                  <TextBlock Text="{loc:Translate Profiles.AddProfile}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="{DynamicResource FBody}"
                             FontWeight="Medium"
                             TextAlignment="Center"
                             MaxWidth="150"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>

          </ItemsControl.DataTemplates>
        </ItemsControl>

        <!--
          ── Yedek "Profil Ekle" butonu ────────────────────────────
          DisplayItems tamamen boşken (ViewModel henüz yüklenmediyse)
          gösterilen geri dönüş kartı. Profiller yüklenince kaybolur.
        -->
        <Button x:Name="FallbackAddProfileButton"
                Classes="ProfileCardStyle"
                Click="AddProfile_Click"
                HorizontalAlignment="Center"
                Margin="8,6"
                IsVisible="{Binding DisplayItems.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}">
          <StackPanel Spacing="10">
            <Grid Width="140" Height="140" HorizontalAlignment="Center">
              <Rectangle RadiusX="14" RadiusY="14"
                         Stroke="{DynamicResource BorderBrush}"
                         StrokeThickness="2"
                         StrokeDashArray="4,2"
                         Fill="Transparent" />
              <icons:MaterialIcon Kind="Plus"
                                  Width="42" Height="42"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{loc:Translate Profiles.AddProfile}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="{DynamicResource FBody}" FontWeight="Medium"
                       TextAlignment="Center" />
          </StackPanel>
        </Button>



      </StackPanel>
    </ScrollViewer>

    <!-- ════════════════════════════════════════════════════════
         OVERLAY KATMANLARI (RowSpan="2" → tüm ekranı kaplar)
         ════════════════════════════════════════════════════════ -->

    <!-- Profil kurulum formu -->
    <Border x:Name="ProfileSetupHost"
            Grid.RowSpan="2"
            Background="{DynamicResource Bg0Brush}"
            IsVisible="False">
      <ContentControl x:Name="ProfileSetupContent" />
    </Border>

    <!-- PIN girişi -->
    <Border x:Name="PinEntryHost"
            Grid.RowSpan="2"
            Background="{DynamicResource Bg0Brush}"
            Padding="18"
            IsVisible="False">
      <views:PinEntryView x:Name="PinEntryContent" />
    </Border>

    <!-- Profil yükleniyor -->
    <Border x:Name="ProfileLoadingHost"
            Grid.RowSpan="2"
            Background="{DynamicResource Bg0Brush}"
            IsVisible="False">
      <views:ProfileLoadingView x:Name="ProfileLoadingContent" />
    </Border>

  </Grid>
</UserControl>
