<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             x:Class="Noctra.Mobile.Views.MobileWatermarkView"
             x:DataType="vm:WatermarkViewModel"
             IsHitTestVisible="False">
  <Grid IsVisible="{Binding IsVisible}">
    <Border Background="Transparent"
            Padding="6,6"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0">
      <!-- Desktop watermark preserved, with a slightly smaller mobile font so it does not dominate narrow screens. -->
      <TextBlock Text="Noctra - Free"
                 FontWeight="SemiBold"
                 FontSize="{DynamicResource FWatermark}"
                 Foreground="{DynamicResource PlayerOverlayTextBrush}"
                 Opacity="{Binding Opacity}" />
    </Border>
  </Grid>
</UserControl>
