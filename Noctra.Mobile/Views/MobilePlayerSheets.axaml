<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:player="using:Noctra.Mobile.Views.Player"
             x:Class="Noctra.Mobile.Views.MobilePlayerSheets"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <Grid>
    <Border x:Name="ScrimLayer"
            Background="{DynamicResource OverlayDimBrush}"
            PointerPressed="Scrim_PointerPressed" />
    <Border x:Name="SheetSurface"
            Background="{DynamicResource PlayerOverlaySheetBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,1,1,0"
            Margin="100,0,100,0"
            Padding="12,8"
            CornerRadius="8,8,0,0"
            VerticalAlignment="Bottom"
            MaxHeight="{DynamicResource SheetMaxHeight}">
      <Border.RenderTransform>
        <TranslateTransform />
      </Border.RenderTransform>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">
          <!-- Drag handle -->
          <Border x:Name="DragHandle"
                  Height="28"
                  Background="Transparent"
                  PointerPressed="DragHandle_PointerPressed"
                  PointerMoved="DragHandle_PointerMoved"
                  PointerReleased="DragHandle_PointerReleased"
                  PointerCaptureLost="DragHandle_PointerCaptureLost">
            <Border Width="36"
                    Height="4"
                    CornerRadius="2"
                    Background="{DynamicResource BorderBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,10,0,4" />
          </Border>

          <!-- Actions panel (More) -->
          <player:MobilePlayerMoreSheet
              IsVisible="{Binding IsActionsPanelOpen}" />

          <!-- Audio/Subtitles panel -->
          <player:MobilePlayerTrackSheet
              IsVisible="{Binding IsAudioSettingsOpen}"
              Margin="14,0,14,14" />

          <!-- Quality panel -->
          <player:MobilePlayerQualitySheet
              IsVisible="{Binding IsQualitySettingsOpen}"
              Margin="14,0,14,14" />

          <!-- Info panel -->
          <player:MobilePlayerInfoSheet
              IsVisible="{Binding IsInfoPanelOpen}"
              Margin="14,0,14,14" />

          <!-- Episodes panel -->
          <player:MobilePlayerEpisodesSheet
              IsVisible="{Binding IsEpisodesPanelOpen}"
              Margin="14,0,14,14" />

          <!-- Sleep timer panel -->
          <player:MobilePlayerSleepSheet
              IsVisible="{Binding IsSleepTimerPanelOpen}"
              Margin="14,0,14,14" />

          <!-- Resume dialog -->
          <Border Background="{DynamicResource Surface0Brush}"
                  CornerRadius="16" Padding="20"
                  Margin="14,0,14,14"
                  IsVisible="{Binding IsResumeDialogVisible}">
            <StackPanel Spacing="16">
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <icons:MaterialIcon Kind="PlayCircleOutline"
                                    Width="40" Height="40"
                                    Foreground="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Translate Player.Resume.Title}"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
              </StackPanel>
              <Border Background="{DynamicResource Surface1Brush}" CornerRadius="10" Padding="14,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                  <icons:MaterialIcon Kind="ClockOutline" Width="16" Height="16"
                                      Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Translate Player.Resume.LastPosition}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                    <TextBlock Text="{Binding ResumePositionText}"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Content="{loc:Translate Player.Resume.StartOver}"
                        Command="{Binding StartFromBeginningCommand}"
                        MinHeight="48" CornerRadius="12" />
                <Button Grid.Column="1"
                        Content="{loc:Translate Player.Resume.Resume}"
                        Command="{Binding ResumeFromPositionCommand}"
                        MinHeight="48" CornerRadius="12"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        FontWeight="Bold" BorderThickness="0" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Next episode prompt -->
          <Border Background="{DynamicResource Surface0Brush}"
                  CornerRadius="16" Padding="16"
                  Margin="14,0,14,14"
                  IsVisible="{Binding IsNextEpisodePromptVisible}">
            <StackPanel Spacing="10">
              <TextBlock Text="{loc:Translate Player.Overlay.NextEpisode}"
                         FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="{Binding NextEpisode.Name}"
                         FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextTrimming="CharacterEllipsis" MaxLines="1" />
              <Button Command="{Binding PlayNextEpisodeCommand}"
                      MinHeight="44" CornerRadius="10"
                      Background="{DynamicResource AccentBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      FontSize="14" FontWeight="Bold" BorderThickness="0"
                      HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                  <icons:MaterialIcon Kind="Play" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{loc:Translate Player.NextEpisode.WatchNow}" FontSize="14" FontWeight="Bold" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>