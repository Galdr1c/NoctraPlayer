<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.Player.MobilePlayerEpisodesSheet"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <UserControl.Styles>
    <!-- Header close button: compact, hover/press feedback -->
    <Style Selector="Button#SheetCloseButton">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Season tabs: compact chips (active = accent pill + label) -->
    <Style Selector="ListBox#SeasonListBox > ListBoxItem">
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4,4,0,0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox#SeasonListBox > ListBoxItem:selected  /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TextSelectionBrush}" />
    </Style>
    <Style Selector="ListBox#SeasonListBox > ListBoxItem TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PlayerOverlaySheetMutedTextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox#SeasonListBox > ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PlayerOverlaySheetBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Episode card: full-surface tap zone with pressed feedback -->
    <Style Selector="Button.episodeCard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.episodeCard:pressed Border#EpBgLayer">
      <Setter Property="Background" Value="{DynamicResource InteractivePressedBrush}" />
      <Setter Property="Opacity" Value="1.0" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="10">
    <!-- ═══════ HEADER: kicker + accent bar + title + close ═══════ -->
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3" VerticalAlignment="Center">
        <TextBlock Text="{loc:Translate Player.Overlay.Episodes.Tooltip}"
                   FontSize="11" FontWeight="Bold"
                   Foreground="{DynamicResource PlayerOverlaySheetSecondaryTextBrush}"
                   LetterSpacing="1" />
        <Border Height="2" Width="32"
                CornerRadius="1"
                Background="{DynamicResource AccentBrush}"
                Opacity="0.85"
                HorizontalAlignment="Left" />
        <TextBlock Text="{Binding EpisodesPanelTitle}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource PlayerOverlaySheetTextBrush}"
                   TextWrapping="Wrap"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button Grid.Column="1"
              x:Name="SheetCloseButton"
              Command="{Binding BackFromPlayerPanelCommand}"
              VerticalAlignment="Center">
        <icons:MaterialIcon Kind="Close" Width="18" Height="18"
                            Foreground="{DynamicResource PlayerOverlaySheetMutedTextBrush}" />
      </Button>
    </Grid>

    <!-- ═══════ SEASON TABS (compact chips, horizontal pan) ═══════ -->
    <ListBox x:Name="SeasonListBox"
             ItemsSource="{Binding EpisodeSeasons}"
             SelectedItem="{Binding SelectedEpisodeSeason}"
             Background="Transparent"
             BorderThickness="0"
             Padding="2,2"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Disabled"
             ScrollViewer.IsScrollInertiaEnabled="True"
             ScrollViewer.IsScrollChainingEnabled="False">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:Season">
          <TextBlock Text="{Binding SeasonNumber, Converter={StaticResource StringFormatConverter}, ConverterParameter='Series.Seasons.Format'}"
                     FontWeight="Medium" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- ═══════ EPISODE LIST (compact cards) ═══════ -->
    <ScrollViewer MaxHeight="340"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  ScrollViewer.IsScrollInertiaEnabled="True"
                  ScrollViewer.IsScrollChainingEnabled="False">
      <ItemsControl ItemsSource="{Binding SelectedEpisodeSeasonEpisodes}"
                    Margin="0,2,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Episode">
            <Border 
                    BorderBrush="{DynamicResource PlayerOverlaySheetBorderBrush}"
                    BorderThickness="0.5"
                    CornerRadius="6"
                    Padding="4"
                    Margin="0,0,0,8">
              <Button Classes="episodeCard"
                      Command="{Binding $parent[UserControl].DataContext.PlayEpisodeFromOverlayCommand}"
                      CommandParameter="{Binding}">
                <Panel>
                  <Border x:Name="EpBgLayer"
                          CornerRadius="6"
                          IsHitTestVisible="False" />
                  <Grid ColumnDefinitions="80,*"
                        ColumnSpacing="10">

                    <!-- Thumbnail: number badge + watched progress -->
                    <Border Height="56"
                            CornerRadius="5"
                            ClipToBounds="True"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PlaceHolderBrush}">
                      <Grid>
                        <controls:RemoteImage Url="{Binding CoverUrl}"
                                              Stretch="UniformToFill" />
                        <Border VerticalAlignment="Bottom"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource OverlayDimBrush}"
                                CornerRadius="0,3,0,0"
                                Padding="5,2,7,2">
                          <TextBlock Text="{Binding EpisodeNumber}"
                                     Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                     FontSize="{DynamicResource FOverline}"
                                     FontWeight="Bold"
                                     LineHeight="12" />
                        </Border>
                        <ProgressBar VerticalAlignment="Bottom"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding WatchedPercentage}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource ThemePreviewDarkText}"
                                     BorderThickness="0"
                                     CornerRadius="2"
                                     IsVisible="{Binding WatchedPercentage, Converter={StaticResource CountToVisibilityConverter}}" />
                      </Grid>
                    </Border>

                    <!-- Info -->
                    <StackPanel Grid.Column="1"
                                Spacing="2"
                                VerticalAlignment="Center">

                      <!-- "Şu An Yayında" badge — yalnızca oynatılan bölümde -->
                      <StackPanel Orientation="Horizontal"
                                  Spacing="5">
                        <StackPanel.IsVisible>
                          <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                            <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}" />
                            <Binding Path="$parent[UserControl].DataContext.CurrentEpisode" Converter="{StaticResource EpisodeIdentityConverter}" />
                          </MultiBinding>
                        </StackPanel.IsVisible>
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="3"
                                Padding="6,2">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="6" Height="6" Fill="White" VerticalAlignment="Center">
                              <Ellipse.Styles>
                                <Style Selector="Ellipse">
                                  <Style.Animations>
                                    <Animation Duration="0:0:0.9" IterationCount="INFINITE" PlaybackDirection="Alternate">
                                      <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                                      <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
                                    </Animation>
                                  </Style.Animations>
                                </Style>
                              </Ellipse.Styles>
                            </Ellipse>
                            <TextBlock Text="{loc:Translate Player.Info.NowPlaying}"
                                       FontSize="8.5"
                                       FontWeight="Black"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       LetterSpacing="0.8" />
                          </StackPanel>
                        </Border>
                      </StackPanel>

                      <!-- Title + watched chip -->
                      <StackPanel Orientation="Horizontal"
                                  Spacing="6">
                        <TextBlock Text="{Binding DisplayTitle}"
                                   Foreground="{DynamicResource PlayerOverlaySheetTextBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxLines="1"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="8"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsCompleted}">
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <icons:MaterialIcon Kind="CheckCircle"
                                                Width="11" Height="11"
                                                Foreground="{DynamicResource PlayerOverlaySheetBrush}"
                                                VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Translate Player.Overlay.Watched}"
                                       Foreground="{DynamicResource PlayerOverlaySheetBrush}"
                                       FontSize="9" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                      </StackPanel>

                      <!-- TMDB subtitle -->
                      <TextBlock Text="{Binding DisplaySubtitle}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 FontSize="11" FontStyle="Italic"
                                 Opacity="0.9"
                                 TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="1"
                                 IsVisible="{Binding DisplaySubtitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                      <!-- Meta: air date • duration -->
                      <TextBlock Text="{Binding EpisodeMetaText}"
                                 Foreground="{DynamicResource PlayerOverlaySheetMutedTextBrush}"
                                 FontSize="10"
                                 IsVisible="{Binding EpisodeMetaText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                    </StackPanel>
                  </Grid>
                </Panel>
              </Button>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </StackPanel>
</UserControl>