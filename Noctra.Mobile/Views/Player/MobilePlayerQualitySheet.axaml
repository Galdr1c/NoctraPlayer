<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.Player.MobilePlayerQualitySheet"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="Button.SelectionSheetOption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1.5" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.SelectionSheetOption:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InteractivePressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{loc:Translate Player.Mobile.Quality}"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource PlayerOverlayTextBrush}"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1"
              Command="{Binding BackFromPlayerPanelCommand}"
              Width="40" Height="40" Padding="0"
              Background="Transparent" BorderThickness="0">
        <icons:MaterialIcon Kind="Close" Width="22" Height="22"
                            Foreground="{DynamicResource TextMutedBrush}" />
      </Button>
    </Grid>

    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
      <StackPanel Spacing="2">
        <TextBlock Text="{loc:Translate Player.Quality.Resolution}"
                   FontSize="{Binding FCaption}" FontWeight="Bold"
                   Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}" />
        <TextBlock Text="{Binding QualityResolutionText}"
                   FontSize="{Binding FTitleM}" LetterSpacing="2.5"
                   Foreground="{DynamicResource Accent500Color}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Text="{loc:Translate Player.Quality.Fps}"
                   FontSize="{Binding FCaption}" FontWeight="Bold"
                   Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}" />
        <TextBlock Text="{Binding QualityFpsText}"
                   FontSize="{Binding FTitleM}" LetterSpacing="2.5"
                   Foreground="{DynamicResource Accent500Color}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Spacing="2">
        <TextBlock Text="{loc:Translate Player.Quality.Codec}"
                   FontSize="{Binding FCaption}" FontWeight="Bold"
                   Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}" />
        <TextBlock Text="{Binding QualityVideoCodecText}"
                   FontSize="{Binding FTitleM}" LetterSpacing="2.5"
                   Foreground="{DynamicResource Accent500Color}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
        <TextBlock Text="{loc:Translate Player.Quality.Bitrate}"
                   FontSize="{Binding FCaption}" FontWeight="Bold"
                   Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}" />
        <TextBlock Text="{Binding QualityVideoBitrateText}"
                   FontSize="{Binding FTitleM}" LetterSpacing="2.5"
                   Foreground="{DynamicResource Accent500Color}" />
      </StackPanel>
    </Grid>

    <TextBlock Text="{loc:Translate Player.Mobile.Speed}"
               FontSize="11" FontWeight="Bold"
               Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}" />
    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
      <Button Classes="SelectionSheetOption"
              Command="{Binding SetPlaybackSpeedCommand}"
              CommandParameter="{x:Static vm:PlayerViewModel.PlaybackRateHalf}">
        <Grid IsHitTestVisible="False">
          <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
            <Border.IsVisible>
              <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                <Binding Source="0.5" />
                <Binding Path="CurrentPlaybackRateKey" />
              </MultiBinding>
            </Border.IsVisible>
          </Border>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="0.5x"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <icons:MaterialIcon Grid.Column="1"
                                Kind="RadioboxMarked"
                                Width="20"
                                Height="20"
                                Margin="4,0"
                                Foreground="{DynamicResource AccentBrush}">
              <icons:MaterialIcon.IsVisible>
                <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                  <Binding Source="0.5" />
                  <Binding Path="CurrentPlaybackRateKey" />
                </MultiBinding>
              </icons:MaterialIcon.IsVisible>
            </icons:MaterialIcon>
          </Grid>
        </Grid>
      </Button>
      <Button Grid.Column="1"
              Classes="SelectionSheetOption"
              Command="{Binding SetPlaybackSpeedCommand}"
              CommandParameter="{x:Static vm:PlayerViewModel.PlaybackRateThreeQuarters}">
        <Grid IsHitTestVisible="False">
          <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
            <Border.IsVisible>
              <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                <Binding Source="0.75" />
                <Binding Path="CurrentPlaybackRateKey" />
              </MultiBinding>
            </Border.IsVisible>
          </Border>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="0.75x"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <icons:MaterialIcon Grid.Column="1"
                                Kind="RadioboxMarked"
                                Width="20"
                                Height="20"
                                Margin="4,0"
                                Foreground="{DynamicResource AccentBrush}">
              <icons:MaterialIcon.IsVisible>
                <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                  <Binding Source="0.75" />
                  <Binding Path="CurrentPlaybackRateKey" />
                </MultiBinding>
              </icons:MaterialIcon.IsVisible>
            </icons:MaterialIcon>
          </Grid>
        </Grid>
      </Button>
      <Button Grid.Column="2"
              Classes="SelectionSheetOption"
              Command="{Binding SetPlaybackSpeedCommand}"
              CommandParameter="{x:Static vm:PlayerViewModel.PlaybackRateNormal}">
        <Grid IsHitTestVisible="False">
          <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
            <Border.IsVisible>
              <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                <Binding Source="1.0" />
                <Binding Path="CurrentPlaybackRateKey" />
              </MultiBinding>
            </Border.IsVisible>
          </Border>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="1.0x"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <icons:MaterialIcon Grid.Column="1"
                                Kind="RadioboxMarked"
                                Width="20"
                                Height="20"
                                Margin="4,0"
                                Foreground="{DynamicResource AccentBrush}">
              <icons:MaterialIcon.IsVisible>
                <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                  <Binding Source="1.0" />
                  <Binding Path="CurrentPlaybackRateKey" />
                </MultiBinding>
              </icons:MaterialIcon.IsVisible>
            </icons:MaterialIcon>
          </Grid>
        </Grid>
      </Button>
      <Button Grid.Row="1"
              Classes="SelectionSheetOption"
              Command="{Binding SetPlaybackSpeedCommand}"
              CommandParameter="{x:Static vm:PlayerViewModel.PlaybackRateOneAndQuarter}">
        <Grid IsHitTestVisible="False">
          <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
            <Border.IsVisible>
              <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                <Binding Source="1.25" />
                <Binding Path="CurrentPlaybackRateKey" />
              </MultiBinding>
            </Border.IsVisible>
          </Border>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="1.25x"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <icons:MaterialIcon Grid.Column="1"
                                Kind="RadioboxMarked"
                                Width="20"
                                Height="20"
                                Margin="4,0"
                                Foreground="{DynamicResource AccentBrush}">
              <icons:MaterialIcon.IsVisible>
                <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                  <Binding Source="1.25" />
                  <Binding Path="CurrentPlaybackRateKey" />
                </MultiBinding>
              </icons:MaterialIcon.IsVisible>
            </icons:MaterialIcon>
          </Grid>
        </Grid>
      </Button>
      <Button Grid.Row="1"
              Grid.Column="1"
              Classes="SelectionSheetOption"
              Command="{Binding SetPlaybackSpeedCommand}"
              CommandParameter="{x:Static vm:PlayerViewModel.PlaybackRateOneAndHalf}">
        <Grid IsHitTestVisible="False">
          <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
            <Border.IsVisible>
              <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                <Binding Source="1.5" />
                <Binding Path="CurrentPlaybackRateKey" />
              </MultiBinding>
            </Border.IsVisible>
          </Border>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="1.5x"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <icons:MaterialIcon Grid.Column="1"
                                Kind="RadioboxMarked"
                                Width="20"
                                Height="20"
                                Margin="4,0"
                                Foreground="{DynamicResource AccentBrush}">
              <icons:MaterialIcon.IsVisible>
                <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                  <Binding Source="1.5" />
                  <Binding Path="CurrentPlaybackRateKey" />
                </MultiBinding>
              </icons:MaterialIcon.IsVisible>
            </icons:MaterialIcon>
          </Grid>
        </Grid>
      </Button>
      <Button Grid.Row="1"
              Grid.Column="2"
              Classes="SelectionSheetOption"
              Command="{Binding SetPlaybackSpeedCommand}"
              CommandParameter="{x:Static vm:PlayerViewModel.PlaybackRateDouble}">
        <Grid IsHitTestVisible="False">
          <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
            <Border.IsVisible>
              <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                <Binding Source="2.0" />
                <Binding Path="CurrentPlaybackRateKey" />
              </MultiBinding>
            </Border.IsVisible>
          </Border>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="2.0x"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <icons:MaterialIcon Grid.Column="1"
                                Kind="RadioboxMarked"
                                Width="20"
                                Height="20"
                                Margin="4,0"
                                Foreground="{DynamicResource AccentBrush}">
              <icons:MaterialIcon.IsVisible>
                <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                  <Binding Source="2.0" />
                  <Binding Path="CurrentPlaybackRateKey" />
                </MultiBinding>
              </icons:MaterialIcon.IsVisible>
            </icons:MaterialIcon>
          </Grid>
        </Grid>
      </Button>
    </Grid>
  </StackPanel>
</UserControl>
