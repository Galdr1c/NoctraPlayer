<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             x:Class="Noctra.Mobile.Views.Player.MobilePlayerTimeline"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <Grid x:Name="RootGrid" Margin="0,4,0,4">
    <Grid Height="3" VerticalAlignment="Center">
      <Border CornerRadius="2"
              Background="{DynamicResource PlayerOverlaySecondaryTextBrush}"
              Opacity="0.35" />
      <Border x:Name="FillBar"
              CornerRadius="2"
              HorizontalAlignment="Left"
              Background="{DynamicResource AccentBrush}" />
    </Grid>
    <Ellipse x:Name="Thumb"
             Width="14" Height="14"
             Fill="{DynamicResource AccentBrush}"
             VerticalAlignment="Center"
             HorizontalAlignment="Left"
              IsVisible="True" />
  </Grid>
</UserControl>
