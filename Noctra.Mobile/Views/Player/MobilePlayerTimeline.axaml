<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             x:Class="Noctra.Mobile.Views.Player.MobilePlayerTimeline"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto" Margin="0,4,0,4">
    <ProgressBar Minimum="0"
                 Maximum="{Binding Duration}"
                 Value="{Binding Position}"
                 Height="3"
                 CornerRadius="2"
                 IsVisible="{Binding !IsLiveContent}"
                 Background="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                 Foreground="{DynamicResource AccentBrush}" />
    <ProgressBar Minimum="0"
                 Maximum="100"
                 Value="{Binding LiveProgramProgress}"
                 Height="3"
                 CornerRadius="2"
                 IsVisible="{Binding IsLiveContent}"
                 Background="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                 Foreground="{DynamicResource AccentBrush}" />
  </Grid>
</UserControl>
