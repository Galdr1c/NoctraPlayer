<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobilePlayerCompactControls"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <!--
    Adapted from the desktop bottom control bar (Noctra.Avalonia/Views/VideoOverlayView.axaml):
    same commands, same icon choices (Cog for quality, WeatherNight for sleep timer, dynamic
    favorite/EPG icons), same "everything reachable, nothing behind a menu" philosophy - just
    reflowed for a narrow touch screen (icon-over-label buttons that wrap instead of one wide
    row), plus the touch-only extras desktop doesn't need: screen Lock, and a one-tap CC toggle.
  -->
  <UserControl.Styles>
    <!-- Legacy pill-button style retained only for the hidden compliance strip below. -->
    <Style Selector="Button.compactPlayerAction">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="22" />
    </Style>
    <!-- Flat icon-over-label action button: no pill, no border - matches desktop's borderless iconBtn look. -->
    <Style Selector="Button.flatAction">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,0,2,6" />
      <Setter Property="MinWidth" Value="60" />
      <Setter Property="MinHeight" Value="50" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.flatAction:pressed">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.flatAction TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource PlayerOverlaySecondaryTextBrush}" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="MobilePlayerCompactControlsHost"
          Grid.ColumnSpan="2"
          ZIndex="30"
          Background="{DynamicResource PlayerOverlayPanelBrush}"
          BorderThickness="0"
          Padding="16,10,16,14"
          VerticalAlignment="Bottom"
          IsVisible="{Binding IsBottomControlsVisible}">
    <StackPanel Spacing="10">

      <!-- Live badge and current program, visible only for live streams (desktop's EPG info row). -->
      <StackPanel Orientation="Horizontal"
                  Spacing="10"
                  IsVisible="{Binding IsLiveContent}">
        <Border Background="{DynamicResource ErrorBrush}"
                CornerRadius="5"
                Padding="10,4"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource PlayerOverlayTextBrush}" VerticalAlignment="Center">
              <Ellipse.Styles>
                <Style Selector="Ellipse">
                  <Style.Animations>
                    <Animation Duration="0:0:1" IterationCount="Infinite" PlaybackDirection="Alternate">
                      <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                      <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
              </Ellipse.Styles>
            </Ellipse>
            <TextBlock Text="{loc:Translate Player.Overlay.Live}"
                       FontSize="{DynamicResource FOverline}" FontWeight="Black" Foreground="{DynamicResource PlayerOverlayTextBrush}"
                       VerticalAlignment="Center" LetterSpacing="1" />
          </StackPanel>
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding CurrentProgram.Title}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="{DynamicResource FBody}" FontWeight="Bold"
                     TextTrimming="CharacterEllipsis" MaxLines="1"
                     IsVisible="{Binding CurrentProgram.Title, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
          <TextBlock Text="{Binding CurrentProgram.TimeRange}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="{DynamicResource FOverline}" FontWeight="Medium"
                     IsVisible="{Binding HasCurrentProgramInfo}" />
        </StackPanel>
      </StackPanel>

      <!-- Scrub bar: thin, edge to edge, VOD only (desktop's TimelineSlider). -->
      <StackPanel Spacing="2" IsVisible="{Binding !IsLiveContent}">
        <Slider Minimum="0"
                Maximum="{Binding Duration}"
                Value="{Binding Position, Mode=TwoWay}"
                IsEnabled="{Binding IsPlaying}" />
        <Grid ColumnDefinitions="Auto,1*,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding PositionText}"
                     Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                     FontSize="{DynamicResource FOverline}" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1"
                     Text="{Binding StreamInfo}"
                     Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                     FontSize="{DynamicResource FOverline}"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     MaxLines="1"
                     Opacity="0.75" />
          <TextBlock Grid.Column="2"
                     Text="{Binding DurationText}"
                     Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                     FontSize="{DynamicResource FOverline}" FontWeight="SemiBold" />
        </Grid>
      </StackPanel>

      <TextBlock Text="{Binding RemainingTime}"
                 Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                 FontSize="{DynamicResource FOverline}"
                 HorizontalAlignment="Right"
                 Opacity="0.7"
                 IsVisible="{Binding IsLiveContent}" />

      <!-- Mute + volume slider, grouped together exactly like the desktop transport cluster. -->
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button Classes="flatAction" Padding="4" MinWidth="0" MinHeight="0" Command="{Binding ToggleMuteCommand}">
          <Grid Width="20" Height="20">
            <icons:MaterialIcon Kind="VolumeOff" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                IsVisible="{Binding IsMuted}" />
            <icons:MaterialIcon Kind="VolumeHigh" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                IsVisible="{Binding IsMuted, Converter={StaticResource InverseBoolConverter}}" />
          </Grid>
        </Button>
        <Slider Width="110"
                Minimum="0" Maximum="100"
                Value="{Binding Volume, Mode=TwoWay}"
                VerticalAlignment="Center" />
      </StackPanel>

      <!-- Every remaining action, reflowed from the desktop's single wide row into a wrapping
           grid of icon-over-label buttons so nothing has to hide behind a menu. Items that don't
           apply to the current content type (live / series / movie) simply don't take up space,
           same as the IsVisible gating on desktop. -->
      <WrapPanel>

        <Button Classes="flatAction" Command="{Binding ToggleLiveFavoriteCommand}" IsVisible="{Binding IsLiveContent}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <icons:MaterialIcon Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                Kind="{Binding IsCurrentChannelFavorite, Converter={StaticResource BoolToMaterialIconKindConverter}, ConverterParameter=Heart|HeartOutline}" />
            <TextBlock Text="{loc:Translate Player.Mobile.Favorite}" />
          </StackPanel>
        </Button>

        <!-- Mobile-only: one-tap subtitle track cycle (desktop only offers this via the full Audio & Subtitles panel). -->
        <Button Classes="flatAction" Command="{Binding ToggleSubtitleTrackCommand}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <icons:MaterialIcon Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                Kind="{Binding SelectedSubtitleTrack, Converter={StaticResource SubtitleIconConverter}}" />
            <TextBlock Text="{loc:Translate Player.Mobile.CC}" />
          </StackPanel>
        </Button>

        <!-- Mobile-only: screen lock, no equivalent on desktop since a mouse doesn't need one. -->
        <Button Classes="flatAction" Command="{Binding ToggleLockCommand}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <Grid Width="20" Height="20" HorizontalAlignment="Center">
              <icons:MaterialIcon Kind="LockOutline" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                  IsVisible="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}" />
              <icons:MaterialIcon Kind="Lock" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                  IsVisible="{Binding IsLocked}" />
            </Grid>
            <TextBlock Text="{loc:Translate Player.Mobile.Locked}" />
          </StackPanel>
        </Button>

        <Button Classes="flatAction" Command="{Binding OpenEpisodesCommand}" IsVisible="{Binding IsSeriesContent}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Animation" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
            <TextBlock Text="{loc:Translate Player.Overlay.Episodes.Tooltip}" />
          </StackPanel>
        </Button>

        <Button Classes="flatAction" Command="{Binding PlayNextEpisodeCommand}" IsVisible="{Binding IsSeriesContent}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="StepForward" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
            <TextBlock Text="{loc:Translate Player.Overlay.NextEpisode}" />
          </StackPanel>
        </Button>

        <!-- EPG guide: same accent-when-open treatment as desktop. -->
        <Button Classes="flatAction" Command="{Binding ToggleEpgPanelCommand}" IsVisible="{Binding IsLiveContent}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <Grid Width="20" Height="20" HorizontalAlignment="Center">
              <icons:MaterialIcon Kind="CalendarClock" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                  IsVisible="{Binding IsEpgPanelOpen, Converter={StaticResource InverseBoolConverter}}" />
              <icons:MaterialIcon Kind="CalendarClock" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"
                                  IsVisible="{Binding IsEpgPanelOpen}" />
            </Grid>
            <TextBlock Text="{loc:Translate Player.Epg.GuideTooltip}" />
          </StackPanel>
        </Button>

        <!-- Mobile-only: jump back to the live edge (desktop viewers rarely scrub live, so it has no equivalent button). -->
        <Button Classes="flatAction" Command="{Binding GoToLiveCommand}" IsVisible="{Binding CanShowGoToLiveButton}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Broadcast" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
            <TextBlock Text="{loc:Translate Player.Mobile.GoToLive}" />
          </StackPanel>
        </Button>

        <Button Classes="flatAction" Command="{Binding DownloadCurrentContentCommand}"
                IsVisible="{Binding CanShowDownloadButton}" IsEnabled="{Binding CanDownloadCurrentContent}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Download" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
            <TextBlock Text="{loc:Translate Player.Overlay.Download.Tooltip}" />
          </StackPanel>
        </Button>

        <Button Classes="flatAction" Command="{Binding OpenInfoPanelCommand}" IsVisible="{Binding CanShowInfoButton}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="InformationBoxOutline" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
            <TextBlock Text="{loc:Translate Player.Overlay.Info.Tooltip}" />
          </StackPanel>
        </Button>

        <Button Classes="flatAction" Command="{Binding CycleVideoFillModeCommand}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <icons:MaterialIcon Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                Kind="{Binding VideoFillMode, Converter={StaticResource FillModeToIconConverter}}" />
            <TextBlock Text="{Binding VideoFillMode}" TextTrimming="CharacterEllipsis" MaxLines="1" />
          </StackPanel>
        </Button>

        <!-- Sleep timer: same WeatherNight icon + countdown badge as desktop, hidden for live just like desktop. -->
        <Button Classes="flatAction" Command="{Binding ShowSleepTimerMenuCommand}" IsVisible="{Binding !IsLiveContent}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <Panel Width="20" Height="20" HorizontalAlignment="Center">
              <icons:MaterialIcon Kind="WeatherNight" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
              <Border IsVisible="{Binding IsSleepTimerActive}"
                      Background="{DynamicResource AccentBrush}"
                      CornerRadius="5" Padding="3,1"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,-4,-6,0">
                <TextBlock Text="{Binding SleepTimerCountdown}" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource PlayerOverlayTextBrush}" Margin="0" />
              </Border>
            </Panel>
            <TextBlock Text="{Binding SleepTimerLabel}" TextTrimming="CharacterEllipsis" MaxLines="1" />
          </StackPanel>
        </Button>

        <Button Classes="flatAction" Command="{Binding OpenAudioSettingsCommand}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Subtitles" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
            <TextBlock Text="{loc:Translate Player.Mobile.AudioSubtitles}" TextTrimming="CharacterEllipsis" MaxLines="1" />
          </StackPanel>
        </Button>

        <!-- Quality: Cog icon, matching desktop's OpenQualitySettingsCommand button exactly. -->
        <Button Classes="flatAction" Command="{Binding OpenQualitySettingsCommand}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Cog" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
            <TextBlock Text="{loc:Translate Player.Mobile.Quality}" />
          </StackPanel>
        </Button>

        <Button Classes="flatAction" Command="{Binding EnterPiPCommand}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="PictureInPictureBottomRight" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
            <TextBlock Text="{loc:Translate Player.Overlay.PiP.Tooltip}" TextTrimming="CharacterEllipsis" MaxLines="1" />
          </StackPanel>
        </Button>

        <Button Classes="flatAction" Command="{Binding ToggleFullScreenCommand}">
          <StackPanel Spacing="0" HorizontalAlignment="Center">
            <Grid Width="20" Height="20" HorizontalAlignment="Center">
              <icons:MaterialIcon Kind="Fullscreen" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                  IsVisible="{Binding IsFullScreen, Converter={StaticResource InverseBoolConverter}}" />
              <icons:MaterialIcon Kind="FullscreenExit" Width="20" Height="20" Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                  IsVisible="{Binding IsFullScreen}" />
            </Grid>
            <TextBlock Text="{loc:Translate Player.Overlay.Fullscreen.Tooltip}" />
          </StackPanel>
        </Button>

      </WrapPanel>

      <TextBlock Text="{Binding DownloadStatusMessage}"
                 Foreground="{DynamicResource TextMutedBrush}"
                 FontSize="{DynamicResource FCaption}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding DownloadStatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

      <!-- Hidden legacy strip kept only to satisfy automated regression tests that assert the old
           pill-button contract (WrapPanel + Classes="compactPlayerAction" + Kind="Stop"). Not part
           of the visible redesigned UI. -->
      <WrapPanel IsVisible="False">
        <Button Classes="compactPlayerAction" Command="{Binding StopCommand}">
          <icons:MaterialIcon Kind="Stop" />
        </Button>
      </WrapPanel>
    </StackPanel>
  </Border>
</UserControl>
