<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:views="using:Noctra.Mobile.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileLegalConsentView"
             mc:Ignorable="d">
  <Grid Background="{DynamicResource OverlayModalDimBrush}">
    <Border Background="{DynamicResource BackgroundGradientBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="24,60,24,60"
            ClipToBounds="True"
            VerticalAlignment="Center"
            MaxWidth="480">
      <ScrollViewer>
        <StackPanel Margin="24" Spacing="20">
          <!-- Header -->
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <icons:MaterialIcon Grid.Column="0"
                                Kind="ShieldCheckOutline"
                                Width="34"
                                Height="34"
                                Foreground="{DynamicResource AccentLightBrush}"
                                VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{loc:Translate LegalConsent.Title}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="{DynamicResource FTitleM}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
          </Grid>

          <TextBlock Text="{loc:Translate LegalConsent.Message}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="{DynamicResource FOverline}"
                     LineHeight="15"
                     TextWrapping="Wrap"/>

          <!-- Checkboxes -->
          <Border Background="{DynamicResource Surface1Brush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="18">
            <StackPanel Spacing="10">
              <CheckBox x:Name="TermsAcceptedCheckBox"
                        Content="{loc:Translate LegalConsent.Check.Terms}"
                        FontSize="{DynamicResource FCaption}"
                        IsCheckedChanged="RequiredCheckBox_Changed"/>
              <CheckBox x:Name="NoContentCheckBox"
                        Content="{loc:Translate LegalConsent.Check.NoContent}"
                        FontSize="{DynamicResource FCaption}"
                        IsCheckedChanged="RequiredCheckBox_Changed"/>
              <CheckBox x:Name="LawfulSourcesCheckBox"
                        Content="{loc:Translate LegalConsent.Check.LawfulSources}"
                        FontSize="{DynamicResource FCaption}"
                        IsCheckedChanged="RequiredCheckBox_Changed"/>
              <CheckBox x:Name="PrivacyAcceptedCheckBox"
                        Content="{loc:Translate LegalConsent.Check.Privacy}"
                        FontSize="{DynamicResource FCaption}"
                        IsCheckedChanged="RequiredCheckBox_Changed"/>
              <CheckBox x:Name="DiagnosticDataCheckBox"
                        FontSize="{DynamicResource FCaption}"
                        Content="{loc:Translate LegalConsent.Check.Diagnostics}"/>
            </StackPanel>
          </Border>

          <!-- Action buttons -->
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="1"
                    Classes="Secondary"
                    MinHeight="30"
                    Click="Privacy_Click"
                    Content="{loc:Translate LegalConsent.Action.Privacy}"/>
            <Button Grid.Column="2"
                    Classes="Secondary"
                    MinHeight="30"
                    Click="Terms_Click"
                    Content="{loc:Translate LegalConsent.Action.Terms}"/>
          </Grid>

          <Button x:Name="ContinueButton"
                  IsEnabled="False"
                  MinHeight="48"
                  CornerRadius="4"
                  Background="{DynamicResource AccentBrush}"
                  Foreground="{DynamicResource PlayerOverlayTextBrush}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  FontWeight="SemiBold"
                  FontSize="{DynamicResource FBodyL}"
                  Click="Continue_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <icons:MaterialIcon Kind="Check" Width="18" Height="18" Foreground="{DynamicResource PlayerOverlayTextBrush}"/>
              <TextBlock Text="{loc:Translate LegalConsent.Action.Continue}" Foreground="{DynamicResource PlayerOverlayTextBrush}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <views:MobileLegalDocumentView x:Name="LegalDocumentHost"
                                   IsVisible="False" />
  </Grid>
</UserControl>
