<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.Mobile.ViewModels"
             xmlns:views="using:Noctra.Mobile.Views"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:corevm="using:Noctra.ViewModels"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="Noctra.Mobile.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource Bg0Brush}">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,8" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.nav:pressed icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="18" />
    </Style>

    <!-- Manage/Done button styling for the profiles overlay.  This style
         mirrors the desktop ProfilesWindow manage mode button style, but
         scaled for mobile.  It defines the default appearance (bordered
         outline with secondary text), a pointerover state that uses the
         accent colour, and an active state (when Tag=True) that inverts
         the colours.  The style is applied via the "ManageModeButtonStyle"
         class on the button in the profiles overlay. -->
    <Style Selector="Button.ManageModeButtonStyle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <!-- Slightly larger font and padding to match desktop while remaining
           comfortable on smaller screens -->
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="20,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <!-- Hover state: emphasise the button by switching to primary text and a
         lighter border when the user hovers/touches the button. -->
    <Style Selector="Button.ManageModeButtonStyle:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>
    <!-- Active state: when the button's Tag property is set to true (indicating
         manage mode is active), invert the colours to draw attention. -->
    <Style Selector="Button.ManageModeButtonStyle[Tag=True]">
      <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Bg0Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">
    <Border x:Name="HeaderBar"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="20,18,20,14"
            Background="{DynamicResource Bg1Brush}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="NOCTRA"
                     FontSize="12"
                     FontWeight="Bold"
                     Foreground="{DynamicResource AccentBrush}"
                     LetterSpacing="2" />
          <TextBlock Text="{Binding PageTitle}"
                     FontSize="26"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
        <Border Grid.Column="1"
                Width="40"
                Height="40"
                CornerRadius="20"
                Background="{DynamicResource AccentBrush}">
          <TextBlock Text="N"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>
      </Grid>
    </Border>

    <Border x:Name="NavigationRail"
            Grid.Row="1"
            Grid.Column="0"
            Width="128"
            Padding="12,20"
            Background="{DynamicResource Bg1Brush}"
            IsVisible="False">
      <StackPanel Spacing="8">
        <Button Classes="nav" Tag="Home" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="HomeVariantOutline" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.Home}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Live" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="Television" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.Live}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Movies" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="Filmstrip" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.Movies}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Series" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="TelevisionPlay" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.Series}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Search" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="Magnify" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Search.Tooltip}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Favorites" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="HeartOutline" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.Favorites}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="MyList" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="BookmarkOutline" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.MyList}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="History" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="History" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.History}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Downloads" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="DownloadOutline" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.Downloads}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Settings" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="CogOutline" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Settings.Title}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="More" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="DotsHorizontal" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Mobile.Nav.More}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1">
      <StackPanel x:Name="ShellContent"
                  Margin="20"
                  Spacing="16">
        <TextBlock Text="{Binding PageDescription}"
                   FontSize="15"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" />

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{loc:Translate Home.ContinueWatching}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{loc:Translate Home.EmptyState.Description}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <views:ProfileListView x:Name="MobileProfileList"
                               IsVisible="{Binding IsMoreSelected}" />

        <StackPanel IsVisible="{Binding IsMoreSelected}" Spacing="10">
          <TextBlock Text="{loc:Translate Mobile.More.Shortcuts}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />

          <Button Classes="nav" Tag="Series" Click="OnDestinationClick" MinHeight="48">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <icons:MaterialIcon Kind="TelevisionPlay" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Nav.Series}" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Tag="Favorites" Click="OnDestinationClick" MinHeight="48">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <icons:MaterialIcon Kind="HeartOutline" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Nav.Favorites}" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Tag="MyList" Click="OnDestinationClick" MinHeight="48">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <icons:MaterialIcon Kind="BookmarkOutline" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Nav.MyList}" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Tag="History" Click="OnDestinationClick" MinHeight="48">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <icons:MaterialIcon Kind="History" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Nav.History}" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Tag="Downloads" Click="OnDestinationClick" MinHeight="48">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <icons:MaterialIcon Kind="DownloadOutline" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Nav.Downloads}" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Click="OnSettingsClick" MinHeight="48">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <icons:MaterialIcon Kind="CogOutline" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Settings.Title}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Translate Live.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{loc:Translate Settings.Channels.Title}" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Translate Shell.Nav.Library}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{loc:Translate Home.QuickAccess.Movies.Description}" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <Grid x:Name="CoreContentHost"
            IsVisible="False">
        <views:MobileHomeView x:Name="MobileHomeContent"
                              IsVisible="False" />
        <views:MobileLiveView x:Name="MobileLiveContent"
                              IsVisible="False" />
        <views:MobileMoviesView x:Name="MobileMoviesContent"
                                IsVisible="False" />
        <views:MobileSeriesView x:Name="MobileSeriesContent"
                                IsVisible="False" />
        <views:MobileSearchView x:Name="MobileSearchContent"
                                IsVisible="False" />
        <views:MobileFavoritesView x:Name="MobileFavoritesContent"
                                   IsVisible="False" />
        <views:MobileMyListView x:Name="MobileMyListContent"
                                IsVisible="False" />
        <views:MobileHistoryView x:Name="MobileHistoryContent"
                                 IsVisible="False" />
        <views:MobileDownloadsView x:Name="MobileDownloadsContent"
                                   IsVisible="False" />
        <views:MobileSettingsView x:Name="MobileSettingsContent"
                                  IsVisible="False" />
        <views:MobileSeriesDetailView x:Name="MobileSeriesDetailContent" />
      </Grid>

      <Border x:Name="SelectedMediaHost"
              IsVisible="False">
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource Surface0Color}" Opacity="0.94" />
        </Border.Background>
        <Border CornerRadius="16"
                Padding="14"
                Margin="20"
                VerticalAlignment="Bottom"
                Background="Transparent">
          <StackPanel Spacing="4">
            <TextBlock x:Name="SelectedMediaTitle"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="SelectedMediaSubtitle"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Border>

      <Border x:Name="PlayerHost"
              IsVisible="False">
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource Bg0Color}" Opacity="0.8" />
        </Border.Background>
        <views:MobilePlayerView x:Name="MobilePlayerContent"
                                VerticalAlignment="Bottom" />
      </Border>
    </Grid>

    <Border x:Name="BottomNavigation"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="8,6,8,10"
            Background="{DynamicResource Bg1Brush}">
      <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
        <Button Grid.Column="0" Classes="nav" Tag="Home" Click="OnDestinationClick">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="HomeVariantOutline" Width="24" Height="24" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Translate Shell.Nav.Home}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="nav" Tag="Live" Click="OnDestinationClick">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Television" Width="24" Height="24" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Translate Shell.Nav.Live}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="nav" Tag="Movies" Click="OnDestinationClick">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Filmstrip" Width="24" Height="24" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Translate Shell.Nav.Movies}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="nav" Tag="Search" Click="OnDestinationClick">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Magnify" Width="24" Height="24" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Translate Shell.Search.Tooltip}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" Classes="nav" Tag="More" Click="OnDestinationClick">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Menu" Width="24" Height="24" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Translate Mobile.Nav.More}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Border x:Name="BackExitToast"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            ZIndex="49000"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="20,0,20,96"
            Padding="18,12"
            CornerRadius="18"
            Background="#E6000000"
            IsHitTestVisible="False"
            IsVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:MaterialIcon Kind="ExitToApp"
                            Width="20"
                            Height="20"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
        <TextBlock Text="{loc:Translate Shell.Mobile.BackToExit}"
                   Foreground="White"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Legal Consent Overlay -->
    <views:MobileLegalConsentView x:Name="LegalConsentOverlay"
                                  Grid.RowSpan="3"
                                  Grid.ColumnSpan="2"
                                  ZIndex="50000"
                                  IsVisible="False" />

    <!-- Splash Overlay -->
    <!--
      Displays a simple splash screen when the mobile application launches.  This overlay
      is initially visible and sits on top of all other content.  It shows the
      application name centred on a dark background.  The overlay is hidden
      programmatically once the application has warmed up (see MainView.axaml.cs),
      revealing the normal content underneath.  A higher ZIndex than the legal
      consent overlay ensures the splash appears above all other UI.
    -->
    <Border x:Name="SplashOverlay"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            ZIndex="60000"
            Background="{DynamicResource Bg0Brush}"
            IsVisible="True">
      <Border CornerRadius="24"
              Margin="32"
              Padding="40"
              MaxWidth="380"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource BackgroundGradientBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1">
        <Border.BoxShadow>
          <BoxShadows>0 10 40 10 #80000000</BoxShadows>
        </Border.BoxShadow>

        <StackPanel Spacing="20"
                    HorizontalAlignment="Center">
          <controls:PremiumSpinner Width="100"
                                   Height="100">
            <Image Source="avares://Noctra.Mobile/Assets/Square150x150Logo.png"
                   Width="50"
                   Height="50"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderTransformOrigin="50%,50%">
              <Image.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
              </Image.RenderTransform>
              <Image.Styles>
                <Style Selector="Image">
                  <Style.Animations>
                    <Animation Duration="0:0:1.5"
                               IterationCount="Infinite"
                               Easing="CubicEaseInOut">
                      <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.5" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9" />
                      </KeyFrame>
                      <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1.0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                      </KeyFrame>
                      <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.5" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9" />
                      </KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
              </Image.Styles>
            </Image>
          </controls:PremiumSpinner>
          <StackPanel Spacing="8">
            <TextBlock Text="Noctra IPTV"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Translate Splash.Initializing}"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Opacity="0.8"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Profiles Overlay -->
    <!--
      A full-screen profiles selection screen inspired by the desktop ProfilesWindow.
      This overlay is hidden by default and is made visible from code when the
      user needs to choose a profile (see MainView.axaml.cs).  While visible,
      the normal header and navigation are hidden to focus the user on picking
      a profile.  The overlay uses the same `ProfileListView` control used in
      other parts of the app, but presented with a header that mirrors the
      desktop layout.
    -->
    <Border x:Name="ProfilesOverlay"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            Background="{DynamicResource Bg0Brush}"
            ZIndex="55000"
            IsVisible="False">
      <Grid RowDefinitions="Auto,*">
        <!-- Header with title and manage/done button -->
        <Grid Margin="20" ColumnDefinitions="*,Auto">
          <StackPanel>
            <!-- Main title "Profiles" -->
            <TextBlock Text="{loc:Translate Profiles.Title}"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <!-- Subtitle prompting user to select a profile -->
            <TextBlock Text="{loc:Translate Profiles.SelectProfile}"
                       FontSize="14"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,4,0,0" />
          </StackPanel>
          <!-- Manage/Done button bound to the ProfilesViewModel ToggleManageModeCommand.
               Styling is applied via the ManageModeButtonStyle class defined in
               UserControl.Styles above.  The Tag property will be toggled in
               code-behind to switch between manage and done states. -->
          <Button Grid.Column="1"
                  x:Name="ProfilesManageButton"
                  x:DataType="corevm:ProfilesViewModel"
                  Margin="0"
                  Classes="ManageModeButtonStyle"
                  Command="{Binding ToggleManageModeCommand}"
                  Content="{loc:Translate Profiles.ManageMode.Manage}" />
        </Grid>
        <!-- Profiles list -->
        <views:ProfileListView x:Name="OverlayProfileList"
                               Grid.Row="1"
                               Margin="20,10"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
