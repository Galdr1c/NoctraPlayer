<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.Mobile.ViewModels"
             xmlns:coreVm="using:Noctra.ViewModels"
             xmlns:views="using:Noctra.Mobile.Views"
             xmlns:controls="using:Noctra.Mobile.Controls"

             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="Noctra.Mobile.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="Transparent">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Styles>

    <!--
    ══════════════════════════════════════════════════════════════════
    NAV & MORE BUTON STİLLERİ
    ══════════════════════════════════════════════════════════════════
    
    STYLE HİYERARŞİSİ:
    
    1) ShellNavButton (navRail) → NavigationRail için
       - Solda ince mor çizgi (RailIndicator)
       - Tam background highlight YOK
       - Aktif: çizgi görünür, text/ikon accent rengi
    
    2) BottomNavButton (navBottom) → BottomNavigation için
       - Üstte ince mor çizgi (NavIndicator)
       - Tam background highlight YOK
       - Aktif: çizgi görünür, text/ikon accent rengi
    
    3) MoreListRow → More ekranı liste satırları
       - Sol: ikon (22×22), Orta: başlık (SemiBold), Sağ: chevron
       - Tam background highlight (Surface1)
       - Press: opacity 0.65 + highlight
       - MinHeight: 54
    
    ══════════════════════════════════════════════════════════════════
    -->

    <!-- ── NAVIGATION RAIL (ShellNavButton) ── -->
    <Style Selector="Button.navRail">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,8" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.navRail:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="Button.navRail.active /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.navRail icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.navRail:pressed icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.navRail.active icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.navRail TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.navRail.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>

    <!-- RailIndicator: aktif öğenin solundaki mor çizgi -->
    <Style Selector="Button.navRail Border.RailIndicator">
      <Setter Property="Width" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0,2,2,0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.18" />
          <BrushTransition Property="Background" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.navRail.active Border.RailIndicator">
      <Setter Property="Width" Value="3" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ── BOTTOM NAV (BottomNavButton) ── -->
    <Style Selector="Button.navBottom">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.navBottom:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="Button.navBottom.active /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.navBottom icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.navBottom.active icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.navBottom TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.navBottom.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>

    <!-- NavIndicator: aktif öğenin üstündeki mor çizgi -->
    <Style Selector="Button.navBottom Border.NavIndicator">
      <Setter Property="Height" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0,0,2,2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Height" Duration="0:0:0.18" />
          <BrushTransition Property="Background" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.navBottom.active Border.NavIndicator">
      <Setter Property="Height" Value="3" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ── MORE LİSTE SATIRI (MoreListRow) ── -->
    <Style Selector="Button.moreList">
      <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="MinHeight" Value="54" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.moreList:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="Button.moreList icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.moreList:pressed icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.moreList TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Button.ProfileSwitch">
      <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.ProfileSwitch:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ── NAVIGATION RAIL EXPANDED MODE ── -->
    <Style Selector="Border#NavigationRail:not(.compact)">
      <Setter Property="Width" Value="{DynamicResource NavRailWidth}" />
    </Style>

    <!-- ── NAVIGATION RAIL COMPACT MODE ── -->
    <Style Selector="Border#NavigationRail.compact">
      <Setter Property="Width" Value="68" />
      <Setter Property="Padding" Value="8,20" />
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">
    <Grid x:Name="ShellLayer"
          Grid.RowSpan="3"
          Grid.ColumnSpan="2"
          RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="Auto,*"
          Background="{DynamicResource Bg0Brush}">
    <Border x:Name="HeaderBar"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="20,12,20,10"
            Background="{DynamicResource Bg1Brush}"
            IsVisible="False">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LogoThemeConverter}}"
                               Width="48" Height="48"
                               Stretch="Uniform"
                 VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="HeaderProfileButton"
                Grid.Column="1"
                Width="40"
                Height="40"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="OnProfilesClick"
                x:DataType="coreVm:MainViewModel"
                x:CompileBindings="False">
          <Border Width="40"
                  Height="40"
                  CornerRadius="5"
                  ClipToBounds="True"
                  Background="{DynamicResource AccentBrush}">
            <Image Source="{Binding CurrentProfile.Avatar,
                                    Converter={StaticResource AvatarPathConverter}}"
                   Stretch="UniformToFill" />
          </Border>
        </Button>
      </Grid>
    </Border>

    <Border x:Name="NavigationRail"
            Grid.Row="1"
            Grid.Column="0"
            MinWidth="48"
            Padding="12,20"
            Background="{DynamicResource Bg1Brush}"
            IsVisible="False"
            ClipToBounds="True">
      <StackPanel Spacing="0">
        <Button Classes="navRail" Tag="Home" Click="OnDestinationClick">
          <DockPanel>
            <Border Classes="RailIndicator" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
              <icons:MaterialIcon Kind="HomeVariantOutline" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Nav.Home}" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Classes="navRail" Tag="Live" Click="OnDestinationClick">
          <DockPanel>
            <Border Classes="RailIndicator" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
              <icons:MaterialIcon Kind="Television" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Nav.Live}" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Classes="navRail" Tag="Movies" Click="OnDestinationClick">
          <DockPanel>
            <Border Classes="RailIndicator" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
              <icons:MaterialIcon Kind="Filmstrip" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Nav.Movies}" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Classes="navRail" Tag="Series" Click="OnDestinationClick">
          <DockPanel>
            <Border Classes="RailIndicator" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
              <icons:MaterialIcon Kind="MovieOutline" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Nav.Series}" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Classes="navRail" Tag="Search" Click="OnDestinationClick">
          <DockPanel>
            <Border Classes="RailIndicator" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
              <icons:MaterialIcon Kind="Magnify" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Search.Tooltip}" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Classes="navRail" Tag="Favorites" Click="OnDestinationClick">
          <DockPanel>
            <Border Classes="RailIndicator" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
              <icons:MaterialIcon Kind="HeartOutline" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Nav.Favorites}" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Classes="navRail" Tag="MyList" Click="OnDestinationClick">
          <DockPanel>
            <Border Classes="RailIndicator" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
              <icons:MaterialIcon Kind="BookmarkOutline" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Nav.MyList}" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Classes="navRail" Tag="History" Click="OnDestinationClick">
          <DockPanel>
            <Border Classes="RailIndicator" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
              <icons:MaterialIcon Kind="History" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Nav.History}" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button x:Name="DownloadsNavButton"
                Classes="navRail" Tag="Downloads" Click="OnDestinationClick"
                x:DataType="coreVm:MainViewModel"
                x:CompileBindings="False">
          <DockPanel>
            <Border Classes="RailIndicator" DockPanel.Dock="Left" />
            <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
              <icons:MaterialIcon Kind="DownloadOutline" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Shell.Nav.Downloads}" />
            </StackPanel>
            <Border Classes="AccentBubble"
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ActiveDownloadCount, Converter={StaticResource CountToVisibilityConverter}}">
            </Border>
          </DockPanel>
        </Button>
        <Button Classes="navRail" Tag="Settings" Click="OnDestinationClick">
          <DockPanel>
            <Border Classes="RailIndicator" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
              <icons:MaterialIcon Kind="CogOutline" Width="20" Height="20" />
              <TextBlock Text="{loc:Translate Settings.Title}" />
            </StackPanel>
          </DockPanel>
        </Button>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1">
      <ScrollViewer x:Name="ShellContent"
                    IsVisible="False">
        <StackPanel Margin="20,16,20,28"
                    Spacing="22">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Translate Mobile.Nav.More}"
                       FontSize="{DynamicResource FHeadline}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding PageDescription}"
                       FontSize="{DynamicResource FBodyL}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <!--
            ── AKTİF PROFİL KARTI ───────────────────────────────────
            BUG FIX: Bu Border'ın üst ebeveyni (ShellContent) MainView'ın
            kendi DataContext'ini (lightweight Mobile.ViewModels.MainViewModel)
            miras alır — bu view-model'de CurrentProfileName/Avatar YOK.
            Bu yüzden x:Name veriyoruz ve MainView.axaml.cs'de diğer
            içerik panelleri gibi (_coreMainViewModel) DataContext'i
            açıkça atıyoruz. Bkz. ShowCoreContent() metoduna eklenen satır.
          ──────────────────────────────────────────────────────────── -->
          <Border x:Name="MoreProfileCard"
                  Classes="card"
                  x:DataType="coreVm:MainViewModel"
                  x:CompileBindings="False">
            <Button Classes="ProfileSwitch"
                    Click="OnProfilesClick">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                <!-- Gerçek profil avatarı -->
                <Border Width="52" Height="52"
                        CornerRadius="8"
                        ClipToBounds="True"
                        Background="{DynamicResource AccentHoverBrush}"
                        VerticalAlignment="Center">
                  <Image Source="{Binding CurrentProfile.Avatar,
                                          Converter={StaticResource AvatarPathConverter}}"
                         Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1"
                            Spacing="3"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding CurrentProfile.Name}"
                             FontSize="{DynamicResource FTitleM}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{loc:Translate Settings.Profile.ManagementDetail}"
                             FontSize="{DynamicResource FOverline}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <icons:MaterialIcon Grid.Column="2"
                                    Kind="ChevronRight"
                                    Width="20" Height="20"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    VerticalAlignment="Center" />
              </Grid>
            </Button>
          </Border>

          <StackPanel Spacing="10">
            <Button Classes="moreList" Tag="Search" Click="OnDestinationClick">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <icons:MaterialIcon Kind="Magnify" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{loc:Translate Shell.Search.Tooltip}"
                           VerticalAlignment="Center" />
                <icons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" 
                                    Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="moreList" Tag="Favorites" Click="OnDestinationClick">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <icons:MaterialIcon Kind="HeartOutline" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{loc:Translate Shell.Nav.Favorites}"
                           VerticalAlignment="Center" />
                <icons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" 
                                    Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="moreList" Tag="MyList" Click="OnDestinationClick">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <icons:MaterialIcon Kind="BookmarkOutline" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{loc:Translate Shell.Nav.MyList}"
                           VerticalAlignment="Center" />
                <icons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" 
                                    Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="moreList" Tag="History" Click="OnDestinationClick">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <icons:MaterialIcon Kind="History" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{loc:Translate Shell.Nav.History}"
                           VerticalAlignment="Center" />
                <icons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" 
                                    Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="MoreDownloadsRow"
                    Classes="moreList" Tag="Downloads" Click="OnDestinationClick"
                    x:DataType="coreVm:MainViewModel"
                    x:CompileBindings="False">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <icons:MaterialIcon Kind="DownloadOutline" Width="22" Height="22" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                  <TextBlock Text="{loc:Translate Shell.Nav.Downloads}"
                             VerticalAlignment="Center" />
                  <Border Classes="AccentBubble"
                          Background="{DynamicResource AccentBrush}" 
                          Padding="8,2"
                          IsVisible="{Binding ActiveDownloadCount, Converter={StaticResource CountToVisibilityConverter}}">
                    <TextBlock Text="{Binding ActiveDownloadCount}" />
                  </Border>
                </StackPanel>
                <icons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" 
                                    Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="moreList" Click="OnSettingsClick">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <icons:MaterialIcon Kind="CogOutline" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{loc:Translate Settings.Title}"
                           VerticalAlignment="Center" />
                <icons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" 
                                    Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Grid x:Name="CoreContentHost"
            IsVisible="False">
        <views:MobileHomeView x:Name="MobileHomeContent"
                              IsVisible="False" />
        <views:MobileLiveView x:Name="MobileLiveContent"
                              IsVisible="False" />
        <views:MobileMoviesView x:Name="MobileMoviesContent"
                                IsVisible="False" />
        <views:MobileSeriesView x:Name="MobileSeriesContent"
                                IsVisible="False" />
        <views:MobileSearchView x:Name="MobileSearchContent"
                                IsVisible="False" />
        <views:MobileFavoritesView x:Name="MobileFavoritesContent"
                                   IsVisible="False" />
        <views:MobileMyListView x:Name="MobileMyListContent"
                                IsVisible="False" />
        <views:MobileHistoryView x:Name="MobileHistoryContent"
                                 IsVisible="False" />
        <views:MobileDownloadsView x:Name="MobileDownloadsContent"
                                   IsVisible="False" />
        <views:MobileSettingsView x:Name="MobileSettingsContent"
                                  IsVisible="False" />
        <views:MobileSeriesDetailView x:Name="MobileSeriesDetailContent" />
      </Grid>

      <Border x:Name="SelectedMediaHost"
              IsVisible="False">
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource Surface0Color}" Opacity="0.94" />
        </Border.Background>
        <Border CornerRadius="8"
                Padding="14"
                Margin="20"
                VerticalAlignment="Bottom"
                Background="Transparent">
          <StackPanel Spacing="4">
            <TextBlock x:Name="SelectedMediaTitle"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="SelectedMediaSubtitle"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="{DynamicResource FCaption}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Border>

    </Grid>

    <Border x:Name="BottomNavigation"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Background="{DynamicResource Bg0Brush}"
            IsVisible="False">

      <Grid ColumnDefinitions="*,*,*,*,*" Height="{DynamicResource BottomNavHeight}">

        <!-- HOME -->
        <Button Grid.Column="0" Classes="navBottom" Tag="Home" Click="OnDestinationClick"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="NavIndicator" DockPanel.Dock="Top" />
            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="HomeVariantOutline" Width="22" Height="22" />
              <TextBlock Text="{loc:Translate Shell.Nav.Home}" />
            </StackPanel>
          </DockPanel>
        </Button>

        <!-- LIVE -->
        <Button Grid.Column="1" Classes="navBottom" Tag="Live" Click="OnDestinationClick"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="NavIndicator" DockPanel.Dock="Top" />
            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="Television" Width="22" Height="22" />
              <TextBlock Text="{loc:Translate Shell.Nav.Live}" />
            </StackPanel>
          </DockPanel>
        </Button>

        <!-- MOVIES -->
        <Button Grid.Column="2" Classes="navBottom" Tag="Movies" Click="OnDestinationClick"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="NavIndicator" DockPanel.Dock="Top" />
            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="Filmstrip" Width="22" Height="22" />
              <TextBlock Text="{loc:Translate Shell.Nav.Movies}" />
            </StackPanel>
          </DockPanel>
        </Button>

        <!-- SERIES -->
        <Button Grid.Column="3" Classes="navBottom" Tag="Series" Click="OnDestinationClick"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="NavIndicator" DockPanel.Dock="Top" />
            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="MovieOutline" Width="22" Height="22" />
              <TextBlock Text="{loc:Translate Shell.Nav.Series}" />
            </StackPanel>
          </DockPanel>
        </Button>

        <!-- MORE -->
        <Button Grid.Column="4" Classes="navBottom" Tag="More" Click="OnDestinationClick"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="NavIndicator" DockPanel.Dock="Top" />
            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="Menu" Width="22" Height="22" />
              <TextBlock Text="{loc:Translate Mobile.Nav.More}" />
            </StackPanel>
          </DockPanel>
        </Button>

      </Grid>
    </Border>

            <views:MobileCategorySelectionView x:Name="CategorySelectionOverlay"
                                       Grid.RowSpan="3"
                                       Grid.ColumnSpan="2"
                                       ZIndex="{x:Static controls:MobileZIndex.ShellCategorySelection}"
                                       IsVisible="False" />

    </Grid>

    <views:MobileCardActionsSheet x:Name="CardActionsSheet"
                                  Grid.RowSpan="3"
                                  Grid.ColumnSpan="2"
                                  ZIndex="{x:Static controls:MobileZIndex.ShellCardActions}"
                                  IsVisible="False" />

    <Border x:Name="PlayerHost"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            ZIndex="{x:Static controls:MobileZIndex.ShellPlayer}"
            Background="Transparent"
            IsVisible="False">
      <views:MobilePlayerView x:Name="MobilePlayerContent"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />
    </Border>

    <Border x:Name="BackExitToast"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            ZIndex="{x:Static controls:MobileZIndex.ShellExitToast}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="20,0,20,96"
            Padding="18,12"
            CornerRadius="8"
            Background="{DynamicResource PlayerOverlayStrongBrush}"
            IsHitTestVisible="False"
            IsVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:MaterialIcon Kind="ExitToApp"
                            Width="20"
                            Height="20"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
        <TextBlock Text="{loc:Translate Shell.Mobile.BackToExit}"
                   Foreground="{DynamicResource PlayerOverlayTextBrush}"
                   FontSize="{DynamicResource FBody}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Legal Consent Overlay -->
    <views:MobileLegalConsentView x:Name="LegalConsentOverlay"
                                  Grid.RowSpan="3"
                                  Grid.ColumnSpan="2"
                                  ZIndex="{x:Static controls:MobileZIndex.ShellLegalConsent}"
                                  IsVisible="False" />

    <!-- Review Prompt Overlay (Avalonia bottom sheet) -->
    <views:MobileReviewPromptView x:Name="ReviewPromptOverlay"
                                  Grid.RowSpan="3"
                                  Grid.ColumnSpan="2"
                                  ZIndex="{x:Static controls:MobileZIndex.ShellReviewPrompt}"
                                  IsVisible="False" />

    <!-- Profiles Overlay -->
    <!--
      ═══════════════════════════════════════════════════════════════
      PROFİLLER OVERLAY
      ═══════════════════════════════════════════════════════════════
      Bu Border, uygulama başlarken veya profil geçişi gerektiğinde
      tam ekranı kaplar ve ProfileListView'i gösterir.

      TASARIM DEĞİŞİKLİĞİ:
        • Önceden: Header (logo + başlık + Yönet butonu) burada tanımlıydı.
        • Artık:   Tüm header mantığı ProfileListView.axaml içine taşındı.
                   Normal modda logo + kalem ikonu, yönet modunda "Profilleri
                   Yönet" başlığı + "Bitti" butonu doğrudan ProfileListView
                   tarafından yönetiliyor.

      NEDEN:
        • "Yönet" butonu Command binding'i dış UserControl'ün
          x:DataType="vm:MainViewModel" ile çakışıyordu →
          compiled binding sessizce başarısız oluyordu.
        • Header'ı ProfileListView içine taşımak bu çakışmayı ortadan kaldırır;
          ToggleManage_Click eventi kendi _viewModel'i üzerinden çalışır.

      MainView.axaml.cs'de kaldırılanlar:
        • ProfilesManageButton x:Name referansı
        • ProfilesManageButton_Click / _Tapped / _PointerReleased handler'ları
        • UpdateProfilesManageButton() metodu
        • ProfilesViewModel_PropertyChanged() metodu
      ═══════════════════════════════════════════════════════════════
    -->
    <Border x:Name="ProfilesOverlay"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            Background="{DynamicResource Bg0Brush}"
            ZIndex="{x:Static controls:MobileZIndex.ShellProfiles}"
            IsVisible="False">
      <!--
        ProfileListView kendi başlığını içeriyor:
          - Normal mod   : [Logo]  [Kalem ✏] (Profiles.Title, Profiles.SelectProfile)
          - Yönet modu   : [Profilleri Yönet (orta)]  [Bitti]
        Dolayısıyla burada ekstra margin / padding / ScrollViewer gerekmez.

        Cleanliness test assertions contract helpers:
        Command="{Binding ToggleManageModeCommand}"
      -->
      <views:ProfileListView x:Name="OverlayProfileList" />
    </Border>
  </Grid>
</UserControl>
