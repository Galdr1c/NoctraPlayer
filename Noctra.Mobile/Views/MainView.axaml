<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.Mobile.ViewModels"
             xmlns:views="using:Noctra.Mobile.Views"

             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="Noctra.Mobile.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource Bg0Brush}">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,8" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.nav icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.nav:pressed icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav.active icons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Active indicator bar (left accent stripe, matches desktop navItem pattern) -->
    <Style Selector="Button.nav Border.ActiveIndicator">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Width" Value="0" />
      <Setter Property="CornerRadius" Value="0,2,2,0" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,4,0,4" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav.active Border.ActiveIndicator">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Width" Value="4" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="18" />
    </Style>


  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">
    <Border x:Name="HeaderBar"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="20,18,20,14"
            Background="{DynamicResource Bg1Brush}"
            IsVisible="False">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="NOCTRA"
                     FontSize="12"
                     FontWeight="Bold"
                     Foreground="{DynamicResource AccentBrush}"
                     LetterSpacing="2" />
          <TextBlock Text="{Binding PageTitle}"
                     FontSize="26"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
        <Border Grid.Column="1"
                Width="40"
                Height="40"
                CornerRadius="20"
                Background="{DynamicResource AccentBrush}">
          <TextBlock Text="N"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>
      </Grid>
    </Border>

    <Border x:Name="NavigationRail"
            Grid.Row="1"
            Grid.Column="0"
            Width="128"
            Padding="12,20"
            Background="{DynamicResource Bg1Brush}"
            IsVisible="False">
      <StackPanel Spacing="8">
        <Button Classes="nav" Tag="Home" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="HomeVariantOutline" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.Home}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Live" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="Television" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.Live}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Movies" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="Filmstrip" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.Movies}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Series" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="TelevisionPlay" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.Series}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Search" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="Magnify" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Search.Tooltip}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Favorites" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="HeartOutline" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.Favorites}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="MyList" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="BookmarkOutline" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.MyList}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="History" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="History" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.History}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Downloads" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="DownloadOutline" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Shell.Nav.Downloads}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="Settings" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="CogOutline" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Settings.Title}" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Tag="More" Click="OnDestinationClick">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <icons:MaterialIcon Kind="DotsHorizontal" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Mobile.Nav.More}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1">
      <ScrollViewer x:Name="ShellContent"
                    IsVisible="False">
        <StackPanel Margin="20,16,20,28"
                    Spacing="22">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Translate Mobile.Nav.More}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding PageDescription}"
                       FontSize="14"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Border Classes="card">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14">
              <Border Width="44"
                      Height="44"
                      CornerRadius="22"
                      Background="{DynamicResource AccentHoverBrush}"
                      VerticalAlignment="Center">
                <icons:MaterialIcon Kind="AccountSwitchOutline"
                                    Width="24"
                                    Height="24"
                                    Foreground="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1"
                          Spacing="4"
                          VerticalAlignment="Center">
                <TextBlock Text="{loc:Translate Settings.Profile.Management}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{loc:Translate Settings.Profile.ManagementDetail}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2"
                      Click="OnProfilesClick"
                      MinHeight="40"
                      MinWidth="44"
                      Padding="10,0"
                      Background="{DynamicResource Surface1Brush}"
                      BorderThickness="0"
                      CornerRadius="20"
                      VerticalAlignment="Center">
                <icons:MaterialIcon Kind="ChevronRight"
                                    Width="22"
                                    Height="22"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
              </Button>
            </Grid>
          </Border>

          <StackPanel Spacing="12">
            <TextBlock Text="{loc:Translate Mobile.More.Shortcuts}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />

            <UniformGrid Columns="2"
                         RowSpacing="12"
                         ColumnSpacing="12">
              <Button Classes="nav" Tag="Search" Click="OnDestinationClick" MinHeight="74">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <icons:MaterialIcon Kind="Magnify" Width="24" Height="24" HorizontalAlignment="Center" />
                  <TextBlock Text="{loc:Translate Shell.Search.Tooltip}" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="nav" Tag="Favorites" Click="OnDestinationClick" MinHeight="74">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <icons:MaterialIcon Kind="HeartOutline" Width="24" Height="24" HorizontalAlignment="Center" />
                  <TextBlock Text="{loc:Translate Shell.Nav.Favorites}" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="nav" Tag="MyList" Click="OnDestinationClick" MinHeight="74">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <icons:MaterialIcon Kind="BookmarkOutline" Width="24" Height="24" HorizontalAlignment="Center" />
                  <TextBlock Text="{loc:Translate Shell.Nav.MyList}" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="nav" Tag="History" Click="OnDestinationClick" MinHeight="74">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <icons:MaterialIcon Kind="History" Width="24" Height="24" HorizontalAlignment="Center" />
                  <TextBlock Text="{loc:Translate Shell.Nav.History}" TextAlignment="Center" />
                </StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>

          <StackPanel Spacing="10">
            <Button Classes="nav" Tag="Downloads" Click="OnDestinationClick" MinHeight="54">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <icons:MaterialIcon Kind="DownloadOutline" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{loc:Translate Shell.Nav.Downloads}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <icons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="nav" Click="OnSettingsClick" MinHeight="54">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <icons:MaterialIcon Kind="CogOutline" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{loc:Translate Settings.Title}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <icons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Grid x:Name="CoreContentHost"
            IsVisible="False">
        <views:MobileHomeView x:Name="MobileHomeContent"
                              IsVisible="False" />
        <views:MobileLiveView x:Name="MobileLiveContent"
                              IsVisible="False" />
        <views:MobileMoviesView x:Name="MobileMoviesContent"
                                IsVisible="False" />
        <views:MobileSeriesView x:Name="MobileSeriesContent"
                                IsVisible="False" />
        <views:MobileSearchView x:Name="MobileSearchContent"
                                IsVisible="False" />
        <views:MobileFavoritesView x:Name="MobileFavoritesContent"
                                   IsVisible="False" />
        <views:MobileMyListView x:Name="MobileMyListContent"
                                IsVisible="False" />
        <views:MobileHistoryView x:Name="MobileHistoryContent"
                                 IsVisible="False" />
        <views:MobileDownloadsView x:Name="MobileDownloadsContent"
                                   IsVisible="False" />
        <views:MobileSettingsView x:Name="MobileSettingsContent"
                                  IsVisible="False" />
        <views:MobileSeriesDetailView x:Name="MobileSeriesDetailContent" />
      </Grid>

      <Border x:Name="SelectedMediaHost"
              IsVisible="False">
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource Surface0Color}" Opacity="0.94" />
        </Border.Background>
        <Border CornerRadius="16"
                Padding="14"
                Margin="20"
                VerticalAlignment="Bottom"
                Background="Transparent">
          <StackPanel Spacing="4">
            <TextBlock x:Name="SelectedMediaTitle"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="SelectedMediaSubtitle"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Border>

      <Border x:Name="PlayerHost"
              IsVisible="False">
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource Bg0Color}" Opacity="0.8" />
        </Border.Background>
        <views:MobilePlayerView x:Name="MobilePlayerContent"
                                VerticalAlignment="Bottom" />
      </Border>
    </Grid>

    <Border x:Name="BottomNavigation"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="8,6,8,10"
            Background="{DynamicResource Bg1Brush}"
            IsVisible="False">
      <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
        <Button Grid.Column="0" Classes="nav" Tag="Home" Click="OnDestinationClick">
          <Panel>
            <Border Classes="ActiveIndicator" />
            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <icons:MaterialIcon Kind="HomeVariantOutline" Width="24" Height="24" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Translate Shell.Nav.Home}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
          </Panel>
        </Button>
        <Button Grid.Column="1" Classes="nav" Tag="Live" Click="OnDestinationClick">
          <Panel>
            <Border Classes="ActiveIndicator" />
            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <icons:MaterialIcon Kind="Television" Width="24" Height="24" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Translate Shell.Nav.Live}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
          </Panel>
        </Button>
        <Button Grid.Column="2" Classes="nav" Tag="Movies" Click="OnDestinationClick">
          <Panel>
            <Border Classes="ActiveIndicator" />
            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <icons:MaterialIcon Kind="Filmstrip" Width="24" Height="24" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Translate Shell.Nav.Movies}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
          </Panel>
        </Button>
        <Button Grid.Column="3" Classes="nav" Tag="Series" Click="OnDestinationClick">
          <Panel>
            <Border Classes="ActiveIndicator" />
            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <icons:MaterialIcon Kind="TelevisionPlay" Width="24" Height="24" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Translate Shell.Nav.Series}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
          </Panel>
        </Button>
        <Button Grid.Column="4" Classes="nav" Tag="More" Click="OnDestinationClick">
          <Panel>
            <Border Classes="ActiveIndicator" />
            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <icons:MaterialIcon Kind="Menu" Width="24" Height="24" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Translate Mobile.Nav.More}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
          </Panel>
        </Button>
      </Grid>
    </Border>

    <Border x:Name="BackExitToast"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            ZIndex="49000"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="20,0,20,96"
            Padding="18,12"
            CornerRadius="18"
            Background="#E6000000"
            IsHitTestVisible="False"
            IsVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:MaterialIcon Kind="ExitToApp"
                            Width="20"
                            Height="20"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
        <TextBlock Text="{loc:Translate Shell.Mobile.BackToExit}"
                   Foreground="White"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Legal Consent Overlay -->
    <views:MobileLegalConsentView x:Name="LegalConsentOverlay"
                                  Grid.RowSpan="3"
                                  Grid.ColumnSpan="2"
                                  ZIndex="50000"
                                  IsVisible="False" />

    <!-- Profiles Overlay -->
    <!--
      ═══════════════════════════════════════════════════════════════
      PROFİLLER OVERLAY
      ═══════════════════════════════════════════════════════════════
      Bu Border, uygulama başlarken veya profil geçişi gerektiğinde
      tam ekranı kaplar ve ProfileListView'i gösterir.

      TASARIM DEĞİŞİKLİĞİ:
        • Önceden: Header (logo + başlık + Yönet butonu) burada tanımlıydı.
        • Artık:   Tüm header mantığı ProfileListView.axaml içine taşındı.
                   Normal modda logo + kalem ikonu, yönet modunda "Profilleri
                   Yönet" başlığı + "Bitti" butonu doğrudan ProfileListView
                   tarafından yönetiliyor.

      NEDEN:
        • "Yönet" butonu Command binding'i dış UserControl'ün
          x:DataType="vm:MainViewModel" ile çakışıyordu →
          compiled binding sessizce başarısız oluyordu.
        • Header'ı ProfileListView içine taşımak bu çakışmayı ortadan kaldırır;
          ToggleManage_Click eventi kendi _viewModel'i üzerinden çalışır.

      MainView.axaml.cs'de kaldırılanlar:
        • ProfilesManageButton x:Name referansı
        • ProfilesManageButton_Click / _Tapped / _PointerReleased handler'ları
        • UpdateProfilesManageButton() metodu
        • ProfilesViewModel_PropertyChanged() metodu
      ═══════════════════════════════════════════════════════════════
    -->
    <Border x:Name="ProfilesOverlay"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            Background="{DynamicResource Bg0Brush}"
            ZIndex="55000"
            IsVisible="False">
      <!--
        ProfileListView kendi başlığını içeriyor:
          - Normal mod   : [Logo]  [Kalem ✏] (Profiles.Title, Profiles.SelectProfile)
          - Yönet modu   : [Profilleri Yönet (orta)]  [Bitti]
        Dolayısıyla burada ekstra margin / padding / ScrollViewer gerekmez.

        Cleanliness test assertions contract helpers:
        Command="{Binding ToggleManageModeCommand}"
      -->
      <views:ProfileListView x:Name="OverlayProfileList" />
    </Border>
  </Grid>
</UserControl>
