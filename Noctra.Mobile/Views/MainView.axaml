<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.Mobile.ViewModels"
             xmlns:views="using:Noctra.Mobile.Views"
             xmlns:corevm="using:Noctra.ViewModels"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="Noctra.Mobile.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#090B10">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#AEB5C5" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#202638" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#151923" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="18" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">
    <Border x:Name="HeaderBar"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="20,18,20,14"
            Background="#0E1118">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="NOCTRA"
                     FontSize="12"
                     FontWeight="Bold"
                     Foreground="#8F7CFF"
                     LetterSpacing="2" />
          <TextBlock Text="{Binding PageTitle}"
                     FontSize="26"
                     FontWeight="SemiBold"
                     Foreground="#FFFFFF" />
        </StackPanel>
        <Border Grid.Column="1"
                Width="40"
                Height="40"
                CornerRadius="20"
                Background="#8F7CFF">
          <TextBlock Text="N"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Foreground="#FFFFFF" />
        </Border>
      </Grid>
    </Border>

    <Border x:Name="NavigationRail"
            Grid.Row="1"
            Grid.Column="0"
            Width="128"
            Padding="12,20"
            Background="#0E1118"
            IsVisible="False">
      <StackPanel Spacing="8">
        <Button Classes="nav" Tag="Home" Content="Home" Click="OnDestinationClick" />
        <Button Classes="nav" Tag="Live" Content="Live" Click="OnDestinationClick" />
        <Button Classes="nav" Tag="Movies" Content="Movies" Click="OnDestinationClick" />
        <Button Classes="nav" Tag="Series" Content="Series" Click="OnDestinationClick" />
        <Button Classes="nav" Tag="Search" Content="Search" Click="OnDestinationClick" />
        <Button Classes="nav" Tag="Favorites" Content="Favorites" Click="OnDestinationClick" />
        <Button Classes="nav" Tag="MyList" Content="My List" Click="OnDestinationClick" />
        <Button Classes="nav" Tag="History" Content="History" Click="OnDestinationClick" />
        <Button Classes="nav" Tag="Downloads" Content="Downloads" Click="OnDestinationClick" />
        <Button Classes="nav" Tag="More" Content="More" Click="OnDestinationClick" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1">
      <StackPanel x:Name="ShellContent"
                  Margin="20"
                  Spacing="16">
        <TextBlock Text="{Binding PageDescription}"
                   FontSize="15"
                   Foreground="#AEB5C5"
                   TextWrapping="Wrap" />

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Continue watching"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF" />
            <TextBlock Text="Your recent content will appear here after profile setup."
                       Foreground="#AEB5C5"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <views:ProfileListView x:Name="MobileProfileList"
                               IsVisible="{Binding IsMoreSelected}" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Text="Live" FontWeight="SemiBold" Foreground="#FFFFFF" />
              <TextBlock Text="Channels" Foreground="#8F7CFF" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Text="Library" FontWeight="SemiBold" Foreground="#FFFFFF" />
              <TextBlock Text="Movies and series" Foreground="#8F7CFF" />
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <Grid x:Name="CoreContentHost"
            IsVisible="False">
        <views:MobileLiveView x:Name="MobileLiveContent"
                              IsVisible="False" />
        <views:MobileMoviesView x:Name="MobileMoviesContent"
                                IsVisible="False" />
        <views:MobileSeriesView x:Name="MobileSeriesContent"
                                IsVisible="False" />
        <views:MobileSearchView x:Name="MobileSearchContent"
                                IsVisible="False" />
        <views:MobileFavoritesView x:Name="MobileFavoritesContent"
                                   IsVisible="False" />
        <views:MobileMyListView x:Name="MobileMyListContent"
                                IsVisible="False" />
        <views:MobileHistoryView x:Name="MobileHistoryContent"
                                 IsVisible="False" />
        <views:MobileDownloadsView x:Name="MobileDownloadsContent"
                                   IsVisible="False" />
      </Grid>

      <Border x:Name="SelectedMediaHost"
              IsVisible="False"
              Background="#EE151923"
              CornerRadius="16"
              Padding="14"
              Margin="20"
              VerticalAlignment="Bottom">
        <StackPanel Spacing="4">
          <TextBlock x:Name="SelectedMediaTitle"
                     Foreground="#FFFFFF"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="SelectedMediaSubtitle"
                     Foreground="#AEB5C5"
                     FontSize="12"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border x:Name="PlayerHost"
              IsVisible="False"
              Background="#CC090B10">
        <views:MobilePlayerView x:Name="MobilePlayerContent"
                                VerticalAlignment="Bottom" />
      </Border>
    </Grid>

    <Border x:Name="BottomNavigation"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="8,6,8,10"
            Background="#0E1118">
      <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4">
        <Button Grid.Column="0" Classes="nav" Tag="Home" Content="Home" Click="OnDestinationClick" />
        <Button Grid.Column="1" Classes="nav" Tag="Live" Content="Live" Click="OnDestinationClick" />
        <Button Grid.Column="2" Classes="nav" Tag="Movies" Content="Movies" Click="OnDestinationClick" />
        <Button Grid.Column="3" Classes="nav" Tag="Series" Content="Series" Click="OnDestinationClick" />
        <Button Grid.Column="4" Classes="nav" Tag="Search" Content="Search" Click="OnDestinationClick" />
        <Button Grid.Column="5" Classes="nav" Tag="MyList" Content="List" Click="OnDestinationClick" />
        <Button Grid.Column="6" Classes="nav" Tag="More" Content="More" Click="OnDestinationClick" />
      </Grid>
    </Border>

  </Grid>
</UserControl>
