<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.UI.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:shared="using:Noctra.UI.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileHistoryView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False">
  <shared:AdaptiveLibraryView
      Title="{loc:Translate History.Title}"
      IsEmpty="{Binding ShowHistoryEmptyState}"
      EmptyIconKind="History"
      EmptyTitle="{loc:Translate History.Empty.Title}"
      EmptyDescription="{loc:Translate History.Empty.Description}">
    <shared:AdaptiveLibraryView.HeaderActionHost>
      <Button Command="{Binding ClearHistoryCommand}"
              IsVisible="{Binding ShowHistoryEmptyState, Converter={StaticResource InverseBoolConverter}}"
              Theme="{StaticResource DangerButtonStyle}"
              MinHeight="48"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <icons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14"
                              Foreground="{DynamicResource ErrorBrush}" />
          <TextBlock Text="{loc:Translate Settings.Privacy.Clear.Title}"
                     Foreground="{DynamicResource ErrorBrush}"
                     FontSize="{DynamicResource FCaption}"
                     FontWeight="Medium" />
        </StackPanel>
      </Button>
    </shared:AdaptiveLibraryView.HeaderActionHost>
    <shared:AdaptiveLibraryView.ItemsHost>
      <controls:MobileSectionedCardFeed x:Name="PrimaryScrollContent"
                                        ScrollChanged="HistoryScrollViewer_ScrollChanged"
                                        ItemContainerTheme="{StaticResource TransparentListBoxItemTheme}">
        <controls:MobileSectionedCardFeed.Sections>
          <controls:MobileCardSection Header="{loc:Translate History.LiveTv}" CardKind="Live" PresentationMode="History" SourceItems="{Binding HistoryLiveChannels}" />
          <controls:MobileCardSection Header="{loc:Translate History.Series}" CardKind="Series" PresentationMode="History" SourceItems="{Binding HistorySeriesItems}" />
          <controls:MobileCardSection Header="{loc:Translate History.Movies}" CardKind="Vod" PresentationMode="History" SourceItems="{Binding HistoryVodChannels}" />
        </controls:MobileSectionedCardFeed.Sections>
      </controls:MobileSectionedCardFeed>
    </shared:AdaptiveLibraryView.ItemsHost>
  </shared:AdaptiveLibraryView>
</UserControl>
