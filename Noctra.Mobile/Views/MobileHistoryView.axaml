<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             x:Class="Noctra.Mobile.Views.MobileHistoryView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <ScrollViewer x:Name="HistoryScrollViewer"
                ScrollChanged="HistoryScrollViewer_ScrollChanged">
    <StackPanel Margin="20" Spacing="14">
      <TextBlock Text="History"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Foreground="#FFFFFF" />

      <TextBlock Text="Live TV"
                 Foreground="#AEB5C5"
                 FontSize="12"
                 FontWeight="Bold" />
      <ItemsControl ItemsSource="{Binding HistoryLiveChannels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Channel">
            <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                    CommandParameter="{Binding}"
                    Background="#151923"
                    BorderThickness="0"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Name}"
                           Foreground="#FFFFFF"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding GroupTitle}"
                           Foreground="#AEB5C5"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Series"
                 Foreground="#AEB5C5"
                 FontSize="12"
                 FontWeight="Bold" />
      <ItemsControl ItemsSource="{Binding HistorySeriesItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Series">
            <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                    CommandParameter="{Binding}"
                    Background="#151923"
                    BorderThickness="0"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Name}"
                           Foreground="#FFFFFF"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding GroupTitle}"
                           Foreground="#AEB5C5"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Movies"
                 Foreground="#AEB5C5"
                 FontSize="12"
                 FontWeight="Bold" />
      <ItemsControl ItemsSource="{Binding HistoryVodChannels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Channel">
            <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                    CommandParameter="{Binding}"
                    Background="#151923"
                    BorderThickness="0"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Name}"
                           Foreground="#FFFFFF"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding GroupTitle}"
                           Foreground="#AEB5C5"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="8"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding ShowHistoryEmptyState}">
        <TextBlock Text="No watch history"
                   Foreground="#FFFFFF"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Text="Watched content will appear here."
                   Foreground="#AEB5C5"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
