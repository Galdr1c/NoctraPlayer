<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:models="using:Noctra.Models"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileHistoryView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390" d:DesignHeight="720">

  <ScrollViewer x:Name="HistoryScrollViewer"
                ScrollChanged="HistoryScrollViewer_ScrollChanged" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,16,20,28" Spacing="24">

      <!-- Title and clear action -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{loc:Translate History.Title}"
                   FontSize="28" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Command="{Binding ClearHistoryCommand}"
                IsVisible="{Binding ShowHistoryEmptyState,
                                    Converter={StaticResource InverseBoolConverter}}"
                Background="Transparent"
                BorderThickness="1"
                BorderBrush="{DynamicResource ErrorBrush}"
                CornerRadius="20"
                Padding="14,7"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14"
                                Foreground="{DynamicResource ErrorBrush}" />
            <TextBlock Text="{loc:Translate History.ClearAll}"
                       Foreground="{DynamicResource ErrorBrush}"
                       FontSize="13" FontWeight="Medium" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Live TV with inline history removal. -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding HistoryLiveChannels.Count,
                                      Converter={StaticResource CountToVisibilityConverter}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border Width="3" Height="20" CornerRadius="2"
                  Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{loc:Translate History.LiveTv}"
                     FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding HistoryLiveChannels}" HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Stretch" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <controls:MobileLiveTvCard ShowHistoryMenu="True"
                  ShowFavoriteMenu="False"
                  Margin="0,0,12,12"
                  Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl},
                                  Converter={StaticResource ResponsiveCardMetricConverter},
                                  ConverterParameter=liveWidth}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Series -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding HistorySeriesItems.Count,
                                      Converter={StaticResource CountToVisibilityConverter}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border Width="3" Height="20" CornerRadius="2"
                  Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{loc:Translate History.Series}"
                     FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding HistorySeriesItems}" HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Stretch" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Series">
              <controls:MobileSeriesCard ShowHistoryMenu="True"
                  Margin="0,0,12,12"
                  Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                  Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Movies -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding HistoryVodChannels.Count,
                                      Converter={StaticResource CountToVisibilityConverter}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border Width="3" Height="20" CornerRadius="2"
                  Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{loc:Translate History.Movies}"
                     FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding HistoryVodChannels}" HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Stretch" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <controls:MobileVodCard ShowHistoryMenu="True"
                  Margin="0,0,12,12"
                  Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                  Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Empty state -->
      <controls:MobileEmptyStateView
                  IsVisible="{Binding ShowHistoryEmptyState}"
                  IconKind="History"
                  Title="{loc:Translate History.Empty.Title}"
                  Description="{loc:Translate History.Empty.Description}" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
