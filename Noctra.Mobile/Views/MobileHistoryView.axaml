<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileHistoryView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d">

  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" Margin="24,24,24,12" ColumnDefinitions="*,Auto">
      <TextBlock Text="{loc:Translate History.Title}"
                 FontSize="{DynamicResource FDisplaySmall}" FontWeight="Bold"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1"
              Command="{Binding ClearHistoryCommand}"
              IsVisible="{Binding ShowHistoryEmptyState, Converter={StaticResource InverseBoolConverter}}"
              Theme="{StaticResource DangerButtonStyle}"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <icons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14"
                              Foreground="{DynamicResource ErrorBrush}" />
          <TextBlock Text="{loc:Translate Settings.Privacy.Clear.Title}"
                     Foreground="{DynamicResource ErrorBrush}"
                     FontSize="{DynamicResource FCaption}" FontWeight="Medium" />
        </StackPanel>
      </Button>
    </Grid>

    <controls:MobileSectionedCardFeed Grid.Row="1"
        Margin="20,0,20,0"
        ScrollChanged="HistoryScrollViewer_ScrollChanged"
        ItemContainerTheme="{StaticResource TransparentListBoxItemTheme}">
      <controls:MobileSectionedCardFeed.Sections>
        <controls:MobileCardSection Header="{loc:Translate History.LiveTv}"
            CardKind="Live" PresentationMode="History"
            SourceItems="{Binding HistoryLiveChannels}" />
        <controls:MobileCardSection Header="{loc:Translate History.Series}"
            CardKind="Series" PresentationMode="History"
            SourceItems="{Binding HistorySeriesItems}" />
        <controls:MobileCardSection Header="{loc:Translate History.Movies}"
            CardKind="Vod" PresentationMode="History"
            SourceItems="{Binding HistoryVodChannels}" />
      </controls:MobileSectionedCardFeed.Sections>
    </controls:MobileSectionedCardFeed>

    <controls:MobileEmptyStateView Grid.Row="1" Margin="20"
        IsVisible="{Binding ShowHistoryEmptyState}"
        IconKind="History"
        Title="{loc:Translate History.Empty.Title}"
        Description="{loc:Translate History.Empty.Description}" />
  </Grid>
</UserControl>
