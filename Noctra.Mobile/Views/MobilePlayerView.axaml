<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             x:Class="Noctra.Mobile.Views.MobilePlayerView"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="260">
  <Border Background="#F5090B10"
          Padding="16"
          CornerRadius="18"
          VerticalAlignment="Bottom"
          Margin="14">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding CurrentChannel.Name}"
                     Foreground="#FFFFFF"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConnectionStatus}"
                     Foreground="#AEB5C5"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="Close"
                Command="{Binding CloseCommand}"
                MinHeight="42"
                MinWidth="72"
                Margin="12,0,0,0" />
      </Grid>

      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="#FF6B6B"
                 TextWrapping="Wrap" />

      <Grid ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="10"
            VerticalAlignment="Center">
        <TextBlock Text="{Binding PositionText}"
                   Foreground="#E6FFFFFF"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Slider Grid.Column="1"
                Minimum="0"
                Maximum="{Binding Duration}"
                Value="{Binding Position, Mode=TwoWay}"
                IsEnabled="{Binding IsPlaying}" />
        <TextBlock Grid.Column="2"
                   Text="{Binding DurationText}"
                   Foreground="#AEB5C5"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <TextBlock Text="{Binding RemainingTime}"
                   Foreground="#AEB5C5"
                   FontSize="12"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding StreamInfo}"
                   Foreground="#AEB5C5"
                   FontSize="12"
                   TextAlignment="Right"
                   VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="Auto,Auto,*,Auto"
            ColumnSpacing="8"
            VerticalAlignment="Center">
        <Button Content="Play/Pause"
                Command="{Binding PlayPauseCommand}"
                MinHeight="44" />
        <Button Grid.Column="1"
                Content="Stop"
                Command="{Binding StopCommand}"
                MinHeight="44" />
        <Slider Grid.Column="2"
                Minimum="0"
                Maximum="100"
                Value="{Binding Volume, Mode=TwoWay}"
                VerticalAlignment="Center" />
        <Button Grid.Column="3"
                Content="Mute"
                Command="{Binding ToggleMuteCommand}"
                MinHeight="44" />
      </Grid>

      <Grid ColumnDefinitions="*,*,*,*,*"
            ColumnSpacing="8">
        <Button Content="-10s"
                Command="{Binding SkipBackwardCommand}"
                CommandParameter="10"
                IsVisible="{Binding !IsLiveContent}"
                MinHeight="40" />
        <Button Grid.Column="1"
                Content="+10s"
                Command="{Binding SkipForwardCommand}"
                CommandParameter="10"
                IsVisible="{Binding !IsLiveContent}"
                MinHeight="40" />
        <Button Grid.Column="2"
                Content="Favorite"
                Command="{Binding ToggleLiveFavoriteCommand}"
                MinHeight="40" />
        <Button Grid.Column="3"
                Content="{Binding VideoFillMode}"
                Command="{Binding CycleVideoFillModeCommand}"
                MinHeight="40" />
        <Button Grid.Column="4"
                Content="{Binding SleepTimerLabel}"
                Command="{Binding ShowSleepTimerMenuCommand}"
                MinHeight="40" />
      </Grid>

      <TextBlock Text="{Binding SleepTimerCountdown}"
                 Foreground="#AEB5C5"
                 FontSize="12"
                 HorizontalAlignment="Right" />

      <Border Background="#1FFFFFFF"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsSleepTimerPanelOpen}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SleepTimerLabel}"
                     Foreground="#FFFFFF"
                     FontSize="13"
                     FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="8"
                RowSpacing="8">
            <Button Content="Off"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Off}"
                    MinHeight="40" />
            <Button Grid.Column="1"
                    Content="15 min"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes15}"
                    MinHeight="40" />
            <Button Grid.Row="1"
                    Content="30 min"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes30}"
                    MinHeight="40" />
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Content="60 min"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes60}"
                    MinHeight="40" />
            <Button Grid.Row="2"
                    Content="End"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.EndOfEpisode}"
                    MinHeight="40" />
            <Button Grid.Row="2"
                    Grid.Column="1"
                    Content="Cancel"
                    Command="{Binding CancelSleepTimerCommand}"
                    IsVisible="{Binding IsSleepTimerActive}"
                    MinHeight="40" />
          </Grid>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*,*"
            ColumnSpacing="8">
        <Border Background="#1FFFFFFF"
                CornerRadius="10"
                Padding="10,8">
          <StackPanel Spacing="2">
            <TextBlock Text="Resolution"
                       Foreground="#8090A0"
                       FontSize="10"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding QualityResolutionText}"
                       Foreground="#FFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1"
                Background="#1FFFFFFF"
                CornerRadius="10"
                Padding="10,8">
          <StackPanel Spacing="2">
            <TextBlock Text="FPS"
                       Foreground="#8090A0"
                       FontSize="10"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding QualityFpsText}"
                       Foreground="#FFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2"
                Background="#1FFFFFFF"
                CornerRadius="10"
                Padding="10,8">
          <StackPanel Spacing="2">
            <TextBlock Text="Audio"
                       Foreground="#8090A0"
                       FontSize="10"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding QualityAudioText}"
                       Foreground="#FFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
