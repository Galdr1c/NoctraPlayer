<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="using:Noctra.Mobile.Views"
             xmlns:player="using:Noctra.Mobile.Views.Player"
             x:Class="Noctra.Mobile.Views.MobilePlayerView"
             x:Name="PlayerRoot"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d">
  <Grid Background="Transparent"
        ClipToBounds="True"
        Tapped="OnPlayerBackgroundTapped">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Layer 0: Native video surface -->
    <Grid x:Name="VideoSurfaceLayer"
          Grid.ColumnSpan="2"
          ClipToBounds="True"
          IsVisible="{Binding !IsEpgPanelOpen}">
      <Border x:Name="VideoSurfaceSlot"
              Background="Transparent"
              ClipToBounds="True"
              IsHitTestVisible="False" />
      <views:MobileWatermarkView x:Name="MobileWatermark"
                                 ZIndex="10"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,24,120"
                                 IsHitTestVisible="False" />
    </Grid>

    <!-- Layer 1: Gesture zones (sol/sağ yarı) -->
    <Border x:Name="LeftZone" Grid.Column="0" Background="Transparent"
            DoubleTapped="OnLeftDoubleTapped"
            PointerPressed="OnZonePointerPressed"
            PointerMoved="OnZonePointerMoved"
            PointerReleased="OnZonePointerReleased" />
    <Border x:Name="RightZone" Grid.Column="1" Background="Transparent"
            DoubleTapped="OnRightDoubleTapped"
            PointerPressed="OnZonePointerPressed"
            PointerMoved="OnZonePointerMoved"
            PointerReleased="OnZonePointerReleased" />

    <!-- Layer 2: Üst gradient + içerik bilgisi -->
    <Border Grid.ColumnSpan="2"
            ZIndex="20"
            Height="130"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            IsVisible="{Binding IsTopOverlayVisible}">
      <Border.Styles>
        <Style Selector="Border">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
      </Border.Styles>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#D9000000" />
          <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <views:MobilePlayerTopOverlay Grid.ColumnSpan="2"
                                  ZIndex="21"
                                  VerticalAlignment="Top"
                                  IsVisible="{Binding IsTopOverlayVisible}">
      <views:MobilePlayerTopOverlay.Styles>
        <Style Selector="views|MobilePlayerTopOverlay">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
      </views:MobilePlayerTopOverlay.Styles>
    </views:MobilePlayerTopOverlay>

    <!-- Layer 3: Alt gradient -->
    <Border Grid.ColumnSpan="2"
            ZIndex="20"
            Height="240"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            IsVisible="{Binding IsTopOverlayVisible}">
      <Border.Styles>
        <Style Selector="Border">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
      </Border.Styles>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#00000000" />
          <GradientStop Offset="1" Color="#E6000000" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <!-- Layer 4: Transport bar -->
    <views:MobilePlayerCompactControls x:Name="PlayerControls"
                                       Grid.ColumnSpan="2"
                                       ZIndex="21"
                                       VerticalAlignment="Bottom"
                                       IsVisible="{Binding IsBottomControlsVisible}">
      <views:MobilePlayerCompactControls.Styles>
        <Style Selector="views|MobilePlayerCompactControls">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
      </views:MobilePlayerCompactControls.Styles>
    </views:MobilePlayerCompactControls>

    <!-- Subtitles (alt konum) -->
    <Border Grid.ColumnSpan="2"
            ZIndex="15"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Margin="18,0,18,96"
            Padding="10,6"
            CornerRadius="8"
            Background="{Binding SubtitleBackgroundOpacity, Converter={StaticResource SubtitleBackgroundBrushConverter}}"
            IsHitTestVisible="False"
            IsVisible="{Binding IsMobileSubtitleBottomVisible}">
      <TextBlock Text="{Binding CurrentSubtitleText}"
                 Foreground="{DynamicResource PlayerOverlayTextBrush}"
                 FontSize="{Binding SubtitleFontSize}"
                 FontWeight="SemiBold"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 MaxLines="3" />
    </Border>

    <!-- Subtitles (üst konum) -->
    <Border Grid.ColumnSpan="2"
            ZIndex="15"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Margin="18,72,18,0"
            Padding="10,6"
            CornerRadius="8"
            Background="{Binding SubtitleBackgroundOpacity, Converter={StaticResource SubtitleBackgroundBrushConverter}}"
            IsHitTestVisible="False"
            IsVisible="{Binding IsMobileSubtitleTopVisible}">
      <TextBlock Text="{Binding CurrentSubtitleText}"
                 Foreground="{DynamicResource PlayerOverlayTextBrush}"
                 FontSize="{Binding SubtitleFontSize}"
                 FontWeight="SemiBold"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 MaxLines="3" />
    </Border>

    <!-- Buffering shield -->
    <Border Grid.ColumnSpan="2"
            ZIndex="25"
            Background="{DynamicResource PlayerOverlayShieldBrush}"
            IsHitTestVisible="False"
            IsVisible="{Binding IsBufferShieldVisible}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="14"
                  MaxWidth="320">
        <Grid Width="64" Height="64" HorizontalAlignment="Center">
          <Arc Width="58" Height="58"
               Stroke="{DynamicResource AccentBrush}"
               StrokeThickness="4"
               StartAngle="0"
               SweepAngle="95"
               VerticalAlignment="Center"
               HorizontalAlignment="Center">
            <Arc.RenderTransform>
              <RotateTransform />
            </Arc.RenderTransform>
            <Arc.Styles>
              <Style Selector="Arc">
                <Style.Animations>
                  <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame KeyTime="0:0:0"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame KeyTime="0:0:1"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                  </Animation>
                </Style.Animations>
              </Style>
            </Arc.Styles>
          </Arc>
        </Grid>
        <TextBlock Text="{Binding PlayerLoadingWarningMessage}"
                   Foreground="{DynamicResource WarningBrush}"
                   FontSize="{DynamicResource FCaption}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="300"
                   IsVisible="{Binding PlayerLoadingWarningMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
      </StackPanel>
    </Border>

    <!-- Overlay mesajı -->
    <Border Grid.ColumnSpan="2"
            ZIndex="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="320"
            Padding="18,12"
            CornerRadius="8"
            Background="{DynamicResource PlayerOverlayShieldBrush}"
            IsHitTestVisible="False"
            IsVisible="{Binding IsOverlayMessageVisible}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:MaterialIcon Kind="AlertCircleOutline"
                            Width="22" Height="22"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
        <TextBlock Text="{Binding OverlayMessage}"
                   Foreground="{DynamicResource PlayerOverlayTextBrush}"
                   FontSize="{DynamicResource FBody}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Volume toast -->
    <Border Grid.ColumnSpan="2"
            ZIndex="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,54,0,0"
            Padding="20,12"
            CornerRadius="8"
            Background="{DynamicResource PlayerOverlayShieldBrush}"
            IsHitTestVisible="False"
            IsVisible="{Binding #PlayerRoot.IsVolumeToastVisible}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:MaterialIcon Kind="VolumeOff"
                            Width="22" Height="22"
                            Foreground="{DynamicResource PlayerOverlayTextBrush}"
                            IsVisible="{Binding IsMuted}" />
        <icons:MaterialIcon Kind="VolumeHigh"
                            Width="22" Height="22"
                            Foreground="{DynamicResource PlayerOverlayTextBrush}"
                            IsVisible="{Binding IsMuted, Converter={StaticResource InverseBoolConverter}}" />
        <TextBlock Text="{loc:Translate Player.Muted}"
                   Foreground="{DynamicResource PlayerOverlayTextBrush}"
                   FontSize="{DynamicResource FTitleM}"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsMuted}" />
        <TextBlock Text="{Binding Volume, StringFormat='{}{0}%'}"
                   Foreground="{DynamicResource PlayerOverlayTextBrush}"
                   FontSize="{DynamicResource FTitleM}"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsMuted, Converter={StaticResource InverseBoolConverter}}" />
      </StackPanel>
    </Border>

    <!-- Seek / double-tap feedback -->
    <Border Grid.ColumnSpan="2"
            ZIndex="41"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="22,14"
            CornerRadius="8"
            Background="{DynamicResource PlayerOverlayShieldBrush}"
            IsHitTestVisible="False"
            IsVisible="{Binding #PlayerRoot.IsSeekToastVisible}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:MaterialIcon Kind="{Binding #PlayerRoot.SeekToastIcon}"
                            Width="26" Height="26"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
        <TextBlock Text="{Binding #PlayerRoot.SeekToastText}"
                   Foreground="{DynamicResource PlayerOverlayTextBrush}"
                   FontSize="{DynamicResource FTitleL}"
                   FontWeight="Black"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Download toast -->
    <Border Grid.ColumnSpan="2"
            ZIndex="42"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="18,0,18,148"
            Padding="18,12"
            CornerRadius="8"
            Background="{DynamicResource PlayerOverlayShieldBrush}"
            IsHitTestVisible="False"
            IsVisible="{Binding #PlayerRoot.IsDownloadToastVisible}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:MaterialIcon Kind="DownloadOutline"
                            Width="22" Height="22"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
        <TextBlock Text="{Binding DownloadStatusMessage}"
                   Foreground="{DynamicResource PlayerOverlayTextBrush}"
                   FontSize="{DynamicResource FBody}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   MaxWidth="280"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Gesture feedback -->
    <Border Grid.ColumnSpan="2"
            ZIndex="43"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="18"
            Padding="18,12"
            CornerRadius="8"
            Background="{DynamicResource PlayerOverlayShieldBrush}"
            IsHitTestVisible="False"
            IsVisible="{Binding #PlayerRoot.IsGestureToastVisible}">
      <TextBlock Text="{Binding #PlayerRoot.GestureToastText}"
                 Foreground="{DynamicResource PlayerOverlayTextBrush}"
                 FontSize="{DynamicResource FBodyL}"
                 FontWeight="Bold"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="300" />
    </Border>

    <!-- Kilitliyken kısa süre görünür; tek dokunuşta kilidi açar. -->
    <Button x:Name="LockIndicator"
            Grid.ColumnSpan="2"
            ZIndex="50"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,48,0,0"
            MinWidth="60"
            MinHeight="56"
            Padding="14,8"
            CornerRadius="8"
            Background="{DynamicResource PlayerOverlayShieldBrush}"
            BorderThickness="0"
            IsVisible="False"
            IsHitTestVisible="{Binding IsLockIndicatorVisible}"
            Command="{Binding ToggleLockCommand}"
            AutomationProperties.Name="{Binding LockAccessibilityName}"
            Opacity="0"
            RenderTransformOrigin="50%,50%">
      <Button.RenderTransform>
        <TransformGroup>
          <ScaleTransform ScaleX="1"
                          ScaleY="1" />
          <RotateTransform Angle="0" />
          <TranslateTransform X="0"
                              Y="0" />
        </TransformGroup>
      </Button.RenderTransform>
      <icons:MaterialIcon Kind="Lock"
                          Width="28"
                          Height="28"
                          Foreground="{DynamicResource PlayerOverlayTextBrush}" />
    </Button>

    <!-- Layer 5: Sheet katmanı (en üst) -->
    <views:MobilePlayerSheets Grid.ColumnSpan="2"
                              ZIndex="100"
                              VerticalAlignment="Bottom"
                              IsVisible="{Binding IsMobileDetailPanelOpen}">
      <views:MobilePlayerSheets.Styles>
        <Style Selector="views|MobilePlayerSheets">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
              <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
      </views:MobilePlayerSheets.Styles>
    </views:MobilePlayerSheets>

    <!-- Layer 6: EPG panel -->
    <views:MobilePlayerEpgPanel x:Name="EpgPanel"
                                Grid.ColumnSpan="2"
                                ZIndex="90"
                                IsVisible="{Binding IsEpgPanelOpen}" />
  </Grid>
</UserControl>
