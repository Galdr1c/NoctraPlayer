<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobilePlayerView"
             x:Name="PlayerRoot"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="260">
  <UserControl.Styles>
    <Style Selector="Button.compactPlayerAction">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Bg0Brush}"
          Padding="16"
          CornerRadius="18"
          VerticalAlignment="Bottom"
          Margin="14">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding CurrentChannel.Name}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConnectionStatus}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1"
                Command="{Binding CloseCommand}"
                MinHeight="42"
                MinWidth="72"
                Margin="12,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:MaterialIcon Kind="Close" Width="18" Height="18" />
            <TextBlock Text="{loc:Translate Common.Close}" />
          </StackPanel>
        </Button>
      </Grid>

      <Grid ColumnDefinitions="*,*,*"
            ColumnSpacing="8">
        <Button Command="{Binding ToggleLockCommand}"
                MinHeight="40">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="LockOutline" Width="18" Height="18" />
            <TextBlock Text="{Binding IsLocked, Converter={StaticResource StringFormatConverter}, ConverterParameter='Player.Mobile.LockFormat'}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1"
                Command="{Binding ToggleFullScreenCommand}"
                MinHeight="40">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Fullscreen" Width="18" Height="18" />
            <TextBlock Text="{Binding IsFullScreen, Converter={StaticResource StringFormatConverter}, ConverterParameter='Player.Mobile.FullscreenFormat'}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2"
                Command="{Binding EnterPiPCommand}"
                MinHeight="40">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="PictureInPictureBottomRight" Width="18" Height="18" />
            <TextBlock Text="{loc:Translate Player.Overlay.PiP.Tooltip}" />
          </StackPanel>
        </Button>
      </Grid>

      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource ErrorBrush}"
                 TextWrapping="Wrap" />

      <Grid ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="10"
            VerticalAlignment="Center">
        <TextBlock Text="{Binding PositionText}"
                   Foreground="{DynamicResource OverlayTextBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Slider Grid.Column="1"
                Minimum="0"
                Maximum="{Binding Duration}"
                Value="{Binding Position, Mode=TwoWay}"
                IsEnabled="{Binding IsPlaying}" />
        <TextBlock Grid.Column="2"
                   Text="{Binding DurationText}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <TextBlock Text="{Binding RemainingTime}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding StreamInfo}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   TextAlignment="Right"
                   VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="Auto,Auto,*,Auto"
            ColumnSpacing="8"
            VerticalAlignment="Center">
        <Button Command="{Binding PlayPauseCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:MaterialIcon Kind="Play" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Player.Overlay.PlayPause.Tooltip}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1"
                Command="{Binding StopCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:MaterialIcon Kind="Stop" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Player.Mobile.Stop}" />
          </StackPanel>
        </Button>
        <Slider Grid.Column="2"
                Minimum="0"
                Maximum="100"
                Value="{Binding Volume, Mode=TwoWay}"
                VerticalAlignment="Center" />
        <Button Grid.Column="3"
                Command="{Binding ToggleMuteCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:MaterialIcon Kind="VolumeOff" Width="20" Height="20" />
            <TextBlock Text="{loc:Translate Player.Mobile.Mute}" />
          </StackPanel>
        </Button>
      </Grid>

      <WrapPanel Orientation="Horizontal"
                 ItemSpacing="8"
                 LineSpacing="8">
        <Button Classes="compactPlayerAction"
                Command="{Binding SkipBackwardCommand}"
                CommandParameter="10"
                IsVisible="{Binding !IsLiveContent}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Rewind10" Width="18" Height="18" />
            <TextBlock Text="-10s" />
          </StackPanel>
        </Button>
        <Button Classes="compactPlayerAction"
                Command="{Binding SkipForwardCommand}"
                CommandParameter="10"
                IsVisible="{Binding !IsLiveContent}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="FastForward10" Width="18" Height="18" />
            <TextBlock Text="+10s" />
          </StackPanel>
        </Button>
        <Button Classes="compactPlayerAction"
                Command="{Binding ToggleLiveFavoriteCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="HeartOutline" Width="18" Height="18" />
            <TextBlock Text="{loc:Translate Player.Mobile.Favorite}" />
          </StackPanel>
        </Button>
        <Button Classes="compactPlayerAction"
                Command="{Binding CycleVideoFillModeCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="AspectRatio" Width="18" Height="18" />
            <TextBlock Text="{Binding VideoFillMode}" />
          </StackPanel>
        </Button>
        <Button Classes="compactPlayerAction"
                Command="{Binding ShowSleepTimerMenuCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="TimerOutline" Width="18" Height="18" />
            <TextBlock Text="{Binding SleepTimerLabel}" />
          </StackPanel>
        </Button>
      </WrapPanel>

      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="8"
            IsVisible="{Binding IsLiveContent}">
        <Button Content="{loc:Translate Player.Mobile.Previous}"
                Command="{Binding PlayPreviousLiveChannelCommand}"
                MinHeight="40" />
        <Button Grid.Column="1"
                Content="{loc:Translate Player.Mobile.Next}"
                Command="{Binding PlayNextLiveChannelCommand}"
                MinHeight="40" />
      </Grid>

      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="8"
            IsVisible="{Binding IsSeriesContent}">
        <Button Content="{loc:Translate Player.Overlay.Episodes.Tooltip}"
                Command="{Binding OpenEpisodesCommand}"
                MinHeight="40" />
        <Button Grid.Column="1"
                Content="{loc:Translate Player.Overlay.NextEpisode}"
                Command="{Binding PlayNextEpisodeCommand}"
                MinHeight="40" />
      </Grid>

      <TextBlock Text="{Binding SleepTimerCountdown}"
                 Foreground="{DynamicResource TextMutedBrush}"
                 FontSize="12"
                 HorizontalAlignment="Right" />

      <Border Background="{DynamicResource OverlayBackgroundBrush}"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsSleepTimerPanelOpen}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SleepTimerLabel}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="13"
                     FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="8"
                RowSpacing="8">
            <Button Content="{loc:Translate Player.Mobile.Sleep.Off}"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Off}"
                    MinHeight="40" />
            <Button Grid.Column="1"
                    Content="{loc:Translate Player.Mobile.Sleep.15min}"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes15}"
                    MinHeight="40" />
            <Button Grid.Row="1"
                    Content="{loc:Translate Player.Mobile.Sleep.30min}"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes30}"
                    MinHeight="40" />
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Content="{loc:Translate Player.Mobile.Sleep.60min}"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes60}"
                    MinHeight="40" />
            <Button Grid.Row="2"
                    Content="{loc:Translate Player.Mobile.Sleep.End}"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.EndOfEpisode}"
                    MinHeight="40" />
            <Button Grid.Row="2"
                    Grid.Column="1"
                    Content="{loc:Translate Player.Mobile.Sleep.Cancel}"
                    Command="{Binding CancelSleepTimerCommand}"
                    IsVisible="{Binding IsSleepTimerActive}"
                    MinHeight="40" />
          </Grid>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*,*"
            ColumnSpacing="8">
        <Button Content="{loc:Translate Player.Overlay.Download.Tooltip}"
                Command="{Binding DownloadCurrentContentCommand}"
                IsVisible="{Binding CanShowDownloadButton}"
                IsEnabled="{Binding CanDownloadCurrentContent}"
                MinHeight="40" />
        <Button Grid.Column="1"
                Content="{loc:Translate Player.Overlay.Info.Tooltip}"
                Command="{Binding OpenInfoPanelCommand}"
                IsVisible="{Binding CanShowInfoButton}"
                MinHeight="40" />
        <Button Grid.Column="2"
                Content="{loc:Translate Player.Settings.Audio}"
                Command="{Binding OpenAudioSettingsCommand}"
                MinHeight="40" />
      </Grid>

      <TextBlock Text="{Binding DownloadStatusMessage}"
                 Foreground="{DynamicResource TextMutedBrush}"
                 FontSize="12"
                 TextWrapping="Wrap" />

      <Border Background="{DynamicResource OverlayBackgroundBrush}"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsAudioSettingsOpen}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Player.Mobile.AudioSubtitles}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Content="{loc:Translate Common.Close}"
                    Command="{Binding ClosePanelsCommand}"
                    MinHeight="36"
                    Margin="10,0,0,0" />
          </Grid>

          <StackPanel Spacing="8"
                      IsVisible="{Binding !IsLiveContent}">
            <TextBlock Text="{loc:Translate Player.Mobile.SubtitleSize}"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       FontSize="10"
                       FontWeight="Bold" />
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">
              <Button Content="{loc:Translate Player.Settings.SubtitleSize.Small}"
                      Command="{Binding SetSubtitleSizeCommand}"
                      CommandParameter="28"
                      MinHeight="40" />
              <Button Grid.Column="1"
                      Content="{loc:Translate Player.Settings.SubtitleSize.Normal}"
                      Command="{Binding SetSubtitleSizeCommand}"
                      CommandParameter="40"
                      MinHeight="40" />
              <Button Grid.Column="2"
                      Content="{loc:Translate Player.Settings.SubtitleSize.Large}"
                      Command="{Binding SetSubtitleSizeCommand}"
                      CommandParameter="60"
                      MinHeight="40" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="8"
                      IsVisible="{Binding !IsLiveContent}">
            <TextBlock Text="{loc:Translate Player.Mobile.SubtitleBackground}"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       FontSize="10"
                       FontWeight="Bold" />
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">
              <Button Content="{loc:Translate Player.Settings.SubtitleBackground.Off}"
                      Command="{Binding SetSubtitleBackgroundCommand}"
                      CommandParameter="0"
                      MinHeight="40" />
              <Button Grid.Column="1"
                      Content="{loc:Translate Player.Settings.SubtitleBackground.Semi}"
                      Command="{Binding SetSubtitleBackgroundCommand}"
                      CommandParameter="128"
                      MinHeight="40" />
              <Button Grid.Column="2"
                      Content="{loc:Translate Player.Settings.SubtitleBackground.Black}"
                      Command="{Binding SetSubtitleBackgroundCommand}"
                      CommandParameter="255"
                      MinHeight="40" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="8"
                      IsVisible="{Binding !IsLiveContent}">
            <TextBlock Text="{loc:Translate Player.Mobile.SubtitlePosition}"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       FontSize="10"
                       FontWeight="Bold" />
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8">
              <Button Content="{loc:Translate Player.Settings.SubtitlePosition.Bottom}"
                      Command="{Binding SetSubtitlePositionCommand}"
                      CommandParameter="40"
                      MinHeight="40" />
              <Button Grid.Column="1"
                      Content="{loc:Translate Player.Settings.SubtitlePosition.Top}"
                      Command="{Binding SetSubtitlePositionCommand}"
                      CommandParameter="900"
                      MinHeight="40" />
            </Grid>
          </StackPanel>

          <ScrollViewer MaxHeight="220"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Translate Player.Settings.Audio}"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           FontSize="10"
                           FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding AudioTracks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Name}"
                              Command="{Binding #PlayerRoot.DataContext.SetAudioTrackCommand}"
                              CommandParameter="{Binding Id}"
                              MinHeight="40"
                              Margin="0,0,0,8"
                              HorizontalContentAlignment="Stretch" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Translate Player.Settings.Subtitle}"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           FontSize="10"
                           FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Name}"
                              Command="{Binding #PlayerRoot.DataContext.SetSubtitleTrackCommand}"
                              CommandParameter="{Binding Id}"
                              MinHeight="40"
                              Margin="0,0,0,8"
                              HorizontalContentAlignment="Stretch" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource OverlayBackgroundBrush}"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsEpisodesPanelOpen}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding EpisodesPanelTitle}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Content="{loc:Translate Common.Close}"
                    Command="{Binding ClosePanelsCommand}"
                    MinHeight="36"
                    Margin="10,0,0,0" />
          </Grid>
          <ScrollViewer MaxHeight="240"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding EpisodeSeasons}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Season">
                  <StackPanel Spacing="8"
                              Margin="0,0,0,12">
                    <TextBlock Text="{Binding SeasonNumber, Converter={StaticResource StringFormatConverter}, ConverterParameter='Series.Seasons.Format'}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Episodes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Episode">
                          <Button Command="{Binding #PlayerRoot.DataContext.PlayEpisodeFromOverlayCommand}"
                                  CommandParameter="{Binding}"
                                  MinHeight="44"
                                  Margin="0,0,0,8"
                                  HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10">
                              <TextBlock Text="{Binding EpisodeNumber}"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Name}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource OverlayBackgroundBrush}"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsInfoPanelOpen}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding CurrentChannel.Name}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Content="{loc:Translate Common.Close}"
                    Command="{Binding OpenInfoPanelCommand}"
                    MinHeight="36"
                    Margin="10,0,0,0" />
          </Grid>
          <TextBlock Text="{Binding OverlaySecondaryText}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding CurrentChannel.Plot}"
                     Foreground="{DynamicResource OverlayTextBrush}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     MaxHeight="120" />
        </StackPanel>
      </Border>

      <Button Content="{loc:Translate Player.Mobile.Quality}"
              Command="{Binding OpenQualitySettingsCommand}"
              MinHeight="40" />

      <Border Background="{DynamicResource OverlayBackgroundBrush}"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsQualitySettingsOpen}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Player.Mobile.Quality}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Content="{loc:Translate Common.Close}"
                    Command="{Binding OpenQualitySettingsCommand}"
                    MinHeight="36"
                    Margin="10,0,0,0" />
          </Grid>

          <Grid ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Resolution}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityResolutionText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Fps}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityFpsText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Row="1"
                        Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Codec}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityVideoCodecText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Bitrate}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityVideoBitrateText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Audio}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityAudioText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <TextBlock Text="{loc:Translate Player.Mobile.Speed}"
                     Foreground="{DynamicResource TextDisabledBrush}"
                     FontSize="10"
                     FontWeight="Bold" />
          <Grid ColumnDefinitions="*,*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="8"
                RowSpacing="8">
            <Button Content="0.5x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.5}"
                    MinHeight="38" />
            <Button Grid.Column="1"
                    Content="0.75x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.75}"
                    MinHeight="38" />
            <Button Grid.Column="2"
                    Content="1.0x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.0}"
                    MinHeight="38" />
            <Button Grid.Row="1"
                    Content="1.25x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.25}"
                    MinHeight="38" />
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Content="1.5x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.5}"
                    MinHeight="38" />
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Content="2.0x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=2.0}"
                    MinHeight="38" />
          </Grid>
        </StackPanel>
      </Border>

      <StackPanel Spacing="6">
        <!-- Row 1: Resolution + FPS -->
        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="8">
          <Border Background="{DynamicResource OverlayBackgroundBrush}"
                  CornerRadius="10"
                  Padding="10,8">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Resolution}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityResolutionText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1"
                  Background="{DynamicResource OverlayBackgroundBrush}"
                  CornerRadius="10"
                  Padding="10,8">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Fps}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityFpsText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Row 2: Codec + Bitrate -->
        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="8">
          <Border Background="{DynamicResource OverlayBackgroundBrush}"
                  CornerRadius="10"
                  Padding="10,8">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Codec}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityVideoCodecText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1"
                  Background="{DynamicResource OverlayBackgroundBrush}"
                  CornerRadius="10"
                  Padding="10,8">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Bitrate}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityVideoBitrateText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Row 3: Audio (full width) -->
        <Border Background="{DynamicResource OverlayBackgroundBrush}"
                CornerRadius="10"
                Padding="10,8">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="8">
            <TextBlock Text="{loc:Translate Player.Quality.Audio}"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       FontSize="10"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding QualityAudioText}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
