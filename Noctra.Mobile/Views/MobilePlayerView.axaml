<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="using:Noctra.ViewModels"
             x:Class="Noctra.Mobile.Views.MobilePlayerView"
             x:Name="PlayerRoot"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="260">
  <Border Background="#F5090B10"
          Padding="16"
          CornerRadius="18"
          VerticalAlignment="Bottom"
          Margin="14">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding CurrentChannel.Name}"
                     Foreground="#FFFFFF"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConnectionStatus}"
                     Foreground="#AEB5C5"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="Close"
                Command="{Binding CloseCommand}"
                MinHeight="42"
                MinWidth="72"
                Margin="12,0,0,0" />
      </Grid>

      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="#FF6B6B"
                 TextWrapping="Wrap" />

      <Grid ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="10"
            VerticalAlignment="Center">
        <TextBlock Text="{Binding PositionText}"
                   Foreground="#E6FFFFFF"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Slider Grid.Column="1"
                Minimum="0"
                Maximum="{Binding Duration}"
                Value="{Binding Position, Mode=TwoWay}"
                IsEnabled="{Binding IsPlaying}" />
        <TextBlock Grid.Column="2"
                   Text="{Binding DurationText}"
                   Foreground="#AEB5C5"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <TextBlock Text="{Binding RemainingTime}"
                   Foreground="#AEB5C5"
                   FontSize="12"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding StreamInfo}"
                   Foreground="#AEB5C5"
                   FontSize="12"
                   TextAlignment="Right"
                   VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="Auto,Auto,*,Auto"
            ColumnSpacing="8"
            VerticalAlignment="Center">
        <Button Content="Play/Pause"
                Command="{Binding PlayPauseCommand}"
                MinHeight="44" />
        <Button Grid.Column="1"
                Content="Stop"
                Command="{Binding StopCommand}"
                MinHeight="44" />
        <Slider Grid.Column="2"
                Minimum="0"
                Maximum="100"
                Value="{Binding Volume, Mode=TwoWay}"
                VerticalAlignment="Center" />
        <Button Grid.Column="3"
                Content="Mute"
                Command="{Binding ToggleMuteCommand}"
                MinHeight="44" />
      </Grid>

      <Grid ColumnDefinitions="*,*,*,*,*"
            ColumnSpacing="8">
        <Button Content="-10s"
                Command="{Binding SkipBackwardCommand}"
                CommandParameter="10"
                IsVisible="{Binding !IsLiveContent}"
                MinHeight="40" />
        <Button Grid.Column="1"
                Content="+10s"
                Command="{Binding SkipForwardCommand}"
                CommandParameter="10"
                IsVisible="{Binding !IsLiveContent}"
                MinHeight="40" />
        <Button Grid.Column="2"
                Content="Favorite"
                Command="{Binding ToggleLiveFavoriteCommand}"
                MinHeight="40" />
        <Button Grid.Column="3"
                Content="{Binding VideoFillMode}"
                Command="{Binding CycleVideoFillModeCommand}"
                MinHeight="40" />
        <Button Grid.Column="4"
                Content="{Binding SleepTimerLabel}"
                Command="{Binding ShowSleepTimerMenuCommand}"
                MinHeight="40" />
      </Grid>

      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="8"
            IsVisible="{Binding IsLiveContent}">
        <Button Content="Previous"
                Command="{Binding PlayPreviousLiveChannelCommand}"
                MinHeight="40" />
        <Button Grid.Column="1"
                Content="Next"
                Command="{Binding PlayNextLiveChannelCommand}"
                MinHeight="40" />
      </Grid>

      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="8"
            IsVisible="{Binding IsSeriesContent}">
        <Button Content="Episodes"
                Command="{Binding OpenEpisodesCommand}"
                MinHeight="40" />
        <Button Grid.Column="1"
                Content="Next Episode"
                Command="{Binding PlayNextEpisodeCommand}"
                MinHeight="40" />
      </Grid>

      <TextBlock Text="{Binding SleepTimerCountdown}"
                 Foreground="#AEB5C5"
                 FontSize="12"
                 HorizontalAlignment="Right" />

      <Border Background="#1FFFFFFF"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsSleepTimerPanelOpen}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SleepTimerLabel}"
                     Foreground="#FFFFFF"
                     FontSize="13"
                     FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="8"
                RowSpacing="8">
            <Button Content="Off"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Off}"
                    MinHeight="40" />
            <Button Grid.Column="1"
                    Content="15 min"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes15}"
                    MinHeight="40" />
            <Button Grid.Row="1"
                    Content="30 min"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes30}"
                    MinHeight="40" />
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Content="60 min"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes60}"
                    MinHeight="40" />
            <Button Grid.Row="2"
                    Content="End"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.EndOfEpisode}"
                    MinHeight="40" />
            <Button Grid.Row="2"
                    Grid.Column="1"
                    Content="Cancel"
                    Command="{Binding CancelSleepTimerCommand}"
                    IsVisible="{Binding IsSleepTimerActive}"
                    MinHeight="40" />
          </Grid>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*,*"
            ColumnSpacing="8">
        <Button Content="Download"
                Command="{Binding DownloadCurrentContentCommand}"
                IsVisible="{Binding CanShowDownloadButton}"
                IsEnabled="{Binding CanDownloadCurrentContent}"
                MinHeight="40" />
        <Button Grid.Column="1"
                Content="Info"
                Command="{Binding OpenInfoPanelCommand}"
                IsVisible="{Binding CanShowInfoButton}"
                MinHeight="40" />
        <Button Grid.Column="2"
                Content="Audio"
                Command="{Binding OpenAudioSettingsCommand}"
                MinHeight="40" />
      </Grid>

      <TextBlock Text="{Binding DownloadStatusMessage}"
                 Foreground="#AEB5C5"
                 FontSize="12"
                 TextWrapping="Wrap" />

      <Border Background="#1FFFFFFF"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsAudioSettingsOpen}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Audio &amp; Subtitles"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Content="Close"
                    Command="{Binding ClosePanelsCommand}"
                    MinHeight="36"
                    Margin="10,0,0,0" />
          </Grid>

          <StackPanel Spacing="8"
                      IsVisible="{Binding !IsLiveContent}">
            <TextBlock Text="Subtitle Size"
                       Foreground="#8090A0"
                       FontSize="10"
                       FontWeight="Bold" />
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">
              <Button Content="Small"
                      Command="{Binding SetSubtitleSizeCommand}"
                      CommandParameter="28"
                      MinHeight="40" />
              <Button Grid.Column="1"
                      Content="Normal"
                      Command="{Binding SetSubtitleSizeCommand}"
                      CommandParameter="40"
                      MinHeight="40" />
              <Button Grid.Column="2"
                      Content="Large"
                      Command="{Binding SetSubtitleSizeCommand}"
                      CommandParameter="60"
                      MinHeight="40" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="8"
                      IsVisible="{Binding !IsLiveContent}">
            <TextBlock Text="Subtitle Background"
                       Foreground="#8090A0"
                       FontSize="10"
                       FontWeight="Bold" />
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">
              <Button Content="Off"
                      Command="{Binding SetSubtitleBackgroundCommand}"
                      CommandParameter="0"
                      MinHeight="40" />
              <Button Grid.Column="1"
                      Content="Semi"
                      Command="{Binding SetSubtitleBackgroundCommand}"
                      CommandParameter="128"
                      MinHeight="40" />
              <Button Grid.Column="2"
                      Content="Black"
                      Command="{Binding SetSubtitleBackgroundCommand}"
                      CommandParameter="255"
                      MinHeight="40" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="8"
                      IsVisible="{Binding !IsLiveContent}">
            <TextBlock Text="Subtitle Position"
                       Foreground="#8090A0"
                       FontSize="10"
                       FontWeight="Bold" />
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8">
              <Button Content="Bottom"
                      Command="{Binding SetSubtitlePositionCommand}"
                      CommandParameter="40"
                      MinHeight="40" />
              <Button Grid.Column="1"
                      Content="Top"
                      Command="{Binding SetSubtitlePositionCommand}"
                      CommandParameter="900"
                      MinHeight="40" />
            </Grid>
          </StackPanel>

          <ScrollViewer MaxHeight="220"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Audio"
                           Foreground="#8090A0"
                           FontSize="10"
                           FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding AudioTracks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Name}"
                              Command="{Binding #PlayerRoot.DataContext.SetAudioTrackCommand}"
                              CommandParameter="{Binding Id}"
                              MinHeight="40"
                              Margin="0,0,0,8"
                              HorizontalContentAlignment="Stretch" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="Subtitles"
                           Foreground="#8090A0"
                           FontSize="10"
                           FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Name}"
                              Command="{Binding #PlayerRoot.DataContext.SetSubtitleTrackCommand}"
                              CommandParameter="{Binding Id}"
                              MinHeight="40"
                              Margin="0,0,0,8"
                              HorizontalContentAlignment="Stretch" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Background="#1FFFFFFF"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsEpisodesPanelOpen}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding EpisodesPanelTitle}"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Content="Close"
                    Command="{Binding ClosePanelsCommand}"
                    MinHeight="36"
                    Margin="10,0,0,0" />
          </Grid>
          <ScrollViewer MaxHeight="240"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding EpisodeSeasons}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Season">
                  <StackPanel Spacing="8"
                              Margin="0,0,0,12">
                    <TextBlock Text="{Binding SeasonNumber, StringFormat='Season {0}'}"
                               Foreground="#AEB5C5"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Episodes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Episode">
                          <Button Command="{Binding #PlayerRoot.DataContext.PlayEpisodeFromOverlayCommand}"
                                  CommandParameter="{Binding}"
                                  MinHeight="44"
                                  Margin="0,0,0,8"
                                  HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10">
                              <TextBlock Text="{Binding EpisodeNumber}"
                                         Foreground="#AEB5C5"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Name}"
                                         Foreground="#FFFFFF"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Background="#1FFFFFFF"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsInfoPanelOpen}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding CurrentChannel.Name}"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Content="Close"
                    Command="{Binding OpenInfoPanelCommand}"
                    MinHeight="36"
                    Margin="10,0,0,0" />
          </Grid>
          <TextBlock Text="{Binding OverlaySecondaryText}"
                     Foreground="#AEB5C5"
                     FontSize="12"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding CurrentChannel.Plot}"
                     Foreground="#E6FFFFFF"
                     FontSize="12"
                     TextWrapping="Wrap"
                     MaxHeight="120" />
        </StackPanel>
      </Border>

      <Button Content="Quality"
              Command="{Binding OpenQualitySettingsCommand}"
              MinHeight="40" />

      <Border Background="#1FFFFFFF"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsQualitySettingsOpen}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Quality"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Content="Close"
                    Command="{Binding OpenQualitySettingsCommand}"
                    MinHeight="36"
                    Margin="10,0,0,0" />
          </Grid>

          <Grid ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="Resolution"
                         Foreground="#8090A0"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityResolutionText}"
                         Foreground="#FFFFFF"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Spacing="2">
              <TextBlock Text="FPS"
                         Foreground="#8090A0"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityFpsText}"
                         Foreground="#FFFFFF"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Row="1"
                        Spacing="2">
              <TextBlock Text="Codec"
                         Foreground="#8090A0"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityVideoCodecText}"
                         Foreground="#FFFFFF"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        Spacing="2">
              <TextBlock Text="Bitrate"
                         Foreground="#8090A0"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityVideoBitrateText}"
                         Foreground="#FFFFFF"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Spacing="2">
              <TextBlock Text="Audio"
                         Foreground="#8090A0"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityAudioText}"
                         Foreground="#FFFFFF"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <TextBlock Text="Speed"
                     Foreground="#8090A0"
                     FontSize="10"
                     FontWeight="Bold" />
          <Grid ColumnDefinitions="*,*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="8"
                RowSpacing="8">
            <Button Content="0.5x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.5}"
                    MinHeight="38" />
            <Button Grid.Column="1"
                    Content="0.75x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.75}"
                    MinHeight="38" />
            <Button Grid.Column="2"
                    Content="1.0x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.0}"
                    MinHeight="38" />
            <Button Grid.Row="1"
                    Content="1.25x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.25}"
                    MinHeight="38" />
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Content="1.5x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.5}"
                    MinHeight="38" />
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Content="2.0x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=2.0}"
                    MinHeight="38" />
          </Grid>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*,*"
            ColumnSpacing="8">
        <Border Background="#1FFFFFFF"
                CornerRadius="10"
                Padding="10,8">
          <StackPanel Spacing="2">
            <TextBlock Text="Resolution"
                       Foreground="#8090A0"
                       FontSize="10"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding QualityResolutionText}"
                       Foreground="#FFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1"
                Background="#1FFFFFFF"
                CornerRadius="10"
                Padding="10,8">
          <StackPanel Spacing="2">
            <TextBlock Text="FPS"
                       Foreground="#8090A0"
                       FontSize="10"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding QualityFpsText}"
                       Foreground="#FFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2"
                Background="#1FFFFFFF"
                CornerRadius="10"
                Padding="10,8">
          <StackPanel Spacing="2">
            <TextBlock Text="Audio"
                       Foreground="#8090A0"
                       FontSize="10"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding QualityAudioText}"
                       Foreground="#FFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
