<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Noctra.Models"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="using:Noctra.Mobile.Views"
             x:Class="Noctra.Mobile.Views.MobilePlayerView"
             x:Name="PlayerRoot"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="260">
  <UserControl.Styles>
    <Style Selector="Button.compactPlayerAction">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
  </UserControl.Styles>

  <Grid Background="Transparent" Tapped="OnPlayerBackgroundTapped">
    <!-- Watermark overlay for free tier, positioned above the bottom sheet -->
    <views:MobileWatermarkView x:Name="MobileWatermark"
                                Grid.ColumnSpan="2"
                                ZIndex="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,24,120"
                                IsHitTestVisible="False" />
    <!-- Double Tap Zones -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Mobile subtitle overlay. Text/style bindings update instantly without restarting the native player. -->
    <Border Grid.ColumnSpan="2"
            ZIndex="9"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Margin="18,0,18,96"
            Padding="10,6"
            CornerRadius="8"
            Background="{Binding SubtitleBackgroundOpacity, Converter={StaticResource SubtitleBackgroundBrushConverter}}"
            IsHitTestVisible="False"
            IsVisible="{Binding IsMobileSubtitleBottomVisible}">
      <TextBlock Text="{Binding CurrentSubtitleText}"
                 Foreground="White"
                 FontSize="{Binding SubtitleFontSize}"
                 FontWeight="SemiBold"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 MaxLines="3" />
    </Border>

    <Border Grid.ColumnSpan="2"
            ZIndex="9"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Margin="18,72,18,0"
            Padding="10,6"
            CornerRadius="8"
            Background="{Binding SubtitleBackgroundOpacity, Converter={StaticResource SubtitleBackgroundBrushConverter}}"
            IsHitTestVisible="False"
            IsVisible="{Binding IsMobileSubtitleTopVisible}">
      <TextBlock Text="{Binding CurrentSubtitleText}"
                 Foreground="White"
                 FontSize="{Binding SubtitleFontSize}"
                 FontWeight="SemiBold"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 MaxLines="3" />
    </Border>
    <!-- Sol bölge: çift dokunma = 10sn geri, dikey kaydırma = parlaklık, yatay = sarma -->
    <Border x:Name="LeftZone" Grid.Column="0" Background="Transparent"
            DoubleTapped="OnLeftDoubleTapped"
            PointerPressed="OnZonePointerPressed"
            PointerMoved="OnZonePointerMoved"
            PointerReleased="OnZonePointerReleased" />
    <!-- Sağ bölge: çift dokunma = 10sn ileri, dikey kaydırma = ses, yatay = sarma -->
    <Border x:Name="RightZone" Grid.Column="1" Background="Transparent"
            DoubleTapped="OnRightDoubleTapped"
            PointerPressed="OnZonePointerPressed"
            PointerMoved="OnZonePointerMoved"
            PointerReleased="OnZonePointerReleased" />

    <!-- Buffering / loading shield: desktop overlay parity for mobile. -->
    <Border Grid.ColumnSpan="2"
            ZIndex="20"
            Background="#B3000000"
            IsHitTestVisible="False"
            IsVisible="{Binding IsBufferShieldVisible}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="14"
                  MaxWidth="320">
        <Grid Width="64" Height="64" HorizontalAlignment="Center">
          <Arc Width="58" Height="58"
               Stroke="{DynamicResource AccentBrush}"
               StrokeThickness="4"
               StartAngle="0"
               SweepAngle="95"
               VerticalAlignment="Center"
               HorizontalAlignment="Center">
            <Arc.RenderTransform>
              <RotateTransform />
            </Arc.RenderTransform>
            <Arc.Styles>
              <Style Selector="Arc">
                <Style.Animations>
                  <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame KeyTime="0:0:0"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame KeyTime="0:0:1"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                  </Animation>
                </Style.Animations>
              </Style>
            </Arc.Styles>
          </Arc>
          <icons:MaterialIcon Kind="ShieldCheckOutline"
                              Width="28" Height="28"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{loc:Translate Common.Loading}"
                   Foreground="White"
                   FontSize="15"
                   FontWeight="Bold"
                   TextAlignment="Center" />
        <TextBlock Text="{Binding PlayerLoadingWarningMessage}"
                   Foreground="{DynamicResource WarningBrush}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="300"
                   IsVisible="{Binding PlayerLoadingWarningMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
      </StackPanel>
    </Border>

    <!-- Generic overlay message from PlayerOverlayManager. -->
    <Border Grid.ColumnSpan="2"
            ZIndex="42"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="320"
            Padding="18,12"
            CornerRadius="16"
            Background="#E6000000"
            IsHitTestVisible="False"
            IsVisible="{Binding IsOverlayMessageVisible}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:MaterialIcon Kind="AlertCircleOutline"
                            Width="22" Height="22"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
        <TextBlock Text="{Binding OverlayMessage}"
                   Foreground="White"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Volume feedback toast. -->
    <Border Grid.ColumnSpan="2"
            ZIndex="60"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,54,0,0"
            Padding="18,11"
            CornerRadius="18"
            Background="#E6000000"
            IsHitTestVisible="False"
            IsVisible="{Binding #PlayerRoot.IsVolumeToastVisible}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:MaterialIcon Kind="VolumeOff"
                            Width="22" Height="22"
                            Foreground="White"
                            IsVisible="{Binding IsMuted}" />
        <icons:MaterialIcon Kind="VolumeHigh"
                            Width="22" Height="22"
                            Foreground="White"
                            IsVisible="{Binding IsMuted, Converter={StaticResource InverseBoolConverter}}" />
        <TextBlock Text="{loc:Translate Player.Muted}"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsMuted}" />
        <TextBlock Text="{Binding Volume, StringFormat='{}{0}%'}"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsMuted, Converter={StaticResource InverseBoolConverter}}" />
      </StackPanel>
    </Border>

    <!-- Seek / double-tap feedback toast. -->
    <Border Grid.ColumnSpan="2"
            ZIndex="61"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="22,14"
            CornerRadius="20"
            Background="#E6000000"
            IsHitTestVisible="False"
            IsVisible="{Binding #PlayerRoot.IsSeekToastVisible}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:MaterialIcon Kind="{Binding #PlayerRoot.SeekToastIcon}"
                            Width="26" Height="26"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
        <TextBlock Text="{Binding #PlayerRoot.SeekToastText}"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Black"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Download feedback toast. -->
    <Border Grid.ColumnSpan="2"
            ZIndex="62"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="18,0,18,148"
            Padding="18,12"
            CornerRadius="18"
            Background="#E6000000"
            IsHitTestVisible="False"
            IsVisible="{Binding #PlayerRoot.IsDownloadToastVisible}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <icons:MaterialIcon Kind="DownloadOutline"
                            Width="22" Height="22"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
        <TextBlock Text="{Binding DownloadStatusMessage}"
                   Foreground="White"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   MaxWidth="280"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Gesture feedback for brightness and non-seekable live streams. -->
    <Border Grid.ColumnSpan="2"
            ZIndex="63"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="18"
            Padding="18,12"
            CornerRadius="18"
            Background="#E6000000"
            IsHitTestVisible="False"
            IsVisible="{Binding #PlayerRoot.IsGestureToastVisible}">
      <TextBlock Text="{Binding #PlayerRoot.GestureToastText}"
                 Foreground="White"
                 FontSize="15"
                 FontWeight="Bold"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="300" />
    </Border>

    <!-- Persistent lock badge: kontroller kapalıyken bile kilidin aktif olduğunu gösterir.
         Dokunulduğunda kilidi doğrudan kaldırır (ToggleControls kilitliyken açılmadığı için). -->
    <Button Grid.ColumnSpan="2"
            ZIndex="70"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,48,0,0"
            Padding="14,8"
            CornerRadius="20"
            Background="#E6000000"
            BorderThickness="0"
            IsVisible="{Binding IsLocked}"
            Command="{Binding ToggleLockCommand}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <icons:MaterialIcon Kind="Lock" Width="18" Height="18" Foreground="White" />
        <TextBlock Text="{loc:Translate Player.Mobile.Locked}"
                   Foreground="White" FontSize="13" FontWeight="SemiBold" />
      </StackPanel>
    </Button>

    <!-- Normal mod: bottom sheet (EPG kapalıyken) -->
    <Border Grid.ColumnSpan="2"
            Background="{DynamicResource Bg0Brush}"
            Padding="16"
            CornerRadius="18"
            VerticalAlignment="Bottom"
            Margin="14"
            IsVisible="{Binding AreMobileControlsVisible}">
      <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding CurrentChannel.Name}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConnectionStatus}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1"
                Command="{Binding CloseCommand}"
                MinHeight="44"
                MinWidth="72"
                Margin="12,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:MaterialIcon Kind="Close" Width="18" Height="18" />
            <TextBlock Text="{loc:Translate Common.Close}" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- LIVE Badge + Current Program (sadece canlı yayında) -->
      <StackPanel Orientation="Horizontal"
                  Spacing="12"
                  IsVisible="{Binding IsLiveContent}">
        <Border Background="{DynamicResource ErrorBrush}"
                CornerRadius="6"
                Padding="12,6"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" Fill="White" VerticalAlignment="Center">
              <Ellipse.Styles>
                <Style Selector="Ellipse">
                  <Style.Animations>
                    <Animation Duration="0:0:1" IterationCount="INFINITE" PlaybackDirection="Alternate">
                      <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                      <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
              </Ellipse.Styles>
            </Ellipse>
            <TextBlock Text="{loc:Translate Player.Overlay.Live}"
                       FontSize="12" FontWeight="Black" Foreground="White"
                       VerticalAlignment="Center" LetterSpacing="1" />
          </StackPanel>
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding CurrentProgram.Title}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="15" FontWeight="Bold"
                     TextTrimming="CharacterEllipsis" MaxLines="1"
                     IsVisible="{Binding CurrentProgram.Title, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
          <TextBlock Text="{Binding CurrentProgram.TimeRange}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" FontWeight="Medium"
                     IsVisible="{Binding HasCurrentProgramInfo}" />
        </StackPanel>
      </StackPanel>

      <Grid ColumnDefinitions="*,*,*"
            ColumnSpacing="8">
        <Button Command="{Binding ToggleLockCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="LockOutline" Width="18" Height="18" />
            <TextBlock Text="{Binding IsLocked, Converter={StaticResource StringFormatConverter}, ConverterParameter='Player.Mobile.LockFormat'}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1"
                Command="{Binding ToggleFullScreenCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Grid Width="18" Height="18">
              <icons:MaterialIcon Kind="Fullscreen" Width="18" Height="18"
                                  IsVisible="{Binding IsFullScreen, Converter={StaticResource InverseBoolConverter}}" />
              <icons:MaterialIcon Kind="FullscreenExit" Width="18" Height="18"
                                  IsVisible="{Binding IsFullScreen}" />
            </Grid>
            <TextBlock Text="{Binding IsFullScreen, Converter={StaticResource StringFormatConverter}, ConverterParameter='Player.Mobile.FullscreenFormat'}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2"
                Command="{Binding EnterPiPCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="PictureInPictureBottomRight" Width="18" Height="18" />
            <TextBlock Text="{loc:Translate Player.Overlay.PiP.Tooltip}" />
          </StackPanel>
        </Button>
      </Grid>

      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource ErrorBrush}"
                 TextWrapping="Wrap" />

      <Grid ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="10"
            VerticalAlignment="Center">
        <TextBlock Text="{Binding PositionText}"
                   Foreground="{DynamicResource OverlayTextBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Slider Grid.Column="1"
                Minimum="0"
                Maximum="{Binding Duration}"
                Value="{Binding Position, Mode=TwoWay}"
                IsEnabled="{Binding IsPlaying}" />
        <TextBlock Grid.Column="2"
                   Text="{Binding DurationText}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <TextBlock Text="{Binding RemainingTime}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding StreamInfo}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   TextAlignment="Right"
                   VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="Auto,Auto,*,Auto"
            ColumnSpacing="8"
            VerticalAlignment="Center">
        <Button Command="{Binding PlayPauseCommand}"
                MinHeight="56"
                MinWidth="64"
                CornerRadius="28"
                Background="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}">
          <Grid Width="32" Height="32">
            <icons:MaterialIcon Kind="Pause" Width="32" Height="32"
                                IsVisible="{Binding IsPlaying}" />
            <icons:MaterialIcon Kind="Play" Width="32" Height="32"
                                IsVisible="{Binding IsPlaying, Converter={StaticResource InverseBoolConverter}}" />
          </Grid>
        </Button>
        <Button Grid.Column="1"
                Command="{Binding StopCommand}"
                MinHeight="44"
                Width="44"
                CornerRadius="22">
          <icons:MaterialIcon Kind="Stop" Width="24" Height="24" />
        </Button>
        <Slider Grid.Column="2"
                Minimum="0"
                Maximum="100"
                Value="{Binding Volume, Mode=TwoWay}"
                VerticalAlignment="Center" />
        <Button Grid.Column="3"
                Command="{Binding ToggleMuteCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Grid Width="20" Height="20">
              <icons:MaterialIcon Kind="VolumeOff" Width="20" Height="20"
                                  IsVisible="{Binding IsMuted}" />
              <icons:MaterialIcon Kind="VolumeHigh" Width="20" Height="20"
                                  IsVisible="{Binding IsMuted, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>
            <TextBlock Text="{loc:Translate Player.Mobile.Mute}" />
          </StackPanel>
        </Button>
      </Grid>

      <WrapPanel Orientation="Horizontal"
                 ItemSpacing="8"
                 LineSpacing="8">
        <Button Classes="compactPlayerAction"
                Command="{Binding SkipBackwardCommand}"
                CommandParameter="10"
                IsVisible="{Binding !IsLiveContent}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Rewind10" Width="18" Height="18" />
            <TextBlock Text="-10s" />
          </StackPanel>
        </Button>
        <Button Classes="compactPlayerAction"
                Command="{Binding SkipForwardCommand}"
                CommandParameter="10"
                IsVisible="{Binding !IsLiveContent}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="FastForward10" Width="18" Height="18" />
            <TextBlock Text="+10s" />
          </StackPanel>
        </Button>
        <Button Classes="compactPlayerAction"
                Command="{Binding ToggleSubtitleTrackCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
            <icons:MaterialIcon Width="18" Height="18"
                                Kind="{Binding SelectedSubtitleTrack,
                                        Converter={StaticResource SubtitleIconConverter}}" />
            <TextBlock Text="{loc:Translate Player.Mobile.CC}" />
          </StackPanel>
        </Button>
        <Button Classes="compactPlayerAction"
                Command="{Binding ToggleLiveFavoriteCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="HeartOutline" Width="18" Height="18" />
            <TextBlock Text="{loc:Translate Player.Mobile.Favorite}" />
          </StackPanel>
        </Button>
        <Button Classes="compactPlayerAction"
                Command="{Binding GoToLiveCommand}"
                IsVisible="{Binding IsLiveContent}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Broadcast" Width="18" Height="18" />
            <TextBlock Text="{loc:Translate Player.Mobile.GoToLive}" />
          </StackPanel>
        </Button>
        <Button Classes="compactPlayerAction"
                Command="{Binding CycleVideoFillModeCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="{Binding VideoFillMode,
                                      Converter={StaticResource FillModeToIconConverter}}"
                                Width="18" Height="18" />
            <TextBlock Text="{Binding VideoFillMode}" />
          </StackPanel>
        </Button>
        <Button Classes="compactPlayerAction"
                Command="{Binding ShowSleepTimerMenuCommand}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="TimerOutline" Width="18" Height="18" />
            <TextBlock Text="{Binding SleepTimerLabel}" />
          </StackPanel>
        </Button>
        <Button Classes="compactPlayerAction"
                Command="{Binding ToggleEpgPanelCommand}"
                IsVisible="{Binding IsLiveContent}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="CalendarClock" Width="18" Height="18" />
            <TextBlock Text="{loc:Translate Player.Epg.GuideTooltip}" />
          </StackPanel>
        </Button>
      </WrapPanel>

      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="8"
            IsVisible="{Binding IsLiveContent}">
        <Button Content="{loc:Translate Player.Mobile.Previous}"
                Command="{Binding PlayPreviousLiveChannelCommand}"
                MinHeight="44" />
        <Button Grid.Column="1"
                Content="{loc:Translate Player.Mobile.Next}"
                Command="{Binding PlayNextLiveChannelCommand}"
                MinHeight="44" />
      </Grid>

      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="8"
            IsVisible="{Binding IsSeriesContent}">
        <Button Content="{loc:Translate Player.Overlay.Episodes.Tooltip}"
                Command="{Binding OpenEpisodesCommand}"
                MinHeight="44" />
        <Button Grid.Column="1"
                Content="{loc:Translate Player.Overlay.NextEpisode}"
                Command="{Binding PlayNextEpisodeCommand}"
                MinHeight="44" />
      </Grid>

      <TextBlock Text="{Binding SleepTimerCountdown}"
                 Foreground="{DynamicResource TextMutedBrush}"
                 FontSize="12"
                 HorizontalAlignment="Right" />

      <Border Background="{DynamicResource OverlayBackgroundBrush}"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsSleepTimerPanelOpen}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SleepTimerLabel}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="13"
                     FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="8"
                RowSpacing="8">
            <Button Content="{loc:Translate Player.Mobile.Sleep.Off}"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Off}"
                    MinHeight="44" />
            <Button Grid.Column="1"
                    Content="{loc:Translate Player.Mobile.Sleep.15min}"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes15}"
                    MinHeight="44" />
            <Button Grid.Row="1"
                    Content="{loc:Translate Player.Mobile.Sleep.30min}"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes30}"
                    MinHeight="44" />
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Content="{loc:Translate Player.Mobile.Sleep.60min}"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes60}"
                    MinHeight="44" />
            <Button Grid.Row="2"
                    Content="{loc:Translate Player.Mobile.Sleep.End}"
                    Command="{Binding SetSleepTimerCommand}"
                    CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.EndOfEpisode}"
                    MinHeight="44" />
            <Button Grid.Row="2"
                    Grid.Column="1"
                    Content="{loc:Translate Player.Mobile.Sleep.Cancel}"
                    Command="{Binding CancelSleepTimerCommand}"
                    IsVisible="{Binding IsSleepTimerActive}"
                    MinHeight="44" />
          </Grid>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*,*"
            ColumnSpacing="8">
        <Button Content="{loc:Translate Player.Overlay.Download.Tooltip}"
                Command="{Binding DownloadCurrentContentCommand}"
                IsVisible="{Binding CanShowDownloadButton}"
                IsEnabled="{Binding CanDownloadCurrentContent}"
                MinHeight="44" />
        <Button Grid.Column="1"
                Content="{loc:Translate Player.Overlay.Info.Tooltip}"
                Command="{Binding OpenInfoPanelCommand}"
                IsVisible="{Binding CanShowInfoButton}"
                MinHeight="44" />
        <Button Grid.Column="2"
                Content="{loc:Translate Player.Settings.Audio}"
                Command="{Binding OpenAudioSettingsCommand}"
                MinHeight="44" />
      </Grid>

      <TextBlock Text="{Binding DownloadStatusMessage}"
                 Foreground="{DynamicResource TextMutedBrush}"
                 FontSize="12"
                 TextWrapping="Wrap" />

      <Border Background="{DynamicResource OverlayBackgroundBrush}"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsAudioSettingsOpen}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Player.Mobile.AudioSubtitles}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Content="{loc:Translate Common.Close}"
                    Command="{Binding ClosePanelsCommand}"
                    MinHeight="44"
                    Margin="10,0,0,0" />
          </Grid>

          <StackPanel Spacing="8"
                      IsVisible="{Binding !IsLiveContent}">
            <TextBlock Text="{loc:Translate Player.Mobile.SubtitleSize}"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       FontSize="10"
                       FontWeight="Bold" />
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">
              <Button Content="{loc:Translate Player.Settings.SubtitleSize.Small}"
                      Command="{Binding SetSubtitleSizeCommand}"
                      CommandParameter="28"
                      MinHeight="44" />
              <Button Grid.Column="1"
                      Content="{loc:Translate Player.Settings.SubtitleSize.Normal}"
                      Command="{Binding SetSubtitleSizeCommand}"
                      CommandParameter="40"
                      MinHeight="44" />
              <Button Grid.Column="2"
                      Content="{loc:Translate Player.Settings.SubtitleSize.Large}"
                      Command="{Binding SetSubtitleSizeCommand}"
                      CommandParameter="60"
                      MinHeight="44" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="8"
                      IsVisible="{Binding !IsLiveContent}">
            <TextBlock Text="{loc:Translate Player.Mobile.SubtitleBackground}"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       FontSize="10"
                       FontWeight="Bold" />
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">
              <Button Content="{loc:Translate Player.Settings.SubtitleBackground.Off}"
                      Command="{Binding SetSubtitleBackgroundCommand}"
                      CommandParameter="0"
                      MinHeight="44" />
              <Button Grid.Column="1"
                      Content="{loc:Translate Player.Settings.SubtitleBackground.Semi}"
                      Command="{Binding SetSubtitleBackgroundCommand}"
                      CommandParameter="128"
                      MinHeight="44" />
              <Button Grid.Column="2"
                      Content="{loc:Translate Player.Settings.SubtitleBackground.Black}"
                      Command="{Binding SetSubtitleBackgroundCommand}"
                      CommandParameter="255"
                      MinHeight="44" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="8"
                      IsVisible="{Binding !IsLiveContent}">
            <TextBlock Text="{loc:Translate Player.Mobile.SubtitlePosition}"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       FontSize="10"
                       FontWeight="Bold" />
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8">
              <Button Content="{loc:Translate Player.Settings.SubtitlePosition.Bottom}"
                      Command="{Binding SetSubtitlePositionCommand}"
                      CommandParameter="40"
                      MinHeight="44" />
              <Button Grid.Column="1"
                      Content="{loc:Translate Player.Settings.SubtitlePosition.Top}"
                      Command="{Binding SetSubtitlePositionCommand}"
                      CommandParameter="900"
                      MinHeight="44" />
            </Grid>
          </StackPanel>

          <ScrollViewer MaxHeight="220"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Translate Player.Settings.Audio}"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           FontSize="10"
                           FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding AudioTracks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding #PlayerRoot.DataContext.SetAudioTrackCommand}"
                              CommandParameter="{Binding Id}"
                              MinHeight="46"
                              Margin="0,0,0,8"
                              Padding="12,8"
                              BorderThickness="1"
                              HorizontalContentAlignment="Stretch">
                        <Button.Background>
                          <MultiBinding Converter="{StaticResource EqualityToBrushMultiConverter}" ConverterParameter="AccentHoverBrush">
                            <Binding Path="Id" />
                            <Binding Path="#PlayerRoot.DataContext.SelectedAudioTrack" />
                          </MultiBinding>
                        </Button.Background>
                        <Button.BorderBrush>
                          <MultiBinding Converter="{StaticResource EqualityToBrushMultiConverter}" ConverterParameter="AccentBrush">
                            <Binding Path="Id" />
                            <Binding Path="#PlayerRoot.DataContext.SelectedAudioTrack" />
                          </MultiBinding>
                        </Button.BorderBrush>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <icons:MaterialIcon Grid.Column="1"
                                              Kind="CheckCircle"
                                              Width="18"
                                              Height="18"
                                              Foreground="{DynamicResource AccentLightBrush}"
                                              VerticalAlignment="Center">
                            <icons:MaterialIcon.IsVisible>
                              <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                                <Binding Path="Id" />
                                <Binding Path="#PlayerRoot.DataContext.SelectedAudioTrack" />
                              </MultiBinding>
                            </icons:MaterialIcon.IsVisible>
                          </icons:MaterialIcon>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Translate Player.Settings.Subtitle}"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           FontSize="10"
                           FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding #PlayerRoot.DataContext.SetSubtitleTrackCommand}"
                              CommandParameter="{Binding Id}"
                              MinHeight="46"
                              Margin="0,0,0,8"
                              Padding="12,8"
                              BorderThickness="1"
                              HorizontalContentAlignment="Stretch">
                        <Button.Background>
                          <MultiBinding Converter="{StaticResource EqualityToBrushMultiConverter}" ConverterParameter="AccentHoverBrush">
                            <Binding Path="Id" />
                            <Binding Path="#PlayerRoot.DataContext.SelectedSubtitleTrack" />
                          </MultiBinding>
                        </Button.Background>
                        <Button.BorderBrush>
                          <MultiBinding Converter="{StaticResource EqualityToBrushMultiConverter}" ConverterParameter="AccentBrush">
                            <Binding Path="Id" />
                            <Binding Path="#PlayerRoot.DataContext.SelectedSubtitleTrack" />
                          </MultiBinding>
                        </Button.BorderBrush>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBlock Text="{Binding Name}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <icons:MaterialIcon Grid.Column="1"
                                              Kind="CheckCircle"
                                              Width="18"
                                              Height="18"
                                              Foreground="{DynamicResource AccentLightBrush}"
                                              VerticalAlignment="Center">
                            <icons:MaterialIcon.IsVisible>
                              <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                                <Binding Path="Id" />
                                <Binding Path="#PlayerRoot.DataContext.SelectedSubtitleTrack" />
                              </MultiBinding>
                            </icons:MaterialIcon.IsVisible>
                          </icons:MaterialIcon>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource OverlayBackgroundBrush}"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsEpisodesPanelOpen}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2"
                        VerticalAlignment="Center">
              <TextBlock Text="{loc:Translate Player.Overlay.Episodes.Tooltip}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding EpisodesPanelTitle}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{loc:Translate Common.Close}"
                    Command="{Binding ClosePanelsCommand}"
                    MinHeight="44"
                    Margin="10,0,0,0" />
          </Grid>

          <ScrollViewer MaxHeight="330"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding EpisodeSeasons}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Season">
                  <StackPanel Spacing="8"
                              Margin="0,0,0,14">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Margin="2,0,2,0">
                      <TextBlock Text="{loc:Translate Player.Episodes.Season}"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding SeasonNumber}"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Margin="4,0,0,0"
                                 VerticalAlignment="Center" />
                      <Border Grid.Column="2"
                              Background="{DynamicResource Surface1Brush}"
                              CornerRadius="10"
                              Padding="8,3"
                              VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                          <TextBlock Text="{Binding Episodes.Count}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     FontSize="10"
                                     FontWeight="Bold" />
                          <TextBlock Text="{loc:Translate Player.Episodes.CountLabel}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     FontSize="10"
                                     FontWeight="Bold" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Episodes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Episode">
                          <Button Command="{Binding #PlayerRoot.DataContext.PlayEpisodeFromOverlayCommand}"
                                  CommandParameter="{Binding}"
                                  MinHeight="88"
                                  Margin="0,0,0,10"
                                  Padding="0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="Stretch">
                            <Panel>
                              <!-- Card background + current episode accent border. -->
                              <Border Background="{DynamicResource Surface1Brush}"
                                      CornerRadius="14"
                                      BorderThickness="1.5"
                                      ClipToBounds="True">
                                <Border.BorderBrush>
                                  <MultiBinding Converter="{StaticResource EqualityToBrushMultiConverter}" ConverterParameter="AccentBrush">
                                    <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}" />
                                    <Binding Path="#PlayerRoot.DataContext.CurrentEpisodeIdentity" />
                                  </MultiBinding>
                                </Border.BorderBrush>
                              </Border>

                              <!-- Subtle current episode tint. -->
                              <Border CornerRadius="14"
                                      Background="{DynamicResource AccentBrush}"
                                      Opacity="0.08"
                                      IsHitTestVisible="False">
                                <Border.IsVisible>
                                  <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                                    <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}" />
                                    <Binding Path="#PlayerRoot.DataContext.CurrentEpisodeIdentity" />
                                  </MultiBinding>
                                </Border.IsVisible>
                              </Border>

                              <Grid ColumnDefinitions="92,*"
                                    ColumnSpacing="10"
                                    Margin="8">
                                <!-- Episode thumbnail / still image. -->
                                <Border Width="92"
                                        Height="62"
                                        CornerRadius="10"
                                        ClipToBounds="True"
                                        Background="{DynamicResource Surface0Brush}"
                                        VerticalAlignment="Top">
                                  <Grid>
                                    <controls:RemoteImage Url="{Binding CoverUrl}"
                                                          Stretch="UniformToFill" />

                                    <!-- Active episode dark overlay + play icon. -->
                                    <Border Background="#99000000">
                                      <Border.IsVisible>
                                        <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                                          <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}" />
                                          <Binding Path="#PlayerRoot.DataContext.CurrentEpisodeIdentity" />
                                        </MultiBinding>
                                      </Border.IsVisible>
                                      <icons:MaterialIcon Kind="PlayCircle"
                                                          Width="28"
                                                          Height="28"
                                                          Foreground="White"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Opacity="0.95" />
                                    </Border>

                                    <!-- Episode number badge. -->
                                    <Border VerticalAlignment="Bottom"
                                            HorizontalAlignment="Left"
                                            Background="#AA000000"
                                            CornerRadius="0,8,0,0"
                                            Padding="6,3,8,3">
                                      <TextBlock Text="{Binding EpisodeNumber}"
                                                 Foreground="White"
                                                 FontSize="11"
                                                 FontWeight="Bold" />
                                    </Border>

                                    <!-- Watched progress bar. -->
                                    <Border VerticalAlignment="Bottom"
                                            Height="4"
                                            Background="#66000000"
                                            IsVisible="{Binding WatchedPercentage, Converter={StaticResource CountToVisibilityConverter}}">
                                      <Border HorizontalAlignment="Left"
                                              Background="{DynamicResource AccentBrush}"
                                              Width="{Binding WatchedPercentage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=92}" />
                                    </Border>
                                  </Grid>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Spacing="3"
                                            VerticalAlignment="Center">
                                  <!-- TMDB episode title. -->
                                  <TextBlock Text="{Binding TmdbEpisodeName}"
                                             Foreground="{DynamicResource AccentBrush}"
                                             FontSize="12"
                                             FontStyle="Italic"
                                             Opacity="0.9"
                                             TextTrimming="CharacterEllipsis"
                                             MaxLines="1"
                                             IsVisible="{Binding TmdbEpisodeName, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                                  <DockPanel LastChildFill="True">
                                    <icons:MaterialIcon DockPanel.Dock="Right"
                                                        Kind="CheckCircle"
                                                        Width="17"
                                                        Height="17"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        Margin="8,1,0,0"
                                                        IsVisible="{Binding IsCompleted}" />
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2"
                                               LineHeight="17" />
                                  </DockPanel>

                                  <TextBlock Text="{Binding EpisodeMetaText}"
                                             Foreground="{DynamicResource TextMutedBrush}"
                                             FontSize="11"
                                             TextTrimming="CharacterEllipsis"
                                             IsVisible="{Binding EpisodeMetaText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                                  <StackPanel Orientation="Horizontal"
                                              Spacing="6"
                                              Margin="0,1,0,0">
                                    <StackPanel.IsVisible>
                                      <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                                        <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}" />
                                        <Binding Path="#PlayerRoot.DataContext.CurrentEpisodeIdentity" />
                                      </MultiBinding>
                                    </StackPanel.IsVisible>
                                    <Ellipse Width="6"
                                             Height="6"
                                             Fill="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Translate Player.Info.NowPlaying}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Black"
                                               LetterSpacing="0.5"
                                               VerticalAlignment="Center" />
                                  </StackPanel>

                                  <TextBlock Text="{Binding Plot}"
                                             Foreground="{DynamicResource TextMutedBrush}"
                                             FontSize="11"
                                             TextWrapping="Wrap"
                                             TextTrimming="CharacterEllipsis"
                                             MaxLines="2"
                                             IsVisible="{Binding Plot, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                </StackPanel>
                              </Grid>
                            </Panel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>


      <Border Background="{DynamicResource OverlayBackgroundBrush}"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsInfoPanelOpen}">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto"
                Margin="0,0,0,10">
            <StackPanel Spacing="2"
                        VerticalAlignment="Center">
              <TextBlock Text="{loc:Translate Player.Info.Title}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding CurrentChannel.Name}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{loc:Translate Common.Close}"
                    Command="{Binding OpenInfoPanelCommand}"
                    MinHeight="44"
                    Margin="10,0,0,0" />
          </Grid>

          <ScrollViewer Grid.Row="1"
                        MaxHeight="300"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
              <!-- Live: current EPG program and description. -->
              <Border Background="{DynamicResource Surface1Brush}"
                      CornerRadius="12"
                      Padding="12"
                      IsVisible="{Binding IsLiveInfoVisible}">
                <StackPanel Spacing="5">
                  <TextBlock Text="{loc:Translate Player.Info.NowPlaying}"
                             Foreground="{DynamicResource AccentBrush}"
                             FontSize="10"
                             FontWeight="Bold" />
                  <TextBlock Text="{Binding CurrentProgram.Title}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CurrentProgram.TimeRange}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="11"
                             IsVisible="{Binding HasCurrentProgramInfo}" />
                  <TextBlock Text="{Binding CurrentProgram.Description}"
                             Foreground="{DynamicResource OverlayTextBrush}"
                             FontSize="12"
                             LineHeight="18"
                             TextWrapping="Wrap"
                             IsVisible="{Binding CurrentProgram.Description, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                </StackPanel>
              </Border>

              <!-- Series: show series context plus the selected episode metadata. -->
              <Border Background="{DynamicResource Surface1Brush}"
                      CornerRadius="12"
                      Padding="12"
                      IsVisible="{Binding IsInfoSeriesHeaderVisible}">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding SeriesInfoTitle}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SeriesInfoPlot}"
                             Foreground="{DynamicResource OverlayTextBrush}"
                             FontSize="12"
                             LineHeight="18"
                             TextWrapping="Wrap"
                             MaxHeight="96"
                             IsVisible="{Binding SeriesInfoPlot, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource Surface1Brush}"
                      CornerRadius="12"
                      Padding="12"
                      IsVisible="{Binding IsInfoEpisodeVisible}">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding CurrentEpisodeDisplayTitle}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             IsVisible="{Binding CurrentEpisodeDisplayTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                  <TextBlock Text="{Binding CurrentEpisodeMetaText}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="11"
                             IsVisible="{Binding CurrentEpisodeMetaText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                  <TextBlock Text="{Binding CurrentEpisode.Plot}"
                             Foreground="{DynamicResource OverlayTextBrush}"
                             FontSize="12"
                             LineHeight="18"
                             TextWrapping="Wrap"
                             MaxHeight="110"
                             IsVisible="{Binding CurrentEpisode.Plot, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                </StackPanel>
              </Border>

              <!-- Movies / VOD: full plot plus year, rating, maturity and duration when available. -->
              <Border Background="{DynamicResource Surface1Brush}"
                      CornerRadius="12"
                      Padding="12"
                      IsVisible="{Binding IsVodPlotVisible}">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding InfoVodMetaText}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="11"
                             IsVisible="{Binding InfoVodMetaText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                  <TextBlock Text="{Binding CurrentChannel.Plot}"
                             Foreground="{DynamicResource OverlayTextBrush}"
                             FontSize="12"
                             LineHeight="18"
                             TextWrapping="Wrap"
                             MaxHeight="130" />
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource Surface1Brush}"
                      CornerRadius="12"
                      Padding="12"
                      IsVisible="{Binding IsInfoDirectorVisible}">
                <StackPanel Spacing="5">
                  <TextBlock Text="{loc:Translate Player.Info.Director}"
                             Foreground="{DynamicResource TextDisabledBrush}"
                             FontSize="10"
                             FontWeight="Bold" />
                  <TextBlock Text="{Binding InfoDirectorText}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource Surface1Brush}"
                      CornerRadius="12"
                      Padding="12"
                      IsVisible="{Binding IsInfoCastVisible}">
                <StackPanel Spacing="5">
                  <TextBlock Text="{loc:Translate Player.Info.Cast}"
                             Foreground="{DynamicResource TextDisabledBrush}"
                             FontSize="10"
                             FontWeight="Bold" />
                  <TextBlock Text="{Binding InfoCastText}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="12"
                             LineHeight="18"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <Button Content="{loc:Translate Player.Mobile.Quality}"
              Command="{Binding OpenQualitySettingsCommand}"
              MinHeight="44" />

      <Border Background="{DynamicResource OverlayBackgroundBrush}"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding IsQualitySettingsOpen}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Player.Mobile.Quality}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Content="{loc:Translate Common.Close}"
                    Command="{Binding OpenQualitySettingsCommand}"
                    MinHeight="44"
                    Margin="10,0,0,0" />
          </Grid>

          <Grid ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Resolution}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityResolutionText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Fps}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityFpsText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Row="1"
                        Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Codec}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityVideoCodecText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Bitrate}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityVideoBitrateText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Audio}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityAudioText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <TextBlock Text="{loc:Translate Player.Mobile.Speed}"
                     Foreground="{DynamicResource TextDisabledBrush}"
                     FontSize="10"
                     FontWeight="Bold" />
          <Grid ColumnDefinitions="*,*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="8"
                RowSpacing="8">
            <Button Content="0.5x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.5}"
                    MinHeight="38" />
            <Button Grid.Column="1"
                    Content="0.75x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.75}"
                    MinHeight="38" />
            <Button Grid.Column="2"
                    Content="1.0x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.0}"
                    MinHeight="38" />
            <Button Grid.Row="1"
                    Content="1.25x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.25}"
                    MinHeight="38" />
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Content="1.5x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.5}"
                    MinHeight="38" />
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Content="2.0x"
                    Command="{Binding SetPlaybackSpeedCommand}"
                    CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=2.0}"
                    MinHeight="38" />
          </Grid>
        </StackPanel>
      </Border>

      <StackPanel Spacing="6">
        <!-- Row 1: Resolution + FPS -->
        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="8">
          <Border Background="{DynamicResource OverlayBackgroundBrush}"
                  CornerRadius="10"
                  Padding="10,8">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Resolution}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityResolutionText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1"
                  Background="{DynamicResource OverlayBackgroundBrush}"
                  CornerRadius="10"
                  Padding="10,8">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Fps}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityFpsText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Row 2: Codec + Bitrate -->
        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="8">
          <Border Background="{DynamicResource OverlayBackgroundBrush}"
                  CornerRadius="10"
                  Padding="10,8">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Codec}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityVideoCodecText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1"
                  Background="{DynamicResource OverlayBackgroundBrush}"
                  CornerRadius="10"
                  Padding="10,8">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Translate Player.Quality.Bitrate}"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding QualityVideoBitrateText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Row 3: Audio (full width) -->
        <Border Background="{DynamicResource OverlayBackgroundBrush}"
                CornerRadius="10"
                Padding="10,8">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="8">
            <TextBlock Text="{loc:Translate Player.Quality.Audio}"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       FontSize="10"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding QualityAudioText}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
      </StackPanel>

      <!-- Next Episode Prompt → bölüm bitince öneri kartı -->
      <Border Background="{DynamicResource Surface0Brush}"
              CornerRadius="16"
              Padding="16"
              IsVisible="{Binding IsNextEpisodePromptVisible}">
        <StackPanel Spacing="10">
          <TextBlock Text="{loc:Translate Player.Overlay.NextEpisode}"
                     FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="{Binding NextEpisode.Name}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis"
                     MaxLines="1" />
          <Button Command="{Binding PlayNextEpisodeCommand}"
                  MinHeight="44"
                  CornerRadius="10"
                  Background="{DynamicResource AccentBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  FontSize="14"
                  FontWeight="Bold"
                  BorderThickness="0"
                  HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <icons:MaterialIcon Kind="Play" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{loc:Translate Player.NextEpisode.WatchNow}" FontSize="14" FontWeight="Bold" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Resume Dialog (inline card — mobile pattern) -->
      <Border Background="{DynamicResource Surface0Brush}"
              CornerRadius="16"
              Padding="20"
              IsVisible="{Binding IsResumeDialogVisible}">
        <StackPanel Spacing="16">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="PlayCircleOutline"
                                Width="40" Height="40"
                                Foreground="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Translate Player.Resume.Title}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>
          <Border Background="{DynamicResource Surface1Brush}" CornerRadius="10" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <icons:MaterialIcon Kind="ClockOutline" Width="16" Height="16"
                                  Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{loc:Translate Player.Resume.LastPosition}"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
                <TextBlock Text="{Binding ResumePositionText}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="SemiBold" />
              </StackPanel>
            </StackPanel>
          </Border>
          <StackPanel Spacing="10">
            <Button Command="{Binding ResumeFromPositionCommand}"
                    IsVisible="{Binding IsPremiumResume}"
                    MinHeight="48" BorderThickness="0" CornerRadius="12"
                    HorizontalAlignment="Stretch">
              <Button.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Color="#8B5CF6" Offset="0" />
                  <GradientStop Color="#A855F7" Offset="1" />
                </LinearGradientBrush>
              </Button.Background>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <icons:MaterialIcon Kind="Play" Width="18" Height="18" Foreground="White" />
                <TextBlock Text="{loc:Translate Player.Resume.Continue}" Foreground="White"
                           FontSize="14" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
            <Button IsVisible="{Binding !IsPremiumResume}" IsEnabled="False"
                    MinHeight="48" CornerRadius="12" BorderThickness="1"
                    Background="{DynamicResource Surface1Brush}"
                    HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" Spacing="8">
                  <icons:MaterialIcon Kind="Play" Width="18" Height="18"
                                      Foreground="{DynamicResource TextMutedBrush}" />
                  <TextBlock Text="{loc:Translate Player.Resume.Continue}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
                <icons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    VerticalAlignment="Center" Margin="0,0,16,0" />
              </Grid>
            </Button>
            <Button Command="{Binding StartFromBeginningCommand}"
                    MinHeight="48" CornerRadius="12"
                    Background="{DynamicResource Surface0Brush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                    HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <icons:MaterialIcon Kind="SkipBackward" Width="18" Height="18" />
                <TextBlock Text="{loc:Translate Player.Resume.StartOver}" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Border IsVisible="{Binding !IsPremiumResume}"
                  Background="Transparent" Padding="4" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <icons:MaterialIcon Kind="Crown" Width="14" Height="14"
                                  Foreground="{DynamicResource AccentLightBrush}" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Translate Common.Premium}" FontSize="12"
                           Foreground="{DynamicResource AccentLightBrush}" />
                <TextBlock Text="{loc:Translate Player.Resume.UpgradeNote}" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>

    <!-- EPG MODU: video üstte küçülür (şeffaf slot), EPG listesi altında açılır -->
    <Grid x:Name="EpgModeRoot" Grid.ColumnSpan="2"
          RowDefinitions="Auto,*"
          IsVisible="{Binding IsEpgPanelOpen}">
      <!-- Üst: küçük şeffaf video alanı (native video surface buraya küçültülür) -->
      <Border x:Name="VideoSlot" Grid.Row="0"
              Background="Transparent"
              ClipToBounds="True">
        <!-- Videonun alt kenarına ince yarı saydam kontrol şeridi -->
        <Border VerticalAlignment="Bottom"
                Background="#A6000000"
                Padding="12,6">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{Binding CurrentChannel.Name}"
                         FontSize="13" FontWeight="SemiBold"
                         Foreground="White"
                         TextTrimming="CharacterEllipsis" MaxLines="1" />
              <TextBlock Text="{Binding ConnectionStatus}"
                         FontSize="10"
                         Foreground="#CCFFFFFF"
                         TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Command="{Binding PlayPauseCommand}"
                      MinHeight="44" MinWidth="44"
                      Background="Transparent" BorderThickness="0" CornerRadius="22">
                <Grid>
                  <icons:MaterialIcon Kind="Pause" Width="20" Height="20"
                                      Foreground="White" IsVisible="{Binding IsPlaying}" />
                  <icons:MaterialIcon Kind="Play" Width="20" Height="20"
                                      Foreground="White" IsVisible="{Binding !IsPlaying}" />
                </Grid>
              </Button>
              <Button Command="{Binding ToggleFullScreenCommand}"
                      MinHeight="44" MinWidth="44"
                      Background="Transparent" BorderThickness="0" CornerRadius="22">
                <Grid>
                  <icons:MaterialIcon Kind="Fullscreen" Width="20" Height="20"
                                      Foreground="White"
                                      IsVisible="{Binding IsFullScreen, Converter={StaticResource InverseBoolConverter}}" />
                  <icons:MaterialIcon Kind="FullscreenExit" Width="20" Height="20"
                                      Foreground="White"
                                      IsVisible="{Binding IsFullScreen}" />
                </Grid>
              </Button>
              <Button Command="{Binding ToggleEpgPanelCommand}"
                      MinHeight="44" MinWidth="44"
                      Background="Transparent" BorderThickness="0" CornerRadius="22">
                <icons:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="White" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Border>

      <!-- EPG Timeline paneli (tüm kalan alanı kaplar) -->
      <Grid Grid.Row="1" Background="#EE0D0D0D">
        <Grid RowDefinitions="Auto,*">
          <!-- EPG Header -->
          <Border Padding="14,10" Background="#1A7B2FBE">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <icons:MaterialIcon Kind="CalendarClock" Width="18" Height="18"
                                    Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{loc:Translate Player.Epg.GuideTitle}"
                           FontSize="11" FontWeight="Black"
                           Foreground="{DynamicResource AccentBrush}" LetterSpacing="2"
                           VerticalAlignment="Center" />
                <Border Background="#267B2FBE"
                        CornerRadius="5"
                        Padding="7,3"
                        VerticalAlignment="Center">
                  <TextBlock x:Name="EpgTimeWindowLabel"
                             FontSize="10" FontWeight="SemiBold"
                             Foreground="#B3FFFFFF" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsEpgLoading}">
                  <ProgressBar IsIndeterminate="True" Width="50" Height="3"
                               Foreground="{DynamicResource AccentBrush}" Background="#1AFFFFFF" />
                  <TextBlock Text="{loc:Translate Common.Loading}" FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Background="#33F59E0B" BorderBrush="#66F59E0B"
                      BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0"
                      VerticalAlignment="Center" IsVisible="{Binding IsEpgUpdateRequired}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <icons:MaterialIcon Kind="AlertCircle" Width="12" Height="12"
                                      Foreground="#FBBF24" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding EpgStatusMessage}" FontSize="10" FontWeight="SemiBold"
                             Foreground="#FDE68A" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                </StackPanel>
              </Border>
              <Button Grid.Column="2" Command="{Binding ToggleEpgPanelCommand}"
                      MinHeight="44" MinWidth="36"
                      Background="Transparent" BorderThickness="0" CornerRadius="18">
                <icons:MaterialIcon Kind="Close" Width="16" Height="16"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
              </Button>
            </Grid>
          </Border>

          <!-- Timeline: frozen kanal kolonu + saat başlığı + senkron scroll -->
          <Grid Grid.Row="1" ColumnDefinitions="112,*" ClipToBounds="True"
                Background="{DynamicResource Bg0Brush}">
            <!-- Sol: sabit kanal başlığı ve kanal listesi -->
            <Grid RowDefinitions="36,*" Background="#0D0D0D" ZIndex="20" ClipToBounds="True">
              <Border Grid.Row="0" Background="#131313"
                      BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,1">
                <TextBlock Text="{loc:Translate Player.Epg.ChannelHeader}"
                           FontSize="9" FontWeight="Black" LetterSpacing="1.2"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>

              <ScrollViewer Grid.Row="1"
                            x:Name="EpgNamesScroll"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Hidden"
                            IsHitTestVisible="False">
                <ItemsControl ItemsSource="{Binding EpgRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EpgPanelRow">
                      <Border Height="60"
                              BorderBrush="#0DFFFFFF"
                              BorderThickness="0,0,1,1"
                              Background="{Binding IsCurrentChannel, Converter={StaticResource BoolToSelectionBrushConverter}}">
                        <Grid ColumnDefinitions="34,*" ColumnSpacing="6" Margin="6,0">
                          <Border Width="30" Height="30" CornerRadius="6" ClipToBounds="True"
                                  Background="{DynamicResource Surface1Brush}"
                                  VerticalAlignment="Center">
                            <Grid>
                              <icons:MaterialIcon Kind="Television" Width="13" Height="13"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <controls:RemoteImage Url="{Binding Channel.LogoUrl}" Stretch="Uniform" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Channel.Name}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="2" />
                            <TextBlock Text="{Binding Channel.GroupTitle}" FontSize="7"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                       IsVisible="{Binding Channel.GroupTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>

            <!-- Sağ: saat başlığı ve program timeline -->
            <Grid Grid.Column="1" RowDefinitions="36,*" ClipToBounds="True">
              <Border Grid.Row="0" Background="#131313"
                      BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
                <ScrollViewer x:Name="EpgTimeHeaderScroll"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              IsHitTestVisible="False">
                  <Canvas x:Name="EpgTimeHeaderCanvas"
                          Width="{Binding EpgCanvasPixelWidth}"
                          Height="36" />
                </ScrollViewer>
              </Border>

              <ScrollViewer Grid.Row="1"
                            x:Name="EpgTimelineScroll"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            ScrollChanged="EpgTimelineScroll_ScrollChanged"
                            Background="{DynamicResource Bg0Brush}">
                <Grid Width="{Binding EpgCanvasPixelWidth}">
                  <ItemsControl ItemsSource="{Binding EpgRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:EpgPanelRow">
                        <Grid Height="60" ClipToBounds="True">
                          <Border Background="{Binding IsCurrentChannel, Converter={StaticResource BoolToSelectionBrushConverter}}"
                                  BorderBrush="#0DFFFFFF"
                                  BorderThickness="0,0,0,1" />

                          <TextBlock Text="{loc:Translate Player.Epg.NoInfo}" FontSize="10"
                                     Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                     Margin="10,0,0,0"
                                     IsVisible="{Binding HasEpgData, Converter={StaticResource InverseBoolConverter}}" />

                          <ItemsControl ItemsSource="{Binding Blocks}"
                                        IsVisible="{Binding HasEpgData}"
                                        ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <Grid />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:EpgProgramBlock">
                                <Border Width="{Binding PixelWidth}"
                                        Margin="{Binding PixelLeft, Converter={StaticResource DoubleToLeftMarginConverter}}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Height="{Binding VisualHeight}" CornerRadius="5" ClipToBounds="True"
                                        Padding="0"
                                        PointerReleased="EpgRow_PointerReleased"
                                        ToolTip.Tip="{Binding Program.Title}"
                                        Opacity="{Binding IsPast, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter=0.45}">
                                  <Border.Background>
                                    <SolidColorBrush Color="{Binding IsCurrentProgram, Converter={StaticResource BoolToEpgBlockColorConverter}}" />
                                  </Border.Background>
                                  <Border.BorderBrush>
                                    <SolidColorBrush Color="{Binding IsCurrentProgram, Converter={StaticResource BoolToEpgBorderColorConverter}}" />
                                  </Border.BorderBrush>
                                  <Border.BorderThickness>1</Border.BorderThickness>
                                  <Grid ClipToBounds="True">
                                    <Border HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Width="{Binding ProgressPixelWidth}"
                                            Background="#38FFFFFF"
                                            IsVisible="{Binding IsCurrentProgram}"
                                            IsHitTestVisible="False" />
                                    <StackPanel Margin="7,0" VerticalAlignment="Center" Spacing="1"
                                                IsVisible="{Binding HasReadableText}">
                                      <TextBlock Text="{Binding Program.Title}" FontSize="10" FontWeight="SemiBold"
                                                 Foreground="White" TextTrimming="CharacterEllipsis"
                                                 MaxLines="1" />
                                      <TextBlock Text="{Binding Program.TimeRange}" FontSize="7"
                                                 Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis"
                                                 MaxLines="1" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <Border Width="1.5" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                  Background="#CC7B2FBE"
                                  Margin="{Binding NowLineLeft, Converter={StaticResource DoubleToLeftMarginConverter}}"
                                  IsHitTestVisible="False" ZIndex="10" />

                          <Border PointerReleased="EpgRow_PointerReleased"
                                  Background="Transparent"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ZIndex="20"
                                  IsVisible="{Binding IsCurrentChannel, Converter={StaticResource InverseBoolConverter}}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Grid>

</UserControl>
