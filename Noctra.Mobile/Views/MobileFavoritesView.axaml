<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:models="using:Noctra.Models"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileFavoritesView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390" d:DesignHeight="720">

  <ScrollViewer x:Name="FavoritesScrollViewer"
                ScrollChanged="FavoritesScrollViewer_ScrollChanged" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,16,20,28" Spacing="24">

      <!-- Title and total count -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{loc:Translate Favorites.Title}"
                   FontSize="28" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center" />
        <Border Grid.Column="1"
                Background="{DynamicResource Surface1Brush}"
                CornerRadius="20" Padding="12,6"
                VerticalAlignment="Center"
                IsVisible="{Binding FavoriteChannels.Count,
                                    Converter={StaticResource CountToVisibilityConverter}}">
          <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="13" FontWeight="Medium">
            <Run Text="{Binding FavoriteChannels.Count}" />
            <Run Text=" items" />
          </TextBlock>
        </Border>
      </Grid>

      <!-- Live TV -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding FavoriteLiveChannels.Count,
                                      Converter={StaticResource CountToVisibilityConverter}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border Width="3" Height="20" CornerRadius="2"
                  Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{loc:Translate History.LiveTv}"
                     FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding FavoriteLiveChannels}" HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Stretch" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <controls:MobileLiveTvCard Margin="0,0,12,12"
                  ShowFavoriteMenu="False"
                  ShowRemoveFavoriteMenu="True"
                  Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl},
                                  Converter={StaticResource ResponsiveCardMetricConverter},
                                  ConverterParameter=liveWidth}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Series -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding FavoriteSeriesItems.Count,
                                      Converter={StaticResource CountToVisibilityConverter}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border Width="3" Height="20" CornerRadius="2"
                  Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{loc:Translate History.Series}"
                     FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding FavoriteSeriesItems}" HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Stretch" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Series">
              <controls:MobileSeriesCard Margin="0,0,12,12"
                  ShowRemoveFavoriteMenu="True"
                  Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                  Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Movies -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding FavoriteVodChannels.Count,
                                      Converter={StaticResource CountToVisibilityConverter}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border Width="3" Height="20" CornerRadius="2"
                  Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{loc:Translate History.Movies}"
                     FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding FavoriteVodChannels}" HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Stretch" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <controls:MobileVodCard Margin="0,0,12,12"
                  ShowRemoveFavoriteMenu="True"
                  Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                  Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Empty state -->
      <controls:MobileEmptyStateView
                  IsVisible="{Binding ShowFavoritesEmptyState}"
                  IconKind="HeartOutline"
                  Title="{loc:Translate Favorites.Empty.Title}"
                  Description="{loc:Translate Favorites.Empty.Description}" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
