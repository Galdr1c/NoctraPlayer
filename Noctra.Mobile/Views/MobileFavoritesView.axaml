<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.UI.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:shared="using:Noctra.UI.Views"
             x:Class="Noctra.Mobile.Views.MobileFavoritesView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False">
  <shared:AdaptiveLibraryView
      Title="{loc:Translate Favorites.Title}"
      CountText="{Binding FavoriteChannels.Count}"
      ShowCountBadge="{Binding FavoriteChannels.Count, Converter={StaticResource CountToVisibilityConverter}}"
      IsEmpty="{Binding ShowFavoritesEmptyState}"
      EmptyIconKind="HeartOutline"
      EmptyTitle="{loc:Translate Favorites.Empty.Title}"
      EmptyDescription="{loc:Translate Favorites.Empty.Description}">
    <shared:AdaptiveLibraryView.ItemsHost>
      <controls:MobileSectionedCardFeed Grid.Row="0"
                                        x:Name="PrimaryScrollContent"
                                        ItemContainerTheme="{StaticResource TransparentListBoxItemTheme}">
        <controls:MobileSectionedCardFeed.Sections>
          <controls:MobileCardSection Header="{loc:Translate History.LiveTv}" CardKind="Live" PresentationMode="Favorites" SourceItems="{Binding FavoriteLiveChannels}" />
          <controls:MobileCardSection Header="{loc:Translate History.Series}" CardKind="Series" PresentationMode="Favorites" SourceItems="{Binding FavoriteSeriesItems}" />
          <controls:MobileCardSection Header="{loc:Translate History.Movies}" CardKind="Vod" PresentationMode="Favorites" SourceItems="{Binding FavoriteVodChannels}" />
        </controls:MobileSectionedCardFeed.Sections>
      </controls:MobileSectionedCardFeed>
    </shared:AdaptiveLibraryView.ItemsHost>
  </shared:AdaptiveLibraryView>
</UserControl>
