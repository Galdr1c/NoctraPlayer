<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileFavoritesView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <UserControl.Resources>
    <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
  </UserControl.Resources>

  <ScrollViewer>
    <!-- Increase margins and spacing to mirror desktop layout -->
    <StackPanel Margin="24" Spacing="20">
      <!-- Title styled like desktop: bold with subtle letter spacing -->
      <TextBlock Text="{loc:Translate Favorites.Title}"
                 FontSize="24"
                 FontWeight="Bold"
                 LetterSpacing="1"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Margin="0,0,0,24" />

      <!-- Live TV -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding FavoriteLiveChannels.Count, Converter={StaticResource CountToVisibility}}">
        <!-- Section header styled like desktop: larger font and primary colour -->
        <TextBlock Text="{loc:Translate History.LiveTv}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   LetterSpacing="1"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <ItemsControl ItemsSource="{Binding FavoriteLiveChannels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                      CommandParameter="{Binding}"
                      Background="{DynamicResource Surface0Brush}"
                      BorderThickness="0"
                      CornerRadius="16"
                      Padding="14"
                      Margin="0,0,0,16"
                      HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="52,*"
                      ColumnSpacing="12">
                  <Border Width="42"
                          Height="42"
                          CornerRadius="10"
                          ClipToBounds="True"
                          Background="{DynamicResource Surface1Brush}">
                    <Grid>
                      <icons:MaterialIcon Kind="Television"
                                          Foreground="{DynamicResource AccentBrush}"
                                          Width="20"
                                          Height="20" />
                      <controls:RemoteImage Url="{Binding CoverUrl}" Stretch="Uniform" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1"
                              Spacing="3"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GroupTitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Series -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding FavoriteSeriesItems.Count, Converter={StaticResource CountToVisibility}}">
        <!-- Section header styled like desktop: larger font and primary colour -->
        <TextBlock Text="{loc:Translate History.Series}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   LetterSpacing="1"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <ItemsControl ItemsSource="{Binding FavoriteSeriesItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Series">
              <controls:MobileSeriesCard Margin="0,0,16,16"
                                         Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                                         Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Movies -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding FavoriteVodChannels.Count, Converter={StaticResource CountToVisibility}}">
        <!-- Section header styled like desktop: larger font and primary colour -->
        <TextBlock Text="{loc:Translate History.Movies}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   LetterSpacing="1"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <ItemsControl ItemsSource="{Binding FavoriteVodChannels}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <controls:MobileVodCard Margin="0,0,16,16"
                                      Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                                      Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Empty State -->
      <StackPanel Spacing="8"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding ShowFavoritesEmptyState}">
        <!-- Icon matching desktop: heart outline -->
        <icons:MaterialIcon Kind="HeartOutline"
                            Width="64"
                            Height="64"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Opacity="0.5"
                            HorizontalAlignment="Center" />
        <!-- Empty title styled like desktop: bold and letter‑spaced -->
        <TextBlock Text="{loc:Translate Favorites.Empty.Title}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="20"
                   FontWeight="Bold"
                   LetterSpacing="1"
                   TextAlignment="Center"
                   Margin="0,16,0,4" />
        <TextBlock Text="{loc:Translate Favorites.Empty.Description}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="14"
                   TextAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
