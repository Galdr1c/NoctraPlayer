<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:views="using:Noctra.Mobile.Views"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileSettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <Grid Background="{DynamicResource Bg0Brush}">
    <ScrollViewer>
      <StackPanel Margin="24,18,24,28" Spacing="20">
      <StackPanel Spacing="6">
        <TextBlock Text="{loc:Translate Settings.Title}"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="13"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="NoctraCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="20"
              Padding="16">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="16">
          <Border Width="64"
                  Height="64"
                  CornerRadius="18"
                  ClipToBounds="True"
                  Background="{DynamicResource AccentHoverBrush}">
            <Image Source="{Binding CurrentProfileAvatar, Converter={StaticResource AvatarPathConverter}}"
                   Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1"
                      Spacing="6"
                      VerticalAlignment="Center">
            <TextBlock Text="{loc:Translate Settings.Profile.ActiveProfile}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="11"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding CurrentProfileName}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="22"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ProfileCreatedAt, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Profile.CreatedAtFormat'}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="SettingsSectionCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="18"
              Padding="16">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="AccountSwitchOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{loc:Translate Settings.Profile.Management}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="18"
                       FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="{loc:Translate Settings.Profile.ManagementDetail}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12"
                     TextWrapping="Wrap" />
          <Button Classes="SettingsActionButton"
                  Click="BackToProfiles_Click"
                  MinHeight="46"
                  Background="{DynamicResource Surface1Brush}"
                  BorderThickness="0"
                  CornerRadius="14"
                  Padding="14,0"
                  HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <icons:MaterialIcon Kind="AccountSwitchOutline"
                                  Width="20"
                                  Height="20"
                                  Foreground="{DynamicResource AccentBrush}"
                                  VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{loc:Translate Settings.Profile.BackToProfiles}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <icons:MaterialIcon Grid.Column="2"
                                  Kind="ChevronRight"
                                  Width="20"
                                  Height="20"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>

      <Border Classes="SettingsSectionCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="AccountBoxOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{loc:Translate Settings.Account.Title}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
            <TextBlock Text="{Binding ProviderUrlLabel}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ProviderUrl}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10"
                IsVisible="{Binding ShowProviderIdentity}">
            <TextBlock Text="{Binding ProviderIdentityLabel}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ProviderUsername}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10"
                IsVisible="{Binding ShowProviderPassword}">
            <TextBlock Text="{loc:Translate Settings.Account.Password}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ProviderPassword}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
          </Grid>
          <StackPanel Spacing="3"
                      IsVisible="{Binding ShowProviderExpiration}">
            <TextBlock Text="{loc:Translate Settings.Account.Expiry}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
            <TextBlock Text="{Binding ExpirationDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Account.ExpiryFormat'}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding ExpirationStatus}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="12" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="SettingsSectionCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="BrushVariant" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{loc:Translate GlobalSettings.Appearance.Title}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </StackPanel>

          <StackPanel Spacing="10"
                      Tag="{Binding IsDarkTheme}">
            <StackPanel>
              <TextBlock Text="{loc:Translate Settings.Theme.Title}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontWeight="Medium" />
              <TextBlock Text="{loc:Translate GlobalSettings.Theme.Description}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">
              <Border x:Name="DarkThemeButton"
                      Height="92"
                      CornerRadius="12"
                      BorderThickness="3"
                      BorderBrush="Transparent"
                      PointerPressed="DarkTheme_PointerPressed">
                <Grid>
                  <Border Background="{DynamicResource ThemePreviewDarkBg}"
                          CornerRadius="9">
                    <Grid>
                      <Border Background="{DynamicResource ThemePreviewDarkInnerBg}"
                              Height="54"
                              CornerRadius="7"
                              Margin="12"
                              VerticalAlignment="Top">
                        <StackPanel Margin="10,8">
                          <Rectangle Fill="White"
                                     Height="4"
                                     Width="38"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,6" />
                          <Rectangle Fill="{DynamicResource ThemePreviewDarkText}"
                                     Height="3"
                                     Width="56"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,4" />
                          <Rectangle Fill="{DynamicResource ThemePreviewDarkText}"
                                     Height="3"
                                     Width="44"
                                     HorizontalAlignment="Left" />
                        </StackPanel>
                      </Border>
                      <Border x:Name="DarkCheckmark"
                              Width="22"
                              Height="22"
                              Background="{DynamicResource AccentBrush}"
                              CornerRadius="11"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="6">
                        <icons:MaterialIcon Kind="Check"
                                            Foreground="White"
                                            Width="12"
                                            Height="12"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Border>
                  <TextBlock Text="{loc:Translate Settings.Theme.Dark}"
                             FontSize="12"
                             Foreground="{DynamicResource ThemePreviewDarkLabelBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,7" />
                </Grid>
              </Border>

              <Border x:Name="LightThemeButton"
                      Grid.Column="1"
                      Height="92"
                      CornerRadius="12"
                      BorderThickness="3"
                      BorderBrush="Transparent"
                      PointerPressed="LightTheme_PointerPressed">
                <Grid>
                  <Border Background="{DynamicResource ThemePreviewLightBg}"
                          CornerRadius="9">
                    <Grid>
                      <Border Background="{DynamicResource ThemePreviewLightInnerBg}"
                              Height="54"
                              CornerRadius="7"
                              Margin="12"
                              VerticalAlignment="Top">
                        <StackPanel Margin="10,8">
                          <Rectangle Fill="{DynamicResource ThemePreviewDarkBg}"
                                     Height="4"
                                     Width="38"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,6" />
                          <Rectangle Fill="{DynamicResource ThemePreviewLightText}"
                                     Height="3"
                                     Width="56"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,4" />
                          <Rectangle Fill="{DynamicResource ThemePreviewLightText}"
                                     Height="3"
                                     Width="44"
                                     HorizontalAlignment="Left" />
                        </StackPanel>
                      </Border>
                      <Border x:Name="LightCheckmark"
                              Width="22"
                              Height="22"
                              Background="{DynamicResource AccentBrush}"
                              CornerRadius="11"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="6"
                              IsVisible="False">
                        <icons:MaterialIcon Kind="Check"
                                            Foreground="White"
                                            Width="12"
                                            Height="12"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Border>
                  <TextBlock Text="{loc:Translate Settings.Theme.Light}"
                             FontSize="12"
                             Foreground="{DynamicResource ThemePreviewLightLabelBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,7" />
                </Grid>
              </Border>
            </Grid>
          </StackPanel>

          <TextBlock Text="{loc:Translate Settings.Language.Title}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <ComboBox SelectedValue="{Binding AppLanguage, Mode=TwoWay}"
                    Theme="{StaticResource ModernComboBox}"
                    SelectedValueBinding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                    MinHeight="44">
            <ComboBoxItem Content="{loc:Translate Language.English}" Tag="en" />
            <ComboBoxItem Content="{loc:Translate Language.Turkish}" Tag="tr" />
            <ComboBoxItem Content="{loc:Translate Language.German}" Tag="de" />
            <ComboBoxItem Content="{loc:Translate Language.French}" Tag="fr" />
            <ComboBoxItem Content="{loc:Translate Language.Spanish}" Tag="es" />
          </ComboBox>
        </StackPanel>
      </Border>

      <Border Classes="SettingsSectionCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="PlayBoxOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{loc:Translate Settings.Playback.Network}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="{loc:Translate Settings.Playback.UserAgent}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <TextBox Text="{Binding UserAgent, Mode=TwoWay}"
                   PlaceholderText="VLC/3.0.x LibVLC/3.0.x"
                   MinHeight="44" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Settings.Playback.AutoPlayNext}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding AutoPlayNext}"
                          VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{loc:Translate Settings.Playback.Quality}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <ComboBox SelectedIndex="{Binding SelectedDataUsage}"
                    Theme="{StaticResource ModernComboBox}"
                    MinHeight="44">
            <ComboBoxItem Content="{loc:Translate Settings.Playback.Quality.Low}" />
            <ComboBoxItem Content="{loc:Translate Settings.Playback.Quality.Medium}" />
            <ComboBoxItem Content="{loc:Translate Settings.Playback.Quality.High}" />
            <ComboBoxItem Content="{loc:Translate Settings.Playback.Quality.Auto}" />
          </ComboBox>
          <TextBlock Text="{loc:Translate Settings.Playback.Buffer}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <StackPanel Spacing="4">
            <RadioButton Content="{loc:Translate Settings.Playback.Buffer.Small}"
                         GroupName="MobileBuffer"
                         IsChecked="{Binding IsBufferSmall}"
                         IsEnabled="{Binding IsPremium}" />
            <RadioButton Content="{loc:Translate Settings.Playback.Buffer.Normal}"
                         GroupName="MobileBuffer"
                         IsChecked="{Binding IsBufferNormal}" />
            <RadioButton Content="{loc:Translate Settings.Playback.Buffer.Large}"
                         GroupName="MobileBuffer"
                         IsChecked="{Binding IsBufferLarge}"
                         IsEnabled="{Binding IsPremium}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Settings.Privacy.SaveHistory}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding SaveWatchHistory}"
                          VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Settings.Privacy.ClearOnExit}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding ClearHistoryOnExit}"
                          VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="SettingsSectionCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="ClosedCaptionOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{loc:Translate Settings.Playback.AudioSubtitle}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Settings.Playback.SubtitlesAuto}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding SubtitleEnabled}"
                          VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{loc:Translate Settings.Playback.PreferredSubtitle}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <ComboBox SelectedValue="{Binding SubtitleLanguage, Mode=TwoWay}"
                    Theme="{StaticResource ModernComboBox}"
                    SelectedValueBinding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                    MinHeight="44">
            <ComboBoxItem Content="{loc:Translate Language.Turkish}" Tag="tr" />
            <ComboBoxItem Content="{loc:Translate Language.English}" Tag="en" />
            <ComboBoxItem Content="{loc:Translate Language.German}" Tag="de" />
            <ComboBoxItem Content="{loc:Translate Language.French}" Tag="fr" />
            <ComboBoxItem Content="{loc:Translate Language.Spanish}" Tag="es" />
            <ComboBoxItem Content="{loc:Translate Language.Italian}" Tag="it" />
            <ComboBoxItem Content="{loc:Translate Language.Portuguese}" Tag="pt" />
            <ComboBoxItem Content="{loc:Translate Language.Russian}" Tag="ru" />
            <ComboBoxItem Content="{loc:Translate Language.Arabic}" Tag="ar" />
            <ComboBoxItem Content="{loc:Translate Language.Dutch}" Tag="nl" />
          </ComboBox>
          <TextBlock Text="{loc:Translate Settings.Playback.PreferredAudio}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <ComboBox SelectedValue="{Binding PreferredAudioLanguage, Mode=TwoWay}"
                    Theme="{StaticResource ModernComboBox}"
                    SelectedValueBinding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                    MinHeight="44">
            <ComboBoxItem Content="{loc:Translate Language.Turkish}" Tag="tr" />
            <ComboBoxItem Content="{loc:Translate Language.English}" Tag="en" />
            <ComboBoxItem Content="{loc:Translate Language.German}" Tag="de" />
            <ComboBoxItem Content="{loc:Translate Language.French}" Tag="fr" />
            <ComboBoxItem Content="{loc:Translate Language.Spanish}" Tag="es" />
            <ComboBoxItem Content="{loc:Translate Language.Italian}" Tag="it" />
            <ComboBoxItem Content="{loc:Translate Language.Portuguese}" Tag="pt" />
            <ComboBoxItem Content="{loc:Translate Language.Russian}" Tag="ru" />
            <ComboBoxItem Content="{loc:Translate Language.Arabic}" Tag="ar" />
            <ComboBoxItem Content="{loc:Translate Language.Dutch}" Tag="nl" />
          </ComboBox>
        </StackPanel>
      </Border>

      <Border Classes="SettingsSectionCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="DownloadBoxOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{loc:Translate Settings.Download.Title}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Settings.Download.WifiOnly}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding DownloadWifiOnly}"
                          VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{loc:Translate Settings.Download.Quality}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <ComboBox SelectedIndex="{Binding SelectedDownloadQuality}"
                    Theme="{StaticResource ModernComboBox}"
                    MinHeight="44">
            <ComboBoxItem Content="{loc:Translate Settings.Download.Quality.Standard}" />
            <ComboBoxItem Content="{loc:Translate Settings.Download.Quality.High}" />
          </ComboBox>
          <TextBlock Text="{loc:Translate Settings.Download.Path}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <TextBox Text="{Binding DownloadPath}"
                   IsReadOnly="True"
                   TextWrapping="Wrap"
                   MinHeight="44" />
          <TextBlock Text="{loc:Translate Mobile.Settings.Download.AndroidStorage}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12"
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Settings.Notifications.Download}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding ShowDownloadNotification}"
                          VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="SettingsSectionCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="FormatListBulletedSquare" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{loc:Translate Settings.Channels.Title}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </StackPanel>
          <Button Content="{loc:Translate Settings.Channels.RefreshNow}"
                  Command="{Binding RefreshChannelListNowCommand}"
                  MinHeight="44" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Settings.Channels.Count}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding TotalChannels}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Settings.Channels.LastUpdate}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ChannelListLastUpdated, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Channels.DateFormat'}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="12" />
          </Grid>
          <TextBlock Text="{Binding ChannelListLastError}"
                     Foreground="{DynamicResource ErrorBrush}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{loc:Translate Settings.Channels.Frequency}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <ComboBox SelectedIndex="{Binding ChannelListRefreshFrequencyIndex, Mode=TwoWay}"
                    Theme="{StaticResource ModernComboBox}"
                    MinHeight="44">
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.Off}" />
            <ComboBoxItem IsEnabled="{Binding IsPremium}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.1h}" />
                <icons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" />
              </Grid>
            </ComboBoxItem>
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.3h}"
                          IsEnabled="{Binding IsPremium}" />
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.12h}"
                          IsEnabled="{Binding IsPremium}" />
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.24h}"
                          IsEnabled="{Binding IsPremium}" />
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.2d}"
                          IsEnabled="{Binding IsPremium}" />
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.3d}"
                          IsEnabled="{Binding IsPremium}" />
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.7d}"
                          IsEnabled="{Binding IsPremium}" />
          </ComboBox>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Live}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding HiddenLiveGroups.Count}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="12"
                       FontWeight="SemiBold" />
          </Grid>
          <ItemsControl ItemsSource="{Binding HiddenLiveGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Surface1Brush}"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                    <TextBlock Text="{Binding}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UnhideGroupCommand}"
                            CommandParameter="{Binding}"
                            MinHeight="44">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <icons:MaterialIcon Kind="EyeOutline" Width="14" Height="14" />
                        <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Show}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Empty.Live}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12"
                     IsVisible="{Binding !HiddenLiveGroups.Count}" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Movies}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding HiddenMovieGroups.Count}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="12"
                       FontWeight="SemiBold" />
          </Grid>
          <ItemsControl ItemsSource="{Binding HiddenMovieGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Surface1Brush}"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                    <TextBlock Text="{Binding}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UnhideGroupCommand}"
                            CommandParameter="{Binding}"
                            MinHeight="44">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <icons:MaterialIcon Kind="EyeOutline" Width="14" Height="14" />
                        <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Show}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Empty.Movies}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12"
                     IsVisible="{Binding !HiddenMovieGroups.Count}" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Series}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding HiddenSeriesGroups.Count}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="12"
                       FontWeight="SemiBold" />
          </Grid>
          <ItemsControl ItemsSource="{Binding HiddenSeriesGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Surface1Brush}"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                    <TextBlock Text="{Binding}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UnhideGroupCommand}"
                            CommandParameter="{Binding}"
                            MinHeight="44">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <icons:MaterialIcon Kind="EyeOutline" Width="14" Height="14" />
                        <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Show}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Empty.Series}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12"
                     IsVisible="{Binding !HiddenSeriesGroups.Count}" />
        </StackPanel>
      </Border>

      <Border Classes="SettingsSectionCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="CalendarClock" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{loc:Translate Settings.Epg.Title}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Settings.Epg.Enabled}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding EpgEnabled}"
                          VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Settings.Epg.Count}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding TotalEpgPrograms}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Mobile.Settings.Epg.Channels}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding TotalEpgChannels}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Mobile.Settings.Epg.LastUpdate}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding LastEpgUpdate, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Channels.DateFormat'}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="12" />
          </Grid>
          <Button Classes="SettingsActionButton"
                  Command="{Binding RefreshEpgNowCommand}"
                  IsEnabled="{Binding !IsGlobalLoading}"
                  MinHeight="44">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:MaterialIcon Kind="Refresh" Width="18" Height="18" />
              <TextBlock Text="{loc:Translate Settings.Epg.RefreshNow}" />
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding EpgLastError}"
                     Foreground="{DynamicResource ErrorBrush}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{loc:Translate Settings.Epg.Refresh}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <ComboBox SelectedIndex="{Binding EpgRefreshFrequencyIndex, Mode=TwoWay}"
                    Theme="{StaticResource ModernComboBox}"
                    MinHeight="44">
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.Off}" />
            <ComboBoxItem IsEnabled="{Binding IsPremium}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.1h}" />
                <icons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" />
              </Grid>
            </ComboBoxItem>
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.3h}"
                          IsEnabled="{Binding IsPremium}" />
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.12h}"
                          IsEnabled="{Binding IsPremium}" />
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.24h}"
                          IsEnabled="{Binding IsPremium}" />
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.2d}"
                          IsEnabled="{Binding IsPremium}" />
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.3d}"
                          IsEnabled="{Binding IsPremium}" />
            <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.7d}"
                          IsEnabled="{Binding IsPremium}" />
          </ComboBox>
          <TextBlock Text="{loc:Translate Settings.Epg.Timezone}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <ComboBox SelectedIndex="{Binding EpgTimeOffsetIndex, Mode=TwoWay}"
                    Theme="{StaticResource ModernComboBox}"
                    MinHeight="44">
            <ComboBoxItem Content="{Binding Source=-12, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}" />
            <ComboBoxItem Content="{Binding Source=-11, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}" />
            <ComboBoxItem Content="{Binding Source=-10, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}" />
            <ComboBoxItem Content="{Binding Source=-9, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}" />
            <ComboBoxItem Content="{Binding Source=-8, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}" />
            <ComboBoxItem Content="{Binding Source=-7, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}" />
            <ComboBoxItem Content="{Binding Source=-6, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}" />
            <ComboBoxItem Content="{Binding Source=-5, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}" />
            <ComboBoxItem Content="{Binding Source=-4, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}" />
            <ComboBoxItem Content="{Binding Source=-3, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}" />
            <ComboBoxItem Content="{Binding Source=-2, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}" />
            <ComboBoxItem Content="{Binding Source=-1, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}" />
            <ComboBoxItem Content="{loc:Translate Settings.Epg.Timezone.Auto}" />
            <ComboBoxItem Content="{Binding Source=1, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}" />
            <ComboBoxItem Content="{Binding Source=2, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}" />
            <ComboBoxItem Content="{Binding Source=3, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}" />
            <ComboBoxItem Content="{Binding Source=4, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}" />
            <ComboBoxItem Content="{Binding Source=5, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}" />
            <ComboBoxItem Content="{Binding Source=6, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}" />
            <ComboBoxItem Content="{Binding Source=7, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}" />
            <ComboBoxItem Content="{Binding Source=8, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}" />
            <ComboBoxItem Content="{Binding Source=9, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}" />
            <ComboBoxItem Content="{Binding Source=10, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}" />
            <ComboBoxItem Content="{Binding Source=11, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}" />
            <ComboBoxItem Content="{Binding Source=12, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}" />
          </ComboBox>

          <Border Background="{DynamicResource Surface1Brush}"
                  CornerRadius="12"
                  Padding="12">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Text="{loc:Translate Settings.Epg.CustomSources}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding CustomEpgUrls.Count, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.SourcesCountFormat'}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding AddCustomEpgCommand}"
                        IsEnabled="{Binding !IsGlobalLoading}"
                        MinHeight="40">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="Plus" Width="18" Height="18" />
                    <TextBlock Text="{loc:Translate Settings.Epg.AddNew}" />
                  </StackPanel>
                </Button>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <icons:MaterialIcon Kind="AlertCircleOutline"
                                    Width="16"
                                    Height="16"
                                    Foreground="{DynamicResource WarningBrush}"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0" />
                <TextBlock Text="{loc:Translate Settings.Epg.PerformanceWarning}"
                           Foreground="{DynamicResource WarningBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
              </StackPanel>

              <ItemsControl ItemsSource="{Binding CustomEpgUrls}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          Margin="0,0,0,8">
                      <TextBox Text="{Binding Url, Mode=TwoWay}"
                               PlaceholderText="{loc:Translate Settings.Epg.UrlPlaceholder}"
                               MinHeight="44" />
                      <Button Grid.Column="1"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveCustomEpgCommand}"
                              CommandParameter="{Binding .}"
                              MinHeight="44">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <icons:MaterialIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="{DynamicResource ErrorBrush}" />
                          <TextBlock Text="{loc:Translate Settings.Epg.RemoveSource.Tooltip}" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="SettingsSectionCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="ShieldAccountOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{loc:Translate LegalConsent.Action.Privacy}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="{loc:Translate Settings.Privacy.Retention}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <ComboBox SelectedIndex="{Binding WatchHistoryRetentionIndex}"
                    Theme="{StaticResource ModernComboBox}"
                    MinHeight="44">
            <ComboBoxItem Content="{loc:Translate Settings.Privacy.Retention.Forever}" />
            <ComboBoxItem Content="{loc:Translate Settings.Privacy.Retention.3d}" />
            <ComboBoxItem Content="{loc:Translate Settings.Privacy.Retention.7d}" />
            <ComboBoxItem Content="{loc:Translate Settings.Privacy.Retention.14d}" />
            <ComboBoxItem Content="{loc:Translate Settings.Privacy.Retention.30d}" />
          </ComboBox>
          <Button Classes="SettingsDangerActionButton"
                  Content="{loc:Translate Settings.Privacy.ClearAllNow}"
                  Command="{Binding ClearHistoryCommand}"
                  MinHeight="44" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
            <Button Classes="SettingsActionButton"
                    Click="PrivacyPolicy_Click"
                    MinHeight="44"
                    Background="{DynamicResource Surface1Brush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    CornerRadius="10">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                <icons:MaterialIcon Kind="ShieldCheckOutline" Width="16" Height="16"
                                    Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{loc:Translate LegalConsent.Action.Privacy}" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
            <Button Classes="SettingsActionButton"
                    Grid.Column="1"
                    Click="Terms_Click"
                    MinHeight="44"
                    Background="{DynamicResource Surface1Brush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    CornerRadius="10">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                <icons:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16"
                                    Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{loc:Translate GlobalSettings.Terms.Title}" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="SettingsSectionCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="Crown" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{loc:Translate Mobile.Settings.About.Title}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="12">
            <Image Source="avares://Noctra.Mobile/Assets/Square150x150Logo.png"
                   Width="48"
                   Height="48"
                   Stretch="Uniform"
                   IsVisible="{Binding IsPremium}" />
            <Image Source="avares://Noctra.Mobile/Assets/Square150x150Logo.Gray.png"
                   Width="48"
                   Height="48"
                   Stretch="Uniform"
                   IsVisible="{Binding !IsPremium}" />
            <StackPanel Grid.Column="1"
                        Spacing="4"
                        VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <TextBlock Text="Noctra"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <Border Background="{DynamicResource PremiumBadgeBrush}"
                        CornerRadius="6"
                        Padding="8,2"
                        IsVisible="{Binding IsPremium}">
                  <TextBlock Text="PREMIUM"
                             Foreground="{DynamicResource PremiumBadgeTextBrush}"
                             FontSize="10"
                             FontWeight="Bold" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding CurrentVersion, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.About.PremiumVersionFormat'}"
                         IsVisible="{Binding IsPremium}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="12" />
              <TextBlock Text="{Binding CurrentVersion, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.About.VersionFormat'}"
                         IsVisible="{Binding !IsPremium}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="12" />
            </StackPanel>
          </Grid>

          <!-- ShowUpsellCommand remains on SettingsViewModel; mobile opens a branded bottom-sheet instead. -->
          <Button Classes="SettingsPrimaryActionButton"
                  Click="ShowUpsell_Click"
                  IsVisible="{Binding !IsPremium}"
                  MinHeight="44">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:MaterialIcon Kind="Crown" Width="18" Height="18" />
              <TextBlock Text="{loc:Translate GlobalSettings.About.Upgrade}" />
            </StackPanel>
          </Button>

          <Border Background="{DynamicResource Surface1Brush}"
                  CornerRadius="12"
                  Padding="12">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <icons:MaterialIcon Kind="Update" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{loc:Translate GlobalSettings.Update.Title}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Text="{Binding UpdateStatusText}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="12"
                         TextWrapping="Wrap" />
              <TextBlock Text="{loc:Translate GlobalSettings.Update.Checking}"
                         Foreground="{DynamicResource AccentBrush}"
                         FontSize="12"
                         IsVisible="{Binding IsCheckingUpdates}" />
              <Button Classes="SettingsActionButton"
                      Command="{Binding CheckForUpdatesCommand}"
                      IsVisible="{Binding IsIdle}"
                      MinHeight="44">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <icons:MaterialIcon Kind="Refresh" Width="18" Height="18" />
                  <TextBlock Text="{loc:Translate GlobalSettings.Update.Check}" />
                </StackPanel>
              </Button>
              <Button Classes="SettingsPrimaryActionButton"
                      Command="{Binding StartUpdateCommand}"
                      IsVisible="{Binding IsUpdateAvailable}"
                      MinHeight="44">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <icons:MaterialIcon Kind="RocketLaunch" Width="18" Height="18" />
                  <TextBlock Text="{loc:Translate GlobalSettings.Update.Now}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

        </StackPanel>
      </Border>

      <!-- Promo Code Section -->
      <Border Classes="SettingsSectionCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="GiftOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{loc:Translate GlobalSettings.Promo.Title}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="{loc:Translate GlobalSettings.Promo.Description}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12"
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding PromoCodeInput, Mode=TwoWay}"
                     PlaceholderText="{loc:Translate GlobalSettings.Promo.Placeholder}"
                     MinHeight="44" />
            <Button Classes="SettingsPrimaryActionButton"
                    Grid.Column="1"
                    Command="{Binding ApplyPromoCodeCommand}"
                    MinHeight="44"
                    MinWidth="80"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    CornerRadius="10"
                    Padding="16,10">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                <icons:MaterialIcon Kind="AutoAwesome" Width="18" Height="18" Foreground="White"
                                    IsVisible="{Binding !IsApplyingPromoCode}" />
                <icons:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="White"
                                    IsVisible="{Binding IsApplyingPromoCode}" />
                <TextBlock Text="{loc:Translate GlobalSettings.Promo.Apply}" Foreground="White" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </Grid>
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding PromoCodeStatus}"
                       Foreground="{Binding IsPromoCodeStatusSuccess, Converter={StaticResource BooleanToSuccessWarningBrushConverter}}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       IsVisible="{Binding PromoCodeStatus, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
            <TextBlock Text="{Binding PremiumStatusText}"
                       Foreground="{DynamicResource SuccessBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       IsVisible="{Binding PremiumStatusText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Cache Section -->
      <Border Classes="SettingsSectionCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="DeleteSweepOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{loc:Translate GlobalSettings.Cache.Title}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate GlobalSettings.Cache.Size}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding CacheSizeString}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold" />
          </Grid>
          <TextBlock Text="{loc:Translate GlobalSettings.Cache.Description}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12"
                     TextWrapping="Wrap" />
          <Button Classes="SettingsDangerActionButton"
                  Command="{Binding ClearCacheCommand}"
                  MinHeight="44">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:MaterialIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="{DynamicResource ErrorBrush}" />
              <TextBlock Text="{loc:Translate GlobalSettings.Cache.Clear.Button}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Bug Report Section -->
      <Border Background="#1AE50914"
              BorderBrush="#E50914"
              BorderThickness="1"
              CornerRadius="16"
              Padding="14">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="{loc:Translate GlobalSettings.Support.Question}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{loc:Translate GlobalSettings.Support.Description}"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Button Classes="SettingsPrimaryActionButton"
                  Grid.Column="1"
                  Command="{Binding ReportBugCommand}"
                  Background="#E50914"
                  Foreground="White"
                  CornerRadius="10"
                  Padding="16,10"
                  MinHeight="44"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <icons:MaterialIcon Kind="BugOutline" Width="16" Height="16" />
              <TextBlock Text="{loc:Translate GlobalSettings.Support.Report}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="10"
            Margin="0,0,0,24">
        <Button Classes="SettingsActionButton"
                Content="{loc:Translate Settings.Action.ResetDefaults}"
                Command="{Binding ResetToDefaultsCommand}"
                MinHeight="44" />
        <Button Classes="SettingsPrimaryActionButton"
                Grid.Column="1"
                Content="{loc:Translate Settings.Action.SaveSettings}"
                Command="{Binding SaveSettingsCommand}"
                MinHeight="44" />
      </Grid>
      </StackPanel>
    </ScrollViewer>

    <Grid Background="{DynamicResource OverlayDimBrush}"
          IsVisible="{Binding IsGlobalLoading}">
      <Border Classes="SettingsSectionCard" Background="{DynamicResource Surface0Brush}"
              CornerRadius="18"
              Padding="24"
              Width="300"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="{loc:Translate Common.Loading}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding GlobalLoadingMessage}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
          <TextBlock Text="{Binding StatusMessage}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
          <Button Content="{loc:Translate Dialog.Cancel}"
                  Command="{Binding CancelRefreshOperationCommand}"
                  MinHeight="44" />
        </StackPanel>
      </Border>
    </Grid>

    <views:MobileLegalDocumentView x:Name="LegalDocumentHost"
                                   IsVisible="False" />
    <views:MobileUpsellView x:Name="UpsellHost"
                            IsVisible="False" />
  </Grid>
</UserControl>
