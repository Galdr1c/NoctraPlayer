<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             x:Class="Noctra.Mobile.Views.MobileSettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14">
      <StackPanel Spacing="4">
        <TextBlock Text="Settings"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF" />
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="#AEB5C5"
                   FontSize="12"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Border Background="#151923"
              CornerRadius="16"
              Padding="14">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="14">
          <Border Width="64"
                  Height="64"
                  CornerRadius="32"
                  ClipToBounds="True"
                  Background="#8F7CFF">
            <Image Source="{Binding CurrentProfileAvatar, Converter={StaticResource AvatarPathConverter}}"
                   Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1"
                      Spacing="4"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentProfileName}"
                       Foreground="#FFFFFF"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ProfileCreatedAt}"
                       Foreground="#AEB5C5"
                       FontSize="12" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Background="#151923"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="Account"
                     Foreground="#FFFFFF"
                     FontWeight="SemiBold" />
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
            <TextBlock Text="{Binding ProviderUrlLabel}"
                       Foreground="#AEB5C5"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ProviderUrl}"
                       Foreground="#FFFFFF"
                       TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10"
                IsVisible="{Binding ShowProviderIdentity}">
            <TextBlock Text="{Binding ProviderIdentityLabel}"
                       Foreground="#AEB5C5"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ProviderUsername}"
                       Foreground="#FFFFFF"
                       TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10"
                IsVisible="{Binding ShowProviderPassword}">
            <TextBlock Text="Password"
                       Foreground="#AEB5C5"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ProviderPassword}"
                       Foreground="#FFFFFF"
                       TextWrapping="Wrap" />
          </Grid>
          <StackPanel Spacing="3"
                      IsVisible="{Binding ShowProviderExpiration}">
            <TextBlock Text="Expiration"
                       Foreground="#AEB5C5"
                       FontSize="12" />
            <TextBlock Text="{Binding ExpirationDate}"
                       Foreground="#FFFFFF"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding ExpirationStatus}"
                       Foreground="#8F7CFF"
                       FontSize="12" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="#151923"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Text="Appearance"
                     Foreground="#FFFFFF"
                     FontWeight="SemiBold" />
          <CheckBox Content="Dark theme"
                    IsChecked="{Binding IsDarkTheme}" />
          <TextBlock Text="Language"
                     Foreground="#AEB5C5"
                     FontSize="12" />
          <ComboBox SelectedValue="{Binding AppLanguage, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Tag}"
                    MinHeight="44">
            <ComboBoxItem Content="English" Tag="en" />
            <ComboBoxItem Content="Turkish" Tag="tr" />
          </ComboBox>
        </StackPanel>
      </Border>

      <Border Background="#151923"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Text="Playback"
                     Foreground="#FFFFFF"
                     FontWeight="SemiBold" />
          <TextBlock Text="User agent"
                     Foreground="#AEB5C5"
                     FontSize="12" />
          <TextBox Text="{Binding UserAgent, Mode=TwoWay}"
                   PlaceholderText="VLC/3.0.x LibVLC/3.0.x"
                   MinHeight="44" />
          <CheckBox Content="Auto play next episode"
                    IsChecked="{Binding AutoPlayNext}" />
          <TextBlock Text="Streaming quality"
                     Foreground="#AEB5C5"
                     FontSize="12" />
          <ComboBox SelectedIndex="{Binding SelectedDataUsage}"
                    MinHeight="44">
            <ComboBoxItem Content="Low" />
            <ComboBoxItem Content="Medium" />
            <ComboBoxItem Content="High" />
            <ComboBoxItem Content="Auto" />
          </ComboBox>
          <TextBlock Text="Buffer"
                     Foreground="#AEB5C5"
                     FontSize="12" />
          <StackPanel Spacing="4">
            <RadioButton Content="Small"
                         GroupName="MobileBuffer"
                         IsChecked="{Binding IsBufferSmall}" />
            <RadioButton Content="Normal"
                         GroupName="MobileBuffer"
                         IsChecked="{Binding IsBufferNormal}" />
            <RadioButton Content="Large"
                         GroupName="MobileBuffer"
                         IsChecked="{Binding IsBufferLarge}" />
          </StackPanel>
          <CheckBox Content="Save watch history"
                    IsChecked="{Binding SaveWatchHistory}" />
          <CheckBox Content="Clear history on exit"
                    IsChecked="{Binding ClearHistoryOnExit}" />
        </StackPanel>
      </Border>

      <Border Background="#151923"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Text="Audio and subtitles"
                     Foreground="#FFFFFF"
                     FontWeight="SemiBold" />
          <CheckBox Content="Enable subtitles automatically"
                    IsChecked="{Binding SubtitleEnabled}" />
          <TextBlock Text="Preferred subtitle"
                     Foreground="#AEB5C5"
                     FontSize="12" />
          <ComboBox SelectedValue="{Binding SubtitleLanguage, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Tag}"
                    MinHeight="44">
            <ComboBoxItem Content="Turkish" Tag="tr" />
            <ComboBoxItem Content="English" Tag="en" />
            <ComboBoxItem Content="Deutsch" Tag="de" />
            <ComboBoxItem Content="Francais" Tag="fr" />
            <ComboBoxItem Content="Espanol" Tag="es" />
            <ComboBoxItem Content="Italiano" Tag="it" />
            <ComboBoxItem Content="Portugues" Tag="pt" />
          </ComboBox>
          <TextBlock Text="Preferred audio"
                     Foreground="#AEB5C5"
                     FontSize="12" />
          <ComboBox SelectedValue="{Binding PreferredAudioLanguage, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Tag}"
                    MinHeight="44">
            <ComboBoxItem Content="Turkish" Tag="tr" />
            <ComboBoxItem Content="English" Tag="en" />
            <ComboBoxItem Content="Deutsch" Tag="de" />
            <ComboBoxItem Content="Francais" Tag="fr" />
            <ComboBoxItem Content="Espanol" Tag="es" />
            <ComboBoxItem Content="Italiano" Tag="it" />
            <ComboBoxItem Content="Portugues" Tag="pt" />
          </ComboBox>
        </StackPanel>
      </Border>

      <Border Background="#151923"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Text="Downloads"
                     Foreground="#FFFFFF"
                     FontWeight="SemiBold" />
          <CheckBox Content="Download on Wi-Fi only"
                    IsChecked="{Binding DownloadWifiOnly}" />
          <TextBlock Text="Download quality"
                     Foreground="#AEB5C5"
                     FontSize="12" />
          <ComboBox SelectedIndex="{Binding SelectedDownloadQuality}"
                    MinHeight="44">
            <ComboBoxItem Content="Standard" />
            <ComboBoxItem Content="High" />
          </ComboBox>
          <CheckBox Content="Show download notifications"
                    IsChecked="{Binding ShowDownloadNotification}" />
        </StackPanel>
      </Border>

      <Border Background="#151923"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Text="Channels"
                     Foreground="#FFFFFF"
                     FontWeight="SemiBold" />
          <Button Content="Refresh channels now"
                  Command="{Binding RefreshChannelListNowCommand}"
                  MinHeight="44" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Total channels"
                       Foreground="#AEB5C5"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding TotalChannels}"
                       Foreground="#FFFFFF"
                       FontWeight="SemiBold" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Last update"
                       Foreground="#AEB5C5"
                       FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ChannelListLastUpdated}"
                       Foreground="#FFFFFF"
                       FontSize="12" />
          </Grid>
          <TextBlock Text="{Binding ChannelListLastError}"
                     Foreground="#FF6B6B"
                     TextWrapping="Wrap" />
          <TextBlock Text="Refresh frequency"
                     Foreground="#AEB5C5"
                     FontSize="12" />
          <ComboBox SelectedIndex="{Binding ChannelListRefreshFrequencyIndex, Mode=TwoWay}"
                    MinHeight="44">
            <ComboBoxItem Content="Off" />
            <ComboBoxItem Content="1 hour" />
            <ComboBoxItem Content="3 hours" />
            <ComboBoxItem Content="12 hours" />
            <ComboBoxItem Content="24 hours" />
            <ComboBoxItem Content="2 days" />
            <ComboBoxItem Content="3 days" />
            <ComboBoxItem Content="7 days" />
          </ComboBox>
        </StackPanel>
      </Border>

      <Border Background="#151923"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Text="EPG"
                     Foreground="#FFFFFF"
                     FontWeight="SemiBold" />
          <CheckBox Content="Enable EPG"
                    IsChecked="{Binding EpgEnabled}" />
          <Button Content="Refresh EPG now"
                  Command="{Binding RefreshEpgNowCommand}"
                  MinHeight="44" />
          <TextBlock Text="{Binding EpgLastError}"
                     Foreground="#FF6B6B"
                     TextWrapping="Wrap" />
          <TextBlock Text="EPG refresh frequency"
                     Foreground="#AEB5C5"
                     FontSize="12" />
          <ComboBox SelectedIndex="{Binding EpgRefreshFrequencyIndex, Mode=TwoWay}"
                    MinHeight="44">
            <ComboBoxItem Content="Off" />
            <ComboBoxItem Content="1 hour" />
            <ComboBoxItem Content="3 hours" />
            <ComboBoxItem Content="12 hours" />
            <ComboBoxItem Content="24 hours" />
            <ComboBoxItem Content="2 days" />
            <ComboBoxItem Content="3 days" />
            <ComboBoxItem Content="7 days" />
          </ComboBox>
          <TextBlock Text="EPG time offset"
                     Foreground="#AEB5C5"
                     FontSize="12" />
          <ComboBox SelectedIndex="{Binding EpgTimeOffsetIndex, Mode=TwoWay}"
                    MinHeight="44">
            <ComboBoxItem Content="-12" />
            <ComboBoxItem Content="-11" />
            <ComboBoxItem Content="-10" />
            <ComboBoxItem Content="-9" />
            <ComboBoxItem Content="-8" />
            <ComboBoxItem Content="-7" />
            <ComboBoxItem Content="-6" />
            <ComboBoxItem Content="-5" />
            <ComboBoxItem Content="-4" />
            <ComboBoxItem Content="-3" />
            <ComboBoxItem Content="-2" />
            <ComboBoxItem Content="-1" />
            <ComboBoxItem Content="0" />
            <ComboBoxItem Content="+1" />
            <ComboBoxItem Content="+2" />
            <ComboBoxItem Content="+3" />
            <ComboBoxItem Content="+4" />
            <ComboBoxItem Content="+5" />
            <ComboBoxItem Content="+6" />
            <ComboBoxItem Content="+7" />
            <ComboBoxItem Content="+8" />
            <ComboBoxItem Content="+9" />
            <ComboBoxItem Content="+10" />
            <ComboBoxItem Content="+11" />
            <ComboBoxItem Content="+12" />
          </ComboBox>
        </StackPanel>
      </Border>

      <Border Background="#151923"
              CornerRadius="16"
              Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="Privacy"
                     Foreground="#FFFFFF"
                     FontWeight="SemiBold" />
          <Button Content="Clear watch history"
                  Command="{Binding ClearHistoryCommand}"
                  MinHeight="44" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="10"
            Margin="0,0,0,24">
        <Button Content="Reset"
                Command="{Binding ResetToDefaultsCommand}"
                MinHeight="44" />
        <Button Grid.Column="1"
                Content="Save"
                Command="{Binding SaveSettingsCommand}"
                MinHeight="44" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
