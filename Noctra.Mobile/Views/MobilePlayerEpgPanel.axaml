<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:mobileVm="using:Noctra.Mobile.ViewModels"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobilePlayerEpgPanel"
             x:Name="EpgPanelRoot"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False"
             Focusable="True"
             KeyDown="EpgPanel_KeyDown"
             PointerPressed="EpgPanel_PointerPressed">
  <UserControl.Styles>
    <Style Selector="Button.epgIconButton">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.epgIconButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}" />
    </Style>
    <Style Selector="Button.epgIconButton:focus-visible /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource FocusGlow}" />
    </Style>

    <Style Selector="Button.epgChannel">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="4,0,0,4" />
      <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
    <Style Selector="Button.epgChannel.playing">
      <Setter Property="Background" Value="{DynamicResource TextSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Button.epgChannel:pointerover">
      <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}" />
    </Style>
    <Style Selector="Button.epgChannel:focus-visible">
      <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="Button.epgChannel:focus-visible /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource FocusGlow}" />
    </Style>

    <!-- The button owns the touch target; the inner border owns the
         time-accurate visual width. Keeping these separate prevents a short
         EPG segment from covering the next segment on the timeline. -->
    <Style Selector="Button.epgProgramHitTarget">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Height" Value="56" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.epgProgramVisual">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.epgProgramHitTarget.current Border.epgProgramVisual">
      <Setter Property="Background" Value="{DynamicResource PremiumCardBackgroundBrush}" />
    </Style>
    <Style Selector="Button.epgProgramHitTarget.playing Border.epgProgramVisual">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.epgProgramHitTarget.selected Border.epgProgramVisual">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource TextSelectionBrush}" />
    </Style>
    <Style Selector="Button.epgProgramHitTarget.past Border.epgProgramVisual">
      <Setter Property="Opacity" Value="0.58" />
    </Style>
    <Style Selector="Button.epgProgramHitTarget:pointerover Border.epgProgramVisual">
      <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}" />
    </Style>
    <Style Selector="Button.epgProgramHitTarget:pressed Border.epgProgramVisual">
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.epgProgramHitTarget:focus-visible">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="ZIndex" Value="20" />
    </Style>
    <Style Selector="Button.epgProgramHitTarget:focus-visible Border.epgProgramVisual">
      <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="Button.epgProgramHitTarget:focus-visible /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource FocusGlow}" />
    </Style>
    <Style Selector="Button.epgProgramHitTarget:pressed /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="UserControl.remote Button.epgProgramHitTarget">
      <Setter Property="Height" Value="64" />
    </Style>
    <Style Selector="UserControl.remote Button.epgProgramHitTarget Border.epgProgramVisual">
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="UserControl.remote Button.epgIconButton">
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="CornerRadius" Value="28" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="EpgModeRoot"
        RowDefinitions="Auto,*"
        Background="{x:Null}"
        IsVisible="{Binding IsEpgPanelOpen}">
    <Grid x:Name="EpgHeroGrid"
          Grid.Row="0"
          Background="{x:Null}">
      <Border x:Name="VideoSlot"
              Background="{x:Null}"
              ClipToBounds="True">
        <Border VerticalAlignment="Bottom"
                Background="{DynamicResource PlayerOverlayShieldBrush}"
                Padding="14,8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding CurrentChannel.Name}"
                         FontSize="{DynamicResource FBody}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource PlayerOverlayTextBrush}"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1" />
              <TextBlock Text="{Binding CurrentProgram.Title}"
                         FontSize="{DynamicResource FCaption}"
                         Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
              <Button Classes="epgIconButton"
                      Command="{Binding PlayPauseCommand}"
                      Background="Transparent"
                      BorderBrush="Transparent"
                                        AutomationProperties.Name="{loc:Translate Player.Overlay.PlayPause.Tooltip}">
                <Grid>
                  <icons:MaterialIcon Kind="Pause"
                                      Width="22" Height="22"
                                      Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                      IsVisible="{Binding IsPlaying}" />
                  <icons:MaterialIcon Kind="Play"
                                      Width="22" Height="22"
                                      Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                      IsVisible="{Binding !IsPlaying}" />
                </Grid>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Border>

      <Border x:Name="ProgramDetailPanel"
              Padding="18,14"
              Background="{DynamicResource Surface0Brush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Width="56" Height="56"
                  CornerRadius="{DynamicResource RadiusSmall}"
                  Background="{DynamicResource Surface1Brush}"
                  ClipToBounds="True"
                  VerticalAlignment="Top">
            <Grid>
              <controls:RemoteImage Url="{Binding Guide.SelectedChannel.LogoUrl, ElementName=EpgPanelRoot}"
                                    Stretch="Uniform" />
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Guide.SelectedChannelName, ElementName=EpgPanelRoot}"
                         FontSize="{DynamicResource FBody}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1" />
              <Border Classes="AccentBadge"
                      IsVisible="{Binding Guide.SelectedProgram.IsCurrentProgram, ElementName=EpgPanelRoot}">
                <TextBlock Text="{loc:Translate Player.Epg.Live}"
                           FontSize="{DynamicResource FOverline}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Guide.SelectedTitle, ElementName=EpgPanelRoot}"
                       FontSize="{DynamicResource FTitleL}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Guide.SelectedTimeRange, ElementName=EpgPanelRoot}"
                         FontSize="{DynamicResource FCaption}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding Guide.SelectedTimingStatus, ElementName=EpgPanelRoot}"
                         FontSize="{DynamicResource FCaption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding Guide.SelectedCategory, ElementName=EpgPanelRoot}"
                         FontSize="{DynamicResource FCaption}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         IsVisible="{Binding Guide.HasSelectedCategory, ElementName=EpgPanelRoot}" />
            </StackPanel>
            <TextBlock Text="{Binding Guide.SelectedDescription, ElementName=EpgPanelRoot}"
                       FontSize="{DynamicResource FCaption}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="2" />
          </StackPanel>

          <Button x:Name="WatchSelectedButton"
                  Grid.Column="2"
                  Classes="epgIconButton"
                  Click="WatchSelectedButton_Click"
                  IsVisible="{Binding Guide.CanWatchSelectedChannel, ElementName=EpgPanelRoot}"
                  AutomationProperties.Name="{loc:Translate Player.Epg.WatchChannel}"
                  AutomationProperties.HelpText="{loc:Translate Player.Epg.WatchChannelHelp}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:MaterialIcon Kind="Play" Width="20" Height="20"
                                  Foreground="{DynamicResource AccentBrush}" />
              <TextBlock x:Name="WatchSelectedText"
                         Text="{loc:Translate Player.Epg.WatchChannel}"
                         FontSize="{DynamicResource FCaption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="1"
            Background="{DynamicResource Bg0Brush}">
      <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0"
                Padding="14,8"
                Background="{DynamicResource Surface0Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="CalendarClock"
                                  Width="22" Height="22"
                                  Foreground="{DynamicResource AccentBrush}" />
              <StackPanel Spacing="1">
                <TextBlock Text="{loc:Translate Player.Epg.GuideTitle}"
                           FontSize="{DynamicResource FBody}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Guide.DateLabel, ElementName=EpgPanelRoot}"
                           FontSize="{DynamicResource FOverline}"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="epgIconButton"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="NowButton_Click"
                    AutomationProperties.Name="{loc:Translate Player.Epg.NowA11y}"
                    AutomationProperties.HelpText="{loc:Translate Player.Epg.NowHelp}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:MaterialIcon Kind="CrosshairsGps" Width="18" Height="18"
                                    Foreground="{DynamicResource LiveRedBrush}" />
              </StackPanel>
            </Button>
            <Button x:Name="CloseGuideButton"
                    Grid.Column="2"
                    Classes="epgIconButton"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{Binding ToggleEpgPanelCommand}"
                    AutomationProperties.Name="{loc:Translate Common.Close}"
                    AutomationProperties.HelpText="{loc:Translate Player.Epg.CloseHelp}">
              <icons:MaterialIcon Kind="Close"
                                  Width="20" Height="20"
                                  Foreground="{DynamicResource TextPrimaryBrush}" />
            </Button>
          </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="12,8"
                Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                IsVisible="{Binding IsEpgLoading}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ProgressBar IsIndeterminate="True"
                         Width="72" Height="4"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource Surface0Brush}"
                         VerticalAlignment="Center" />
            <TextBlock Text="{loc:Translate Player.Epg.LoadingDescription}"
                       FontSize="{DynamicResource FCaption}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="2">
          <Grid x:Name="GuideGrid"
                ColumnDefinitions="132,*"
                IsVisible="{Binding HasEpgRows}"
                ClipToBounds="True">
            <Grid Grid.Column="0" RowDefinitions="48,*" ClipToBounds="True">
              <Border Background="{DynamicResource Surface1Brush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,0,1,1">
                <TextBlock Text="{loc:Translate Player.Epg.ChannelHeader}"
                           FontSize="{DynamicResource FOverline}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <ListBox x:Name="EpgChannelList"
                       Grid.Row="1"
                       ItemsSource="{Binding Guide.Rows, ElementName=EpgPanelRoot}"
                       SelectionMode="Single"
                       Background="{x:Null}"
                       BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel CacheLength="1.5" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerTheme>
                  <ControlTheme TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  </ControlTheme>
                </ListBox.ItemContainerTheme>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="mobileVm:MobileEpgRow">
                    <Button Classes="epgChannel"
                            Classes.playing="{Binding IsPlayingChannel}"
                            Height="{Binding RowHeight}"
                            Tag="{Binding}"
                            GotFocus="ChannelButton_GotFocus"
                            PointerReleased="ChannelButton_PointerReleased"
                            AutomationProperties.Name="{Binding Channel.Name}"
                            AutomationProperties.HelpText="{loc:Translate Player.Epg.ChannelA11yHelp}">
                      <Grid ColumnDefinitions="32,*" ColumnSpacing="6">
                        <Border Width="30" Height="30"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Background="{DynamicResource Surface1Brush}"
                                ClipToBounds="True"
                                VerticalAlignment="Center">
                          <Grid>
                            <controls:RemoteImage Url="{Binding Channel.LogoUrl}" Stretch="Uniform" />
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Channel.Name}"
                                     FontSize="{DynamicResource FCaption}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextWrapping="Wrap"
                                     TextTrimming="CharacterEllipsis"
                                     MaxLines="2" />
                          <TextBlock Text="{Binding Channel.GroupTitle}"
                                     FontSize="{DynamicResource FOverline}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     TextTrimming="CharacterEllipsis"
                                     MaxLines="1"
                                     IsVisible="{Binding Channel.GroupTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="48,*" ClipToBounds="True">
              <Border Background="{DynamicResource Surface1Brush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,0,0,1">
                <ScrollViewer x:Name="EpgTimeHeaderScroll"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              IsHitTestVisible="False">
                  <Grid Width="{Binding Guide.CanvasWidth, ElementName=EpgPanelRoot}"
                        Height="48">
                    <ItemsControl ItemsSource="{Binding Guide.TimeTicks, ElementName=EpgPanelRoot}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mobileVm:MobileEpgTimeTick">
                          <Grid Width="90"
                                Margin="{Binding Left, Converter={StaticResource DoubleToLeftMarginConverter}}"
                                HorizontalAlignment="Left">
                            <Border Width="1"
                                    Background="{DynamicResource BorderBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch" />
                            <TextBlock Text="{Binding Label}"
                                       Margin="8,0,0,0"
                                       FontSize="{DynamicResource FOverline}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Width="2"
                            Margin="{Binding Guide.NowLineLeft, ElementName=EpgPanelRoot, Converter={StaticResource DoubleToLeftMarginConverter}}"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource LiveRedBrush}"
                            IsVisible="{Binding Guide.IsNowLineVisible, ElementName=EpgPanelRoot}" />
                    <Border Padding="7,3"
                            Margin="{Binding Guide.NowLineLeft, ElementName=EpgPanelRoot, Converter={StaticResource DoubleToLeftMarginConverter}}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            CornerRadius="0,4,4,0"
                            Background="{DynamicResource LiveRedBrush}"
                            IsVisible="{Binding Guide.IsNowLineVisible, ElementName=EpgPanelRoot}">
                      <TextBlock Text="{loc:Translate Player.Epg.Now}"
                                 FontSize="{DynamicResource FOverline}"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource PlayerOverlayTextBrush}" />
                    </Border>
                  </Grid>
                </ScrollViewer>
              </Border>

              <ScrollViewer x:Name="EpgTimelineHorizontalScroll"
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            ScrollChanged="EpgTimelineHorizontalScroll_ScrollChanged">
                <Grid Width="{Binding Guide.CanvasWidth, ElementName=EpgPanelRoot}">
                  <ListBox x:Name="EpgTimelineList"
                           ItemsSource="{Binding Guide.Rows, ElementName=EpgPanelRoot}"
                           SelectionMode="Single"
                           Background="{x:Null}"
                           BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel CacheLength="1.5" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerTheme>
                      <ControlTheme TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      </ControlTheme>
                    </ListBox.ItemContainerTheme>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="mobileVm:MobileEpgRow">
                        <Grid Width="{Binding CanvasWidth}"
                              Height="{Binding RowHeight}"
                              ClipToBounds="True">
                          <Border Background="Transparent"
                                  Opacity="0.26"
                                  IsVisible="{Binding IsPlayingChannel}" />
                          <Border BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="0,0,0,1" />
                          <TextBlock Text="{loc:Translate Player.Epg.NoInfo}"
                                     Margin="12,0,0,0"
                                     FontSize="{DynamicResource FCaption}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding HasPrograms, Converter={StaticResource InverseBoolConverter}}" />
                          <ItemsControl ItemsSource="{Binding Programs}"
                                        IsVisible="{Binding HasPrograms}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="mobileVm:MobileEpgProgramItem">
                                <Button Classes="epgProgramHitTarget"
                                        Classes.current="{Binding IsCurrentProgram}"
                                        Classes.playing="{Binding IsPlayingProgram}"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.past="{Binding IsPast}"
                                        Width="{Binding HitTargetWidth}"
                                        Margin="{Binding Left, Converter={StaticResource DoubleToLeftMarginConverter}}"
                                        Tag="{Binding}"
                                        GotFocus="ProgramButton_GotFocus"
                                        PointerReleased="ProgramButton_PointerReleased"
                                        ToolTip.Tip="{Binding AccessibilityName}"
                                        AutomationProperties.Name="{Binding AccessibilityName}"
                                        AutomationProperties.HelpText="{loc:Translate Player.Epg.ProgramA11yHelp}">
                                  <Border Classes="epgProgramVisual"
                                          Width="{Binding Width}"
                                          ClipToBounds="True">
                                    <Grid>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Program.Title}"
                                                 FontSize="{DynamicResource FCaption}"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 TextTrimming="CharacterEllipsis"
                                                 MaxLines="1" />
                                      <TextBlock Text="{Binding TimeRange}"
                                                 FontSize="{DynamicResource FOverline}"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 TextTrimming="CharacterEllipsis"
                                                 MaxLines="1" />
                                    </StackPanel>
                                    </Grid>
                                  </Border>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Border Width="2"
                          Margin="{Binding Guide.NowLineLeft, ElementName=EpgPanelRoot, Converter={StaticResource DoubleToLeftMarginConverter}}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource LiveRedBrush}"
                          IsVisible="{Binding Guide.IsNowLineVisible, ElementName=EpgPanelRoot}"
                          IsHitTestVisible="False"
                          ZIndex="30" />
                </Grid>
              </ScrollViewer>
            </Grid>
          </Grid>

          <Border Padding="16,10"
                  VerticalAlignment="Top"
                  Background="{DynamicResource Surface1Brush}"
                  BorderBrush="{DynamicResource WarningBrush}"
                  BorderThickness="0,0,0,1"
                  IsVisible="{Binding EpgHasNoProgramData}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <icons:MaterialIcon Kind="InformationOutline"
                                  Width="20" Height="20"
                                  Foreground="{DynamicResource WarningBrush}" />
              <TextBlock Text="{loc:Translate Player.Epg.NoProgramsDescription}"
                         FontSize="{DynamicResource FCaption}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Padding="28"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource Surface0Brush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusLarge}"
                  IsVisible="{Binding IsEpgEmpty}">
            <StackPanel Spacing="10" MaxWidth="420" HorizontalAlignment="Center">
              <icons:MaterialIcon Kind="TelevisionOff"
                                  Width="42" Height="42"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Translate Player.Epg.EmptyTitle}"
                         FontSize="{DynamicResource FTitleL}"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextAlignment="Center" />
              <TextBlock Text="{loc:Translate Player.Epg.EmptyDescription}"
                         FontSize="{DynamicResource FBody}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap"
                         TextAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Padding="18,12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="16"
                  Background="{DynamicResource Surface0Brush}"
                  BorderBrush="{DynamicResource ErrorBrush}"
                  BorderThickness="0"
                  CornerRadius="{DynamicResource RadiusMedium}"
                  IsVisible="{Binding IsEpgError}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MaxWidth="720">
              <icons:MaterialIcon Kind="WifiAlert"
                                  Width="24" Height="24"
                                  Foreground="{DynamicResource ErrorBrush}" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{loc:Translate Player.Epg.ErrorTitle}"
                           FontSize="{DynamicResource FBody}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{loc:Translate Player.Epg.ErrorDescription}"
                           FontSize="{DynamicResource FCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button x:Name="RetryGuideButton"
                      Grid.Column="2"
                      Classes="epgIconButton"
                      Command="{Binding RetryEpgPanelCommand}"
                      AutomationProperties.Name="{loc:Translate Player.Epg.Retry}"
                      AutomationProperties.HelpText="{loc:Translate Player.Epg.RetryHelp}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:MaterialIcon Kind="Refresh" Width="18" Height="18"
                                      Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{loc:Translate Player.Epg.Retry}"
                             FontSize="{DynamicResource FCaption}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
