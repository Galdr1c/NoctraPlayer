<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileMoviesView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <UserControl.Resources>
    <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
  </UserControl.Resources>

  <ScrollViewer x:Name="MoviesScrollViewer"
                ScrollChanged="MoviesScrollViewer_ScrollChanged">
    <StackPanel Margin="20" Spacing="14">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{loc:Translate Movies.Title}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <ComboBox Grid.Column="1"
                  Width="150"
                  ItemsSource="{Binding SortOptions}"
                  SelectedValue="{Binding SelectedSortOrder}"
                  SelectedValueBinding="{Binding Key}"
                  DisplayMemberBinding="{Binding Value}"
                  IsVisible="{Binding ShowContentFilters}" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="8"
            IsVisible="{Binding ShowGroupFilter}">
        <ComboBox Grid.Column="0"
                  ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedGroup}"
                  PlaceholderText="{loc:Translate Common.All}"
                  MinHeight="48"
                  CornerRadius="12" />
        <Button Grid.Column="1"
                MinWidth="48"
                MinHeight="48"
                Padding="12"
                CornerRadius="12"
                Background="{DynamicResource Surface0Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                Command="{Binding HideGroupCommand}"
                CommandParameter="{Binding SelectedGroup}"
                IsVisible="{Binding SelectedGroup, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                ToolTip.Tip="{loc:Translate Live.HideCategory.Tooltip}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <icons:MaterialIcon Kind="EyeOffOutline"
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Translate Live.HideCategory.Tooltip}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="13"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <ItemsControl ItemsSource="{Binding FilteredChannels}"
                    IsVisible="{Binding !IsContentLoading}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Channel">
            <controls:MobileVodCard Margin="0,0,10,10"
                                    MinWidth="150"
                                    MaxWidth="180" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="10"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding IsContentLoading}">
        <controls:PremiumSpinner Width="56" Height="56" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:Translate Movies.Loading}"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>

      <StackPanel Spacing="8"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding ShowEmptyChannels}">
        <TextBlock Text="{loc:Translate Movies.Empty.Title}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Text="{loc:Translate Movies.Empty.Description}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
