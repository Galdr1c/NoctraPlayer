<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileMoviesView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <UserControl.Resources>
    <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
  </UserControl.Resources>

  <ScrollViewer x:Name="MoviesScrollViewer"
                ScrollChanged="MoviesScrollViewer_ScrollChanged">
    <!-- Increase margins and spacing to better emulate desktop layout -->
    <StackPanel Margin="24" Spacing="20">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Desktop-inspired title styling: bold weight and subtle letter spacing -->
        <TextBlock Text="{loc:Translate Movies.Title}"
                   FontSize="24"
                   FontWeight="Bold"
                   LetterSpacing="1"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <ComboBox Grid.Column="1"
                  Width="150"
                  ItemsSource="{Binding SortOptions}"
                  SelectedValue="{Binding SelectedSortOrder}"
                  SelectedValueBinding="{Binding Key}"
                  DisplayMemberBinding="{Binding Value}"
                  IsVisible="{Binding ShowContentFilters}" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="8"
            IsVisible="{Binding ShowGroupFilter}">
        <ComboBox Grid.Column="0"
                  ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedGroup}"
                  PlaceholderText="{loc:Translate Common.All}"
                  MinHeight="48"
                  CornerRadius="12" />
        <Button Grid.Column="1"
                MinWidth="48"
                MinHeight="48"
                Padding="12"
                CornerRadius="12"
                Background="{DynamicResource Surface0Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                Command="{Binding HideGroupCommand}"
                CommandParameter="{Binding SelectedGroup}"
                IsVisible="{Binding SelectedGroup, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                ToolTip.Tip="{loc:Translate Live.HideCategory.Tooltip}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <icons:MaterialIcon Kind="EyeOffOutline"
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Translate Live.HideCategory.Tooltip}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="13"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <ItemsControl ItemsSource="{Binding FilteredChannels}"
                    IsVisible="{Binding !IsContentLoading}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Channel">
            <!-- Increase spacing between cards to match desktop -->
            <controls:MobileVodCard Margin="0,0,16,16"
                                    Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                                    Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Loading state: mirror desktop with two lines of status text -->
      <StackPanel Spacing="16"
                  Margin="0,80,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding IsContentLoading}">
        <controls:PremiumSpinner Width="56" Height="56" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:Translate Movies.Loading}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextAlignment="Center" />
        <TextBlock Text="{loc:Translate Live.LoadingDetail}"
                   FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Opacity="0.6"
                   TextAlignment="Center" />
      </StackPanel>

      <StackPanel Spacing="12"
                  Margin="0,96,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding ShowEmptyChannels}">
        <!-- Add a film icon similar to desktop empty state -->
        <icons:MaterialIcon Kind="Filmstrip"
                            Width="64"
                            Height="64"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Opacity="0.5" />
        <TextBlock Text="{loc:Translate Movies.Empty.Title}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   LetterSpacing="1"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextAlignment="Center" />
        <TextBlock Text="{loc:Translate Movies.Empty.Description}"
                   FontSize="14"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
