<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileMyListView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <UserControl.Resources>
    <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="16">
      <TextBlock Text="{loc:Translate MyList.Title}"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />

      <!-- Live TV -->
      <StackPanel Spacing="8"
                  IsVisible="{Binding MyListLiveChannels.Count, Converter={StaticResource CountToVisibility}}">
        <TextBlock Text="{loc:Translate History.LiveTv}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   FontWeight="Bold"
                   LetterSpacing="1" />
        <ItemsControl ItemsSource="{Binding MyListLiveChannels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                      CommandParameter="{Binding}"
                      Background="{DynamicResource Surface0Brush}"
                      BorderThickness="0"
                      CornerRadius="16"
                      Padding="14"
                      Margin="0,0,0,10"
                      HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="52,*"
                      ColumnSpacing="12">
                  <Border Width="42"
                          Height="42"
                          CornerRadius="10"
                          ClipToBounds="True"
                          Background="{DynamicResource Surface1Brush}">
                    <Grid>
                      <icons:MaterialIcon Kind="Television"
                                          Foreground="{DynamicResource AccentBrush}"
                                          Width="20"
                                          Height="20" />
                      <controls:RemoteImage Url="{Binding CoverUrl}" Stretch="Uniform" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1"
                              Spacing="3"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GroupTitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Series -->
      <StackPanel Spacing="8"
                  IsVisible="{Binding MyListSeriesItems.Count, Converter={StaticResource CountToVisibility}}">
        <TextBlock Text="{loc:Translate History.Series}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   FontWeight="Bold"
                   LetterSpacing="1" />
        <ItemsControl ItemsSource="{Binding MyListSeriesItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Series">
              <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                      CommandParameter="{Binding}"
                      Background="{DynamicResource Surface0Brush}"
                      BorderThickness="0"
                      CornerRadius="16"
                      Padding="14"
                      Margin="0,0,0,10"
                      HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="52,*"
                      ColumnSpacing="12">
                  <Border Width="42"
                          Height="42"
                          CornerRadius="10"
                          ClipToBounds="True"
                          Background="{DynamicResource Surface1Brush}">
                    <Grid>
                      <icons:MaterialIcon Kind="Collections"
                                          Foreground="{DynamicResource AccentBrush}"
                                          Width="20"
                                          Height="20" />
                      <controls:RemoteImage Url="{Binding CoverUrl}" Stretch="Uniform" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1"
                              Spacing="3"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GroupTitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Movies -->
      <StackPanel Spacing="8"
                  IsVisible="{Binding MyListVodChannels.Count, Converter={StaticResource CountToVisibility}}">
        <TextBlock Text="{loc:Translate History.Movies}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   FontWeight="Bold"
                   LetterSpacing="1" />
        <ItemsControl ItemsSource="{Binding MyListVodChannels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                      CommandParameter="{Binding}"
                      Background="{DynamicResource Surface0Brush}"
                      BorderThickness="0"
                      CornerRadius="16"
                      Padding="14"
                      Margin="0,0,0,10"
                      HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="52,*"
                      ColumnSpacing="12">
                  <Border Width="42"
                          Height="42"
                          CornerRadius="10"
                          ClipToBounds="True"
                          Background="{DynamicResource Surface1Brush}">
                    <Grid>
                      <icons:MaterialIcon Kind="Movie"
                                          Foreground="{DynamicResource AccentBrush}"
                                          Width="20"
                                          Height="20" />
                      <controls:RemoteImage Url="{Binding CoverUrl}" Stretch="Uniform" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1"
                              Spacing="3"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GroupTitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Empty State -->
      <StackPanel Spacing="8"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding ShowMyListEmptyState}">
        <TextBlock Text="{loc:Translate MyList.Empty.Title}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Text="{loc:Translate MyList.Empty.Description}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
