<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileMyListView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <UserControl.Resources>
    <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
  </UserControl.Resources>

  <ScrollViewer>
    <!-- Use larger margin and spacing to better mirror the desktop layout -->
    <StackPanel Margin="24" Spacing="20">
      <!-- Page title styled like desktop: bold with slight letter spacing and bottom margin -->
      <TextBlock Text="{loc:Translate MyList.Title}"
                 FontSize="24"
                 FontWeight="Bold"
                 LetterSpacing="1"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Margin="0,0,0,24" />

      <!-- Live TV -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding MyListLiveChannels.Count, Converter={StaticResource CountToVisibility}}">
        <!-- Section header styled like desktop: larger font, semi-bold weight and primary colour -->
        <TextBlock Text="{loc:Translate History.LiveTv}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   LetterSpacing="1" />
        <ItemsControl ItemsSource="{Binding MyListLiveChannels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <controls:MobileLiveTvCard ShowMyListMenu="True" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Series -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding MyListSeriesItems.Count, Converter={StaticResource CountToVisibility}}">
        <!-- Section header styled like desktop: larger font, semi-bold weight and primary colour -->
        <TextBlock Text="{loc:Translate History.Series}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   LetterSpacing="1" />
        <ItemsControl ItemsSource="{Binding MyListSeriesItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Series">
              <controls:MobileSeriesCard Margin="0,0,16,16"
                                         Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                                         Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Movies -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding MyListVodChannels.Count, Converter={StaticResource CountToVisibility}}">
        <!-- Section header styled like desktop: larger font, semi-bold weight and primary colour -->
        <TextBlock Text="{loc:Translate History.Movies}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   LetterSpacing="1" />
        <ItemsControl ItemsSource="{Binding MyListVodChannels}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <controls:MobileVodCard Margin="0,0,16,16"
                                      Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                                      Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Empty State -->
      <StackPanel Spacing="8"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding ShowMyListEmptyState}">
        <!-- Icon matching desktop: bookmark outline -->
        <icons:MaterialIcon Kind="BookmarkOutline"
                            Width="64"
                            Height="64"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Opacity="0.5"
                            HorizontalAlignment="Center" />
        <!-- Empty title styled like desktop: bold and letter‑spaced -->
        <TextBlock Text="{loc:Translate MyList.Empty.Title}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="20"
                   FontWeight="Bold"
                   LetterSpacing="1"
                   TextAlignment="Center"
                   Margin="0,16,0,4" />
        <TextBlock Text="{loc:Translate MyList.Empty.Description}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="14"
                   TextAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
