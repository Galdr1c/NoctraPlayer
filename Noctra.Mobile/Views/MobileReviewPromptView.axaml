<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileReviewPromptView"
             x:CompileBindings="False">

  <UserControl.Styles>
      <Style Selector="Button.ReviewSecondary">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="6"/>
          <Setter Property="Padding" Value="18,10"/>
          <Setter Property="FontSize" Value="14"/>
          <Setter Property="HorizontalContentAlignment" Value="Center"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
      <Style Selector="Button.ReviewLater">
          <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="6"/>
          <Setter Property="Padding" Value="18,10"/>
          <Setter Property="FontSize" Value="14"/>
          <Setter Property="HorizontalContentAlignment" Value="Center"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
  </UserControl.Styles>    

  <!-- Dimmed overlay backdrop — same as MobileUpsellView -->
  <Grid Background="{DynamicResource OverlayDimBrush}">
    <!-- Bottom sheet card -->
    <Border Background="{DynamicResource BackgroundGradientBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="0,1.5,0,0"
            CornerRadius="0"
            Padding="22,20,22,24"
            VerticalAlignment="Bottom"
            BoxShadow="{DynamicResource OverlaySheetShadow}">
      <StackPanel Spacing="18">

        <!-- Header: star icon + title -->
        <StackPanel Orientation="Horizontal"
                    Spacing="12"
                    HorizontalAlignment="Center">
          <Border Background="{DynamicResource NavActiveBackgroundBrush}"
                  BorderBrush="{DynamicResource AccentBrush}"
                  CornerRadius="6"
                  BorderThickness="1"
                  Padding="10">
            <icons:MaterialIcon Kind="StarOutline"
                                Width="24"
                                Height="24"
                                Foreground="{DynamicResource AccentLightBrush}" />
          </Border>
          <TextBlock Text="{loc:Translate ReviewPrompt.Title}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="{DynamicResource FTitleL}"
                     FontWeight="Bold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Message body -->
        <TextBlock Text="{loc:Translate ReviewPrompt.Message.Android}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{DynamicResource FBody}"
                   LineHeight="21"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="4,0" />

        <!-- Rate Now button (primary) -->
        <Grid RowDefinitions="Auto,Auto,Auto"
              RowSpacing="10">
          <Button Grid.Row="0" Classes="ReviewSecondary"
                  MinHeight="50"
                  HorizontalAlignment="Stretch"
                  Click="Rate_Click">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">
              <icons:MaterialIcon Kind="Star"
                                  Width="18"
                                  Height="18"
                                  Foreground="{DynamicResource PlayerOverlayTextBrush}" />
              <TextBlock Text="{loc:Translate ReviewPrompt.Action.Rate}"
                        Foreground="{DynamicResource PlayerOverlayTextBrush}"
                        FontSize="{DynamicResource FBodyL}"
                        FontWeight="Bold" />
            </StackPanel>
          </Button>

          <!-- Later button (secondary) -->
          <Button Grid.Row="1" Classes="ReviewLater"
                  MinHeight="40"
                  HorizontalAlignment="Stretch"
                  Click="Later_Click"
                  Content="{loc:Translate ReviewPrompt.Action.Later}" />

          <!-- Never button (quiet text) -->
          <Button Grid.Row="2" Background="Transparent"
                  BorderThickness="0"
                  CornerRadius="6"
                  Click="Never_Click"
                  HorizontalAlignment="Center">
            <TextBlock Text="{loc:Translate ReviewPrompt.Action.Never}"
                      Foreground="{DynamicResource TextMutedBrush}"
                      FontSize="{DynamicResource FCaption}"
                      FontWeight="SemiBold" />
          </Button>
      </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
