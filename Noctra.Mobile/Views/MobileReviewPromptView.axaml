<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileReviewPromptView"
             x:CompileBindings="False">

  <UserControl.Styles>
      <Style Selector="Button.ReviewSecondary">
          <Setter Property="Background" Value="#FF0000}"/>
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="6"/>
          <Setter Property="Padding" Value="18,10"/>
          <Setter Property="FontSize" Value="14"/>
      </Style>
  </UserControl.Styles>    

  <!-- Dimmed overlay backdrop — same as MobileUpsellView -->
  <Grid Background="{DynamicResource OverlayDimBrush}">
    <!-- Bottom sheet card -->
    <Border Background="{DynamicResource BackgroundGradientBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1.5,0,0"
            CornerRadius="0"
            Padding="22,20,22,24"
            VerticalAlignment="Bottom"
            BoxShadow="{DynamicResource OverlaySheetShadow}">
      <StackPanel Spacing="18">

        <!-- Header: star icon + title -->
        <StackPanel Orientation="Horizontal"
                    Spacing="12"
                    HorizontalAlignment="Center">
          <Border Background="{DynamicResource NavActiveBackgroundBrush}"
                  CornerRadius="6"
                  Padding="10">
            <icons:MaterialIcon Kind="StarOutline"
                                Width="24"
                                Height="24"
                                Foreground="{DynamicResource AccentLightBrush}" />
          </Border>
          <TextBlock Text="{loc:Translate ReviewPrompt.Title}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="20"
                     FontWeight="Bold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Message body -->
        <TextBlock Text="{loc:Translate ReviewPrompt.Message.Android}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="14"
                   LineHeight="21"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="4,0" />

        <!-- Rate Now button (primary) -->
        <Button Classes="SettingsPrimaryActionButton"
                MinHeight="50"
                Click="Rate_Click">
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Spacing="8">
            <icons:MaterialIcon Kind="Star"
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource PlayerOverlayTextBrush}" />
            <TextBlock Text="{loc:Translate ReviewPrompt.Action.Rate}"
                       Foreground="{DynamicResource PlayerOverlayTextBrush}"
                       FontSize="15"
                       FontWeight="Bold" />
          </StackPanel>
        </Button>

        <!-- Later button (secondary) -->
        <Button Classes="ReviewSecondary"
                MinHeight="46"
                Click="Later_Click"
                Content="{loc:Translate ReviewPrompt.Action.Later}" />

        <!-- Never button (quiet text) -->
        <Button Background="Transparent"
                BorderThickness="0"
                Click="Never_Click"
                HorizontalAlignment="Center">
          <TextBlock Text="{loc:Translate ReviewPrompt.Action.Never}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="13"
                     FontWeight="SemiBold" />
        </Button>

      </StackPanel>
    </Border>
  </Grid>
</UserControl>
