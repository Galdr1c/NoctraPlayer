<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:behaviors="using:Noctra.Mobile.Behaviors"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileSeriesDetailView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             IsVisible="{Binding IsSeriesDetailVisible}"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <Border Background="{DynamicResource Bg0Brush}">
    <ScrollViewer>
      <StackPanel Margin="20" Spacing="16">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="12">
          <Button Command="{Binding CloseSeriesDetailCommand}"
                  MinHeight="40"
                  Padding="14,0"
                  Background="{DynamicResource Surface0Brush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderThickness="0"
                  CornerRadius="12">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <icons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
              <TextBlock Text="{loc:Translate Player.Overlay.Back}" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1"
                      Spacing="2"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedSeries.Name}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       MaxLines="2" />
            <TextBlock Text="{loc:Translate Series.Detail.DownloadedEpisodes}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       IsVisible="{Binding IsDownloadedSeriesDetailMode}" />
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        IsVisible="{Binding !IsDownloadedSeriesDetailMode}">
              <TextBlock Text="{Binding SelectedSeriesYears}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="12"
                         IsVisible="{Binding SelectedSeriesYears, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
              <TextBlock Text="{Binding SelectedSeriesGenres}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="12"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="120"
                         IsVisible="{Binding SelectedSeriesGenres, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
              <Border BorderBrush="{DynamicResource TextMutedBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="4,0"
                      IsVisible="{Binding SelectedSeriesAgeRating, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                <TextBlock Text="{Binding SelectedSeriesAgeRating}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10"
                           FontWeight="Bold" />
              </Border>
            </StackPanel>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="118,*"
              ColumnSpacing="14">
          <Border Width="118"
                  Height="174"
                  CornerRadius="16"
                  ClipToBounds="True"
                  Background="{DynamicResource Surface0Brush}">
            <controls:RemoteImage Url="{Binding SelectedSeriesPosterUrl}"
                                  Stretch="UniformToFill" />
          </Border>

          <StackPanel Grid.Column="1"
                      Spacing="8"
                      VerticalAlignment="Top">
            <Border Height="24"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding SelectedSeriesNetworkLogoUrl, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
              <controls:RemoteImage Url="{Binding SelectedSeriesNetworkLogoUrl}"
                                    Stretch="Uniform"
                                    Height="24"
                                    MaxWidth="92" />
            </Border>
            <TextBlock Text="{Binding SelectedSeriesOverview}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Opacity="0.78"
                       FontSize="13"
                       LineHeight="18"
                       TextWrapping="Wrap"
                       MaxLines="7"
                       IsVisible="{Binding SelectedSeriesOverview, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
            <TextBlock Text="{Binding SelectedSeriesCast, Converter={StaticResource StringFormatConverter}, ConverterParameter='Series.Detail.Cast'}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       MaxLines="3"
                       IsVisible="{Binding SelectedSeriesCast, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    IsVisible="{Binding !IsDownloadedSeriesDetailMode}">
          <TextBlock Text="{Binding SelectedSeries.SeasonCountSafe, Converter={StaticResource StringFormatConverter}, ConverterParameter='Series.Seasons.Format'}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <TextBlock Text="{Binding SelectedSeries.TotalEpisodesCount, Converter={StaticResource StringFormatConverter}, ConverterParameter='Series.Episodes.Format'}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    IsVisible="{Binding !IsDownloadedSeriesDetailMode}">
          <Button Command="{Binding PlayEpisodeCommand}"
                  CommandParameter="{Binding SelectedSeriesContinueEpisode}"
                  IsVisible="{Binding HasSelectedSeriesPlayableEpisode}"
                  MinHeight="44"
                  Padding="18,0"
                  Background="{DynamicResource AccentBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderThickness="0"
                  CornerRadius="14">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <icons:MaterialIcon Kind="Play" Width="18" Height="18" />
              <TextBlock Text="{loc:Translate Series.Play}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding PlayEpisodeCommand}"
                  CommandParameter="{Binding SelectedSeriesContinueEpisode}"
                  IsVisible="{Binding HasSelectedSeriesPlayableEpisode}"
                  MinHeight="44"
                  Padding="16,0"
                  Background="{DynamicResource Surface0Brush}"
                  Foreground="{DynamicResource AccentBrush}"
                  BorderThickness="0"
                  CornerRadius="14">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <icons:MaterialIcon Kind="PlayCircleOutline" Width="18" Height="18" />
              <TextBlock Text="{Binding SelectedSeriesContinueText}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding WatchTrailerCommand}"
                  IsVisible="{Binding SelectedSeriesTrailerUrl, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                  MinHeight="44"
                  Padding="16,0"
                  Background="{DynamicResource Surface0Brush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderThickness="0"
                  CornerRadius="14">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <icons:MaterialIcon Kind="Youtube" Width="18" Height="18" />
              <TextBlock Text="{loc:Translate Series.WatchTrailer}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding AddToMyListCommand}"
                  CommandParameter="{Binding SelectedSeries}"
                  MinHeight="44"
                  Padding="16,0"
                  Background="{DynamicResource Surface0Brush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderThickness="0"
                  CornerRadius="14">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <icons:MaterialIcon Kind="BookmarkOutline" Width="18" Height="18" />
              <TextBlock Text="{loc:Translate Context.MyList.Toggle}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding ToggleFavoriteCommand}"
                  CommandParameter="{Binding SelectedSeries}"
                  MinHeight="44"
                  Padding="16,0"
                  Background="{DynamicResource Surface0Brush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderThickness="0"
                  CornerRadius="14">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <icons:MaterialIcon Kind="HeartOutline" Width="18" Height="18" />
              <TextBlock Text="{loc:Translate Context.Favorite.Toggle}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Button Command="{Binding DownloadSelectedSeasonCommand}"
                IsVisible="{Binding !IsDownloadedSeriesDetailMode}"
                HorizontalAlignment="Left"
                MinHeight="40"
                Padding="14,0"
                Background="{DynamicResource Surface0Brush}"
                Foreground="{DynamicResource AccentBrush}"
                BorderThickness="0"
                CornerRadius="12">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <icons:MaterialIcon Kind="DownloadOutline" Width="18" Height="18" />
            <TextBlock Text="{loc:Translate Series.Detail.DownloadSeason}" />
          </StackPanel>
        </Button>

        <StackPanel Spacing="10"
                    Margin="0,36,0,0"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding ShowSelectedSeriesEpisodesLoading}">
          <controls:PremiumSpinner Width="56"
                                   Height="56"
                                   HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Translate Series.Episodes.Loading}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     TextAlignment="Center" />
        </StackPanel>

        <StackPanel Spacing="8"
                    Margin="0,36,0,0"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding ShowSelectedSeriesNoEpisodes}">
          <TextBlock Text="{loc:Translate Series.Episodes.Empty}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextAlignment="Center" />
          <TextBlock Text="{loc:Translate Series.Episodes.EmptyDetail}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
        </StackPanel>

        <ListBox ItemsSource="{Binding SelectedSeries.Seasons}"
                 SelectedItem="{Binding SelectedSeason}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 IsVisible="{Binding SelectedSeries.Seasons.Count, Converter={StaticResource CountToVisibilityConverter}}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:Season">
              <TextBlock Text="{Binding SeasonNumber, Converter={StaticResource StringFormatConverter}, ConverterParameter='Series.Seasons.Format'}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontWeight="SemiBold"
                         Margin="0,0,18,0" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ItemsControl ItemsSource="{Binding SelectedSeason.Episodes}"
                      behaviors:MobileSlideTransitionBehavior.TriggerValue="{Binding SelectedSeason}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Episode">
              <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlayEpisodeCommand}"
                      CommandParameter="{Binding}"
                      Background="{DynamicResource Surface0Brush}"
                      BorderThickness="0"
                      CornerRadius="16"
                      Padding="12"
                      Margin="0,0,0,10"
                      HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="72,*"
                      ColumnSpacing="12">
                  <!-- Thumbnail with Episode Number Overlay -->
                  <Border Width="72"
                          Height="54"
                          CornerRadius="8"
                          ClipToBounds="True"
                          Background="{DynamicResource Surface1Brush}">
                    <Grid>
                      <controls:RemoteImage Url="{Binding CoverUrl}"
                                            Stretch="UniformToFill" />

                      <!-- Play Icon Overlay -->
                      <Border Background="#44000000"
                              IsVisible="{Binding CoverUrl, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                        <icons:MaterialIcon Kind="Play"
                                            Width="28"
                                            Height="28"
                                            Foreground="White"
                                            Opacity="0.95"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                      </Border>

                      <!-- Episode Number Badge (bottom-left) -->
                      <Border VerticalAlignment="Bottom"
                              HorizontalAlignment="Left"
                              Background="#AA000000"
                              CornerRadius="0,8,0,0"
                              Padding="6,3,8,3">
                        <TextBlock Text="{Binding EpisodeNumber}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   LineHeight="13" />
                      </Border>

                      <!-- Progress Bar at Bottom -->
                      <ProgressBar VerticalAlignment="Bottom"
                                   Height="3"
                                   Minimum="0"
                                   Maximum="100"
                                   Value="{Binding WatchedPercentage}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   IsVisible="{Binding WatchedPercentage, Converter={StaticResource CountToVisibilityConverter}}" />
                    </Grid>
                  </Border>

                  <!-- Info -->
                  <StackPanel Grid.Column="1"
                              Spacing="4"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                      <TextBlock Text="{Binding Name}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap"
                                 MaxLines="2" />
                      <!-- Watched Checkmark -->
                      <icons:MaterialIcon Kind="CheckCircle"
                                          Width="16"
                                          Height="16"
                                          Foreground="{DynamicResource AccentBrush}"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding IsCompleted}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Plot}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               IsVisible="{Binding Plot, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
