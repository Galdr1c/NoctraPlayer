<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:shared="using:Noctra.UI.Views"
             x:Class="Noctra.Mobile.Views.MobileHomeView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False">
  <UserControl.Resources>
    <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
  </UserControl.Resources>

  <shared:HomeContentView HasContent="{Binding ContinueWatching.Count, Converter={StaticResource CountToVisibility}}">
    <shared:HomeContentView.ItemsHost>
      <controls:MobileVirtualizingCardGrid x:Name="ContinueWatchingGrid"
                                           SourceItems="{Binding ContinueWatching}"
                                           CardKind="ContinueWatching"
                                           ItemContainerTheme="{StaticResource TransparentListBoxItemTheme}" />
    </shared:HomeContentView.ItemsHost>
    <shared:HomeContentView.EmptyArtwork>
      <Image Source="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LogoThemeConverter}, ConverterParameter=Full}"
             Stretch="Uniform" />
    </shared:HomeContentView.EmptyArtwork>
  </shared:HomeContentView>
</UserControl>
