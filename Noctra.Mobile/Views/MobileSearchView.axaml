<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.UI.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:shared="using:Noctra.UI.Views"
             x:Class="Noctra.Mobile.Views.MobileSearchView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False">
  <shared:AdaptiveSearchView>
    <shared:AdaptiveSearchView.ResultsHost>
      <!-- Virtualization and image decoding stay mobile-specific; search UX is shared. -->
      <controls:MobileSectionedCardFeed x:Name="PrimaryScrollContent"
                                        ItemContainerTheme="{StaticResource TransparentListBoxItemTheme}">
        <controls:MobileSectionedCardFeed.Sections>
          <controls:MobileCardSection Header="{loc:Translate History.LiveTv}"
                                      CardKind="Live"
                                      SourceItems="{Binding SearchLiveChannels}" />
          <controls:MobileCardSection Header="{loc:Translate History.Series}"
                                      CardKind="Series"
                                      SourceItems="{Binding SearchSeriesChannels}" />
          <controls:MobileCardSection Header="{loc:Translate History.Movies}"
                                      CardKind="Vod"
                                      SourceItems="{Binding SearchVodChannels}" />
          <controls:MobileCardSection Header="{loc:Translate History.LiveTv}"
                                      GroupHeader="{loc:Translate Search.SimilarResults}"
                                      CardKind="Live"
                                      SourceItems="{Binding SearchSimilarLiveChannels}" />
          <controls:MobileCardSection Header="{loc:Translate History.Series}"
                                      GroupHeader="{loc:Translate Search.SimilarResults}"
                                      CardKind="Series"
                                      SourceItems="{Binding SearchSimilarSeriesChannels}" />
          <controls:MobileCardSection Header="{loc:Translate History.Movies}"
                                      GroupHeader="{loc:Translate Search.SimilarResults}"
                                      CardKind="Vod"
                                      SourceItems="{Binding SearchSimilarVodChannels}" />
        </controls:MobileSectionedCardFeed.Sections>
      </controls:MobileSectionedCardFeed>
    </shared:AdaptiveSearchView.ResultsHost>
  </shared:AdaptiveSearchView>
</UserControl>
