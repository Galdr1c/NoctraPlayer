<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:models="using:Noctra.Models"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileSearchView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390" d:DesignHeight="720">

  <Grid RowDefinitions="Auto,*">

    <!-- Fixed search input -->
    <Border Grid.Row="0" Padding="20,14,20,12"
            Background="{DynamicResource Bg0Brush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

        <Border Background="{DynamicResource Surface1Brush}"
                CornerRadius="14">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <icons:MaterialIcon Kind="Magnify" Width="18" Height="18"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Margin="14,0,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     x:Name="SearchInput"
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     PlaceholderText="{loc:Translate Search.Placeholder}"
                     Background="Transparent"
                     BorderThickness="0"
                     MinHeight="46"
                     Padding="10,0,10,0"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     KeyDown="SearchInput_KeyDown" />
              <!-- Clear button, visible when text exists -->
            <Button Grid.Column="2"
                    Background="Transparent" BorderThickness="0"
                    Padding="10,0" MinHeight="46"
                    Click="ClearSearch_Click"
                    IsVisible="{Binding SearchQuery,
                                        Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
              <icons:MaterialIcon Kind="Close" Width="16" Height="16"
                                  Foreground="{DynamicResource TextMutedBrush}" />
            </Button>
          </Grid>
        </Border>

        <Button Grid.Column="1"
                Command="{Binding CommitSearchCommand}"
                MinHeight="46" Padding="16,0"
                Background="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                BorderThickness="0" CornerRadius="14"
                FontWeight="Medium" FontSize="14"
                Content="{loc:Translate Search.Button}" />
      </Grid>
    </Border>

    <!-- Scrollable results -->
    <ScrollViewer Grid.Row="1"
                  x:Name="SearchScrollViewer"
                  ScrollChanged="SearchScrollViewer_ScrollChanged">
      <StackPanel Margin="20,4,20,28" Spacing="24">

        <!-- Suggestion strip -->
        <Border Background="{DynamicResource Surface0Brush}"
                CornerRadius="14" Padding="14"
                IsVisible="{Binding SearchSuggestion,
                                    Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
          <StackPanel Spacing="8">
            <TextBlock Text="{loc:Translate Search.DidYouMean}"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
            <Button Content="{Binding SearchSuggestion}"
                    Command="{Binding ApplySearchSuggestionCommand}"
                    MinHeight="42"
                    Background="{DynamicResource Surface1Brush}"
                    Foreground="{DynamicResource AccentBrush}"
                    BorderThickness="0" CornerRadius="10"
                    FontWeight="Medium" FontSize="14" />
          </StackPanel>
        </Border>

        <!-- Result sections -->

        <!-- Live -->
        <StackPanel Spacing="12"
                    IsVisible="{Binding SearchLiveChannels.Count,
                                        Converter={StaticResource CountToVisibilityConverter}}">
          <TextBlock Text="{loc:Translate History.LiveTv}"
                     FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <ItemsControl ItemsSource="{Binding SearchLiveChannels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Channel">
                <controls:MobileLiveTvCard Margin="0,0,12,12"
                    Width="{Binding Bounds.Width,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl},
                                    Converter={StaticResource ResponsiveCardMetricConverter},
                                    ConverterParameter=liveWidth}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Series -->
        <StackPanel Spacing="12"
                    IsVisible="{Binding SearchSeriesChannels.Count,
                                        Converter={StaticResource CountToVisibilityConverter}}">
          <TextBlock Text="{loc:Translate History.Series}"
                     FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <ItemsControl ItemsSource="{Binding SearchSeriesChannels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Series">
                <controls:MobileSeriesCard Margin="0,0,12,12"
                    Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                    Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Movies -->
        <StackPanel Spacing="12"
                    IsVisible="{Binding SearchVodChannels.Count,
                                        Converter={StaticResource CountToVisibilityConverter}}">
          <TextBlock Text="{loc:Translate History.Movies}"
                     FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <ItemsControl ItemsSource="{Binding SearchVodChannels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Channel">
                <controls:MobileVodCard Margin="0,0,12,12"
                    Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                    Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Similar results -->
        <StackPanel Spacing="20" IsVisible="{Binding ShowSearchSimilarSection}">

          <Border Height="1" Background="{DynamicResource BorderBrush}" />

          <TextBlock Text="{loc:Translate Search.SimilarResults}"
                     FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />

          <StackPanel Spacing="12"
                      IsVisible="{Binding SearchSimilarLiveChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <TextBlock Text="{loc:Translate History.LiveTv}"
                       FontSize="15" FontWeight="Medium"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <ItemsControl ItemsSource="{Binding SearchSimilarLiveChannels}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Channel">
                  <controls:MobileLiveTvCard Margin="0,0,12,12"
                      Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=liveWidth}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="12"
                      IsVisible="{Binding SearchSimilarSeriesChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <TextBlock Text="{loc:Translate History.Series}"
                       FontSize="15" FontWeight="Medium"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <ItemsControl ItemsSource="{Binding SearchSimilarSeriesChannels}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Series">
                  <controls:MobileSeriesCard Margin="0,0,12,12"
                      Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                      Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="12"
                      IsVisible="{Binding SearchSimilarVodChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <TextBlock Text="{loc:Translate History.Movies}"
                       FontSize="15" FontWeight="Medium"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <ItemsControl ItemsSource="{Binding SearchSimilarVodChannels}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Channel">
                  <controls:MobileVodCard Margin="0,0,12,12"
                      Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                      Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <!-- Empty state -->
        <StackPanel Spacing="14" Margin="0,100,0,0"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding ShowSearchEmptyState}">
          <icons:MaterialIcon Kind="Magnify" Width="64" Height="64"
                              Foreground="{DynamicResource TextDisabledBrush}"
                              Opacity="0.4" HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Translate Search.Empty.Title}"
                     FontSize="20" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextAlignment="Center" />
          <TextBlock Text="{loc:Translate Search.Empty.Description}"
                     FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                     TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
