<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             x:Class="Noctra.Mobile.Views.MobileSearchView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14">
      <TextBlock Text="Search"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Foreground="#FFFFFF" />

      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                 PlaceholderText="Search channels, movies, series"
                 MinHeight="44" />
        <Button Grid.Column="1"
                Content="Search"
                Command="{Binding CommitSearchCommand}"
                MinHeight="44" />
      </Grid>

      <Border Background="#1FFFFFFF"
              CornerRadius="12"
              Padding="12"
              IsVisible="{Binding SearchSuggestion}">
        <StackPanel Spacing="8">
          <TextBlock Text="Did you mean?"
                     Foreground="#AEB5C5"
                     FontSize="12" />
          <Button Content="{Binding SearchSuggestion}"
                  Command="{Binding ApplySearchSuggestionCommand}"
                  MinHeight="40" />
        </StackPanel>
      </Border>

      <TextBlock Text="Live TV"
                 Foreground="#AEB5C5"
                 FontSize="12"
                 FontWeight="Bold" />
      <ItemsControl ItemsSource="{Binding SearchLiveChannels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Channel">
            <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                    CommandParameter="{Binding}"
                    Background="#151923"
                    BorderThickness="0"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Name}"
                           Foreground="#FFFFFF"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding GroupTitle}"
                           Foreground="#AEB5C5"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Series"
                 Foreground="#AEB5C5"
                 FontSize="12"
                 FontWeight="Bold" />
      <ItemsControl ItemsSource="{Binding SearchSeriesChannels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Series">
            <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                    CommandParameter="{Binding}"
                    Background="#151923"
                    BorderThickness="0"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Name}"
                           Foreground="#FFFFFF"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding GroupTitle}"
                           Foreground="#AEB5C5"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Movies"
                 Foreground="#AEB5C5"
                 FontSize="12"
                 FontWeight="Bold" />
      <ItemsControl ItemsSource="{Binding SearchVodChannels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Channel">
            <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                    CommandParameter="{Binding}"
                    Background="#151923"
                    BorderThickness="0"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Name}"
                           Foreground="#FFFFFF"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding GroupTitle}"
                           Foreground="#AEB5C5"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="8"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding ShowSearchEmptyState}">
        <TextBlock Text="No results"
                   Foreground="#FFFFFF"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Text="Try another search term."
                   Foreground="#AEB5C5"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
