<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileSearchView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <UserControl.Resources>
    <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
    <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
  </UserControl.Resources>

  <ScrollViewer>
    <!-- Increase margins and spacing to better emulate desktop layout -->
    <StackPanel Margin="24" Spacing="20">
      <!-- Desktop-inspired search results header -->
      <TextBlock Text="{loc:Translate Search.Results}"
                 FontSize="24"
                 FontWeight="Bold"
                 LetterSpacing="1"
                 Foreground="{DynamicResource TextPrimaryBrush}" />

      <!-- Search Input -->
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                 PlaceholderText="{loc:Translate Search.Placeholder}"
                 MinHeight="44" />
        <Button Grid.Column="1"
                Content="{loc:Translate Search.Button}"
                Command="{Binding CommitSearchCommand}"
                MinHeight="44"
                Padding="16,0"
                Background="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                BorderThickness="0"
                CornerRadius="12" />
      </Grid>

      <!-- Search Suggestion -->
      <Border Background="{DynamicResource Surface0Brush}"
              CornerRadius="12"
              Padding="14"
              IsVisible="{Binding SearchSuggestion, Converter={StaticResource StringNotEmptyToVisibility}}">
        <StackPanel Spacing="8">
          <TextBlock Text="{loc:Translate Search.DidYouMean}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <Button Content="{Binding SearchSuggestion}"
                  Command="{Binding ApplySearchSuggestionCommand}"
                  MinHeight="44"
                  Background="{DynamicResource Surface1Brush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderThickness="0"
                  CornerRadius="8" />
        </StackPanel>
      </Border>

      <!-- Live Results -->
      <StackPanel Spacing="8"
                  IsVisible="{Binding SearchLiveChannels.Count, Converter={StaticResource CountToVisibility}}">
        <TextBlock Text="{loc:Translate History.LiveTv}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   FontWeight="Bold"
                   LetterSpacing="1" />
        <ItemsControl ItemsSource="{Binding SearchLiveChannels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                      CommandParameter="{Binding}"
                      Background="{DynamicResource Surface0Brush}"
                      BorderThickness="0"
                      CornerRadius="16"
                      Padding="14"
                      Margin="0,0,0,10"
                      HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="52,*,Auto"
                      ColumnSpacing="12">
                  <Border Width="42"
                          Height="42"
                          CornerRadius="10"
                          ClipToBounds="True"
                          Background="{DynamicResource Surface1Brush}">
                    <Grid>
                      <icons:MaterialIcon Kind="Tv"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Width="20"
                                 Height="20" />
                      <controls:RemoteImage Url="{Binding CoverUrl}" Stretch="Uniform" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1"
                              Spacing="3"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GroupTitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="2"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="10"
                          MinWidth="44"
                          MinHeight="44"
                          VerticalAlignment="Center">
                    <Grid>
                      <icons:MaterialIcon Kind="Heart"
                                          Width="20"
                                          Height="20"
                                          Foreground="#E50914"
                                          IsVisible="{Binding IsFavorite}" />
                      <icons:MaterialIcon Kind="HeartOutline"
                                          Width="20"
                                          Height="20"
                                          Foreground="{DynamicResource TextMutedBrush}"
                                          IsVisible="{Binding !IsFavorite}" />
                    </Grid>
                  </Button>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Series Results -->
      <StackPanel Spacing="8"
                  IsVisible="{Binding SearchSeriesChannels.Count, Converter={StaticResource CountToVisibility}}">
        <TextBlock Text="{loc:Translate History.Series}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   FontWeight="Bold"
                   LetterSpacing="1" />
        <ItemsControl ItemsSource="{Binding SearchSeriesChannels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Series">
              <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                      CommandParameter="{Binding}"
                      Background="{DynamicResource Surface0Brush}"
                      BorderThickness="0"
                      CornerRadius="16"
                      Padding="14"
                      Margin="0,0,0,10"
                      HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="52,*,Auto,Auto"
                      ColumnSpacing="12">
                  <Border Width="42"
                          Height="42"
                          CornerRadius="10"
                          ClipToBounds="True"
                          Background="{DynamicResource Surface1Brush}">
                    <Grid>
                      <icons:MaterialIcon Kind="Collections"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Width="20"
                                 Height="20" />
                      <controls:RemoteImage Url="{Binding CoverUrl}" Stretch="Uniform" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1"
                              Spacing="3"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GroupTitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="2"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AddToMyListCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="10"
                          MinWidth="44"
                          MinHeight="44"
                          VerticalAlignment="Center">
                    <Grid>
                      <icons:MaterialIcon Kind="BookmarkCheck"
                                          Width="20"
                                          Height="20"
                                          Foreground="{DynamicResource AccentBrush}"
                                          IsVisible="{Binding IsInMyList}" />
                      <icons:MaterialIcon Kind="BookmarkPlusOutline"
                                          Width="20"
                                          Height="20"
                                          Foreground="{DynamicResource TextMutedBrush}"
                                          IsVisible="{Binding !IsInMyList}" />
                    </Grid>
                  </Button>
                  <Button Grid.Column="3"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="10"
                          MinWidth="44"
                          MinHeight="44"
                          VerticalAlignment="Center">
                    <Grid>
                      <icons:MaterialIcon Kind="Heart"
                                          Width="20"
                                          Height="20"
                                          Foreground="#E50914"
                                          IsVisible="{Binding IsFavorite}" />
                      <icons:MaterialIcon Kind="HeartOutline"
                                          Width="20"
                                          Height="20"
                                          Foreground="{DynamicResource TextMutedBrush}"
                                          IsVisible="{Binding !IsFavorite}" />
                    </Grid>
                  </Button>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- VOD Results -->
      <StackPanel Spacing="8"
                  IsVisible="{Binding SearchVodChannels.Count, Converter={StaticResource CountToVisibility}}">
        <TextBlock Text="{loc:Translate History.Movies}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   FontWeight="Bold"
                   LetterSpacing="1" />
        <ItemsControl ItemsSource="{Binding SearchVodChannels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                      CommandParameter="{Binding}"
                      Background="{DynamicResource Surface0Brush}"
                      BorderThickness="0"
                      CornerRadius="16"
                      Padding="14"
                      Margin="0,0,0,10"
                      HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="52,*,Auto,Auto"
                      ColumnSpacing="12">
                  <Border Width="42"
                          Height="42"
                          CornerRadius="10"
                          ClipToBounds="True"
                          Background="{DynamicResource Surface1Brush}">
                    <Grid>
                      <icons:MaterialIcon Kind="Movie"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Width="20"
                                 Height="20" />
                      <controls:RemoteImage Url="{Binding CoverUrl}" Stretch="Uniform" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1"
                              Spacing="3"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GroupTitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="2"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AddToMyListCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="10"
                          MinWidth="44"
                          MinHeight="44"
                          VerticalAlignment="Center">
                    <Grid>
                      <icons:MaterialIcon Kind="BookmarkCheck"
                                          Width="20"
                                          Height="20"
                                          Foreground="{DynamicResource AccentBrush}"
                                          IsVisible="{Binding IsInMyList}" />
                      <icons:MaterialIcon Kind="BookmarkPlusOutline"
                                          Width="20"
                                          Height="20"
                                          Foreground="{DynamicResource TextMutedBrush}"
                                          IsVisible="{Binding !IsInMyList}" />
                    </Grid>
                  </Button>
                  <Button Grid.Column="3"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="10"
                          MinWidth="44"
                          MinHeight="44"
                          VerticalAlignment="Center">
                    <Grid>
                      <icons:MaterialIcon Kind="Heart"
                                          Width="20"
                                          Height="20"
                                          Foreground="#E50914"
                                          IsVisible="{Binding IsFavorite}" />
                      <icons:MaterialIcon Kind="HeartOutline"
                                          Width="20"
                                          Height="20"
                                          Foreground="{DynamicResource TextMutedBrush}"
                                          IsVisible="{Binding !IsFavorite}" />
                    </Grid>
                  </Button>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Similar Results Section -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding ShowSearchSimilarSection}">
        <TextBlock Text="{loc:Translate Search.SimilarResults}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <!-- Similar Live -->
        <StackPanel Spacing="8"
                    IsVisible="{Binding SearchSimilarLiveChannels.Count, Converter={StaticResource CountToVisibility}}">
          <TextBlock Text="{loc:Translate History.LiveTv}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12"
                     FontWeight="Bold" />
          <ItemsControl ItemsSource="{Binding SearchSimilarLiveChannels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Channel">
                <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                        CommandParameter="{Binding}"
                        Background="{DynamicResource Surface0Brush}"
                        BorderThickness="0"
                        CornerRadius="14"
                        Padding="12"
                        Margin="0,0,0,8"
                        HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GroupTitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Similar Series -->
        <StackPanel Spacing="8"
                    IsVisible="{Binding SearchSimilarSeriesChannels.Count, Converter={StaticResource CountToVisibility}}">
          <TextBlock Text="{loc:Translate History.Series}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12"
                     FontWeight="Bold" />
          <ItemsControl ItemsSource="{Binding SearchSimilarSeriesChannels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Series">
                <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                        CommandParameter="{Binding}"
                        Background="{DynamicResource Surface0Brush}"
                        BorderThickness="0"
                        CornerRadius="14"
                        Padding="12"
                        Margin="0,0,0,8"
                        HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GroupTitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Similar VOD -->
        <StackPanel Spacing="8"
                    IsVisible="{Binding SearchSimilarVodChannels.Count, Converter={StaticResource CountToVisibility}}">
          <TextBlock Text="{loc:Translate History.Movies}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12"
                     FontWeight="Bold" />
          <ItemsControl ItemsSource="{Binding SearchSimilarVodChannels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Channel">
                <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                        CommandParameter="{Binding}"
                        Background="{DynamicResource Surface0Brush}"
                        BorderThickness="0"
                        CornerRadius="14"
                        Padding="12"
                        Margin="0,0,0,8"
                        HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GroupTitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>

      <!-- Empty State -->
      <StackPanel Spacing="8"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding ShowSearchEmptyState}">
        <TextBlock Text="{loc:Translate Search.Empty.Title}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Text="{loc:Translate Search.Empty.Description}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
