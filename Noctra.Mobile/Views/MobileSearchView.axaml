<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:models="using:Noctra.Models"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileSearchView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0"
            Padding="20,14,20,12"
            Background="{DynamicResource Bg0Brush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <Border Background="{DynamicResource Surface1Brush}"
                CornerRadius="14">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <icons:MaterialIcon Kind="Magnify"
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     x:Name="SearchInput"
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     PlaceholderText="{loc:Translate Search.Placeholder}"
                     Background="Transparent"
                     BorderThickness="0"
                     MinHeight="46"
                     Padding="10,0"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     KeyDown="SearchInput_KeyDown" />
            <Button Grid.Column="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="10,0"
                    MinHeight="46"
                    Click="ClearSearch_Click"
                    IsVisible="{Binding SearchQuery, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
              <icons:MaterialIcon Kind="Close"
                                  Width="16"
                                  Height="16"
                                  Foreground="{DynamicResource TextMutedBrush}" />
            </Button>
          </Grid>
        </Border>
        <Button Grid.Column="1"
                Command="{Binding CommitSearchCommand}"
                MinHeight="46"
                Padding="16,0"
                Background="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                BorderThickness="0"
                CornerRadius="14"
                FontWeight="Medium"
                FontSize="14"
                Content="{loc:Translate Search.Button}" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Margin="20,0,20,10"
            Background="{DynamicResource Surface0Brush}"
            CornerRadius="14"
            Padding="14"
            IsVisible="{Binding SearchSuggestion, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <TextBlock Text="{loc:Translate Search.DidYouMean}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Content="{Binding SearchSuggestion}"
                Command="{Binding ApplySearchSuggestionCommand}"
                MinHeight="40"
                Background="{DynamicResource Surface1Brush}"
                Foreground="{DynamicResource AccentBrush}"
                BorderThickness="0"
                CornerRadius="10"
                FontWeight="Medium"
                FontSize="14" />
      </Grid>
    </Border>

    <TabControl Grid.Row="2"
                Margin="20,0"
                IsVisible="{Binding ShowSearchEmptyState, Converter={StaticResource InverseBoolConverter}}">
      <TabItem Header="{loc:Translate History.LiveTv}"
               IsVisible="{Binding SearchLiveChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
        <controls:VirtualizedResponsiveGrid ItemsSource="{Binding SearchLiveChannels}"
                                            MinItemWidth="280"
                                            MaxColumns="3"
                                            ItemSpacing="16"
                                            ScrollChanged="SearchScrollViewer_ScrollChanged">
          <controls:VirtualizedResponsiveGrid.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <controls:MobileLiveTvCard
                  Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=liveWidth}" />
            </DataTemplate>
          </controls:VirtualizedResponsiveGrid.ItemTemplate>
        </controls:VirtualizedResponsiveGrid>
      </TabItem>

      <TabItem Header="{loc:Translate History.Series}"
               IsVisible="{Binding SearchSeriesChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
        <controls:VirtualizedResponsiveGrid ItemsSource="{Binding SearchSeriesChannels}"
                                            MinItemWidth="150"
                                            MaxColumns="6"
                                            ItemSpacing="16"
                                            ScrollChanged="SearchScrollViewer_ScrollChanged">
          <controls:VirtualizedResponsiveGrid.ItemTemplate>
            <DataTemplate x:DataType="models:Series">
              <controls:MobileSeriesCard
                  Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                  Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
            </DataTemplate>
          </controls:VirtualizedResponsiveGrid.ItemTemplate>
        </controls:VirtualizedResponsiveGrid>
      </TabItem>

      <TabItem Header="{loc:Translate History.Movies}"
               IsVisible="{Binding SearchVodChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
        <controls:VirtualizedResponsiveGrid ItemsSource="{Binding SearchVodChannels}"
                                            MinItemWidth="150"
                                            MaxColumns="6"
                                            ItemSpacing="16"
                                            ScrollChanged="SearchScrollViewer_ScrollChanged">
          <controls:VirtualizedResponsiveGrid.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <controls:MobileVodCard
                  Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                  Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
            </DataTemplate>
          </controls:VirtualizedResponsiveGrid.ItemTemplate>
        </controls:VirtualizedResponsiveGrid>
      </TabItem>
    </TabControl>

    <controls:MobileEmptyStateView Grid.Row="2"
                                   Margin="20"
                                   IsVisible="{Binding ShowSearchEmptyState}"
                                   IconKind="Magnify"
                                   Title="{loc:Translate Search.Empty.Title}"
                                   Description="{loc:Translate Search.Empty.Description}" />

    <Expander Grid.Row="3"
              Margin="20,8,20,16"
              Header="{loc:Translate Search.SimilarResults}"
              IsVisible="{Binding ShowSearchSimilarSection}">
      <TabControl Height="280">
        <TabItem Header="{loc:Translate History.LiveTv}"
                 IsVisible="{Binding SearchSimilarLiveChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
          <controls:VirtualizedResponsiveGrid ItemsSource="{Binding SearchSimilarLiveChannels}"
                                              MinItemWidth="280"
                                              MaxColumns="3"
                                              ItemSpacing="16"
                                              ScrollChanged="SearchScrollViewer_ScrollChanged">
            <controls:VirtualizedResponsiveGrid.ItemTemplate>
              <DataTemplate x:DataType="models:Channel">
                <controls:MobileLiveTvCard
                    Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=liveWidth}" />
              </DataTemplate>
            </controls:VirtualizedResponsiveGrid.ItemTemplate>
          </controls:VirtualizedResponsiveGrid>
        </TabItem>
        <TabItem Header="{loc:Translate History.Series}"
                 IsVisible="{Binding SearchSimilarSeriesChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
          <controls:VirtualizedResponsiveGrid ItemsSource="{Binding SearchSimilarSeriesChannels}"
                                              MinItemWidth="150"
                                              MaxColumns="6"
                                              ItemSpacing="16"
                                              ScrollChanged="SearchScrollViewer_ScrollChanged">
            <controls:VirtualizedResponsiveGrid.ItemTemplate>
              <DataTemplate x:DataType="models:Series">
                <controls:MobileSeriesCard
                    Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                    Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
              </DataTemplate>
            </controls:VirtualizedResponsiveGrid.ItemTemplate>
          </controls:VirtualizedResponsiveGrid>
        </TabItem>
        <TabItem Header="{loc:Translate History.Movies}"
                 IsVisible="{Binding SearchSimilarVodChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
          <controls:VirtualizedResponsiveGrid ItemsSource="{Binding SearchSimilarVodChannels}"
                                              MinItemWidth="150"
                                              MaxColumns="6"
                                              ItemSpacing="16"
                                              ScrollChanged="SearchScrollViewer_ScrollChanged">
            <controls:VirtualizedResponsiveGrid.ItemTemplate>
              <DataTemplate x:DataType="models:Channel">
                <controls:MobileVodCard
                    Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                    Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
              </DataTemplate>
            </controls:VirtualizedResponsiveGrid.ItemTemplate>
          </controls:VirtualizedResponsiveGrid>
        </TabItem>
      </TabControl>
    </Expander>
  </Grid>
</UserControl>
