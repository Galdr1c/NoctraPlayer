<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileSearchView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d">

  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Padding="20,14,20,12"
            Background="{DynamicResource Bg0Brush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <Border Background="{DynamicResource Surface1Brush}" BorderThickness="1.5" MinHeight="54" CornerRadius="8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <icons:MaterialIcon Kind="Magnify" Width="18" Height="18"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Margin="14,0,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="SearchInput"
                     Classes="search"
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     TextInputOptions.ReturnKeyType="Search"
                     PlaceholderText="{loc:Translate Search.Placeholder}"
                     VerticalContentAlignment="Center"
                     KeyDown="SearchInput_KeyDown" />
            <Button Grid.Column="2"
                    Background="Transparent" BorderThickness="0"
                    Padding="5" MinHeight="28"
                    Margin="5,0"
                    Click="ClearSearch_Click"
                    IsVisible="{Binding SearchQuery, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
              <icons:MaterialIcon Kind="Close" Width="16" Height="16"
                                  Foreground="{DynamicResource TextMutedBrush}" />
            </Button>
          </Grid>
        </Border>

        <Button Grid.Column="1"
                Command="{Binding CommitSearchCommand}"
                MinHeight="54" Padding="18,0"
                Background="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource PremiumBadgeTextBrush}"
                BorderThickness="0" FontWeight="Medium"
                FontSize="{DynamicResource FBody}" CornerRadius="8"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                Content="{loc:Translate Search.Button}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="20,0,20,4"
            Background="{DynamicResource Surface0Brush}"
            CornerRadius="8" Padding="14"
            IsVisible="{Binding SearchSuggestion, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
      <StackPanel Spacing="8">
        <TextBlock Text="{loc:Translate Search.DidYouMean}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="{DynamicResource FCaption}" />
        <Button Content="{Binding SearchSuggestion}"
                Command="{Binding ApplySearchSuggestionCommand}"
                MinHeight="42"
                Background="{DynamicResource Surface1Brush}"
                Foreground="{DynamicResource AccentBrush}"
                BorderThickness="0" CornerRadius="8"
                FontWeight="Medium" FontSize="{DynamicResource FBody}" />
      </StackPanel>
    </Border>

    <controls:MobileSectionedCardFeed Grid.Row="2"
        Margin="20,0,20,0"
        ScrollChanged="SearchScrollViewer_ScrollChanged"
        ItemContainerTheme="{StaticResource TransparentListBoxItemTheme}">
      <controls:MobileSectionedCardFeed.Sections>
        <controls:MobileCardSection Header="{loc:Translate History.LiveTv}"
            CardKind="Live" SourceItems="{Binding SearchLiveChannels}" />
        <controls:MobileCardSection Header="{loc:Translate History.Series}"
            CardKind="Series" SourceItems="{Binding SearchSeriesChannels}" />
        <controls:MobileCardSection Header="{loc:Translate History.Movies}"
            CardKind="Vod" SourceItems="{Binding SearchVodChannels}" />
        <controls:MobileCardSection Header="{loc:Translate History.LiveTv}"
            GroupHeader="{loc:Translate Search.SimilarResults}"
            CardKind="Live" SourceItems="{Binding SearchSimilarLiveChannels}" />
        <controls:MobileCardSection Header="{loc:Translate History.Series}"
            GroupHeader="{loc:Translate Search.SimilarResults}"
            CardKind="Series" SourceItems="{Binding SearchSimilarSeriesChannels}" />
        <controls:MobileCardSection Header="{loc:Translate History.Movies}"
            GroupHeader="{loc:Translate Search.SimilarResults}"
            CardKind="Vod" SourceItems="{Binding SearchSimilarVodChannels}" />
      </controls:MobileSectionedCardFeed.Sections>
    </controls:MobileSectionedCardFeed>

    <controls:MobileEmptyStateView Grid.Row="2" Margin="20"
        IsVisible="{Binding ShowSearchEmptyState}"
        IconKind="Magnify"
        Title="{loc:Translate Search.Empty.Title}"
        Description="{loc:Translate Search.Empty.Description}" />
  </Grid>
</UserControl>
