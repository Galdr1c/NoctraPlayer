<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:loc="using:Noctra.Mobile.Localization"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.Views.MobileSearchView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="720">
  <UserControl.Resources>
    <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
    <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
    <converters:ResponsiveCardMetricConverter x:Key="ResponsiveCardMetricConverter" />
  </UserControl.Resources>

  <ScrollViewer x:Name="SearchScrollViewer"
                ScrollChanged="SearchScrollViewer_ScrollChanged">
    <!-- Increase margins and spacing to better emulate desktop layout -->
    <StackPanel Margin="24" Spacing="20">
      <!-- Desktop-inspired search results header -->
      <TextBlock Text="{loc:Translate Search.Results}"
                 FontSize="24"
                 FontWeight="Bold"
                 LetterSpacing="1"
                 Foreground="{DynamicResource TextPrimaryBrush}" />

      <!-- Search Input -->
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <TextBox x:Name="SearchInput"
                 Text="{Binding SearchQuery, Mode=TwoWay}"
                 PlaceholderText="{loc:Translate Search.Placeholder}"
                 MinHeight="44"
                 KeyDown="SearchInput_KeyDown" />
        <Button Grid.Column="1"
                Content="{loc:Translate Search.Button}"
                Command="{Binding CommitSearchCommand}"
                MinHeight="44"
                Padding="16,0"
                Background="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                BorderThickness="0"
                CornerRadius="12" />
      </Grid>

      <!-- Search Suggestion -->
      <Border Background="{DynamicResource Surface0Brush}"
              CornerRadius="12"
              Padding="14"
              IsVisible="{Binding SearchSuggestion, Converter={StaticResource StringNotEmptyToVisibility}}">
        <StackPanel Spacing="8">
          <TextBlock Text="{loc:Translate Search.DidYouMean}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <Button Content="{Binding SearchSuggestion}"
                  Command="{Binding ApplySearchSuggestionCommand}"
                  MinHeight="44"
                  Background="{DynamicResource Surface1Brush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderThickness="0"
                  CornerRadius="8" />
        </StackPanel>
      </Border>

      <!-- Live Results -->
      <StackPanel Spacing="8"
                  IsVisible="{Binding SearchLiveChannels.Count, Converter={StaticResource CountToVisibility}}">
        <TextBlock Text="{loc:Translate History.LiveTv}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   LetterSpacing="1" />
        <ItemsControl ItemsSource="{Binding SearchLiveChannels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <controls:MobileLiveTvCard />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Series Results -->
      <StackPanel Spacing="8"
                  IsVisible="{Binding SearchSeriesChannels.Count, Converter={StaticResource CountToVisibility}}">
        <TextBlock Text="{loc:Translate History.Series}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   LetterSpacing="1" />
        <ItemsControl ItemsSource="{Binding SearchSeriesChannels}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Series">
              <controls:MobileSeriesCard Margin="0,0,16,16"
                                         Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                                         Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- VOD Results -->
      <StackPanel Spacing="8"
                  IsVisible="{Binding SearchVodChannels.Count, Converter={StaticResource CountToVisibility}}">
        <TextBlock Text="{loc:Translate History.Movies}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   LetterSpacing="1" />
        <ItemsControl ItemsSource="{Binding SearchVodChannels}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Channel">
              <controls:MobileVodCard Margin="0,0,16,16"
                                      Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                                      Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Similar Results Section -->
      <StackPanel Spacing="12"
                  IsVisible="{Binding ShowSearchSimilarSection}">
        <TextBlock Text="{loc:Translate Search.SimilarResults}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <!-- Similar Live -->
        <StackPanel Spacing="8"
                    IsVisible="{Binding SearchSimilarLiveChannels.Count, Converter={StaticResource CountToVisibility}}">
          <TextBlock Text="{loc:Translate History.LiveTv}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     LetterSpacing="1" />
          <ItemsControl ItemsSource="{Binding SearchSimilarLiveChannels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Channel">
                <controls:MobileLiveTvCard />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Similar Series -->
        <StackPanel Spacing="8"
                    IsVisible="{Binding SearchSimilarSeriesChannels.Count, Converter={StaticResource CountToVisibility}}">
          <TextBlock Text="{loc:Translate History.Series}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     LetterSpacing="1" />
          <ItemsControl ItemsSource="{Binding SearchSimilarSeriesChannels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Series">
                <controls:MobileSeriesCard Margin="0,0,16,16"
                                           Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                                           Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Similar VOD -->
        <StackPanel Spacing="8"
                    IsVisible="{Binding SearchSimilarVodChannels.Count, Converter={StaticResource CountToVisibility}}">
          <TextBlock Text="{loc:Translate History.Movies}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     LetterSpacing="1" />
          <ItemsControl ItemsSource="{Binding SearchSimilarVodChannels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Channel">
                <controls:MobileVodCard Margin="0,0,16,16"
                                        Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterWidth}"
                                        Height="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardMetricConverter}, ConverterParameter=posterHeight}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>

      <!-- Empty State -->
      <StackPanel Spacing="8"
                  Margin="0,60,0,0"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding ShowSearchEmptyState}">
        <icons:MaterialIcon Kind="Magnify"
                            Width="64"
                            Height="64"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Opacity="0.5"
                            HorizontalAlignment="Center" />
        <TextBlock Text="{loc:Translate Search.Empty.Title}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Text="{loc:Translate Search.Empty.Description}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
