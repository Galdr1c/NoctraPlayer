<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:controls="using:Noctra.Mobile.Controls"
             x:Class="Noctra.Mobile.Views.ProfileLoadingView"
             x:DataType="vm:ProfileLoadingViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="844"
             Background="{DynamicResource Bg0Brush}">

  <!--
    ╔══════════════════════════════════════════════════════╗
    ║  Profil Yükleme Ekranı — Netflix tarzı tam ekran    ║
    ║                                                      ║
    ║  Üst:   Pulsing logo (PremiumSpinner içinde)         ║
    ║  Orta:  Profil avatar + ad                           ║
    ║  Alt:   Durum mesajı, uyarı şeridi                   ║
    ╚══════════════════════════════════════════════════════╝
  -->
  <Grid RowDefinitions="*,Auto,Auto,*" Margin="32">

    <!-- ── Boş üst dolgu ── -->
    <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" IsVisible="False" />

    <!-- ── Merkez: Spinner + Logo animasyonu ── -->
    <StackPanel Grid.Row="1"
                HorizontalAlignment="Center"
                Spacing="0">

      <!-- PremiumSpinner içinde aktif profil avatarı -->
      <controls:PremiumSpinner Width="90" Height="90"
                               HorizontalAlignment="Center">
        <Border Width="54" Height="54"
                CornerRadius="12"
                ClipToBounds="True"
                Background="{DynamicResource Surface1Brush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Image Source="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}"
                 Stretch="UniformToFill" />
        </Border>
      </controls:PremiumSpinner>

      <!-- Profil bilgisi (avatar + ad) -->
      <StackPanel HorizontalAlignment="Center"
                  Spacing="16"
                  Margin="0,40,0,0">

        <!-- Profil adı -->
        <TextBlock Text="{Binding ProfileName}"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextAlignment="Center"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <!-- ── Durum mesajı ve uyarı ── -->
    <StackPanel Grid.Row="2"
                HorizontalAlignment="Center"
                Spacing="14"
                Margin="0,28,0,0"
                MaxWidth="320">

      <!-- Durum metni (normal / hata) -->
      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="14"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Center"
                 Tag="{Binding IsError}">
        <TextBlock.Styles>
          <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
          </Style>
          <Style Selector="TextBlock[Tag=True]">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
        </TextBlock.Styles>
      </TextBlock>

      <!-- Uyarı şeridi (sarı) -->
      <Border Background="#1AFFA500"
              BorderBrush="#80FFA500"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14,10"
              IsVisible="{Binding LoadingWarningMessage,
                                  Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="⚠"
                     FontSize="15"
                     Foreground="#FFA500"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding LoadingWarningMessage}"
                     Foreground="#FFA500"
                     FontSize="13"
                     TextAlignment="Left"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Aktif import iÅŸi: büyük listelerde kullanıcıya veri akışını gösterir -->
      <Border Background="{DynamicResource Surface1Brush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="14,12"
              IsVisible="{Binding HasActiveImportJob}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding ActiveImportJobStage}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />

          <UniformGrid Columns="4" HorizontalAlignment="Stretch">
            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <TextBlock Text="{Binding ActiveImportJobLiveCount}"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Live"
                         FontSize="10"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <TextBlock Text="{Binding ActiveImportJobVodCount}"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="VOD"
                         FontSize="10"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <TextBlock Text="{Binding ActiveImportJobSeriesCount}"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Series"
                         FontSize="10"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Spacing="2" HorizontalAlignment="Center"
                        IsVisible="{Binding ActiveImportJobFailedCategoryCount,
                                            Converter={StaticResource CountToVisibilityConverter}}">
              <TextBlock Text="{Binding ActiveImportJobFailedCategoryCount}"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="{DynamicResource WarningBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Failed"
                         FontSize="10"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ── Boş alt dolgu ── -->
    <Border Grid.Row="3" />
  </Grid>

</UserControl>
