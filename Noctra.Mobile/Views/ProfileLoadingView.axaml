<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             x:Class="Noctra.Mobile.Views.ProfileLoadingView"
             x:DataType="vm:ProfileLoadingViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="420">
  <Border Background="#151923"
          CornerRadius="20"
          Padding="24"
          MaxWidth="360"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="16"
                HorizontalAlignment="Center">
      <ProgressBar IsIndeterminate="{Binding IsIndeterminate}"
                   Width="220"
                   Height="8"
                   Foreground="#8F7CFF" />
      <TextBlock Text="Noctra"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="#FFFFFF"
                 HorizontalAlignment="Center" />
      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="#AEB5C5"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="300"
                 Tag="{Binding IsError}" />
      <Border Background="#1AFFA500"
              BorderBrush="#80FFA500"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12,8"
              IsVisible="{Binding LoadingWarningMessage}">
        <TextBlock Text="{Binding LoadingWarningMessage}"
                   Foreground="#FFA500"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </Border>
      <Border Width="52"
              Height="52"
              CornerRadius="13"
              ClipToBounds="True"
              Background="#8F7CFF">
        <Image Source="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}"
               Stretch="UniformToFill" />
      </Border>
      <TextBlock Text="{Binding ProfileName}"
                 Foreground="#FFFFFF"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
