<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:controls="using:Noctra.Mobile.Controls"
             x:Class="Noctra.Mobile.Views.ProfileLoadingView"
             x:DataType="vm:ProfileLoadingViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="844"
             Background="{DynamicResource Bg0Brush}">

  <!--
    ╔══════════════════════════════════════════════════════╗
    ║  Profil Yükleme Ekranı — Netflix tarzı tam ekran    ║
    ║                                                      ║
    ║  Üst:   Pulsing logo (PremiumSpinner içinde)         ║
    ║  Orta:  Profil avatar + ad                           ║
    ║  Alt:   Durum mesajı, uyarı şeridi                   ║
    ╚══════════════════════════════════════════════════════╝
  -->
  <Grid RowDefinitions="*,Auto,Auto,*" Margin="32">

    <!-- ── Boş üst dolgu ── -->
    <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" IsVisible="False" />

    <!-- ── Merkez: Spinner + Logo animasyonu ── -->
    <StackPanel Grid.Row="1"
                HorizontalAlignment="Center"
                Spacing="0">

      <!-- PremiumSpinner içinde pulsing logo -->
      <controls:PremiumSpinner Width="90" Height="90"
                               HorizontalAlignment="Center">
        <Image Source="avares://Noctra.Mobile/Assets/Square150x150Logo.png"
               Width="44" Height="44"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderTransformOrigin="50%,50%">
          <Image.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
          </Image.RenderTransform>
          <Image.Styles>
            <Style Selector="Image">
              <Style.Animations>
                <Animation Duration="0:0:1.6"
                           IterationCount="Infinite"
                           Easing="SineEaseInOut">
                  <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.55" />
                    <Setter Property="ScaleTransform.ScaleX" Value="0.88" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.88" />
                  </KeyFrame>
                  <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="1.0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                  </KeyFrame>
                  <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.55" />
                    <Setter Property="ScaleTransform.ScaleX" Value="0.88" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.88" />
                  </KeyFrame>
                </Animation>
              </Style.Animations>
            </Style>
          </Image.Styles>
        </Image>
      </controls:PremiumSpinner>

      <!-- Profil bilgisi (avatar + ad) -->
      <StackPanel HorizontalAlignment="Center"
                  Spacing="16"
                  Margin="0,40,0,0">

        <!-- Profil avatarı -->
        <Border Width="72" Height="72"
                CornerRadius="12"
                ClipToBounds="True"
                Background="{DynamicResource Surface1Brush}"
                HorizontalAlignment="Center">
          <Image Source="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}"
                 Stretch="UniformToFill" />
        </Border>

        <!-- Profil adı -->
        <TextBlock Text="{Binding ProfileName}"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextAlignment="Center"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <!-- ── Durum mesajı ve uyarı ── -->
    <StackPanel Grid.Row="2"
                HorizontalAlignment="Center"
                Spacing="14"
                Margin="0,28,0,0"
                MaxWidth="320">

      <!-- Durum metni (normal / hata) -->
      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="14"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Center"
                 Tag="{Binding IsError}">
        <TextBlock.Styles>
          <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
          </Style>
          <Style Selector="TextBlock[Tag=True]">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
        </TextBlock.Styles>
      </TextBlock>

      <!-- Uyarı şeridi (sarı) -->
      <Border Background="#1AFFA500"
              BorderBrush="#80FFA500"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14,10"
              IsVisible="{Binding LoadingWarningMessage,
                                  Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="⚠"
                     FontSize="15"
                     Foreground="#FFA500"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding LoadingWarningMessage}"
                     Foreground="#FFA500"
                     FontSize="13"
                     TextAlignment="Left"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ── Boş alt dolgu ── -->
    <Border Grid.Row="3" />
  </Grid>

</UserControl>
