<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             x:Class="Noctra.Mobile.Views.ProfileLoadingView"
             x:DataType="vm:ProfileLoadingViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="420">
  <Border Background="{DynamicResource Surface0Brush}"
          CornerRadius="20"
          Padding="24"
          MaxWidth="360"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="16"
                HorizontalAlignment="Center">
      <ProgressBar IsIndeterminate="{Binding IsIndeterminate}"
                   Width="220"
                   Height="8"
                   Foreground="{DynamicResource AccentBrush}" />
      <TextBlock Text="Noctra"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 HorizontalAlignment="Center" />
      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{DynamicResource TextMutedBrush}"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="300"
                 Tag="{Binding IsError}" />
      <Border BorderThickness="1"
              CornerRadius="10"
              Padding="12,8"
              IsVisible="{Binding LoadingWarningMessage}">
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource WarningColor}" Opacity="0.1" />
        </Border.Background>
        <Border.BorderBrush>
          <SolidColorBrush Color="{DynamicResource WarningColor}" Opacity="0.5" />
        </Border.BorderBrush>
        <TextBlock Text="{Binding LoadingWarningMessage}"
                   Foreground="{DynamicResource WarningBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </Border>
      <Border Width="52"
              Height="52"
              CornerRadius="13"
              ClipToBounds="True"
              Background="{DynamicResource AccentBrush}">
        <Image Source="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}"
               Stretch="UniformToFill" />
      </Border>
      <TextBlock Text="{Binding ProfileName}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
