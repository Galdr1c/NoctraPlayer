<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Noctra.Mobile"
             xmlns:controls="using:Noctra.Mobile.Controls"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Default">
            <ResourceDictionary.MergedDictionaries>
              <ResourceInclude Source="avares://Noctra.Mobile/Resources/Themes/DarkTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
          </ResourceDictionary>
          <ResourceDictionary x:Key="Dark">
            <ResourceDictionary.MergedDictionaries>
              <ResourceInclude Source="avares://Noctra.Mobile/Resources/Themes/DarkTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
          </ResourceDictionary>
          <ResourceDictionary x:Key="Light">
            <ResourceDictionary.MergedDictionaries>
              <ResourceInclude Source="avares://Noctra.Mobile/Resources/Themes/LightTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary.MergedDictionaries>
          <ResourceInclude Source="avares://Noctra.Mobile/Resources/Colors.axaml" />
          <ResourceInclude Source="avares://Noctra.Mobile/Resources/Tokens.axaml" />
          <ResourceInclude Source="avares://Noctra.Mobile/Resources/Styles.axaml" />
        </ResourceDictionary.MergedDictionaries>
        <converters:AvatarPathConverter x:Key="AvatarPathConverter" />
        <converters:DoubleToFloatConverter x:Key="DoubleToFloatConverter" />
        <converters:StringFormatConverter x:Key="StringFormatConverter" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
        <converters:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter" />
        <converters:MediaSupportsFavoriteConverter x:Key="MediaSupportsFavoriteConverter" />
        <converters:MediaSupportsMyListConverter x:Key="MediaSupportsMyListConverter" />
        <converters:DoubleToLeftMarginConverter x:Key="DoubleToLeftMarginConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <converters:BoolToEpgBlockColorConverter x:Key="BoolToEpgBlockColorConverter" />
        <converters:BoolToEpgBorderColorConverter x:Key="BoolToEpgBorderColorConverter" />
        <converters:BoolToSelectionBrushConverter x:Key="BoolToSelectionBrushConverter" />
        <converters:SubtitleBackgroundBrushConverter x:Key="SubtitleBackgroundBrushConverter" />
        <converters:SubtitlePositionToAlignmentConverter x:Key="SubtitlePositionToAlignmentConverter" />
        <converters:EpisodeIdentityConverter x:Key="EpisodeIdentityConverter" />
        <converters:EqualityToBoolMultiConverter x:Key="EqualityToBoolMultiConverter" />
        <converters:EqualityToBrushMultiConverter x:Key="EqualityToBrushMultiConverter" />
        <converters:PercentToWidthConverter x:Key="PercentToWidthConverter" />
        <converters:SubtitleIconConverter x:Key="SubtitleIconConverter" />
        <converters:FillModeToIconConverter x:Key="FillModeToIconConverter" />
        <converters:ResponsiveCardMetricConverter x:Key="ResponsiveCardMetricConverter" />
        <converters:UrgencyToColorConverter x:Key="UrgencyToColorConverter" />
        <converters:TimeSpanToCountdownConverter x:Key="TimeSpanToCountdownConverter" />
        <converters:PinDotConverter x:Key="PinDotConverter" />
        <converters:ProfileColorConverter x:Key="ProfileColorConverter" />
        <converters:DownloadStatusToBrushConverter x:Key="DownloadStatusToBrushConverter" />
        <converters:DownloadStatusToLocalizedTextConverter x:Key="DownloadStatusToLocalizedTextConverter" />
        <converters:DownloadEtaTextConverter x:Key="DownloadEtaTextConverter" />
        <converters:DownloadSpeedTextConverter x:Key="DownloadSpeedTextConverter" />
        <converters:BoolToMaterialIconKindConverter x:Key="BoolToMaterialIconKindConverter" />
        <converters:BoolToLocalizedStringConverter x:Key="BoolToLocalizedStringConverter" />
        <converters:BytesToHumanConverter x:Key="BytesToHumanConverter" />
        <converters:DoubleToStarGridLengthConverter x:Key="DoubleToStarGridLengthConverter" />
        <converters:WidthToColumnsConverter x:Key="WidthToColumnsConverter" />
        <converters:WatchedProgressVisibilityConverter x:Key="WatchedProgressVisibilityConverter" />
        <converters:WatchedProgressWidthConverter x:Key="WatchedProgressWidthConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:ConnectionHealthToVisibilityConverter x:Key="ConnectionHealthToVisibilityConverter" />
        <converters:ConnectionHealthToIconConverter x:Key="ConnectionHealthToIconConverter" />
        <converters:ConnectionHealthToBrushConverter x:Key="ConnectionHealthToBrushConverter" />
        <converters:BooleanToSuccessWarningBrushConverter x:Key="BooleanToSuccessWarningBrushConverter" />
        <converters:PromoStatusBrushConverter x:Key="PromoStatusBrushConverter" />
        <converters:LogoThemeConverter x:Key="LogoThemeConverter" />
        <converters:EnumEqualConverter x:Key="EnumEqualConverter" />
        <converters:EnumToStringConverter x:Key="EnumToStringConverter" />
        <ControlTheme x:Key="TransparentListBoxItemTheme" TargetType="ListBoxItem">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Template">
            <ControlTemplate TargetType="ListBoxItem">
              <ContentPresenter Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
          </Setter>
        </ControlTheme>
      </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <materialIcons:MaterialIconStyles />
        <FluentTheme />
        <StyleInclude Source="avares://Noctra.Mobile/Controls/PremiumSpinner.axaml" />
        <StyleInclude Source="avares://Noctra.Mobile/Resources/CommonStyles.axaml" />
        <StyleInclude Source="avares://Noctra.Mobile/Resources/SettingsStyles.axaml" />

        <!-- ═══════════════════════════════════════════════════════
             NoctraTextBox — Unified Input System
             Base: 54dp height, 8dp radius, 1.5px border
             Classes: .url .search .password .pin .error .readonly
             ═══════════════════════════════════════════════════════ -->
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="FontSize" Value="{DynamicResource FBodyL}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="PlaceholderForeground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox:not(:focus) /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource TextDisabledBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <!-- Class: .url -->
        <Style Selector="TextBox.url">
            <Setter Property="TextInputOptions.ContentType" Value="Url" />
            <Setter Property="TextInputOptions.ShowSuggestions" Value="False" />
        </Style>
        <!-- Class: .search -->
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="TextInputOptions.ContentType" Value="Search" />
            <Setter Property="TextInputOptions.ReturnKeyType" Value="Search" />
        </Style>
        
        <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.search:not(:focus) /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Class: .password -->
        <Style Selector="TextBox.password">
            <Setter Property="TextInputOptions.IsSensitive" Value="True" />
            <Setter Property="TextInputOptions.ShowSuggestions" Value="False" />
            <Setter Property="PasswordChar" Value="&#x2022;" />
        </Style>
        <!-- Class: .pin -->
        <Style Selector="TextBox.pin">
            <Setter Property="TextInputOptions.ContentType" Value="Digits" />
            <Setter Property="TextInputOptions.IsSensitive" Value="True" />
            <Setter Property="TextInputOptions.ShowSuggestions" Value="False" />
            <Setter Property="MaxLength" Value="4" />
            <Setter Property="PasswordChar" Value="&#x2022;" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="LetterSpacing" Value="8" />
        </Style>
        <!-- Class: .error -->
        <Style Selector="TextBox.error">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox.error:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox.error:not(:focus) /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <!-- Class: .readonly -->
        <Style Selector="TextBox.readonly">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
        </Style>

        <!-- Rotating Icon Animation (madde 18: islem sirasinda donen loading ikonu) -->
        <Style Selector="materialIcons|MaterialIcon.Rotating">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>
