<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Noctra.Mobile"
             xmlns:converters="using:Noctra.Mobile.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Mobile.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Default">
            <ResourceDictionary.MergedDictionaries>
              <ResourceInclude Source="avares://Noctra.Mobile/Resources/Themes/DarkTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
          </ResourceDictionary>
          <ResourceDictionary x:Key="Dark">
            <ResourceDictionary.MergedDictionaries>
              <ResourceInclude Source="avares://Noctra.Mobile/Resources/Themes/DarkTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
          </ResourceDictionary>
          <ResourceDictionary x:Key="Light">
            <ResourceDictionary.MergedDictionaries>
              <ResourceInclude Source="avares://Noctra.Mobile/Resources/Themes/LightTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary.MergedDictionaries>
          <ResourceInclude Source="avares://Noctra.Mobile/Resources/Colors.axaml" />
          <ResourceInclude Source="avares://Noctra.Mobile/Resources/Tokens.axaml" />
          <ResourceInclude Source="avares://Noctra.Mobile/Resources/Styles.axaml" />
        </ResourceDictionary.MergedDictionaries>
        <converters:AvatarPathConverter x:Key="AvatarPathConverter" />
        <converters:DoubleToFloatConverter x:Key="DoubleToFloatConverter" />
        <converters:StringFormatConverter x:Key="StringFormatConverter" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
        <converters:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter" />
        <converters:MediaSupportsFavoriteConverter x:Key="MediaSupportsFavoriteConverter" />
        <converters:MediaSupportsMyListConverter x:Key="MediaSupportsMyListConverter" />
        <converters:DoubleToLeftMarginConverter x:Key="DoubleToLeftMarginConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <converters:BoolToEpgBlockColorConverter x:Key="BoolToEpgBlockColorConverter" />
        <converters:BoolToEpgBorderColorConverter x:Key="BoolToEpgBorderColorConverter" />
        <converters:BoolToSelectionBrushConverter x:Key="BoolToSelectionBrushConverter" />
        <converters:SubtitleBackgroundBrushConverter x:Key="SubtitleBackgroundBrushConverter" />
        <converters:EpisodeIdentityConverter x:Key="EpisodeIdentityConverter" />
        <converters:EqualityToBoolMultiConverter x:Key="EqualityToBoolMultiConverter" />
        <converters:EqualityToBrushMultiConverter x:Key="EqualityToBrushMultiConverter" />
        <converters:PercentToWidthConverter x:Key="PercentToWidthConverter" />
        <converters:SubtitleIconConverter x:Key="SubtitleIconConverter" />
        <converters:FillModeToIconConverter x:Key="FillModeToIconConverter" />
        <converters:ResponsiveCardMetricConverter x:Key="ResponsiveCardMetricConverter" />
        <converters:UrgencyToColorConverter x:Key="UrgencyToColorConverter" />
        <converters:TimeSpanToCountdownConverter x:Key="TimeSpanToCountdownConverter" />
        <converters:PinDotConverter x:Key="PinDotConverter" />
        <converters:ProfileColorConverter x:Key="ProfileColorConverter" />
        <converters:DownloadStatusToBrushConverter x:Key="DownloadStatusToBrushConverter" />
        <converters:BoolToMaterialIconKindConverter x:Key="BoolToMaterialIconKindConverter" />
        <converters:BoolToLocalizedStringConverter x:Key="BoolToLocalizedStringConverter" />
        <converters:BytesToHumanConverter x:Key="BytesToHumanConverter" />
        <converters:DoubleToStarGridLengthConverter x:Key="DoubleToStarGridLengthConverter" />
        <converters:WidthToColumnsConverter x:Key="WidthToColumnsConverter" />
        <converters:WatchedProgressVisibilityConverter x:Key="WatchedProgressVisibilityConverter" />
        <converters:WatchedProgressWidthConverter x:Key="WatchedProgressWidthConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:ConnectionHealthToVisibilityConverter x:Key="ConnectionHealthToVisibilityConverter" />
        <converters:ConnectionHealthToIconConverter x:Key="ConnectionHealthToIconConverter" />
        <converters:ConnectionHealthToBrushConverter x:Key="ConnectionHealthToBrushConverter" />
        <converters:BooleanToSuccessWarningBrushConverter x:Key="BooleanToSuccessWarningBrushConverter" />
        <converters:PromoStatusBrushConverter x:Key="PromoStatusBrushConverter" />
      </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <materialIcons:MaterialIconStyles />
        <FluentTheme />
        <StyleInclude Source="avares://Noctra.Mobile/Controls/PremiumSpinner.axaml" />
        <StyleInclude Source="avares://Noctra.Mobile/Resources/CommonStyles.axaml" />
        <StyleInclude Source="avares://Noctra.Mobile/Resources/SettingsStyles.axaml" />
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ScrollBar Thumb">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ScrollBar RepeatButton">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Styles>
</Application>
