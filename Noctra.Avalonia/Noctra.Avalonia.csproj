<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Noctra</AssemblyName>
    <TargetName>Noctra</TargetName>
    <PackageId>Noctra</PackageId>
    <Authors>$(NoctraAuthors)</Authors>
    <Company>$(NoctraCompany)</Company>
    <Product>$(NoctraAppDisplayName)</Product>
    <Version>$(NoctraVersionPrefix)</Version>
    <FileVersion>$(NoctraPackageVersion)</FileVersion>
    <AssemblyVersion>$(NoctraPackageVersion)</AssemblyVersion>
    <InformationalVersion>$(NoctraVersionPrefix)</InformationalVersion>
    <ApplicationIcon>Assets\Noctra.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildingStorePackage)' == 'true'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NoctraEdition</_Parameter1>
      <_Parameter2>$(NoctraEdition)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NoctraEditionDisplayName</_Parameter1>
      <_Parameter2>$(NoctraEditionDisplayName)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NoctraPremiumStoreProductId</_Parameter1>
      <_Parameter2>$(NoctraPremiumStoreProductId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NoctraPremiumStoreLaunchUri</_Parameter1>
      <_Parameter2>$(NoctraPremiumStoreLaunchUri)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NoctraPremiumStoreWebUri</_Parameter1>
      <_Parameter2>$(NoctraPremiumStoreWebUri)</_Parameter2>
    </AssemblyAttribute>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="LibVLCSharp" Version="3.9.5" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noctra.Core\Noctra.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
