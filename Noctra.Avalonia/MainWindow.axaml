<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Noctra.ViewModels"
        xmlns:models="using:Noctra.Models"
        xmlns:views="using:Noctra.Avalonia.Views"
        xmlns:controls="using:Noctra.Avalonia.Controls"
        xmlns:loc="using:Noctra.Avalonia.Localization"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:b="using:Noctra.Avalonia.Behaviors"
        x:Class="Noctra.Avalonia.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://Noctra.Avalonia/Assets/Logo.png"
        Title="Noctra"
        TransparencyLevelHint="None"
        Width="1400" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg0Brush}">

    <Window.Styles>
      <Style Selector="Button.SettingsGearButton materialIcons|MaterialIcon#SettingsGearIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="RenderTransform" Value="rotate(0deg)"/>
      </Style>
      <Style Selector="Button.SettingsGearButton:pointerover materialIcons|MaterialIcon#SettingsGearIcon">  
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="RenderTransform" Value="rotate(120deg)"/>
      </Style>
      <Style Selector="Button.pipButton">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
      </Style>
      <Style Selector="Button.pipButton:pointerover">
        <Setter Property="Background" Value="#33FFFFFF"/>
      </Style>
      <Style Selector="Button.pipButton:pressed">
          <Setter Property="Background" Value="#44FFFFFF"/>
          <Setter Property="RenderTransform" Value="scale(0.95)"/>
      </Style>
      <Style Selector="materialIcons|MaterialIcon.cornerMask">
          <Setter Property="Foreground" Value="Black"/>
          <Setter Property="Width" Value="12"/>
          <Setter Property="Height" Value="12"/>
          <Setter Property="ZIndex" Value="5000"/>
      </Style>
  
      <!-- HIGH IMPACT SIDEBAR STYLES -->
      <Style Selector="Button.navItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Height" Value="44"/>
      </Style>
  
      <Style Selector="Button.navItem StackPanel.ItemContent">
        <Setter Property="Margin" Value="14,0"/>
      </Style>          
      <Style Selector="Button.navItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
      </Style>
  
      <Style Selector="Button.navItem.active">
        <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}"/>
      </Style>

      <Style Selector="Button.navItem Border.ActiveIndicator">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Width" Value="0"/>
        <Setter Property="CornerRadius" Value="0,2,2,0"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
      </Style>

      <Style Selector="Button.navItem.active Border.ActiveIndicator">
        <Setter Property="IsVisible" Value="True"/>
        <Setter Property="Width" Value="4"/>
      </Style>

      <Style Selector="Button.navItem TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="14"/>
      </Style>

      <Style Selector="Button.navItem:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      </Style>

      <Style Selector="Button.navItem.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <Style Selector="Button.navItem materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
      </Style>

      <Style Selector="Button.navItem:pointerover materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Opacity" Value="1"/>
      </Style>

      <Style Selector="Button.navItem.active materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Opacity" Value="1"/>
      </Style>
  
      <!-- HEADER SEARCH STYLES -->
      <Style Selector="TextBox.headerSearch">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Watermark" Value=""/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Transitions">
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.15" Easing="QuadraticEaseOut"/>
          </Transitions>
        </Setter>
      </Style>

      <Style Selector="TextBox.headerSearch:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      </Style>

      <Style Selector="TextBox.headerSearch:focus, TextBox.headerSearch.notEmpty, TextBox.headerSearch.isSearchView">
        <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Padding" Value="12,6"/>

        <Setter Property="Watermark" Value="{loc:Translate Shell.Search.Placeholder}"/>
      </Style>

      <!-- Avalonia TextBox focus kenarlığını ezmek için özel PART_BorderElement kuralı -->
      <Style Selector="TextBox.headerSearch:focus /template/ Border#PART_BorderElement, TextBox.headerSearch.notEmpty /template/ Border#PART_BorderElement, TextBox.headerSearch.isSearchView /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Style>


    </Window.Styles>

  <Grid RowDefinitions="64,*,48" Focusable="True">

    <!-- ========== HEADER BAR ========== -->
    <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource HeaderGradientBrush}" 
            Padding="24,0" PointerPressed="HeaderBar_PointerPressed" Focusable="True">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- Spacer for Logo removal -->
        <Border Width="1" Height="64" Margin="8,0,0,0"/>

        <!-- New Expanding Search -->
        <TextBox x:Name="HeaderSearchBox" Classes="headerSearch" 
                 Classes.notEmpty="{Binding SearchQuery, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                 Classes.isSearchView="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=Search}"
                 Grid.Column="1" HorizontalAlignment="Right"
                 Text="{Binding SearchQuery, Mode=TwoWay}"
                 Margin="0,0,12,0"
                 KeyDown="SearchInput_KeyDown" Cursor="Hand" ToolTip.Tip="{loc:Translate Shell.Search.Tooltip}">
          <TextBox.InnerLeftContent>
            <Border Width="38" Height="34" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
               <materialIcons:MaterialIcon Kind="Magnify" Width="18" Height="18" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
            </Border>
          </TextBox.InnerLeftContent>
        </TextBox>

        <!-- Search Results Popup -->
        <Popup IsOpen="{Binding !!SearchResults.Count}" 
               PlacementTarget="{Binding #HeaderSearchBox}"
               Placement="Bottom"
               IsLightDismissEnabled="True" >
          <Border Width="340" MaxHeight="400" Background="{DynamicResource SurfaceBrush}" 
                  CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.DataTemplates>
                  <DataTemplate x:DataType="models:Channel">
                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" 
                            CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="8" Cursor="Hand" HorizontalAlignment="Stretch">
                      <Grid ColumnDefinitions="40,*">
                        <Border Width="32" Height="32" CornerRadius="4" ClipToBounds="True">
                          <controls:RemoteImage Stretch="UniformToFill" Url="{Binding LogoUrl}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding GroupTitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                  <DataTemplate x:DataType="models:Series">
                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" 
                            CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="8" Cursor="Hand" HorizontalAlignment="Stretch">
                      <Grid ColumnDefinitions="40,*">
                        <Border Width="32" Height="32" CornerRadius="4" ClipToBounds="True">
                          <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{loc:Translate Shell.Series.Type}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.DataTemplates>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Popup>

        <!-- Header Actions -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <!-- Settings Button -->
          <Button Classes="SettingsGearButton" Click="SettingsButton_Click" Cursor="Hand" ToolTip.Tip="{loc:Translate Shell.Settings.Tooltip}"
                  Width="48" Height="48" Background="Transparent" BorderThickness="0" CornerRadius="24">
            <materialIcons:MaterialIcon x:Name="SettingsGearIcon" Kind="CogOutline" Width="22" Height="22" RenderTransformOrigin="50%,50%">
              <materialIcons:MaterialIcon.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22"/>
                </Transitions>
              </materialIcons:MaterialIcon.Transitions>
            </materialIcons:MaterialIcon>
          </Button>
          <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="0,8" Opacity="0.5"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ========== MAIN CONTENT AREA ========== -->
    <Grid x:Name="MainContentArea" Grid.Row="1">
      <!-- SIDEBAR -->
      <Border x:Name="SideBar" Width="60" HorizontalAlignment="Left" ZIndex="200" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseOut"/>
          </Transitions>
        </Border.Transitions>

        <StackPanel Margin="0,16,0,24">
          <!-- Hamburger Button -->
          <Button x:Name="HamburgerBtn" Click="HamburgerBtn_Click"
                  Background="Transparent" BorderThickness="0"
                  Width="44" Height="44" Padding="0"
                  HorizontalAlignment="Left" Margin="8,0,0,16"
                      Cursor="Hand" ToolTip.Tip="{loc:Translate Shell.Menu.Tooltip}">
            <materialIcons:MaterialIcon x:Name="HamburgerIcon" Kind="Menu" Width="22" Height="22"
                                        Foreground="{DynamicResource TextPrimaryBrush}"/>
          </Button>

          <!-- Nav Section Label -->
                    <TextBlock x:Name="NavLabel1" Text="{loc:Translate Shell.Nav.Main}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="24,0,24,8" LetterSpacing="2" IsVisible="False"/>

          <!-- Home -->
                    <Button x:Name="NavHomeBtn" Classes="navItem" Click="NavigateHome_Click" ToolTip.Tip="{loc:Translate Shell.Nav.Home}"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.Home}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="HomeVariantOutline" />
                        <TextBlock x:Name="NavHomeText" Text="{loc:Translate Shell.Nav.Home}" VerticalAlignment="Center" IsVisible="False"/>
              </StackPanel>
            </Panel>
          </Button>

          <!-- Live TV -->
                    <Button x:Name="NavLiveBtn" Classes="navItem" Click="NavigateLive_Click" ToolTip.Tip="{loc:Translate Shell.Nav.Live}"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.Live}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="Television" />
                        <TextBlock x:Name="NavLiveText" Text="{loc:Translate Shell.Nav.Live}" VerticalAlignment="Center" IsVisible="False"/>
              </StackPanel>
            </Panel>
          </Button>

          <!-- Movies -->
                    <Button x:Name="NavMoviesBtn" Classes="navItem" Click="NavigateMovies_Click" ToolTip.Tip="{loc:Translate Shell.Nav.Movies}"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.Movies}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="Filmstrip"/>
                        <TextBlock x:Name="NavMoviesText" Text="{loc:Translate Shell.Nav.Movies}" VerticalAlignment="Center" IsVisible="False"/>
              </StackPanel>
            </Panel>
          </Button>

          <!-- Series -->
                    <Button x:Name="NavSeriesBtn" Classes="navItem" Click="NavigateSeries_Click" ToolTip.Tip="{loc:Translate Shell.Nav.Series}"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.Series}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="TelevisionPlay" />
                        <TextBlock x:Name="NavSeriesText" Text="{loc:Translate Shell.Nav.Series}" VerticalAlignment="Center" IsVisible="False"/>
              </StackPanel>
            </Panel>
          </Button>

          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,12"/>

          <!-- Nav Section Label 2 -->
                    <TextBlock x:Name="NavLabel2" Text="{loc:Translate Shell.Nav.Library}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="24,0,24,8" LetterSpacing="2" IsVisible="False"/>

          <!-- My List -->
                    <Button x:Name="NavMyListBtn" Classes="navItem" Click="NavigateMyList_Click" ToolTip.Tip="{loc:Translate Shell.Nav.MyList}"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.MyList}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="BookmarkOutline" />
                        <TextBlock x:Name="NavMyListText" Text="{loc:Translate Shell.Nav.MyList}" VerticalAlignment="Center" IsVisible="False"/>
              </StackPanel>
            </Panel>
          </Button>

          <!-- Favorites -->
                    <Button x:Name="NavFavBtn" Classes="navItem" Click="NavigateFavorites_Click" ToolTip.Tip="{loc:Translate Shell.Nav.Favorites}"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.Favorites}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="HeartOutline" />
                        <TextBlock x:Name="NavFavText" Text="{loc:Translate Shell.Nav.Favorites}" VerticalAlignment="Center" IsVisible="False"/>
              </StackPanel>
            </Panel>
          </Button>

          <!-- History -->
                    <Button x:Name="NavHistoryBtn" Classes="navItem" Click="NavigateHistory_Click" ToolTip.Tip="{loc:Translate Shell.Nav.History}"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.History}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="History" />
                        <TextBlock x:Name="NavHistoryText" Text="{loc:Translate Shell.Nav.History}" VerticalAlignment="Center" IsVisible="False"/>
              </StackPanel>
            </Panel>
          </Button>

          <!-- Downloads -->
                    <Button x:Name="NavDownloadsBtn" Classes="navItem" Click="NavigateDownloads_Click" ToolTip.Tip="{loc:Translate Shell.Nav.Downloads}"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.Downloads}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                  <Panel>
                    <materialIcons:MaterialIcon Kind="DownloadOutline" />
                    <!-- Mini mode badge (overlay on icon) -->
                    <Border x:Name="NavDownloadsBadgeMini" 
                            IsVisible="False"
                            Background="{DynamicResource AccentBrush}" 
                            CornerRadius="6" Width="12" Height="12" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0"
                            BorderBrush="{DynamicResource Bg1Brush}" BorderThickness="1.5">
                       <Ellipse Fill="White" Width="4" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
                    </Border>
                  </Panel>
                            <TextBlock x:Name="NavDownloadsText" Text="{loc:Translate Shell.Nav.Downloads}" VerticalAlignment="Center" IsVisible="False"/>
                </StackPanel>
                
                <!-- Expanded mode badge -->
                <Border x:Name="NavDownloadsBadgeFull" Grid.Column="1" 
                        IsVisible="False"
                        Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                  <TextBlock Text="{Binding ActiveDownloadCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>
              </Grid>
            </Panel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Sidebar dışına tıklayınca kapatan şeffaf overlay -->
      <Border x:Name="SidebarDismissOverlay"
              Background="Transparent"
              ZIndex="199"
              IsVisible="False"
              IsHitTestVisible="True"
              PointerPressed="SidebarDismissOverlay_PointerPressed"/>

      <!-- MAIN CONTENT (Has 60px left margin to avoid overlap with closed sidebar) -->
      <Grid Margin="60,0,0,0">

        <!-- 1. HOME VIEW -->
                <views:HomeView Opacity="{Binding ActiveView, Converter={StaticResource EqualityToOpacityConverter}, ConverterParameter={x:Static vm:AppView.Home}}"
                                IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Home}}">
                    <views:HomeView.Transitions>
                        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
                    </views:HomeView.Transitions>
                </views:HomeView>


        <!-- 2. MOVIES VIEW -->
                <views:MoviesView Opacity="{Binding ActiveView, Converter={StaticResource EqualityToOpacityConverter}, ConverterParameter={x:Static vm:AppView.Movies}}"
                                  IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Movies}}">
                    <views:MoviesView.Transitions>
                        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
                    </views:MoviesView.Transitions>
                </views:MoviesView>


        <!-- 3. SERIES VIEW -->
                <views:SeriesView Opacity="{Binding ActiveView, Converter={StaticResource EqualityToOpacityConverter}, ConverterParameter={x:Static vm:AppView.Series}}"
                                  IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Series}}">
                    <views:SeriesView.Transitions>
                        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
                    </views:SeriesView.Transitions>
                </views:SeriesView>


        <!-- 4. LIVE TV VIEW -->
                <views:LiveView Opacity="{Binding ActiveView, Converter={StaticResource EqualityToOpacityConverter}, ConverterParameter={x:Static vm:AppView.Live}}"
                                IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Live}}">
                    <views:LiveView.Transitions>
                        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
                    </views:LiveView.Transitions>
                </views:LiveView>


        <!-- 5. SEARCH VIEW -->
                <views:SearchView Opacity="{Binding ActiveView, Converter={StaticResource EqualityToOpacityConverter}, ConverterParameter={x:Static vm:AppView.Search}}"
                                  IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Search}}">
                    <views:SearchView.Transitions>
                        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
                    </views:SearchView.Transitions>
                </views:SearchView>

        <!-- 6. MY LIST VIEW -->
                <views:MyListView Opacity="{Binding ActiveView, Converter={StaticResource EqualityToOpacityConverter}, ConverterParameter={x:Static vm:AppView.MyList}}"
                                  IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.MyList}}">
                    <views:MyListView.Transitions>
                        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
                    </views:MyListView.Transitions>
                </views:MyListView>


        <!-- 7. FAVORITES VIEW -->
                <views:FavoritesView Opacity="{Binding ActiveView, Converter={StaticResource EqualityToOpacityConverter}, ConverterParameter={x:Static vm:AppView.Favorites}}"
                                     IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Favorites}}">
                    <views:FavoritesView.Transitions>
                        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
                    </views:FavoritesView.Transitions>
                </views:FavoritesView>


        <!-- 8. HISTORY VIEW -->
                <views:HistoryView Opacity="{Binding ActiveView, Converter={StaticResource EqualityToOpacityConverter}, ConverterParameter={x:Static vm:AppView.History}}"
                                   IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.History}}">
                    <views:HistoryView.Transitions>
                        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
                    </views:HistoryView.Transitions>
                </views:HistoryView>


        <!-- 9. DOWNLOADS VIEW -->
                <views:DownloadsView Opacity="{Binding ActiveView, Converter={StaticResource EqualityToOpacityConverter}, ConverterParameter={x:Static vm:AppView.Downloads}}"
                                     IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Downloads}}">
                    <views:DownloadsView.Transitions>
                        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
                    </views:DownloadsView.Transitions>
                </views:DownloadsView>



        <!-- Series Detail Overlay (Modern Netflix Style) -->
        <!-- Will be placed inside Main Content Area so that sidebar can overlay over it -->
        <Grid x:Name="SeriesDetailOverlay"
              Background="{DynamicResource BackgroundGradientBrush}"
              IsVisible="{Binding IsSeriesDetailVisible}" ZIndex="998">          
          <Grid>
            <!-- Background Backdrop with Blur -->
            <Grid IsHitTestVisible="False" Opacity="0.3" IsVisible="{Binding !IsDownloadedSeriesDetailMode}">
                <controls:RemoteImage Stretch="UniformToFill" Url="{Binding SelectedSeriesPosterUrl}">
                    <controls:RemoteImage.Effect>
                        <BlurEffect Radius="60"/>
                    </controls:RemoteImage.Effect>
                </controls:RemoteImage>
                <Border>
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="Transparent" Offset="0.0"/>
                      <GradientStop Color="{DynamicResource Bg0Color}" Offset="1.0"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid Margin="60,40" RowDefinitions="Auto,Auto">

                <!-- Header Section -->
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Reduce width to 200 in Downloaded Mode using a Panel/Border trick -->
                  <Panel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                     <Border Height="450" Width="300" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource Surface0Brush}"
                             IsVisible="{Binding !IsDownloadedSeriesDetailMode}">
                        <Border.BoxShadow>
                          <BoxShadows>0 15 50 5 #88000000</BoxShadows>
                        </Border.BoxShadow>
                        <controls:RemoteImage Stretch="UniformToFill" Url="{Binding SelectedSeriesPosterUrl}"/>
                     </Border>
                     <Border Height="300" Width="200" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource Surface0Brush}"
                             IsVisible="{Binding IsDownloadedSeriesDetailMode}">
                        <Border.BoxShadow>
                          <BoxShadows>0 15 50 5 #88000000</BoxShadows>
                        </Border.BoxShadow>
                        <controls:RemoteImage Stretch="UniformToFill" Url="{Binding SelectedSeriesPosterUrl}"/>
                     </Border>
                  </Panel>

                  <!-- Metadata & Info -->
                  <Grid Grid.Column="1" Margin="48,0,0,0" RowDefinitions="Auto,*,Auto">

                    <!-- Title and Meta -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Top">
                      <!-- Back button -->
                      <Button Command="{Binding CloseSeriesDetailCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" 
                              Theme="{StaticResource ActionCircleButtonStyle}" Width="48" Height="48" Padding="0">
                        <materialIcons:MaterialIcon Kind="ArrowLeft" Width="24" Height="24" Foreground="{DynamicResource TextPrimaryBrush}"/>
                      </Button>

                      <StackPanel Spacing="8">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="120">
                          <TextBlock Text="{Binding SelectedSeries.Name}" FontSize="52" FontWeight="Black" 
                                     Foreground="{DynamicResource TextPrimaryBrush}" LetterSpacing="-1"/>
                        </Viewbox>
                        <TextBlock Text="{loc:Translate Series.Detail.DownloadedEpisodes}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   IsVisible="{Binding IsDownloadedSeriesDetailMode}"/>
                      </StackPanel>

                      <!-- Badges & Stats (Netflix Style Meta) -->
                      <WrapPanel Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center" IsVisible="{Binding !IsDownloadedSeriesDetailMode}">
                        <TextBlock Text="{Binding SelectedSeriesYears}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" FontWeight="SemiBold"
                                  IsVisible="{Binding SelectedSeriesYears, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                        <TextBlock Text=" • " Foreground="{DynamicResource TextMutedBrush}" FontSize="15" VerticalAlignment="Center" Margin="8,0">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="SelectedSeriesYears" Converter="{StaticResource StringNotEmptyToBoolConverter}"/>
                              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="SelectedSeriesGenres" Converter="{StaticResource StringNotEmptyToBoolConverter}"/>
                                <Binding Path="SelectedSeriesAgeRating" Converter="{StaticResource StringNotEmptyToBoolConverter}"/>
                              </MultiBinding>
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>

                        <TextBlock Text="{Binding SelectedSeriesGenres}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" FontWeight="Medium"
                                  IsVisible="{Binding SelectedSeriesGenres, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                        <TextBlock Text=" • " Foreground="{DynamicResource TextMutedBrush}" FontSize="15" VerticalAlignment="Center" Margin="8,0">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="SelectedSeriesGenres" Converter="{StaticResource StringNotEmptyToBoolConverter}"/>
                              <Binding Path="SelectedSeriesAgeRating" Converter="{StaticResource StringNotEmptyToBoolConverter}"/>
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>

                        <Border BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1.5" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Margin="4,0,0,0"
                                IsVisible="{Binding SelectedSeriesAgeRating, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <TextBlock Text="{Binding SelectedSeriesAgeRating}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Black"/>
                        </Border>

                        <!-- Network Logo (Netflix, HBO, Disney+, etc.) -->
                        <Border VerticalAlignment="Center" Margin="12,4,0,4" Height="20"
                                IsVisible="{Binding SelectedSeriesNetworkLogoUrl, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <controls:RemoteImage Url="{Binding SelectedSeriesNetworkLogoUrl}" 
                                                  Stretch="Uniform" Height="20" MaxWidth="80"/>
                        </Border>
                      </WrapPanel>

                      <!-- Seasons & Episodes Stats -->
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Spacing="16" IsVisible="{Binding !IsDownloadedSeriesDetailMode}">
                        <TextBlock Text="{Binding SelectedSeries.SeasonCountSafe, Converter={StaticResource StringFormatConverter}, ConverterParameter='Series.Seasons.Format'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" FontWeight="Medium"/>
                        <TextBlock Text="{Binding SelectedSeries.TotalEpisodesCount, Converter={StaticResource StringFormatConverter}, ConverterParameter='Series.Episodes.Format'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" FontWeight="Medium"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- Scrollable Description & Cast -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,0" IsVisible="{Binding !IsDownloadedSeriesDetailMode}">
                      <StackPanel>
                        <!-- Description -->
                        <TextBlock Text="{Binding SelectedSeriesOverview}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" 
                                  TextWrapping="Wrap" Opacity="0.4" LineHeight="22"
                                  IsVisible="{Binding SelectedSeriesOverview, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                        <!-- Cast -->
                        <TextBlock Text="{Binding SelectedSeriesCast, Converter={StaticResource StringFormatConverter}, ConverterParameter='Series.Detail.Cast'}" FontSize="14" 
                                  Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0"
                                  IsVisible="{Binding SelectedSeriesCast, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                      </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,24,0,0" Spacing="10" IsVisible="{Binding !IsDownloadedSeriesDetailMode}">
                        <Border CornerRadius="8" Background="Transparent" ClipToBounds="True">
                            <Border.Styles>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="BoxShadow" Value="0 0 16 0 #608B5CF6"/>
                                </Style>
                            </Border.Styles>
                            <Button Command="{Binding PlayEpisodeCommand}" CommandParameter="{Binding SelectedSeriesContinueEpisode}"
                                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                    Padding="16,8" CornerRadius="8" Focusable="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Play" Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:Translate Series.Play}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <Button Command="{Binding PlayEpisodeCommand}" CommandParameter="{Binding SelectedSeriesContinueEpisode}"
                                Background="#1A8B5CF6" Foreground="{DynamicResource AccentBrush}"
                                Padding="14,8" CornerRadius="8" Focusable="False"
                                IsVisible="{Binding SelectedSeriesContinueText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="History" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding SelectedSeriesContinueText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding WatchTrailerCommand}"
                                Background="#1A000000" Foreground="{DynamicResource TextPrimaryBrush}"
                                Padding="14,8" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" Focusable="False"
                                IsVisible="{Binding SelectedSeriesTrailerUrl, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Youtube" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{loc:Translate Series.WatchTrailer}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddToMyListCommand}" CommandParameter="{Binding SelectedSeries}"
                                Theme="{StaticResource ActionCircleButtonStyle}" Width="52" Height="52" Padding="0">
                            <Panel>
                                <materialIcons:MaterialIcon Kind="Bookmark" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"
                                                            IsVisible="{Binding SelectedSeries.IsInMyList}"/>
                                <materialIcons:MaterialIcon Kind="BookmarkOutline" Width="24" Height="24" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            IsVisible="{Binding !SelectedSeries.IsInMyList}"/>
                            </Panel>
                        </Button>

                        <Button Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedSeries}"
                                Theme="{StaticResource ActionCircleButtonStyle}" Width="52" Height="52" Padding="0">
                            <Panel>
                                <materialIcons:MaterialIcon Kind="Heart" Width="22" Height="22" Foreground="#E50914"
                                                            IsVisible="{Binding SelectedSeries.IsFavorite}"/>
                                <materialIcons:MaterialIcon Kind="HeartOutline" Width="22" Height="22" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            IsVisible="{Binding !SelectedSeries.IsFavorite}"/>
                            </Panel>
                        </Button>
                    </StackPanel>
                  </Grid>
                </Grid>

                <!-- Episodes Loading Spinner (Stalker/Xtream progressive load in progress) -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,80,0,0" Spacing="20">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsChannelLoading"/>
                            <Binding Path="SelectedSeriesTotalEpisodesCount" Converter="{StaticResource CountToVisibilityConverter}" ConverterParameter="invert"/>
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <controls:PremiumSpinner Width="56" Height="56"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Translate Series.Episodes.Loading}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextAlignment="Center"/>
                    <TextBlock Text="{loc:Translate Series.Episodes.LoadingDetail}"
                               FontSize="12" Opacity="0.6"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Seasons & Episodes -->
                <Grid Grid.Row="1" Margin="0,48,0,0" RowDefinitions="Auto,Auto"
                      IsVisible="{Binding SelectedSeries.TotalEpisodesCount, Converter={StaticResource CountToVisibilityConverter}}">
                  <!-- Seasons Tab Menu -->
                  <StackPanel Grid.Row="0">
                      <Grid ColumnDefinitions="*,Auto">
                      <!-- Seasons List Area -->
                      <ListBox x:Name="SeasonsListBox"
                               ItemsSource="{Binding SelectedSeries.Seasons}" 
                               SelectedItem="{Binding SelectedSeason}"
                               Background="Transparent" BorderThickness="0" Padding="0"
                               ScrollViewer.HorizontalScrollBarVisibility="Auto">
                          <ListBox.ItemsPanel>
                              <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal"/>
                              </ItemsPanelTemplate>
                          </ListBox.ItemsPanel>
                          <ListBox.ItemTemplate>
                              <DataTemplate>
                                  <TextBlock Text="{Binding SeasonNumber, Converter={StaticResource StringFormatConverter}, ConverterParameter='Series.Seasons.Format'}" 
                                             FontSize="18" FontWeight="SemiBold" 
                                             VerticalAlignment="Center"/>
                              </DataTemplate>
                          </ListBox.ItemTemplate>
                          <ListBox.Styles>
                              <!-- Custom ScrollViewer Template to move scrollbar to TOP -->
                              <Style Selector="ListBox#SeasonsListBox /template/ ScrollViewer">
                                  <Setter Property="Template">
                                      <ControlTemplate>
                                          <Grid RowDefinitions="Auto,*">
                                              <ScrollBar Name="PART_HorizontalScrollBar" 
                                                         Orientation="Horizontal" 
                                                         Grid.Row="0"
                                                         Margin="0,0,0,4"/>
                                              <ScrollContentPresenter Name="PART_ContentPresenter" 
                                                                      Grid.Row="1"
                                                                      Padding="{TemplateBinding Padding}"
                                                                      Background="{TemplateBinding Background}"/>
                                              <ScrollBar Name="PART_VerticalScrollBar" 
                                                         Orientation="Vertical" 
                                                         IsVisible="False"/>
                                          </Grid>
                                      </ControlTemplate>
                                  </Setter>
                              </Style>

                              <Style Selector="ListBoxItem">
                                  <Setter Property="Padding" Value="0,0,0,12"/>
                                  <Setter Property="Margin" Value="0,0,24,0"/>
                                  <Setter Property="Background" Value="Transparent"/>
                                  <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                  <Setter Property="BorderThickness" Value="0"/>
                                  <Setter Property="BorderBrush" Value="Transparent"/>
                                  <Setter Property="FontWeight" Value="Medium"/>
                                  <Setter Property="Template">
                                      <ControlTemplate>
                                          <Grid Background="Transparent">
                                              <Border Background="{TemplateBinding Background}"
                                                      Padding="{TemplateBinding Padding}">
                                                  <ContentPresenter Content="{TemplateBinding Content}"
                                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                              </Border>
                                              <Border x:Name="SelectionIndicator"
                                                      Height="3"
                                                      Width="0"
                                                      Background="{DynamicResource AccentBrush}"
                                                      VerticalAlignment="Bottom"
                                                      HorizontalAlignment="Center"
                                                      CornerRadius="1.5">
                                                  <Border.Transitions>
                                                      <Transitions>
                                                          <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                                      </Transitions>
                                                  </Border.Transitions>
                                              </Border>
                                          </Grid>
                                      </ControlTemplate>
                                  </Setter>
                                  <Setter Property="Transitions">
                                      <Transitions>
                                          <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                                      </Transitions>
                                  </Setter>
                              </Style>

                              <!-- PointerOver State -->
                              <Style Selector="ListBoxItem:pointerover">
                                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                              </Style>

                              <!-- Selected State -->
                              <Style Selector="ListBoxItem:selected">
                                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                  <Setter Property="FontWeight" Value="Bold"/>
                              </Style>
                              <Style Selector="ListBoxItem:selected /template/ Border#SelectionIndicator">
                                  <Setter Property="Width" Value="20"/>
                              </Style>

                              <!-- Pressed State -->
                              <Style Selector="ListBoxItem:pressed">
                                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                  <Setter Property="RenderTransform" Value="scale(0.98)"/>
                              </Style>
                          </ListBox.Styles>
                      </ListBox>

                      <!-- Download Season Button -->
                      <Button Grid.Column="1" VerticalAlignment="Center" Padding="12,8" CornerRadius="8"
                              Background="{DynamicResource Surface1Brush}" BorderThickness="0" Margin="0,0,0,12"
                              Command="{Binding DownloadSelectedSeasonCommand}"
                              IsVisible="{Binding !IsDownloadedSeriesDetailMode}"
                              ToolTip.Tip="{loc:Translate Series.Detail.DownloadSeason.Tooltip}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                              <materialIcons:MaterialIcon Kind="DownloadMultipleOutline" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                              <TextBlock Text="{loc:Translate Series.Detail.DownloadSeason}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                          </StackPanel>
                      </Button>
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="0,0,0,24"/>
                  </StackPanel>

                  <!-- Episode Row List -->
                  <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedSeason.Episodes}"
                                b:SlideTransitionBehavior.TriggerValue="{Binding SelectedSeason}">
                      <ItemsControl.ItemTemplate>
                          <DataTemplate>
                              <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PlayEpisodeCommand}"
                                      CommandParameter="{Binding}"
                                      Padding="0" Background="Transparent" BorderThickness="0" Margin="0,0,0,6" 
                                      HorizontalAlignment="Stretch" CornerRadius="8">
                                  <Panel>
                                      <!-- Separate background layer for independent transparency -->
                                      <Border Background="{DynamicResource Surface1Brush}" Opacity="0.4" CornerRadius="8" x:Name="EpBgLayer" />

                                      <Border CornerRadius="8" Padding="12,8" BorderThickness="0" BorderBrush="Transparent">
                                      <Grid ColumnDefinitions="60, 200, *, Auto">
                                          <!-- Index -->
                                          <TextBlock Text="{Binding EpisodeNumber}" FontSize="22" FontWeight="Bold" 
                                                     Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>

                                          <!-- Thumbnail -->
                                          <Border Grid.Column="1" Height="80" CornerRadius="6" ClipToBounds="True" Margin="12,0" Background="{DynamicResource Surface1Brush}">
                                              <Grid>
                                                  <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                                                  <materialIcons:MaterialIcon Kind="Play" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>

                                                   <!-- Progress Bar (Internal Sync with Overlay) -->
                                                   <Border VerticalAlignment="Bottom" Height="5" Background="#66000000" CornerRadius="0,0,6,6" IsVisible="{Binding WatchedPercentage, Converter={StaticResource CountToVisibilityConverter}}">
                                                       <Border HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="0,0,0,6" Width="{Binding WatchedPercentage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=200}"/>
                                                   </Border>
                                              </Grid>
                                          </Border>

                                          <!-- Info -->
                                          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4" Margin="12,0">
                                              <StackPanel Orientation="Horizontal" Spacing="16">
                                                  <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                  <TextBlock Text="{Binding EpisodeMetaText}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                                             IsVisible="{Binding EpisodeMetaText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                                                  <!-- Status Badge (Verified Style) -->
                                                  <Border IsVisible="{Binding IsCompleted}" VerticalAlignment="Center" ToolTip.Tip="{loc:Translate Series.Episode.Watched}" Background="Transparent">
                                                      <materialIcons:MaterialIcon Kind="CheckCircle" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}"/>
                                                  </Border>                                              </StackPanel>
                                              <TextBlock Text="{Binding TmdbEpisodeName}" 
                                                         FontSize="14" Foreground="{DynamicResource AccentBrush}" FontStyle="Italic" Opacity="0.85"
                                                         IsVisible="{Binding TmdbEpisodeName, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                              <TextBlock Text="{Binding Plot}" 
                                                         FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="40" Opacity="0.9" LineHeight="18"/>
                                          </StackPanel>

                                          <!-- Action -->
                                          <Button Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" Padding="8" Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DownloadEpisodeCommand}"
                                                  CommandParameter="{Binding}"
                                                  IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsDownloadedSeriesDetailMode, Converter={StaticResource InverseBoolConverter}}"
                                                  ToolTip.Tip="{loc:Translate Series.Episode.Download}">
                                              <materialIcons:MaterialIcon Kind="DownloadOutline" Width="22" Height="22" Foreground="{DynamicResource TextMutedBrush}" Opacity="0.6" ToolTip.Tip="{loc:Translate Player.Overlay.Download.Tooltip}"/>
                                          </Button>
                                      </Grid>
                                  </Border>
                                  </Panel>
                              </Button>
                          </DataTemplate>
                      </ItemsControl.ItemTemplate>
                      <ItemsControl.Styles>
                          <Style Selector="Button:pointerover Border#EpBgLayer">
                                <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}"/>
                                <Setter Property="Opacity" Value="0.9"/>
                            </Style>
                          <Style Selector="Button:pressed Border#EpBgLayer">
                               <Setter Property="Background" Value="{DynamicResource InteractivePressedBrush}"/>
                               <Setter Property="Opacity" Value="1.0"/>
                           </Style>
                      </ItemsControl.Styles>
                  </ItemsControl>
                </Grid>

              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>


      </Grid>
    </Grid>



    <!-- Player Area (full window overlay) -->
    <Grid x:Name="PlayerArea" Grid.RowSpan="3" Background="Transparent" IsVisible="False" ClipToBounds="True" ZIndex="5000">
      <!-- Main Content Container with Rounded Corners for PiP -->
      <Border x:Name="PiPContainer"
              CornerRadius="0"
              ClipToBounds="True"
              Background="Black">
          <controls:MemoryVideoView x:Name="VideoSurface">
              <controls:MemoryVideoView.OverlayContent>
                  <Grid>
                      <views:WatermarkView x:Name="PiPWatermark" DataContext="{Binding WatermarkViewModel}" ZIndex="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,100"/>
                      <Border x:Name="MouseCaptureLayer"
                              ZIndex="2500"
                              Background="Transparent"
                              PointerMoved="MouseCaptureLayer_PointerMoved"
                              PointerPressed="MouseCaptureLayer_PointerPressed"
                              PointerReleased="MouseCaptureLayer_PointerReleased"/>

                      <!-- PiP Window Frame (Border & Shadows) - Visible only in PiP -->
                      <Border x:Name="PiPFrame"
                              DataContext="{Binding #OverlayControl.DataContext}" x:DataType="vm:PlayerViewModel"
                              BorderBrush="#44FFFFFF"
                              BorderThickness="1"
                              CornerRadius="0"
                              IsVisible="{Binding IsPiPControlsVisible}"
                              ZIndex="5001"
                              IsHitTestVisible="False">
                          <Border.BoxShadow>
                              <BoxShadows>0 10 40 0 #AA000000</BoxShadows>
                          </Border.BoxShadow>
                      </Border>

                  <!-- PiP Central Controls (Netflix Style) -->
                  <StackPanel x:Name="PiPCentralControls"
                              Orientation="Horizontal"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Spacing="40"
                              IsVisible="{Binding IsPiPControlsVisible}"
                              ZIndex="6000"
                              x:DataType="vm:PlayerViewModel">
                      
                      <!-- VOD Skip Backward 10s -->
                      <Button Command="{Binding SkipBackwardCommand}" CommandParameter="10"
                              Width="48" Height="48"
                              IsVisible="{Binding !IsLiveContent}"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="{loc:Translate Player.Overlay.Backward}">
                          <materialIcons:MaterialIcon Kind="Rewind10" Width="18" Height="18" Foreground="White" Opacity="0.9"/>
                      </Button>

                      <!-- Live TV Previous Channel -->
                      <Button x:Name="PlayPreviousLiveChannelPiPBtn"
                              Click="PlayPreviousLiveChannelPiP_Click"
                              Width="48" Height="48"
                              IsVisible="{Binding IsLiveContent}"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="{loc:Translate Player.Overlay.PreviousChannel}">
                          <materialIcons:MaterialIcon Kind="SkipPrevious" Width="18" Height="18" Foreground="White" Opacity="0.9"/>
                      </Button>

                      <!-- Play/Pause (Large Center) -->
                      <Button Command="{Binding PlayPauseCommand}"
                              Width="80" Height="80"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="{loc:Translate Player.Overlay.PlayPause.Tooltip}">
                          <Grid>
                              <materialIcons:MaterialIcon Kind="Pause" 
                                                          Width="36" Height="36" Foreground="White" 
                                                          IsVisible="{Binding IsPlaying}"/>
                              <materialIcons:MaterialIcon Kind="Play" 
                                                          Width="36" Height="36" Foreground="White" 
                                                          IsVisible="{Binding IsPlaying, Converter={StaticResource InverseBoolConverter}}"/>
                          </Grid>
                      </Button>

                      <!-- VOD Skip Forward 10s -->
                      <Button Command="{Binding SkipForwardCommand}" CommandParameter="10"
                              Width="48" Height="48"
                              IsVisible="{Binding !IsLiveContent}"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="{loc:Translate Player.Overlay.Forward}">
                           <materialIcons:MaterialIcon Kind="FastForward10" Width="18" Height="18" Foreground="White" Opacity="0.9"/>
                      </Button>

                      <!-- Live TV Next Channel -->
                      <Button x:Name="PlayNextLiveChannelPiPBtn"
                              Click="PlayNextLiveChannelPiP_Click"
                              Width="48" Height="48"
                              IsVisible="{Binding IsLiveContent}"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="{loc:Translate Player.Overlay.NextChannel}">
                          <materialIcons:MaterialIcon Kind="SkipNext" Width="18" Height="18" Foreground="White" Opacity="0.9"/>
                      </Button>
                  </StackPanel>

                  <!-- PiP Bottom-Right Controls -->
                  <Button x:Name="PiPBottomControls"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="12"
                          Width="40" Height="40"
                          Background="Transparent" BorderThickness="0"
                          Click="PiPReturn_Click"
                          IsVisible="{Binding #PiPCentralControls.IsVisible}"
                          ZIndex="6000"
                          Classes="pipButton"
                          ToolTip.Tip="{loc:Translate Player.Overlay.Fullscreen.Tooltip}">
                      <materialIcons:MaterialIcon Kind="ArrowExpand" Width="18" Height="18" Foreground="White" Opacity="0.9"/>
                  </Button>

                  <!-- PiP Resize Grips (Proportional) -->
                  <!-- Corners -->
                  <!-- TopLeft, TopRight, BottomLeft removed to prevent jitter -->

                  <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="24" Height="24" Background="Transparent" 
                          Cursor="BottomRightCorner" PointerPressed="PiPCornerResize_PointerPressed" 
                          PointerMoved="PiPCornerResize_PointerMoved" PointerReleased="PiPCornerResize_PointerReleased"
                          Tag="BottomRight" ZIndex="7000" IsVisible="{Binding #PiPBottomControls.IsVisible}"/>
                  
                  <!-- Edges -->
                  <!-- Top and Left removed to prevent jitter -->

                  <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8" Margin="0,24" Background="Transparent" 
                          Cursor="SizeWestEast" PointerPressed="PiPCornerResize_PointerPressed" 
                          PointerMoved="PiPCornerResize_PointerMoved" PointerReleased="PiPCornerResize_PointerReleased"
                          Tag="Right" ZIndex="7000" IsVisible="{Binding #PiPBottomControls.IsVisible}"/>

                  <Grid x:Name="PlayerOverlayLayer" ZIndex="2600" x:DataType="vm:PlayerViewModel">
                    <views:VideoOverlayView x:Name="OverlayControl" ZIndex="2" IsVisible="{Binding IsResumeDialogVisible, Converter={StaticResource InverseBoolConverter}}"/>
                    <!-- Next Episode Prompt (binds to PlayerViewModel via OverlayControl's DataContext) -->
                    <Border x:Name="NextEpisodePrompt" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,140" Width="260"
                            DataContext="{Binding #OverlayControl.DataContext}" x:DataType="vm:PlayerViewModel"
                            IsVisible="{Binding IsNextEpisodePromptVisible}" ZIndex="3000">
                      <Grid RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Text="{loc:Translate Player.Overlay.NextEpisode}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                          <TextBlock Text="{Binding NextEpisode.Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Row="2" Command="{Binding PlayNextEpisodeCommand}"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" Padding="16,10" BorderThickness="0" HorizontalAlignment="Stretch" Cursor="Hand">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{loc:Translate Player.NextEpisode.WatchNow}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </Grid>

                  <!-- Resume Dialog -->
                  <Border IsVisible="{Binding IsResumeDialogVisible}"
                          DataContext="{Binding #OverlayControl.DataContext}"
                          x:DataType="vm:PlayerViewModel"
                          Background="#B3000000"
                          ZIndex="6000"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">

                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="16"
                            Padding="40,32"
                            Width="400"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                      <Border.BoxShadow>
                        <BoxShadows>0 24 64 0 #88000000</BoxShadows>
                      </Border.BoxShadow>

                      <StackPanel Spacing="24">

                        <!-- İkon + Başlık -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                          <materialIcons:MaterialIcon Kind="PlayCircleOutline"
                                                      Width="48" Height="48"
                                                      Foreground="{DynamicResource AccentBrush}"
                                                      HorizontalAlignment="Center"/>
                          <TextBlock Text="{loc:Translate Player.Resume.Title}"
                                     FontSize="19" FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Progress bilgisi -->
                        <Border Background="{DynamicResource Surface1Brush}"
                                CornerRadius="8" Padding="16,10">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ClockOutline" Width="16" Height="16"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <TextBlock Text="{loc:Translate Player.Resume.LastPosition}" 
                                         Foreground="{DynamicResource TextMutedBrush}" 
                                         FontSize="14"/>
                              <TextBlock Text="{Binding ResumePositionText}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontSize="14"
                                         FontWeight="SemiBold"/>
                            </StackPanel>
                          </StackPanel>
                        </Border>

                        <!-- Butonlar -->
                        <StackPanel Spacing="12">

                          <!-- ── PREMIUM: Kaldığım Yerden ── -->
                          <Panel>
                            <!-- Premium kullanıcı: normal buton -->
                            <Button Command="{Binding ResumeFromPositionCommand}"
                                    IsVisible="{Binding IsPremiumResume}"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,15"
                                    BorderThickness="0" CornerRadius="8" Cursor="Hand">
                              <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                  <GradientStop Color="#8B5CF6" Offset="0"/>
                                  <GradientStop Color="#A855F7" Offset="1"/>
                                </LinearGradientBrush>
                              </Button.Background>
                              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                <materialIcons:MaterialIcon Kind="Play" Width="18" Height="18" Foreground="White"/>
                                <TextBlock Text="{loc:Translate Player.Resume.Continue}"
                                           Foreground="White" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                              </StackPanel>
                            </Button>

                            <!-- Ücretsiz kullanıcı: kilitli görünüm (Etkileşimsiz) -->
                            <Button IsVisible="{Binding !IsPremiumResume}"
                                    IsEnabled="False"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,15"
                                    BorderThickness="1" CornerRadius="8"
                                    Background="{DynamicResource Surface1Brush}">
                              <Button.BorderBrush>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                  <GradientStop Color="#508B5CF6" Offset="0"/>
                                  <GradientStop Color="#50A855F7" Offset="1"/>
                                </LinearGradientBrush>
                              </Button.BorderBrush>
                              <Grid ColumnDefinitions="*,Auto">

                                <!-- Sol: içerik -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            HorizontalAlignment="Center" Spacing="10">
                                  <materialIcons:MaterialIcon Kind="Play" Width="18" Height="18"
                                                              Foreground="{DynamicResource TextMutedBrush}"
                                                              VerticalAlignment="Center"/>
                                  <TextBlock Text="{loc:Translate Player.Resume.Continue}"
                                             Foreground="{DynamicResource TextMutedBrush}"
                                             FontSize="15" FontWeight="SemiBold"
                                             VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Sağ: Standart Kilit İkonu -->
                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" 
                                                            Width="18" Height="18"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,16,0"/>

                              </Grid>
                            </Button>
                          </Panel>

                          <!-- Baştan Başla (her zaman aktif) -->
                          <Button Command="{Binding StartFromBeginningCommand}"
                                  HorizontalAlignment="Stretch"
                                  Padding="0,15"
                                  Background="{DynamicResource Surface0Brush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  FontSize="15"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  CornerRadius="8" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                              <materialIcons:MaterialIcon Kind="SkipBackward" Width="18" Height="18"/>
                              <TextBlock Text="{loc:Translate Player.Resume.StartOver}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>

                        </StackPanel>

                        <!-- Ücretsiz kullanıcıya küçük bilgi notu (Etkileşimsiz) -->
                        <Border IsVisible="{Binding !IsPremiumResume}"
                                Background="Transparent" Padding="4"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <materialIcons:MaterialIcon Kind="Crown" Width="14" Height="14"
                                                          Foreground="{DynamicResource AccentLightBrush}"/>
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Translate Common.Premium}" 
                                           FontSize="12" Foreground="{DynamicResource AccentLightBrush}"/>
                                <TextBlock Text="{loc:Translate Player.Resume.UpgradeNote}"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                              </StackPanel>
                            </StackPanel>
                        </Border>

                      </StackPanel>
                    </Border>
                  </Border>
              </Grid>
          </controls:MemoryVideoView.OverlayContent>
      </controls:MemoryVideoView>
      </Border>
    </Grid>

    <!-- ========== STATUS BAR ========== -->
    <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Height="40">
      <Grid>
        <!-- Progressive Channel Loading Bar -->
        <ProgressBar IsVisible="{Binding IsChannelLoading}" 
                     Value="{Binding ChannelLoadingProgress}" 
                     Minimum="0" Maximum="100"
                     Height="2" VerticalAlignment="Top" 
                     Background="Transparent" 
                     Foreground="{DynamicResource AccentBrush}" 
                     BorderThickness="0"/>

        <Grid Margin="20,0" ColumnDefinitions="*,Auto">
          <!-- Left: Status & Stats -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
            <ProgressBar IsIndeterminate="True" Width="14" Height="14" 
                         IsVisible="{Binding IsLoading}" 
                         Theme="{StaticResource ProgressRingTheme}"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center">
              <TextBlock.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                </Transitions>
              </TextBlock.Transitions>
            </TextBlock>
                        <TextBlock Text="{Binding ChannelLoadingStats}" 
                       IsVisible="{Binding IsChannelLoading}" 
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" 
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <!-- Right: Badges -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
            <!-- Enhanced Connection Health Badge -->
            <Border IsVisible="{Binding ConnectionQuality, Converter={StaticResource ConnectionHealthToVisibilityConverter}}"
                    CornerRadius="20" Padding="10,4" 
                    Background="{DynamicResource Surface1Brush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Grid>
                  <!-- Soft Glow -->
                  <Ellipse Width="12" Height="12" 
                           Fill="{Binding ConnectionQuality, Converter={StaticResource ConnectionHealthToBrushConverter}}" 
                           Opacity="0.4"
                           VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse.Effect>
                      <BlurEffect Radius="6"/>
                    </Ellipse.Effect>
                  </Ellipse>
                  <!-- Inner Dot -->
                  <Ellipse Width="7" Height="7" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Fill="{Binding ConnectionQuality, Converter={StaticResource ConnectionHealthToBrushConverter}}">
                    <Ellipse.Transitions>
                      <Transitions>
                        <BrushTransition Property="Fill" Duration="0:0:0.5"/>
                      </Transitions>
                    </Ellipse.Transitions>
                  </Ellipse>
                </Grid>
                <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                           LetterSpacing="0.3"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Global Loading Overlay (Visible during refresh etc.) -->
    <Grid Grid.RowSpan="3" Background="#AA000000" IsVisible="{Binding IsGlobalLoading}" ZIndex="10000">
        <Border Background="{DynamicResource Bg1Brush}" 
                CornerRadius="16" 
                Padding="32" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                BoxShadow="0 10 30 5 #80000000">
            <StackPanel Spacing="24">
                <controls:PremiumSpinner Width="80" Height="80">
                    <!-- Pulsing App Logo in Center -->
                    <Image Source="avares://Noctra.Avalonia/Assets/LogoGray.png" 
                           Width="32" Height="32"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           RenderTransformOrigin="50%,50%">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Image.RenderTransform>
                        <Image.Styles>
                            <Style Selector="Image">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="CubicEaseInOut">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="0.5"/>
                                            <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                                        </KeyFrame>
                                        <KeyFrame Cue="50%">
                                            <Setter Property="Opacity" Value="1.0"/>
                                            <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                                            <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="0.5"/>
                                            <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Image.Styles>
                    </Image>
                </controls:PremiumSpinner>
                <TextBlock Text="{Binding GlobalLoadingMessage}" 
                           Foreground="{DynamicResource TextPrimaryBrush}" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>

  </Grid>
</Window>

