<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Noctra.ViewModels"
        xmlns:models="using:Noctra.Models"
        xmlns:views="using:Noctra.Avalonia.Views"
        xmlns:controls="using:Noctra.Avalonia.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Noctra.Avalonia.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://Noctra.Avalonia/Assets/Logo.png"
        Title="Noctra"
        TransparencyLevelHint="None"
        Width="1400" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg0Brush}">

  <Window.Styles>
    <Style Selector="Button.SettingsGearButton materialIcons|MaterialIcon#SettingsGearIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="RenderTransform" Value="rotate(0deg)"/>
    </Style>
    <Style Selector="Button.SettingsGearButton:pointerover materialIcons|MaterialIcon#SettingsGearIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="RenderTransform" Value="rotate(120deg)"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="64,*,48">

    <!-- ========== HEADER BAR ========== -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderGradientBrush}" Padding="24,0" PointerPressed="HeaderBar_PointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- Logo -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12" Margin="8,0,0,0">
          <Image Source="avares://Noctra.Avalonia/Assets/Logo.png" Height="32" />
          <TextBlock Text="Noctra" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Search Button -->
        <Button Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,24,0"
                Command="{Binding OpenSearchCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8">
          <StackPanel Orientation="Horizontal">
            <materialIcons:MaterialIcon Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0"/>
            <TextBlock Text="Ara" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
          </StackPanel>
        </Button>

        <!-- Header Actions -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <!-- Settings Button -->
          <Button Classes="SettingsGearButton" Click="SettingsButton_Click" Cursor="Hand" ToolTip.Tip="Ayarlar"
                  Width="48" Height="48" Background="Transparent" BorderThickness="0" CornerRadius="24">
            <materialIcons:MaterialIcon x:Name="SettingsGearIcon" Kind="CogOutline" Width="22" Height="22" RenderTransformOrigin="50%,50%">
              <materialIcons:MaterialIcon.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22"/>
                </Transitions>
              </materialIcons:MaterialIcon.Transitions>
            </materialIcons:MaterialIcon>
          </Button>
          <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="0,8" Opacity="0.5"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ========== MAIN CONTENT AREA ========== -->
    <Grid Grid.Row="1" ColumnDefinitions="280,*">

      <!-- SIDEBAR -->
      <Border Grid.Column="0" Background="{DynamicResource Bg1Brush}">
        <StackPanel Margin="16,24,16,16">
          <!-- Home -->
          <Button Classes="navItem" Click="NavigateHome_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Home}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,14"><materialIcons:MaterialIcon Kind="HomeOutline" Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Ana Sayfa" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- Live TV -->
          <Button Classes="navItem" Click="NavigateLive_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Live}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,14"><materialIcons:MaterialIcon Kind="Television" Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Canl&#305; TV" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- Movies -->
          <Button Classes="navItem" Click="NavigateMovies_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Movies}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,14"><materialIcons:MaterialIcon Kind="MovieOpenOutline" Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Filmler" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- Series -->
          <Button Classes="navItem" Click="NavigateSeries_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Series}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,14"><materialIcons:MaterialIcon Kind="Television" Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Diziler" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- My List -->
          <Button Classes="navItem" Click="NavigateMyList_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.MyList}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,14"><materialIcons:MaterialIcon Kind="PlaylistPlus" Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Listem" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- Divider -->
          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20"/>
          <!-- Favorites -->
          <Button Classes="navItem" Click="NavigateFavorites_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Favorites}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,12"><materialIcons:MaterialIcon Kind="StarOutline" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Favoriler" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- History -->
          <Button Classes="navItem" Click="NavigateHistory_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.History}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,12"><materialIcons:MaterialIcon Kind="History" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Ge&#231;mi&#351;" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- Downloads -->
          <Button Classes="navItem" Click="NavigateDownloads_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Downloads}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,12"><materialIcons:MaterialIcon Kind="Download" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="&#304;ndirilenler" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center"/></Grid>
          </Button>
        </StackPanel>
      </Border>

      <!-- MAIN CONTENT -->
      <Grid Grid.Column="1">

        <!-- 1. HOME VIEW -->
        <ScrollViewer x:Name="HomeView" IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Home}}"
                      ScrollChanged="HomeView_ScrollChanged">
          <StackPanel Margin="24">
            <!-- HERO SECTION -->
            <Border Height="500" CornerRadius="16" Margin="0,0,0,40" ClipToBounds="True">
              <Grid x:Name="HeroGrid" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <TransformGroup>
                    <TranslateTransform/>
                    <ScaleTransform/>
                  </TransformGroup>
                </Grid.RenderTransform>
                <controls:RemoteImage x:Name="HeroImage" Stretch="UniformToFill" Url="{Binding FeaturedChannel.CoverUrl}"/>
                <Border>
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Color="Transparent" Offset="0.0"/>
                      <GradientStop Color="#AA0B0614" Offset="0.5"/>
                      <GradientStop Color="#0B0614" Offset="1.0"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Bottom" Margin="60,0,60,60">
                  <TextBlock Text="{Binding FeaturedChannel.Name}" FontSize="56" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left"/>
                  <StackPanel Orientation="Horizontal" Margin="0,16,0,24">
                    <Border Background="#7C3AED" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                      <TextBlock Text="LIVE" FontSize="12" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="{Binding FeaturedChannel.GroupTitle}" FontSize="16" Foreground="#C4B5FD" VerticalAlignment="Center"/>
                    <TextBlock Text=" &#8226; " FontSize="16" Foreground="#666" Margin="8,0"/>
                    <TextBlock Text="HD" FontSize="16" Foreground="#22C55E" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Text="{Binding FeaturedChannel.Description}" FontSize="16" Foreground="#E5E5E5" TextWrapping="Wrap" MaxWidth="600" LineHeight="24" Margin="0,0,0,24"/>
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button Command="{Binding PlayFeaturedCommand}" Height="56" Padding="32,0" Background="White" BorderThickness="0" Cursor="Hand" CornerRadius="8">
                      <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Play" Width="20" Height="20" Foreground="Black" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="&#304;zle" FontSize="18" Foreground="Black" FontWeight="Bold" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Command="{Binding AddToMyListCommand}" CommandParameter="{Binding FeaturedChannel}" Height="56" Width="56" Background="#A06D6D6E" BorderThickness="0" Cursor="Hand" CornerRadius="28" ToolTip.Tip="Listem'e Ekle">
                      <Grid>
                        <materialIcons:MaterialIcon Kind="Check" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsVisible="{Binding FeaturedChannel.IsInMyList}"/>
                        <materialIcons:MaterialIcon Kind="Plus" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsVisible="{Binding FeaturedChannel.IsInMyList, Converter={StaticResource InverseBoolConverter}}"/>
                      </Grid>
                    </Button>
                    <Button Height="56" Padding="32,0" Background="#A06D6D6E" BorderThickness="0" Cursor="Hand" CornerRadius="8">
                      <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="InformationOutline" Width="20" Height="20" Foreground="White" Margin="0,0,12,0"/>
                        <TextBlock Text="Daha Fazla Bilgi" FontSize="18" Foreground="White"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Rail: &#304;zlemeye Devam Et -->
            <StackPanel IsVisible="{Binding ContinueWatching.Count, Converter={StaticResource CountToVisibilityConverter}}" Margin="0,0,0,40">
              <TextBlock Text="&#304;zlemeye Devam Et" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
              <ItemsControl ItemsSource="{Binding ContinueWatching}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:Channel">
                    <Button Width="300" Height="169" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                      <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusSmall}" ClipToBounds="True">
                        <Grid>
                          <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}" Opacity="0.8"/>
                          <Border Background="{DynamicResource HeroOverlayBrush}"/>
                          <StackPanel VerticalAlignment="Bottom" Margin="12">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Rail: &#350;u An Trend -->
            <StackPanel Margin="0,0,0,40">
              <TextBlock Text="&#350;u An Trend" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
              <ItemsControl ItemsSource="{Binding TrendingChannels}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:Channel">
                    <Button Width="300" Height="169" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                      <Button.ContextFlyout>
                        <MenuFlyout>
                          <MenuItem Header="Listem'e Ekle/&#199;&#305;kar" Click="Context_AddToMyList_Click" Tag="{Binding}" CommandParameter="{Binding}"
                                    IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
                          <MenuItem Header="Favorilere Ekle/&#199;&#305;kar" Click="Context_ToggleFavorite_Click" Tag="{Binding}" CommandParameter="{Binding}"
                                    IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
                        </MenuFlyout>
                      </Button.ContextFlyout>
                      <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusSmall}" ClipToBounds="True">
                        <Grid>
                          <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}" Opacity="0.8"/>
                          <Border Background="{DynamicResource HeroOverlayBrush}"/>
                          <StackPanel VerticalAlignment="Bottom" Margin="12">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Rail: Pop&#252;ler Filmler -->
            <StackPanel Margin="0,0,0,40">
              <TextBlock Text="Pop&#252;ler Filmler" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
              <ItemsControl ItemsSource="{Binding LatestMovies}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:Channel">
                    <Button Width="160" Height="240" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                      <Button.ContextFlyout>
                        <MenuFlyout>
                          <MenuItem Header="Listem'e Ekle/&#199;&#305;kar" Click="Context_AddToMyList_Click" Tag="{Binding}" CommandParameter="{Binding}"
                                    IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
                          <MenuItem Header="Favorilere Ekle/&#199;&#305;kar" Click="Context_ToggleFavorite_Click" Tag="{Binding}" CommandParameter="{Binding}"
                                    IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
                        </MenuFlyout>
                      </Button.ContextFlyout>
                      <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusSmall}" ClipToBounds="True">
                        <Grid>
                          <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                          <Border Background="{DynamicResource HeroOverlayBrush}"/>
                          <StackPanel VerticalAlignment="Bottom" Margin="12">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Rail: Yeni Diziler -->
            <StackPanel Margin="0,0,0,40">
              <TextBlock Text="Yeni Diziler" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
              <ItemsControl ItemsSource="{Binding LatestSeries}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:Series">
                    <Button Width="160" Height="240" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                      <Button.ContextFlyout>
                        <MenuFlyout>
                          <MenuItem Header="Listem'e Ekle/&#199;&#305;kar" Click="Context_AddToMyList_Click" Tag="{Binding}" CommandParameter="{Binding}"
                                    IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
                          <MenuItem Header="Favorilere Ekle/&#199;&#305;kar" Click="Context_ToggleFavorite_Click" Tag="{Binding}" CommandParameter="{Binding}"
                                    IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
                        </MenuFlyout>
                      </Button.ContextFlyout>
                      <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusSmall}" ClipToBounds="True">
                        <Grid>
                          <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                          <Border Background="{DynamicResource HeroOverlayBrush}"/>
                          <StackPanel VerticalAlignment="Bottom" Margin="12">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Genre}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- 2. MOVIES VIEW -->
        <ScrollViewer x:Name="MoviesView" IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Movies}}"
                      ScrollChanged="MoviesView_ScrollChanged">
          <StackPanel Margin="24">
            <Grid Margin="0,0,0,24" ColumnDefinitions="*,Auto">
              <TextBlock Text="Filmler" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <ComboBox Width="260" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"/>
                <Button Content="T&#252;m&#252;" Width="64" Click="ClearGroupSelection_Click"/>
                <ComboBox Width="240" ItemsSource="{Binding SortOptions}" SelectedValue="{Binding SelectedSortOrder}" SelectedValueBinding="{Binding Key}" DisplayMemberBinding="{Binding Value}"/>
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding FilteredChannels}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Channel">
                  <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                    <Button.ContextFlyout>
                      <MenuFlyout>
                        <MenuItem Header="Listem'e Ekle/&#199;&#305;kar"
                                  Click="Context_AddToMyList_Click"
                                  Tag="{Binding}" CommandParameter="{Binding}"
                                  IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
                        <MenuItem Header="Favorilere Ekle/&#199;&#305;kar"
                                  Click="Context_ToggleFavorite_Click"
                                  Tag="{Binding}" CommandParameter="{Binding}"
                                  IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
                      </MenuFlyout>
                    </Button.ContextFlyout>
                    <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                      <StackPanel Spacing="6">
                        <Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12">
                          <controls:RemoteImage Width="60" Stretch="Uniform" Url="{Binding CoverUrl}"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,96,0,0"
                        IsVisible="{Binding FilteredChannels.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}">
              <Image Source="avares://Noctra.Avalonia/Assets/Logo.png" Width="88" Height="88" Stretch="Uniform" Opacity="0.75"/>
              <TextBlock Text="Film bulunamad&#305;" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,14,0,6"/>
              <TextBlock Text="Bu filtrede g&#246;sterilecek film yok." FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- 3. SERIES VIEW -->
        <ScrollViewer x:Name="SeriesView" IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Series}}"
                      ScrollChanged="SeriesView_ScrollChanged">
          <StackPanel Margin="24">
            <Grid Margin="0,0,0,24" ColumnDefinitions="*,Auto">
              <TextBlock Text="Diziler" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <ComboBox Width="260" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"/>
                <Button Content="T&#252;m&#252;" Width="64" Click="ClearGroupSelection_Click"/>
                <ComboBox Width="240" ItemsSource="{Binding SortOptions}" SelectedValue="{Binding SelectedSortOrder}" SelectedValueBinding="{Binding Key}" DisplayMemberBinding="{Binding Value}"/>
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding SeriesViewItems}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Series">
                  <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                    <Button.ContextFlyout>
                      <MenuFlyout>
                        <MenuItem Header="Listem'e Ekle/&#199;&#305;kar"
                                  Click="Context_AddToMyList_Click"
                                  Tag="{Binding}" CommandParameter="{Binding}"
                                  IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
                        <MenuItem Header="Favorilere Ekle/&#199;&#305;kar"
                                  Click="Context_ToggleFavorite_Click"
                                  Tag="{Binding}" CommandParameter="{Binding}"
                                  IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
                      </MenuFlyout>
                    </Button.ContextFlyout>
                    <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                      <StackPanel Spacing="6">
                        <Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12">
                          <controls:RemoteImage Width="60" Stretch="Uniform" Url="{Binding CoverUrl}"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SeasonCountSafe, StringFormat='Sezon: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextAlignment="Center" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,96,0,0"
                        IsVisible="{Binding !SeriesViewItems.Count}">
              <Image Source="avares://Noctra.Avalonia/Assets/Logo.png" Width="88" Height="88" Stretch="Uniform" Opacity="0.75"/>
              <TextBlock Text="Dizi bulunamad&#305;" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,14,0,6"/>
              <TextBlock Text="Bu filtrede g&#246;sterilecek dizi yok." FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- 4. LIVE TV VIEW -->
        <ScrollViewer x:Name="LiveView" IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Live}}"
                      ScrollChanged="LiveView_ScrollChanged">
          <StackPanel Margin="24">
            <Grid Margin="0,0,0,24" ColumnDefinitions="*,Auto">
              <TextBlock Text="Canl&#305; TV" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <ComboBox Width="260" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"/>
                <Button Content="T&#252;m&#252;" Width="64" Click="ClearGroupSelection_Click"/>
                <ComboBox Width="240" ItemsSource="{Binding SortOptions}" SelectedValue="{Binding SelectedSortOrder}" SelectedValueBinding="{Binding Key}" DisplayMemberBinding="{Binding Value}"/>
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding FilteredChannels}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Channel">
                  <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                    <Button.ContextFlyout>
                      <MenuFlyout>
                        <MenuItem Header="Favorilere Ekle/&#199;&#305;kar"
                                  Click="Context_ToggleFavorite_Click"
                                  Tag="{Binding}" CommandParameter="{Binding}"
                                  IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
                      </MenuFlyout>
                    </Button.ContextFlyout>
                    <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                      <StackPanel Spacing="6">
                        <Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12">
                          <controls:RemoteImage Width="60" Stretch="Uniform" Url="{Binding CoverUrl}"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,96,0,0"
                        IsVisible="{Binding FilteredChannels.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}">
              <Image Source="avares://Noctra.Avalonia/Assets/Logo.png" Width="88" Height="88" Stretch="Uniform" Opacity="0.75"/>
              <TextBlock Text="Kanal bulunamad&#305;" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,14,0,6"/>
              <TextBlock Text="Bu filtrede g&#246;sterilecek canl&#305; kanal yok." FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- 5. SEARCH VIEW -->
        <ScrollViewer x:Name="SearchView" IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Search}}">
          <ScrollViewer.Resources>
            <DataTemplate x:Key="SearchChannelCardTemplate" x:DataType="models:Channel">
              <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                <Button.ContextFlyout>
                  <MenuFlyout>
                    <MenuItem Header="Listem'e Ekle/&#199;&#305;kar"
                              Click="Context_AddToMyList_Click"
                              Tag="{Binding}" CommandParameter="{Binding}"
                              IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
                    <MenuItem Header="Favorilere Ekle/&#199;&#305;kar"
                              Click="Context_ToggleFavorite_Click"
                              Tag="{Binding}" CommandParameter="{Binding}"
                              IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
                  </MenuFlyout>
                </Button.ContextFlyout>
                <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                  <StackPanel>
                    <Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12">
                      <controls:RemoteImage Width="60" Stretch="Uniform" Url="{Binding CoverUrl}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding GroupTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>

            <DataTemplate x:Key="SearchSeriesCardTemplate" x:DataType="models:Series">
              <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                <Button.ContextFlyout>
                  <MenuFlyout>
                    <MenuItem Header="Listem'e Ekle/&#199;&#305;kar"
                              Click="Context_AddToMyList_Click"
                              Tag="{Binding}" CommandParameter="{Binding}"
                              IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
                    <MenuItem Header="Favorilere Ekle/&#199;&#305;kar"
                              Click="Context_ToggleFavorite_Click"
                              Tag="{Binding}" CommandParameter="{Binding}"
                              IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
                  </MenuFlyout>
                </Button.ContextFlyout>
                <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                  <StackPanel>
                    <Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12" ClipToBounds="True">
                      <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SeasonCountSafe, StringFormat='Sezon: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextAlignment="Center" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ScrollViewer.Resources>

          <StackPanel Margin="24">
            <TextBlock Text="Arama Sonu&#231;lar&#305;" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>
            <!-- Search Suggestion -->
            <Border Margin="0,0,0,20" Padding="12,10" Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusSmall}"
                    IsVisible="{Binding SearchSuggestion, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Bunu mu demek istediniz?" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <Button Content="{Binding SearchSuggestion}" Margin="10,0,0,0" Padding="10,4" Command="{Binding ApplySearchSuggestionCommand}"
                        Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"/>
              </StackPanel>
            </Border>

            <!-- Live results -->
            <StackPanel Margin="0,0,0,24" IsVisible="{Binding SearchLiveChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
              <TextBlock Text="Canl&#305; TV" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
              <ItemsControl ItemsSource="{Binding SearchLiveChannels}" ItemTemplate="{StaticResource SearchChannelCardTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>

            <!-- Series results -->
            <StackPanel Margin="0,0,0,24" IsVisible="{Binding SearchSeriesChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
              <TextBlock Text="Dizi" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
              <ItemsControl ItemsSource="{Binding SearchSeriesChannels}" ItemTemplate="{StaticResource SearchSeriesCardTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>

            <!-- VOD results -->
            <StackPanel Margin="0,0,0,24" IsVisible="{Binding SearchVodChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
              <TextBlock Text="VOD" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
              <ItemsControl ItemsSource="{Binding SearchVodChannels}" ItemTemplate="{StaticResource SearchChannelCardTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>

            <!-- Similar Results -->
            <StackPanel Margin="0,8,0,24" IsVisible="{Binding ShowSearchSimilarSection}">
              <TextBlock Text="Yak&#305;n Sonu&#231;lar" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

              <!-- Similar Live -->
              <StackPanel Margin="0,0,0,20" IsVisible="{Binding SearchSimilarLiveChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock Text="Canl&#305; TV" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding SearchSimilarLiveChannels}" ItemTemplate="{StaticResource SearchChannelCardTemplate}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>

              <!-- Similar Series -->
              <StackPanel Margin="0,0,0,20" IsVisible="{Binding SearchSimilarSeriesChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock Text="Dizi" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding SearchSimilarSeriesChannels}" ItemTemplate="{StaticResource SearchSeriesCardTemplate}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>

              <!-- Similar VOD -->
              <StackPanel Margin="0,0,0,8" IsVisible="{Binding SearchSimilarVodChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock Text="VOD" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding SearchSimilarVodChannels}" ItemTemplate="{StaticResource SearchChannelCardTemplate}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <!-- Empty search -->
            <StackPanel HorizontalAlignment="Center" Margin="0,100,0,0" IsVisible="{Binding ShowSearchEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
              <TextBlock Text="Sonu&#231; bulunamad&#305;." FontSize="16" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <!-- 6. MY LIST VIEW -->
        <ScrollViewer x:Name="MyListView" IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.MyList}}">
          <StackPanel Margin="24">
            <TextBlock Text="Listem" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>
            <ItemsControl ItemsSource="{Binding MyList}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                  <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Listeden &#199;&#305;kar"
                                  Click="Context_RemoveFromMyList_Click"
                                  Tag="{Binding}" CommandParameter="{Binding}"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                      <StackPanel><Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12"><controls:RemoteImage Width="60" Stretch="Uniform" Url="{Binding CoverUrl}"/></Border><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,96,0,0" IsVisible="{Binding ShowMyListEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
              <Image Source="avares://Noctra.Avalonia/Assets/Logo.png" Width="88" Height="88" Stretch="Uniform" Opacity="0.75"/>
              <TextBlock Text="Listeniz bo&#351;" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,14,0,6"/>
              <TextBlock Text="&#304;&#231;erik ekledi&#287;inizde burada g&#246;r&#252;necek." FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- 7. FAVORITES VIEW -->
        <ScrollViewer x:Name="FavoritesView" IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Favorites}}">
          <StackPanel Margin="24">
            <TextBlock Text="Favoriler" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>
            <ItemsControl ItemsSource="{Binding FavoriteChannels}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                  <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Favorilerden &#199;&#305;kar"
                                  Click="Context_RemoveFromFavorites_Click"
                                  Tag="{Binding}" CommandParameter="{Binding}"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                      <StackPanel><Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12"><controls:RemoteImage Width="60" Stretch="Uniform" Url="{Binding CoverUrl}"/></Border><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,96,0,0" IsVisible="{Binding ShowFavoritesEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
              <Image Source="avares://Noctra.Avalonia/Assets/Logo.png" Width="88" Height="88" Stretch="Uniform" Opacity="0.75"/>
              <TextBlock Text="Favoriler bo&#351;" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,14,0,6"/>
              <TextBlock Text="Be&#287;endi&#287;iniz i&#231;erikleri favorilere ekleyin." FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- 8. HISTORY VIEW -->
        <ScrollViewer x:Name="HistoryView" IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.History}}">
          <StackPanel Margin="24">
            <TextBlock Text="Ge&#231;mi&#351;" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>
            <TextBlock Text="Canl&#305; TV" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"
                       IsVisible="{Binding HistoryLiveChannels.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
            <ItemsControl ItemsSource="{Binding HistoryLiveChannels}" IsVisible="{Binding HistoryLiveChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Channel">
                  <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                    <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                      <StackPanel><Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12"><controls:RemoteImage Width="60" Stretch="Uniform" Url="{Binding CoverUrl}"/></Border><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LastWatched, StringFormat='Son: {0:dd.MM.yyyy HH:mm}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><Border Height="3" Background="#33FFFFFF" Margin="0,10,0,0" IsVisible="{Binding ., Converter={StaticResource WatchedProgressVisibilityConverter}}"><Border Width="{Binding ., Converter={StaticResource WatchedProgressWidthConverter}, ConverterParameter=160}" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/></Border></StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Diziler" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,12"
                       IsVisible="{Binding HistorySeriesChannels.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
            <ItemsControl ItemsSource="{Binding HistorySeriesChannels}" IsVisible="{Binding HistorySeriesChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Channel">
                  <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                    <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                      <StackPanel><Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12"><controls:RemoteImage Width="60" Stretch="Uniform" Url="{Binding CoverUrl}"/></Border><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LastWatched, StringFormat='Son: {0:dd.MM.yyyy HH:mm}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><Border Height="3" Background="#33FFFFFF" Margin="0,10,0,0" IsVisible="{Binding ., Converter={StaticResource WatchedProgressVisibilityConverter}}"><Border Width="{Binding ., Converter={StaticResource WatchedProgressWidthConverter}, ConverterParameter=160}" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/></Border></StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Filmler" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,12"
                       IsVisible="{Binding HistoryVodChannels.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
            <ItemsControl ItemsSource="{Binding HistoryVodChannels}" IsVisible="{Binding HistoryVodChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Channel">
                  <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                    <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                      <StackPanel><Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12"><controls:RemoteImage Width="60" Stretch="Uniform" Url="{Binding CoverUrl}"/></Border><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LastWatched, StringFormat='Son: {0:dd.MM.yyyy HH:mm}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><Border Height="3" Background="#33FFFFFF" Margin="0,10,0,0" IsVisible="{Binding ., Converter={StaticResource WatchedProgressVisibilityConverter}}"><Border Width="{Binding ., Converter={StaticResource WatchedProgressWidthConverter}, ConverterParameter=160}" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/></Border></StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,96,0,0" IsVisible="{Binding ShowHistoryEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
              <Image Source="avares://Noctra.Avalonia/Assets/Logo.png" Width="88" Height="88" Stretch="Uniform" Opacity="0.75"/>
              <TextBlock Text="Ge&#231;mi&#351; bo&#351;" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,14,0,6"/>
              <TextBlock Text="&#304;zledi&#287;iniz i&#231;erikler burada listelenecek." FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- 9. DOWNLOADS VIEW -->
        <ScrollViewer x:Name="DownloadsView" IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Downloads}}">
          <StackPanel Margin="24">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
              <TextBlock Text="&#304;ndirilenler" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              <Button Grid.Column="1"
                      Command="{Binding ToggleDownloadCenterCommand}"
                      Padding="14,8"
                      MinWidth="170"
                      Background="{DynamicResource Surface1Brush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}">
                <Grid>
                  <TextBlock Text="&#304;ndirme Merkezi" IsVisible="{Binding IsDownloadCenterVisible, Converter={StaticResource InverseBoolConverter}}"/>
                  <TextBlock Text="&#304;ndirilenlere D&#246;n" IsVisible="{Binding IsDownloadCenterVisible}"/>
                </Grid>
              </Button>
            </Grid>

            <TextBlock Text="&#304;ndirme Merkezi" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"
                       IsVisible="{Binding IsDownloadCenterVisible}"/>
            <TextBlock Text="&#350;uanda &#304;ndirilenler" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"
                       IsVisible="{Binding IsDownloadCenterVisible}"/>
            <Border Background="{DynamicResource Surface0Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}" Padding="14,12" Margin="0,0,0,14"
                    IsVisible="{Binding IsDownloadCenterVisible}">
              <Grid ColumnDefinitions="Auto,Auto,*">
                <TextBlock Text="{Binding ActiveDownloadsTotalSpeedText, StringFormat='{}Toplam H&#305;z: {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,18,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ActiveDownloadCount, StringFormat='{}Aktif &#304;ndirme: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,18,0"/>
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding DownloadFreeDiskSpaceText, StringFormat='{}Bo&#351; Alan: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
              </Grid>
            </Border>
            <TextBlock Text="Aktif İndirmeler" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"
                       IsVisible="{Binding IsDownloadCenterVisible}"/>
            <ItemsControl ItemsSource="{Binding ActiveDownloadingItems}" IsVisible="{Binding IsDownloadCenterVisible}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="10"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadItem">
                  <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="88,*,Auto">
                      <Border Width="88" Height="116" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource Surface1Brush}" ClipToBounds="True" Margin="0,0,12,0">
                        <Grid>
                          <controls:RemoteImage Stretch="UniformToFill" Url="{Binding PosterUrl}"/>
                          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Background="#B3000000" CornerRadius="10" Padding="6,2">
                            <TextBlock Text="{Binding QueueOrder, StringFormat='#{0}'}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                          </Border>
                        </Grid>
                      </Border>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                          <Border Grid.Column="1" Background="{DynamicResource Surface1Brush}" CornerRadius="999" Padding="10,3" Margin="8,0,0,0">
                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                          </Border>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                          <TextBlock Text="{Binding SpeedText, StringFormat='{}H&#305;z: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,16,0"/>
                          <TextBlock Grid.Column="1" Text="{Binding EtaText, StringFormat='{}Kalan: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,16,0"/>
                          <TextBlock Grid.Column="2" Text="{Binding SizeText, StringFormat='{}Boyut: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,16,0"/>
                          <TextBlock Grid.Column="3" HorizontalAlignment="Right" Text="{Binding ProgressText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>
                      </StackPanel>

                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8" Margin="16,0,0,0">
                        <Button Padding="14,7"
                                MinWidth="96"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).TogglePauseDownloadCommand}"
                                CommandParameter="{Binding}"
                                Background="{DynamicResource Surface1Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                IsVisible="{Binding IsQueued, Converter={StaticResource InverseBoolConverter}}">
                          <Grid>
                            <TextBlock Text="Duraklat" IsVisible="{Binding IsPaused, Converter={StaticResource InverseBoolConverter}}"/>
                            <TextBlock Text="Devam Et" IsVisible="{Binding IsPaused}"/>
                          </Grid>
                        </Button>
                        <Button Content="&#304;ptal"
                                Padding="14,7"
                                MinWidth="96"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelDownloadCommand}"
                                CommandParameter="{Binding}"
                                Background="#3A2323"
                                BorderBrush="#663333"
                                Foreground="#FFB8B8"/>
                      </StackPanel>

                      <ProgressBar Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,0"
                                   Height="6"
                                   Minimum="0"
                                   Maximum="100"
                                   Value="{Binding ProgressPercent}"/>

                      <TextBlock Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="0,8,0,0"
                                 Text="{Binding ErrorMessage}"
                                 FontSize="11"
                                 Foreground="{DynamicResource ErrorBrush}"
                                 IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Kuyruk" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,18,0,10"
                       IsVisible="{Binding IsDownloadCenterVisible}"/>
            <ItemsControl ItemsSource="{Binding QueuedDownloadItems}" IsVisible="{Binding IsDownloadCenterVisible}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="10"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadItem">
                  <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="88,*,Auto">
                      <Border Width="88" Height="116" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource Surface1Brush}" ClipToBounds="True" Margin="0,0,12,0">
                        <Grid>
                          <controls:RemoteImage Stretch="UniformToFill" Url="{Binding PosterUrl}"/>
                          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Background="#B3000000" CornerRadius="10" Padding="6,2">
                            <TextBlock Text="{Binding QueueOrder, StringFormat='#{0}'}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                          </Border>
                        </Grid>
                      </Border>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                          <Border Grid.Column="1" Background="{DynamicResource Surface1Brush}" CornerRadius="999" Padding="10,3" Margin="8,0,0,0">
                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                          </Border>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                          <TextBlock Text="{Binding SpeedText, StringFormat='{}H&#305;z: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,16,0"/>
                          <TextBlock Grid.Column="1" Text="{Binding EtaText, StringFormat='{}Kalan: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,16,0"/>
                          <TextBlock Grid.Column="2" Text="{Binding SizeText, StringFormat='{}Boyut: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,16,0"/>
                          <TextBlock Grid.Column="3" HorizontalAlignment="Right" Text="{Binding ProgressText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>
                      </StackPanel>

                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8" Margin="16,0,0,0">
                        <Button Content="&#304;ptal"
                                Padding="14,7"
                                MinWidth="96"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelDownloadCommand}"
                                CommandParameter="{Binding}"
                                Background="#3A2323"
                                BorderBrush="#663333"
                                Foreground="#FFB8B8"/>
                      </StackPanel>

                      <ProgressBar Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,0"
                                   Height="6"
                                   Minimum="0"
                                   Maximum="100"
                                   Value="{Binding ProgressPercent}"/>

                      <TextBlock Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="0,8,0,0"
                                 Text="{Binding ErrorMessage}"
                                 FontSize="11"
                                 Foreground="{DynamicResource ErrorBrush}"
                                 IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel IsVisible="{Binding IsDownloadCenterVisible, Converter={StaticResource InverseBoolConverter}}">
            <TextBlock Text="Diziler" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,18,0,12"
                       IsVisible="{Binding DownloadedSeriesItems.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
            <ItemsControl ItemsSource="{Binding DownloadedSeriesItems}" IsVisible="{Binding DownloadedSeriesItems.Count, Converter={StaticResource CountToVisibilityConverter}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Series">
                  <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                    <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                      <StackPanel>
                        <Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12">
                          <controls:RemoteImage Width="60" Stretch="Uniform" Url="{Binding CoverUrl}"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SeasonCountSafe, StringFormat='{}{0} sezon'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextAlignment="Center" Margin="0,6,0,0"/>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Filmler" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,12"
                       IsVisible="{Binding DownloadedVodChannels.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
            <ItemsControl ItemsSource="{Binding DownloadedVodChannels}" IsVisible="{Binding DownloadedVodChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Channel">
                  <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                    <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                      <StackPanel>
                        <Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12">
                          <controls:RemoteImage Width="60" Stretch="Uniform" Url="{Binding CoverUrl}"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,96,0,0"
                        IsVisible="{Binding ShowDownloadsLandingEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
              <Image Source="avares://Noctra.Avalonia/Assets/Logo.png" Width="88" Height="88" Stretch="Uniform" Opacity="0.75"/>
              <TextBlock Text="&#304;ndirilen i&#231;erik yok" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,14,0,6"/>
              <TextBlock Text="&#304;ndirilen VOD ve dizi i&#231;erikleri burada listelenecek." FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Loading Skeleton State -->
        <Grid x:Name="LoadingSkeletons" Background="{DynamicResource Bg0Brush}" IsVisible="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel Margin="24">
            <Border Height="500" Background="{DynamicResource Surface0Brush}" CornerRadius="16" Margin="0,0,0,32" Opacity="0.5"/>
            <Border Width="200" Height="24" Background="{DynamicResource Surface0Brush}" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,16" Opacity="0.5"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Width="300" Height="169" Background="{DynamicResource Surface0Brush}" CornerRadius="8" Opacity="0.5"/>
              <Border Width="300" Height="169" Background="{DynamicResource Surface0Brush}" CornerRadius="8" Opacity="0.5"/>
              <Border Width="300" Height="169" Background="{DynamicResource Surface0Brush}" CornerRadius="8" Opacity="0.5"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- Search Overlay -->
        <Grid x:Name="SearchOverlay" Background="#CC000000" IsVisible="{Binding IsSearchOverlayVisible}" ZIndex="1000">
          <StackPanel MaxWidth="800" VerticalAlignment="Top" Margin="0,100,0,0">
            <Border Background="{DynamicResource Bg1Brush}" CornerRadius="8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="SearchInput" FontSize="24" Background="Transparent" BorderThickness="0" Padding="20" Watermark="Film, dizi veya kanal ara..."
                         Text="{Binding SearchQuery}" KeyDown="SearchInput_KeyDown"/>
                <Button Grid.Column="1" Command="{Binding CommitSearchCommand}" Background="Transparent" BorderThickness="0" Padding="20" Cursor="Hand">
                  <materialIcons:MaterialIcon Kind="Magnify" Width="24" Height="24" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
              </Grid>
            </Border>
            <ScrollViewer MaxHeight="500" Margin="0,20,0,0">
              <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.DataTemplates>
                  <DataTemplate x:DataType="models:Channel">
                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                      <Border Background="{DynamicResource Surface1Brush}" CornerRadius="8" Padding="16">
                        <Grid ColumnDefinitions="120,*">
                          <Border Width="100" Height="56" CornerRadius="4" Background="{DynamicResource Surface1Brush}" ClipToBounds="True">
                            <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding GroupTitle}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                            <Border Height="3" Background="#33FFFFFF" Margin="0,12,0,0"
                                    IsVisible="{Binding WatchedPercentage, Converter={StaticResource CountToVisibilityConverter}}">
                              <Border Width="{Binding WatchedPercentage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=640}"
                                      Background="#8D09E5" HorizontalAlignment="Left"/>
                            </Border>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>

                  <DataTemplate x:DataType="models:Series">
                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                      <Border Background="{DynamicResource Surface1Brush}" CornerRadius="8" Padding="16">
                        <Grid ColumnDefinitions="120,*">
                          <Border Width="100" Height="56" CornerRadius="4" Background="{DynamicResource Surface1Brush}" ClipToBounds="True">
                            <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Genre}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.DataTemplates>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="40" Foreground="White"
                  Background="Transparent" BorderThickness="0" Command="{Binding CloseSearchCommand}" Cursor="Hand">
            <materialIcons:MaterialIcon Kind="Close" Width="22" Height="22" Foreground="White"/>
          </Button>
        </Grid>

        <!-- Series Detail Overlay -->
        <Grid x:Name="SeriesDetailOverlay" Background="{DynamicResource BackgroundGradientBrush}"
              IsVisible="{Binding IsSeriesDetailVisible}" ZIndex="998">
          <Grid Margin="52,88">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnDefinitions="260,*" Margin="0,0,0,28">
              <Border Height="360" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource Surface0Brush}">
                <controls:RemoteImage Stretch="UniformToFill" Url="{Binding SelectedSeriesPosterUrl}"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="28,0,0,0">
                <Button Command="{Binding CloseSeriesDetailCommand}" HorizontalAlignment="Left" Margin="0,0,0,20" Background="Transparent" BorderThickness="0" Cursor="Hand">
                  <materialIcons:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
                <TextBlock Text="{Binding SelectedSeries.Name}" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="{Binding SelectedSeries.Genre}" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0"/>
                  <TextBlock Text="{Binding SelectedSeries.ReleaseYear}" FontSize="16" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding SelectedSeriesOverview}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,16,0,0" MaxHeight="96"/>
                <TextBlock Text="{Binding SelectedSeriesCast, StringFormat='Oyuncular: {0}'}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"
                           IsVisible="{Binding SelectedSeriesCast, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                <TextBlock Text="Detaylar y&#252;kleniyor..." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"
                           IsVisible="{Binding IsSelectedSeriesMetadataLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
              </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" Padding="0,8,0,0">
              <ItemsControl ItemsSource="{Binding SelectedSeries.Seasons}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,40">
                      <TextBlock Text="{Binding SeasonNumber, StringFormat='Sezon {0}'}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                      <ItemsControl ItemsSource="{Binding Episodes}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Margin="0,0,16,24" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" x:DataType="models:Episode"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PlayEpisodeCommand}" CommandParameter="{Binding}">
                              <Border Background="{DynamicResource Bg1Brush}" CornerRadius="8" Width="240">
                                <Grid RowDefinitions="Auto,*">
                                  <Border Height="100" CornerRadius="8,8,0,0" ClipToBounds="True">
                                    <Grid>
                                      <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                                      <Border Background="#44000000"/>
                                      <materialIcons:MaterialIcon Kind="Play" Foreground="White" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                      <!-- Completion badge -->
                                      <Border Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                              Background="{DynamicResource AccentBrush}" IsVisible="{Binding ., Converter={StaticResource EpisodeCompletionBadgeVisibilityConverter}}">
                                        <materialIcons:MaterialIcon Kind="Check" Foreground="White" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      </Border>
                                    </Grid>
                                  </Border>
                                  <Border Grid.Row="1" Padding="12">
                                    <StackPanel>
                                      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                      <!-- Episode progress bar -->
                                      <Border Height="3" Background="#33FFFFFF" Margin="0,12,0,0"
                                              IsVisible="{Binding ., Converter={StaticResource EpisodeWatchedProgressVisibilityConverter}}">
                                        <Border Width="{Binding ., Converter={StaticResource EpisodeWatchedProgressWidthConverter}, ConverterParameter=150}"
                                                Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                                      </Border>
                                    </StackPanel>
                                  </Border>
                                </Grid>
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Grid>


      </Grid>
    </Grid>

    <!-- Mini Player (Picture-in-Picture) -->
    <Border x:Name="MiniPlayer"
            Width="320" Height="180"
            CornerRadius="12"
            Background="Black"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="24"
            IsVisible="False"
            ZIndex="4900"
            BoxShadow="0 12 28 0 #66000000">
      <Grid>
        <controls:MemoryVideoView x:Name="MiniVideoSurface"/>
        <Border Background="{DynamicResource HeroOverlayBrush}" IsHitTestVisible="False"/>

        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="8"
                Width="28" Height="28"
                Background="#AA000000"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                CornerRadius="14"
                Click="CloseMiniPlayer_Click">
          <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </Grid>
    </Border>

    <!-- Player Area (full window overlay) -->
    <Grid x:Name="PlayerArea" Grid.RowSpan="3" Background="Black" IsVisible="False" ClipToBounds="True" ZIndex="5000">
      <controls:MemoryVideoView x:Name="VideoSurface"/>
      <views:WatermarkView DataContext="{Binding WatermarkViewModel}" ZIndex="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,100"/>
      <Border x:Name="MouseCaptureLayer"
              ZIndex="2500"
              Background="Transparent"
              PointerMoved="MouseCaptureLayer_PointerMoved"
              PointerPressed="MouseCaptureLayer_PointerPressed"/>
      <Grid x:Name="PlayerOverlayLayer" ZIndex="2600">
        <views:VideoOverlayView x:Name="OverlayControl" ZIndex="2"/>
        <!-- Next Episode Prompt (binds to PlayerViewModel via OverlayControl's DataContext) -->
        <Border x:Name="NextEpisodePrompt" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="24"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,180" Width="350"
                DataContext="{Binding #OverlayControl.DataContext}" x:DataType="vm:PlayerViewModel"
                IsVisible="{Binding IsNextEpisodePromptVisible}" ZIndex="3000">
          <Grid RowDefinitions="Auto,Auto,Auto">
            <TextBlock Text="Sonraki B&#246;l&#252;m" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
              <TextBlock Text="{Binding NextEpisode.Name}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding NextEpisode.Plot}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Row="2" Command="{Binding PlayNextEpisodeCommand}"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Padding="20,12" BorderThickness="0" HorizontalAlignment="Stretch" Cursor="Hand">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <materialIcons:MaterialIcon Kind="Play" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="&#350;imdi &#304;zle" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ========== STATUS BAR ========== -->
    <Border Grid.Row="2" Background="{DynamicResource HeaderGradientBrush}">
      <Grid Margin="24,0" ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="{DynamicResource RadiusPill}" Padding="14,6">
          <TextBlock Text="{Binding FilteredChannels.Count, StringFormat='{}{0} kanal'}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
        </Border>
      </Grid>
    </Border>

  </Grid>
</Window>

