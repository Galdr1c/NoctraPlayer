<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Noctra.ViewModels"
        xmlns:models="using:Noctra.Models"
        xmlns:views="using:Noctra.Avalonia.Views"
        xmlns:controls="using:Noctra.Avalonia.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Noctra.Avalonia.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://Noctra.Avalonia/Assets/Logo.png"
        Title="Noctra"
        TransparencyLevelHint="None"
        Width="1400" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg0Brush}">

    <Window.Styles>
      <Style Selector="Button.SettingsGearButton materialIcons|MaterialIcon#SettingsGearIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="RenderTransform" Value="rotate(0deg)"/>
      </Style>
      <Style Selector="Button.SettingsGearButton:pointerover materialIcons|MaterialIcon#SettingsGearIcon">  
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="RenderTransform" Value="rotate(120deg)"/>
      </Style>
      <Style Selector="Button.pipButton">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
      </Style>
      <Style Selector="Button.pipButton:pointerover">
        <Setter Property="Background" Value="#33FFFFFF"/>
      </Style>
      <Style Selector="Button.pipButton:pressed">
          <Setter Property="Background" Value="#44FFFFFF"/>
          <Setter Property="RenderTransform" Value="scale(0.95)"/>
      </Style>
      <Style Selector="materialIcons|MaterialIcon.cornerMask">
          <Setter Property="Foreground" Value="Black"/>
          <Setter Property="Width" Value="12"/>
          <Setter Property="Height" Value="12"/>
          <Setter Property="ZIndex" Value="5000"/>
      </Style>
  
      <!-- HIGH IMPACT SIDEBAR STYLES -->
      <Style Selector="Button.navItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="10,1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ClipToBounds" Value="True"/>
      </Style>
  
      <Style Selector="Button.navItem StackPanel.ItemContent">
        <Setter Property="Margin" Value="20,11"/>
      </Style>          
      <Style Selector="Button.navItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
      </Style>
  
      <Style Selector="Button.navItem.active">
        <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}"/>
      </Style>

      <Style Selector="Button.navItem Border.ActiveIndicator">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Width" Value="4"/>
        <Setter Property="CornerRadius" Value="0,2,2,0"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="24"/>
      </Style>

      <Style Selector="Button.navItem.active Border.ActiveIndicator">
        <Setter Property="IsVisible" Value="True"/>
      </Style>

      <Style Selector="Button.navItem TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="14"/>
      </Style>

      <Style Selector="Button.navItem:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      </Style>

      <Style Selector="Button.navItem.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <Style Selector="Button.navItem materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
      </Style>

      <Style Selector="Button.navItem:pointerover materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Opacity" Value="1"/>
      </Style>

      <Style Selector="Button.navItem.active materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Opacity" Value="1"/>
      </Style>
  
      <!-- HEADER SEARCH STYLES -->
      <Style Selector="TextBox.headerSearch">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Watermark" Value=""/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Transitions">
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.15" Easing="QuadraticEaseOut"/>
          </Transitions>
        </Setter>
      </Style>

      <Style Selector="TextBox.headerSearch:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      </Style>

      <Style Selector="TextBox.headerSearch:focus, TextBox.headerSearch.notEmpty, TextBox.headerSearch.isSearchView">
        <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Padding" Value="12,6"/>

        <Setter Property="Watermark" Value="Film, dizi veya kanal ara..."/>
      </Style>

      <!-- Avalonia TextBox focus kenarlığını ezmek için özel PART_BorderElement kuralı -->
      <Style Selector="TextBox.headerSearch:focus /template/ Border#PART_BorderElement, TextBox.headerSearch.notEmpty /template/ Border#PART_BorderElement, TextBox.headerSearch.isSearchView /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Style>


    </Window.Styles>

  <Grid RowDefinitions="64,*,48" Focusable="True">

    <!-- ========== HEADER BAR ========== -->
    <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource HeaderGradientBrush}" 
            Padding="24,0" PointerPressed="HeaderBar_PointerPressed" Focusable="True">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- Spacer for Logo removal -->
        <Border Width="1" Height="32" Margin="8,0,0,0"/>

        <!-- New Expanding Search -->
        <TextBox x:Name="HeaderSearchBox" Classes="headerSearch" 
                 Classes.notEmpty="{Binding SearchQuery, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                 Classes.isSearchView="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=Search}"
                 Grid.Column="1" HorizontalAlignment="Right"
                 Text="{Binding SearchQuery, Mode=TwoWay}"
                 Margin="0,0,12,0"
                 KeyDown="SearchInput_KeyDown">
          <TextBox.InnerLeftContent>
            <Border Width="38" Height="34" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
               <materialIcons:MaterialIcon Kind="Magnify" Width="18" Height="18" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
            </Border>
          </TextBox.InnerLeftContent>
        </TextBox>

        <!-- Search Results Popup -->
        <Popup IsOpen="{Binding !!SearchResults.Count}" 
               PlacementTarget="{Binding #HeaderSearchBox}"
               Placement="Bottom"
               IsLightDismissEnabled="True">
          <Border Width="340" MaxHeight="400" Background="{DynamicResource SurfaceBrush}" 
                  CornerRadius="12" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.DataTemplates>
                  <DataTemplate x:DataType="models:Channel">
                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" 
                            CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="8" Cursor="Hand" HorizontalAlignment="Stretch">
                      <Grid ColumnDefinitions="40,*">
                        <Border Width="32" Height="32" CornerRadius="4" ClipToBounds="True">
                          <controls:RemoteImage Stretch="UniformToFill" Url="{Binding LogoUrl}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding GroupTitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                  <DataTemplate x:DataType="models:Series">
                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" 
                            CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="8" Cursor="Hand" HorizontalAlignment="Stretch">
                      <Grid ColumnDefinitions="40,*">
                        <Border Width="32" Height="32" CornerRadius="4" ClipToBounds="True">
                          <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="Dizi" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.DataTemplates>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Popup>

        <!-- Header Actions -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <!-- Settings Button -->
          <Button Classes="SettingsGearButton" Click="SettingsButton_Click" Cursor="Hand" ToolTip.Tip="Ayarlar"
                  Width="48" Height="48" Background="Transparent" BorderThickness="0" CornerRadius="24">
            <materialIcons:MaterialIcon x:Name="SettingsGearIcon" Kind="CogOutline" Width="22" Height="22" RenderTransformOrigin="50%,50%">
              <materialIcons:MaterialIcon.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22"/>
                </Transitions>
              </materialIcons:MaterialIcon.Transitions>
            </materialIcons:MaterialIcon>
          </Button>
          <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="0,8" Opacity="0.5"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ========== MAIN CONTENT AREA ========== -->
    <Grid x:Name="MainContentArea" Grid.Row="1" ColumnDefinitions="280,*">

      <!-- SIDEBAR -->
      <Border x:Name="SideBar" Grid.Column="0" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="0,24,0,24">
          <!-- Nav Section Label -->
          <TextBlock Text="ANA MENÜ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="24,0,24,8" LetterSpacing="2"/>

          <!-- Home -->
          <Button Classes="navItem" Click="NavigateHome_Click"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.Home}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="HomeVariantOutline" />
                <TextBlock Text="Ana Sayfa" VerticalAlignment="Center"/>
              </StackPanel>
            </Panel>
          </Button>

          <!-- Live TV -->
          <Button Classes="navItem" Click="NavigateLive_Click"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.Live}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="Television" />
                <TextBlock Text="Canlı TV" VerticalAlignment="Center"/>
              </StackPanel>
            </Panel>
          </Button>

          <!-- Movies -->
          <Button Classes="navItem" Click="NavigateMovies_Click"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.Movies}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="MovieOpenOutline" />
                <TextBlock Text="Filmler" VerticalAlignment="Center"/>
              </StackPanel>
            </Panel>
          </Button>

          <!-- Series -->
          <Button Classes="navItem" Click="NavigateSeries_Click"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.Series}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="TelevisionPlay" />
                <TextBlock Text="Diziler" VerticalAlignment="Center"/>
              </StackPanel>
            </Panel>
          </Button>

          <!-- My List -->
          <Button Classes="navItem" Click="NavigateMyList_Click"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.MyList}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="PlaylistPlus" />
                <TextBlock Text="Listem" VerticalAlignment="Center"/>
              </StackPanel>
            </Panel>
          </Button>

          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="20,12"/>

          <!-- Nav Section Label 2 -->
          <TextBlock Text="KÜTÜPHANE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="24,0,24,8" LetterSpacing="2"/>

          <!-- Favorites -->
          <Button Classes="navItem" Click="NavigateFavorites_Click"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.Favorites}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="HeartOutline" />
                <TextBlock Text="Favoriler" VerticalAlignment="Center"/>
              </StackPanel>
            </Panel>
          </Button>

          <!-- History -->
          <Button Classes="navItem" Click="NavigateHistory_Click"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.History}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <StackPanel Classes="ItemContent" Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="History" />
                <TextBlock Text="Geçmiş" VerticalAlignment="Center"/>
              </StackPanel>
            </Panel>
          </Button>

          <!-- Downloads -->
          <Button Classes="navItem" Click="NavigateDownloads_Click"
                  Classes.active="{Binding ActiveView, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:AppView.Downloads}}">
            <Panel>
              <Border Classes="ActiveIndicator" />
              <Grid ColumnDefinitions="*,Auto" Margin="20,11">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <materialIcons:MaterialIcon Kind="DownloadOutline" />
                  <TextBlock Text="İndirilenler" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Badge -->
                <Border Grid.Column="1" 
                        IsVisible="{Binding ActiveDownloadCount, Converter={StaticResource CountToVisibilityConverter}}"
                        Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ActiveDownloadCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>
              </Grid>
            </Panel>
          </Button>
        </StackPanel>
      </Border>

      <!-- MAIN CONTENT -->
      <Grid Grid.Column="1">

        <!-- 1. HOME VIEW -->
                <views:HomeView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Home}}" />


        <!-- 2. MOVIES VIEW -->
                <views:MoviesView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Movies}}" />


        <!-- 3. SERIES VIEW -->
                <views:SeriesView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Series}}" />


        <!-- 4. LIVE TV VIEW -->
                <views:LiveView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Live}}" />


        <!-- 5. SEARCH VIEW -->
                <views:SearchView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Search}}" />

        <!-- 6. MY LIST VIEW -->
                <views:MyListView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.MyList}}" />


        <!-- 7. FAVORITES VIEW -->
                <views:FavoritesView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Favorites}}" />


        <!-- 8. HISTORY VIEW -->
                <views:HistoryView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.History}}" />


        <!-- 9. DOWNLOADS VIEW -->
                <views:DownloadsView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Downloads}}" />



        <!-- Series Detail Overlay (Modern Netflix Style) -->
        <Grid x:Name="SeriesDetailOverlay" 
              Background="{DynamicResource BackgroundGradientBrush}"
              IsVisible="{Binding IsSeriesDetailVisible}" ZIndex="998">
          
          <Grid>
            <!-- Background Backdrop with Blur -->
            <Grid IsHitTestVisible="False" Opacity="0.3">
                <controls:RemoteImage Stretch="UniformToFill" Url="{Binding SelectedSeriesPosterUrl}">
                    <controls:RemoteImage.Effect>
                        <BlurEffect Radius="60"/>
                    </controls:RemoteImage.Effect>
                </controls:RemoteImage>
                <Border Background="{DynamicResource BackgroundGradientBrush}"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid Margin="60,40" RowDefinitions="Auto,Auto">
                
                <!-- Header Section -->
                <Grid ColumnDefinitions="300,*" Grid.Row="0">
                  <!-- Large Poster -->
                  <Border Grid.Column="0" Height="450" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource Surface0Brush}">
                    <Border.BoxShadow>
                      <BoxShadows>0 15 50 5 #88000000</BoxShadows>
                    </Border.BoxShadow>
                    <controls:RemoteImage Stretch="UniformToFill" Url="{Binding SelectedSeriesPosterUrl}"/>
                  </Border>

                  <!-- Metadata & Info -->
                  <Grid Grid.Column="1" Margin="48,0,0,0" Height="450" RowDefinitions="Auto,*,Auto">
                    
                    <!-- Title and Meta -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Top">
                      <!-- Back button -->
                      <Button Command="{Binding CloseSeriesDetailCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" 
                              Theme="{StaticResource ActionCircleButtonStyle}" Width="48" Height="48" Padding="0">
                        <materialIcons:MaterialIcon Kind="ArrowLeft" Width="24" Height="24" Foreground="{DynamicResource TextPrimaryBrush}"/>
                      </Button>
 
                      <StackPanel Spacing="8">
                          <TextBlock Text="{Binding SelectedSeries.Name}" FontSize="52" FontWeight="Black" 
                                    Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="58" LetterSpacing="-1"/>
                      </StackPanel>

                      <!-- Badges & Stats (Netflix Style Meta) -->
                      <StackPanel Orientation="Horizontal" Margin="0,18,0,0" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedSeriesYears}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" FontWeight="SemiBold"
                                  IsVisible="{Binding SelectedSeriesYears, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                        
                        <TextBlock Text="•" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" VerticalAlignment="Center" Margin="4,0">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="SelectedSeriesYears" Converter="{StaticResource StringNotEmptyToBoolConverter}"/>
                              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="SelectedSeriesGenres" Converter="{StaticResource StringNotEmptyToBoolConverter}"/>
                                <Binding Path="SelectedSeriesAgeRating" Converter="{StaticResource StringNotEmptyToBoolConverter}"/>
                              </MultiBinding>
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>
                        
                        <TextBlock Text="{Binding SelectedSeriesGenres}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" FontWeight="Medium"
                                  IsVisible="{Binding SelectedSeriesGenres, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                        <TextBlock Text="•" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" VerticalAlignment="Center" Margin="4,0">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="SelectedSeriesGenres" Converter="{StaticResource StringNotEmptyToBoolConverter}"/>
                              <Binding Path="SelectedSeriesAgeRating" Converter="{StaticResource StringNotEmptyToBoolConverter}"/>
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>
                        
                        <Border BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1.5" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Margin="12,0,0,0"
                                IsVisible="{Binding SelectedSeriesAgeRating, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <TextBlock Text="{Binding SelectedSeriesAgeRating}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Black"/>
                        </Border>

                        <!-- Network Logo (Netflix, HBO, Disney+, etc.) -->
                        <Border VerticalAlignment="Center" Margin="12,0,0,0" Height="20"
                                IsVisible="{Binding SelectedSeriesNetworkLogoUrl, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <controls:RemoteImage Url="{Binding SelectedSeriesNetworkLogoUrl}" 
                                                  Stretch="Uniform" Height="20" MaxWidth="80"/>
                        </Border>
                      </StackPanel>

                      <!-- Seasons & Episodes Stats -->
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Spacing="16">
                        <TextBlock Text="{Binding SelectedSeriesTotalSeasonsCount, StringFormat='{}{0} Sezon'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" FontWeight="Medium"/>
                        <TextBlock Text="{Binding SelectedSeriesTotalEpisodesCount, StringFormat='{}{0} Bölüm'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" FontWeight="Medium"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- Scrollable Description & Cast -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,0">
                      <StackPanel>
                        <!-- Description -->
                        <TextBlock Text="{Binding SelectedSeriesOverview}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" 
                                  TextWrapping="Wrap" Opacity="0.4" LineHeight="22"
                                  IsVisible="{Binding SelectedSeriesOverview, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                        
                        <!-- Cast -->
                        <TextBlock Text="{Binding SelectedSeriesCast, StringFormat='Oyuncular: {0}'}" FontSize="14" 
                                  Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0"
                                  IsVisible="{Binding SelectedSeriesCast, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                      </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,24,0,0" Spacing="10">
                        <Button Command="{Binding PlayEpisodeCommand}" CommandParameter="{Binding SelectedSeriesContinueEpisode}"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                Padding="16,8" CornerRadius="8" Focusable="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Play" Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Oynat" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding PlayEpisodeCommand}" CommandParameter="{Binding SelectedSeriesContinueEpisode}"
                                Background="#1A8B5CF6" Foreground="{DynamicResource AccentBrush}"
                                Padding="14,8" CornerRadius="8" Focusable="False"
                                IsVisible="{Binding SelectedSeriesContinueText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="History" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding SelectedSeriesContinueText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding WatchTrailerCommand}"
                                Background="#1A000000" Foreground="{DynamicResource TextPrimaryBrush}"
                                Padding="14,8" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" Focusable="False"
                                IsVisible="{Binding SelectedSeriesTrailerUrl, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Youtube" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Fragmanı İzle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddToMyListCommand}" CommandParameter="{Binding SelectedSeries}"
                                Theme="{StaticResource ActionCircleButtonStyle}" Width="52" Height="52" Padding="0">
                            <Panel>
                                <materialIcons:MaterialIcon Kind="Minus" Width="24" Height="24" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            IsVisible="{Binding SelectedSeries.IsInMyList}"/>
                                <materialIcons:MaterialIcon Kind="Plus" Width="24" Height="24" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            IsVisible="{Binding !SelectedSeries.IsInMyList}"/>
                            </Panel>
                        </Button>

                        <Button Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedSeries}"
                                Theme="{StaticResource ActionCircleButtonStyle}" Width="52" Height="52" Padding="0">
                            <Panel>
                                <materialIcons:MaterialIcon Kind="Heart" Width="22" Height="22" Foreground="#E50914" 
                                                            IsVisible="{Binding SelectedSeries.IsFavorite}"/>
                                <materialIcons:MaterialIcon Kind="HeartOutline" Width="22" Height="22" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                            IsVisible="{Binding !SelectedSeries.IsFavorite}"/>
                            </Panel>
                        </Button>
                    </StackPanel>
                  </Grid>
                </Grid>

                <!-- Seasons & Episodes -->
                <Grid Grid.Row="1" Margin="0,48,0,0" RowDefinitions="Auto,Auto">
                  <!-- Seasons Tab Menu -->
                  <StackPanel Grid.Row="0">
                      <Grid ColumnDefinitions="*,Auto">
                      <ListBox ItemsSource="{Binding SelectedSeries.Seasons}" 
                               SelectedItem="{Binding SelectedSeason}"
                               Background="Transparent" BorderThickness="0" Padding="0"
                               ScrollViewer.HorizontalScrollBarVisibility="Auto">
                          <ListBox.ItemsPanel>
                              <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal"/>
                              </ItemsPanelTemplate>
                          </ListBox.ItemsPanel>
                          <ListBox.ItemTemplate>
                              <DataTemplate>
                                  <TextBlock Text="{Binding SeasonNumber, StringFormat='Sezon {0}'}" 
                                             FontSize="18" FontWeight="SemiBold" 
                                             VerticalAlignment="Center"/>
                              </DataTemplate>
                          </ListBox.ItemTemplate>
                          <ListBox.Styles>
                              <Style Selector="ListBoxItem">
                                  <Setter Property="Padding" Value="0,0,0,8"/>
                                  <Setter Property="Margin" Value="0,0,24,0"/>
                                  <Setter Property="Background" Value="Transparent"/>
                                  <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                  <Setter Property="BorderThickness" Value="0,0,0,3"/>
                                  <Setter Property="BorderBrush" Value="Transparent"/>
                                  <Setter Property="FontWeight" Value="Medium"/>
                                  <Setter Property="Transitions">
                                      <Transitions>
                                          <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                                          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                                      </Transitions>
                                  </Setter>
                              </Style>
                              
                              <Style Selector="ListBoxItem /template/ ContentPresenter">
                                  <Setter Property="Background" Value="Transparent" />
                              </Style>
                              
                              <!-- PointerOver State -->
                              <Style Selector="ListBoxItem:pointerover">
                                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                              </Style>
                              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                  <Setter Property="Background" Value="Transparent" />
                              </Style>

                              <!-- Selected State -->
                              <Style Selector="ListBoxItem:selected">
                                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                  <Setter Property="FontWeight" Value="Bold"/>
                              </Style>
                              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                  <Setter Property="Background" Value="Transparent" />
                              </Style>

                              <!-- Pressed State -->
                              <Style Selector="ListBoxItem:pressed">
                                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                  <Setter Property="RenderTransform" Value="scale(0.98)"/>
                              </Style>
                              <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
                                  <Setter Property="Background" Value="Transparent" />
                              </Style>
                          </ListBox.Styles>
                      </ListBox>

                      <!-- Download Season Button -->
                      <Button Grid.Column="1" VerticalAlignment="Center" Padding="12,8" CornerRadius="8"
                              Background="{DynamicResource Surface1Brush}" BorderThickness="0" Margin="0,0,0,12"
                              Command="{Binding DownloadSelectedSeasonCommand}"
                              ToolTip.Tip="Aktif sezondaki tüm bölümleri indirme kuyruğuna ekle">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                              <materialIcons:MaterialIcon Kind="Download" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                              <TextBlock Text="Sezonu İndir" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                          </StackPanel>
                      </Button>
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="0,0,0,24"/>
                  </StackPanel>

                  <!-- Episode Row List -->
                  <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedSeason.Episodes}">
                      <ItemsControl.ItemTemplate>
                          <DataTemplate>
                              <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PlayEpisodeCommand}"
                                      CommandParameter="{Binding}"
                                      Padding="0" Background="Transparent" BorderThickness="0" Margin="0,0,0,6" 
                                      HorizontalAlignment="Stretch" CornerRadius="8">
                                  <Panel>
                                      <!-- Separate background layer for independent transparency -->
                                      <Border Background="{DynamicResource Surface1Brush}" Opacity="0.4" CornerRadius="8" x:Name="EpBgLayer" />
                                      
                                      <Border CornerRadius="8" Padding="12,8" BorderThickness="0" BorderBrush="Transparent">
                                      <Grid ColumnDefinitions="60, 200, *, Auto">
                                          <!-- Index -->
                                          <TextBlock Text="{Binding EpisodeNumber}" FontSize="22" FontWeight="Bold" 
                                                     Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                          
                                          <!-- Thumbnail -->
                                          <Border Grid.Column="1" Height="80" CornerRadius="6" ClipToBounds="True" Margin="12,0" Background="{DynamicResource Surface1Brush}">
                                              <Grid>
                                                  <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                                                  <materialIcons:MaterialIcon Kind="Play" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                                                  
                                                  <!-- Progress Bar (Internal) -->
                                                  <ProgressBar VerticalAlignment="Bottom" Height="3" Minimum="0" Maximum="100" 
                                                               Value="{Binding WatchedPercentage}" Foreground="{DynamicResource AccentBrush}" Background="#4D000000" BorderThickness="0"
                                                               IsVisible="{Binding WatchedPercentage, Converter={StaticResource CountToVisibilityConverter}}"/>
                                              </Grid>
                                          </Border>

                                          <!-- Info -->
                                          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4" Margin="12,0">
                                              <StackPanel Orientation="Horizontal" Spacing="16">
                                                  <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                  <TextBlock Text="{Binding EpisodeMetaText}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                                             IsVisible="{Binding EpisodeMetaText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                                  
                                                  <!-- Status Badge -->
                                                  <Border Background="#3346D369" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                          IsVisible="{Binding IsCompleted}">
                                                      <TextBlock Text="İZLENDİ" FontSize="9" FontWeight="Bold" Foreground="#46D369"/>
                                                  </Border>
                                              </StackPanel>
                                              <TextBlock Text="{Binding TmdbEpisodeName}" 
                                                         FontSize="14" Foreground="{DynamicResource AccentBrush}" FontStyle="Italic" Opacity="0.85"
                                                         IsVisible="{Binding TmdbEpisodeName, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                              <TextBlock Text="{Binding Plot}" 
                                                         FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="40" Opacity="0.9" LineHeight="18"/>
                                          </StackPanel>
                                          
                                          <!-- Action -->
                                          <Button Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" Padding="8" Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DownloadEpisodeCommand}"
                                                  CommandParameter="{Binding}"
                                                  ToolTip.Tip="Bölümü İndir">
                                              <materialIcons:MaterialIcon Kind="Download" Width="22" Height="22" Foreground="{DynamicResource TextMutedBrush}" Opacity="0.6"/>
                                          </Button>
                                      </Grid>
                                  </Border>
                                  </Panel>
                              </Button>
                          </DataTemplate>
                      </ItemsControl.ItemTemplate>
                      <ItemsControl.Styles>
                          <Style Selector="Button:pointerover Border#EpBgLayer">
                                <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}"/>
                                <Setter Property="Opacity" Value="0.9"/>
                            </Style>
                          <Style Selector="Button:pressed Border#EpBgLayer">
                               <Setter Property="Background" Value="{DynamicResource InteractivePressedBrush}"/>
                               <Setter Property="Opacity" Value="1.0"/>
                           </Style>
                      </ItemsControl.Styles>
                  </ItemsControl>
                </Grid>

              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>


      </Grid>
    </Grid>



    <!-- Player Area (full window overlay) -->
    <Grid x:Name="PlayerArea" Grid.RowSpan="3" Background="Transparent" IsVisible="False" ClipToBounds="True" ZIndex="5000">
      <!-- Main Content Container with Rounded Corners for PiP -->
      <Border x:Name="PiPContainer"
              CornerRadius="0"
              ClipToBounds="True"
              Background="Black">
          <controls:MemoryVideoView x:Name="VideoSurface">
              <controls:MemoryVideoView.OverlayContent>
                  <Grid>
                      <views:WatermarkView x:Name="PiPWatermark" DataContext="{Binding WatermarkViewModel}" ZIndex="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,100"/>
                      <Border x:Name="MouseCaptureLayer"
                              ZIndex="2500"
                              Background="Transparent"
                              PointerMoved="MouseCaptureLayer_PointerMoved"
                              PointerPressed="MouseCaptureLayer_PointerPressed"/>

                      <!-- PiP Window Frame (Border & Shadows) - Visible only in PiP -->
                      <Border x:Name="PiPFrame"
                              BorderBrush="#44FFFFFF"
                              BorderThickness="1"
                              CornerRadius="0"
                              IsVisible="{Binding #PiPCentralControls.IsVisible}"
                              ZIndex="5001"
                              IsHitTestVisible="False">
                          <Border.BoxShadow>
                              <BoxShadows>0 10 40 0 #AA000000</BoxShadows>
                          </Border.BoxShadow>
                      </Border>

                  <!-- PiP Central Controls (Netflix Style) -->
                  <StackPanel x:Name="PiPCentralControls"
                              Orientation="Horizontal"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Spacing="40"
                              IsVisible="{Binding IsPiPControlsVisible}"
                              ZIndex="6000"
                              x:DataType="vm:PlayerViewModel">
                      
                      <!-- VOD Skip Backward 10s -->
                      <Button Command="{Binding SkipBackwardCommand}" CommandParameter="10"
                              Width="48" Height="48"
                              IsVisible="{Binding !IsLiveContent}"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="10 sn Geri">
                          <materialIcons:MaterialIcon Kind="Rewind" Width="36" Height="36" Foreground="White" Opacity="0.9"/>
                      </Button>

                      <!-- Live TV Previous Channel -->
                      <Button x:Name="PlayPreviousLiveChannelPiPBtn"
                              Click="PlayPreviousLiveChannelPiP_Click"
                              Width="48" Height="48"
                              IsVisible="{Binding IsLiveContent}"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="Önceki Kanal">
                          <materialIcons:MaterialIcon Kind="SkipPrevious" Width="36" Height="36" Foreground="White" Opacity="0.9"/>
                      </Button>

                      <!-- Play/Pause (Large Center) -->
                      <Button Command="{Binding PlayPauseCommand}"
                              Width="80" Height="80"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="Oynat/Duraklat">
                          <Grid>
                              <materialIcons:MaterialIcon Kind="PauseCircleOutline" 
                                                          Width="72" Height="72" Foreground="White" 
                                                          IsVisible="{Binding IsPlaying}"/>
                              <materialIcons:MaterialIcon Kind="PlayCircleOutline" 
                                                          Width="72" Height="72" Foreground="White" 
                                                          IsVisible="{Binding IsPlaying, Converter={StaticResource InverseBoolConverter}}"/>
                          </Grid>
                      </Button>

                      <!-- VOD Skip Forward 10s -->
                      <Button Command="{Binding SkipForwardCommand}" CommandParameter="10"
                              Width="48" Height="48"
                              IsVisible="{Binding !IsLiveContent}"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="10 sn İleri">
                          <materialIcons:MaterialIcon Kind="FastForward" Width="36" Height="36" Foreground="White" Opacity="0.9"/>
                      </Button>

                      <!-- Live TV Next Channel -->
                      <Button x:Name="PlayNextLiveChannelPiPBtn"
                              Click="PlayNextLiveChannelPiP_Click"
                              Width="48" Height="48"
                              IsVisible="{Binding IsLiveContent}"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="Sonraki Kanal">
                          <materialIcons:MaterialIcon Kind="SkipNext" Width="36" Height="36" Foreground="White" Opacity="0.9"/>
                      </Button>
                  </StackPanel>

                  <!-- PiP Bottom-Right Controls -->
                  <Button x:Name="PiPBottomControls"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="12"
                          Width="40" Height="40"
                          Background="Transparent" BorderThickness="0"
                          Click="PiPReturn_Click"
                          IsVisible="{Binding #PiPCentralControls.IsVisible}"
                          ZIndex="6000"
                          Classes="pipButton"
                          ToolTip.Tip="Tam ekrana dön">
                      <materialIcons:MaterialIcon Kind="ArrowExpand" Width="24" Height="24" Foreground="White" Opacity="0.9"/>
                  </Button>

                  <!-- PiP Resize Grips (Proportional) -->
                  <!-- Corners -->
                  <!-- TopLeft, TopRight, BottomLeft removed to prevent jitter -->

                  <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="24" Height="24" Background="Transparent" 
                          Cursor="BottomRightCorner" PointerPressed="PiPCornerResize_PointerPressed" 
                          PointerMoved="PiPCornerResize_PointerMoved" PointerReleased="PiPCornerResize_PointerReleased"
                          Tag="BottomRight" ZIndex="7000" IsVisible="{Binding #PiPBottomControls.IsVisible}"/>
                  
                  <!-- Edges -->
                  <!-- Top and Left removed to prevent jitter -->

                  <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8" Margin="0,24" Background="Transparent" 
                          Cursor="SizeWestEast" PointerPressed="PiPCornerResize_PointerPressed" 
                          PointerMoved="PiPCornerResize_PointerMoved" PointerReleased="PiPCornerResize_PointerReleased"
                          Tag="Right" ZIndex="7000" IsVisible="{Binding #PiPBottomControls.IsVisible}"/>

                  <Grid x:Name="PlayerOverlayLayer" ZIndex="2600">
                    <views:VideoOverlayView x:Name="OverlayControl" ZIndex="2"/>
                    <!-- Next Episode Prompt (binds to PlayerViewModel via OverlayControl's DataContext) -->
                    <Border x:Name="NextEpisodePrompt" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="24"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,180" Width="350"
                            DataContext="{Binding #OverlayControl.DataContext}" x:DataType="vm:PlayerViewModel"
                            IsVisible="{Binding IsNextEpisodePromptVisible}" ZIndex="3000">
                      <Grid RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Text="Sonraki B&#246;l&#252;m" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                          <TextBlock Text="{Binding NextEpisode.Name}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding NextEpisode.Plot}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Row="2" Command="{Binding PlayNextEpisodeCommand}"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Padding="20,12" BorderThickness="0" HorizontalAlignment="Stretch" Cursor="Hand">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Play" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="&#350;imdi &#304;zle" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </Grid>
              </Grid>
          </controls:MemoryVideoView.OverlayContent>
      </controls:MemoryVideoView>
      </Border>
    </Grid>

    <!-- ========== STATUS BAR ========== -->
    <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Height="40">
      <Grid>
        <!-- Progressive Channel Loading Bar -->
        <ProgressBar IsVisible="{Binding IsChannelLoading}" 
                     Value="{Binding ChannelLoadingProgress}" 
                     Minimum="0" Maximum="100"
                     Height="2" VerticalAlignment="Top" 
                     Background="Transparent" 
                     Foreground="{DynamicResource AccentBrush}" 
                     BorderThickness="0"/>

        <Grid Margin="20,0" ColumnDefinitions="*,Auto">
          <!-- Left: Status & Stats -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
            <ProgressBar IsIndeterminate="True" Width="14" Height="14" 
                         IsVisible="{Binding IsLoading}" 
                         Theme="{StaticResource ProgressRingTheme}"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" 
                       Foreground="{DynamicResource TextPrimaryBrush}" 
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ChannelLoadingStats}" 
                       IsVisible="{Binding IsChannelLoading}" 
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" 
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <!-- Right: Badges -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
            <!-- Connection Health Badge -->
            <Border IsVisible="{Binding ConnectionQuality, Converter={StaticResource ConnectionHealthToVisibilityConverter}}"
                    CornerRadius="4" Padding="8,3" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- Dot indicator scaled by quality -->
                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{Binding ConnectionQuality, Converter={StaticResource ConnectionHealthToBrushConverter}}">
                  <Ellipse.Transitions>
                    <Transitions>
                      <BrushTransition Property="Fill" Duration="0:0:0.5"/>
                    </Transitions>
                  </Ellipse.Transitions>
                </Ellipse>
                <TextBlock Text="{Binding ConnectionStatusText}" FontSize="10" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>

            <!-- Channel Counter Badge -->
            <Border CornerRadius="4" Padding="8,3" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <materialIcons:MaterialIcon Kind="Television" Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
                  <Run Text="{Binding FilteredChannels.Count, Mode=OneWay}"/>
                  <Run Text="/"/>
                  <Run Text="{Binding Channels.Count, Mode=OneWay}"/>
                  <Run Text=" Kanal"/>
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Global Loading Overlay (Visible during refresh etc.) -->
    <Grid Grid.RowSpan="3" Background="#AA000000" IsVisible="{Binding IsGlobalLoading}" ZIndex="10000">
        <Border Background="{DynamicResource Bg1Brush}" 
                CornerRadius="16" 
                Padding="32" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                BoxShadow="0 10 30 5 #80000000">
            <StackPanel Spacing="24">
                <controls:PremiumSpinner Width="80" Height="80">
                    <Path Data="M 30,60 L 45,45 C 50,40 60,40 65,45 L 90,70 C 95,75 95,85 90,90 L 65,115 C 60,120 50,120 45,115 L 30,100 Z" 
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                          Width="40" Height="40"
                          Stretch="Uniform"
                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </controls:PremiumSpinner>
                <TextBlock Text="{Binding GlobalLoadingMessage}" 
                           Foreground="{DynamicResource TextPrimaryBrush}" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>

  </Grid>
</Window>
