<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Noctra.ViewModels"
        xmlns:models="using:Noctra.Models"
        xmlns:views="using:Noctra.Avalonia.Views"
        xmlns:controls="using:Noctra.Avalonia.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Noctra.Avalonia.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://Noctra.Avalonia/Assets/Logo.png"
        Title="Noctra"
        TransparencyLevelHint="None"
        Width="1400" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg0Brush}">

  <Window.Styles>
    <Style Selector="Button.SettingsGearButton materialIcons|MaterialIcon#SettingsGearIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="RenderTransform" Value="rotate(0deg)"/>
    </Style>
    <Style Selector="Button.SettingsGearButton:pointerover materialIcons|MaterialIcon#SettingsGearIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="RenderTransform" Value="rotate(120deg)"/>
    </Style>
    <Style Selector="Button.pipButton">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.pipButton:pointerover">
      <Setter Property="Background" Value="#33FFFFFF"/>
    </Style>
    <Style Selector="Button.pipButton:pressed">
        <Setter Property="Background" Value="#44FFFFFF"/>
        <Setter Property="RenderTransform" Value="scale(0.95)"/>
    </Style>
    <Style Selector="materialIcons|MaterialIcon.cornerMask">
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="ZIndex" Value="5000"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="64,*,48">

    <!-- ========== HEADER BAR ========== -->
    <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource HeaderGradientBrush}" Padding="24,0" PointerPressed="HeaderBar_PointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- Logo -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12" Margin="8,0,0,0">
          <Image Source="avares://Noctra.Avalonia/Assets/Logo.png" Height="32" />
          <TextBlock Text="Noctra" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Search Button -->
        <Button Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,24,0"
                Command="{Binding OpenSearchCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8">
          <StackPanel Orientation="Horizontal">
            <materialIcons:MaterialIcon Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0"/>
            <TextBlock Text="Ara" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
          </StackPanel>
        </Button>

        <!-- Header Actions -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <!-- Settings Button -->
          <Button Classes="SettingsGearButton" Click="SettingsButton_Click" Cursor="Hand" ToolTip.Tip="Ayarlar"
                  Width="48" Height="48" Background="Transparent" BorderThickness="0" CornerRadius="24">
            <materialIcons:MaterialIcon x:Name="SettingsGearIcon" Kind="CogOutline" Width="22" Height="22" RenderTransformOrigin="50%,50%">
              <materialIcons:MaterialIcon.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22"/>
                </Transitions>
              </materialIcons:MaterialIcon.Transitions>
            </materialIcons:MaterialIcon>
          </Button>
          <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="0,8" Opacity="0.5"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ========== MAIN CONTENT AREA ========== -->
    <Grid x:Name="MainContentArea" Grid.Row="1" ColumnDefinitions="280,*">

      <!-- SIDEBAR -->
      <Border x:Name="SideBar" Grid.Column="0" Background="{DynamicResource Bg1Brush}">
        <StackPanel Margin="16,24,16,16">
          <!-- Home -->
          <Button Classes="navItem" Click="NavigateHome_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Home}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,14"><materialIcons:MaterialIcon Kind="HomeOutline" Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Ana Sayfa" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- Live TV -->
          <Button Classes="navItem" Click="NavigateLive_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Live}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,14"><materialIcons:MaterialIcon Kind="Television" Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Canl&#305; TV" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- Movies -->
          <Button Classes="navItem" Click="NavigateMovies_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Movies}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,14"><materialIcons:MaterialIcon Kind="MovieOpenOutline" Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Filmler" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- Series -->
          <Button Classes="navItem" Click="NavigateSeries_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Series}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,14"><materialIcons:MaterialIcon Kind="Television" Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Diziler" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- My List -->
          <Button Classes="navItem" Click="NavigateMyList_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.MyList}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,14"><materialIcons:MaterialIcon Kind="PlaylistPlus" Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Listem" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- Divider -->
          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20"/>
          <!-- Favorites -->
          <Button Classes="navItem" Click="NavigateFavorites_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Favorites}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,12"><materialIcons:MaterialIcon Kind="StarOutline" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Favoriler" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- History -->
          <Button Classes="navItem" Click="NavigateHistory_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.History}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,12"><materialIcons:MaterialIcon Kind="History" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Ge&#231;mi&#351;" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center"/></Grid>
          </Button>
          <!-- Downloads -->
          <Button Classes="navItem" Click="NavigateDownloads_Click" Cursor="Hand"
                  Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Downloads}}">
            <Grid ColumnDefinitions="Auto,*" Margin="16,12"><materialIcons:MaterialIcon Kind="Download" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="&#304;ndirilenler" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center"/></Grid>
          </Button>
        </StackPanel>
      </Border>

      <!-- MAIN CONTENT -->
      <Grid Grid.Column="1">

        <!-- 1. HOME VIEW -->
                <views:HomeView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Home}}" />


        <!-- 2. MOVIES VIEW -->
                <views:MoviesView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Movies}}" />


        <!-- 3. SERIES VIEW -->
                <views:SeriesView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Series}}" />


        <!-- 4. LIVE TV VIEW -->
                <views:LiveView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Live}}" />


        <!-- 5. SEARCH VIEW -->
                <views:SearchView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Search}}" />

        <!-- 6. MY LIST VIEW -->
                <views:MyListView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.MyList}}" />


        <!-- 7. FAVORITES VIEW -->
                <views:FavoritesView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Favorites}}" />


        <!-- 8. HISTORY VIEW -->
                <views:HistoryView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.History}}" />


        <!-- 9. DOWNLOADS VIEW -->
                <views:DownloadsView IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Downloads}}" />


        <!-- Loading Skeleton State -->
        <Grid x:Name="LoadingSkeletons" Background="{DynamicResource Bg0Brush}" IsVisible="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel Margin="24">
            <Border Height="500" Background="{DynamicResource Surface0Brush}" CornerRadius="16" Margin="0,0,0,32" Opacity="0.5"/>
            <Border Width="200" Height="24" Background="{DynamicResource Surface0Brush}" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,16" Opacity="0.5"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Width="300" Height="169" Background="{DynamicResource Surface0Brush}" CornerRadius="8" Opacity="0.5"/>
              <Border Width="300" Height="169" Background="{DynamicResource Surface0Brush}" CornerRadius="8" Opacity="0.5"/>
              <Border Width="300" Height="169" Background="{DynamicResource Surface0Brush}" CornerRadius="8" Opacity="0.5"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- Search Overlay -->
        <Grid x:Name="SearchOverlay" Background="#CC000000" IsVisible="{Binding IsSearchOverlayVisible}" ZIndex="1000">
          <StackPanel MaxWidth="800" VerticalAlignment="Top" Margin="0,100,0,0">
            <Border Background="{DynamicResource Bg1Brush}" CornerRadius="8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="SearchInput" FontSize="24" Background="Transparent" BorderThickness="0" Padding="20" Watermark="Film, dizi veya kanal ara..."
                         Text="{Binding SearchQuery}" KeyDown="SearchInput_KeyDown"/>
                <Button Grid.Column="1" Command="{Binding CommitSearchCommand}" Background="Transparent" BorderThickness="0" Padding="20" Cursor="Hand">
                  <materialIcons:MaterialIcon Kind="Magnify" Width="24" Height="24" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
              </Grid>
            </Border>
            <ScrollViewer MaxHeight="500" Margin="0,20,0,0">
              <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.DataTemplates>
                  <DataTemplate x:DataType="models:Channel">
                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                      <Border Background="{DynamicResource Surface1Brush}" CornerRadius="8" Padding="16">
                        <Grid ColumnDefinitions="120,*">
                          <Border Width="100" Height="56" CornerRadius="4" Background="{DynamicResource Surface1Brush}" ClipToBounds="True">
                            <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding GroupTitle}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                            <Border Height="3" Background="#33FFFFFF" Margin="0,12,0,0"
                                    IsVisible="{Binding WatchedPercentage, Converter={StaticResource CountToVisibilityConverter}}">
                              <Border Width="{Binding WatchedPercentage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=640}"
                                      Background="#8D09E5" HorizontalAlignment="Left"/>
                            </Border>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>

                  <DataTemplate x:DataType="models:Series">
                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                      <Border Background="{DynamicResource Surface1Brush}" CornerRadius="8" Padding="16">
                        <Grid ColumnDefinitions="120,*">
                          <Border Width="100" Height="56" CornerRadius="4" Background="{DynamicResource Surface1Brush}" ClipToBounds="True">
                            <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Genre}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.DataTemplates>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="40" Foreground="White"
                  Background="Transparent" BorderThickness="0" Command="{Binding CloseSearchCommand}" Cursor="Hand">
            <materialIcons:MaterialIcon Kind="Close" Width="22" Height="22" Foreground="White"/>
          </Button>
        </Grid>

        <!-- Series Detail Overlay -->
        <Grid x:Name="SeriesDetailOverlay" Background="{DynamicResource BackgroundGradientBrush}"
              IsVisible="{Binding IsSeriesDetailVisible}" ZIndex="998">
          <Grid Margin="52,88">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnDefinitions="260,*" Margin="0,0,0,28">
              <Border Height="360" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource Surface0Brush}">
                <controls:RemoteImage Stretch="UniformToFill" Url="{Binding SelectedSeriesPosterUrl}"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="28,0,0,0">
                <Button Command="{Binding CloseSeriesDetailCommand}" HorizontalAlignment="Left" Margin="0,0,0,20" Background="Transparent" BorderThickness="0" Cursor="Hand">
                  <materialIcons:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
                <TextBlock Text="{Binding SelectedSeries.Name}" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="{Binding SelectedSeries.Genre}" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0"/>
                  <TextBlock Text="{Binding SelectedSeries.ReleaseYear}" FontSize="16" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding SelectedSeriesOverview}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,16,0,0" MaxHeight="96"/>
                <TextBlock Text="{Binding SelectedSeriesCast, StringFormat='Oyuncular: {0}'}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"
                           IsVisible="{Binding SelectedSeriesCast, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                <TextBlock Text="Detaylar y&#252;kleniyor..." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"
                           IsVisible="{Binding IsSelectedSeriesMetadataLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
              </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" Padding="0,8,0,0">
              <Grid>
                <!-- Normal detay görünümü -->
                <ItemsControl ItemsSource="{Binding SelectedSeries.Seasons}"
                              IsVisible="{Binding IsDownloadedSeriesDetailMode, Converter={StaticResource InverseBoolConverter}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,40">
                        <TextBlock Text="{Binding SeasonNumber, StringFormat='Sezon {0}'}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding Episodes}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Margin="0,0,16,24" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" x:DataType="models:Episode"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PlayEpisodeCommand}" CommandParameter="{Binding}">
                                <Border Background="{DynamicResource Bg1Brush}" CornerRadius="8" Width="240">
                                  <Grid RowDefinitions="Auto,*">
                                    <Border Height="100" CornerRadius="8,8,0,0" ClipToBounds="True">
                                      <Grid>
                                        <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                                        <Border Background="#44000000"/>
                                        <materialIcons:MaterialIcon Kind="Play" Foreground="White" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                        <Border Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                Background="{DynamicResource AccentBrush}" IsVisible="{Binding ., Converter={StaticResource EpisodeCompletionBadgeVisibilityConverter}}">
                                          <materialIcons:MaterialIcon Kind="Check" Foreground="White" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                      </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Padding="12">
                                      <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <Border Height="3" Background="#33FFFFFF" Margin="0,12,0,0"
                                                IsVisible="{Binding ., Converter={StaticResource EpisodeWatchedProgressVisibilityConverter}}">
                                          <Border Width="{Binding ., Converter={StaticResource EpisodeWatchedProgressWidthConverter}, ConverterParameter=150}"
                                                  Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                                        </Border>
                                      </StackPanel>
                                    </Border>
                                  </Grid>
                                </Border>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- İndirilen dizi görünümü: sezonlara ayrılmış düz liste -->
                <ItemsControl ItemsSource="{Binding SelectedSeries.Seasons}"
                              IsVisible="{Binding IsDownloadedSeriesDetailMode}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Season">
                      <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="{Binding SeasonNumber, StringFormat='Season {0}'}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Episodes}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Episode">
                              <Button Margin="0,0,0,8"
                                      Padding="12,10"
                                      Background="{DynamicResource Surface0Brush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      BorderThickness="1"
                                      HorizontalContentAlignment="Stretch"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PlayEpisodeCommand}"
                                      CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="*,Auto">
                                  <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BaseDisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SeriesInfoText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0"
                                               IsVisible="{Binding SeriesInfoText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                  </StackPanel>
                                  <materialIcons:MaterialIcon Grid.Column="2" Kind="Play" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}"/>
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>


      </Grid>
    </Grid>



    <!-- Player Area (full window overlay) -->
    <Grid x:Name="PlayerArea" Grid.RowSpan="3" Background="Transparent" IsVisible="False" ClipToBounds="True" ZIndex="5000">
      <!-- Main Content Container with Rounded Corners for PiP -->
      <Border x:Name="PiPContainer"
              CornerRadius="0"
              ClipToBounds="True"
              Background="Black">
          <controls:MemoryVideoView x:Name="VideoSurface">
              <controls:MemoryVideoView.OverlayContent>
                  <Grid>
                      <views:WatermarkView x:Name="PiPWatermark" DataContext="{Binding WatermarkViewModel}" ZIndex="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,100"/>
                      <Border x:Name="MouseCaptureLayer"
                              ZIndex="2500"
                              Background="Transparent"
                              PointerMoved="MouseCaptureLayer_PointerMoved"
                              PointerPressed="MouseCaptureLayer_PointerPressed"/>

                      <!-- PiP Window Frame (Border & Shadows) - Visible only in PiP -->
                      <Border x:Name="PiPFrame"
                              BorderBrush="#44FFFFFF"
                              BorderThickness="1"
                              CornerRadius="0"
                              IsVisible="{Binding #PiPCentralControls.IsVisible}"
                              ZIndex="5001"
                              IsHitTestVisible="False">
                          <Border.BoxShadow>
                              <BoxShadows>0 10 40 0 #AA000000</BoxShadows>
                          </Border.BoxShadow>
                      </Border>

                  <!-- PiP Central Controls (Netflix Style) -->
                  <StackPanel x:Name="PiPCentralControls"
                              Orientation="Horizontal"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Spacing="40"
                              IsVisible="{Binding IsPiPControlsVisible}"
                              ZIndex="6000"
                              x:DataType="vm:PlayerViewModel">
                      
                      <!-- VOD Skip Backward 10s -->
                      <Button Command="{Binding SkipBackwardCommand}" CommandParameter="10"
                              Width="48" Height="48"
                              IsVisible="{Binding !IsLiveContent}"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="10 sn Geri">
                          <materialIcons:MaterialIcon Kind="Rewind" Width="36" Height="36" Foreground="White" Opacity="0.9"/>
                      </Button>

                      <!-- Live TV Previous Channel -->
                      <Button x:Name="PlayPreviousLiveChannelPiPBtn"
                              Click="PlayPreviousLiveChannelPiP_Click"
                              Width="48" Height="48"
                              IsVisible="{Binding IsLiveContent}"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="Önceki Kanal">
                          <materialIcons:MaterialIcon Kind="SkipPrevious" Width="36" Height="36" Foreground="White" Opacity="0.9"/>
                      </Button>

                      <!-- Play/Pause (Large Center) -->
                      <Button Command="{Binding PlayPauseCommand}"
                              Width="80" Height="80"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="Oynat/Duraklat">
                          <Grid>
                              <materialIcons:MaterialIcon Kind="PauseCircleOutline" 
                                                          Width="72" Height="72" Foreground="White" 
                                                          IsVisible="{Binding IsPlaying}"/>
                              <materialIcons:MaterialIcon Kind="PlayCircleOutline" 
                                                          Width="72" Height="72" Foreground="White" 
                                                          IsVisible="{Binding IsPlaying, Converter={StaticResource InverseBoolConverter}}"/>
                          </Grid>
                      </Button>

                      <!-- VOD Skip Forward 10s -->
                      <Button Command="{Binding SkipForwardCommand}" CommandParameter="10"
                              Width="48" Height="48"
                              IsVisible="{Binding !IsLiveContent}"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="10 sn İleri">
                          <materialIcons:MaterialIcon Kind="FastForward" Width="36" Height="36" Foreground="White" Opacity="0.9"/>
                      </Button>

                      <!-- Live TV Next Channel -->
                      <Button x:Name="PlayNextLiveChannelPiPBtn"
                              Click="PlayNextLiveChannelPiP_Click"
                              Width="48" Height="48"
                              IsVisible="{Binding IsLiveContent}"
                              Background="Transparent" BorderThickness="0"
                              Classes="pipButton" ToolTip.Tip="Sonraki Kanal">
                          <materialIcons:MaterialIcon Kind="SkipNext" Width="36" Height="36" Foreground="White" Opacity="0.9"/>
                      </Button>
                  </StackPanel>

                  <!-- PiP Bottom-Right Controls -->
                  <Button x:Name="PiPBottomControls"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="12"
                          Width="40" Height="40"
                          Background="Transparent" BorderThickness="0"
                          Click="PiPReturn_Click"
                          IsVisible="{Binding #PiPCentralControls.IsVisible}"
                          ZIndex="6000"
                          Classes="pipButton"
                          ToolTip.Tip="Tam ekrana dön">
                      <materialIcons:MaterialIcon Kind="ArrowExpand" Width="24" Height="24" Foreground="White" Opacity="0.9"/>
                  </Button>

                  <!-- PiP Resize Grips (Proportional) -->
                  <!-- Corners -->
                  <!-- TopLeft, TopRight, BottomLeft removed to prevent jitter -->

                  <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="24" Height="24" Background="Transparent" 
                          Cursor="BottomRightCorner" PointerPressed="PiPCornerResize_PointerPressed" 
                          PointerMoved="PiPCornerResize_PointerMoved" PointerReleased="PiPCornerResize_PointerReleased"
                          Tag="BottomRight" ZIndex="7000" IsVisible="{Binding #PiPBottomControls.IsVisible}"/>
                  
                  <!-- Edges -->
                  <!-- Top and Left removed to prevent jitter -->

                  <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8" Margin="0,24" Background="Transparent" 
                          Cursor="SizeWestEast" PointerPressed="PiPCornerResize_PointerPressed" 
                          PointerMoved="PiPCornerResize_PointerMoved" PointerReleased="PiPCornerResize_PointerReleased"
                          Tag="Right" ZIndex="7000" IsVisible="{Binding #PiPBottomControls.IsVisible}"/>

                  <Grid x:Name="PlayerOverlayLayer" ZIndex="2600">
                    <views:VideoOverlayView x:Name="OverlayControl" ZIndex="2"/>
                    <!-- Next Episode Prompt (binds to PlayerViewModel via OverlayControl's DataContext) -->
                    <Border x:Name="NextEpisodePrompt" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="24"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,180" Width="350"
                            DataContext="{Binding #OverlayControl.DataContext}" x:DataType="vm:PlayerViewModel"
                            IsVisible="{Binding IsNextEpisodePromptVisible}" ZIndex="3000">
                      <Grid RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Text="Sonraki B&#246;l&#252;m" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                          <TextBlock Text="{Binding NextEpisode.Name}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding NextEpisode.Plot}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Row="2" Command="{Binding PlayNextEpisodeCommand}"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Padding="20,12" BorderThickness="0" HorizontalAlignment="Stretch" Cursor="Hand">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Play" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="&#350;imdi &#304;zle" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </Grid>
              </Grid>
          </controls:MemoryVideoView.OverlayContent>
      </controls:MemoryVideoView>
      </Border>
    </Grid>

    <!-- ========== STATUS BAR ========== -->
    <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource HeaderGradientBrush}">
      <Grid Margin="24,0" ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="{DynamicResource RadiusPill}" Padding="14,6">
          <TextBlock Text="{Binding FilteredChannels.Count, StringFormat='{}{0} kanal'}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
        </Border>
      </Grid>
    </Border>

  </Grid>
</Window>

