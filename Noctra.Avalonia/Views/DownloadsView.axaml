<UserControl x:CompileBindings="True" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:views="using:Noctra.Avalonia.Views"
             xmlns:converters="using:Noctra.Avalonia.Converters"
             xmlns:behaviors="using:Noctra.Avalonia.Behaviors"
             xmlns:avaloniaConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:Noctra.Avalonia.Localization"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Noctra.Avalonia.Views.DownloadsView"
             x:DataType="vm:MainViewModel">
  
  <UserControl.Styles>
    <!-- Tab Button Style (Converted to TabItem) -->
    <Style Selector="TabItem.downloadTab">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="PART_HeaderPresenter"
                                Content="{TemplateBinding Header}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="SelectionIndicator"
                    Height="3"
                    Width="0"
                    Background="{DynamicResource AccentBrush}"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    CornerRadius="1.5">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
              </Border.Transitions>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem.downloadTab:selected">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TabItem.downloadTab:selected /template/ Border#SelectionIndicator">
      <Setter Property="Width" Value="32"/>
    </Style>
    <Style Selector="TabItem.downloadTab:pointerover:not(:selected)">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style Selector="Border.Badge">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,2" />
    </Style>

    <Style Selector="Border.AccentBadge">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,2" />
    </Style>

    <Style Selector="ListBox.downloadVirtualList ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- Whole-card open button (no dead zones; trash stays a separate target) -->
    <Style Selector="Button.downloadCard">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.downloadCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
    </Style>
    <Style Selector="ListBox.downloadVirtualList > ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.downloadVirtualList > ListBoxItem:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.downloadVirtualList > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.dangerTextHover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.dangerTextHover:pointerover materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.dangerTextHover:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Downloads}}">
    <ScrollViewer x:Name="DownloadsScrollViewer">
      <StackPanel Margin="32">

        <!-- Title Section -->
        <StackPanel Spacing="4" Margin="0,0,0,24">
          <TextBlock Text="{loc:Translate Downloads.Title}" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="{Binding TotalDownloadsInfoText}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding HasDownloadedItems}"/>
        </StackPanel>

        <!-- Storage Quota Card (above the tabs, like mobile) -->
        <Border Background="{DynamicResource Surface0Brush}" CornerRadius="8" Padding="20" Margin="0,0,0,24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Icon -->
            <materialIcons:MaterialIcon Kind="Database" Width="48" Height="48" Foreground="{DynamicResource AccentBrush}"/>

            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{loc:Translate Downloads.Storage.Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding StorageUsageDetailText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
              </Grid>

              <!-- Progress Bar -->
              <Border Height="8" Background="{DynamicResource Bg1Brush}" CornerRadius="2" ClipToBounds="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding StorageOtherPercent, Converter={StaticResource DoubleToStarGridLengthConverter}}"/>
                    <ColumnDefinition Width="{Binding StorageNoctraPercent, Converter={StaticResource DoubleToStarGridLengthConverter}}"/>
                    <ColumnDefinition Width="{Binding StoragePendingPercent, Converter={StaticResource DoubleToStarGridLengthConverter}}"/>
                    <ColumnDefinition Width="{Binding StorageFreePercent, Converter={StaticResource DoubleToStarGridLengthConverter}}"/>
                  </Grid.ColumnDefinitions>

                  <!-- Other Usage (Lighter Purple) -->
                  <Rectangle Grid.Column="0" Fill="{DynamicResource AccentLightBrush}"/>

                  <!-- Noctra Usage (Solid Accent Purple) -->
                  <Rectangle Grid.Column="1" Fill="{DynamicResource AccentBrush}"/>

                  <!-- Pending Space (Ghost Accent) -->
                  <Rectangle Grid.Column="2" Fill="{DynamicResource AccentBrush}" Opacity="0.5"/>

                  <!-- Free Space (Empty/Background) -->
                  <Rectangle Grid.Column="3" Fill="Transparent"/>
                </Grid>
              </Border>

              <!-- Legend -->
              <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0" Spacing="6">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentLightBrush}"/>
                  <TextBlock Text="{loc:Translate Downloads.Storage.Other}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0" Spacing="6">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                  <TextBlock Text="{loc:Translate Downloads.Storage.Noctra}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0" Spacing="6">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.5"/>
                  <TextBlock Text="{loc:Translate Downloads.Storage.Pending}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="10" Height="10" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource TextMutedBrush}" Opacity="0.3"/>
                  <TextBlock Text="{loc:Translate Downloads.Storage.Free}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                </StackPanel>
              </WrapPanel>
            </StackPanel>

            <!-- Actions: Delete all (only when there is something) + Open folder -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" Margin="24,0,0,0" VerticalAlignment="Center">
              <Button Content="{loc:Translate Downloads.Action.DeleteAll}" Command="{Binding DeleteAllDownloadsCommand}"
                      Theme="{StaticResource ErrorButton}"
                      IsVisible="{Binding HasDownloadedItems}"/>
              <Button Content="{loc:Translate Downloads.Action.OpenFolder}" Command="{Binding OpenDownloadsFolderCommand}"
                      Theme="{StaticResource SettingsActionButton}" FontSize="12"
                      HorizontalAlignment="Stretch" VerticalContentAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Storage Warning -->
        <Border Background="#33FF4444" CornerRadius="6" Padding="10,6" Margin="0,0,0,24" IsVisible="{Binding ShowStorageWarning}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="#FFFF4444"/>
            <TextBlock Text="{loc:Translate Downloads.Storage.Warning}" 
                       Foreground="#FFFF4444" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- Empty State -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,40"
                    IsVisible="{Binding ShowDownloadsEmptyState}">
          <materialIcons:MaterialIcon Kind="DownloadOffOutline" Width="64" Height="64" Foreground="{DynamicResource TextMutedBrush}" Opacity="0.5"/>
          <TextBlock Text="{loc:Translate Downloads.Empty.Title}" FontSize="20" LetterSpacing="1" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,4" TextAlignment="Center"/>
          <TextBlock Text="{loc:Translate Downloads.Empty.Description}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
        </StackPanel>

        <!-- Tabs & Content (hidden when there is nothing downloaded) -->
        <TabControl behaviors:TabSlideTransitionBehavior.IsEnabled="True" ClipToBounds="True" Background="Transparent" SelectedIndex="{Binding DownloadTabIndex, Mode=TwoWay}" Padding="0" Margin="0" BorderThickness="0"
                    IsVisible="{Binding HasAnyDownloadState}">
          <TabControl.Template>
            <ControlTemplate>
              <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,-2" Margin="0,0,0,24">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0,0,0,-1"/>
                </Border>
                <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1" Content="{TemplateBinding SelectedContent}" />
              </Grid>
            </ControlTemplate>
          </TabControl.Template>

          <TabControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </TabControl.ItemsPanel>

          <!-- TABS CONTENT: LIBRARY -->
          <TabItem Classes="downloadTab" Header="{loc:Translate Downloads.Tabs.Library}">
            <StackPanel Spacing="16" Margin="0,24,0,0">

              <!-- Sort -->
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="1" x:Name="SortSelectionButton" Classes="DesktopIconButton" Width="44" Height="44"
                        Click="OpenDownloadSortSheet_Click"
                        AutomationProperties.Name="{loc:Translate Downloads.Sort.Title}"
                        AutomationProperties.HelpText="{loc:Translate Downloads.Sort.Title}">
                  <materialIcons:MaterialIcon x:Name="SortSelectionIcon" Kind="Sort" Width="23" Height="23"/>
                </Button>
              </Grid>

              <!-- Series Section -->
              <StackPanel Spacing="12" IsVisible="{Binding DownloadedSeriesItems.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock Text="{loc:Translate History.Series}" FontSize="20" LetterSpacing="1" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding DownloadedSeriesItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Series">
                      <!-- Card: the WHOLE card opens the item; only the trash
                           button is a separate hit target (no dead zones). -->
                      <Border Background="{DynamicResource Surface0Brush}" CornerRadius="8" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
                          <Button Classes="downloadCard"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                                  CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                              <!-- Mini Poster -->
                              <Border Width="48" Height="56" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Surface1Brush}">
                                <Grid>
                                  <Image Source="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LogoThemeConverter}, ConverterParameter=Full}"
                                         Width="32" Height="32" Stretch="Uniform" Opacity="0.12"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         IsHitTestVisible="False" />
                                  <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                                </Grid>
                              </Border>

                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding LocalSizeText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                              </StackPanel>

                              <materialIcons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Foreground="{DynamicResource TextMutedBrush}"
                                                          Width="24" Height="24" VerticalAlignment="Center"/>
                            </Grid>
                          </Button>
                          <Button Grid.Column="1" Theme="{StaticResource ErrorButton}" VerticalAlignment="Center"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteDownloadedMediaCommand}"
                                  CommandParameter="{Binding}"
                                  MinWidth="48" Padding="8" Background="Transparent" BorderThickness="0">
                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="18" Height="18"/>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Movies Section -->
              <StackPanel Spacing="12" IsVisible="{Binding DownloadedVodChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock Text="{loc:Translate History.Movies}" FontSize="20" LetterSpacing="1" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding DownloadedVodChannels}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Channel">
                      <!-- Card: the WHOLE card opens the item; only the trash
                           button is a separate hit target (no dead zones). -->
                      <Border Background="{DynamicResource Surface0Brush}" CornerRadius="8" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
                          <Button Classes="downloadCard"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                                  CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                              <!-- Mini Poster -->
                              <Border Width="48" Height="64" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Surface1Brush}">
                                <Grid>
                                  <Image Source="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LogoThemeConverter}, ConverterParameter=Full}"
                                         Width="32" Height="32" Stretch="Uniform" Opacity="0.12"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         IsHitTestVisible="False" />
                                  <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                                </Grid>
                              </Border>

                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding LocalSizeText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                              </StackPanel>

                              <materialIcons:MaterialIcon Grid.Column="2" Kind="PlayOutline" Foreground="{DynamicResource TextMutedBrush}"
                                                          Width="24" Height="24" VerticalAlignment="Center"/>
                            </Grid>
                          </Button>
                          <Button Grid.Column="1" Theme="{StaticResource ErrorButton}" VerticalAlignment="Center"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteDownloadedMediaCommand}"
                                  CommandParameter="{Binding}"
                                  MinWidth="48" Padding="8" Background="Transparent" BorderThickness="0">
                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="18" Height="18"/>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </TabItem>

          <!-- TABS CONTENT: DOWNLOAD CENTER -->
          <TabItem Classes="downloadTab">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{loc:Translate Downloads.Tabs.Center}" VerticalAlignment="Center"/>
                <Border IsVisible="{Binding ActiveDownloadCount, Converter={StaticResource CountToVisibilityConverter}}"
                        Classes="AccentBadge">
                  <TextBlock Text="{Binding ActiveDownloadCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>
              </StackPanel>
            </TabItem.Header>
            <StackPanel Spacing="16" Margin="0,24,0,0">

              <!-- Ongoing Header -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                    IsVisible="{Binding ActiveDownloadingItems.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{loc:Translate Downloads.Ongoing.Title}" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <Border Classes="Badge" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveDownloadingItems.Count, Converter={StaticResource StringFormatConverter}, ConverterParameter='Downloads.Ongoing.Count.Format'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                  </Border>
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource ErrorButton}" Command="{Binding StopAllDownloadsCommand}"
                        Padding="12,6" FontSize="12" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16"/>
                    <TextBlock Text="{loc:Translate Downloads.Action.StopAll}"/>
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Active Empty State -->
              <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="0,16,0,16"
                          IsVisible="{Binding ActiveDownloadCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}">
                <TextBlock Text="{loc:Translate Downloads.Ongoing.Empty.Title}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
                <TextBlock Text="{loc:Translate Downloads.Ongoing.Empty.Description}" FontSize="12" Opacity="0.65"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
              </StackPanel>

              <!-- Active Cards -->
              <ListBox ItemsSource="{Binding ActiveDownloadingItems}"
                       Classes="downloadVirtualList"
                       MaxHeight="640"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0"
                       SelectionChanged="ClearTransientSelection"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.IsScrollChainingEnabled="True">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel CacheLength="0.5" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:DownloadItem">
                    <Border Background="{DynamicResource Surface0Brush}" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                          <!-- Poster -->
                          <Border Width="48" Height="64" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Surface1Brush}">
                            <Grid>
                              <materialIcons:MaterialIcon Kind="Download" Foreground="{DynamicResource TextMutedBrush}" Width="24" Height="24" Opacity="0.35"/>
                              <controls:RemoteImage Stretch="UniformToFill" Url="{Binding PosterUrl}"/>
                            </Grid>
                          </Border>

                          <!-- Info -->
                          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BaseDisplayName}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ., Converter={StaticResource DownloadStatusToLocalizedTextConverter}}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                          </StackPanel>

                          <!-- Percent -->
                          <TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontWeight="SemiBold" FontSize="14"
                                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                     Foreground="{Binding Status, Converter={StaticResource DownloadStatusToBrushConverter}}"
                                     CornerRadius="2"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding SpeedBytesPerSecond, Converter={StaticResource DownloadSpeedTextConverter}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold"/>
                              <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Opacity="0.5"
                                         IsVisible="{Binding SpeedBytesPerSecond, Converter={StaticResource CountToVisibilityConverter}}"/>
                              <TextBlock Text="{Binding EstimatedSecondsRemaining, Converter={StaticResource DownloadEtaTextConverter}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                          </StackPanel>

                          <!-- Actions -->
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).TogglePauseDownloadCommand}"
                                    CommandParameter="{Binding}"
                                    Theme="{StaticResource SettingsActionButton}" FontSize="12">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="{Binding IsPaused, Converter={StaticResource BoolToMaterialIconKindConverter}, ConverterParameter='Play|Pause'}" Width="16" Height="16"/>
                                <TextBlock Text="{loc:Translate Downloads.Action.Resume}" IsVisible="{Binding IsPaused}"/>
                                <TextBlock Text="{loc:Translate Downloads.Action.Pause}" IsVisible="{Binding !IsPaused}"/>
                              </StackPanel>
                            </Button>
                            <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelDownloadCommand}"
                                    CommandParameter="{Binding}"
                                    Theme="{StaticResource ErrorButton}" Padding="10,6" FontSize="12">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16"/>
                                <TextBlock Text="{loc:Translate Downloads.Action.Cancel}"/>
                              </StackPanel>
                            </Button>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Queue Header -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,16,0,0"
                    IsVisible="{Binding QueuedDownloadItems.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock Text="{loc:Translate Downloads.Queue.Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Command="{Binding ClearQueueCommand}"
                        Theme="{StaticResource ErrorButton}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16"/>
                    <TextBlock Text="{loc:Translate Downloads.Action.ClearQueue}"/>
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Queue Cards -->
              <ListBox ItemsSource="{Binding QueuedDownloadItems}"
                       Classes="downloadVirtualList"
                       MaxHeight="640"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0"
                       SelectionChanged="ClearTransientSelection"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.IsScrollChainingEnabled="True">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel CacheLength="0.5" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:DownloadItem">
                    <Border Background="{DynamicResource Surface0Brush}" Opacity="0.8" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                        <!-- Number -->
                        <TextBlock Text="{Binding QueueOrder}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>

                        <!-- Mini Icon -->
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Surface1Brush}" VerticalAlignment="Center">
                          <Grid>
                            <materialIcons:MaterialIcon Kind="Download" Foreground="{DynamicResource TextMutedBrush}" Width="16" Height="16" Opacity="0.35"/>
                            <controls:RemoteImage Stretch="UniformToFill" Url="{Binding PosterUrl}"/>
                          </Grid>
                        </Border>

                        <!-- Title -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding BaseDisplayName}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding ., Converter={StaticResource DownloadStatusToLocalizedTextConverter}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Actions/Size -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                          <TextBlock Text="{Binding BytesTotal, Converter={StaticResource BytesToHumanConverter}}"
                                     FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                          <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelDownloadCommand}"
                                  CommandParameter="{Binding}"
                                  Theme="{StaticResource ErrorButton}" FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
                              <TextBlock Text="{loc:Translate Downloads.Action.Cancel}"/>
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Failed Header -->
              <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0"
                    IsVisible="{Binding FailedDownloadItems.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock Text="{loc:Translate Downloads.Failed.Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
              </Grid>

              <!-- Failed Cards -->
              <ListBox ItemsSource="{Binding FailedDownloadItems}"
                       Classes="downloadVirtualList"
                       MaxHeight="640"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0"
                       SelectionChanged="ClearTransientSelection"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.IsScrollChainingEnabled="True">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel CacheLength="0.5" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:DownloadItem">
                    <Border Background="{DynamicResource Surface0Brush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <Border Width="48" Height="64" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Surface1Brush}">
                            <Grid>
                              <materialIcons:MaterialIcon Kind="AlertCircleOutline" Foreground="{DynamicResource ErrorBrush}" Width="24" Height="24" Opacity="0.7"/>
                              <controls:RemoteImage Stretch="UniformToFill" Url="{Binding PosterUrl}"/>
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BaseDisplayName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap"
                                       IsVisible="{Binding ErrorMessage, Converter={x:Static avaloniaConverters:StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding SizeText, Converter={StaticResource StringFormatConverter}, ConverterParameter='Downloads.Failed.SizeFormat'}"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                          </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBlock Text="{Binding ., Converter={StaticResource DownloadStatusToLocalizedTextConverter}}"
                                     FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RetryDownloadCommand}"
                                    CommandParameter="{Binding}"
                                    Theme="{StaticResource PrimaryButtonStyle}" Padding="12,6" FontSize="12">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                                <TextBlock Text="{loc:Translate Downloads.Failed.Retry}"/>
                              </StackPanel>
                            </Button>
                            <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelDownloadCommand}"
                                    CommandParameter="{Binding}"
                                    Theme="{StaticResource ErrorButton}" FontSize="12">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16"/>
                                <TextBlock Text="{loc:Translate Downloads.Action.Delete}"/>
                              </StackPanel>
                            </Button>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>
    </ScrollViewer>
    <views:DesktopSelectionSheet x:Name="SelectionSheetHost" ZIndex="40000" />
  </Grid>
</UserControl>
