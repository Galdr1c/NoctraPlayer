<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Noctra.ViewModels"
        xmlns:controls="using:Noctra.Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="300"
        xmlns:loc="using:Noctra.Avalonia.Localization"
        x:Class="Noctra.Avalonia.Views.ProfileLoadingWindow"
        x:DataType="vm:ProfileLoadingViewModel"
        Icon="avares://Noctra/Assets/Square44x44Logo.targetsize-256.png"
        Title="{loc:Translate Profile.Loading.Title}"
        Width="450" Height="350"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="True"
        Topmost="False">

    <Panel>
        <!-- Consistent Background Gradient -->
        <Border CornerRadius="12" Background="{DynamicResource BackgroundGradientBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Margin="40" ClipToBounds="True">
            <Border.BoxShadow>
                <BoxShadows>0 10 40 10 #80000000</BoxShadows>
            </Border.BoxShadow>
            
            <Grid RowDefinitions="*,Auto,Auto">
                <!-- Top Section: Standard Themed Spinner -->
                <Panel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:PremiumSpinner>
                        <!-- Pulsing App Logo in Center -->
                        <Image Source="avares://Noctra/Assets/Square71x71Logo.png"
                               Width="40" Height="40"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               RenderTransformOrigin="50%,50%">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Image.RenderTransform>
                            <Image.Styles>
                                <Style Selector="Image">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="CubicEaseInOut">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="Opacity" Value="0.5"/>
                                                <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                                                <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="50%">
                                                <Setter Property="Opacity" Value="1.0"/>
                                                <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                                                <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="Opacity" Value="0.5"/>
                                                <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                                                <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Image.Styles>
                        </Image>
                    </controls:PremiumSpinner>
                </Panel>

                <!-- Middle Section: Status (Red on error) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,40" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Noctra" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="14" 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="380"
                               TextWrapping="Wrap">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Style>
                            <Style Selector="TextBlock[Tag=True]">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </TextBlock.Styles>
                        <TextBlock.Tag>
                            <Binding Path="IsError"/>
                        </TextBlock.Tag>
                    </TextBlock>
                    <Border Background="#1AFFA500" 
                            BorderBrush="#80FFA500" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12,8"
                            Margin="0,12,0,0"
                            IsVisible="{Binding LoadingWarningMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                        <TextBlock Text="{Binding LoadingWarningMessage}"
                                   Foreground="#FFA500"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Bottom Section: Profile Badge -->
                <Border Grid.Row="2" Background="{DynamicResource Bg1Brush}" CornerRadius="0,0,12,12" Padding="15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                        <Border Width="28" Height="28" CornerRadius="6" ClipToBounds="True"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Image Source="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}" />
                        </Border>
                        <TextBlock Text="{Binding ProfileName}" 
                                   VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   FontSize="15" 
                                   FontWeight="Medium"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Panel>
</Window>
