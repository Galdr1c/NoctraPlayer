<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Noctra.ViewModels"
        xmlns:controls="using:Noctra.Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="300"
        x:Class="Noctra.Avalonia.Views.ProfileLoadingWindow"
        x:DataType="vm:ProfileLoadingViewModel"
        Title="Oturum Açılıyor"
        Width="450" Height="300"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Panel>
        <!-- Consistent Background Gradient -->
        <Border CornerRadius="12" Background="{DynamicResource BackgroundGradientBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Border.BoxShadow>
                <BoxShadows>0 10 30 5 #80000000</BoxShadows>
            </Border.BoxShadow>
            
            <Grid RowDefinitions="*,Auto,Auto">
                <!-- Top Section: Standard Themed Spinner -->
                <Panel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:PremiumSpinner>
                        <!-- App Logo Pulsing in Center (Closed Path) -->
                        <Path Data="M 30,60 L 45,45 C 50,40 60,40 65,45 L 90,70 C 95,75 95,85 90,90 L 65,115 C 60,120 50,120 45,115 L 30,100 Z" 
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                              Width="40" Height="40"
                              Stretch="Uniform"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </controls:PremiumSpinner>
                </Panel>

                <!-- Middle Section: Status (Red on error) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,40" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Noctra" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="14" 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="380"
                               TextWrapping="Wrap">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Style>
                            <Style Selector="TextBlock[Tag=True]">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </TextBlock.Styles>
                        <TextBlock.Tag>
                            <Binding Path="IsError"/>
                        </TextBlock.Tag>
                    </TextBlock>
                    <Border Background="#1AFFA500" 
                            BorderBrush="#80FFA500" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12,8"
                            Margin="0,12,0,0"
                            IsVisible="{Binding LoadingWarningMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                        <TextBlock Text="{Binding LoadingWarningMessage}"
                                   Foreground="#FFA500"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Bottom Section: Profile Badge -->
                <Border Grid.Row="2" Background="{DynamicResource Bg1Brush}" CornerRadius="0,0,12,12" Padding="15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                        <Border Width="28" Height="28" CornerRadius="6" ClipToBounds="True"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Image Source="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}" />
                        </Border>
                        <TextBlock Text="{Binding ProfileName}" 
                                   VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   FontSize="15" 
                                   FontWeight="Medium"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Panel>
</Window>
