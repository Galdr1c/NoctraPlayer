<UserControl x:CompileBindings="True" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:views="using:Noctra.Avalonia.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Noctra.Avalonia.Views.SearchView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer x:Name="SearchScrollViewer" IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Search}}">
          <ScrollViewer.Resources>
            <DataTemplate x:Key="SearchChannelCardTemplate" x:DataType="models:Channel">
              <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                <Button.ContextFlyout>
                  <MenuFlyout>
                    <MenuItem Header="Listem'e Ekle/&#199;&#305;kar"
                              Click="Context_AddToMyList_Click" Tag="{Binding}" 
                              CommandParameter="{Binding}"
                              IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
                    <MenuItem Header="Favorilere Ekle/&#199;&#305;kar"
                              Click="Context_ToggleFavorite_Click" Tag="{Binding}" 
                              CommandParameter="{Binding}"
                              IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
                  </MenuFlyout>
                </Button.ContextFlyout>
                <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                  <StackPanel>
                    <Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12">
                      <controls:RemoteImage Width="60" Stretch="Uniform" Url="{Binding CoverUrl}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding GroupTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>

            <DataTemplate x:Key="SearchSeriesCardTemplate" x:DataType="models:Series">
              <Button Width="180" Margin="0,0,16,16" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
                <Button.ContextFlyout>
                  <MenuFlyout>
                    <MenuItem Header="Listem'e Ekle/&#199;&#305;kar"
                              Click="Context_AddToMyList_Click" Tag="{Binding}" 
                              CommandParameter="{Binding}"
                              IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
                    <MenuItem Header="Favorilere Ekle/&#199;&#305;kar"
                              Click="Context_ToggleFavorite_Click" Tag="{Binding}" 
                              CommandParameter="{Binding}"
                              IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
                  </MenuFlyout>
                </Button.ContextFlyout>
                <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                  <StackPanel>
                    <Border Height="100" Background="{DynamicResource IconGradientBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,12" ClipToBounds="True">
                      <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SeasonCountSafe, StringFormat='Sezon: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextAlignment="Center" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ScrollViewer.Resources>

          <StackPanel Margin="24">
            <TextBlock Text="Arama Sonu&#231;lar&#305;" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>
            <!-- Search Suggestion -->
            <Border Margin="0,0,0,20" Padding="12,10" Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusSmall}"
                    IsVisible="{Binding SearchSuggestion, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Bunu mu demek istediniz?" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <Button Content="{Binding SearchSuggestion}" Margin="10,0,0,0" Padding="10,4" Command="{Binding ApplySearchSuggestionCommand}"
                        Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"/>
              </StackPanel>
            </Border>

            <!-- Live results -->
            <StackPanel Margin="0,0,0,24" IsVisible="{Binding SearchLiveChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
              <TextBlock Text="Canl&#305; TV" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
              <ItemsControl ItemsSource="{Binding SearchLiveChannels}" ItemTemplate="{StaticResource SearchChannelCardTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>

            <!-- Series results -->
            <StackPanel Margin="0,0,0,24" IsVisible="{Binding SearchSeriesChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
              <TextBlock Text="Dizi" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
              <ItemsControl ItemsSource="{Binding SearchSeriesChannels}" ItemTemplate="{StaticResource SearchSeriesCardTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>

            <!-- VOD results -->
            <StackPanel Margin="0,0,0,24" IsVisible="{Binding SearchVodChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
              <TextBlock Text="VOD" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
              <ItemsControl ItemsSource="{Binding SearchVodChannels}" ItemTemplate="{StaticResource SearchChannelCardTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>

            <!-- Similar Results -->
            <StackPanel Margin="0,8,0,24" IsVisible="{Binding ShowSearchSimilarSection}">
              <TextBlock Text="Yak&#305;n Sonu&#231;lar" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

              <!-- Similar Live -->
              <StackPanel Margin="0,0,0,20" IsVisible="{Binding SearchSimilarLiveChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock Text="Canl&#305; TV" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding SearchSimilarLiveChannels}" ItemTemplate="{StaticResource SearchChannelCardTemplate}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>

              <!-- Similar Series -->
              <StackPanel Margin="0,0,0,20" IsVisible="{Binding SearchSimilarSeriesChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock Text="Dizi" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding SearchSimilarSeriesChannels}" ItemTemplate="{StaticResource SearchSeriesCardTemplate}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>

              <!-- Similar VOD -->
              <StackPanel Margin="0,0,0,8" IsVisible="{Binding SearchSimilarVodChannels.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock Text="VOD" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding SearchSimilarVodChannels}" ItemTemplate="{StaticResource SearchChannelCardTemplate}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <!-- Empty search -->
            <StackPanel HorizontalAlignment="Center" Margin="0,100,0,0" IsVisible="{Binding ShowSearchEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
              <TextBlock Text="Sonu&#231; bulunamad&#305;." FontSize="16" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
</UserControl>