<UserControl x:Class="Noctra.Avalonia.Views.VideoOverlayView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:epg="using:Noctra.Avalonia.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:loc="using:Noctra.Avalonia.Localization"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             x:Name="OverlayRoot"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False"
             Focusable="True"
             d:DesignHeight="800" d:DesignWidth="1200"
             KeyDown="OverlayRoot_KeyDown"
             PointerMoved="OverlayRoot_PointerMoved"
             PointerPressed="OverlayRoot_PointerPressed"
             PointerWheelChanged="OverlayRoot_PointerWheelChanged">
    
    <UserControl.Styles>
        <Style Selector="Button.iconBtn">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.iconBtn:pointerover">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.iconBtn:pressed">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>
        
        <Style Selector="Button.outlineBtn">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <Style Selector="Button.panelCloseBtn">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
        </Style>
        <Style Selector="Button.panelCloseBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>

        <Style Selector="Button.listItemBtn">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.listItemBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>

        <Style Selector="Button.episodeCardBtn">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.episodeCardBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
            <Setter Property="ZIndex" Value="1"/>
        </Style>
        <Style Selector="Button.episodeCardBtn:pointerover Border#CardBackground">
            <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}"/>
        </Style>

        <!-- Side Panel Styles -->
        <Style Selector="Grid.sidePanel">
            <Setter Property="Width" Value="400"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ZIndex" Value="1000"/>
            <Setter Property="RenderTransform" Value="translateX(400px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Grid.sidePanel[IsVisible=True]">
            <Setter Property="RenderTransform" Value="translateX(0)"/>
        </Style>

        <Style Selector="Border.panelContent">
            <Setter Property="Background" Value="#E61A1A1A"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BoxShadow" Value="-10 0 50 0 #66000000"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style Selector="Border.panelTitleUnderline">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,-12,0,12"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="CornerRadius" Value="1"/>
        </Style>

        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="350"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader, Expander:down /template/ ToggleButton#ExpanderHeader, Expander:up /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pressed">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
            <Setter Property="Margin" Value="16,0,8,0"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ ContentPresenter#PART_ContentPresenter, Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Expander /template/ Border#ExpanderContent, Expander:down /template/ Border#ExpanderContent, Expander:up /template/ Border#ExpanderContent, Expander:left /template/ Border#ExpanderContent, Expander:right /template/ Border#ExpanderContent">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Expander /template/ Border#PART_ContentBorder">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent">
        <ThemeVariantScope RequestedThemeVariant="Dark">
            <Grid>

        <!-- OVERLAY CONTENT -->
        <Grid x:Name="OverlayContent"
              IsHitTestVisible="{Binding IsVisible}"
              Opacity="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=OpacityOnly}">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="QuadraticEaseOut"/>
                </Transitions>
            </Grid.Transitions>

            <!-- 1. Top Gradient -->
            <Grid x:Name="LegacyTopGradient" IsHitTestVisible="False" VerticalAlignment="Top">
                <Border Height="140">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#CC000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- 2. Top Bar -->
            <Grid x:Name="LegacyTopBar" VerticalAlignment="Top" Margin="32,32,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                    <Button Command="{Binding ClosePlayerCommand}" 
                            Classes="iconBtn" 
                            ToolTip.Tip="{loc:Translate Player.Overlay.Back}">
                        <materialIcons:MaterialIcon Kind="ArrowLeft" Width="24" Height="24" Foreground="White"/>
                    </Button>
                    <TextBlock Text="{Binding CurrentChannel.Name}" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" LetterSpacing="0.2" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Opacity="0.8">
                        <materialIcons:MaterialIcon Kind="{Binding NetworkIcon}" Width="16" Height="16" Foreground="White"/>
                        <TextBlock Text="{Binding NetworkStatus}" FontSize="13" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentTimeStr}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 3. Bottom Control Bar -->
            <Border x:Name="LegacyTransportControls" VerticalAlignment="Bottom" Padding="32,80,32,32" CornerRadius="8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#99000000" Offset="0.3"/>
                        <GradientStop Color="#CC000000" Offset="0.6"/>
                        <GradientStop Color="#F2000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,Auto">
                    <!-- Timeline Slider with Hover Preview -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Slider x:Name="TimelineSlider" 
                                Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position}"
                                IsVisible="{Binding !IsLiveContent}" Foreground="{DynamicResource AccentBrush}" 
                                Focusable="False" 
                                PointerMoved="TimelineSlider_PointerMoved"
                                PointerEntered="TimelineSlider_PointerEntered"
                                PointerExited="TimelineSlider_PointerExited"
                                Padding="0"/>       
                        
                        <Popup x:Name="HoverTimePopup" IsOpen="False" IsHitTestVisible="False"
                               PlacementTarget="{Binding #TimelineSlider}"
                               Placement="Top">
                            <Border Background="#E6000000" CornerRadius="4" Padding="10,5">
                                <TextBlock x:Name="HoverTimeText" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Live Stream EPG Info -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0,0,16"
                                IsVisible="{Binding IsLiveContent}">
                        <Border Background="{DynamicResource ErrorBrush}" CornerRadius="2" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="White" VerticalAlignment="Center">
                                    <Ellipse.Styles>
                                        <Style Selector="Ellipse">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1" IterationCount="INFINITE" PlaybackDirection="Alternate">
                                                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Ellipse.Styles>
                                </Ellipse>
                                <TextBlock Text="{loc:Translate Player.Overlay.Live}" FontSize="12" FontWeight="Black" Foreground="White" VerticalAlignment="Center" LetterSpacing="1"/>
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding CurrentProgram.Title}" Foreground="White" FontSize="16" FontWeight="Bold" 
                                       IsVisible="{Binding CurrentProgram.Title, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding CurrentProgram.TimeRange}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" FontWeight="Medium"
                                       IsVisible="{Binding HasCurrentProgramInfo}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Transport Controls -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                            <Button Command="{Binding SkipBackwardCommand}" CommandParameter="10" Classes="iconBtn" IsVisible="{Binding !IsLiveContent}" ToolTip.Tip="{loc:Translate Player.Overlay.Backward}">
                                <materialIcons:MaterialIcon Kind="Rewind10" Width="22" Height="22" Foreground="#E6FFFFFF"/>
                            </Button>
                            <Button Click="PlayPreviousLiveChannel_Click" Classes="iconBtn" IsVisible="{Binding IsLiveContent}" ToolTip.Tip="{loc:Translate Player.Overlay.PreviousChannel}">
                                <materialIcons:MaterialIcon Kind="SkipPrevious" Width="18" Height="18" Foreground="#E6FFFFFF"/>
                            </Button>
                            <Button Command="{Binding PlayPauseCommand}" Classes="iconBtn">
                                <Grid>
                                    <materialIcons:MaterialIcon Kind="Pause" Width="28" Height="28" Foreground="White" IsVisible="{Binding IsPlaying}"/>
                                    <materialIcons:MaterialIcon Kind="Play" Width="28" Height="28" Foreground="White" IsVisible="{Binding IsPlaying, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>
                            </Button>
                            <Button Command="{Binding SkipForwardCommand}" CommandParameter="10" Classes="iconBtn" IsVisible="{Binding !IsLiveContent}" ToolTip.Tip="{loc:Translate Player.Overlay.Forward}">
                                <materialIcons:MaterialIcon Kind="FastForward10" Width="22" Height="22" Foreground="#E6FFFFFF"/>
                            </Button>
                            <Button Click="PlayNextLiveChannel_Click" Classes="iconBtn" IsVisible="{Binding IsLiveContent}" ToolTip.Tip="{loc:Translate Player.Overlay.NextChannel}">
                                <materialIcons:MaterialIcon Kind="SkipNext" Width="18" Height="18" Foreground="#E6FFFFFF"/>
                            </Button>
                            <Button Command="{Binding ToggleLiveFavoriteCommand}" 
                                    Classes="iconBtn" 
                                    IsVisible="{Binding IsLiveContent}" 
                                    ToolTip.Tip="{loc:Translate Player.Overlay.Favorite.Tooltip}">
                                <materialIcons:MaterialIcon Kind="{Binding IsCurrentChannelFavorite, Converter={StaticResource BoolToFavoriteIconConverter}}" 
                                                           Width="18" Height="18" Foreground="#E6FFFFFF"/>
                            </Button>
                            
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0,0,0">
                                <Button Command="{Binding ToggleMuteCommand}" Classes="iconBtn" ToolTip.Tip="{loc:Translate Player.Overlay.Mute.Tooltip}">
                                    <Grid>
                                        <materialIcons:MaterialIcon Kind="VolumeOff" Width="22" Height="22" Foreground="#E6FFFFFF" IsVisible="{Binding IsMuted}"/>
                                        <materialIcons:MaterialIcon Kind="VolumeHigh" Width="22" Height="22" Foreground="#E6FFFFFF" IsVisible="{Binding IsMuted, Converter={StaticResource InverseBoolConverter}}"/>
                                    </Grid>
                                </Button>
                                <Slider x:Name="VolumeSlider" Width="70" VerticalAlignment="Center"
                                        Minimum="0" Maximum="100" Value="{Binding Volume}" Foreground="{DynamicResource AccentBrush}" Focusable="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding !IsLiveContent}">
                                <TextBlock Text="{Binding PositionText}" Foreground="#E6FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="/" Foreground="#66FFFFFF" FontSize="13" FontWeight="SemiBold" Margin="4,0"/>
                                <TextBlock Text="{Binding DurationText}" Foreground="#B3FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                            <Button Command="{Binding OpenEpisodesCommand}" Classes="iconBtn" IsVisible="{Binding IsSeriesContent}" ToolTip.Tip="{loc:Translate Player.Overlay.Episodes.Tooltip}"><materialIcons:MaterialIcon Kind="Animation" Width="20" Height="20" Foreground="#E6FFFFFF"/></Button>
                            <Button Command="{Binding PlayNextEpisodeCommand}" Classes="iconBtn" IsVisible="{Binding IsSeriesContent}" ToolTip.Tip="{loc:Translate Player.Overlay.NextEpisode.Tooltip}"><materialIcons:MaterialIcon Kind="StepForward" Width="20" Height="20" Foreground="#E6FFFFFF"/></Button>
                            <!-- EPG Guide Button — canlı yayın için -->
                            <Button Command="{Binding ToggleEpgPanelCommand}"
                                    Classes="iconBtn"
                                    IsVisible="{Binding IsLiveContent}"
                                    ToolTip.Tip="{loc:Translate Player.Epg.GuideTooltip}">
                                <Grid>
                                    <materialIcons:MaterialIcon Kind="CalendarClock" Width="20" Height="20" Foreground="#E6FFFFFF"
                                                               IsVisible="{Binding IsEpgPanelOpen, Converter={StaticResource InverseBoolConverter}}"/>
                                    <materialIcons:MaterialIcon Kind="CalendarClock" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"
                                                               IsVisible="{Binding IsEpgPanelOpen}"/>
                                </Grid>
                            </Button>
                            <Button Command="{Binding DownloadCurrentContentCommand}" Classes="iconBtn" IsVisible="{Binding CanShowDownloadButton}" IsEnabled="{Binding CanDownloadCurrentContent}" ToolTip.Tip="{loc:Translate Player.Overlay.Download.Tooltip}"><materialIcons:MaterialIcon Kind="Download" Width="20" Height="20" Foreground="#E6FFFFFF"/></Button>
                            <Button Command="{Binding OpenInfoPanelCommand}" Classes="iconBtn" IsVisible="{Binding CanShowInfoButton}" ToolTip.Tip="{loc:Translate Player.Overlay.Info.Tooltip}"><materialIcons:MaterialIcon Kind="InformationBoxOutline" Width="20" Height="20" Foreground="#E6FFFFFF"/></Button>
                            <Button Command="{Binding CycleVideoFillModeCommand}" Classes="iconBtn"
                                    ToolTip.Tip="{loc:Translate Player.Overlay.FillMode.Tooltip}">
                                <materialIcons:MaterialIcon Kind="{Binding VideoFillMode,
                                    Converter={StaticResource FillModeToIconConverter}}" Width="20" Height="20" Foreground="#E6FFFFFF"/>
                            </Button>

                            <!-- Sleep Timer Butonu — sadece Premium -->
                            <Button Classes="iconBtn"
                                    IsVisible="{Binding !IsLiveContent}"
                                    ToolTip.Tip="{loc:Translate Player.Overlay.SleepTimer.Tooltip}"
                                    Command="{Binding ShowSleepTimerMenuCommand}">
                                <Panel>
                                    <materialIcons:MaterialIcon Kind="WeatherNight" Width="20" Height="20" Foreground="#E6FFFFFF"/>
                                    <!-- Aktifken üzerinde küçük geri sayım badge -->
                                    <Border IsVisible="{Binding IsSleepTimerActive}"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="6" Padding="3,1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-4,-4,0">
                                        <TextBlock Text="{Binding SleepTimerCountdown}"
                                                   FontSize="8" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </Panel>
                            </Button>

                            <Button Command="{Binding OpenAudioSettingsCommand}" Classes="iconBtn" ToolTip.Tip="{loc:Translate Player.Overlay.Subtitles.Tooltip}"><materialIcons:MaterialIcon Kind="Subtitles" Width="20" Height="20" Foreground="#E6FFFFFF"/></Button>
                            <Button Command="{Binding OpenQualitySettingsCommand}" Classes="iconBtn" ToolTip.Tip="{loc:Translate Player.Overlay.Settings.Tooltip}"><materialIcons:MaterialIcon Kind="Cog" Width="20" Height="20" Foreground="#E6FFFFFF"/></Button>
                            <Button Command="{Binding EnterPiPCommand}" Classes="iconBtn" ToolTip.Tip="{loc:Translate Player.Overlay.PiP.Tooltip}"><materialIcons:MaterialIcon Kind="PictureInPictureBottomRight" Width="20" Height="20" Foreground="#E6FFFFFF"/></Button>
                            <Button Command="{Binding ToggleFullScreenCommand}" Classes="iconBtn" ToolTip.Tip="{loc:Translate Player.Overlay.Fullscreen.Tooltip}">
                                <Grid>
                                    <materialIcons:MaterialIcon Kind="Fullscreen" Width="22" Height="22" Foreground="#E6FFFFFF" IsVisible="{Binding IsFullScreen, Converter={StaticResource InverseBoolConverter}}"/>
                                    <materialIcons:MaterialIcon Kind="FullscreenExit" Width="22" Height="22" Foreground="#E6FFFFFF" IsVisible="{Binding IsFullScreen}"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>


            <!-- ═══════════════════════════════════════════════════════════════
                 EPG TIMELINE PANEL
                 Canlı yayında player küçülür, alt kısımda EPG timeline gösterilir.
                 Panel: translateY(100%) → translateY(0) animasyonu ile yukarı kayar.
                 Kanal listesi: ayarlanan sırayla (SortIndex), sol taraf frozen, 
                 timeline bölümü yatay + dikey scroll destekler.
            ════════════════════════════════════════════════════════════════ -->
            <Grid x:Name="EpgPanel"
                  VerticalAlignment="Bottom"
                  Height="480"
                  ZIndex="800"
                  ClipToBounds="True"
                  IsVisible="{Binding IsEpgPanelOpen}"
                  Margin="{Binding IsEpgPanelOpen, Converter={StaticResource BoolToEpgPanelMarginConverter}, ConverterParameter=480}">
                <Grid.Transitions>
                    <Transitions>
                        <ThicknessTransition Property="Margin" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                    </Transitions>
                </Grid.Transitions>

                <!-- Panel arka planı -->
                <Border Background="#EE0D0D0D"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="0,1,0,0"
                        BoxShadow="0 -20 60 0 #88000000"/>

                <Grid RowDefinitions="52,*">

                    <!-- ── Üst bar: başlık + zaman + kapat ── -->
                    <Border Grid.Row="0"
                            Background="#1A7B2FBE"
                            BorderBrush="#267B2FBE"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              Margin="20,0,16,0">

                            <!-- Sol: ikon + başlık -->
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <materialIcons:MaterialIcon Kind="CalendarClock"
                                                           Width="18" Height="18"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{loc:Translate Player.Epg.GuideTitle}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                                <Border Background="#267B2FBE"
                                        CornerRadius="4"
                                        Padding="8,3"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="EpgDateLabel"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#B3FFFFFF"/>
                                </Border>
                            </StackPanel>

                            <!-- Orta: loading göstergesi -->
                            <Border Grid.Column="1"
                                    Background="#33F59E0B"
                                    BorderBrush="#66F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,5"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsEpgError}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="AlertCircle"
                                                               Width="14" Height="14"
                                                               Foreground="#FBBF24"
                                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Translate Player.Epg.ErrorDescription}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#FDE68A"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="360"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        IsVisible="{Binding IsEpgLoading}"
                                        Margin="0,0,24,0">
                                <controls:PremiumSpinner Width="28" Height="28"
                                        HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Translate Common.Loading}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Sağ: kapat butonu -->
                            <Button Grid.Column="2"
                                    Command="{Binding ToggleEpgPanelCommand}"
                                    Classes="panelCloseBtn"
                                    VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ── İçerik: Frozen kanal isimleri + Timeline ── -->
                    <Grid Grid.Row="1" ColumnDefinitions="200,*" ClipToBounds="True">

                        <!-- Sol sütun: Zaman başlığı hizalayıcı + Frozen kanal isimleri -->
                        <Grid RowDefinitions="40,*"
                              Background="#0D0D0D"
                              ZIndex="10"
                              ClipToBounds="True">
                            <Border Grid.Row="0"
                                    Background="#131313"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="0,0,1,1">
                                <TextBlock Text="{loc:Translate Player.Epg.ChannelHeader}"
                                           FontSize="9" FontWeight="Black"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           LetterSpacing="1.5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          x:Name="EpgNamesScroll"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Hidden"
                                          IsHitTestVisible="False">
                                <ItemsControl ItemsSource="{Binding #OverlayRoot.DesktopEpg.Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="epg:DesktopEpgPanelRow">
                                            <Border Height="68"
                                                    BorderBrush="#0DFFFFFF"
                                                    BorderThickness="0,0,1,1"
                                                    Background="{Binding IsCurrentChannel,
                                                        Converter={StaticResource BoolToSelectionBrushConverter}}">
                                                <Grid ColumnDefinitions="44,*">
                                                    <Border Grid.Column="0"
                                                            Width="34" Height="34"
                                                            CornerRadius="6"
                                                            ClipToBounds="True"
                                                            Background="#1AFFFFFF"
                                                            Margin="6,0,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <controls:RemoteImage
                                                            Url="{Binding Channel.LogoUrl}"
                                                            Stretch="Uniform"/>
                                                    </Border>

                                                    <Grid Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          Margin="6,0,8,0">
                                                        <TextBlock Text="{Binding Channel.Name}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxLines="2"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Sağ sütun: Saat başlığı + Timeline -->
                        <Grid Grid.Column="1" RowDefinitions="40,*" ClipToBounds="True">
                            <Border Grid.Row="0"
                                    Background="#131313"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="0,0,0,1">
                                <ScrollViewer x:Name="EpgTimeHeaderScroll"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              IsHitTestVisible="False">
                                    <Canvas x:Name="EpgTimeHeaderCanvas"
                                            Width="{Binding #OverlayRoot.DesktopEpg.CanvasWidth}"
                                            Height="40"/>
                                </ScrollViewer>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          x:Name="EpgTimelineScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          ScrollChanged="EpgTimelineScroll_ScrollChanged">
                                <Grid Width="{Binding #OverlayRoot.DesktopEpg.CanvasWidth}">
                                    <ItemsControl ItemsSource="{Binding #OverlayRoot.DesktopEpg.Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="epg:DesktopEpgPanelRow">
                                                <Grid Height="68">
                                                    <!-- Satır arkaplanı -->
                                                    <Border Background="{Binding IsCurrentChannel,
                                                                Converter={StaticResource BoolToSelectionBrushConverter}}"
                                                            BorderBrush="#0DFFFFFF"
                                                            BorderThickness="0,0,0,1"/>

                                                    <!-- Kanal satırı tıklama butonu (şeffaf üst katman) -->
                                                    <Border PointerReleased="EpgChannelRow_PointerReleased"
                                                            Background="Transparent"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            ZIndex="5"
                                                            IsVisible="{Binding IsCurrentChannel, Converter={StaticResource InverseBoolConverter}}"/>

                                                    <!-- Boş EPG etiketi -->
                                                    <TextBlock Text="{loc:Translate Player.Epg.NoInfo}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0"
                                                               IsVisible="{Binding HasEpgData, Converter={StaticResource InverseBoolConverter}}"/>

                                                    <!-- Program blokları (pixel bazlı margin ile konumlandırma) -->
                                                    <ItemsControl ItemsSource="{Binding Blocks}"
                                                                  IsVisible="{Binding HasEpgData}"
                                                                  ClipToBounds="True"
                                                                  ZIndex="6">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Grid/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="epg:DesktopEpgProgramBlock">
                                                                <!-- Margin.Left = PixelLeft, HorizontalAlignment=Left ile mutlak konum -->
                                                                <Border Width="{Binding PixelWidth}"
                                                                        Margin="{Binding PixelLeft,
                                                                            Converter={StaticResource DoubleToLeftMarginConverter}}"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        Height="{Binding VisualHeight}"
                                                                        CornerRadius="4"
                                                                        ClipToBounds="True"
                                                                        Padding="0"
                                                                        PointerReleased="EpgChannelRow_PointerReleased"
                                                                        ToolTip.Tip="{Binding Program.Title}"
                                                                        ToolTip.Placement="Top">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Color="{Binding IsCurrentProgram,
                                                                            Converter={StaticResource BoolToEpgBlockColorConverter}}"/>
                                                                    </Border.Background>
                                                                    <Border.BorderBrush>
                                                                        <SolidColorBrush Color="{Binding IsCurrentProgram,
                                                                            Converter={StaticResource BoolToEpgBorderColorConverter}}"/>
                                                                    </Border.BorderBrush>
                                                                    <Border.BorderThickness>
                                                                        <Binding Path="IsStrip"
                                                                                 Converter="{StaticResource BoolToThicknessConverter}"
                                                                                 ConverterParameter="0|1.5,0,0,0"/>
                                                                    </Border.BorderThickness>
                                                                    <Border.Opacity>
                                                                        <Binding Path="IsPast"
                                                                                 Converter="{StaticResource BoolToOpacityConverter}"
                                                                                 ConverterParameter="0.45"/>
                                                                    </Border.Opacity>

                                                                    <Grid Margin="7,0"
                                                                          ClipToBounds="True"
                                                                          IsVisible="{Binding IsStrip,
                                                                              Converter={StaticResource InverseBoolConverter}}">
                                                                        <TextBlock Text="{Binding Program.Title}"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="White"
                                                                                   Width="{Binding TitleTextWidth}"
                                                                                   TextWrapping="NoWrap"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxLines="1"
                                                                                   LineHeight="14"
                                                                                   VerticalAlignment="Center"
                                                                                   ClipToBounds="True"
                                                                                   IsVisible="{Binding HasReadableText}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- NOW çizgisi (her satırda) -->
                                                    <Border Width="1.5"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Stretch"
                                                            Background="#CC7B2FBE"
                                                            Margin="{Binding NowLineLeft, Converter={StaticResource DoubleToLeftMarginConverter}}"
                                                            IsHitTestVisible="False"
                                                            ZIndex="10"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Sleep Timer Panel -->
            <Grid x:Name="SleepTimerPanel" Classes="sidePanel" IsVisible="{Binding IsSleepTimerPanelOpen}">
                <Border Classes="panelContent">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Margin="32,48,32,24" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Translate Player.Sleep.Title}" Classes="panelTitle"/>
                                <Border Classes="panelTitleUnderline"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ClosePanelsCommand}" Classes="panelCloseBtn" VerticalAlignment="Top" Margin="16,-8,0,0">
                                <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="32,0,32,40">
                            <StackPanel Spacing="8">
                                <Border Background="{Binding SleepTimerMode, Converter={StaticResource SleepModeToBackgroundConverter}, ConverterParameter=Off}" CornerRadius="4">
                                    <Button Command="{Binding SetSleepTimerCommand}" CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Off}" Classes="listItemBtn">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="20" Height="20" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{loc:Translate Player.Sleep.Off}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </Border>

                                <Grid>
                                    <Border Background="{Binding SleepTimerMode, Converter={StaticResource SleepModeToBackgroundConverter}, ConverterParameter=Minutes15}" CornerRadius="4">
                                        <Button Command="{Binding SetSleepTimerCommand}" 
                                                CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes15}" 
                                                IsEnabled="{Binding IsPremium}"
                                                Classes="listItemBtn">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Kind="Timer" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{loc:Translate Player.Sleep.Minutes15}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SleepTimerCountdown}" IsVisible="{Binding SleepTimerMode, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:PlayerViewModel+SleepTimerOption.Minutes15}}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </Border>
                                    <materialIcons:MaterialIcon Kind="Lock" Width="18" Height="18" 
                                                                Foreground="{DynamicResource TextMutedBrush}" 
                                                                IsVisible="{Binding !IsPremium}" 
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Margin="0,0,12,0"
                                                                IsHitTestVisible="False"/>
                                </Grid>

                                <Grid>
                                    <Border Background="{Binding SleepTimerMode, Converter={StaticResource SleepModeToBackgroundConverter}, ConverterParameter=Minutes30}" CornerRadius="4">
                                        <Button Command="{Binding SetSleepTimerCommand}" 
                                                CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes30}" 
                                                IsEnabled="{Binding IsPremium}"
                                                Classes="listItemBtn">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Kind="Timer" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{loc:Translate Player.Sleep.Minutes30}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SleepTimerCountdown}" IsVisible="{Binding SleepTimerMode, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:PlayerViewModel+SleepTimerOption.Minutes30}}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </Border>
                                    <materialIcons:MaterialIcon Kind="Lock" Width="18" Height="18" 
                                                                Foreground="{DynamicResource TextMutedBrush}" 
                                                                IsVisible="{Binding !IsPremium}" 
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Margin="0,0,12,0"
                                                                IsHitTestVisible="False"/>
                                </Grid>

                                <Grid>
                                    <Border Background="{Binding SleepTimerMode, Converter={StaticResource SleepModeToBackgroundConverter}, ConverterParameter=Minutes60}" CornerRadius="4">
                                        <Button Command="{Binding SetSleepTimerCommand}" 
                                                CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.Minutes60}" 
                                                IsEnabled="{Binding IsPremium}"
                                                Classes="listItemBtn">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Kind="Timer" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{loc:Translate Player.Sleep.Minutes60}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SleepTimerCountdown}" IsVisible="{Binding SleepTimerMode, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:PlayerViewModel+SleepTimerOption.Minutes60}}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </Border>
                                    <materialIcons:MaterialIcon Kind="Lock" Width="18" Height="18" 
                                                                Foreground="{DynamicResource TextMutedBrush}" 
                                                                IsVisible="{Binding !IsPremium}" 
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Margin="0,0,12,0"
                                                                IsHitTestVisible="False"/>
                                </Grid>

                                <Grid>
                                    <Border Background="{Binding SleepTimerMode, Converter={StaticResource SleepModeToBackgroundConverter}, ConverterParameter=EndOfEpisode}" CornerRadius="4">
                                        <Button Command="{Binding SetSleepTimerCommand}" 
                                                CommandParameter="{x:Static vm:PlayerViewModel+SleepTimerOption.EndOfEpisode}" 
                                                IsEnabled="{Binding IsPremium}"
                                                Classes="listItemBtn">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"/>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding EndOfContentText}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding EndOfContentDescription}" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Border>
                                    <materialIcons:MaterialIcon Kind="Lock" Width="18" Height="18" 
                                                                Foreground="{DynamicResource TextMutedBrush}" 
                                                                IsVisible="{Binding !IsPremium}" 
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Margin="0,0,12,0"
                                                                IsHitTestVisible="False"/>
                                </Grid>

                                <Button IsVisible="{Binding IsSleepTimerActive}" Command="{Binding CancelSleepTimerCommand}" Margin="0,16,0,0" HorizontalAlignment="Stretch" Padding="12" CornerRadius="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TimerOff" Width="16" Height="16"/>
                                        <TextBlock Text="{loc:Translate Player.Sleep.Cancel}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Info Panel -->
            <Grid x:Name="InfoPanel" Classes="sidePanel" IsVisible="{Binding IsInfoPanelOpen}">
                <Border Classes="panelContent">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Margin="32,48,32,24" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Translate Player.Info.Title}" Classes="panelTitle"/>
                                <Border Classes="panelTitleUnderline"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ClosePanelsCommand}" Classes="panelCloseBtn" VerticalAlignment="Top" Margin="16,-8,0,0">
                                <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Grid Margin="32,0,32,40">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding CurrentChannel.Name}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding CurrentEpisode.TmdbEpisodeName}" FontSize="15" Foreground="{DynamicResource AccentBrush}" FontStyle="Italic" Opacity="0.9" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding CurrentEpisode.TmdbEpisodeName, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,24" IsVisible="{Binding !IsLiveContent}">
                                        <TextBlock Text="{Binding CurrentEpisode.AirDateText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" IsVisible="{Binding CurrentEpisode.AirDateText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                        <TextBlock Text="&#8226;" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" IsVisible="{Binding CurrentEpisode.AirDateText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" IsVisible="{Binding DurationText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                    </StackPanel>
                                    
                                    <!-- Live Only -->
                                    <Border Background="{DynamicResource Surface1Brush}" CornerRadius="8" Padding="20" Margin="0,0,0,24" IsVisible="{Binding IsLiveInfoVisible}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Player.Info.NowPlaying}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" LetterSpacing="1" Margin="0,0,0,12"/>
                                            <TextBlock Text="{Binding CurrentProgram.Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding CurrentProgram.TimeRange}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,0,12" IsVisible="{Binding HasCurrentProgramInfo}"/>
                                            <TextBlock Text="{Binding CurrentProgram.Description}" Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.8" FontSize="14" TextWrapping="Wrap" LineHeight="22" IsVisible="{Binding CurrentProgram.Description, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Episode Plot (Series) -->
                                    <Border Background="{DynamicResource Surface1Brush}" CornerRadius="8" Padding="20" Margin="0,0,0,24" IsVisible="{Binding IsSeriesPlotVisible}">
                                        <TextBlock Text="{Binding CurrentEpisode.Plot}" Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.8" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                                    </Border>

                                    <!-- VOD Plot (Movies/Single) -->
                                    <Border Background="{DynamicResource Surface1Brush}" CornerRadius="8" Padding="20" Margin="0,0,0,24" IsVisible="{Binding IsVodPlotVisible}">
                                        <TextBlock Text="{Binding CurrentChannel.Plot}" Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.8" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                                    </Border>

                                    <StackPanel Margin="0,0,0,24" IsVisible="{Binding CurrentChannel.Director, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{loc:Translate Player.Info.Director}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" Margin="0,0,0,8"/>
                                            <Border Height="1" Width="50" HorizontalAlignment="Left" Background="{DynamicResource Surface1Brush}" Opacity="0.5"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CurrentChannel.Director}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,24" IsVisible="{Binding CurrentChannel.Cast, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{loc:Translate Player.Info.Cast}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" Margin="0,0,0,8"/>
                                            <Border Height="1" Width="60" HorizontalAlignment="Left" Background="{DynamicResource Surface1Brush}" Opacity="0.5"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CurrentChannel.Cast}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Audio Settings -->
            <Grid x:Name="AudioSettingsPanel" Classes="sidePanel" IsVisible="{Binding IsAudioSettingsOpen}">
                <Border Classes="panelContent">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Margin="32,48,32,24" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Translate Player.Settings.Title}" Classes="panelTitle"/>
                                <Border Classes="panelTitleUnderline"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ClosePanelsCommand}" Classes="panelCloseBtn" VerticalAlignment="Top" Margin="16,-8,0,0">
                                <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                            <StackPanel Margin="32,0,32,40">
                                <Border Background="{DynamicResource NavActiveBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,24" IsVisible="{Binding !IsLiveContent}" Opacity="0.9">
                                    <Grid ColumnDefinitions="24,*">
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{loc:Translate Player.Settings.RestartNote}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="8,2,0,0" LineHeight="16" />
                                    </Grid>
                                </Border>

                                <StackPanel Margin="0,0,0,12" IsVisible="{Binding !IsLiveContent}">
                                    <TextBlock Text="{loc:Translate Player.Settings.SubtitleSize}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" Margin="0,0,0,8"/>
                                    <Border Height="1" Width="40" HorizontalAlignment="Left" Background="{DynamicResource Surface1Brush}" Opacity="0.5"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,24" IsVisible="{Binding !IsLiveContent}">
                                    <UniformGrid Columns="4" Margin="0,0,0,8">
                                        <Button Command="{Binding SetSubtitleSizeCommand}" CommandParameter="Small" Content="{loc:Translate Player.Settings.SubtitleSize.Small}" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="0,0,4,0"
                                                Background="{Binding SubtitleTextSize, Converter={StaticResource EqualityToSelectionBrushConverter}, ConverterParameter=Small}"/>
                                        <Button Command="{Binding SetSubtitleSizeCommand}" CommandParameter="Medium" Content="{loc:Translate Player.Settings.SubtitleSize.Normal}" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="4,0,4,0"
                                                Background="{Binding SubtitleTextSize, Converter={StaticResource EqualityToSelectionBrushConverter}, ConverterParameter=Medium}"/>
                                        <Button Command="{Binding SetSubtitleSizeCommand}" CommandParameter="Large" Content="{loc:Translate Player.Settings.SubtitleSize.Large}" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="4,0,4,0"
                                                Background="{Binding SubtitleTextSize, Converter={StaticResource EqualityToSelectionBrushConverter}, ConverterParameter=Large}"/>
                                        <Button Command="{Binding SetSubtitleSizeCommand}" CommandParameter="ExtraLarge" Content="{loc:Translate Player.Settings.SubtitleSize.ExtraLarge}" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="4,0,0,0"
                                                Background="{Binding SubtitleTextSize, Converter={StaticResource EqualityToSelectionBrushConverter}, ConverterParameter=ExtraLarge}"/>
                                    </UniformGrid>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12" IsVisible="{Binding !IsLiveContent}">
                                    <TextBlock Text="{loc:Translate Player.Settings.SubtitleBackground}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" Margin="0,0,0,8"/>
                                    <Border Height="1" Width="60" HorizontalAlignment="Left" Background="{DynamicResource Surface1Brush}" Opacity="0.5"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,24" IsVisible="{Binding !IsLiveContent}">
                                    <UniformGrid Columns="4" Margin="0,0,0,8">
                                        <Button Command="{Binding SetSubtitleBackgroundCommand}" CommandParameter="0" Content="{loc:Translate Player.Settings.SubtitleBackground.Off}" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="0,0,4,0"
                                                Background="{Binding SubtitleBackgroundOpacity, Converter={StaticResource EqualityToSelectionBrushConverter}, ConverterParameter=0}"/>
                                        <Button Command="{Binding SetSubtitleBackgroundCommand}" CommandParameter="30" Content="{loc:Translate Player.Settings.SubtitleBackground.Light}" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="4,0,4,0"
                                                Background="{Binding SubtitleBackgroundOpacity, Converter={StaticResource EqualityToSelectionBrushConverter}, ConverterParameter=30}"/>
                                        <Button Command="{Binding SetSubtitleBackgroundCommand}" CommandParameter="60" Content="{loc:Translate Player.Settings.SubtitleBackground.Medium}" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="4,0,4,0"
                                                Background="{Binding SubtitleBackgroundOpacity, Converter={StaticResource EqualityToSelectionBrushConverter}, ConverterParameter=60}"/>
                                        <Button Command="{Binding SetSubtitleBackgroundCommand}" CommandParameter="85" Content="{loc:Translate Player.Settings.SubtitleBackground.Dark}" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="4,0,0,0"
                                                Background="{Binding SubtitleBackgroundOpacity, Converter={StaticResource EqualityToSelectionBrushConverter}, ConverterParameter=85}"/>
                                    </UniformGrid>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12" IsVisible="{Binding !IsLiveContent}">
                                    <TextBlock Text="{loc:Translate Player.Settings.SubtitlePosition}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" Margin="0,0,0,8"/>
                                    <Border Height="1" Width="50" HorizontalAlignment="Left" Background="{DynamicResource Surface1Brush}" Opacity="0.5"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,32" IsVisible="{Binding !IsLiveContent}">
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <Button Command="{Binding SetSubtitlePositionCommand}" CommandParameter="Bottom" Content="{loc:Translate Player.Settings.SubtitlePosition.Bottom}" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="0,0,4,0"
                                                Background="{Binding SubtitlePosition, Converter={StaticResource EqualityToSelectionBrushConverter}, ConverterParameter=Bottom}"/>
                                        <Button Command="{Binding SetSubtitlePositionCommand}" CommandParameter="Top" Content="{loc:Translate Player.Settings.SubtitlePosition.Top}" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="4,0,0,0"
                                                Background="{Binding SubtitlePosition, Converter={StaticResource EqualityToSelectionBrushConverter}, ConverterParameter=Top}"/>
                                    </UniformGrid>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{loc:Translate Player.Settings.Audio}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" Margin="0,0,0,8"/>
                                    <Border Height="1" Width="30" HorizontalAlignment="Left" Background="{DynamicResource Surface1Brush}" Opacity="0.5"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding AudioTracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding Id}" Click="AudioTrack_Click" Classes="listItemBtn" Margin="0,0,0,8" Content="{Binding Name}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Margin="0,32,0,12">
                                    <TextBlock Text="{loc:Translate Player.Settings.Subtitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" Margin="0,0,0,8"/>
                                    <Border Height="1" Width="40" HorizontalAlignment="Left" Background="{DynamicResource Surface1Brush}" Opacity="0.5"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding SubtitleTracks}" Margin="0,0,0,24">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding Id}" Click="SubtitleTrack_Click" Classes="listItemBtn" Margin="0,0,0,8" Content="{Binding Name}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Episodes Panel -->
            <Grid x:Name="EpisodesPanel" Classes="sidePanel" IsVisible="{Binding IsEpisodesPanelOpen}">
                <Border Classes="panelContent">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Margin="32,48,32,16" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Translate Player.Episodes.Title}" Classes="panelTitle"/>
                                <Border Classes="panelTitleUnderline"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ClosePanelsCommand}" Classes="panelCloseBtn" VerticalAlignment="Top" Margin="16,-8,0,0">
                                <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="24,0,16,40">
                            <ItemsControl ItemsSource="{Binding EpisodeSeasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Season">
                                        <Expander Margin="0,0,0,16" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header>
                                                <Grid ColumnDefinitions="Auto,Auto,*" Margin="8,0,0,8">
                                                    <TextBlock Text="{loc:Translate Player.Episodes.Season}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SeasonNumber}" Margin="4,0,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource Surface1Brush}" CornerRadius="4" Padding="12,4" Margin="12,0,16,0" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding Episodes.Count}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" LetterSpacing="0.5"/>
                                                            <TextBlock Text="{loc:Translate Player.Episodes.CountLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" LetterSpacing="1.5"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Expander.Header>
                                            
                                            <ItemsControl ItemsSource="{Binding Episodes}" Margin="0,4,0,4">
                                                <ItemsControl.ItemTemplate >
                                                    <DataTemplate x:DataType="models:Episode">
                                                        <Button Margin="8,6" Width="330" Classes="episodeCardBtn" Command="{Binding #OverlayRoot.DataContext.PlayEpisodeFromOverlayCommand}" CommandParameter="{Binding}" PointerPressed="EpisodeCardBtn_PointerPressed">
                                                            <Panel>
                                                                <Border Name="CardBackground" Background="{DynamicResource Surface1Brush}" CornerRadius="8" ClipToBounds="True" BorderThickness="1">
                                                                    <Border.BorderBrush>
                                                                        <MultiBinding Converter="{StaticResource EqualityToBrushMultiConverter}" ConverterParameter="AccentBrush">
                                                                            <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}"/>
                                                                            <Binding Path="#OverlayRoot.DataContext.CurrentEpisodeIdentity"/>
                                                                        </MultiBinding>
                                                                    </Border.BorderBrush>
                                                                </Border>

                                                                <!-- Subtile Active Background Tint -->
                                                                <Border CornerRadius="8" Background="{DynamicResource AccentBrush}" Opacity="0.08" IsHitTestVisible="False">
                                                                    <Border.IsVisible>
                                                                        <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                                                                            <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}"/>
                                                                            <Binding Path="#OverlayRoot.DataContext.CurrentEpisodeIdentity"/>
                                                                        </MultiBinding>
                                                                    </Border.IsVisible>
                                                                </Border>
                                                                
                                                                <Grid ColumnDefinitions="106,*" Margin="8">
                                                                    <!-- Thumbnail -->
                                                                    <Border Width="106" Height="60" ClipToBounds="True" CornerRadius="6" Background="{DynamicResource Bg1Brush}">
                                                                        <Panel>
                                                                            <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                                                                            
                                                                            <!-- Playing Indicator Overlay -->
                                                                            <Border Background="#99000000">
                                                                                <Border.IsVisible>
                                                                                    <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                                                                                        <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}"/>
                                                                                        <Binding Path="#OverlayRoot.DataContext.CurrentEpisodeIdentity"/>
                                                                                    </MultiBinding>
                                                                                </Border.IsVisible>
                                                                                <materialIcons:MaterialIcon Kind="PlayCircle" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
                                                                            </Border>
                                                                            
                                                                            <!-- Progress Bar -->
                                                                            <Border VerticalAlignment="Bottom" Height="5" Background="#66000000" CornerRadius="0,0,6,6" IsVisible="{Binding WatchedPercentage, Converter={StaticResource CountToVisibilityConverter}}">
                                                                                <Border HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="0,0,0,6" Width="{Binding WatchedPercentage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=106}"/>
                                                                            </Border>
                                                                        </Panel>
                                                                    </Border>

                                                                    <!-- Content -->
                                                                    <StackPanel Grid.Column="1" Margin="12,2,4,2" VerticalAlignment="Center" Spacing="2">
                                                                        <TextBlock Text="{Binding TmdbEpisodeName}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontStyle="Italic" Opacity="0.9" TextTrimming="CharacterEllipsis" IsVisible="{Binding TmdbEpisodeName, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                                                        <DockPanel LastChildFill="True">
                                                                            <Border DockPanel.Dock="Right" IsVisible="{Binding IsCompleted}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="{loc:Translate Player.Overlay.Watched}">
                                                                                <materialIcons:MaterialIcon Kind="CheckCircle" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                                                                            </Border>
                                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" LineHeight="17" VerticalAlignment="Center"/>
                                                                        </DockPanel>
                                                                        
                                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                                                            <StackPanel.IsVisible>
                                                                                <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                                                                                    <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}"/>
                                                                                    <Binding Path="#OverlayRoot.DataContext.CurrentEpisodeIdentity"/>
                                                                                </MultiBinding>
                                                                            </StackPanel.IsVisible>
                                                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{loc:Translate Player.Info.NowPlaying}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" LetterSpacing="0.5"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Panel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Quality Panel -->
            <Grid x:Name="QualitySettingsPanel" Classes="sidePanel" IsVisible="{Binding IsQualitySettingsOpen}">
                <Border Classes="panelContent">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Margin="32,48,32,24" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Translate Player.Quality.Title}" Classes="panelTitle"/>
                                <Border Classes="panelTitleUnderline"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ClosePanelsCommand}" Classes="panelCloseBtn" VerticalAlignment="Top" Margin="16,-8,0,0">
                                <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="32,0,32,40">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{loc:Translate Player.Quality.Video}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1.5" Margin="0,0,0,8"/>
                                    <Border Height="1" Width="40" HorizontalAlignment="Left" Background="{DynamicResource Surface1Brush}" Opacity="0.5"/>
                                </StackPanel>
                                
                                <Border Background="{DynamicResource Surface1Brush}" CornerRadius="8" Padding="20" Margin="0,0,0,24" IsVisible="{Binding StreamQuality, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding StreamInfo}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                </Border>

                                <Border Background="{DynamicResource Surface1Brush}" CornerRadius="8" Padding="20" Margin="0,0,0,24" IsVisible="{Binding StreamQuality, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Text="{loc:Translate Player.Quality.Resolution}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,40,12"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding QualityResolutionText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <TextBlock Grid.Row="1" Text="{loc:Translate Player.Quality.Fps}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,40,12"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding QualityFpsText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <TextBlock Grid.Row="2" Text="{loc:Translate Player.Quality.Codec}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,40,12"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QualityVideoCodecText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <TextBlock Grid.Row="3" Text="{loc:Translate Player.Quality.Bitrate}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,40,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding QualityVideoBitrateText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold"/>
                                    </Grid>
                                </Border>
                                
                                <StackPanel Margin="0,0,0,12" IsVisible="{Binding StreamQuality, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="{loc:Translate Player.Quality.Audio}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1.5" Margin="0,0,0,8"/>
                                    <Border Height="1" Width="30" HorizontalAlignment="Left" Background="{DynamicResource Surface1Brush}" Opacity="0.5"/>
                                </StackPanel>
                                
                                <Border Background="{DynamicResource Surface1Brush}" CornerRadius="8" Padding="20" IsVisible="{Binding StreamQuality, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="{Binding QualityAudioText}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                
                                <StackPanel IsVisible="{Binding !IsLiveContent}">
                                    <StackPanel Margin="0,32,0,12">
                                        <TextBlock Text="{loc:Translate Player.Quality.Speed}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1.5" Margin="0,0,0,8"/>
                                        <Border Height="1" Width="80" HorizontalAlignment="Left" Background="{DynamicResource Surface1Brush}" Opacity="0.5"/>
                                    </StackPanel>
                                    
                                    <UniformGrid Columns="3">
                                        <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.5}" Content="0.5x" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="0,0,8,8"/>
                                        <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.75}" Content="0.75x" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="4,0,4,8"/>
                                        <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.0}" Content="{loc:Translate Player.Quality.Speed.Normal}" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="8,0,0,8"/>
                                        <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.25}" Content="1.25x" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.5}" Content="1.5x" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="4,0,4,0"/>
                                        <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=2.0}" Content="2.0x" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="8,0,0,0"/>
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- Overlays -->
        <Border Background="Black" IsHitTestVisible="True" ZIndex="900" CornerRadius="12" IsVisible="{Binding IsBufferShieldVisible}"/>
        <Button Command="{Binding ClosePlayerCommand}" Classes="iconBtn" ZIndex="1001" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32" IsVisible="{Binding IsBuffering}">
            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="24" Height="24" Foreground="White"/>
        </Button>
        
        <Border x:Name="VolumeToast" Background="#CC000000" CornerRadius="12" Padding="20,12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" IsHitTestVisible="False" ZIndex="1100" IsVisible="{Binding $parent[UserControl].IsVolumeToastVisible}" Opacity="{Binding $parent[UserControl].IsVolumeToastVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=OpacityOnly}">
            <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2"/></Transitions></Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <materialIcons:MaterialIcon Kind="VolumeOff" Width="22" Height="22" Foreground="White" IsVisible="{Binding IsMuted}"/>
                <materialIcons:MaterialIcon Kind="VolumeHigh" Width="22" Height="22" Foreground="White" IsVisible="{Binding IsMuted, Converter={StaticResource InverseBoolConverter}}"/>
                <TextBlock Text="{loc:Translate Player.Muted}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" IsVisible="{Binding IsMuted}"/>
                <TextBlock Text="{Binding Volume, StringFormat='{}{0}%'}" FontSize="16" FontWeight="Black" Foreground="White" VerticalAlignment="Center" IsVisible="{Binding IsMuted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
            </StackPanel>
        </Border>

        <Border x:Name="SeekToast" Background="#CC000000" CornerRadius="12" Padding="20,12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,160" IsHitTestVisible="False" ZIndex="1100" IsVisible="{Binding $parent[UserControl].IsSeekToastVisible}" Opacity="{Binding $parent[UserControl].IsSeekToastVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=OpacityOnly}">
            <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2"/></Transitions></Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <materialIcons:MaterialIcon Kind="ClockFast" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding $parent[UserControl].SeekToastText}" FontSize="18" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border x:Name="DownloadToast" Background="#CC000000" CornerRadius="12" Padding="20,12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,220" IsHitTestVisible="False" ZIndex="1100" IsVisible="{Binding $parent[UserControl].IsDownloadToastVisible}" Opacity="{Binding $parent[UserControl].IsDownloadToastVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=OpacityOnly}">
            <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2"/></Transitions></Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <materialIcons:MaterialIcon Kind="Download" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding DownloadStatusMessage}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Buffering Overlay -->
        <Border Background="#4D000000" IsVisible="{Binding IsBuffering}" IsHitTestVisible="False" ZIndex="950" CornerRadius="12">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="60" Height="60">
                    <Arc Stroke="{DynamicResource AccentBrush}" StrokeThickness="4" StartAngle="0" SweepAngle="90" Width="50" Height="50">
                        <Arc.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Arc.RenderTransform>
                        <Arc.Styles>
                            <Style Selector="Arc">
                                <Style.Animations>
                                    <Animation Duration="0:0:1" IterationCount="INFINITE">
                                        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Arc.Styles>
                    </Arc>
                    <Arc Stroke="{DynamicResource AccentBrush}" StrokeThickness="4" StartAngle="180" SweepAngle="90" Width="50" Height="50" Opacity="0.5">
                        <Arc.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Arc.RenderTransform>
                        <Arc.Styles>
                            <Style Selector="Arc">
                                <Style.Animations>
                                    <Animation Duration="0:0:1" IterationCount="INFINITE">
                                        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Arc.Styles>
                    </Arc>
                </Grid>
                <TextBlock Text="{Binding PlayerLoadingWarningMessage}" Foreground="{DynamicResource WarningBrush}" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="350" TextAlignment="Center" Margin="0,12,0,0" IsVisible="{Binding PlayerLoadingWarningMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
            </Grid>
        </ThemeVariantScope>
    </Grid>
</UserControl>
