<UserControl x:Class="Noctra.Avalonia.Views.VideoOverlayView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             x:Name="OverlayRoot"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False"
             Focusable="True"
             d:DesignHeight="800" d:DesignWidth="1200"
             KeyDown="OverlayRoot_KeyDown"
             PointerMoved="OverlayRoot_PointerMoved"
             PointerPressed="OverlayRoot_PointerPressed"
             PointerWheelChanged="OverlayRoot_PointerWheelChanged">

    <UserControl.Styles>
        <Style Selector="Button.iconBtn">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.iconBtn:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.iconBtn:pressed">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>
        
        <Style Selector="Button.outlineBtn">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <Style Selector="Button.panelCloseBtn">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
        </Style>
        <Style Selector="Button.panelCloseBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>

        <Style Selector="Button.listItemBtn">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.listItemBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>

        <Style Selector="Button.episodeCardBtn">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.episodeCardBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
            <Setter Property="ZIndex" Value="1"/>
        </Style>
        <Style Selector="Button.episodeCardBtn:pointerover Border#CardBackground">
            <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}"/>
        </Style>

        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader, Expander:down /template/ ToggleButton#ExpanderHeader, Expander:up /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pressed">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
            <Setter Property="Margin" Value="16,0,8,0"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ ContentPresenter#PART_ContentPresenter, Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Expander /template/ Border#ExpanderContent, Expander:down /template/ Border#ExpanderContent, Expander:up /template/ Border#ExpanderContent, Expander:left /template/ Border#ExpanderContent, Expander:right /template/ Border#ExpanderContent">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Expander /template/ Border#PART_ContentBorder">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent">

        <!-- OVERLAY CONTENT -->
        <Grid x:Name="OverlayContent"
              IsHitTestVisible="{Binding IsVisible}"
              Opacity="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=OpacityOnly}">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="QuadraticEaseOut"/>
                </Transitions>
            </Grid.Transitions>

            <!-- 1. Top Gradient -->
            <Grid IsHitTestVisible="False" VerticalAlignment="Top">
                <Border Height="140">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#CC000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- 2. Top Bar -->
            <Grid VerticalAlignment="Top" Margin="32,32,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                    <Button Command="{Binding ClosePlayerCommand}" Classes="iconBtn">
                        <materialIcons:MaterialIcon Kind="ArrowLeft" Width="24" Height="24" Foreground="White"/>
                    </Button>
                    <TextBlock Text="{Binding CurrentChannel.Name}" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" LetterSpacing="0.2"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Opacity="0.8">
                        <materialIcons:MaterialIcon Kind="{Binding NetworkIcon}" Width="16" Height="16" Foreground="White"/>
                        <TextBlock Text="{Binding NetworkStatus}" FontSize="13" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentTimeStr}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 3. Bottom Control Bar -->
            <Border VerticalAlignment="Bottom" Padding="32,80,32,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#B3000000" Offset="0.4"/>
                        <GradientStop Color="#E6000000" Offset="0.7"/>
                        <GradientStop Color="#FF000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,Auto">
                    <!-- Timeline Slider -->
                    <Slider x:Name="TimelineSlider" Grid.Row="0" Margin="0,0,0,12"
                            Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position}"
                            IsVisible="{Binding !IsLiveContent}" Foreground="{DynamicResource AccentBrush}" Focusable="False"/>

                    <!-- Live Stream EPG Info -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,16"
                                IsVisible="{Binding IsLiveContent}">
                        <Border Background="#E50914" CornerRadius="4" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" Fill="White" VerticalAlignment="Center">
                                    <Ellipse.Styles>
                                        <Style Selector="Ellipse">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1" IterationCount="INFINITE" PlaybackDirection="Alternate">
                                                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Ellipse.Styles>
                                </Ellipse>
                                <TextBlock Text="CANLI" FontSize="11" FontWeight="Black" Foreground="White" VerticalAlignment="Center" LetterSpacing="0.5"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding CurrentProgram.Title}" Foreground="#E6FFFFFF" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                   IsVisible="{Binding CurrentProgram.Title, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding CurrentProgram.TimeRange, StringFormat='{} &#8226; {0}'}" Foreground="#B3FFFFFF" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                   IsVisible="{Binding HasCurrentProgramInfo}"/>
                    </StackPanel>

                    <!-- Transport Controls -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                            <Button Command="{Binding SkipBackwardCommand}" CommandParameter="10" Classes="iconBtn" IsVisible="{Binding !IsLiveContent}" ToolTip.Tip="10 Saniye Geri Sar">
                                <materialIcons:MaterialIcon Kind="Rewind10" Width="24" Height="24" Foreground="#E6FFFFFF"/>
                            </Button>
                            <Button Click="PlayPreviousLiveChannel_Click" Classes="iconBtn" IsVisible="{Binding IsLiveContent}" ToolTip.Tip="Önceki Kanal">
                                <materialIcons:MaterialIcon Kind="SkipPrevious" Width="20" Height="20" Foreground="#E6FFFFFF"/>
                            </Button>
                            <Button Command="{Binding PlayPauseCommand}" Classes="iconBtn">
                                <Grid>
                                    <materialIcons:MaterialIcon Kind="Pause" Width="24" Height="24" Foreground="White" IsVisible="{Binding IsPlaying}"/>
                                    <materialIcons:MaterialIcon Kind="Play" Width="24" Height="24" Foreground="White" IsVisible="{Binding IsPlaying, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>
                            </Button>
                            <Button Command="{Binding SkipForwardCommand}" CommandParameter="10" Classes="iconBtn" IsVisible="{Binding !IsLiveContent}" ToolTip.Tip="10 Saniye İleri Sar">
                                <materialIcons:MaterialIcon Kind="FastForward10" Width="24" Height="24" Foreground="#E6FFFFFF"/>
                            </Button>
                            <Button Click="PlayNextLiveChannel_Click" Classes="iconBtn" IsVisible="{Binding IsLiveContent}" ToolTip.Tip="Sonraki Kanal">
                                <materialIcons:MaterialIcon Kind="SkipNext" Width="20" Height="20" Foreground="#E6FFFFFF"/>
                            </Button>
                            <Button Command="{Binding ToggleMuteCommand}" Classes="iconBtn" Margin="4,0,0,0" ToolTip.Tip="Sesi Aç/Kapa">
                                <Grid>
                                    <materialIcons:MaterialIcon Kind="VolumeOff" Width="20" Height="20" Foreground="#E6FFFFFF" IsVisible="{Binding IsMuted}"/>
                                    <materialIcons:MaterialIcon Kind="VolumeHigh" Width="20" Height="20" Foreground="#E6FFFFFF" IsVisible="{Binding IsMuted, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>
                            </Button>
                            <Slider x:Name="VolumeSlider" Width="80" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Minimum="0" Maximum="100" Value="{Binding Volume}" Foreground="{DynamicResource AccentBrush}" Focusable="False"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding !IsLiveContent}">
                                <TextBlock Text="{Binding PositionText}" Foreground="#E6FFFFFF" FontSize="13" FontWeight="Medium"/>
                                <TextBlock Text=" / " Foreground="#80FFFFFF" FontSize="13" FontWeight="Medium" Margin="4,0"/>
                                <TextBlock Text="{Binding DurationText}" Foreground="#B3FFFFFF" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                            <Button Command="{Binding OpenEpisodesCommand}" Classes="iconBtn" IsVisible="{Binding IsSeriesContent}" ToolTip.Tip="Bölümler"><materialIcons:MaterialIcon Kind="FormatListBulletedSquare" Width="20" Height="20" Foreground="#E6FFFFFF"/></Button>
                            <Button Command="{Binding PlayNextEpisodeCommand}" Classes="iconBtn" IsVisible="{Binding IsSeriesContent}" ToolTip.Tip="Sonraki Bölüm"><materialIcons:MaterialIcon Kind="StepForward" Width="20" Height="20" Foreground="#E6FFFFFF"/></Button>
                            <Button Command="{Binding DownloadCurrentContentCommand}" Classes="iconBtn" IsVisible="{Binding CanShowDownloadButton}" IsEnabled="{Binding CanDownloadCurrentContent}" ToolTip.Tip="İndir"><materialIcons:MaterialIcon Kind="Download" Width="20" Height="20" Foreground="#E6FFFFFF"/></Button>
                            <Button Command="{Binding OpenInfoPanelCommand}" Classes="iconBtn" IsVisible="{Binding CanShowInfoButton}" ToolTip.Tip="Bilgi"><materialIcons:MaterialIcon Kind="InformationBoxOutline" Width="20" Height="20" Foreground="#E6FFFFFF"/></Button>
                            <Button Command="{Binding OpenAudioSettingsCommand}" Classes="iconBtn" ToolTip.Tip="Altyazı"><TextBlock Text="CC" FontWeight="Bold" FontSize="14" Foreground="#E6FFFFFF" VerticalAlignment="Center"/></Button>
                            <Button Command="{Binding OpenQualitySettingsCommand}" Classes="iconBtn" ToolTip.Tip="Ayarlar"><materialIcons:MaterialIcon Kind="Cog" Width="20" Height="20" Foreground="#E6FFFFFF"/></Button>
                            <Button Command="{Binding EnterPiPCommand}" Classes="iconBtn" ToolTip.Tip="Resim İçinde Resim"><materialIcons:MaterialIcon Kind="PictureInPictureBottomRight" Width="20" Height="20" Foreground="#E6FFFFFF"/></Button>
                            <Button Command="{Binding ToggleFullScreenCommand}" Classes="iconBtn" ToolTip.Tip="Tam Ekran">
                                <Grid>
                                    <materialIcons:MaterialIcon Kind="Fullscreen" Width="22" Height="22" Foreground="#E6FFFFFF" IsVisible="{Binding IsFullScreen, Converter={StaticResource InverseBoolConverter}}"/>
                                    <materialIcons:MaterialIcon Kind="FullscreenExit" Width="22" Height="22" Foreground="#E6FFFFFF" IsVisible="{Binding IsFullScreen}"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Info Panel -->
            <Grid x:Name="InfoPanel" Width="420" HorizontalAlignment="Right" IsVisible="{Binding IsInfoPanelOpen}">
                <Grid.Transitions><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/></Transitions></Grid.Transitions>
                <Border Background="{DynamicResource SurfaceBrush}" BorderThickness="0" ClipToBounds="True">
                    <Border.BoxShadow><BoxShadows>0 0 40 0 #A6000000</BoxShadows></Border.BoxShadow>
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Margin="32,40,32,24" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HAKKINDA" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1.5" Margin="0,0,0,16"/>
                                <Border Height="1" Background="{DynamicResource Surface1Brush}" Margin="0,0,0,8" Opacity="0.5"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding OpenInfoPanelCommand}" Classes="panelCloseBtn" VerticalAlignment="Top" Margin="16,-8,0,0"><materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Kapat"/></Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Grid Margin="32,0,32,40">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding CurrentChannel.Name}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding CurrentEpisode.TmdbEpisodeName}" FontSize="15" Foreground="{DynamicResource AccentBrush}" FontStyle="Italic" Opacity="0.9" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding CurrentEpisode.TmdbEpisodeName, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,24">
                                        <TextBlock Text="{Binding CurrentEpisode.AirDateText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" IsVisible="{Binding CurrentEpisode.AirDateText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                        <TextBlock Text="&#8226;" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" IsVisible="{Binding CurrentEpisode.AirDateText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" IsVisible="{Binding DurationText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                    </StackPanel>
                                    
                                    <!-- Live Only -->
                                    <Border Background="{DynamicResource Surface1Brush}" CornerRadius="12" Padding="20" Margin="0,0,0,24">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="IsLiveContent"/>
                                                <Binding Path="CurrentProgram.Title" Converter="{StaticResource StringNotEmptyToBoolConverter}"/>
                                            </MultiBinding>
                                        </Border.IsVisible>
                                        <StackPanel>
                                            <TextBlock Text="ŞU AN YAYINDA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" LetterSpacing="1" Margin="0,0,0,12"/>
                                            <TextBlock Text="{Binding CurrentProgram.Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding CurrentProgram.TimeRange}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,0,12" IsVisible="{Binding HasCurrentProgramInfo}"/>
                                            <TextBlock Text="{Binding CurrentProgram.Description}" Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.8" FontSize="14" TextWrapping="Wrap" LineHeight="22" IsVisible="{Binding CurrentProgram.Description, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Episode Plot (Series) -->
                                    <Border Background="{DynamicResource Surface1Brush}" CornerRadius="12" Padding="20" Margin="0,0,0,24">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="IsSeriesContent"/>
                                                <Binding Path="CurrentEpisode.Plot" Converter="{StaticResource StringNotEmptyToBoolConverter}"/>
                                            </MultiBinding>
                                        </Border.IsVisible>
                                        <TextBlock Text="{Binding CurrentEpisode.Plot}" Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.8" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                                    </Border>

                                    <!-- VOD Plot (Movies/Single) -->
                                    <Border Background="{DynamicResource Surface1Brush}" CornerRadius="12" Padding="20" Margin="0,0,0,24">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="!IsSeriesContent"/>
                                                <Binding Path="CurrentChannel.Plot" Converter="{StaticResource StringNotEmptyToBoolConverter}"/>
                                            </MultiBinding>
                                        </Border.IsVisible>
                                        <TextBlock Text="{Binding CurrentChannel.Plot}" Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.8" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                                    </Border>

                                    <StackPanel Margin="0,0,0,24" IsVisible="{Binding CurrentChannel.Director, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                        <TextBlock Text="YÖNETMEN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding CurrentChannel.Director}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,24" IsVisible="{Binding CurrentChannel.Cast, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                        <TextBlock Text="OYUNCULAR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding CurrentChannel.Cast}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Audio Settings -->
            <Grid x:Name="AudioSettingsPanel" Width="400" HorizontalAlignment="Right" IsVisible="{Binding IsAudioSettingsOpen}">
                <Grid.Transitions><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/></Transitions></Grid.Transitions>
                <Border Background="{DynamicResource SurfaceBrush}" BorderThickness="0"><Border.BoxShadow><BoxShadows>0 0 40 0 #A6000000</BoxShadows></Border.BoxShadow>
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Margin="32,40,32,24" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="SES VE ALTYAZI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1.5" Margin="0,0,0,16"/><Border Height="1" Background="{DynamicResource Surface1Brush}" Margin="0,0,0,8" Opacity="0.5"/></StackPanel>
                            <Button Grid.Column="1" Command="{Binding ClosePanelsCommand}" Classes="panelCloseBtn" VerticalAlignment="Top" Margin="16,-8,0,0"><materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Kapat"/></Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible"><StackPanel Margin="32,0,32,40"><TextBlock Text="SES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding AudioTracks}"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Id}" Click="AudioTrack_Click" Classes="listItemBtn" Margin="0,0,0,8" Content="{Binding Name}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="ALTYAZI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" Margin="0,32,0,12"/><ItemsControl ItemsSource="{Binding SubtitleTracks}" Margin="0,0,0,24"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Id}" Click="SubtitleTrack_Click" Classes="listItemBtn" Margin="0,0,0,8" Content="{Binding Name}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Episodes Panel -->
            <Grid x:Name="EpisodesPanel" Width="400" HorizontalAlignment="Right" IsVisible="{Binding IsEpisodesPanelOpen}" ZIndex="1000">
                <Grid.Transitions><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/></Transitions></Grid.Transitions>
                
                <Border Background="{DynamicResource SurfaceBrush}" BorderThickness="0" ClipToBounds="True">
                    <Border.BoxShadow><BoxShadows>0 0 40 0 #A6000000</BoxShadows></Border.BoxShadow>
                    
                    <Grid RowDefinitions="Auto,*">
                        <!-- Standardized Header -->
                        <Grid Grid.Row="0" Margin="32,40,32,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="BÖLÜMLER" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1.5" Margin="0,0,0,16" VerticalAlignment="Center"/>
                            <Button Grid.Row="0" Grid.Column="1" Command="{Binding ClosePanelsCommand}" Classes="panelCloseBtn" VerticalAlignment="Center" Margin="16,0,0,16" ToolTip.Tip="Kapat">
                                <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                            
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="1" Background="{DynamicResource Surface1Brush}" Opacity="0.5" Margin="0,0,0,24"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="16,0,12,40">
                            <ItemsControl ItemsSource="{Binding EpisodeSeasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Season">
                                        <Expander Margin="0,0,0,16" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header>
                                                <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,8">
                                                    <TextBlock Text="{Binding SeasonNumber, StringFormat='Sezon {0}'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{DynamicResource Surface1Brush}" CornerRadius="12" Padding="12,4" Margin="0,0,16,0">
                                                        <TextBlock Text="{Binding Episodes.Count, StringFormat='{}{0} BÖLÜM'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" LetterSpacing="0.5"/>
                                                    </Border>
                                                </Grid>
                                            </Expander.Header>
                                            
                                            <ItemsControl ItemsSource="{Binding Episodes}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:Episode">
                                                        <Button Margin="8,0,24,12" Classes="episodeCardBtn" Command="{Binding #OverlayRoot.DataContext.PlayEpisodeFromOverlayCommand}" CommandParameter="{Binding}" PointerPressed="EpisodeCardBtn_PointerPressed">
                                                            <Panel>
                                                                <Border Name="CardBackground" Background="{DynamicResource Surface1Brush}" CornerRadius="10" ClipToBounds="True" BorderThickness="1.5">
                                                                    <Border.BorderBrush>
                                                                        <MultiBinding Converter="{StaticResource EqualityToBrushMultiConverter}" ConverterParameter="AccentBrush">
                                                                            <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}"/>
                                                                            <Binding Path="#OverlayRoot.DataContext.CurrentEpisodeIdentity"/>
                                                                        </MultiBinding>
                                                                    </Border.BorderBrush>
                                                                </Border>

                                                                <!-- Subtle Active Background Tint -->
                                                                <Border CornerRadius="10" Background="{DynamicResource AccentBrush}" Opacity="0.08" IsHitTestVisible="False">
                                                                    <Border.IsVisible>
                                                                        <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                                                                            <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}"/>
                                                                            <Binding Path="#OverlayRoot.DataContext.CurrentEpisodeIdentity"/>
                                                                        </MultiBinding>
                                                                    </Border.IsVisible>
                                                                </Border>
                                                                
                                                                <Grid ColumnDefinitions="106,*" Margin="8">
                                                                    <!-- Thumbnail -->
                                                                    <Border Width="106" Height="60" ClipToBounds="True" CornerRadius="6" Background="{DynamicResource Bg1Brush}">
                                                                        <Panel>
                                                                            <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                                                                            
                                                                            <!-- Playing Indicator Overlay -->
                                                                            <Border Background="#99000000">
                                                                                <Border.IsVisible>
                                                                                    <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                                                                                        <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}"/>
                                                                                        <Binding Path="#OverlayRoot.DataContext.CurrentEpisodeIdentity"/>
                                                                                    </MultiBinding>
                                                                                </Border.IsVisible>
                                                                                <materialIcons:MaterialIcon Kind="PlayCircle" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
                                                                            </Border>
                                                                            
                                                                            <!-- Progress Bar -->
                                                                            <Border VerticalAlignment="Bottom" Height="5" Background="#66000000" CornerRadius="0,0,6,6" IsVisible="{Binding WatchedPercentage, Converter={StaticResource CountToVisibilityConverter}}">
                                                                                <Border HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="0,0,0,6" Width="{Binding WatchedPercentage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=106}"/>
                                                                            </Border>
                                                                        </Panel>
                                                                    </Border>

                                                                    <!-- Content -->
                                                                    <StackPanel Grid.Column="1" Margin="12,2,4,2" VerticalAlignment="Center" Spacing="2">
                                                                        <TextBlock Text="{Binding TmdbEpisodeName}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontStyle="Italic" Opacity="0.9" TextTrimming="CharacterEllipsis" IsVisible="{Binding TmdbEpisodeName, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                                                        <DockPanel LastChildFill="True">
                                                                            <Border DockPanel.Dock="Right" IsVisible="{Binding IsCompleted}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="İzlendi">
                                                                                <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                                                                            </Border>
                                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" LineHeight="17" VerticalAlignment="Center"/>
                                                                        </DockPanel>
                                                                        
                                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                                                            <StackPanel.IsVisible>
                                                                                <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                                                                                    <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}"/>
                                                                                    <Binding Path="#OverlayRoot.DataContext.CurrentEpisodeIdentity"/>
                                                                                </MultiBinding>
                                                                            </StackPanel.IsVisible>
                                                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="ŞU AN OYNATILIYOR" FontSize="10" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" LetterSpacing="0.5"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Panel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Quality Panel -->
            <Grid x:Name="QualitySettingsPanel" Width="400" HorizontalAlignment="Right" IsVisible="{Binding IsQualitySettingsOpen}">
                <Grid.Transitions><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/></Transitions></Grid.Transitions>
                <Border Background="{DynamicResource SurfaceBrush}" BorderThickness="0"><Border.BoxShadow><BoxShadows>0 0 40 0 #A6000000</BoxShadows></Border.BoxShadow>
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Margin="32,40,32,24" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="YAYIN BİLGİSİ" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1.5" Margin="0,0,0,16"/><Border Height="1" Background="{DynamicResource Surface1Brush}" Margin="0,0,0,8" Opacity="0.5"/></StackPanel>
                            <Button Grid.Column="1" Command="{Binding ClosePanelsCommand}" Classes="panelCloseBtn" VerticalAlignment="Top" Margin="16,-8,0,0"><materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Kapat"/></Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="32,0,32,40"><StackPanel><TextBlock Text="VİDEO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1.5" Margin="0,0,0,12"/><Border Background="{DynamicResource Surface1Brush}" CornerRadius="12" Padding="20" Margin="0,0,0,24"><Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"><TextBlock Grid.Row="0" Text="Çözünürlük" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,40,12"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StreamQuality.ResolutionLabel, FallbackValue='-'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock Grid.Row="1" Text="Kare hızı" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,40,12"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StreamQuality.Fps, StringFormat='{}{0} FPS', FallbackValue='-'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock Grid.Row="2" Text="Codec" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,40,12"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StreamQuality.VideoCodec, FallbackValue='-'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock Grid.Row="3" Text="Bit hızı" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,40,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StreamQuality.VideoBitrate, Converter={StaticResource BitrateDisplayConverter}, FallbackValue='Bilinmiyor'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold"/></Grid></Border><TextBlock Text="SES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1.5" Margin="0,0,0,12"/><Border Background="{DynamicResource Surface1Brush}" CornerRadius="12" Padding="20"><TextBlock Text="{Binding StreamQuality.AudioDetailLabel, FallbackValue='Bilinmiyor'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/></Border><StackPanel IsVisible="{Binding !IsLiveContent}"><TextBlock Text="OYNATMA HIZI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1.5" Margin="0,32,0,12"/><UniformGrid Columns="3"><Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.5}" Content="0.5x" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="0,0,8,8"/><Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.75}" Content="0.75x" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="4,0,4,8"/><Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.0}" Content="Normal" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="8,0,0,8"/><Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.25}" Content="1.25x" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="0,0,8,0"/><Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.5}" Content="1.5x" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="4,0,4,0"/><Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=2.0}" Content="2.0x" Classes="listItemBtn" HorizontalContentAlignment="Center" Margin="8,0,0,0"/></UniformGrid></StackPanel></StackPanel></ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- Overlays -->
        <Border Background="Black" IsHitTestVisible="True" ZIndex="900" IsVisible="{Binding IsBufferShieldVisible}"/>
        <Button Command="{Binding ClosePlayerCommand}" Classes="iconBtn" Background="#33000000" CornerRadius="8" ZIndex="1001" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,24,0,0" IsVisible="{Binding IsBuffering}"><materialIcons:MaterialIcon Kind="ArrowLeft" Width="28" Height="28" Foreground="White"/></Button>
        
        <Border x:Name="VolumeToast" Background="#99000000" CornerRadius="8" Padding="16,8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" IsHitTestVisible="False" ZIndex="1000" IsVisible="{Binding $parent[UserControl].IsVolumeToastVisible}" Opacity="{Binding $parent[UserControl].IsVolumeToastVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=OpacityOnly}">
            <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2"/></Transitions></Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="8"><materialIcons:MaterialIcon Kind="VolumeOff" Width="18" Height="18" Foreground="White" IsVisible="{Binding IsMuted}"/><materialIcons:MaterialIcon Kind="VolumeHigh" Width="18" Height="18" Foreground="White" IsVisible="{Binding IsMuted, Converter={StaticResource InverseBoolConverter}}"/><TextBlock Text="SESSIZ" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" IsVisible="{Binding IsMuted}"/><TextBlock Text="{Binding Volume, StringFormat='{}{0}%'}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" IsVisible="{Binding IsMuted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/></StackPanel>
        </Border>

        <Border x:Name="SeekToast" Background="#99000000" CornerRadius="8" Padding="16,8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" IsHitTestVisible="False" ZIndex="1000" IsVisible="{Binding $parent[UserControl].IsSeekToastVisible}" Opacity="{Binding $parent[UserControl].IsSeekToastVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=OpacityOnly}">
            <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2"/></Transitions></Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="6"><materialIcons:MaterialIcon Kind="ClockFast" Width="18" Height="18" Foreground="White" Opacity="0.8"/><TextBlock Text="{Binding $parent[UserControl].SeekToastText}" FontSize="14" FontWeight="Bold" Foreground="White"/></StackPanel>
        </Border>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" ZIndex="950" IsVisible="{Binding IsBuffering}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Opacity="0.35"><Ellipse.Styles><Style Selector="Ellipse"><Style.Animations><Animation Duration="0:0:1.0" IterationCount="INFINITE"><KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame><KeyFrame Cue="33%"><Setter Property="Opacity" Value="0.35"/></KeyFrame><KeyFrame Cue="66%"><Setter Property="Opacity" Value="0.35"/></KeyFrame><KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame></Animation></Style.Animations></Style></Ellipse.Styles></Ellipse><Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Opacity="0.35"><Ellipse.Styles><Style Selector="Ellipse"><Style.Animations><Animation Duration="0:0:1.0" IterationCount="INFINITE"><KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35"/></KeyFrame><KeyFrame Cue="33%"><Setter Property="Opacity" Value="1"/></KeyFrame><KeyFrame Cue="66%"><Setter Property="Opacity" Value="0.35"/></KeyFrame><KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35"/></KeyFrame></Animation></Style.Animations></Style></Ellipse.Styles></Ellipse><Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Opacity="0.35"><Ellipse.Styles><Style Selector="Ellipse"><Style.Animations><Animation Duration="0:0:1.0" IterationCount="INFINITE"><KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35"/></KeyFrame><KeyFrame Cue="33%"><Setter Property="Opacity" Value="0.35"/></KeyFrame><KeyFrame Cue="66%"><Setter Property="Opacity" Value="1"/></KeyFrame><KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35"/></KeyFrame></Animation></Style.Animations></Style></Ellipse.Styles></Ellipse></StackPanel>
            <TextBlock Text="Y&#252;kleniyor..." Foreground="White" FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock Text="{Binding PlayerLoadingWarningMessage}" Foreground="#FFA500" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="350" TextAlignment="Center" Margin="0,8,0,0" IsVisible="{Binding PlayerLoadingWarningMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>