<UserControl x:Class="Noctra.Avalonia.Views.VideoOverlayView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             x:Name="OverlayRoot"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False"
             Focusable="True"
             d:DesignHeight="800" d:DesignWidth="1200"
             KeyDown="OverlayRoot_KeyDown"
             PointerMoved="OverlayRoot_PointerMoved"
             PointerPressed="OverlayRoot_PointerPressed">

    <UserControl.Styles>
        <!-- Base styles for all buttons in overlay -->
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#16000000"/>
            <Setter Property="BorderBrush" Value="#36FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#2A000000"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="BorderBrush" Value="#88FFFFFF"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent">

        <!-- ==========================================
             OVERLAY CONTENT (Visible when interacting)
             ========================================== -->
        <Grid x:Name="OverlayContent"
              IsHitTestVisible="{Binding IsVisible}"
              Opacity="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=OpacityOnly}">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Grid.Transitions>

            <!-- 1. Gradient Scrims (Readability Layer) -->
            <Grid IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="160"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="240"/>
                </Grid.RowDefinitions>

                <!-- Top Gradient -->
                <Border Grid.Row="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#CC000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Bottom Gradient -->
                <Border Grid.Row="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#00000000" Offset="0.0"/>
                            <GradientStop Color="#88000000" Offset="0.4"/>
                            <GradientStop Color="#EE000000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- 2. Top Bar (Back, Title, Time) -->
            <Grid VerticalAlignment="Top" Margin="32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Action -->
                <Button Command="{Binding ClosePlayerCommand}" Classes="circle" Margin="0,0,24,0">
                    <materialIcons:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" Foreground="White"/>
                </Button>

                <!-- Content Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentChannel.Name}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <WrapPanel Margin="0,8,0,0"
                               IsVisible="{Binding HasTopQualityBadgesReady}">
                        <Border Background="#5B0B9E" CornerRadius="5" Padding="8,3" Margin="0,0,8,0" Opacity="0.75">
                            <TextBlock Text="{Binding StreamQuality.ResolutionOnlyLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <Border Background="#5B0B9E" CornerRadius="5" Padding="8,3" Margin="0,0,8,0" Opacity="0.75">
                            <TextBlock Text="{Binding StreamQuality.Fps, StringFormat='{}{0} FPS'}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <Border Background="#5B0B9E" CornerRadius="5" Padding="8,3" Opacity="0.75">
                            <TextBlock Text="{Binding StreamQuality.VideoCodecDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- System Info (Clock/Network) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center" Opacity="0.8">
                        <materialIcons:MaterialIcon Kind="{Binding NetworkIcon}" Width="18" Height="18" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding NetworkStatus}" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentTimeStr}" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 3. Bottom Control Bar -->
            <Grid VerticalAlignment="Bottom" Margin="48,0,48,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Timeline -->
                    <RowDefinition Height="Auto"/> <!-- Controls -->
                </Grid.RowDefinitions>

                <!-- Timeline Slider -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding PositionText}" Foreground="#CCCCCC" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center"
                               IsVisible="{Binding !IsLiveContent}"/>

                    <Slider x:Name="TimelineSlider"
                            Grid.Column="1"
                            Minimum="0" Maximum="{Binding Duration}"
                            Value="{Binding Position}"
                            IsVisible="{Binding !IsLiveContent}"/>

                    <!-- LIVE Badge for Live Streams -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center"
                                IsVisible="{Binding IsLiveContent}">

                        <StackPanel Orientation="Horizontal">
                            <Border Background="#8d09e5" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,6,0">
                                        <Ellipse.Styles>
                                            <Style Selector="Ellipse">
                                                <Style.Animations>
                                                    <Animation Duration="0:0:1" IterationCount="INFINITE" PlaybackDirection="Alternate">
                                                        <KeyFrame Cue="0%">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </KeyFrame>
                                                        <KeyFrame Cue="100%">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </Ellipse.Styles>
                                    </Ellipse>
                                    <TextBlock Text="CANLI" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ChannelName}" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- EPG Info -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding CurrentProgram.Title}" Foreground="#E0E0E0" FontSize="14" FontWeight="Normal"
                                       IsVisible="{Binding CurrentProgram.Title, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding CurrentProgram.TimeRange, StringFormat='{} &#8226; {0}'}" Foreground="#AAAAAA" FontSize="13" Margin="8,1,0,0" VerticalAlignment="Bottom"
                                       IsVisible="{Binding HasCurrentProgramInfo}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding RemainingTime}" Foreground="#CCCCCC" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"
                               IsVisible="{Binding !IsLiveContent}"/>
                </Grid>

                <!-- Transport Controls -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Left: Volume/Mute -->
                        <ColumnDefinition Width="*"/>    <!-- Center: Play/Pause -->
                        <ColumnDefinition Width="Auto"/> <!-- Right: Settings/Fullscreen -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Volume -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding ToggleMuteCommand}">
                            <Grid>
                                <materialIcons:MaterialIcon Kind="VolumeOff" Width="20" Height="20" Foreground="White"
                                                            IsVisible="{Binding IsMuted}"/>
                                <materialIcons:MaterialIcon Kind="VolumeHigh" Width="20" Height="20" Foreground="White"
                                                            IsVisible="{Binding IsMuted, Converter={StaticResource InverseBoolConverter}}"/>
                            </Grid>
                        </Button>
                        <Slider Width="100" Margin="12,0,0,0" VerticalAlignment="Center"
                                Minimum="0" Maximum="100" Value="{Binding Volume}"/>
                    </StackPanel>

                    <!-- Center: Play/Pause (Noctra style large button) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding SkipBackwardCommand}" CommandParameter="10"
                                Margin="0,0,32,0"
                                IsVisible="{Binding !IsLiveContent}">
                            <materialIcons:MaterialIcon Kind="Rewind" Width="24" Height="24" Foreground="White"/>
                        </Button>

                        <Button x:Name="PlayPreviousLiveChannelBtn"
                                Click="PlayPreviousLiveChannel_Click"
                                Margin="0,0,32,0"
                                IsVisible="{Binding IsLiveContent}">
                            <materialIcons:MaterialIcon Kind="SkipPrevious" Width="24" Height="24" Foreground="White"/>
                        </Button>

                        <Button Command="{Binding PlayPauseCommand}"
                                Width="64" Height="64">
                            <Grid>
                                <materialIcons:MaterialIcon Kind="Pause" Width="28" Height="28" Foreground="White"
                                                            IsVisible="{Binding IsPlaying}"/>
                                <materialIcons:MaterialIcon Kind="Play" Width="28" Height="28" Foreground="White"
                                                            IsVisible="{Binding IsPlaying, Converter={StaticResource InverseBoolConverter}}"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding SkipForwardCommand}" CommandParameter="10"
                                Margin="32,0,0,0"
                                IsVisible="{Binding !IsLiveContent}">
                            <materialIcons:MaterialIcon Kind="FastForward" Width="24" Height="24" Foreground="White"/>
                        </Button>

                        <Button x:Name="PlayNextLiveChannelBtn"
                                Click="PlayNextLiveChannel_Click"
                                Margin="32,0,0,0"
                                IsVisible="{Binding IsLiveContent}">
                            <materialIcons:MaterialIcon Kind="SkipNext" Width="24" Height="24" Foreground="White"/>
                        </Button>
                    </StackPanel>

                    <!-- Right: Options -->
                    <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding OpenEpisodesCommand}"
                                    Content="B&#246;l&#252;mler" Margin="0,0,16,0"
                                    IsVisible="{Binding IsSeriesContent}"/>

                            <Button Command="{Binding PlayNextEpisodeCommand}"
                                    Content="S&#305;radaki B&#246;l&#252;m" Margin="0,0,24,0"
                                    IsVisible="{Binding IsSeriesContent}"/>

                            <Button Command="{Binding DownloadCurrentContentCommand}"
                                    IsVisible="{Binding CanShowDownloadButton}"
                                    IsEnabled="{Binding CanDownloadCurrentContent}"
                                    Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="Download" Width="18" Height="18" Foreground="White"/>
                                    <TextBlock Text="{Binding DownloadButtonText}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenInfoPanelCommand}" Margin="0,0,16,0">
                                <Button.IsVisible>
                                    <Binding Path="CanShowInfoButton"/>
                                </Button.IsVisible>
                                <materialIcons:MaterialIcon Kind="InformationOutline" Width="18" Height="18" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding OpenAudioSettingsCommand}" Margin="0,0,16,0">
                                <materialIcons:MaterialIcon Kind="Music" Width="18" Height="18" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding OpenQualitySettingsCommand}" Margin="0,0,16,0">
                                <materialIcons:MaterialIcon Kind="CogOutline" Width="18" Height="18" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding EnterPiPCommand}" Margin="0,0,16,0" ToolTip.Tip="Pencere İçi Pencere">
                                <materialIcons:MaterialIcon Kind="PictureInPictureBottomRight" Width="18" Height="18" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding ToggleFullScreenCommand}">
                                <Grid>
                                    <materialIcons:MaterialIcon Kind="Fullscreen" Width="18" Height="18" Foreground="White"
                                                                IsVisible="{Binding IsFullScreen, Converter={StaticResource InverseBoolConverter}}"/>
                                    <materialIcons:MaterialIcon Kind="FullscreenExit" Width="18" Height="18" Foreground="White"
                                                                IsVisible="{Binding IsFullScreen}"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{Binding DownloadStatusMessage}"
                                   HorizontalAlignment="Right"
                                   Foreground="#D9FFFFFF"
                                   FontSize="12"
                                   IsVisible="{Binding DownloadStatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 4. Side Sheets (Info) -->
            <Grid x:Name="InfoPanel"
                  Width="400" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Background="{DynamicResource SurfaceBrush}"
                  IsVisible="{Binding IsInfoPanelOpen}">
                <Grid.RenderTransform>
                    <TranslateTransform X="0"/>
                </Grid.RenderTransform>
                <Grid.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25"/>
                    </Transitions>
                </Grid.Transitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="32,48,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Hakk&#305;nda" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <Border Height="1" Background="{DynamicResource SurfaceLightBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding OpenInfoPanelCommand}"
                            Padding="12,6"
                            Height="36"
                            Margin="16,0,0,0">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,48">
                    <StackPanel>
                        <!-- Title & Year -->
                        <TextBlock Text="{Binding CurrentChannel.Name}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                            <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                    IsVisible="{Binding CurrentChannel.ReleaseYear, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentChannel.ReleaseYear}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                            </Border>
                            <Border Background="#E50914" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                    IsVisible="{Binding CurrentChannel.Rating, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentChannel.Rating, StringFormat='&#9733; {0:F1}'}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Current Program -->
                        <Border Background="{DynamicResource SurfaceLightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,20"
                                IsVisible="{Binding IsLiveContent}">
                            <StackPanel>
                                <TextBlock Text="&#350;U AN YAYINDA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CurrentProgram.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"
                                           IsVisible="{Binding CurrentProgram.Title, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding CurrentProgram.TimeRange}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0"
                                           IsVisible="{Binding HasCurrentProgramInfo}"/>
                                <TextBlock Text="{Binding CurrentProgram.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0"
                                           IsVisible="{Binding CurrentProgram.Description, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Plot -->
                        <TextBlock Text="{Binding CurrentChannel.Plot}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,24"
                                   IsVisible="{Binding CurrentChannel.Plot, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                        <!-- Cast & Crew -->
                        <StackPanel IsVisible="{Binding CurrentChannel.Director, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <TextBlock Text="Y&#214;NETMEN" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CurrentChannel.Director}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,16"/>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding CurrentChannel.Cast, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <TextBlock Text="OYUNCULAR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CurrentChannel.Cast}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 5. Side Sheets (Audio/Subtitles) -->
            <Grid x:Name="AudioSettingsPanel"
                  Width="360" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Background="{DynamicResource SurfaceBrush}"
                  IsVisible="{Binding IsAudioSettingsOpen}">
                <Grid.RenderTransform>
                    <TranslateTransform X="0"/>
                </Grid.RenderTransform>
                <Grid.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25"/>
                    </Transitions>
                </Grid.Transitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="32,48,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Ses ve Altyaz&#305;" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <Border Height="1" Background="{DynamicResource SurfaceLightBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding ClosePanelsCommand}"
                            Padding="12,6"
                            Height="36"
                            Margin="16,0,0,0">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,48">
                    <StackPanel>
                        <!-- Audio Tracks -->
                        <TextBlock Text="SES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding AudioTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Id}" Click="AudioTrack_Click"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,0,0,8"
                                            Content="{Binding Name}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Subtitle Tracks -->
                        <TextBlock Text="ALTYAZI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,24,0,16"/>
                        <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Id}" Click="SubtitleTrack_Click"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,0,0,8"
                                            Content="{Binding Name}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 5a. Side Sheets (Episodes) -->
            <Grid x:Name="EpisodesPanel"
                  Width="460" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Background="{DynamicResource SurfaceBrush}"
                  IsVisible="{Binding IsEpisodesPanelOpen}">
                <Grid.RenderTransform>
                    <TranslateTransform X="0"/>
                </Grid.RenderTransform>
                <Grid.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25"/>
                    </Transitions>
                </Grid.Transitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="32,48,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="B&#246;l&#252;mler" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding EpisodesPanelTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                   IsVisible="{Binding EpisodesPanelTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                        <Border Height="1" Background="{DynamicResource SurfaceLightBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding ClosePanelsCommand}"
                            Padding="12,6"
                            Height="36"
                            Margin="16,0,0,0">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,40">
                    <ItemsControl ItemsSource="{Binding EpisodeSeasons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Season">
                                <Expander Margin="0,0,0,10">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding SeasonNumber, StringFormat='Sezon {0}'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border Grid.Column="1" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="8" Padding="8,2">
                                                <TextBlock Text="{Binding Episodes.Count, StringFormat='{}{0} b&#246;l&#252;m'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Episodes}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:Episode">
                                                <Button Margin="0,0,0,12"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        CornerRadius="12"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding #OverlayRoot.DataContext.PlayEpisodeFromOverlayCommand}"
                                                        CommandParameter="{Binding}">
                                                    <!-- Main Container -->
                                                    <Panel>
                                                        <!-- Background Border -->
                                                        <Border Name="CardBackground" 
                                                                Background="{DynamicResource SurfaceLightBrush}" 
                                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                                BorderThickness="1" 
                                                                CornerRadius="12"
                                                                ClipToBounds="True"/>
                                                                
                                                        <!-- Content -->
                                                        <Grid ColumnDefinitions="120,*,Auto" Margin="10">
                                                            <!-- Thumbnail -->
                                                            <Border Width="120" Height="68" ClipToBounds="True" CornerRadius="8" Background="{DynamicResource Bg1Brush}">
                                                                <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}"/>
                                                            </Border>
                                                            
                                                            <!-- Text Info -->
                                                            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding EpisodeNumber, StringFormat='Bölüm {0}'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,4"/>
                                                                
                                                                <!-- Progress Bar -->
                                                                <Border Height="3" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="1.5" HorizontalAlignment="Left" Width="100"
                                                                        IsVisible="{Binding ., Converter={StaticResource EpisodeWatchedProgressVisibilityConverter}}">
                                                                    <Border Width="{Binding ., Converter={StaticResource EpisodeWatchedProgressWidthConverter}, ConverterParameter=100}"
                                                                            Background="{DynamicResource AccentBrush}" CornerRadius="1.5" HorizontalAlignment="Left"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Check Badge -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}"
                                                                        IsVisible="{Binding ., Converter={StaticResource EpisodeCompletionBadgeVisibilityConverter}}"
                                                                        BoxShadow="0 2 8 0 #4C000000">
                                                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="White"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Active Selection Border (Outer Glow) -->
                                                        <Border IsHitTestVisible="False"
                                                                BorderBrush="{DynamicResource AccentBrush}"
                                                                BorderThickness="2"
                                                                CornerRadius="12"
                                                                Background="Transparent">
                                                            <Border.IsVisible>
                                                                <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                                                                    <Binding Path="." Converter="{StaticResource EpisodeIdentityConverter}"/>
                                                                    <Binding Path="#OverlayRoot.DataContext.CurrentEpisodeIdentity"/>
                                                                </MultiBinding>
                                                            </Border.IsVisible>
                                                        </Border>
                                                    </Panel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 5b. Side Sheets (Quality) -->
            <Grid x:Name="QualitySettingsPanel"
                  Width="360" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Background="{DynamicResource SurfaceBrush}"
                  IsVisible="{Binding IsQualitySettingsOpen}">
                <Grid.RenderTransform>
                    <TranslateTransform X="0"/>
                </Grid.RenderTransform>
                <Grid.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25"/>
                    </Transitions>
                </Grid.Transitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="32,48,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Kalite" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <Border Height="1" Background="{DynamicResource SurfaceLightBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding ClosePanelsCommand}"
                            Padding="12,6"
                            Height="36"
                            Margin="16,0,0,0">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,48">
                    <StackPanel>
                        <!-- Detected Quality -->
                        <TextBlock Text="MEVCUT KAL&#304;TE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>

                        <!-- Resolution Badge -->
                        <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding StreamQuality.ResolutionLabel, FallbackValue='Tespit ediliyor...'}"
                                               FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Border Background="#8d09e5" CornerRadius="4" Padding="8,2" Margin="12,4,0,0" VerticalAlignment="Top"
                                            IsVisible="{Binding StreamQuality.QualityTier, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                        <TextBlock Text="{Binding StreamQuality.QualityTier}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding StreamQuality.DetailLabel, FallbackValue=''}"
                                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                           IsVisible="{Binding IsLiveContent}"/>
                                <TextBlock Text="{Binding StreamQuality.VideoCodec, FallbackValue=''}"
                                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                           IsVisible="{Binding !IsLiveContent}"/>
                            </StackPanel>
                        </Border>

                        <!-- Video Info -->
                        <TextBlock Text="V&#304;DEO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="&#199;&#246;z&#252;n&#252;rl&#252;k" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,16,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StreamQuality.ResolutionLabel, FallbackValue='-'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="FPS" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,16,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StreamQuality.Fps, StringFormat='{}{0} fps', FallbackValue='-'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Codec" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,16,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StreamQuality.VideoCodec, FallbackValue='-'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Bit Rate" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,16,6"
                                       IsVisible="{Binding IsLiveContent}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StreamQuality.VideoBitrate, Converter={StaticResource BitrateDisplayConverter}}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                       IsVisible="{Binding IsLiveContent}"/>
                        </Grid>

                        <!-- Audio Info -->
                        <TextBlock Text="SES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,16,0,12"/>
                        <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="8" Padding="16,12">
                            <TextBlock Text="{Binding StreamQuality.AudioDetailLabel, FallbackValue='Tespit ediliyor...'}"
                                       FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>

                        <!-- Playback Speed (Only for VOD/Series) -->
                        <StackPanel IsVisible="{Binding !IsLiveContent}">
                            <TextBlock Text="OYNATMA HIZI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,24,0,16"/>
                            <UniformGrid Columns="3">
                                <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.5}"
                                        Content="0.5x" HorizontalContentAlignment="Center" Margin="0,0,4,8"/>
                                <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.75}"
                                        Content="0.75x" HorizontalContentAlignment="Center" Margin="4,0,4,8"/>
                                <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.0}"
                                        Content="Normal" HorizontalContentAlignment="Center" Margin="4,0,0,8"/>
                                <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.25}"
                                        Content="1.25x" HorizontalContentAlignment="Center" Margin="0,0,4,0"/>
                                <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.5}"
                                        Content="1.5x" HorizontalContentAlignment="Center" Margin="4,0,4,0"/>
                                <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=2.0}"
                                        Content="2.0x" HorizontalContentAlignment="Center" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>

        <!-- Buffer Shield: Keep screen black while stream reconnects/buffers -->
        <Border Background="Black"
                IsHitTestVisible="True"
                ZIndex="900"
                IsVisible="{Binding IsBufferShieldVisible}"/>

        <!-- Loading state back button -->
        <Button Command="{Binding ClosePlayerCommand}"
                Classes="circle"
                ZIndex="1001"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="32,24,0,0"
                IsVisible="{Binding IsBuffering}">
            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" Foreground="White"/>
        </Button>

        <!-- 6. Volume Toast Indicator -->
        <Border x:Name="VolumeToast"
                Background="#DD000000"
                CornerRadius="12"
                Padding="32,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                ZIndex="1000"
                IsVisible="{Binding $parent[UserControl].IsVolumeToastVisible}"
                Opacity="{Binding $parent[UserControl].IsVolumeToastVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=OpacityOnly}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Border.Transitions>
            <StackPanel>
                <TextBlock Text="SESSIZ"
                           FontSize="26"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           Margin="0,0,0,12"
                           IsVisible="{Binding IsMuted}"/>
                <TextBlock Text="SES"
                           FontSize="26"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           Margin="0,0,0,12"
                           IsVisible="{Binding IsMuted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                <TextBlock Text="{Binding Volume, StringFormat='{}{0}%'}"
                           FontSize="28" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding IsMuted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
            </StackPanel>
        </Border>

        <Border x:Name="SeekToast"
                Background="#DD000000"
                CornerRadius="12"
                Padding="28,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,-140,0,0"
                IsHitTestVisible="False"
                ZIndex="1000"
                IsVisible="{Binding $parent[UserControl].IsSeekToastVisible}"
                Opacity="{Binding $parent[UserControl].IsSeekToastVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=OpacityOnly}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                </Transitions>
            </Border.Transitions>
            <TextBlock Text="{Binding $parent[UserControl].SeekToastText}"
                       FontSize="36"
                       FontWeight="SemiBold"
                       Foreground="White"/>
        </Border>

        <!-- 5. Ephemeral UI (Buffering Spinner - Always visible when buffering) -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    ZIndex="950"
                    IsVisible="{Binding IsBuffering}">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Ellipse Width="12" Height="12" Fill="#8D09E5" Opacity="0.35">
                    <Ellipse.Styles>
                        <Style Selector="Ellipse">
                            <Style.Animations>
                                <Animation Duration="0:0:1.0" IterationCount="INFINITE">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="Opacity" Value="1"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="33%">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="66%">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="Opacity" Value="1"/>
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Ellipse.Styles>
                </Ellipse>
                <Ellipse Width="12" Height="12" Fill="#8D09E5" Opacity="0.35">
                    <Ellipse.Styles>
                        <Style Selector="Ellipse">
                            <Style.Animations>
                                <Animation Duration="0:0:1.0" IterationCount="INFINITE">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="33%">
                                        <Setter Property="Opacity" Value="1"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="66%">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Ellipse.Styles>
                </Ellipse>
                <Ellipse Width="12" Height="12" Fill="#8D09E5" Opacity="0.35">
                    <Ellipse.Styles>
                        <Style Selector="Ellipse">
                            <Style.Animations>
                                <Animation Duration="0:0:1.0" IterationCount="INFINITE">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="33%">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="66%">
                                        <Setter Property="Opacity" Value="1"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Ellipse.Styles>
                </Ellipse>
            </StackPanel>
            <TextBlock Text="Y&#252;kleniyor..." Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>


