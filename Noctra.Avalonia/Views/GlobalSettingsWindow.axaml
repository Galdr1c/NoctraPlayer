<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Noctra.ViewModels"
        xmlns:loc="using:Noctra.Avalonia.Localization"
        x:Class="Noctra.Avalonia.Views.GlobalSettingsWindow"
        x:DataType="vm:GlobalSettingsViewModel"
        x:CompileBindings="False"
        Title="{loc:Translate GlobalSettings.Title}"
        Width="800" Height="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        WindowDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="{StaticResource DefaultFontFamily}"
        xmlns:materialIcons="using:Material.Icons.Avalonia">

    <Window.Styles>
        <!-- Close Button Style -->
        <Style Selector="Button.CloseButtonStyle">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="CloseBg" Background="{TemplateBinding Background}" CornerRadius="12">
                        <materialIcons:MaterialIcon x:Name="CloseIcon" Kind="Close" Width="24" Height="24"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ Border#CloseBg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ materialIcons|MaterialIcon#CloseIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Clear Cache Button Style -->
        <Style Selector="Button.ClearCacheButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="CacheBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="24" Height="24" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Translate GlobalSettings.Cache.Clear}"
                                       FontSize="15"
                                       Foreground="{DynamicResource WarningBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ClearCacheButtonStyle:pointerover /template/ Border#CacheBorder">
            <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        </Style>

        <!-- Text Link Button Style -->
        <Style Selector="Button.TextLinkButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.TextLinkButtonStyle:pointerover">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <!-- Rotating Icon Animation -->
        <Style Selector="materialIcons|MaterialIcon.Rotating">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Border CornerRadius="8"
            ClipToBounds="True"
            Background="{DynamicResource BackgroundGradientBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- ==========================================
                 HEADER
                 ========================================== -->
            <Grid Grid.Row="0" 
                  Margin="32,24,32,24"
                  Height="48"
                  Background="Transparent"
                  PointerPressed="Header_PointerPressed">
                <TextBlock Text="{loc:Translate GlobalSettings.Title}" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                
                <!-- Close Button -->
                <Button HorizontalAlignment="Right"
                        Click="CloseButton_Click"
                        Classes="CloseButtonStyle">
                    <materialIcons:MaterialIcon Kind="Close" Width="24" Height="24"/>
                </Button>
            </Grid>

            <!-- ==========================================
                 CONTENT
                 ========================================== -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="32,0,32,0">
                <StackPanel MaxWidth="650" Margin="0,0,0,40">

                    <!-- APPEARANCE SECTION -->
                    <Border Background="{DynamicResource Surface0Brush}" 
                            CornerRadius="8" 
                            Padding="24"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate GlobalSettings.Appearance.Title}" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,20"/>

                            <!-- Theme Selection -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{loc:Translate GlobalSettings.Theme.Title}"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:Translate GlobalSettings.Theme.Description}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Theme Options -->
                                <StackPanel Grid.Column="1" 
                                           Orientation="Horizontal">
                                    
                                    <!-- Dark Theme Button -->
                                    <Border x:Name="DarkThemeButton"
                                            Width="130" Height="85"
                                            CornerRadius="4"
                                            BorderThickness="1.5"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            Cursor="Hand"
                                            PointerPressed="DarkTheme_PointerPressed"
                                            Margin="0,0,16,0">
                                        <Grid>
                                            <Border Background="{DynamicResource ThemePreviewDarkBg}" CornerRadius="4">
                                                <Grid>
                                                    <!-- Mini UI Preview -->
                                                    <Border Background="{DynamicResource ThemePreviewDarkInnerBg}" 
                                                           Width="95" Height="50"
                                                           CornerRadius="4"
                                                           Margin="12">
                                                        <StackPanel Margin="8">
                                                            <Rectangle Fill="White" Height="4" Width="40" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                            <Rectangle Fill="{DynamicResource ThemePreviewDarkText}" Height="3" Width="50" HorizontalAlignment="Left" Margin="0,0,0,3"/>
                                                            <Rectangle Fill="{DynamicResource ThemePreviewDarkText}" Height="3" Width="45" HorizontalAlignment="Left"/>
                                                        </StackPanel>
                                                    </Border>
                                                    
                                                    <!-- Checkmark -->
                                                    <Border x:Name="DarkCheckmark"
                                                           Width="24" Height="24"
                                                           Background="{DynamicResource AccentBrush}"
                                                           CornerRadius="4"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top"
                                                           Margin="8">
                                                        <materialIcons:MaterialIcon Kind="Check"
                                                                                   Foreground="White"
                                                                                   Width="14" Height="14"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{loc:Translate GlobalSettings.Theme.Dark}"
                                                      FontSize="12"
                                                      Foreground="{DynamicResource ThemePreviewDarkLabelBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Bottom"
                                                      Margin="0,0,0,8"/>
                                        </Grid>
                                    </Border>

                                    <!-- Light Theme Button -->
                                    <Border x:Name="LightThemeButton"
                                            Width="130" Height="85"
                                            CornerRadius="4"
                                            BorderThickness="1.5"
                                            BorderBrush="Transparent"
                                            Cursor="Hand"
                                            PointerPressed="LightTheme_PointerPressed">
                                        <Grid>
                                            <Border Background="{DynamicResource ThemePreviewLightBg}" CornerRadius="4">
                                                <Grid>
                                                    <!-- Mini UI Preview -->
                                                    <Border Background="{DynamicResource ThemePreviewLightInnerBg}" 
                                                           Width="95" Height="50"
                                                           CornerRadius="4"
                                                           Margin="12">
                                                        <StackPanel Margin="8">
                                                            <Rectangle Fill="{DynamicResource ThemePreviewDarkBg}" Height="4" Width="40" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                            <Rectangle Fill="{DynamicResource ThemePreviewLightText}" Height="3" Width="50" HorizontalAlignment="Left" Margin="0,0,0,3"/>
                                                            <Rectangle Fill="{DynamicResource ThemePreviewLightText}" Height="3" Width="45" HorizontalAlignment="Left"/>
                                                        </StackPanel>
                                                    </Border>
                                                    
                                                    <!-- Checkmark (hidden by default) -->
                                                    <Border x:Name="LightCheckmark"
                                                           Width="24" Height="24"
                                                           Background="{DynamicResource AccentBrush}"
                                                           CornerRadius="4"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top"
                                                           Margin="8"
                                                           IsVisible="False">
                                                        <materialIcons:MaterialIcon Kind="Check"
                                                                                   Foreground="White"
                                                                                   Width="14" Height="14"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{loc:Translate GlobalSettings.Theme.Light}"
                                                      FontSize="12"
                                                      Foreground="{DynamicResource ThemePreviewLightLabelBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Bottom"
                                                      Margin="0,0,0,8"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" 
                                      Fill="{DynamicResource BorderBrush}" 
                                      Margin="0,16"/>

                            <!-- Language Selection -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{loc:Translate GlobalSettings.Language.Title}"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:Translate GlobalSettings.Language.Description}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          SelectedValue="{Binding Settings.Language, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding Tag}"
                                          Width="180">
                                    <ComboBoxItem Content="{loc:Translate Language.Turkish}" Tag="tr"/>
                                    <ComboBoxItem Content="{loc:Translate Language.English}" Tag="en"/>
                                    <ComboBoxItem Content="{loc:Translate Language.German}" Tag="de"/>
                                    <ComboBoxItem Content="{loc:Translate Language.French}" Tag="fr"/>
                                    <ComboBoxItem Content="{loc:Translate Language.Spanish}" Tag="es"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GENERAL SECTION -->
                    <Border Background="{DynamicResource Surface0Brush}" 
                            CornerRadius="8" 
                            Padding="24"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate GlobalSettings.General.Title}" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,20"/>

                            <!-- Auto-update -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{loc:Translate GlobalSettings.General.AutoUpdate.Title}"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:Translate GlobalSettings.General.AutoUpdate.Description}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding Settings.AutoUpdate}"/>
                            </Grid>

                            <!-- Hardware acceleration -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{loc:Translate GlobalSettings.General.HardwareAcceleration.Title}"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:Translate GlobalSettings.General.HardwareAcceleration.Description}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding Settings.HardwareAcceleration}"/>
                            </Grid>

                            <!-- Diagnostics -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{loc:Translate GlobalSettings.General.Diagnostics.Title}"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:Translate GlobalSettings.General.Diagnostics.Description}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding Settings.DiagnosticDataConsent}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- DATA & CACHE SECTION -->
                    <Border Background="{DynamicResource Surface0Brush}" 
                            CornerRadius="8" 
                            Padding="24"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate GlobalSettings.Cache.Title}" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,20"/>

                            <!-- Cache info -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{loc:Translate GlobalSettings.Cache.Size.Title}"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:Translate GlobalSettings.Cache.Size.Description}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding CacheSizeString}"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>

                            </Grid>

                            <!-- Clear cache button -->
                            <Button Command="{Binding ClearCacheCommand}"
                                    HorizontalAlignment="Left"
                                    Classes="ClearCacheButtonStyle"/>
                        </StackPanel>
                    </Border>
                    <!-- ABOUT SECTION -->
                    <Panel>
                        <!-- PREMIUM CARD -->
                        <Border Background="{DynamicResource PremiumBadgeBrush}" 
                                CornerRadius="8" 
                                Padding="1.5"
                                IsVisible="{Binding IsPremium}"
                                Margin="0,0,0,24">
                            <Border Background="{DynamicResource Bg1Brush}" 
                                    CornerRadius="8" 
                                    Padding="24"
                                    ClipToBounds="True">
                                <Panel>
                                    <!-- Crown Icon (Top Right Background) -->
                                    <materialIcons:MaterialIcon Kind="Crown" 
                                                              Width="140" Height="140" 
                                                              Foreground="{DynamicResource PremiumBadgeTextBrush}" 
                                                              Opacity="0.05"
                                                              HorizontalAlignment="Center" 
                                                              VerticalAlignment="Top"
                                                              Margin="260,-10,0,0"/>

                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- App Icon -->
                                            <Image Source="avares://Noctra/Assets/Square150x150Logo.png"
                                                   Width="64"
                                                   Height="64"
                                                   Stretch="Uniform"
                                                   Margin="0,0,20,0"/>

                                            <!-- App Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="Noctra"
                                                             FontSize="22"
                                                             FontWeight="Bold"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    
                                                    <!-- PREMIUM BADGE -->
                                                    <Border Padding="10,3" 
                                                            CornerRadius="3"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource PremiumBadgeBrush}">
                                                        <TextBlock Text="PREMIUM" 
                                                                 FontSize="11" 
                                                                 FontWeight="ExtraBold" 
                                                                 Foreground="{DynamicResource PremiumBadgeTextBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{loc:Translate GlobalSettings.About.Version}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding CurrentVersion}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{loc:Translate GlobalSettings.About.Suite}" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="6,0,0,0" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- PREM SEPARATOR -->
                                        <Border Height="1.5" Margin="0,24,0,20">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0.4"/>
                                                    <GradientStop Color="#f5c842" Offset="0.7"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- PREMIUM FOOTER -->
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Translate GlobalSettings.About.Copyright}"
                                                         FontSize="12"
                                                         Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </Border>

                        <!-- FREE CARD (Standard Refined) -->
                        <Border Background="{DynamicResource Surface0Brush}" 
                                CornerRadius="8" 
                                Padding="24"
                                IsVisible="{Binding !IsPremium}"
                                Margin="0,0,0,24">
                            <StackPanel>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- App Icon -->
                                    <Image Source="avares://Noctra/Assets/Square150x150Logo.Gray.png"
                                           Width="64"
                                           Height="64"
                                           Stretch="Uniform"
                                           Margin="0,0,20,0"/>
                                    
                                    <!-- App Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Noctra"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{loc:Translate GlobalSettings.About.Version}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding CurrentVersion}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- UPGRADE BUTTON -->
                                    <Button Grid.Column="2" 
                                            Command="{Binding ShowUpsellCommand}"
                                            Padding="16,8"
                                            Background="{DynamicResource PremiumBadgeBrush}"
                                            Foreground="White"
                                            CornerRadius="8"
                                            VerticalAlignment="Center"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <materialIcons:MaterialIcon Kind="Crown" Width="16" Height="16"/>
                                            <TextBlock Text="{loc:Translate GlobalSettings.About.Upgrade}" FontWeight="SemiBold" Foreground="{DynamicResource PremiumBadgeTextBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,16" Opacity="0.5"/>
                                
                                <TextBlock Text="{loc:Translate GlobalSettings.About.Copyright}"
                                         FontSize="12"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Panel>

                    
                            <!-- Global Promo Code Section -->
                            <Border Padding="20,16" Margin="0,0,0,16" CornerRadius="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#1A6D28D9" Offset="0.0"/>
                                        <GradientStop Color="#08B7A6F6" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                
                                <Border BorderBrush="{DynamicResource Surface0Brush}" CornerRadius="8" Padding="20">
                                    <Panel>
                                        <!-- Background Watermark Icon -->
                                        <materialIcons:MaterialIcon Kind="TicketPercentOutline" 
                                                                    Width="120" Height="120" 
                                                                    Foreground="{DynamicResource AccentBrush}" 
                                                                    Opacity="0.05"
                                                                    HorizontalAlignment="Right" 
                                                                    VerticalAlignment="Top"
                                                                    Margin="0,-30,-20,0"/>
                                                                    
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                                                <Border Background="{DynamicResource PremiumBadgeBrush}" Opacity="0.9" Padding="6" CornerRadius="4">
                                                    <materialIcons:MaterialIcon Kind="GiftOutline" Width="20" Height="20" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="{loc:Translate GlobalSettings.Promo.Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{loc:Translate GlobalSettings.Promo.Description}" 
                                                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>
                                            
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Text="{Binding PromoCodeInput, Mode=TwoWay}" 
                                                         PlaceholderText="{loc:Translate GlobalSettings.Promo.Placeholder}"
                                                         Padding="16,12"
                                                         CornerRadius="8"
                                                         BorderThickness="1.5"
                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                         Background="{DynamicResource Surface1Brush}"
                                                         VerticalContentAlignment="Center"
                                                         FontSize="15"
                                                         LetterSpacing="1"
                                                         Theme="{StaticResource ModernTextBox}"/>
                                                <Button Grid.Column="1"
                                                        Command="{Binding ApplyPromoCodeCommand}"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Foreground="White"
                                                        CornerRadius="8"
                                                        Padding="24,10"
                                                        Margin="12,0,0,0"
                                                        Cursor="Hand"
                                                        VerticalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <materialIcons:MaterialIcon Kind="AutoAwesome" Width="18" Height="18" IsVisible="{Binding !IsApplyingPromoCode}"/>
                                                        <materialIcons:MaterialIcon Kind="Refresh" Width="18" Height="18" Classes="Rotating" IsVisible="{Binding IsApplyingPromoCode}"/>
                                                        <TextBlock Text="{loc:Translate GlobalSettings.Promo.Apply}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            
                                            <!-- Sonuç Mesajları -->
                                            <StackPanel Margin="0,12,0,0" Spacing="4">
                                                <TextBlock Text="{Binding PromoCodeStatus}" 
                                                           FontSize="13" FontWeight="Bold" 
                                                           Foreground="{Binding IsPromoCodeStatusSuccess, Converter={StaticResource BooleanToSuccessWarningBrushConverter}}"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding PromoCodeStatus, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding PremiumStatusText}" 
                                                           FontSize="13" FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource SuccessBrush}" 
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding PremiumStatusText, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Panel>
                                </Border>
                            </Border>
                            
                    <!-- UPDATE SECTION (Enhanced Modern Card) -->
                    <Border Background="{DynamicResource Surface0Brush}" 
                            CornerRadius="12" 
                            Padding="20,16" 
                            Margin="0,0,0,16">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Status Icon -->
                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="{DynamicResource Surface1Brush}" Margin="0,0,16,0">
                                <materialIcons:MaterialIcon Kind="Update" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{loc:Translate GlobalSettings.Update.Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding UpdateStatusText}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            
                            <!-- Action Area -->
                            <Panel Grid.Column="2">
                                <!-- Checking State -->
                                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsCheckingUpdates}">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="18" Height="18" Classes="Rotating" Foreground="{DynamicResource AccentBrush}">
                                        <materialIcons:MaterialIcon.RenderTransform>
                                            <RotateTransform />
                                        </materialIcons:MaterialIcon.RenderTransform>
                                    </materialIcons:MaterialIcon>
                                    <TextBlock Text="{loc:Translate GlobalSettings.Update.Checking}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>

                                <!-- Idle State -->
                                <Button Command="{Binding CheckForUpdatesCommand}"
                                        IsVisible="{Binding IsIdle}"
                                        Padding="16,8"
                                        Background="{DynamicResource Surface1Brush}"
                                        CornerRadius="8"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                                        <TextBlock Text="{loc:Translate GlobalSettings.Update.Check}" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Update Available State -->
                                <Button Command="{Binding StartUpdateCommand}"
                                        IsVisible="{Binding IsUpdateAvailable}"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        Padding="18,9"
                                        CornerRadius="8"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="RocketLaunch" Width="18" Height="18"/>
                                        <TextBlock Text="{loc:Translate GlobalSettings.Update.Now}" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </Panel>
                        </Grid>
                    </Border>

                    <!-- BUG REPORT (Common for both) -->
                    <Border Background="#1AE50914" BorderBrush="#E50914" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Translate GlobalSettings.Support.Question}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{loc:Translate GlobalSettings.Support.Description}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:Translate GlobalSettings.Support.Report}" Command="{Binding ReportBugCommand}" Padding="16,8" Background="#E50914" Foreground="White" CornerRadius="8"/>
                        </Grid>
                    </Border>

                    <Rectangle Height="1" 
                              Fill="{DynamicResource BorderBrush}" 
                              Margin="0,20"
                              IsVisible="{Binding !IsPremium}"/>

                            <!-- Links -->
                            <StackPanel Orientation="Horizontal"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0">
                                <Button Content="{loc:Translate GlobalSettings.Links.Privacy}"
                                        Command="{Binding ShowPrivacyPolicyCommand}"
                                        Classes="TextLinkButtonStyle"/>
                                <TextBlock Text=" | " 
                                          Foreground="{DynamicResource BorderBrush}" 
                                          VerticalAlignment="Center"
                                          Margin="8,0"/>
                                <Button Content="{loc:Translate GlobalSettings.Links.Terms}"
                                        Command="{Binding ShowTermsCommand}"
                                        Classes="TextLinkButtonStyle"/>
                            </StackPanel>

                    <!-- DEVELOPER TOOLS SECTION -->
                    <Border Background="{DynamicResource SuccessBackgroundBrush}" 
                            BorderBrush="{DynamicResource SuccessBrush}" Opacity="0.8"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,24,0,0"
                            IsVisible="{Binding CanTogglePremiumForTesting}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                                <materialIcons:MaterialIcon Kind="CodeBraces" Width="20" Height="20" 
                                                            Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{loc:Translate GlobalSettings.Dev.Title}" FontWeight="Bold" 
                                           Foreground="{DynamicResource SuccessBrush}" FontSize="16" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <Border Background="{DynamicResource Surface1Brush}" CornerRadius="6" Padding="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Translate GlobalSettings.Dev.PremiumBypass}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{loc:Translate GlobalSettings.Dev.PremiumBypassDescription}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" 
                                            Content="{loc:Translate GlobalSettings.Dev.PremiumBypass}" 
                                            Command="{Binding TogglePremiumCommand}" 
                                            Background="{DynamicResource SuccessBackgroundBrush}" 
                                            Foreground="{DynamicResource SuccessBrush}"
                                            BorderBrush="{DynamicResource SuccessBrush}"
                                            BorderThickness="1"
                                            Padding="12,6" 
                                            CornerRadius="4"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- SECRET DEVELOPER ENTRY -->
                    <Grid Height="30" Margin="0,10,0,0">
                        <TextBlock Text="{Binding CurrentVersion}" 
                                  FontSize="10" 
                                  Foreground="{DynamicResource BorderBrush}"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>
                        <TextBox Text="{Binding DeveloperPassword}" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="Transparent"
                                 CaretBrush="Transparent"
                                 SelectionBrush="Transparent"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Opacity="0.05"
                                 Cursor="IBeam"/>
                    </Grid>
                        

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>

</Window>
