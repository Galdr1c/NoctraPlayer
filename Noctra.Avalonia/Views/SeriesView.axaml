<UserControl x:CompileBindings="True" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:views="using:Noctra.Avalonia.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Noctra.Avalonia.Views.SeriesView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer x:Name="SeriesScrollViewer" IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Series}}"
                      ScrollChanged="SeriesView_ScrollChanged">
          <StackPanel Margin="24">
            <Grid Margin="0,0,0,24" ColumnDefinitions="*,Auto">
              <TextBlock Text="Diziler" FontSize="24" LetterSpacing="1" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <ComboBox Width="260" Height="45" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Theme="{StaticResource ModernComboBox}"/>
                <Button Content="Tümü" Width="80" Height="45" Click="ClearGroupSelection_Click" Theme="{StaticResource FilterButtonStyle}"/>
                <ComboBox Width="240" Height="45" ItemsSource="{Binding SortOptions}" SelectedValue="{Binding SelectedSortOrder}" SelectedValueBinding="{Binding Key}" DisplayMemberBinding="{Binding Value}" Theme="{StaticResource ModernComboBox}"/>
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding SeriesViewItems}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Series">
                  <controls:SeriesCard Margin="0,0,16,16" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- YÜKLENIYOR STATE -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,80,0,0" Spacing="20"
                        IsVisible="{Binding IsContentLoading}">
                <controls:PremiumSpinner Width="56" Height="56"
                                         HorizontalAlignment="Center"/>
                <TextBlock Text="Diziler yükleniyor..."
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextAlignment="Center"/>
                <TextBlock Text="Bu işlem liste büyüklüğüne göre birkaç saniye sürebilir."
                           FontSize="12" Opacity="0.6"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextAlignment="Center"/>
            </StackPanel>

            <!-- GERÇEKTEN BOŞ STATE -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,96,0,0"
                        IsVisible="{Binding ShowEmptyChannels}">
                <materialIcons:MaterialIcon Kind="MovieFilter" Width="64" Height="64"
                                            Foreground="{DynamicResource TextMutedBrush}" Opacity="0.5"/>
                <TextBlock Text="Dizi bulunamadı" FontSize="20" LetterSpacing="1"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center" Margin="0,14,0,6"/>
                <TextBlock Text="Bu filtrede gösterilecek dizi yok."
                           FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                           TextAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
</UserControl>
