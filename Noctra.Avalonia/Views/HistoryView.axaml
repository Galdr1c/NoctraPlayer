<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:loc="using:Noctra.UI.Localization"
             xmlns:shared="using:Noctra.UI.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Avalonia.Views.HistoryView"
             x:CompileBindings="False">
  <Grid IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.History}}">
    <shared:AdaptiveLibraryView
        Title="{loc:Translate History.Title}"
        IsEmpty="{Binding ShowHistoryEmptyState}"
        EmptyIconKind="History"
        EmptyTitle="{loc:Translate History.Empty.Title}"
        EmptyDescription="{loc:Translate History.Empty.Description}">
      <shared:AdaptiveLibraryView.HeaderActionHost>
        <Button Command="{Binding ClearHistoryCommand}"
                IsVisible="{Binding ShowHistoryEmptyState, Converter={StaticResource InverseBoolConverter}}"
                Theme="{StaticResource ErrorButton}"
                MinHeight="48">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14"
                                Foreground="{DynamicResource ErrorBrush}" />
            <TextBlock Text="{loc:Translate Settings.Privacy.Clear.Title}"
                       Foreground="{DynamicResource ErrorBrush}"
                       FontSize="{DynamicResource FCaption}"
                       FontWeight="Medium" />
          </StackPanel>
        </Button>
      </shared:AdaptiveLibraryView.HeaderActionHost>
      <shared:AdaptiveLibraryView.ItemsHost>
        <controls:DesktopSectionedCardFeed ScrollChanged="HistoryScrollViewer_ScrollChanged">
          <controls:DesktopSectionedCardFeed.Sections>
            <controls:DesktopCardSection Header="{loc:Translate History.LiveTv}" CardKind="Live" PresentationMode="History" SourceItems="{Binding HistoryLiveChannels}" />
            <controls:DesktopCardSection Header="{loc:Translate History.Series}" CardKind="Series" PresentationMode="History" SourceItems="{Binding HistorySeriesItems}" />
            <controls:DesktopCardSection Header="{loc:Translate History.Movies}" CardKind="Vod" PresentationMode="History" SourceItems="{Binding HistoryVodChannels}" />
          </controls:DesktopSectionedCardFeed.Sections>
        </controls:DesktopSectionedCardFeed>
      </shared:AdaptiveLibraryView.ItemsHost>
    </shared:AdaptiveLibraryView>
  </Grid>
</UserControl>
