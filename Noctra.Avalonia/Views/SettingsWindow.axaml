<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Noctra.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:controls="using:Noctra.Avalonia.Controls"
        xmlns:behaviors="using:Noctra.Avalonia.Behaviors"
        mc:Ignorable="d"
        x:Class="Noctra.Avalonia.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        x:CompileBindings="False"
        Title="Ayarlar" Height="750" Width="850"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SystemDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="{StaticResource DefaultFontFamily}">

    <Window.Resources>
    </Window.Resources>

    <Window.Styles>
        <!-- Close Button Style -->
        <Style Selector="Button.CloseButtonStyle">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="CloseBg" Background="{TemplateBinding Background}" CornerRadius="24">
                        <materialIcons:MaterialIcon x:Name="CloseIcon" Kind="Close" Width="24" Height="24"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ Border#CloseBg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ materialIcons|MaterialIcon#CloseIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Settings Tab Item Style -->
        <Style Selector="TabItem.SettingsTab">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border x:Name="HoverBackground" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Opacity="0"
                                Margin="2,4"/>
                        
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_HeaderPresenter" 
                                              Content="{TemplateBinding Header}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <!-- Selection Indicator -->
                        <Border x:Name="SelectionIndicator" 
                                Height="3" 
                                Width="20" 
                                Background="{DynamicResource AccentBrush}" 
                                VerticalAlignment="Bottom" 
                                HorizontalAlignment="Center"
                                CornerRadius="1.5"
                                Margin="0,0,0,2"
                                IsVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="TabItem.SettingsTab:selected">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TabItem.SettingsTab:selected /template/ Border#SelectionIndicator">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="TabItem.SettingsTab:pointerover /template/ Border#HoverBackground">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="TabItem.SettingsTab:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Settings Card Style -->
        <Style Selector="Border.SettingsCard">
            <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource BackgroundGradientBrush}" 
            CornerRadius="{DynamicResource RadiusLarge}" 
            ClipToBounds="True"
            Margin="1"
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0"
                  Margin="32,24,32,12"
                  Background="Transparent"
                  PointerPressed="Header_PointerPressed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ayarlar" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <Button HorizontalAlignment="Right" Click="CloseButton_Click"
                        Classes="CloseButtonStyle" ToolTip.Tip="Kapat"/>
            </Grid>

            <!-- CONTENT -->
            <TabControl behaviors:TabSlideTransitionBehavior.IsEnabled="True" ClipToBounds="True" Grid.Row="1" Margin="32,0,0,0" Background="Transparent" Padding="0">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
                
                <!-- PROFILE TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="AccountBoxOutline" Width="20" Height="20" />
                            <TextBlock Text="Profil" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,20">
                            
                            <!-- Current Profile Card -->
                            <Border Classes="SettingsCard">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Avatar -->
                                    <Border Width="80" Height="80" CornerRadius="40" Margin="0,0,24,0" 
                                            Background="{DynamicResource PrimaryGradientBrush}"
                                            ClipToBounds="True">
                                        <Border CornerRadius="40" RenderOptions.BitmapInterpolationMode="HighQuality">
                                            <Border.Background>
                                                <ImageBrush Source="{Binding CurrentProfileAvatar, Converter={StaticResource AvatarPathConverter}}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentProfileName}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Aktif Profil" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text=" • " FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding ProfileCreatedAt, StringFormat='Oluşturulma: {0:dd.MM.yyyy}'}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="Profil Yönetimi" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Kim İzliyor ekranına dönerek aktif profili değiştirebilirsiniz."
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,14"/>
                                    <Button Content="Profil Seçme Ekranına Dön"
                                            Click="BackToProfiles_Click"
                                            HorizontalAlignment="Left"
                                            Padding="18,10"/>
                                </StackPanel>
                            </Border>

                            <!-- Subscription Details -->
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="Hesap Bilgileri" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="URL:" FontSize="15" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ProviderUrl}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Kullanıcı Adı:" FontSize="15" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ProviderUsername}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Şifre:" FontSize="15" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ProviderPassword}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Grid>
                                    
                                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,4,0,16"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Bitiş Tarihi:" FontSize="15" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding ExpirationDate, StringFormat='dd MMMM yyyy', TargetNullValue='Bilgi yok'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding ExpirationStatus}" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                            </Border>
                            
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- PLAYBACK TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="PlayBoxOutline" Width="20" Height="20" />
                            <TextBlock Text="Oynatma &amp; İndirme" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,100">

                            <!-- Ağ Ayarları -->
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="Ağ Ayarları" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="User-Agent" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox Text="{Binding UserAgent, Mode=TwoWay}" Watermark="VLC/3.0.x LibVLC/3.0.x" Padding="12" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="Otomatik Oynatma" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Sonraki bölümü otomatik oynat" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Bir bölüm bittiğinde seriyi otomatik devam ettirir" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoPlayNext}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="Görüntü Kalitesi" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    <TextBlock Text="Video kalitesi tercihi" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}" SelectedIndex="{Binding SelectedDataUsage}" Width="250" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="Düşük (480p)"/>
                                        <ComboBoxItem Content="Orta (720p)"/>
                                        <ComboBoxItem Content="Yüksek (1080p)"/>
                                        <ComboBoxItem Content="Otomatik"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="Video Buffer (Önbellek) Boyutu" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Bağlantı hızınıza göre video yükleme tamponunu ayarlayın." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                                    <StackPanel Orientation="Horizontal" Spacing="24">
                                        <!-- Küçük (2sn) - PREMIUM -->
                                        <Grid VerticalAlignment="Center">
                                            <RadioButton Content="Küçük (2sn)" GroupName="Buffer"
                                                         IsChecked="{Binding IsBufferSmall}"
                                                         IsEnabled="{Binding IsPremium}"
                                                         Theme="{StaticResource ModernRadioButton}"/>
                                            <!-- Lock icon positioned over the circle -->
                                            <materialIcons:MaterialIcon Kind="Lock" Width="18" Height="18" 
                                                                        Foreground="{DynamicResource TextMutedBrush}" 
                                                                        IsVisible="{Binding !IsPremium}" 
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                        Margin="0,0,0,0"
                                                                        IsHitTestVisible="False"/>
                                        </Grid>
                                        
                                        <!-- Normal (5sn) - FREE -->
                                        <RadioButton Content="Normal (5sn)" GroupName="Buffer"
                                                     IsChecked="{Binding IsBufferNormal}"
                                                     Theme="{StaticResource ModernRadioButton}"/>

                                        <!-- Büyük (10sn) - PREMIUM -->
                                        <Grid VerticalAlignment="Center">
                                            <RadioButton Content="Büyük (10sn)" GroupName="Buffer"
                                                         IsChecked="{Binding IsBufferLarge}"
                                                         IsEnabled="{Binding IsPremium}"
                                                         Theme="{StaticResource ModernRadioButton}"/>
                                            <!-- Lock icon positioned over the circle -->
                                            <materialIcons:MaterialIcon Kind="Lock" Width="18" Height="18" 
                                                                        Foreground="{DynamicResource TextMutedBrush}" 
                                                                        IsVisible="{Binding !IsPremium}" 
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                        Margin="0,0,0,0"
                                                                        IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="Ses ve Altyazı" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Altyazıları otomatik aç" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Altyazıyı varsayılan olarak etkinleştirir" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SubtitleEnabled}"/>
                                    </Grid>

                                    <TextBlock Text="Tercih Edilen Altyazı Dili" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}" SelectedValue="{Binding SubtitleLanguage, Mode=TwoWay}" SelectedValueBinding="{Binding Tag}" Width="250" HorizontalAlignment="Left" Margin="0,0,0,18">
                                        <ComboBoxItem Content="Türkçe" Tag="tr"/>
                                        <ComboBoxItem Content="English" Tag="en"/>
                                        <ComboBoxItem Content="Deutsch" Tag="de"/>
                                        <ComboBoxItem Content="Français" Tag="fr"/>
                                        <ComboBoxItem Content="Español" Tag="es"/>
                                        <ComboBoxItem Content="Italiano" Tag="it"/>
                                        <ComboBoxItem Content="Português" Tag="pt"/>
                                        <ComboBoxItem Content="Русский" Tag="ru"/>
                                        <ComboBoxItem Content="العربية" Tag="ar"/>
                                        <ComboBoxItem Content="Nederlands" Tag="nl"/>
                                    </ComboBox>

                                    <TextBlock Text="Tercih Edilen Ses Dili" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}" SelectedValue="{Binding PreferredAudioLanguage, Mode=TwoWay}" SelectedValueBinding="{Binding Tag}" Width="250" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="Türkçe" Tag="tr"/>
                                        <ComboBoxItem Content="English" Tag="en"/>
                                        <ComboBoxItem Content="Deutsch" Tag="de"/>
                                        <ComboBoxItem Content="Français" Tag="fr"/>
                                        <ComboBoxItem Content="Español" Tag="es"/>
                                        <ComboBoxItem Content="Italiano" Tag="it"/>
                                        <ComboBoxItem Content="Português" Tag="pt"/>
                                        <ComboBoxItem Content="Русский" Tag="ru"/>
                                        <ComboBoxItem Content="العربية" Tag="ar"/>
                                        <ComboBoxItem Content="Nederlands" Tag="nl"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                        
                            <!-- Subtitle Section Removed -->
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="İndirme" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Sadece Wi-Fi ile indir" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Mobil veri kullanımını engeller" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding DownloadWifiOnly}"/>
                                    </Grid>
                                    <TextBlock Text="İndirme kalitesi" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}" SelectedIndex="{Binding SelectedDownloadQuality}" Width="250" HorizontalAlignment="Left" Margin="0,0,0,18">
                                        <ComboBoxItem Content="Standart"/>
                                        <ComboBoxItem Content="Yüksek"/>
                                    </ComboBox>
                                    <TextBlock Text="Kayıt Konumu" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding DownloadPath}" IsReadOnly="True" Padding="12"/>
                                        <Button Grid.Column="1" Content="Değiştir" Click="ChangeDownloadPath_Click" Margin="12,0,0,0" Padding="20,10"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- CHANNEL LIST TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FormatListBulletedSquare" Width="20" Height="20" />
                            <TextBlock Text="Kanal Listesi" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,100">
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="Kanal Listesi Yenileme" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    <TextBlock Text="Varsayılan olarak kanal listesi önbellekten yüklenir. Kaynaktan yeniden çekmek için aşağıdaki butonu kullanın."
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,12"/>

                                    <Button Content="Şimdi Yenile"
                                            Command="{Binding RefreshChannelListNowCommand}"
                                            IsEnabled="{Binding !_mainViewModel.IsGlobalLoading}"
                                            HorizontalAlignment="Left"
                                            Padding="20,10"
                                            Margin="0,0,0,20"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Kanal Sayısı" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalChannels}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Son Yenileme" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ChannelListLastUpdated, StringFormat='{}{0:dd.MM.yyyy HH:mm}', TargetNullValue='-'}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Grid>

                                    <!-- Hata göstergesi (EPG ile aynı tasarım) -->
                                    <Border Background="{DynamicResource Surface1Brush}"
                                            BorderBrush="{DynamicResource ErrorBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,0,0,16"
                                            IsVisible="{Binding ChannelListLastError, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ChannelListLastError}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Border>

                                    <TextBlock Text="Yenileme Sıklığı" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}"
                                              SelectedIndex="{Binding ChannelListRefreshFrequencyIndex, Mode=TwoWay}"
                                              Width="200"
                                              HorizontalAlignment="Left">
                                        <ComboBoxItem Content="Kapalı (Sadece manuel)" Tag="0"/>
                                        <ComboBoxItem Tag="1" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 1 saat" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="3" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 3 saat" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="12" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 12 saat" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="24" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 24 saat" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="48" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 2 günde" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="72" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 3 günde" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="168" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 7 günde" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- EPG TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="CalendarClock" Width="20" Height="20" />                            <TextBlock Text="EPG" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,100">
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <Grid HorizontalAlignment="Stretch" Margin="0,0,0,20">
                                        <TextBlock Text="EPG Yenileme" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch IsChecked="{Binding EpgEnabled}" 
                                                      Content="Etkinleştirildi" 
                                                      OnContent="Açık" 
                                                      OffContent="Kapalı"
                                                      HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Program Sayısı" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalEpgPrograms}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Son Yenileme" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding LastEpgUpdate, StringFormat='{}{0:dd.MM.yyyy HH:mm}', TargetNullValue='-'}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Grid>

                                    <Border Background="{DynamicResource Surface1Brush}"
                                            BorderBrush="{DynamicResource ErrorBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,0,0,16"
                                            IsVisible="{Binding EpgLastError, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="{Binding EpgLastError}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Border>

                                    <Button Content="EPG'yi Şimdi Yenile"
                                            Command="{Binding RefreshEpgNowCommand}"
                                            IsEnabled="{Binding !_mainViewModel.IsGlobalLoading}"
                                            HorizontalAlignment="Left"
                                            Padding="20,10"
                                            Margin="0,0,0,20"/>

                                    <TextBlock Text="Yenileme Sıklığı" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}"
                                              SelectedIndex="{Binding EpgRefreshFrequencyIndex, Mode=TwoWay}"
                                              Width="200"
                                              HorizontalAlignment="Left"
                                              Margin="0,0,0,20">
                                        <ComboBoxItem Content="Kapalı (Sadece manuel)" Tag="0"/>
                                        <ComboBoxItem Tag="1" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 1 saat" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="3" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 3 saat" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="12" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 12 saat" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="24" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 24 saat" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="48" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 2 günde" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="72" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 3 günde" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="168" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto" Width="175">
                                                <TextBlock Text="Her 7 günde" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                    </ComboBox>

                                    <TextBlock Text="EPG Saat Dilimi" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <ComboBox SelectedIndex="{Binding EpgTimeOffsetIndex, Mode=TwoWay}" Theme="{StaticResource ModernComboBox}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,20">
                                        <ComboBoxItem Content="-12 saat"/>
                                        <ComboBoxItem Content="-11 saat"/>
                                        <ComboBoxItem Content="-10 saat"/>
                                        <ComboBoxItem Content="-9 saat"/>
                                        <ComboBoxItem Content="-8 saat"/>
                                        <ComboBoxItem Content="-7 saat"/>
                                        <ComboBoxItem Content="-6 saat"/>
                                        <ComboBoxItem Content="-5 saat"/>
                                        <ComboBoxItem Content="-4 saat"/>
                                        <ComboBoxItem Content="-3 saat"/>
                                        <ComboBoxItem Content="-2 saat"/>
                                        <ComboBoxItem Content="-1 saat"/>
                                        <ComboBoxItem Content="0 (Otomatik)"/>
                                        <ComboBoxItem Content="+1 saat"/>
                                        <ComboBoxItem Content="+2 saat"/>
                                        <ComboBoxItem Content="+3 saat"/>
                                        <ComboBoxItem Content="+4 saat"/>
                                        <ComboBoxItem Content="+5 saat"/>
                                        <ComboBoxItem Content="+6 saat"/>
                                        <ComboBoxItem Content="+7 saat"/>
                                        <ComboBoxItem Content="+8 saat"/>
                                        <ComboBoxItem Content="+9 saat"/>
                                        <ComboBoxItem Content="+10 saat"/>
                                        <ComboBoxItem Content="+11 saat"/>
                                        <ComboBoxItem Content="+12 saat"/>
                                    </ComboBox>

                                    <TextBlock Text="Özel EPG URL (Opsiyonel)" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                                        <TextBox Grid.Column="0" Text="{Binding CustomEpgUrl, Mode=TwoWay}"
                                                 Watermark="https://.../epg.xml veya .xml.gz"
                                                 Padding="12"/>
                                        <Button Grid.Column="1" Content="Şimdi Yenile" 
                                                Command="{Binding RefreshEpgNowCommand}"
                                                IsEnabled="{Binding !_mainViewModel.IsGlobalLoading}"
                                                Theme="{StaticResource FilterButtonStyle}"
                                                Margin="10,0,0,0"
                                                Height="45"
                                                VerticalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- NOTIFICATIONS TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="BellOutline" Width="20" Height="20" />
                            <TextBlock Text="Bildirimler" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,100">
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="Uygulama Bildirimleri" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="İndirme Bildirimleri" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="İndirme tamamlandığında masaüstü bildirimi göster" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowDownloadNotification}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- PRIVACY TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="ShieldAccountOutline" Width="20" Height="20" />
                            <TextBlock Text="Gizlilik" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,100">
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="İzleme Geçmişi" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Geçmişi Kaydet" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="İzlediğiniz içerikleri geçmişe ekler" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SaveWatchHistory}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Çıkışta Geçmişi Temizle" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Uygulama kapandığında tüm geçmişi siler" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ClearHistoryOnExit}"/>
                                    </Grid>

                                    <TextBlock Text="Geçmişi Tutma Süresi" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}"
                                              SelectedIndex="{Binding WatchHistoryRetentionIndex}"
                                              Width="260"
                                              HorizontalAlignment="Left"
                                              Margin="0,0,0,20">
                                        <ComboBoxItem Content="Süresiz (Her zaman tut)"/>
                                        <ComboBoxItem Content="3 Gün"/>
                                        <ComboBoxItem Content="7 Gün"/>
                                        <ComboBoxItem Content="14 Gün"/>
                                        <ComboBoxItem Content="30 Gün"/>
                                    </ComboBox>

                                    <Separator Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,20"/>

                                    <TextBlock Text="Tehlikeli Bölge" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,12"/>
                                    <Button Content="Tüm İzleme Geçmişini Şimdi Sil" 
                                            Command="{Binding ClearHistoryCommand}"
                                            Classes="ErrorButton"
                                            Padding="16,10"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- APPEARANCE TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="BrushVariant" Width="20" Height="20" />
                            <TextBlock Text="Görünüm" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,100">
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="Kişiselleştirme" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>

                                    <!-- Theme Selection -->
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Tema" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Uygulamanın renklerini değiştirin" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Theme Options -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <!-- Dark Theme Button -->
                                            <Border x:Name="DarkThemeButton" Width="130" Height="85" CornerRadius="10" BorderThickness="3" BorderBrush="Transparent" Cursor="Hand" PointerPressed="DarkTheme_PointerPressed" Margin="0,0,16,0">
                                                <Grid>
                                                    <Border Background="{DynamicResource ThemePreviewDarkBg}" CornerRadius="7">
                                                        <Grid>
                                                            <Border Background="{DynamicResource ThemePreviewDarkInnerBg}" Width="95" Height="50" CornerRadius="6" Margin="12">
                                                                <StackPanel Margin="10,8">
                                                                    <Rectangle Fill="White" Height="4" Width="40" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                                                    <Rectangle Fill="{DynamicResource ThemePreviewDarkText}" Height="3" Width="55" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                                    <Rectangle Fill="{DynamicResource ThemePreviewDarkText}" Height="3" Width="45" HorizontalAlignment="Left"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="DarkCheckmark" Width="22" Height="22" Background="{DynamicResource AccentBrush}" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                                                <Path Data="M9,16.2L4.8,12l-1.4,1.4L9,19L21,7l-1.4-1.4L9,16.2z" Fill="White" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="Koyu" FontSize="12" Foreground="{DynamicResource ThemePreviewDarkLabelBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                                </Grid>
                                            </Border>

                                            <!-- Light Theme Button -->
                                            <Border x:Name="LightThemeButton" Width="130" Height="85" CornerRadius="10" BorderThickness="3" BorderBrush="Transparent" Cursor="Hand" PointerPressed="LightTheme_PointerPressed">
                                                <Grid>
                                                    <Border Background="{DynamicResource ThemePreviewLightBg}" CornerRadius="7">
                                                        <Grid>
                                                            <Border Background="{DynamicResource ThemePreviewLightInnerBg}" Width="95" Height="50" CornerRadius="6" Margin="12">
                                                                <StackPanel Margin="10,8">
                                                                    <Rectangle Fill="{DynamicResource ThemePreviewDarkBg}" Height="4" Width="40" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                                                    <Rectangle Fill="{DynamicResource ThemePreviewLightText}" Height="3" Width="55" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                                    <Rectangle Fill="{DynamicResource ThemePreviewLightText}" Height="3" Width="45" HorizontalAlignment="Left"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="LightCheckmark" Width="22" Height="22" Background="{DynamicResource AccentBrush}" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" IsVisible="False">
                                                                <Path Data="M9,16.2L4.8,12l-1.4,1.4L9,19L21,7l-1.4-1.4L9,16.2z" Fill="White" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="Açık" FontSize="12" Foreground="{DynamicResource ThemePreviewLightLabelBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,24"/>

                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Uygulama Dili" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Arayüz dilini değiştirin" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <ComboBox Grid.Column="1"
                                                  Theme="{StaticResource ModernComboBox}"
                                                  SelectedValue="{Binding AppLanguage, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding Tag}"
                                                  Width="180">
                                            <ComboBoxItem Content="Türkçe" Tag="tr"/>
                                            <ComboBoxItem Content="English" Tag="en"/>
                                            <ComboBoxItem Content="Deutsch" Tag="de"/>
                                            <ComboBoxItem Content="Français" Tag="fr"/>
                                            <ComboBoxItem Content="Español" Tag="es"/>
                                        </ComboBox>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- ABOUT SECTION -->
                            <Panel Margin="0,0,0,16">
                                <!-- PREMIUM CARD -->
                                <Border Background="{DynamicResource PrimaryGradientBrush}" 
                                        CornerRadius="12" 
                                        Padding="1.5"
                                        IsVisible="{Binding IsPremium}">
                                    <Border Background="{DynamicResource Bg1Brush}" 
                                            CornerRadius="10.5" 
                                            Padding="24"
                                            ClipToBounds="True">
                                        <Panel>
                                            <!-- Crown Icon (Top Right Background) -->
                                            <materialIcons:MaterialIcon Kind="Crown" 
                                                                      Width="140" Height="140" 
                                                                      Foreground="#f5c842" 
                                                                      Opacity="0.05"
                                                                      HorizontalAlignment="Right" 
                                                                      VerticalAlignment="Top"
                                                                      Margin="0,-40,-40,0"/>

                                            <Grid ColumnDefinitions="Auto,*">
                                                <!-- App Icon -->
                                                <Border Width="64" Height="64"
                                                        Background="{DynamicResource PrimaryGradientBrush}"
                                                        CornerRadius="12"
                                                        Margin="0,0,20,0">
                                                    <TextBlock Text="TV" FontSize="32" FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="Noctra" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        
                                                        <!-- PREMIUM BADGE -->
                                                        <Border Padding="10,3" CornerRadius="6" VerticalAlignment="Center">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                                    <GradientStop Color="#f5c842" Offset="0"/>
                                                                    <GradientStop Color="#f0a832" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <TextBlock Text="PREMIUM" FontSize="11" FontWeight="ExtraBold" Foreground="Black"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CurrentVersion, StringFormat='Sürüm {0} (Noctra Suite)'}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Panel>
                                    </Border>
                                </Border>

                                <!-- FREE CARD (Standard Refined) -->
                                <Border Background="{DynamicResource Surface0Brush}" 
                                        CornerRadius="12" 
                                        Padding="24"
                                        IsVisible="{Binding !IsPremium}"
                                        Margin="0">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- App Icon -->
                                            <Border Width="64" Height="64" 
                                                    Background="{DynamicResource PrimaryGradientBrush}" 
                                                    CornerRadius="12" 
                                                    Margin="0,0,20,0">
                                                <TextBlock Text="TV" FontSize="32" 
                                                           FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- App Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Noctra" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding CurrentVersion, StringFormat='Sürüm {0}'}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- UPGRADE BUTTON -->
                                            <Button Grid.Column="2" 
                                                    Command="{Binding ShowUpsellCommand}"
                                                    Padding="16,8"
                                                    Background="{DynamicResource PrimaryGradientBrush}"
                                                    Foreground="White"
                                                    CornerRadius="20"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <materialIcons:MaterialIcon Kind="Crown" Width="16" Height="16"/>
                                                    <TextBlock Text="Premium'a Geç" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Panel>

                            <!-- UPDATE SECTION (Separate Box) -->
                            <Border Classes="SettingsCard" Padding="16,12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="Update" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="Uygulama Güncellemesi" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding UpdateStatusText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    
                                    <!-- Update Actions -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding CheckForUpdatesCommand}"
                                                Padding="14,6"
                                                Background="{DynamicResource Surface1Brush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                CornerRadius="6"
                                                Cursor="Hand"
                                                IsVisible="{Binding !IsUpdateAvailable}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" IsVisible="{Binding !IsCheckingUpdates}"/>
                                                <ProgressBar IsIndeterminate="True" Width="14" Height="14" Margin="0" IsVisible="{Binding IsCheckingUpdates}" Theme="{StaticResource FluentProgressBar}"/>
                                                <TextBlock Text="Güncelleştirmeleri Denetle" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                        
                                        <Button Command="{Binding StartUpdateCommand}"
                                                Background="{DynamicResource AccentBrush}"
                                                Foreground="White"
                                                Padding="16,8"
                                                CornerRadius="6"
                                                Cursor="Hand"
                                                IsVisible="{Binding IsUpdateAvailable}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <materialIcons:MaterialIcon Kind="Download" Width="16" Height="16"/>
                                                <TextBlock Text="Şimdi Güncelle" FontWeight="Bold" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- FOOTER -->
            <Border Grid.Row="2" Padding="32,16" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,16,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Varsayılanlara Sıfırla" Command="{Binding ResetToDefaultsCommand}" 
                                HorizontalAlignment="Left" Padding="20,10"/>
                        
                        <Button Command="{Binding ReportBugCommand}" 
                                Background="Transparent" BorderBrush="#E50914" BorderThickness="1" 
                                Padding="16,10" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="BugOutline" Width="18" Height="18" Foreground="#E50914"/>
                                <TextBlock Text="Hata Bildir" Foreground="#E50914" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,20,0" FontWeight="SemiBold"/>
                        <Button Content="Ayarları Kaydet" Command="{Binding SaveSettingsCommand}" 
                                Padding="32,12" FontSize="15"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Global Loading Overlay -->
            <Grid Grid.RowSpan="3" Background="#AA000000" IsVisible="{Binding IsGlobalLoading}" ZIndex="10000">
                <Border Background="{DynamicResource Bg1Brush}" 
                        CornerRadius="16" 
                        Padding="32" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        BoxShadow="0 10 30 5 #80000000">
                    <StackPanel Spacing="24">
                        <controls:PremiumSpinner Width="80" Height="80">
                            <Path Data="M 30,60 L 45,45 C 50,40 60,40 65,45 L 90,70 C 95,75 95,85 90,90 L 65,115 C 60,120 50,120 45,115 L 30,100 Z" 
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                                  Width="40" Height="40"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </controls:PremiumSpinner>
                        <TextBlock Text="{Binding GlobalLoadingMessage}" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>

</Window>
