<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:controls="using:Noctra.Avalonia.Controls"
        xmlns:behaviors="using:Noctra.Avalonia.Behaviors"
        xmlns:loc="using:Noctra.Avalonia.Localization"
        mc:Ignorable="d"
        x:Class="Noctra.Avalonia.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        x:CompileBindings="False"
        Title="{loc:Translate Settings.Title}" Height="750" Width="850"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        WindowDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
>

    <Window.Resources>
    </Window.Resources>

    <Window.Styles>
        <!-- Close Button Style -->
        <Style Selector="Button.CloseButtonStyle">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="CloseBg" Background="{TemplateBinding Background}" CornerRadius="12">
                        <materialIcons:MaterialIcon x:Name="CloseIcon" Kind="Close" Width="24" Height="24"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ Border#CloseBg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ materialIcons|MaterialIcon#CloseIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Settings Tab Item Style -->
        <Style Selector="TabItem.SettingsTab">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border x:Name="HoverBackground" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Opacity="0"
                                Margin="2,4"/>
                        
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_HeaderPresenter" 
                                              Content="{TemplateBinding Header}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <!-- Selection Indicator -->
                        <Border x:Name="SelectionIndicator" 
                                Height="3" 
                                Width="20" 
                                Background="{DynamicResource AccentBrush}" 
                                VerticalAlignment="Bottom" 
                                HorizontalAlignment="Center"
                                CornerRadius="1.5"
                                Margin="0,0,0,2"
                                IsVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="TabItem.SettingsTab:selected">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TabItem.SettingsTab:selected /template/ Border#SelectionIndicator">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="TabItem.SettingsTab:pointerover /template/ Border#HoverBackground">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="TabItem.SettingsTab:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Rotating Icon Animation -->
        <Style Selector="materialIcons|MaterialIcon.Rotating">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Settings Card Style -->
        <Style Selector="Border.SettingsCard">
            <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Flat Expander Style for Settings -->
        <Style Selector="Expander.FlatExpander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander.FlatExpander /template/ ToggleButton#ExpanderHeader, Expander.FlatExpander:down /template/ ToggleButton#ExpanderHeader, Expander.FlatExpander:up /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander.FlatExpander /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Expander.FlatExpander /template/ ToggleButton#ExpanderHeader:pressed">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Expander.FlatExpander /template/ ToggleButton#ExpanderHeader /template/ ContentPresenter#PART_ContentPresenter, Expander.FlatExpander /template/ ToggleButton#ExpanderHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Expander.FlatExpander /template/ Border#ExpanderContent, Expander.FlatExpander:down /template/ Border#ExpanderContent, Expander.FlatExpander:up /template/ Border#ExpanderContent, Expander.FlatExpander:left /template/ Border#ExpanderContent, Expander.FlatExpander:right /template/ Border#ExpanderContent">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="24,0,24,24"/>
        </Style>
        <Style Selector="Expander.FlatExpander /template/ Border#PART_ContentBorder">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource BackgroundGradientBrush}" 
            CornerRadius="8" 
            ClipToBounds="True"
            Margin="1"
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0"
                  Margin="32,24,32,12"
                  Background="Transparent"
                  PointerPressed="Header_PointerPressed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Translate Settings.Title}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <Button HorizontalAlignment="Right" Click="CloseButton_Click"
                        Classes="CloseButtonStyle" ToolTip.Tip="{loc:Translate Settings.Close.Tooltip}"/>
            </Grid>

            <!-- CONTENT -->
            <TabControl behaviors:TabSlideTransitionBehavior.IsEnabled="True" ClipToBounds="True" Grid.Row="1" Margin="32,0,0,0" Background="Transparent" Padding="0">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
                
                <!-- PROFILE TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="AccountBoxOutline" Width="20" Height="20" />
                            <TextBlock Text="{loc:Translate Settings.Nav.Profile}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,20">
                            
                            <!-- Current Profile Card -->
                            <Border Classes="SettingsCard">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Avatar -->
                                    <Border Width="80" Height="80" CornerRadius="8" Margin="0,0,24,0" 
                                            Background="{DynamicResource PrimaryGradientBrush}"
                                            ClipToBounds="True">
                                        <Border CornerRadius="8" RenderOptions.BitmapInterpolationMode="HighQuality">
                                            <Border.Background>
                                                <ImageBrush Source="{Binding CurrentProfileAvatar, Converter={StaticResource AvatarPathConverter}}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentProfileName}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{loc:Translate Settings.Profile.ActiveProfile}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text=" • " FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding ProfileCreatedAt, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Profile.CreatedAtFormat'}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Settings.Profile.Management}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <TextBlock Text="{loc:Translate Settings.Profile.ManagementDetail}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,14"/>
                                    <Button Content="{loc:Translate Settings.Profile.BackToProfiles}"
                                            Click="BackToProfiles_Click"
                                            Theme="{StaticResource SettingsActionButton}"/>
                                </StackPanel>
                            </Border>

                            <!-- Subscription Details -->
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Settings.Account.Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ProviderUrlLabel}" FontSize="15" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="{Binding ProviderUrl}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="96"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16" IsVisible="{Binding ShowProviderIdentity}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ProviderIdentityLabel}" FontSize="15" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding ProviderUsername}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16" IsVisible="{Binding ShowProviderPassword}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Translate Settings.Account.Password}" FontSize="15" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="{Binding ProviderPassword}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="64"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Grid>
                                    
                                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,4,0,16" IsVisible="{Binding ShowProviderExpiration}"/>

                                    <Grid IsVisible="{Binding ShowProviderExpiration}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Translate Settings.Account.Expiry}" FontSize="15" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding ExpirationDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Account.ExpiryFormat', TargetNullValue='{loc:Translate Settings.Account.NoInfo}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding ExpirationStatus}" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                            </Border>
                            
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- PLAYBACK TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="PlayBoxOutline" Width="20" Height="20" />
                            <TextBlock Text="{loc:Translate Settings.Nav.Playback}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,100">

                            <!-- Ağ Ayarları -->
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Settings.Playback.Network}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Settings.Playback.UserAgent}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox Text="{Binding UserAgent, Mode=TwoWay}" PlaceholderText="VLC/3.0.x LibVLC/3.0.x" Padding="12" Margin="0,12,0,0" Theme="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Settings.Playback.AutoPlay}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Settings.Playback.AutoPlayNext}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{loc:Translate Settings.Playback.AutoPlayDescription}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoPlayNext}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Settings.Playback.Quality}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    <TextBlock Text="{loc:Translate Settings.Playback.QualityDescription}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}" SelectedIndex="{Binding SelectedDataUsage}" Width="250" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="{loc:Translate Settings.Playback.Quality.Low}"/>
                                        <ComboBoxItem Content="{loc:Translate Settings.Playback.Quality.Medium}"/>
                                        <ComboBoxItem Content="{loc:Translate Settings.Playback.Quality.High}"/>
                                        <ComboBoxItem Content="{loc:Translate Settings.Playback.Quality.Auto}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Settings.Playback.Buffer}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="{loc:Translate Settings.Playback.BufferDescription}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                                    <StackPanel Orientation="Horizontal" Spacing="24">
                                        <!-- Küçük (2sn) - PREMIUM -->
                                        <Grid VerticalAlignment="Center">
                                            <RadioButton Content="{loc:Translate Settings.Playback.Buffer.Small}" GroupName="Buffer"
                                                         IsChecked="{Binding IsBufferSmall}"
                                                         IsEnabled="{Binding IsPremium}"/>
                                            <!-- Lock icon positioned over the circle -->
                                            <materialIcons:MaterialIcon Kind="Lock" Width="18" Height="18" 
                                                                        Foreground="{DynamicResource TextMutedBrush}" 
                                                                        IsVisible="{Binding !IsPremium}" 
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                        Margin="3,0,0,0"
                                                                        IsHitTestVisible="False"/>
                                        </Grid>
                                        
                                        <!-- Normal (5sn) - FREE -->
                                        <RadioButton Content="{loc:Translate Settings.Playback.Buffer.Normal}" GroupName="Buffer"
                                                     IsChecked="{Binding IsBufferNormal}"/>

                                        <!-- Büyük (10sn) - PREMIUM -->
                                        <Grid VerticalAlignment="Center">
                                            <RadioButton Content="{loc:Translate Settings.Playback.Buffer.Large}" GroupName="Buffer"
                                                         IsChecked="{Binding IsBufferLarge}"
                                                         IsEnabled="{Binding IsPremium}"/>
                                            <!-- Lock icon positioned over the circle -->
                                            <materialIcons:MaterialIcon Kind="Lock" Width="18" Height="18" 
                                                                        Foreground="{DynamicResource TextMutedBrush}" 
                                                                        IsVisible="{Binding !IsPremium}" 
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                        Margin="3,0,0,0"
                                                                        IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Settings.Playback.AudioSubtitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Settings.Playback.SubtitlesAuto}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{loc:Translate Settings.Playback.SubtitlesAutoDescription}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SubtitleEnabled}"/>
                                    </Grid>

                                    <TextBlock Text="{loc:Translate Settings.Playback.PreferredSubtitle}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}" SelectedValue="{Binding SubtitleLanguage, Mode=TwoWay}" SelectedValueBinding="{Binding Tag}" Width="250" HorizontalAlignment="Left" Margin="0,0,0,18">
                                        <ComboBoxItem Content="Turkish" Tag="tr"/>
                                        <ComboBoxItem Content="English" Tag="en"/>
                                        <ComboBoxItem Content="Deutsch" Tag="de"/>
                                        <ComboBoxItem Content="Français" Tag="fr"/>
                                        <ComboBoxItem Content="Español" Tag="es"/>
                                        <ComboBoxItem Content="Italiano" Tag="it"/>
                                        <ComboBoxItem Content="Português" Tag="pt"/>
                                        <ComboBoxItem Content="Русский" Tag="ru"/>
                                        <ComboBoxItem Content="العربية" Tag="ar"/>
                                        <ComboBoxItem Content="Nederlands" Tag="nl"/>
                                    </ComboBox>

                                    <TextBlock Text="{loc:Translate Settings.Playback.PreferredAudio}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}" SelectedValue="{Binding PreferredAudioLanguage, Mode=TwoWay}" SelectedValueBinding="{Binding Tag}" Width="250" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="Turkish" Tag="tr"/>
                                        <ComboBoxItem Content="English" Tag="en"/>
                                        <ComboBoxItem Content="Deutsch" Tag="de"/>
                                        <ComboBoxItem Content="Français" Tag="fr"/>
                                        <ComboBoxItem Content="Español" Tag="es"/>
                                        <ComboBoxItem Content="Italiano" Tag="it"/>
                                        <ComboBoxItem Content="Português" Tag="pt"/>
                                        <ComboBoxItem Content="Русский" Tag="ru"/>
                                        <ComboBoxItem Content="العربية" Tag="ar"/>
                                        <ComboBoxItem Content="Nederlands" Tag="nl"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                        
                            <!-- Subtitle Section Removed -->
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Settings.Download.Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Settings.Download.WifiOnly}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{loc:Translate Settings.Download.WifiOnlyDescription}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding DownloadWifiOnly}"/>
                                    </Grid>
                                    <TextBlock Text="{loc:Translate Settings.Download.Quality}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}" SelectedIndex="{Binding SelectedDownloadQuality}" Width="250" HorizontalAlignment="Left" Margin="0,0,0,18">
                                        <ComboBoxItem Content="{loc:Translate Settings.Download.Quality.Standard}"/>
                                        <ComboBoxItem Content="{loc:Translate Settings.Download.Quality.High}"/>
                                    </ComboBox>
                                    <TextBlock Text="{loc:Translate Settings.Download.Path}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding DownloadPath}" IsReadOnly="True" Padding="12" Theme="{StaticResource ModernTextBox}"/>
                                        <Button Grid.Column="1" Content="{loc:Translate Settings.Download.Change}" Click="ChangeDownloadPath_Click" Margin="12,0,0,0" Padding="20,10"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- CHANNEL LIST TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FormatListBulletedSquare" Width="20" Height="20" />
                            <TextBlock Text="{loc:Translate Settings.Nav.Channels}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,100">
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Settings.Channels.Refresh}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    <TextBlock Text="{loc:Translate Settings.Channels.RefreshDescription}"
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,12"/>

                                    <Button Content="{loc:Translate Settings.Channels.RefreshNow}"
                                            Command="{Binding RefreshChannelListNowCommand}"
                                            IsEnabled="{Binding !_mainViewModel.IsGlobalLoading}"
                                            Theme="{StaticResource SettingsActionButton}"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Translate Settings.Channels.Count}" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalChannels}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Translate Settings.Channels.LastUpdate}" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ChannelListLastUpdated, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Channels.DateFormat', TargetNullValue='-'}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Grid>

                                    <!-- Hata göstergesi (EPG ile aynı tasarım) -->
                                    <Border Background="{DynamicResource Surface1Brush}"
                                            BorderBrush="{DynamicResource ErrorBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,0,0,16"
                                            IsVisible="{Binding ChannelListLastError, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ChannelListLastError}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Border>

                                    <TextBlock Text="{loc:Translate Settings.Channels.Frequency}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}"
                                              SelectedIndex="{Binding ChannelListRefreshFrequencyIndex, Mode=TwoWay}"
                                              Width="200"
                                              HorizontalAlignment="Left">
                                        <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.Off}" Tag="0"/>
                                        <ComboBoxItem Tag="1" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.1h}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="3" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.3h}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="12" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.12h}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="24" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.24h}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="48" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.2d}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="72" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.3d}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="168" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.7d}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Classes="SettingsCard" Padding="0">
                                <Expander Classes="FlatExpander" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,16,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Live}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Description}"
                                                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource Surface1Brush}" CornerRadius="4" Padding="12,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HiddenLiveGroups.Count, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Channels.Hidden.CountFormat'}" 
                                                           Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold" FontSize="11" LetterSpacing="3.5"/>
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <ScrollViewer MaxHeight="250">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding HiddenLiveGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Surface1Brush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                                <Button Grid.Column="1" 
                                                                        Theme="{StaticResource SettingsActionButton}"
                                                                        Command="{Binding $parent[Window].DataContext.UnhideGroupCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Padding="20,4" CornerRadius="4" Cursor="Hand">
                                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                                        <materialIcons:MaterialIcon Kind="EyeOutline" Width="16" Height="16"/>
                                                                        <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Show}" FontSize="14" FontWeight="Medium"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Empty.Live}"
                                                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" Margin="0,20"
                                                       IsVisible="{Binding !HiddenLiveGroups.Count}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Expander>
                            </Border>

                            <Border Classes="SettingsCard" Padding="0">
                                <Expander Classes="FlatExpander" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,16,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Movies}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Description}"
                                                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource Surface1Brush}" CornerRadius="4" Padding="12,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HiddenMovieGroups.Count, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Channels.Hidden.CountFormat'}" 
                                                           Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold" FontSize="11" LetterSpacing="3.5"/>
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <ScrollViewer MaxHeight="250">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding HiddenMovieGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Surface1Brush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                                <Button Grid.Column="1" 
                                                                        Theme="{StaticResource SettingsActionButton}"
                                                                        Command="{Binding $parent[Window].DataContext.UnhideGroupCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Padding="20,4" CornerRadius="4" Cursor="Hand">
                                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                                        <materialIcons:MaterialIcon Kind="EyeOutline" Width="16" Height="16"/>
                                                                        <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Show}" FontSize="14" FontWeight="Medium"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Empty.Movies}"
                                                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" Margin="0,20"
                                                       IsVisible="{Binding !HiddenMovieGroups.Count}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Expander>
                            </Border>

                            <Border Classes="SettingsCard" Padding="0">
                                <Expander Classes="FlatExpander" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,16,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Series}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Description}"
                                                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource Surface1Brush}" CornerRadius="4" Padding="12,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HiddenSeriesGroups.Count, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Channels.Hidden.CountFormat'}" 
                                                           Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold" FontSize="11" LetterSpacing="3.5"/>
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <ScrollViewer MaxHeight="250">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding HiddenSeriesGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Surface1Brush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                                <Button Grid.Column="1" 
                                                                        Theme="{StaticResource SettingsActionButton}"
                                                                        Command="{Binding $parent[Window].DataContext.UnhideGroupCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Padding="20,4" CornerRadius="4" Cursor="Hand">
                                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                                        <materialIcons:MaterialIcon Kind="EyeOutline" Width="16" Height="16"/>
                                                                        <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Show}" FontSize="14" FontWeight="Medium"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{loc:Translate Settings.Channels.Hidden.Empty.Series}"
                                                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" Margin="0,20"
                                                       IsVisible="{Binding !HiddenSeriesGroups.Count}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- EPG TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="CalendarClock" Width="20" Height="20" />                            <TextBlock Text="{loc:Translate Settings.Nav.Epg}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,100">
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <Grid HorizontalAlignment="Stretch" Margin="0,0,0,20">
                                        <TextBlock Text="{loc:Translate Settings.Epg.Refresh}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch IsChecked="{Binding EpgEnabled}" 
                                                      Content="{loc:Translate Settings.Epg.Enabled}" 
                                                      OnContent="{loc:Translate Settings.Epg.On}" 
                                                      OffContent="{loc:Translate Settings.Epg.Off}"
                                                      HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Translate Settings.Epg.Count}" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalEpgPrograms}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Translate Settings.Channels.LastUpdate}" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding LastEpgUpdate, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Channels.DateFormat', TargetNullValue='-'}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Grid>

                                    <Border Background="{DynamicResource Surface1Brush}"
                                            BorderBrush="{DynamicResource ErrorBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,0,0,16"
                                            IsVisible="{Binding EpgLastError, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="{Binding EpgLastError}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Border>

                                    <Button Content="{loc:Translate Settings.Epg.RefreshNow}"
                                            Command="{Binding RefreshEpgNowCommand}"
                                            IsEnabled="{Binding !_mainViewModel.IsGlobalLoading}"
                                            Theme="{StaticResource SettingsActionButton}"/>

                                    <TextBlock Text="{loc:Translate Settings.Channels.Frequency}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}"
                                              SelectedIndex="{Binding EpgRefreshFrequencyIndex, Mode=TwoWay}"
                                              Width="200"
                                              HorizontalAlignment="Left"
                                              Margin="0,0,0,20">
                                        <ComboBoxItem Content="{loc:Translate Settings.Channels.Frequency.Off}" Tag="0"/>
                                        <ComboBoxItem Tag="1" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.1h}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="3" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.3h}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="12" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.12h}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="24" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.24h}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="48" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.2d}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="72" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.3d}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="168" IsEnabled="{Binding IsPremium}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{loc:Translate Settings.Channels.Frequency.7d}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Lock" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPremium}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ComboBoxItem>
                                    </ComboBox>

                                    <TextBlock Text="{loc:Translate Settings.Epg.Timezone}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <ComboBox SelectedIndex="{Binding EpgTimeOffsetIndex, Mode=TwoWay}" Theme="{StaticResource ModernComboBox}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,20">
                                        <ComboBoxItem Content="{Binding Source=-12, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}"/>
                                        <ComboBoxItem Content="{Binding Source=-11, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}"/>
                                        <ComboBoxItem Content="{Binding Source=-10, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}"/>
                                        <ComboBoxItem Content="{Binding Source=-9, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}"/>
                                        <ComboBoxItem Content="{Binding Source=-8, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}"/>
                                        <ComboBoxItem Content="{Binding Source=-7, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}"/>
                                        <ComboBoxItem Content="{Binding Source=-6, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}"/>
                                        <ComboBoxItem Content="{Binding Source=-5, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}"/>
                                        <ComboBoxItem Content="{Binding Source=-4, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}"/>
                                        <ComboBoxItem Content="{Binding Source=-3, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}"/>
                                        <ComboBoxItem Content="{Binding Source=-2, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}"/>
                                        <ComboBoxItem Content="{Binding Source=-1, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Negative'}"/>
                                        <ComboBoxItem Content="{loc:Translate Settings.Epg.Timezone.Auto}"/>
                                        <ComboBoxItem Content="{Binding Source=1, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}"/>
                                        <ComboBoxItem Content="{Binding Source=2, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}"/>
                                        <ComboBoxItem Content="{Binding Source=3, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}"/>
                                        <ComboBoxItem Content="{Binding Source=4, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}"/>
                                        <ComboBoxItem Content="{Binding Source=5, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}"/>
                                        <ComboBoxItem Content="{Binding Source=6, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}"/>
                                        <ComboBoxItem Content="{Binding Source=7, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}"/>
                                        <ComboBoxItem Content="{Binding Source=8, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}"/>
                                        <ComboBoxItem Content="{Binding Source=9, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}"/>
                                        <ComboBoxItem Content="{Binding Source=10, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}"/>
                                        <ComboBoxItem Content="{Binding Source=11, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}"/>
                                        <ComboBoxItem Content="{Binding Source=12, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.Timezone.Format.Positive'}"/>
                                    </ComboBox>

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Translate Settings.Epg.CustomSources}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding CustomEpgUrls.Count, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.Epg.SourcesCountFormat'}" 
                                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" 
                                                Theme="{StaticResource SettingsActionButton}"
                                                Command="{Binding AddCustomEpgCommand}"
                                                IsEnabled="{Binding !_mainViewModel.IsGlobalLoading}"
                                                Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18"/>
                                                <TextBlock Text="{loc:Translate Settings.Epg.AddNew}" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Performans uyarısı -->
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="8">
                                            <materialIcons:MaterialIcon Kind="AlertCircleOutline" Grid.Column="0" Width="16" Height="16" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{loc:Translate Settings.Epg.PerformanceWarning}"
                                                       TextWrapping="Wrap" FontSize="{DynamicResource FCaption}" Foreground="{DynamicResource WarningBrush}"/>
                                    </Grid>
                                    
                                    <ItemsControl ItemsSource="{Binding CustomEpgUrls}" Margin="0,0,0,20">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                    <TextBox Text="{Binding Url, Mode=TwoWay}"
                                                             PlaceholderText="{loc:Translate Settings.Epg.UrlPlaceholder}"
                                                             Padding="12"
                                                             Height="45"
                                                             VerticalContentAlignment="Center"
                                                             Theme="{StaticResource ModernTextBox}"/>
                                                    <Button Grid.Column="1" 
                                                            Theme="{StaticResource SettingsActionButton}"
                                                            Command="{Binding $parent[Window].DataContext.RemoveCustomEpgCommand}"
                                                            CommandParameter="{Binding .}"
                                                            Margin="10,0,0,0"
                                                            BorderThickness="1.5"
                                                            ToolTip.Tip="{loc:Translate Settings.Epg.RemoveSource.Tooltip}">
                                                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="20" Height="20" Foreground="{DynamicResource ErrorBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- En altta tek bir yenile butonu (opsiyonel ama kullanıcı eski haliyle alarak olabilir) -->
                                     <!-- Tüm EPG Kaynaklarını Yenile -->
                                     <Button Command="{Binding RefreshEpgNowCommand}"
                                             IsEnabled="{Binding !_mainViewModel.IsGlobalLoading}"
                                             Theme="{StaticResource SettingsActionButton}"
                                             Cursor="Hand">
                                         <StackPanel Orientation="Horizontal" Spacing="10">
                                             <materialIcons:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                                             <TextBlock Text="{loc:Translate Settings.Epg.RefreshAllNow}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                         </StackPanel>
                                     </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- NOTIFICATIONS TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="BellOutline" Width="20" Height="20" />
                            <TextBlock Text="{loc:Translate Settings.Nav.Notifications}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,100">
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Settings.Notifications.AppTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Settings.Notifications.Download}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{loc:Translate Settings.Notifications.DownloadDescription}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowDownloadNotification}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- PRIVACY TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="ShieldAccountOutline" Width="20" Height="20" />
                            <TextBlock Text="{loc:Translate Settings.Nav.Privacy}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,100">
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Settings.Privacy.History}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                    
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Settings.Privacy.SaveHistory}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{loc:Translate Settings.Privacy.SaveHistoryDescription}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SaveWatchHistory}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Settings.Privacy.ClearOnExit}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{loc:Translate Settings.Privacy.ClearOnExitDescription}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ClearHistoryOnExit}"/>
                                    </Grid>

                                    <TextBlock Text="{loc:Translate Settings.Privacy.Retention}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <ComboBox Theme="{StaticResource ModernComboBox}"
                                              SelectedIndex="{Binding WatchHistoryRetentionIndex}"
                                              Width="260"
                                              HorizontalAlignment="Left"
                                              Margin="0,0,0,20">
                                        <ComboBoxItem Content="{loc:Translate Settings.Privacy.Retention.Forever}"/>
                                        <ComboBoxItem Content="{loc:Translate Settings.Privacy.Retention.3d}"/>
                                        <ComboBoxItem Content="{loc:Translate Settings.Privacy.Retention.7d}"/>
                                        <ComboBoxItem Content="{loc:Translate Settings.Privacy.Retention.14d}"/>
                                        <ComboBoxItem Content="{loc:Translate Settings.Privacy.Retention.30d}"/>
                                    </ComboBox>

                                    <Separator Height="1" Background="{DynamicResource ErrorBrush}" Margin="0,10,0,10"/>

                                    <TextBlock Text="{loc:Translate Settings.Privacy.DangerZone}" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" LetterSpacing="3.5" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,24"/>
                                    <Button Content="{loc:Translate Settings.Privacy.ClearAllNow}" 
                                            Command="{Binding ClearHistoryCommand}"
                                            Theme="{StaticResource ErrorButton}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- APPEARANCE TAB -->
                <TabItem Classes="SettingsTab" Cursor="Hand">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="BrushVariant" Width="20" Height="20" />
                            <TextBlock Text="{loc:Translate Settings.Section.Appearance}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,32,0">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,100">
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Settings.Personalization.Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>

                                    <!-- Theme Selection -->
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Settings.Theme.Title}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{loc:Translate Settings.Theme.Description}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Theme Options -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <!-- Dark Theme Button -->
                                            <Border x:Name="DarkThemeButton" Width="130" Height="85" CornerRadius="4" BorderThickness="1.5" BorderBrush="Transparent" Cursor="Hand" PointerPressed="DarkTheme_PointerPressed" Margin="0,0,16,0">
                                                <Grid>
                                                    <Border Background="{DynamicResource ThemePreviewDarkBg}" CornerRadius="4">
                                                        <Grid>
                                                            <Border Background="{DynamicResource ThemePreviewDarkInnerBg}" Width="95" Height="50" CornerRadius="4" Margin="12">
                                                                <StackPanel Margin="10,8">
                                                                    <Rectangle Fill="White" Height="4" Width="40" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                                                    <Rectangle Fill="{DynamicResource ThemePreviewDarkText}" Height="3" Width="55" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                                    <Rectangle Fill="{DynamicResource ThemePreviewDarkText}" Height="3" Width="45" HorizontalAlignment="Left"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="DarkCheckmark" Width="24" Height="24" Background="{DynamicResource AccentBrush}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                                                <materialIcons:MaterialIcon Kind="Check" Foreground="White" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{loc:Translate Settings.Theme.Dark}" FontSize="12" Foreground="{DynamicResource ThemePreviewDarkLabelBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                                </Grid>
                                            </Border>

                                            <!-- Light Theme Button -->
                                            <Border x:Name="LightThemeButton" Width="130" Height="85" CornerRadius="4" BorderThickness="1.5" BorderBrush="Transparent" Cursor="Hand" PointerPressed="LightTheme_PointerPressed">
                                                <Grid>
                                                    <Border Background="{DynamicResource ThemePreviewLightBg}" CornerRadius="4">
                                                        <Grid>
                                                            <Border Background="{DynamicResource ThemePreviewLightInnerBg}" Width="95" Height="50" CornerRadius="6" Margin="12">
                                                                <StackPanel Margin="10,8">
                                                                    <Rectangle Fill="{DynamicResource ThemePreviewDarkBg}" Height="4" Width="40" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                                                    <Rectangle Fill="{DynamicResource ThemePreviewLightText}" Height="3" Width="55" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                                    <Rectangle Fill="{DynamicResource ThemePreviewLightText}" Height="3" Width="45" HorizontalAlignment="Left"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="LightCheckmark" Width="24" Height="24" Background="{DynamicResource AccentBrush}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" IsVisible="False">
                                                                <materialIcons:MaterialIcon Kind="Check" Foreground="White" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{loc:Translate Settings.Theme.Light}" FontSize="12" Foreground="{DynamicResource ThemePreviewLightLabelBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,24"/>

                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Settings.Language.Title}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{loc:Translate Settings.Language.Description}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <ComboBox Grid.Column="1"
                                                  Theme="{StaticResource ModernComboBox}"
                                                  SelectedValue="{Binding AppLanguage, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding Tag}"
                                                  Width="180">
                                            <ComboBoxItem Content="{loc:Translate Language.Turkish}" Tag="tr"/>
                                            <ComboBoxItem Content="{loc:Translate Language.English}" Tag="en"/>
                                            <ComboBoxItem Content="{loc:Translate Language.German}" Tag="de"/>
                                            <ComboBoxItem Content="{loc:Translate Language.French}" Tag="fr"/>
                                            <ComboBoxItem Content="{loc:Translate Language.Spanish}" Tag="es"/>
                                        </ComboBox>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- ABOUT SECTION -->
                            <Panel Margin="0,0,0,16">
                                <!-- PREMIUM CARD -->
                                <Border Background="{DynamicResource PremiumBadgeBrush}" 
                                        CornerRadius="8" 
                                        Padding="1.5"
                                        IsVisible="{Binding IsPremium}"
                                        Margin="0,0,0,24">
                                    <Border Background="{DynamicResource Bg1Brush}" 
                                            CornerRadius="8" 
                                            Padding="24"
                                            ClipToBounds="True">
                                        <Panel>
                                            <!-- Crown Icon (Top Right Background) -->
                                            <materialIcons:MaterialIcon Kind="Crown" 
                                                                    Width="140" Height="140" 
                                                                    Foreground="{DynamicResource PremiumBadgeTextBrush}" 
                                                                    Opacity="0.05"
                                                                    HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Top"
                                                                    Margin="320,0,0,55"/>

                                            <Grid ColumnDefinitions="Auto,*">
                                                <!-- App Icon -->
                                            <Image Source="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LogoThemeConverter}}"
                                                   Width="80"
                                                   Height="80"
                                                   Stretch="Uniform"
                                                   Margin="0,0,20,0"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="Noctra" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PremiumBadgeTextBrush}"/>
                                                        
                                                        <!-- PREMIUM BADGE -->
                                                        <Border Padding="10,3" 
                                                                CornerRadius="3"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource PremiumBadgeBrush}">
                                                            <TextBlock Text="PREMIUM" 
                                                                    FontSize="11" 
                                                                    FontWeight="ExtraBold" 
                                                                    Foreground="{DynamicResource PremiumBadgeTextBrush}"/>
                                                    </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CurrentVersion, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.About.PremiumVersionFormat'}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- PREM SEPARATOR -->
                                        <Border Height="1.5" Margin="0,24,0,20">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0.4"/>
                                                    <GradientStop Color="#f5c842" Offset="0.7"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        </Panel>
                                    </Border>
                                </Border>

                                <!-- FREE CARD (Standard Refined) -->
                                <Border Background="{DynamicResource Surface0Brush}" 
                                        CornerRadius="8" 
                                        Padding="24"
                                        IsVisible="{Binding !IsPremium}"
                                        Margin="0">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- App Icon -->
                                    <Image Source="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LogoThemeConverter}, ConverterParameter=Full}"
                                           Width="80"
                                           Height="80"
                                           Stretch="Uniform"
                                           Margin="0,0,20,0"/>

                                            <!-- App Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Noctra" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding CurrentVersion, Converter={StaticResource StringFormatConverter}, ConverterParameter='Settings.About.VersionFormat'}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Panel>
                            <!-- Upgrade to Premium Banner (shown when not premium, placed after Account card) -->
                            <Button Theme="{StaticResource UpgradeButton}"
                                    Command="{Binding ShowUpsellCommand}"
                                    IsVisible="{Binding !IsPremium}">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="12">
                                <materialIcons:MaterialIcon Kind="Crown"
                                                            Width="32"
                                                            Height="32"
                                                            Foreground="{DynamicResource PremiumBadgeTextBrush}"
                                                            VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Text="{loc:Translate GlobalSettings.About.Upgrade}"
                                            Foreground="{DynamicResource PremiumBadgeTextBrush}"
                                            FontWeight="SemiBold"
                                            FontSize="{DynamicResource FBody}" />
                                    <TextBlock Text="{loc:Translate Upsell.Headline}"
                                            Foreground="{DynamicResource PremiumBadgeTextBrush}"
                                            FontSize="{DynamicResource FCaption}" />
                                </StackPanel>
                                </Grid>
                            </Button>
                            <!-- UPDATE SECTION (Enhanced Modern Card) -->
                            <Border Background="{DynamicResource Surface0Brush}" 
                                    CornerRadius="8" 
                                    Padding="20,16" 
                                    Margin="0,0,0,16">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Status Icon -->
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="{DynamicResource Surface1Brush}" Margin="0,0,16,0">
                                        <materialIcons:MaterialIcon Kind="Update" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{loc:Translate Settings.Update.Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    
                                    <!-- Action Area -->
                                    <Panel Grid.Column="2">
                                        <!-- Checking State -->
                                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="False">
                                            <materialIcons:MaterialIcon Kind="Refresh" Width="18" Height="18" Classes="Rotating" Foreground="{DynamicResource AccentBrush}">
                                                <materialIcons:MaterialIcon.RenderTransform>
                                                    <RotateTransform />
                                                </materialIcons:MaterialIcon.RenderTransform>
                                            </materialIcons:MaterialIcon>
                                            <TextBlock Text="{loc:Translate Settings.Update.Checking}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>

                                        <!-- Idle State -->
                                        <Button Command="{Binding CheckForUpdatesCommand}"
                                                IsVisible="True"
                                                Theme="{StaticResource SettingsActionButton}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                                                <TextBlock Text="{loc:Translate Settings.Update.CheckNow}" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                        
                                        <!-- Update Available State -->
                                        <Button Command="{Binding CheckForUpdatesCommand}"
                                                IsVisible="False"
                                                Background="{DynamicResource AccentBrush}"
                                                Foreground="White"
                                                Padding="18,9"
                                                CornerRadius="8"
                                                Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <materialIcons:MaterialIcon Kind="RocketLaunch" Width="18" Height="18"/>
                                                <TextBlock Text="{loc:Translate Settings.Update.UpdateNow}" FontWeight="Bold" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                    </Panel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- FOOTER -->
            <Border Grid.Row="2" Padding="32,16" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,8,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Left Actions -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <Button Content="{loc:Translate Settings.Action.ResetDefaults}" Command="{Binding ResetToDefaultsCommand}" 
                                Theme="{StaticResource SettingsActionButton}" HorizontalAlignment="Left" Padding="12,8"/>
                        
                        <Button Command="{Binding ReportBugCommand}" 
                                Theme="{StaticResource ErrorButton}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="BugOutline" Width="18" Height="18"/>
                                <TextBlock Text="{loc:Translate Settings.Action.ReportBug}" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Status Message (Center) -->
                    <TextBlock Grid.Column="1" 
                               Text="{Binding StatusMessage}" 
                               Foreground="{DynamicResource AccentBrush}" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="20,0" 
                               FontWeight="SemiBold"/>
                    
                    <!-- Save Button (Right) -->
                    <Button Grid.Column="2" 
                            Content="{loc:Translate Settings.Action.SaveSettings}" 
                            Command="{Binding SaveSettingsCommand}" 
                            Theme="{StaticResource PrimaryButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Global Loading Overlay -->
            <Grid Grid.RowSpan="3" Background="#AA000000" IsVisible="{Binding IsGlobalLoading}" ZIndex="10000">
                <Border Background="{DynamicResource Bg1Brush}" 
                        CornerRadius="6" 
                        Padding="64,32" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        BoxShadow="0 10 30 5 #80000000">
                    <StackPanel Spacing="24">
                        <controls:PremiumSpinner Width="80" Height="80">
                        <Image Source="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LogoThemeConverter}}"
                               Width="60" Height="60"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   RenderTransformOrigin="50%,50%">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Image.RenderTransform>
                                <Image.Styles>
                                    <Style Selector="Image">
                                        <Style.Animations>
                                            <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="CubicEaseInOut">
                                                <KeyFrame Cue="0%">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                                                    <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                                                </KeyFrame>
                                                <KeyFrame Cue="50%">
                                                    <Setter Property="Opacity" Value="1.0"/>
                                                    <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                                                    <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                                                </KeyFrame>
                                                <KeyFrame Cue="100%">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                                                    <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                                                </KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Image.Styles>
                            </Image>
                        </controls:PremiumSpinner>
                        <TextBlock Text="{loc:Translate Common.Loading}" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <Button Command="{Binding CancelRefreshOperationCommand}"
                                HorizontalAlignment="Center"
                                Padding="18,9"
                                Theme="{StaticResource SettingsActionButton}"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{loc:Translate Dialog.Cancel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>

</Window>
