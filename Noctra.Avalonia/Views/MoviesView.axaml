<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:views="using:Noctra.Avalonia.Views"
             xmlns:loc="using:Noctra.Avalonia.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             x:Class="Noctra.Avalonia.Views.MoviesView"
             x:CompileBindings="False">
  <Grid IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Movies}}">
    <Grid Margin="24,24,24,0" RowDefinitions="Auto,*" RowSpacing="{DynamicResource DesktopHeaderGap}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Text="{loc:Translate Movies.Title}" Classes="DesktopPageTitle" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding ShowContentFilters}">
          <Button x:Name="CategorySelectionButton" Classes="DesktopFilterButton"
                  IsVisible="{Binding ShowGroupFilter}" Click="OpenCategorySelection_Click">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock x:Name="CategorySelectionValue" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <icons:MaterialIcon Grid.Column="1" Kind="ChevronDown" Width="20" Height="20" />
            </Grid>
          </Button>
          <Button x:Name="SortSelectionButton" Classes="DesktopIconButton" Width="44" Height="44"
                  Click="OpenSortSelectionSheet_Click">
            <icons:MaterialIcon x:Name="SortSelectionIcon" Kind="Sort" Width="23" Height="23" />
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <controls:DesktopVirtualizingCardGrid CardKind="Vod"
            SourceItems="{Binding FilteredChannels}" IsVisible="{Binding !IsContentLoading}"
            ScrollChanged="MoviesView_ScrollChanged" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18"
                    IsVisible="{Binding IsContentLoading}">
          <controls:PremiumSpinner Width="56" Height="56" HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Translate Movies.Loading}" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" />
          <TextBlock Text="{loc:Translate Live.LoadingDetail}" FontSize="12" Opacity="0.65"
                     Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding ShowEmptyChannels}">
          <icons:MaterialIcon Kind="Filmstrip" Width="64" Height="64"
                              Foreground="{DynamicResource TextMutedBrush}" Opacity="0.5" />
          <TextBlock Text="{loc:Translate Movies.Empty.Title}" FontSize="20" FontWeight="SemiBold"
                     TextAlignment="Center" Margin="0,14,0,6" />
          <TextBlock Text="{loc:Translate Movies.Empty.Description}" FontSize="14"
                     Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
    <views:DesktopSelectionSheet x:Name="SelectionSheetHost" ZIndex="40000" />
    <views:DesktopCategorySelectionView x:Name="CategorySelectionHost" ZIndex="41000" />
  </Grid>
</UserControl>
