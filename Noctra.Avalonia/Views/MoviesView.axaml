<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:loc="using:Noctra.UI.Localization"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:views="using:Noctra.Avalonia.Views"
             xmlns:shared="using:Noctra.UI.Views"
             x:Class="Noctra.Avalonia.Views.MoviesView"
             x:CompileBindings="False">
  <Grid IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Movies}}">
    <shared:AdaptiveCatalogView x:Name="CatalogContent"
                                Title="{loc:Translate Movies.Title}"
                                LoadingText="{loc:Translate Movies.Loading}"
                                LoadingDetailText="{loc:Translate Live.LoadingDetail}"
                                EmptyTitle="{loc:Translate Movies.Empty.Title}"
                                EmptyDescription="{loc:Translate Movies.Empty.Description}"
                                EmptyIconKind="Filmstrip"
                                CategoryLabel="{loc:Translate Common.All}"
                                SortLabel="{loc:Translate Main.Sort.Title}"
                                ShowContentFilters="{Binding ShowContentFilters}"
                                ShowGroupFilter="{Binding ShowGroupFilter}"
                                IsLoading="{Binding IsContentLoading}"
                                ShowEmptyState="{Binding ShowEmptyChannels}"
                                SortRequested="OpenSortSelectionSheet_Click"
                                CategoryRequested="OpenCategorySelection_Click">
      <shared:AdaptiveCatalogView.ItemsHost>
        <controls:DesktopVirtualizingCardGrid x:Name="PrimaryScrollContent"
                                              CardKind="Vod"
                                              SourceItems="{Binding FilteredChannels}"
                                              ScrollChanged="MoviesView_ScrollChanged" />
      </shared:AdaptiveCatalogView.ItemsHost>
    </shared:AdaptiveCatalogView>
    <views:DesktopSelectionSheet x:Name="SelectionSheetHost" ZIndex="40000" />
    <views:DesktopCategorySelectionView x:Name="CategorySelectionHost" ZIndex="41000" />
  </Grid>
</UserControl>
