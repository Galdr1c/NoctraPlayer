<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Noctra.Avalonia.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Noctra.Avalonia.Views.PiPWindow"
        Title="Noctra PiP"
        Width="400" Height="225"
        MinWidth="280" MinHeight="158"
        SystemDecorations="None"
        Topmost="True"
        CanResize="True"
        ShowInTaskbar="False"
        Background="Black"
        mc:Ignorable="d">

    <Grid>
        <controls:MemoryVideoView x:Name="PiPVideoSurface">
            <controls:MemoryVideoView.OverlayContent>
                <!-- Sürükle alanı + kontroller -->
                <Grid x:Name="ControlsOverlay"
                      Background="Transparent"
                      PointerPressed="DragArea_PointerPressed"
                      PointerEntered="ControlsOverlay_PointerEntered"
                      PointerExited="ControlsOverlay_PointerExited"
                      Opacity="0">
                    <Grid.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                        </Transitions>
                    </Grid.Transitions>
        
                    <!-- Üst gradient -->
                    <Border VerticalAlignment="Top" Height="60" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#CC000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
        
                    <!-- Kapat + tam ekrana dön -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,8,8,0"
                                Spacing="4">
                        <Button x:Name="ReturnButton"
                                Width="28" Height="28"
                                CornerRadius="14"
                                Background="#AA000000"
                                BorderThickness="0"
                                ToolTip.Tip="Tam ekrana dön"
                                Click="ReturnToMain_Click"
                                Cursor="Hand">
                            <materialIcons:MaterialIcon Kind="ArrowExpand" Width="14" Height="14" Foreground="White"/>
                        </Button>
                        <Button x:Name="CloseButton"
                                Width="28" Height="28"
                                CornerRadius="14"
                                Background="#AA000000"
                                BorderThickness="0"
                                Click="Close_Click"
                                Cursor="Hand">
                            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="White"/>
                        </Button>
                    </StackPanel>
        
                    <!-- Alt: oynat/duraklat -->
                    <Border VerticalAlignment="Bottom" Height="60" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#CC000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
        
                    <Button x:Name="PlayPauseButton"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,12"
                            Width="36" Height="36"
                            CornerRadius="18"
                            Background="#AA000000"
                            BorderThickness="0"
                            Click="PlayPause_Click"
                            Cursor="Hand">
                        <materialIcons:MaterialIcon x:Name="PlayPauseIcon"
                                                   Kind="Pause"
                                                   Width="18" Height="18"
                                                   Foreground="White"/>
                    </Button>
                </Grid>
            </controls:MemoryVideoView.OverlayContent>
        </controls:MemoryVideoView>
    </Grid>
</Window>
