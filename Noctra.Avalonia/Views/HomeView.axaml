<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:shared="using:Noctra.UI.Views"
             x:Class="Noctra.Avalonia.Views.HomeView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False"
             IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Home}}">
  <shared:HomeContentView HasContent="{Binding ContinueWatching.Count, Converter={StaticResource CountToVisibilityConverter}}">
    <shared:HomeContentView.ItemsHost>
      <controls:DesktopVirtualizingCardGrid SourceItems="{Binding ContinueWatching}"
                                            CardKind="ContinueWatching" />
    </shared:HomeContentView.ItemsHost>
    <shared:HomeContentView.EmptyArtwork>
      <Image Source="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LogoThemeConverter}, ConverterParameter=Full}"
             Stretch="Uniform" />
    </shared:HomeContentView.EmptyArtwork>
  </shared:HomeContentView>
</UserControl>
