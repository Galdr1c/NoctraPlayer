<UserControl x:CompileBindings="True" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:models="using:Noctra.Models"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:views="using:Noctra.Avalonia.Views"
             xmlns:loc="using:Noctra.Avalonia.Localization"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Noctra.Avalonia.Views.LiveView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer x:Name="LiveScrollViewer" IsVisible="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Live}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="LiveView_ScrollChanged"
                      PointerWheelChanged="LiveView_PointerWheelChanged">
          <StackPanel Margin="24">
            <Grid Margin="0,0,0,24" ColumnDefinitions="*,Auto">
              <TextBlock Text="{loc:Translate Live.Title}" FontSize="24" LetterSpacing="1" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding ShowContentFilters}">
                <ComboBox Theme="{StaticResource ModernComboBox}" Width="320" Height="45" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" IsVisible="{Binding ShowGroupFilter}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*">
                        <Button Grid.Column="0" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).HideGroupCommand}"
                                CommandParameter="{Binding}" Padding="6" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" CornerRadius="6" Cursor="Hand"
                                ToolTip.Tip="{loc:Translate Live.HideCategory.Tooltip}">
                          <materialIcons:MaterialIcon Kind="EyeOffOutline" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryColor}"/>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{loc:Translate Common.All}" Width="80" Height="45" Click="ClearGroupSelection_Click" Theme="{StaticResource FilterButtonStyle}" IsVisible="{Binding ShowGroupFilter}"/>
                <ComboBox Width="300" Height="45" ItemsSource="{Binding SortOptions}" SelectedValue="{Binding SelectedSortOrder}" SelectedValueBinding="{Binding Key}" DisplayMemberBinding="{Binding Value}"/>
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding FilteredChannels}" Margin="0,0,-16,-16"
                          IsVisible="{Binding !IsContentLoading}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource WidthToColumnsConverter}}"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Channel">
                  <controls:LiveTvCard Margin="0,0,16,16" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- YÜKLENIYOR STATE -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,80,0,0" Spacing="20"
                        IsVisible="{Binding IsContentLoading}">
                <controls:PremiumSpinner Width="56" Height="56"
                                         HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Translate Live.Loading}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextAlignment="Center"/>
                <TextBlock Text="{loc:Translate Live.LoadingDetail}"
                           FontSize="12" Opacity="0.6"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextAlignment="Center"/>
            </StackPanel>

            <!-- GERÇEKTEN BOŞ STATE -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,96,0,0"
                        IsVisible="{Binding ShowEmptyChannels}">
                <materialIcons:MaterialIcon Kind="Television" Width="64" Height="64"
                                            Foreground="{DynamicResource TextMutedBrush}" Opacity="0.5"/>
                <TextBlock Text="{loc:Translate Live.Empty.Title}" FontSize="20" LetterSpacing="1"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center" Margin="0,14,0,6"/>
                <TextBlock Text="{loc:Translate Live.Empty.Description}"
                           FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                           TextAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
</UserControl>
