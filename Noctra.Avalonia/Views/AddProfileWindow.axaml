<Window x:Class="Noctra.Avalonia.Views.AddProfileWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Noctra.ViewModels"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:loc="using:Noctra.Avalonia.Localization"
        mc:Ignorable="d"
        x:DataType="vm:AddProfileViewModel"
        x:CompileBindings="False"
        Title="{loc:Translate Profiles.Account.Settings}" Height="700" Width="950"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
>

    <Window.Styles>
        <!-- Cancel Button Style -->
        <Style Selector="Button.CancelBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.CancelBtn:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Save Button Style -->
        <Style Selector="Button.SaveBtn">
            <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Bg0Brush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.SaveBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="Button.SaveBtn:disabled">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <!-- Avatar Button Style -->
        <Style Selector="Button.AvatarBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        
        <!-- Edit Icon Style (Child of AvatarBtn) -->
        <Style Selector="Border.EditIcon">
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- When Avatar Button is hovered, target the EditIcon border -->
        <Style Selector="Button.AvatarBtn:pointerover Border.EditIcon">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="RenderTransform" Value="scale(1.1)"/>
        </Style>
        
        <!-- Close Button Style -->
        <Style Selector="Button.CloseBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.CloseBtn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InteractiveHoverBrush}"/>
        </Style>

        <!-- Password reveal button press feedback -->
        <Style Selector="Button.PasswordRevealBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.PasswordRevealBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.PasswordRevealBtn:pressed /template/ ContentPresenter">
            <Setter Property="RenderTransform" Value="scale(0.90)" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Border CornerRadius="8"
            ClipToBounds="True"
            Background="{DynamicResource BackgroundGradientBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <!-- Drag Bar -->
            <Border Height="40" VerticalAlignment="Top" Background="Transparent" PointerPressed="DragBar_PointerPressed"/>
            
            <!-- Close Button -->
            <Button Click="Cancel_Click" Classes="CloseBtn" 
                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="16" Width="32" Height="32"
                    CornerRadius="8" ToolTip.Tip="{loc:Translate Profiles.Close.Tooltip}">
                <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20"/>
            </Button>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,40,0,0">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0,40,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Main Content -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,40">
                        <Panel HorizontalAlignment="Center">
                            <TextBlock Text="{loc:Translate Profiles.Edit.Title}" FontSize="56" FontWeight="Medium" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       IsVisible="{Binding EditingProfile, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <TextBlock Text="{loc:Translate Profiles.Add.Title}" FontSize="56" FontWeight="Medium" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       IsVisible="{Binding EditingProfile, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Panel>
                        
                        <TextBlock Text="{loc:Translate Profiles.Add.Description}" FontSize="18" 
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,30,0,0" Width="800"/>
                    </StackPanel>

                    <!-- Main Content (Horizontal Split: Avatar | Info) -->
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Avatar -->
                            <ColumnDefinition Width="500"/> <!-- Info Stack -->
                        </Grid.ColumnDefinitions>

                        <!-- Avatar Column -->
                        <Button Command="{Binding OpenAvatarPickerCommand}" 
                                Classes="AvatarBtn"
                                VerticalAlignment="Top" Margin="0,0,60,0">
                            <Grid Width="200" Height="200">
                                <!-- Avatar -->
                                <Border Width="200" Height="200" CornerRadius="12" ClipToBounds="True"
                                        Background="{Binding SelectedAvatar, Converter={StaticResource ProfileColorConverter}, FallbackValue='#E50914'}">
                                    <Grid>
                                        <Image Source="{Binding SelectedAvatar, Converter={StaticResource AvatarPathConverter}}" 
                                               Stretch="UniformToFill" 
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>

                                        <!-- Edit Icon -->
                                        <Border Classes="EditIcon"
                                                Width="34" Height="34"
                                                CornerRadius="10"
                                                Background="{DynamicResource Surface1Brush}"
                                                BorderBrush="{DynamicResource Bg0Brush}"
                                                BorderThickness="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,4,4">
                                            <materialIcons:MaterialIcon Kind="PencilOutline"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  Width="18" Height="18"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>     

                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Info Column -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <!-- Profile Name -->
                            <TextBlock Text="{loc:Translate Profiles.Add.ProfileName}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding ProfileName}" 
                                     Height="52"
                                     PlaceholderText="{loc:Translate Profiles.Add.ProfileNamePlaceholder}"
                                     Theme="{StaticResource ModernTextBox}"/>

                            <CheckBox Content="{loc:Translate Profiles.Add.IsChild}" 
                                      IsChecked="{Binding IsChild}"
                                      IsEnabled="{Binding CanEditIsChild}"
                                      IsVisible="{Binding IsChildVisible}"
                                      Margin="4,16,0,0"
                                      ToolTip.Tip="{loc:Translate Profiles.Add.IsChildTooltip}"/>

                            <!-- PIN Management Section -->
                            <Border Background="{DynamicResource Surface1Brush}" CornerRadius="8"
                                    Padding="20,16" Margin="0,24,0,0">
                                <StackPanel Spacing="12">
                                    <!-- Toggle Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <materialIcons:MaterialIcon Kind="Lock" Width="22" Height="22" Margin="-5,0,0,-15"
                                                                             Foreground="{DynamicResource AccentBrush}"
                                                                             VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:Translate Profiles.Add.PinLock}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <!-- Premium Badge (visible for free users) -->
                                                <Border Background="{DynamicResource PremiumBadgeBrush}" CornerRadius="4" Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding !IsPinAvailable}">
                                                    <TextBlock Text="PREMIUM" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource PremiumBadgeTextBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{loc:Translate Profiles.Add.PinLockDescription}"
                                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="26,0,0,0"/>
                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding HasPin}"
                                                      OnContent="" OffContent=""
                                                      IsEnabled="{Binding IsPinAvailable}"
                                                      VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- PIN Input (visible when toggle is on) -->
                                    <StackPanel IsVisible="{Binding HasPin}" Spacing="12" Margin="26,4,0,0">
                                        
                                        <!-- State 1: Existing PIN info (editing a profile that already has PIN) -->
                                        <StackPanel IsVisible="{Binding HasExistingPin}" Spacing="8">
                                            <!-- Active PIN Badge -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="18" Height="18"
                                                                             Foreground="#4CAF50" VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:Translate Profiles.Add.PinActive}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#4CAF50" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{loc:Translate Profiles.Add.PinChangeInfo}"
                                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap" MaxWidth="350"/>
                                            
                                            <!-- Optional: Change PIN fields -->
                                            <TextBlock Text="{loc:Translate Profiles.Add.NewPin}" FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- PIN Field -->
                                        <StackPanel Spacing="4">
                                            <Panel>
                                                <TextBlock Text="{loc:Translate Profiles.Add.NewPin}" FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           IsVisible="{Binding HasExistingPin}"/>
                                                <TextBlock Text="{loc:Translate Profiles.Add.Pin}" FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           IsVisible="{Binding !HasExistingPin}"/>
                                            </Panel>
                                            <TextBox Text="{Binding PinCode}" 
                                                     MaxLength="4"
                                                     PasswordChar="•"
                                                     PlaceholderText="••••"
                                                     Width="140"
                                                     Height="44"
                                                     FontSize="20"
                                                     LetterSpacing="8"
                                                     HorizontalAlignment="Left"
                                                     HorizontalContentAlignment="Center"
                                                     Theme="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <!-- PIN Confirm Field -->
                                        <StackPanel Spacing="4">
                                            <Panel>
                                                <TextBlock Text="{loc:Translate Profiles.Add.ConfirmNewPin}" FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           IsVisible="{Binding HasExistingPin}"/>
                                                <TextBlock Text="{loc:Translate Profiles.Add.ConfirmPin}" FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           IsVisible="{Binding !HasExistingPin}"/>
                                            </Panel>
                                            <TextBox Text="{Binding PinConfirm}" 
                                                     MaxLength="4"
                                                     PasswordChar="•"
                                                     PlaceholderText="••••"
                                                     Width="140"
                                                     Height="44"
                                                     FontSize="20"
                                                     LetterSpacing="8"
                                                     HorizontalAlignment="Left"
                                                     HorizontalContentAlignment="Center"
                                                     Theme="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <!-- Error -->
                                        <TextBlock Text="{Binding PinError}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   IsVisible="{Binding PinError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                                        <!-- Warning -->
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap" MaxWidth="350" HorizontalAlignment="Left"
                                                   Text="{loc:Translate Profiles.Add.PinWarning}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,32"/>
                            
                            <!-- Provider Account -->
                            <TextBlock Text="{loc:Translate Profiles.Account.Settings}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                            <!-- Connection Details Section -->
                            <StackPanel>
                                <!-- Format Type Toggle (Only for Remote Source) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20"
                                            IsVisible="{Binding IsRemoteProviderSource}"
                                            IsEnabled="{Binding CanSwitchProviderType}">
                                    <RadioButton GroupName="ProfileType" Content="Xtream Codes"
                                                 IsChecked="{Binding IsXtream}"
                                                 Margin="0,0,12,0" Padding="12,10"/>
                                    <RadioButton GroupName="ProfileType" Content="M3U Playlist"
                                                 IsChecked="{Binding IsM3U}"
                                                 Margin="0,0,12,0" Padding="12,10"/>
                                    <RadioButton GroupName="ProfileType" Content="Stalker Portal"
                                                 IsChecked="{Binding IsStalker}"
                                                 Padding="12,10"/>
                                </StackPanel>

                                <!-- Local M3U File Actions & Status -->
                                <Border Background="{DynamicResource Surface1Brush}" 
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,20"
                                        IsVisible="{Binding ShowLocalM3uFileActions}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Surface2Brush}">
                                                <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{loc:Translate Profiles.Account.LocalM3uFile}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{loc:Translate Profiles.Account.LocalM3uDescription}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Padding="12,10" CornerRadius="6" Background="{DynamicResource Surface2Brush}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{loc:Translate Profiles.Account.SelectedFile}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Url}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" MaxLines="3"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Button Grid.Column="0" Command="{Binding PickM3uFileCommand}" Content="{loc:Translate Profiles.Account.ChangeM3uFile}" Height="40" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                            <Button Grid.Column="1" Command="{Binding ValidateLocalM3uFileCommand}" Content="{loc:Translate Profiles.Account.ValidateM3uFile}" IsEnabled="{Binding !IsAnalyzingConnection}" Height="40" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <!-- Health Status Indicator for Local M3U -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4,4,4"
                                                    IsVisible="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToVisibilityConverter}}">
                                            <!-- Icon -->
                                            <materialIcons:MaterialIcon Kind="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToIconConverter}}" 
                                                                        Width="20" Height="20"
                                                                        Foreground="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToBrushConverter}}"
                                                                        Margin="0,0,8,0"/>
                                            <!-- Status Text -->
                                            <TextBlock Text="{Binding DetailedStatus}"
                                                       Foreground="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToBrushConverter}}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Command="{Binding ChangeLocalM3uSourceTypeCommand}" Content="{loc:Translate Profiles.Account.ChangeSourceType}" IsEnabled="{Binding !IsAnalyzingConnection}" Height="40" CornerRadius="6" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Remote M3U/Xtream/Stalker URL Field -->
                                <StackPanel IsVisible="{Binding IsRemoteProviderSource}" Spacing="8" Margin="0,0,0,20">
                                    <Panel Margin="4,0,0,0">
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="14" FontWeight="SemiBold"
                                                   Text="{loc:Translate Profiles.Account.M3uLink}" IsVisible="{Binding IsM3U}"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="14" FontWeight="SemiBold"
                                                   Text="{loc:Translate Profiles.Account.ServerUrl}" IsVisible="{Binding !IsM3U}"/>
                                    </Panel>
                                    
                                    <TextBox Text="{Binding Url}" 
                                             Height="52"
                                             IsEnabled="{Binding CanEditProviderUrl}"
                                             PlaceholderText="{loc:Translate Profiles.Account.ServerUrlPlaceholder}"
                                             Theme="{StaticResource ModernTextBox}"/>

                                    <!-- M3U Local File Select button when in Remote M3U mode -->
                                    <Button Command="{Binding PickM3uFileCommand}"
                                            Content="{loc:Translate Profiles.Account.SelectM3uFile}"
                                            IsVisible="{Binding IsM3U}"
                                            Height="44"
                                            CornerRadius="6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Margin="0,8,0,0"/>
                                </StackPanel>

                                <!-- Remote Credentials Grid -->
                                <Panel IsVisible="{Binding IsRemoteProviderSource}">
                                    <Grid Margin="0,0,0,20" IsVisible="{Binding !IsM3U}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,10,0">
                                            <Panel Margin="4,0,0,8">
                                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="14" FontWeight="SemiBold"
                                                           Text="{loc:Translate Profiles.Account.MacAddress}" IsVisible="{Binding IsStalker}"/>
                                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="14" FontWeight="SemiBold"
                                                           Text="{loc:Translate Profiles.Account.Username}" IsVisible="{Binding !IsStalker}"/>
                                            </Panel>
                                            <TextBox Text="{Binding Username}" Height="52"
                                                     TextChanged="UsernameTextBox_TextChanged"
                                                     PlaceholderText="{loc:Translate Profiles.Account.UsernamePlaceholder}"
                                                     Theme="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" IsVisible="{Binding !IsStalker}">
                                            <TextBlock Text="{loc:Translate Profiles.Account.Password}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold"/>
                                            <Grid>
                                                <TextBox Text="{Binding Password}" Height="52"
                                                         x:Name="DesktopPasswordTextBox"
                                                         PasswordChar="•"
                                                         PlaceholderText="{loc:Translate Profiles.Account.PasswordPlaceholder}"
                                                         Theme="{StaticResource ModernTextBox}"/>
                                                <Button Command="{Binding TogglePasswordRevealCommand}"
                                                        Classes="PasswordRevealBtn"
                                                        HorizontalAlignment="Right"
                                                        ToolTip.Tip="{Binding PasswordToggleA11yName}"
                                                        AutomationProperties.Name="{Binding PasswordToggleA11yName}">
                                                    <materialIcons:MaterialIcon Kind="{Binding PasswordToggleIcon}"
                                                                               Width="20" Height="20"
                                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Panel>

                                <!-- Error Message for URL/File -->
                                <TextBlock Text="{Binding UrlError}"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="4,0,0,12"
                                           IsVisible="{Binding UrlError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                                <!-- Remote Connection Analysis Actions -->
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0" IsVisible="{Binding ShowConnectionAnalysis}">
                                    <Button Command="{Binding AnalyzeConnectionCommand}"
                                            Height="42"
                                            Padding="16,8"
                                            Content="{loc:Translate Profiles.Account.Analyze}"
                                            IsEnabled="{Binding !IsAnalyzingConnection}"
                                            Margin="0,0,16,0"/>

                                    <!-- Health Status Indicator -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                IsVisible="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToVisibilityConverter}}">
                                        
                                        <!-- Icon -->
                                        <materialIcons:MaterialIcon Kind="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToIconConverter}}" 
                                                                    Width="24" Height="24"
                                                                    Foreground="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToBrushConverter}}"
                                                                    Margin="0,0,8,0"
                                                                    ToolTip.Tip="{loc:Translate Profiles.Account.HealthTooltip}"/>
                                        
                                        <!-- Status Text -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DetailedStatus}"
                                                       Foreground="{Binding ConnectionHealth, Converter={StaticResource ConnectionHealthToBrushConverter}}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Footer Actions -->
                    <Grid Grid.Row="2" Margin="0,32,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left: Delete Button (only in edit mode) -->
                        <Button Command="{Binding DeleteProfileCommand}"
                                CommandParameter="{Binding EditingProfile}"
                                IsVisible="{Binding EditingProfile, Converter={StaticResource NullToVisibilityConverter}}"
                                HorizontalAlignment="Left"
                                Theme="{StaticResource ErrorButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="TrashCanOutline"
                                                  Foreground="{DynamicResource ErrorBrush}"
                                                  Width="24" Height="24"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>     
                                <TextBlock Text="{loc:Translate Profiles.Add.DeleteProfile}"
                                           FontSize="16"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Right: Cancel & Save -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Status Message -->
                            <TextBlock Text="{Binding StatusMessage}" 
                                       Foreground="{DynamicResource TextMutedBrush}" 
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,24,0"
                                       IsVisible="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                            
                            <!-- Cancel Button -->
                            <Button Click="Cancel_Click" Width="120" Height="48" Margin="0,0,16,0"
                                    Classes="CancelBtn"
                                    Content="{loc:Translate Profiles.Add.Cancel}" FontSize="16"/>
                            
                            <!-- Save Button -->
                            <Button Command="{Binding SaveCommand}" Width="140" Height="48"
                                    Classes="SaveBtn"
                                    Content="{loc:Translate Profiles.Add.Save}" FontSize="16"
                                    IsEnabled="{Binding !IsAnalyzingConnection}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
