<Window x:Class="Noctra.Avalonia.Views.AddProfileWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Noctra.ViewModels"
        mc:Ignorable="d"
        x:DataType="vm:AddProfileViewModel"
        x:CompileBindings="False"
        Title="Profil Ayarlari" Height="700" Width="950"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SystemDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="{StaticResource DefaultFontFamily}">

    <Window.Styles>
        <!-- Cancel Button Style -->
        <Style Selector="Button.CancelBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.CancelBtn:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Save Button Style -->
        <Style Selector="Button.SaveBtn">
            <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Bg0Brush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.SaveBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="Button.SaveBtn:disabled">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <!-- Delete Button Style -->
        <Style Selector="Button.DeleteBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.DeleteBtn:pointerover">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <!-- Avatar Button Style -->
        <Style Selector="Button.AvatarBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="{DynamicResource RadiusMedium}"
            ClipToBounds="True"
            Background="{DynamicResource BackgroundGradientBrush}">
        <Grid>
            <!-- Drag Bar -->
            <Border Height="34" VerticalAlignment="Top" Background="Transparent" PointerPressed="DragBar_PointerPressed"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0,40,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Main Content -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,40">
                        <TextBlock x:Name="TitleText" FontSize="56" FontWeight="Medium" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"
                                   Text="{Binding EditingProfile, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Profili Duzenle|Profil Ekle'}"/>
                        <TextBlock Text="Noctra izleyen baska bir kisi icin profil ekleyin." FontSize="18" 
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,30,0,0" Width="800"/>
                    </StackPanel>

                    <!-- Main Content (Horizontal Split: Avatar | Info) -->
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Avatar -->
                            <ColumnDefinition Width="500"/> <!-- Info Stack -->
                        </Grid.ColumnDefinitions>

                        <!-- Avatar Column -->
                        <Button Command="{Binding OpenAvatarPickerCommand}" 
                                Classes="AvatarBtn"
                                VerticalAlignment="Top" Margin="0,0,60,0">
                            <Grid Width="200" Height="200">
                                <!-- Avatar -->
                                <Border Width="200" Height="200" CornerRadius="14" ClipToBounds="True"
                                        Background="{Binding SelectedAvatar, Converter={StaticResource ProfileColorConverter}, FallbackValue='#E50914'}">
                                    <Grid>
                                        <Image Source="{Binding SelectedAvatar, Converter={StaticResource AvatarPathConverter}}" 
                                               Stretch="UniformToFill" 
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>

                                        <!-- Edit Icon -->
                                        <Border Width="56" Height="56"
                                                Background="{DynamicResource Surface1Brush}"
                                                CornerRadius="28"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="12"
                                                Opacity="0.8">
                                            <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                  Fill="{DynamicResource TextPrimaryBrush}"
                                                  Stretch="Uniform"
                                                  Width="24" Height="24"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Info Column -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <!-- Profile Name -->
                            <TextBlock Text="Profil Adi" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding ProfileName}" 
                                     Height="52"
                                     Watermark="Isim girin"/>

                            <CheckBox Content="Cocuk Profili" 
                                      IsChecked="{Binding IsChild}"
                                      Margin="4,16,0,0"/>
                            
                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,32"/>
                            
                            <!-- Provider Account -->
                            <TextBlock Text="Hesap Ayarlari" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                            <!-- Connection Details Section -->
                            <StackPanel IsVisible="{Binding ShowConnectionFields}">
                                <!-- URL Field -->
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold"
                                           Text="{Binding IsM3U, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='M3U Link|Sunucu URL'}"/>
                                
                                <TextBox Text="{Binding Url}" 
                                         Height="52" Margin="0,0,0,20"
                                         Watermark="http://server.com:8080"/>
                                
                                <!-- Credentials Grid -->
                                <Grid Margin="0,0,0,20" IsVisible="{Binding ShowCredentials}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold"
                                                   Text="{Binding IsStalker, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='MAC Adresi|Kullanici Adi'}"/>
                                        <TextBox Text="{Binding Username}" Height="52"
                                                 Watermark="Kullanici adi"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" IsVisible="{Binding !IsStalker}">
                                        <TextBlock Text="Sifre" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding Password}" Height="52"
                                                 Watermark="Sifre"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Format Type Toggle -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton GroupName="ProfileType" Content="Xtream Codes"
                                                 IsChecked="{Binding IsXtream}"
                                                 Margin="0,0,12,0" Padding="20,10"/>
                                    <RadioButton GroupName="ProfileType" Content="M3U Playlist"
                                                 IsChecked="{Binding IsM3U}"
                                                 Margin="0,0,12,0" Padding="20,10"/>
                                    <RadioButton GroupName="ProfileType" Content="Stalker Portal"
                                                 IsChecked="{Binding IsStalker}"
                                                 Padding="20,10"/>
                                </StackPanel>
                                
                                <!-- Info Banner - M3U to Xtream Conversion -->
                                <Border Background="{DynamicResource PremiumCardBackgroundBrush}" 
                                        BorderBrush="{DynamicResource AccentBrush}" 
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                                        IsVisible="{Binding ShowXtreamConversionBanner}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ℹ" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                            <Run Text="M3U linkiniz Xtream formatina donusturuldu."/>
                                            <Run Text=" Sunucu, kullanici adi ve sifre otomatik ayristirildi." FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Command="{Binding AnalyzeConnectionCommand}"
                                            Height="42"
                                            Padding="16,8"
                                            Content="Baglantiyi Analiz Et"
                                            IsEnabled="{Binding !IsAnalyzingConnection}"/>
                                </StackPanel>
                                
                                <TextBlock Text="{Binding PlaylistPreviewSummary}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"
                                           IsVisible="{Binding PlaylistPreviewSummary, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Footer Actions -->
                    <Grid Grid.Row="2" Margin="0,32,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left: Delete Button (only in edit mode) -->
                        <Button Command="{Binding DeleteProfileCommand}"
                                CommandParameter="{Binding EditingProfile}"
                                IsVisible="{Binding EditingProfile, Converter={StaticResource NullToVisibilityConverter}}"
                                HorizontalAlignment="Left"
                                Classes="DeleteBtn">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                      Fill="{DynamicResource ErrorBrush}"
                                      Stretch="Uniform"
                                      Width="20" Height="20"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"/>
                                <TextBlock Text="Profili Sil"
                                           FontSize="16"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Right: Cancel & Save -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Status Message -->
                            <TextBlock Text="{Binding StatusMessage}" 
                                       Foreground="{DynamicResource TextMutedBrush}" 
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,24,0"
                                       IsVisible="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                            
                            <!-- Cancel Button -->
                            <Button Click="Cancel_Click" Width="120" Height="48" Margin="0,0,16,0"
                                    Classes="CancelBtn"
                                    Content="Iptal" FontSize="16"/>
                            
                            <!-- Save Button -->
                            <Button Command="{Binding SaveCommand}" Width="140" Height="48"
                                    Classes="SaveBtn"
                                    Content="Kaydet" FontSize="16"
                                    IsEnabled="{Binding !IsAnalyzingConnection}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
