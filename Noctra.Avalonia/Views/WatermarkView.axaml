<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctra.ViewModels"
             x:Class="Noctra.Avalonia.Views.WatermarkView"
             x:DataType="vm:WatermarkViewModel">
  <Grid IsVisible="{Binding IsVisible}">
    <Border Background="Transparent"
            Padding="6,6"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,60"
            IsHitTestVisible="False">
      <TextBlock Text="Noctra - Free"
                 FontWeight="SemiBold"
                 FontSize="{DynamicResource FWatermark}"
                 Foreground="{DynamicResource PlayerOverlayTextBrush}"
                 Opacity="{Binding Opacity}"/>
    </Border>
  </Grid>
</UserControl>
