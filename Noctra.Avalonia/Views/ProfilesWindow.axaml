<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Noctra.ViewModels"
        xmlns:models="using:Noctra.Models"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Noctra.Avalonia.Views.ProfilesWindow"
        x:Name="ProfilesWindowRoot"
        x:CompileBindings="False"
        Title="Kim izliyor?"
        Width="1100" Height="750"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="{StaticResource DefaultFontFamily}">

    <Window.Resources>
        <!-- Converters (mapped from App.xaml resources if needed locally) -->
    </Window.Resources>

    <Window.Styles>
        <!-- Settings Button Style -->
        <Style Selector="Button.SettingsButtonStyle">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="SettingsBg" Background="{TemplateBinding Background}" CornerRadius="24">
                        <materialIcons:MaterialIcon x:Name="SettingsIcon"
                                                    Kind="CogOutline"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Width="22" Height="22"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    RenderTransformOrigin="50%,50%">
                            <materialIcons:MaterialIcon.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </materialIcons:MaterialIcon.Transitions>
                        </materialIcons:MaterialIcon>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.SettingsButtonStyle:pointerover /template/ Border#SettingsBg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.SettingsButtonStyle:pointerover /template/ materialIcons|MaterialIcon#SettingsIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="RenderTransform" Value="rotate(90deg)"/>
        </Style>

        <!-- Close Button Style -->
        <Style Selector="Button.CloseButtonStyle">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="CloseBg" Background="{TemplateBinding Background}" CornerRadius="24">
                        <materialIcons:MaterialIcon x:Name="CloseIcon" Kind="Close" Width="24" Height="24"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ Border#CloseBg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ materialIcons|MaterialIcon#CloseIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Profile Card Button Style -->
        <Style Selector="Button.ProfileCardStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Width="{StaticResource RatioSquareSize}" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Avatar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid x:Name="AvatarRoot" Width="{StaticResource RatioSquareSize}" Height="{StaticResource RatioSquareSize}">
                                <!-- 1. Background & Content (Clipped) -->
                                <Border CornerRadius="14" ClipToBounds="True"
                                        Background="{DynamicResource IconGradientBrush}">
                                    <Grid>
                                        <!-- Actual Avatar -->
                                        <Border CornerRadius="14" RenderOptions.BitmapInterpolationMode="HighQuality">
                                            <Border.Background>
                                                <ImageBrush Source="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>

                                        <!-- Manage Mode Overlay -->
                                        <Border Background="#99000000" CornerRadius="14"
                                                IsVisible="{Binding DataContext.IsManageMode, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <!-- Pencil Icon in Circle -->
                                                <Border Width="48" Height="48"
                                                        CornerRadius="24"
                                                        Background="Transparent"
                                                        BorderBrush="White"
                                                        BorderThickness="2">
                                                    <materialIcons:MaterialIcon Kind="Pencil" Width="20" Height="20"
                                                                                Foreground="White"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Düzenle"
                                                           FontSize="14"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 2. Selection/Focus Frame (On Top) -->
                                <Border x:Name="AvatarBorder" CornerRadius="14"
                                        BorderThickness="3" BorderBrush="Transparent"
                                        Background="Transparent" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>

                        <!-- Name -->
                        <TextBlock x:Name="ProfileName" Grid.Row="1" Text="{Binding Name}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="15" FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="QuadraticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ProfileCardStyle:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)"/>
        </Style>
        <Style Selector="Button.ProfileCardStyle:focus /template/ Border#AvatarBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
            <!-- BoxShadow for Glow Effect -->
            <Setter Property="BoxShadow" Value="0 0 20 0 #996366F1"/> 
        </Style>
        <Style Selector="Button.ProfileCardStyle:focus /template/ TextBlock#ProfileName">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>


        <!-- Add Profile Button Style -->
        <Style Selector="Button.AddProfileButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Width="{StaticResource RatioSquareSize}" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Plus Icon Box (Dashed Border) -->
                        <Grid Width="{StaticResource RatioSquareSize}" Height="{StaticResource RatioSquareSize}"
                              Grid.Row="0" Margin="0,0,0,12">

                            <!-- Dashed Border Rectangle -->
                            <Rectangle x:Name="AddBorder"
                                       RadiusX="14" RadiusY="14"
                                       Stroke="{DynamicResource BorderBrush}"
                                       StrokeThickness="2"
                                       StrokeDashArray="4,2"
                                       Fill="Transparent"/>

                            <!-- Circle with Plus -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse x:Name="PlusCircle" Width="60" Height="60"
                                         Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2" Fill="Transparent"/>
                                <materialIcons:MaterialIcon x:Name="PlusIcon" Kind="Plus" Width="32" Height="32"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Label -->
                        <TextBlock x:Name="AddLabel" Grid.Row="1" Text="Profil Ekle"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="15" FontWeight="Medium"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="QuadraticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)"/>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover /template/ Rectangle#AddBorder">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover /template/ Ellipse#PlusCircle">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover /template/ materialIcons|MaterialIcon#PlusIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover /template/ TextBlock#AddLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Manage Mode Text Button Style -->
        <Style Selector="Button.ManageModeButtonStyle">
             <Setter Property="Background" Value="Transparent"/>
             <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
             <Setter Property="BorderThickness" Value="1"/>
             <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
             <Setter Property="FontSize" Value="14"/>
             <Setter Property="FontWeight" Value="Medium"/>
             <Setter Property="Padding" Value="24,12"/>
             <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
             <Setter Property="Template">
                 <ControlTemplate>
                     <Border Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"
                             CornerRadius="{TemplateBinding CornerRadius}"
                             Padding="{TemplateBinding Padding}">
                         <ContentPresenter Content="{TemplateBinding Content}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                     </Border>
                 </ControlTemplate>
             </Setter>
        </Style>
        <Style Selector="Button.ManageModeButtonStyle:pointerover">
             <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
             <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
        </Style>
        
        <!-- Manage Mode Active State -->
        <Style Selector="Button.ManageModeButtonStyle[Tag=True]"> 
             <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}"/>
             <Setter Property="Foreground" Value="{DynamicResource Bg0Brush}"/>
             <Setter Property="BorderThickness" Value="1"/>
             <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="{DynamicResource RadiusMedium}" ClipToBounds="True"
            Background="{DynamicResource BackgroundGradientBrush}">

        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="32,24" ColumnDefinitions="*,Auto">
                
                <!-- Left: Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="avares://Noctra.Avalonia/Assets/Logo.png" Height="24" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="Noctra" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Right: Settings & Close -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    
                    <!-- Settings Button -->
                    <Button Classes="SettingsButtonStyle" Click="SettingsButton_Click" 
                            ToolTip.Tip="Ayarlar" Margin="0,0,8,0"/>

                    <!-- Close Button -->
                    <Button Classes="CloseButtonStyle" Click="Close_Click"
                            ToolTip.Tip="Kapat"/>
                </StackPanel>
            </Grid>

            <!-- MAIN CONTENT -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Titles -->
                <TextBlock Text="Kim izliyor?"
                           FontSize="64" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Profil seçin"
                           FontSize="18" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,56"/>

                <!-- Profile Grid -->
                <WrapPanel HorizontalAlignment="Center" MaxWidth="900">
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="192" ItemHeight="200"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="ProfileCardStyle"
                                        Click="SelectProfile_Click"
                                        Margin="16,16,16,24"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add Profile Button -->
                    <Button Classes="AddProfileButtonStyle"
                            Command="{Binding AddProfileCommand}"
                            Margin="16,16,16,24"
                            IsVisible="{Binding IsManageMode, Converter={StaticResource InverseBoolConverter}}"/>
                </WrapPanel>
            </StackPanel>

            <!-- FOOTER -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Stretch" Margin="0,0,0,40">
                <Button x:Name="ManageProfilesButton"
                        Content="{Binding IsManageMode, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Bitti|Profilleri Yönet'}"
                        Command="{Binding ToggleManageModeCommand}"
                        Classes="ManageModeButtonStyle"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding Profiles.Count, Converter={StaticResource CountToVisibilityConverter}}"
                        Tag="{Binding IsManageMode}">
                </Button>
            </StackPanel>
        </Grid>
    </Border>

</Window>
