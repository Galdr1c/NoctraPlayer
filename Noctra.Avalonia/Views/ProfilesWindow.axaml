<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Noctra.ViewModels"
        xmlns:models="using:Noctra.Models"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:Noctra.Avalonia.Localization"
        mc:Ignorable="d"
        x:Class="Noctra.Avalonia.Views.ProfilesWindow"
        x:Name="ProfilesWindowRoot"
        x:CompileBindings="False"
        Icon="avares://Noctra.Avalonia/Assets/Favicon.png"
        Title="{loc:Translate Profiles.Title}"
        Width="1100" Height="750"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="{StaticResource DefaultFontFamily}">

    <Window.Resources>
        <!-- Converters (mapped from App.xaml resources if needed locally) -->
    </Window.Resources>

    <Window.Styles>
        <!-- Settings Button Style -->
        <Style Selector="Button.SettingsButtonStyle">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="SettingsBg" Background="{TemplateBinding Background}" CornerRadius="24">
                        <materialIcons:MaterialIcon x:Name="SettingsIcon"
                                                     Kind="CogOutline"
                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                     Width="22" Height="22"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     RenderTransformOrigin="50%,50%">
                            <materialIcons:MaterialIcon.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </materialIcons:MaterialIcon.Transitions>
                        </materialIcons:MaterialIcon>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.SettingsButtonStyle:pointerover /template/ Border#SettingsBg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.SettingsButtonStyle:pointerover /template/ materialIcons|MaterialIcon#SettingsIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="RenderTransform" Value="rotate(90deg)"/>
        </Style>

        <!-- Close Button Style -->
        <Style Selector="Button.CloseButtonStyle">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="CloseBg" Background="{TemplateBinding Background}" CornerRadius="24">
                        <materialIcons:MaterialIcon x:Name="CloseIcon" Kind="Close" Width="24" Height="24"
                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ Border#CloseBg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ materialIcons|MaterialIcon#CloseIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Profile Card Button Style -->
        <Style Selector="Button.ProfileCardStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Width="150" Background="Transparent" ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Avatar Area (Increased height to prevent clipping) -->
                        <Grid Grid.Row="0" Height="140" Margin="0,0,0,12" ClipToBounds="False">
                            <Grid x:Name="AvatarRoot" Width="140" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                                <!-- 1. Kid Frame (Background glow and frame) -->
                                <Border x:Name="KidFrame" 
                                        Width="134" Height="134"
                                        CornerRadius="21" 
                                        BorderThickness="3.5"
                                        IsVisible="{Binding IsChild}"
                                        IsHitTestVisible="False"
                                        BoxShadow="0 0 16 0 #708B5CF6">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#FFB7A6F6" Offset="0"/>
                                            <GradientStop Color="#FF8B5CF6" Offset="0.5"/>
                                            <GradientStop Color="#FF7C3AED" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                </Border>

                                <!-- 2. Avatar Content (120x120) -->
                                <Border Width="{StaticResource RatioSquareSize}" Height="{StaticResource RatioSquareSize}" 
                                        CornerRadius="14" ClipToBounds="True"
                                        Background="{DynamicResource IconGradientBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid>
                                        <!-- Actual Avatar -->
                                        <Border CornerRadius="14" RenderOptions.BitmapInterpolationMode="HighQuality">
                                            <Border.Background>
                                                <ImageBrush Source="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>

                                        <!-- Manage Mode Overlay -->
                                        <Border Background="#CC000000" Opacity="0.7" CornerRadius="14"
                                                IsVisible="{Binding DataContext.IsManageMode, RelativeSource={RelativeSource AncestorType=Window}}">
                                                
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <!-- Pencil Icon in Circle -->
                                                <Border Width="48" Height="48"
                                                        CornerRadius="24"
                                                        Background="Transparent"
                                                        BorderBrush="White"
                                                        BorderThickness="2">
                                                    <materialIcons:MaterialIcon Kind="PencilOutline" Width="20" Height="20"
                                                                                 Foreground="White"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Deletion Countdown Overlay -->
                                        <Border CornerRadius="14" ClipToBounds="True"
                                                IsVisible="{Binding IsPendingDeletion}">
                                            <Border.Background>
                                                <SolidColorBrush Color="#000000" Opacity="0.8"/>
                                            </Border.Background>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="TimerSandFull" Width="28" Height="28"
                                                                             Foreground="{Binding DeletionUrgency, Converter={StaticResource UrgencyToColorConverter}}"
                                                                             HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding TimeUntilDeletion, Converter={StaticResource TimeSpanToCountdownConverter}}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding DeletionUrgency, Converter={StaticResource UrgencyToColorConverter}}"
                                                           TextAlignment="Center" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- PIN Lock Icon (subtle indicator) -->
                                        <materialIcons:MaterialIcon Kind="Lock" Width="14" Height="14"
                                                                     Foreground="#99FFFFFF"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Top"
                                                                     Margin="0,8,8,0"
                                                                     IsVisible="{Binding PinHash, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- 3. Selection/Focus Frame (On Top) -->
                                <Border x:Name="AvatarBorder" Width="{StaticResource RatioSquareSize}" Height="{StaticResource RatioSquareSize}"
                                        CornerRadius="14"
                                        BorderThickness="3" BorderBrush="Transparent"
                                        Background="Transparent" IsHitTestVisible="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Name -->
                        <TextBlock x:Name="ProfileName" Grid.Row="1" Text="{Binding Name}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="15" FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                    </Grid>
                </ControlTemplate>

            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="QuadraticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ProfileCardStyle:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)"/>
        </Style>
        
        <!-- Compact Mode for Profile Cards -->
        <Style Selector="Window[Tag=True] Button.ProfileCardStyle">
            <Setter Property="RenderTransform" Value="scale(0.85)"/>
        </Style>
        <Style Selector="Window[Tag=True] Button.ProfileCardStyle:pointerover">
            <Setter Property="RenderTransform" Value="scale(0.9)"/>
        </Style>
        
        <Style Selector="Button.ProfileCardStyle:focus /template/ Border#AvatarBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
            <!-- BoxShadow for Glow Effect -->
            <Setter Property="BoxShadow" Value="{DynamicResource FocusGlow}"/> 
        </Style>
        <Style Selector="Button.ProfileCardStyle:focus /template/ TextBlock#ProfileName">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>


        <!-- Add Profile Button Style -->
        <Style Selector="Button.AddProfileButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Width="150" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Plus Icon Box (Dashed Border) -->
                        <Grid Width="{StaticResource RatioSquareSize}" Height="{StaticResource RatioSquareSize}"
                              Grid.Row="0" Margin="0,0,0,12">

                            <!-- Dashed Border Rectangle -->
                            <Rectangle x:Name="AddBorder"
                                       RadiusX="14" RadiusY="14"
                                       Stroke="{DynamicResource BorderBrush}"
                                       StrokeThickness="2"
                                       StrokeDashArray="4,2"
                                       Fill="Transparent"/>

                            <!-- Circle with Plus -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse x:Name="PlusCircle" Width="60" Height="60"
                                         Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2" Fill="Transparent"/>
                                <materialIcons:MaterialIcon x:Name="PlusIcon" Kind="Plus" Width="32" Height="32"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Label -->
                        <TextBlock x:Name="AddLabel" Grid.Row="1" Text="{loc:Translate Profiles.AddProfile}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="15" FontWeight="Medium"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="QuadraticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)"/>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover /template/ Rectangle#AddBorder">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover /template/ Ellipse#PlusCircle">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover /template/ materialIcons|MaterialIcon#PlusIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover /template/ TextBlock#AddLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Compact Mode for Add Button -->
        <Style Selector="Window[Tag=True] Button.AddProfileButtonStyle">
            <Setter Property="RenderTransform" Value="scale(0.85)"/>
        </Style>
        <Style Selector="Window[Tag=True] Button.AddProfileButtonStyle:pointerover">
            <Setter Property="RenderTransform" Value="scale(0.9)"/>
        </Style>
        
        <!-- Manage Mode Text Button Style -->
        <Style Selector="Button.ManageModeButtonStyle">
             <Setter Property="Background" Value="Transparent"/>
             <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
             <Setter Property="BorderThickness" Value="1"/>
             <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
             <Setter Property="FontSize" Value="14"/>
             <Setter Property="FontWeight" Value="Medium"/>
             <Setter Property="Padding" Value="24,12"/>
             <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
             <Setter Property="Template">
                 <ControlTemplate>
                     <Border Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"
                             CornerRadius="{TemplateBinding CornerRadius}"
                             Padding="{TemplateBinding Padding}">
                         <ContentPresenter Content="{TemplateBinding Content}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                     </Border>
                 </ControlTemplate>
             </Setter>
        </Style>
        <Style Selector="Button.ManageModeButtonStyle:pointerover">
             <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
             <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
        </Style>
        
        <!-- Manage Mode Active State -->
        <Style Selector="Button.ManageModeButtonStyle[Tag=True]"> 
             <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}"/>
             <Setter Property="Foreground" Value="{DynamicResource Bg0Brush}"/>
             <Setter Property="BorderThickness" Value="1"/>
             <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="{DynamicResource RadiusMedium}" ClipToBounds="True"
            Background="{DynamicResource BackgroundGradientBrush}"
            Tag="{Binding IsCompact}">

        <Grid RowDefinitions="Auto,*">
            
            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="32,24" ColumnDefinitions="*,Auto">
                
                <!-- Left: Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="avares://Noctra.Avalonia/Assets/Logo3.png" Height="24" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="Noctra" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Right: Settings & Close -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    
                    <!-- Settings Button -->
                    <Button Classes="SettingsButtonStyle" Click="SettingsButton_Click" 
                            ToolTip.Tip="{loc:Translate Profiles.Settings.Tooltip}" Margin="0,0,8,0"/>

                    <!-- Close Button -->
                    <Button Classes="CloseButtonStyle" Click="Close_Click"
                            ToolTip.Tip="{loc:Translate Profiles.Close.Tooltip}"/>
                </StackPanel>
            </Grid>

            <!-- SCROLLABLE CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,50">
                    
                    <!-- MAIN CONTENT -->
                    <StackPanel Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center">

                        <!-- Titles -->
                        <TextBlock Text="{loc:Translate Profiles.Title}"
                                   FontSize="64" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Translate Profiles.SelectProfile}"
                                   FontSize="18" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,56"/>
                        <!-- Profile Grid (Unified Flow) -->
                        <ItemsControl ItemsSource="{Binding DisplayItems}" MaxWidth="1050" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center">
                                        <WrapPanel.Styles>
                                            <Style Selector="WrapPanel">
                                                <Setter Property="ItemWidth" Value="170"/>
                                                <Setter Property="ItemHeight" Value="210"/>
                                            </Style>
                                            <Style Selector="Window[Tag=True] WrapPanel">
                                                <Setter Property="ItemWidth" Value="145"/>
                                                <Setter Property="ItemHeight" Value="180"/>
                                            </Style>
                                        </WrapPanel.Styles>
                                    </WrapPanel>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            
                            <ItemsControl.DataTemplates>
                                <!-- 1. Profile Card Template -->
                                <DataTemplate DataType="models:Profile">
                                    <Button Classes="ProfileCardStyle"
                                            Click="SelectProfile_Click"
                                            Margin="10,0"/>
                                </DataTemplate>
                                
                                <!-- 2. Add Profile Button Template -->
                                <DataTemplate DataType="vm:AddProfilePlaceholder">
                                    <Button Classes="AddProfileButtonStyle"
                                            Command="{Binding $parent[Window].DataContext.AddProfileCommand}"
                                            Margin="10,0"/>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </StackPanel>

                    <!-- FOOTER -->
                    <StackPanel HorizontalAlignment="Stretch">
                        <Panel HorizontalAlignment="Center">
                            <!-- MANAGE MODE BUTTON -->
                            <Button x:Name="ManageProfilesButton"
                                    Content="{loc:Translate Profiles.ManageMode.Manage}"
                                    Command="{Binding ToggleManageModeCommand}"
                                    Classes="ManageModeButtonStyle"
                                    IsVisible="{Binding !IsManageMode}"
                                    IsEnabled="{Binding Profiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            </Button>
                            
                            <!-- DONE BUTTON -->
                            <Button x:Name="DoneProfilesButton"
                                    Content="{loc:Translate Profiles.ManageMode.Done}"
                                    Command="{Binding ToggleManageModeCommand}"
                                    Classes="ManageModeButtonStyle"
                                    IsVisible="{Binding IsManageMode}"
                                    Tag="True"> 
                            </Button>
                        </Panel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>

</Window>
