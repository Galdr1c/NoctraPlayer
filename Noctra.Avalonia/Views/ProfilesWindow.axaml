<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Noctra.ViewModels"
        xmlns:models="using:Noctra.Models"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:Noctra.Avalonia.Localization"
        mc:Ignorable="d"
        x:Class="Noctra.Avalonia.Views.ProfilesWindow"
        x:Name="ProfilesWindowRoot"
        x:DataType="vm:ProfilesViewModel"
        x:CompileBindings="False"
        Icon="avares://Noctra/Assets/Square44x44Logo.targetsize-256.png"
        Title="{loc:Translate Profiles.Title}"
        Width="1100" Height="750"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Window.Styles>

        <!-- ══════════════════════════════════════════════════════════════
             PROFİL KARTI — Mobile tarzı basit ContentPresenter + pressed
             Desktop'a uyarlanmış: ControlTemplate korunuyor ama mobile
             transition/pressed durumları ekleniyor
             ══════════════════════════════════════════════════════════════ -->
        <Style Selector="Button.ProfileCardStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent" ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Avatar Area -->
                        <Grid Grid.Row="0" Height="150" Margin="0,0,0,12" ClipToBounds="False">
                            <Grid x:Name="AvatarRoot" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                                <!-- 2. Avatar Content -->
                                <Border Width="{StaticResource RatioSquareSize}" Height="{StaticResource RatioSquareSize}"
                                        CornerRadius="12" ClipToBounds="True"
                                        Background="{DynamicResource IconGradientBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid>
                                        <!-- Asıl avatar görseli -->
                                        <Border CornerRadius="12" RenderOptions.BitmapInterpolationMode="HighQuality">
                                            <Border.Background>
                                                <ImageBrush Source="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>

                                        <!-- YÖNET MODU kalem overlay'i -->
                                        <Border Background="#000000" Opacity="0.7" CornerRadius="11"
                                                IsVisible="{Binding DataContext.IsManageMode, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Border Width="48" Height="48"
                                                    CornerRadius="12"
                                                    Background="Transparent"
                                                    BorderBrush="White"
                                                    BorderThickness="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="PencilOutline" Width="20" Height="20"
                                                                             Foreground="White"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>

                                        <!-- Silme geri sayım overlay'i -->
                                        <Border CornerRadius="8" ClipToBounds="True"
                                                IsVisible="{Binding IsPendingDeletion}">
                                            <Border.Background>
                                                <SolidColorBrush Color="#000000" Opacity="0.8"/>
                                            </Border.Background>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="TimerSand" Width="28" Height="28"
                                                                             Foreground="{Binding DeletionUrgency, Converter={StaticResource UrgencyToColorConverter}}"
                                                                             HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding TimeUntilDeletion, Converter={StaticResource TimeSpanToCountdownConverter}}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding DeletionUrgency, Converter={StaticResource UrgencyToColorConverter}}"
                                                           TextAlignment="Center" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- PIN kilit simgesi -->
                                        <materialIcons:MaterialIcon Kind="Lock" Width="18" Height="18"
                                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Bottom"
                                                                     Margin="8,8"
                                                                     IsVisible="{Binding PinHash, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- 3. Selection/Focus Frame -->
                                <Border x:Name="AvatarBorder" Width="{StaticResource RatioSquareSize}" Height="{StaticResource RatioSquareSize}"
                                        CornerRadius="12"
                                        BorderThickness="3" BorderBrush="Transparent"
                                        Background="Transparent" IsHitTestVisible="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Profil adı etiketi -->
                        <TextBlock x:Name="ProfileName" Grid.Row="1" Text="{Binding Name}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="{DynamicResource FBodyL}"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ProfileCardStyle:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)"/>
        </Style>
        <Style Selector="Button.ProfileCardStyle:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="Button.ProfileCardStyle:focus /template/ TextBlock#ProfileName">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             PROFİL EKLE BUTONU — Mobildeki kare alan + artı görünümü
             ══════════════════════════════════════════════════════════════ -->
        <Style Selector="Button.AddProfileButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Profil kartıyla aynı kare alan -->
                        <Grid Width="{StaticResource RatioSquareSize}" Height="{StaticResource RatioSquareSize}"
                              Grid.Row="0" Margin="0,0,0,12">
                            <Border x:Name="AddBorder"
                                    CornerRadius="12"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource Surface1Brush}"
                                    BorderThickness="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                              <materialIcons:MaterialIcon x:Name="PlusIcon" Kind="Plus" Width="32" Height="32"
                                                        Foreground="{DynamicResource GlowBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- "Profil Ekle" etiketi -->
                        <TextBlock x:Name="AddLabel" Grid.Row="1" Text="{loc:Translate Profiles.AddProfile}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="{DynamicResource FBodyL}"
                                   FontWeight="Medium"
                                   MaxWidth="150"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)"/>
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover /template/ Border#AddBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover /template/ materialIcons|MaterialIcon#PlusIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pointerover /template/ TextBlock#AddLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="Button.AddProfileButtonStyle:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             ÜST ÇUBUK BUTONLARI
             ══════════════════════════════════════════════════════════════ -->
        <!-- Pencil / Header Icon Button -->
        <Style Selector="Button.HeaderIconBtn">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="HeaderIcon" Background="{TemplateBinding Background}" CornerRadius="12">
                        <materialIcons:MaterialIcon x:Name="PencilOutlineIcon" Kind="PencilOutline" Width="22" Height="22"
                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.HeaderIconBtn:pointerover /template/ Border#HeaderIcon">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.HeaderIconBtn:pointerover /template/ materialIcons|MaterialIcon#PencilOutlineIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        

        <!-- Done metin butonu -->
        <Style Selector="Button.DoneBtn">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.DoneBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.DoneBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Settings butonu -->
        <Style Selector="Button.SettingsButtonStyle">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="SettingsBg" Background="{TemplateBinding Background}" CornerRadius="12">
                        <materialIcons:MaterialIcon x:Name="SettingsIcon"
                                                     Kind="CogOutline"
                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                     Width="22" Height="22"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     RenderTransformOrigin="50%,50%">
                            <materialIcons:MaterialIcon.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                </Transitions>
                            </materialIcons:MaterialIcon.Transitions>
                        </materialIcons:MaterialIcon>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.SettingsButtonStyle:pointerover /template/ Border#SettingsBg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.SettingsButtonStyle:pointerover /template/ materialIcons|MaterialIcon#SettingsIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="RenderTransform" Value="rotate(90deg)"/>
        </Style>
        <Style Selector="Button.SettingsButtonStyle:pressed /template/ Border#SettingsBg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button.SettingsButtonStyle:pointerover /template/ materialIcons|MaterialIcon#SettingsIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Close butonu -->
        <Style Selector="Button.CloseButtonStyle">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="CloseBg" Background="{TemplateBinding Background}" CornerRadius="12">
                        <materialIcons:MaterialIcon x:Name="CloseIcon" Kind="Close" Width="22" Height="22"
                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ Border#CloseBg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ materialIcons|MaterialIcon#CloseIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ Border#CloseBg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ materialIcons|MaterialIcon#CloseIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

    </Window.Styles>

    <Border CornerRadius="8"
            ClipToBounds="True"
            Background="{DynamicResource BackgroundGradientBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

        <Grid RowDefinitions="Auto,*">

            <!-- ════════════════════════════════════════════════════════
                 SATIR 0 — ÜST BAŞLIK (Mobile tarzı: normal ↔ yönet modu)
                 Normal  : [Logo + NOCTRA]            [✏] [⚙] [✕]
                 Yönet   : [←]  Profilleri Yönet  [Bitti] [⚙] [✕]
                 ════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="24,8" ColumnDefinitions="*,Auto">

                <!-- ── NORMAL MOD başlığı ── -->
                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                      IsVisible="{Binding !IsManageMode}"
                      VerticalAlignment="Center">

                    <!-- Ortada: uygulama logosu (mobildeki görsel hiyerarşi) -->
                    <Image Grid.Column="0"
                           Grid.ColumnSpan="4"
                           Source="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LogoThemeConverter}}"
                           Width="48" Height="48"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <!-- Sağ: Kalem (yönet modunu aç/kapa) -->
                    <Button Grid.Column="1"
                            Classes="HeaderIconBtn"
                            Click="ToggleManage_Click"
                            Margin="4,0,0,0"
                            ToolTip.Tip="{loc:Translate Profiles.ManageMode.Manage}"
                            IsVisible="{Binding Profiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    </Button>

                    <!-- Settings -->
                    <Button Grid.Column="2"
                            Classes="SettingsButtonStyle"
                            Click="SettingsButton_Click"
                            Margin="4,0,0,0"
                            ToolTip.Tip="{loc:Translate Profiles.Settings.Tooltip}"/>

                    <!-- Close -->
                    <Button Grid.Column="3"
                            Classes="CloseButtonStyle"
                            Click="Close_Click"
                            Margin="4,0,0,0"
                            ToolTip.Tip="{loc:Translate Profiles.Close.Tooltip}"/>
                </Grid>

                <!-- ── YÖNET MOD başlığı ── -->
                <Grid ColumnDefinitions="*,Auto,*,Auto,Auto"
                      IsVisible="{Binding IsManageMode}"
                      VerticalAlignment="Center">

                    <!-- Sol: Geri ok butonu -->
                    <Button Grid.Column="0"
                            Classes="DoneBtn"
                            Click="ToggleManage_Click"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="ChevronLeft" Width="20" Height="20"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                        VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Orta: "Profilleri Yönet" -->
                    <TextBlock Grid.Column="1"
                               Text="{loc:Translate Profiles.ManageMode.Title}"
                               FontSize="{DynamicResource FTitleL}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"
                               VerticalAlignment="Center"/>

                    <!-- Bitti -->
                    <Button Grid.Column="2"
                            Classes="DoneBtn"
                            MinWidth="80"
                            Click="ToggleManage_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="{loc:Translate Profiles.ManageMode.Done}"/>

                    <!-- Settings -->
                    <Button Grid.Column="3"
                            Classes="SettingsButtonStyle"
                            Click="SettingsButton_Click"
                            Margin="4,0,0,0"
                            ToolTip.Tip="{loc:Translate Profiles.Settings.Tooltip}"/>

                    <!-- Close -->
                    <Button Grid.Column="4"
                            Classes="CloseButtonStyle"
                            Click="Close_Click"
                            Margin="4,0,0,0"
                            ToolTip.Tip="{loc:Translate Profiles.Close.Tooltip}"/>
                </Grid>
            </Grid>

            <!-- ════════════════════════════════════════════════════════
                 SATIR 1 — KAYDIRILAB. İÇERİK
                 ════════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- "Kimin izlediğini seç?" büyük başlık (sadece normal modda) -->
                    <TextBlock Text="{loc:Translate Profiles.Title}"
                               FontSize="{DynamicResource HeaderHeight}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               Margin="16,60,16,8"
                               IsVisible="{Binding !IsManageMode}"/>

                    <TextBlock Text="{loc:Translate Profiles.SelectProfile}"
                               FontSize="18"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="24,0,24,32"
                               IsVisible="{Binding !IsManageMode}"/>

                    <!-- Yönet modu üst boşluk -->
                    <Border Height="20" IsVisible="{Binding IsManageMode}"/>

                    <!-- PROFİL KARTLARI + "Profil Ekle" -->
                    <ItemsControl x:Name="ProfileItemsControl"
                                  ItemsSource="{Binding DisplayItems}"
                                  MaxWidth="1050"
                                  HorizontalAlignment="Center"
                                  Margin="60,0,60,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center">
                                    <WrapPanel.Styles>
                                        <Style Selector="WrapPanel">
                                            <Setter Property="ItemWidth" Value="170"/>
                                            <Setter Property="ItemHeight" Value="230"/>
                                        </Style>
                                    </WrapPanel.Styles>
                                </WrapPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.DataTemplates>

                            <!-- 1. Mevcut profil kartı -->
                            <DataTemplate DataType="models:Profile">
                                <Button Classes="ProfileCardStyle"
                                        Click="SelectProfile_Click"
                                        Margin="8,8"/>
                            </DataTemplate>

                            <!-- 2. "Profil Ekle" kartı (sadece normal modda) -->
                            <DataTemplate DataType="vm:AddProfilePlaceholder">
                                <Button Classes="AddProfileButtonStyle"
                                        Click="AddProfile_Click"
                                        Margin="8,8"
                                        IsVisible="{Binding !#ProfilesWindowRoot.DataContext.IsManageMode}"/>
                            </DataTemplate>

                        </ItemsControl.DataTemplates>
                    </ItemsControl>

                    <!-- Yedek "Profil Ekle" butonu (yüklenme sırasında boş ekran) -->
                    <Button x:Name="FallbackAddProfileButton"
                            Classes="AddProfileButtonStyle"
                            Click="AddProfile_Click"
                            HorizontalAlignment="Center"
                            Margin="8,8"
                            IsVisible="{Binding DisplayItems.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}">
                    </Button>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>

</Window>
