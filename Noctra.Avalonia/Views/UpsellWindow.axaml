<Window x:Class="Noctra.Avalonia.Views.UpsellWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:loc="using:Noctra.Avalonia.Localization"
        mc:Ignorable="d"
        x:CompileBindings="False"
        Title="{Binding [Upsell.Title], Source={x:Static loc:LocalizationSource.Instance}}" Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SystemDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="{StaticResource DefaultFontFamily}">

    <Window.Styles>
        <!-- Buy Button -->
        <Style Selector="Button.BuyBtn">
            <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.BuyBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Close Button Style (Matching ProfilesWindow) -->
        <Style Selector="Button.CloseButtonStyle">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="CloseBg" Background="{TemplateBinding Background}" CornerRadius="20">
                        <materialIcons:MaterialIcon x:Name="CloseIcon" Kind="Close" Width="20" Height="20"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ Border#CloseBg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ materialIcons|MaterialIcon#CloseIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Dismiss Button -->
        <Style Selector="Button.DismissBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.DismissBtn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="{DynamicResource RadiusLarge}"
            ClipToBounds="True"
            Background="{DynamicResource BackgroundGradientBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1">
        <Grid>
            <!-- Decorative Elements -->
            <Ellipse Width="400" Height="400" Fill="{DynamicResource AccentBrush}" Opacity="0.08"
                     VerticalAlignment="Top" HorizontalAlignment="Right" Margin="-100"/>
            <Ellipse Width="300" Height="300" Fill="{DynamicResource GlowBrush}" Opacity="0.04"
                     VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-50"/>

            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,8">
                        <materialIcons:MaterialIcon Kind="Crown" Width="20" Height="20" Foreground="{DynamicResource AccentLightBrush}"/>
                        <TextBlock Text="{Binding [Upsell.Badge], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding [Upsell.Headline], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="36" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding [Upsell.Subheadline], Source={x:Static loc:LocalizationSource.Instance}}"
                               FontSize="16" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- COMPARISON -->
                <Grid Grid.Row="1" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FREE CARD -->
                    <Border Grid.Column="0" Background="{DynamicResource Surface0Brush}" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <TextBlock Text="{Binding [Upsell.Free.Title], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding [Upsell.Free.Subtitle], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                            <StackPanel Margin="0,0,0,8" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Free.Feature1], Source={x:Static loc:LocalizationSource.Instance}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Free.Feature2], Source={x:Static loc:LocalizationSource.Instance}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Free.Feature3], Source={x:Static loc:LocalizationSource.Instance}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Free.Feature4], Source={x:Static loc:LocalizationSource.Instance}}" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PREMIUM CARD -->
                    <Border Grid.Column="2" CornerRadius="12" Padding="24" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                            Background="{DynamicResource PremiumCardBackgroundBrush}"
                            BoxShadow="0 0 30 0 #33A855F7">

                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding [Upsell.Premium.Title], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PremiumCardForegroundBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Subtitle], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="{Binding [Upsell.Premium.Recommended], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                            
                            <StackPanel Margin="0,0,0,8" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="{DynamicResource PremiumCardForegroundBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature1], Source={x:Static loc:LocalizationSource.Instance}}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="{DynamicResource PremiumCardForegroundBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature2], Source={x:Static loc:LocalizationSource.Instance}}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="{DynamicResource PremiumCardForegroundBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature3], Source={x:Static loc:LocalizationSource.Instance}}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="{DynamicResource PremiumCardForegroundBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature4], Source={x:Static loc:LocalizationSource.Instance}}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="{DynamicResource PremiumCardForegroundBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature5], Source={x:Static loc:LocalizationSource.Instance}}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="{DynamicResource PremiumCardForegroundBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature6], Source={x:Static loc:LocalizationSource.Instance}}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="{DynamicResource PremiumCardForegroundBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature7], Source={x:Static loc:LocalizationSource.Instance}}" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- FOOTER / ACTIONS -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                    <Button Click="Buy_Click" Width="320" Height="56"
                            Classes="BuyBtn">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Crown" Width="20" Height="20" Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding [Upsell.Action.Buy], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding [Upsell.Action.Buy.Price], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="16" FontWeight="Normal" Foreground="White" Opacity="0.9"/>
                        </StackPanel>
                    </Button>

                    <Button Content="{Binding [Upsell.Action.Dismiss], Source={x:Static loc:LocalizationSource.Instance}}" Click="ContinueFree_Click"
                            Classes="DismissBtn" Margin="0,20,0,0"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Close Button -->
            <Button Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20"
                    Classes="CloseButtonStyle" ToolTip.Tip="{Binding [Upsell.Action.Close], Source={x:Static loc:LocalizationSource.Instance}}"/>
        </Grid>
    </Border>
</Window>
