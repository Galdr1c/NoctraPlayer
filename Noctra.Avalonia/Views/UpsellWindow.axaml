<Window x:Class="Noctra.Avalonia.Views.UpsellWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:loc="using:Noctra.Avalonia.Localization"
        mc:Ignorable="d"
        x:CompileBindings="False"
        Title="{Binding [Upsell.Title], Source={x:Static loc:LocalizationSource.Instance}}" Height="520" Width="760"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        WindowDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
>

    <Window.Styles>

        <!-- Close Button Style (Matching ProfilesWindow) -->
        <Style Selector="Button.CloseButtonStyle">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="CloseBg" Background="{TemplateBinding Background}" CornerRadius="12">
                        <materialIcons:MaterialIcon x:Name="CloseIcon" Kind="Close" Width="18" Height="18"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ Border#CloseBg">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>
        <Style Selector="Button.CloseButtonStyle:pointerover /template/ materialIcons|MaterialIcon#CloseIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Dismiss Button -->
        <Style Selector="Button.DismissBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="Button.DismissBtn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="8"
            ClipToBounds="True"
            Background="{DynamicResource BackgroundGradientBrush}"
            BorderBrush="{DynamicResource PremiumBadgeBrush}"
            BorderThickness="1">
        <Grid>
            <Ellipse Width="300" Height="300" Fill="{DynamicResource AccentBrush}" Opacity="0.07"
                     VerticalAlignment="Top" HorizontalAlignment="Right" Margin="-80"/>
            <Ellipse Width="240" Height="240" Fill="{DynamicResource GlowBrush}" Opacity="0.04"
                     VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-55"/>

            <Grid Margin="28,22,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,0,0,4">
                        <materialIcons:MaterialIcon Kind="Crown" Width="17" Height="17" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding [Upsell.Badge], Source={x:Static loc:LocalizationSource.Instance}}"
                                   FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding [Upsell.Headline], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding [Upsell.Subheadline], Source={x:Static loc:LocalizationSource.Instance}}"
                               FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Surface0Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="{Binding [Upsell.Free.Title], Source={x:Static loc:LocalizationSource.Instance}}"
                                       FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding [Upsell.Free.Subtitle], Source={x:Static loc:LocalizationSource.Instance}}"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,12"/>

                            <StackPanel Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="Check" Width="15" Height="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Free.Feature1], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="Check" Width="15" Height="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Free.Feature2], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="Check" Width="15" Height="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Free.Feature3], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="Check" Width="15" Height="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Free.Feature4], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            CornerRadius="8"
                            Padding="18"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource PremiumBadgeBrush}"
                            Background="{DynamicResource PremiumCardBackgroundBrush}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding [Upsell.Premium.Title], Source={x:Static loc:LocalizationSource.Instance}}"
                                               FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PremiumCardForegroundBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Subtitle], Source={x:Static loc:LocalizationSource.Instance}}"
                                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,10"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="{DynamicResource PremiumBadgeBrush}" CornerRadius="6" Padding="7,3">
                                    <TextBlock Text="{Binding [Upsell.Premium.Recommended], Source={x:Static loc:LocalizationSource.Instance}}"
                                               FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PremiumBadgeTextBrush}"/>
                                </Border>
                            </Grid>

                            <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="Check" Width="14" Height="14" Foreground="{DynamicResource AccentLightBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature1], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="12" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="Check" Width="14" Height="14" Foreground="{DynamicResource AccentLightBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature2], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="12" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="Check" Width="14" Height="14" Foreground="{DynamicResource AccentLightBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature3], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="12" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="Check" Width="14" Height="14" Foreground="{DynamicResource AccentLightBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature4], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="12" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="Check" Width="14" Height="14" Foreground="{DynamicResource AccentLightBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature5], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="12" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="Check" Width="14" Height="14" Foreground="{DynamicResource AccentLightBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature6], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="12" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="Check" Width="14" Height="14" Foreground="{DynamicResource AccentLightBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature7], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="12" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="Check" Width="14" Height="14" Foreground="{DynamicResource AccentLightBrush}"/>
                                    <TextBlock Text="{Binding [Upsell.Premium.Feature8], Source={x:Static loc:LocalizationSource.Instance}}" FontSize="12" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" HorizontalAlignment="Stretch">
                    <Button Click="Buy_Click" Theme="{StaticResource UpgradeButton}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Crown" Width="17" Height="17" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding [Upsell.Action.Buy], Source={x:Static loc:LocalizationSource.Instance}}"
                                       FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Content="{Binding [Upsell.Action.Dismiss], Source={x:Static loc:LocalizationSource.Instance}}" Click="ContinueFree_Click"
                            Classes="DismissBtn" Margin="0,5,0,0"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Button Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                    Classes="CloseButtonStyle" ToolTip.Tip="{Binding [Upsell.Action.Close], Source={x:Static loc:LocalizationSource.Instance}}"/>
        </Grid>
    </Border>
</Window>
