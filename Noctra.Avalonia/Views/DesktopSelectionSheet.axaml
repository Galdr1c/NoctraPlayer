<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctra.Avalonia.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Avalonia.Views.DesktopSelectionSheet"
             x:CompileBindings="False"
             IsVisible="False">
  <Grid>
    <Border x:Name="ScrimLayer"
            Background="{DynamicResource OverlayDimBrush}"
            PointerPressed="Scrim_PointerPressed" />
    <Border x:Name="SheetSurface"
            Classes="DesktopSheetSurface"
            MaxWidth="{DynamicResource DesktopSheetMaxWidth}"
            MaxHeight="620"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">
      <Border.RenderTransform>
        <TranslateTransform />
      </Border.RenderTransform>
      <Grid RowDefinitions="Auto,*">
        <Grid RowDefinitions="24,Auto" Margin="0,0,0,10">
          <Border x:Name="DragHandle"
                  Height="24"
                  Background="Transparent"
                  PointerPressed="DragHandle_PointerPressed"
                  PointerMoved="DragHandle_PointerMoved"
                  PointerReleased="DragHandle_PointerReleased"
                  PointerCaptureLost="DragHandle_PointerCaptureLost">
            <Border Width="44" Height="4"
                    Background="{DynamicResource BorderBrush}"
                    CornerRadius="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="TitleTextBlock"
                       Classes="DesktopSheetTitle"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="iconBtn"
                    Width="44" Height="44"
                    Click="Close_Click"
                    AutomationProperties.Name="{loc:Translate Common.Close}">
              <icons:MaterialIcon Kind="Close" Width="21" Height="21" />
            </Button>
          </Grid>
        </Grid>
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Options}"
                 Classes="DesktopSelectionList"
                 SelectionChanged="ClearTransientSelection"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel CacheLength="1" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Button Classes="DesktopSheetOption"
                      Tag="{Binding}"
                      Click="Option_Click">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                  <TextBlock Text="{Binding Label}"
                             FontSize="15"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                  <Grid Grid.Column="1" Width="32" Height="32">
                    <icons:MaterialIcon Kind="RadioboxMarked"
                                        Width="21" Height="21"
                                        Foreground="{DynamicResource AccentBrush}"
                                        IsVisible="{Binding ShowSelectionMark}" />
                    <icons:MaterialIcon Kind="LockOutline"
                                        Width="19" Height="19"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        IsVisible="{Binding IsLocked}" />
                  </Grid>
                </Grid>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
