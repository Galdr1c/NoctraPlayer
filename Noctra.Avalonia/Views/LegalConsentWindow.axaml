<Window x:Class="Noctra.Avalonia.Views.LegalConsentWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:loc="using:Noctra.Avalonia.Localization"
        x:CompileBindings="False"
        Title="{loc:Translate LegalConsent.Title}"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="False"
        SystemDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="{StaticResource DefaultFontFamily}">

    <Window.Styles>
        <Style Selector="Button.LegalConsentPrimary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.LegalConsentPrimary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
        </Style>
        <Style Selector="Button.LegalConsentPrimary:disabled">
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <Style Selector="Button.LegalConsentSecondary">
            <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.LegalConsentSecondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource BackgroundGradientBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.5"
            CornerRadius="16"
            ClipToBounds="True"
            BoxShadow="0 12 32 0 #90000000">
        <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16" PointerPressed="Header_PointerPressed">
                <materialIcons:MaterialIcon Grid.Column="0"
                                            Kind="ShieldCheckOutline"
                                            Width="30"
                                            Height="30"
                                            Foreground="{DynamicResource AccentLightBrush}"
                                            VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{loc:Translate LegalConsent.Title}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="21"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="12,0,0,0"/>
                <Button Grid.Column="2"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Decline_Click">
                    <materialIcons:MaterialIcon Kind="Close"
                                                Width="18"
                                                Height="18"
                                                Foreground="{DynamicResource TextMutedBrush}"/>
                </Button>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{loc:Translate LegalConsent.Message}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="14"
                       LineHeight="21"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18"/>

            <Border Grid.Row="2"
                    Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,18">
                <StackPanel>
                    <CheckBox x:Name="TermsAcceptedCheckBox"
                              Content="{loc:Translate LegalConsent.Check.Terms}"
                              Checked="RequiredCheckBox_Changed"
                              Unchecked="RequiredCheckBox_Changed"/>
                    <CheckBox x:Name="NoContentCheckBox"
                              Content="{loc:Translate LegalConsent.Check.NoContent}"
                              Checked="RequiredCheckBox_Changed"
                              Unchecked="RequiredCheckBox_Changed"/>
                    <CheckBox x:Name="LawfulSourcesCheckBox"
                              Content="{loc:Translate LegalConsent.Check.LawfulSources}"
                              Checked="RequiredCheckBox_Changed"
                              Unchecked="RequiredCheckBox_Changed"/>
                    <CheckBox x:Name="PrivacyAcceptedCheckBox"
                              Content="{loc:Translate LegalConsent.Check.Privacy}"
                              Checked="RequiredCheckBox_Changed"
                              Unchecked="RequiredCheckBox_Changed"/>
                    <CheckBox x:Name="DiagnosticDataCheckBox"
                              Content="{loc:Translate LegalConsent.Check.Diagnostics}"
                              Margin="0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0"
                        Classes="LegalConsentSecondary"
                        Click="Privacy_Click"
                        Content="{loc:Translate LegalConsent.Action.Privacy}"/>
                <Button Grid.Column="2"
                        Classes="LegalConsentSecondary"
                        Margin="0,0,10,0"
                        Click="Terms_Click"
                        Content="{loc:Translate LegalConsent.Action.Terms}"/>
                <Button x:Name="ContinueButton"
                        Grid.Column="3"
                        Classes="LegalConsentPrimary"
                        IsEnabled="False"
                        Click="Continue_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="Check" Width="17" Height="17" Foreground="White"/>
                        <TextBlock Text="{loc:Translate LegalConsent.Action.Continue}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
