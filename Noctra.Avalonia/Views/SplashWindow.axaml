<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Noctra.Avalonia.Controls"
        xmlns:loc="using:Noctra.Avalonia.Localization"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="300"
        x:Class="Noctra.Avalonia.Views.SplashWindow"
        Icon="avares://Noctra.Avalonia/Assets/Favicon.png"
        Title="Noctra"
        Width="450" Height="350"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="True"
        Topmost="False">

    <Panel>
        <!-- Consistent Background Gradient -->
        <Border CornerRadius="12" Background="{DynamicResource BackgroundGradientBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Margin="40" ClipToBounds="True">
            <Border.BoxShadow>
                <BoxShadows>0 10 40 10 #80000000</BoxShadows>
            </Border.BoxShadow>
            
            <Grid RowDefinitions="*,Auto,Auto">
                <!-- Top Section: Standard Themed Spinner -->
                <Panel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:PremiumSpinner>
                        <!-- Pulsing App Logo in Center -->
                        <Image Source="avares://Noctra.Avalonia/Assets/Logo2.png" 
                               Width="100" Height="100"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               RenderTransformOrigin="50%,50%">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Image.RenderTransform>
                            <Image.Styles>
                                <Style Selector="Image">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="CubicEaseInOut">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="Opacity" Value="0.5"/>
                                                <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                                                <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="50%">
                                                <Setter Property="Opacity" Value="1.0"/>
                                                <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                                                <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="Opacity" Value="0.5"/>
                                                <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                                                <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Image.Styles>
                        </Image>
                    </controls:PremiumSpinner>
                </Panel>

                <!-- Middle Section: Welcome -->
                <StackPanel Grid.Row="1" Margin="0,0,0,40" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Noctra IPTV" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding [Splash.Initializing], Source={x:Static loc:LocalizationSource.Instance}}" 
                               FontSize="14" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               HorizontalAlignment="Center"
                               Opacity="0.8"/>
                </StackPanel>

            </Grid>
        </Border>
    </Panel>
</Window>
