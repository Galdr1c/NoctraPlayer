<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:Noctra.Avalonia.Converters">
  <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  <converters:FavoriteConverter x:Key="FavoriteConverter" />
  <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
  <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
  <converters:ProfileColorConverter x:Key="ProfileColorConverter" />
  <converters:WidthToColumnsConverter x:Key="WidthToColumnsConverter" />
  <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
  <converters:PercentageThresholdToVisibilityConverter x:Key="PercentageThresholdToVisibilityConverter" />
  <converters:PercentageRangeToVisibilityConverter x:Key="PercentageRangeToVisibilityConverter" />
  <converters:WatchedProgressVisibilityConverter x:Key="WatchedProgressVisibilityConverter" />
  <converters:WatchedProgressWidthConverter x:Key="WatchedProgressWidthConverter" />
  <converters:EpisodeWatchedProgressVisibilityConverter x:Key="EpisodeWatchedProgressVisibilityConverter" />
  <converters:EpisodeWatchedProgressWidthConverter x:Key="EpisodeWatchedProgressWidthConverter" />
  <converters:EpisodeCompletionBadgeVisibilityConverter x:Key="EpisodeCompletionBadgeVisibilityConverter" />
  <converters:EpisodeIdentityConverter x:Key="EpisodeIdentityConverter" />
  <converters:MediaSupportsFavoriteConverter x:Key="MediaSupportsFavoriteConverter" />
  <converters:MediaSupportsMyListConverter x:Key="MediaSupportsMyListConverter" />
  <converters:BoolToStringConverter x:Key="BoolToStringConverter" />
  <converters:EqualityToBoolConverter x:Key="EqualityToBoolConverter" />
  <converters:EqualityToBrushConverter x:Key="EqualityToBrushConverter"
                                       TrueBrush="{StaticResource AccentBrush}"
                                       FalseBrush="Transparent" />
  <converters:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter" />
  <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
  <converters:AvatarPathConverter x:Key="AvatarPathConverter" />
  <converters:EqualityToBoolMultiConverter x:Key="EqualityToBoolMultiConverter" />
  <converters:AvatarExpressionConverter x:Key="AvatarExpressionConverter" />
  <converters:StringContainsConverter x:Key="StringContainsConverter" />
  <converters:BoolToPlayPauseIconConverter x:Key="BoolToPlayPauseIconConverter" />
  <converters:StringToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
  <converters:MediaThumbnailConverter x:Key="MediaThumbnailConverter" />
  <converters:BoolToIconConverter x:Key="BoolToIconConverter" />
  <converters:PercentToWidthConverter x:Key="PercentToWidthConverter" />
  <converters:DoubleToFloatConverter x:Key="DoubleToFloatConverter" />
  <converters:BitrateDisplayConverter x:Key="BitrateDisplayConverter" />
  <converters:PlayPauseIconConverter x:Key="PlayPauseIconConverter" />
  <converters:VolumeIconConverter x:Key="VolumeIconConverter" />
  <converters:ChannelTypeToVisibilityConverter x:Key="ChannelTypeToVisibilityConverter" />
  <converters:BoolToDoubleConverter x:Key="BoolToDoubleConverter" />
</ResourceDictionary>
