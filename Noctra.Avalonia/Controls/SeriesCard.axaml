<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:converters="using:Noctra.Avalonia.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:Noctra.Avalonia.Localization"
             x:Class="Noctra.Avalonia.Controls.SeriesCard"
             x:Name="SeriesCardControl"
             x:DataType="models:Series"
             Width="160" Height="240"
             ClipToBounds="False">
  <UserControl.Styles>
    <Style Selector="Button.CardContainer:pointerover">
      <Setter Property="ZIndex" Value="10"/>
      <Setter Property="RenderTransform" Value="scale(1.05)"/>
    </Style>
    <Style Selector="Button.CardContainer:pointerover Border.HoverOverlay">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Border.HoverOverlay">
      <Setter Property="Opacity" Value="0"/>
    </Style>
  </UserControl.Styles>

  <Button Classes="CardContainer" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
    
    <Button.ContextFlyout>
      <MenuFlyout>
        <MenuItem Header="{loc:Translate Context.MyList.Toggle}" Click="Context_AddToMyList_Click"
                  IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
        <MenuItem Header="{loc:Translate Context.Favorite.Toggle}" Click="Context_ToggleFavorite_Click"
                  IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
        <MenuItem Header="{loc:Translate History.Remove}" Click="Context_RemoveFromHistory_Click"
                  IsVisible="{Binding #SeriesCardControl.ShowHistoryMenu}">
          <MenuItem.Icon>
            <materialIcons:MaterialIcon Kind="DeleteOutline" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuFlyout>
    </Button.ContextFlyout>

    <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Surface0Brush}">
      <Grid>
        <!-- Poster Area Placeholder -->
        <Border x:Name="PlaceholderBorder" Width="160" Height="240" Background="{DynamicResource SurfaceLightBrush}">
          <Border.IsVisible>
            <Binding Path="#SeriesPoster.IsImageLoaded" Converter="{StaticResource InverseBoolConverter}"/>
          </Border.IsVisible>
        </Border>

        <controls:RemoteImage x:Name="SeriesPoster" Stretch="UniformToFill" Url="{Binding CoverUrl}" RenderOptions.BitmapInterpolationMode="MediumQuality"/>
        
        <!-- Hover Overlay -->
        <Border Classes="HoverOverlay" Background="#4D000000" />
        
        <!-- Bottom Section: Info -->
        <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="8">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding DisplayCategory}" Foreground="#A6FFFFFF" FontSize="10" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding DisplayCategory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Button>
</UserControl>