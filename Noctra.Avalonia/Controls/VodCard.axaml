<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:vm="using:Noctra.ViewModels"
             x:Class="Noctra.Avalonia.Controls.VodCard"
             x:DataType="models:Channel"
             Width="160" Height="240"
             ClipToBounds="False">
  <UserControl.Styles>
    <Style Selector="Button.CardContainer:pointerover">
      <Setter Property="ZIndex" Value="10"/>
    </Style>
    <Style Selector="Border.HoverOverlay">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.CardContainer:pointerover Border.HoverOverlay">
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </UserControl.Styles>

  <Button Classes="CardContainer" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}" CommandParameter="{Binding}">
    
    <Button.ContextFlyout>
      <MenuFlyout>
        <MenuItem Header="Listem'e Ekle/Çıkar" Click="Context_AddToMyList_Click"
                  IsVisible="{Binding ., Converter={StaticResource MediaSupportsMyListConverter}}"/>
        <MenuItem Header="Favorilere Ekle/Çıkar" Click="Context_ToggleFavorite_Click"
                  IsVisible="{Binding ., Converter={StaticResource MediaSupportsFavoriteConverter}}"/>
      </MenuFlyout>
    </Button.ContextFlyout>

    <Border CornerRadius="{DynamicResource RadiusSmall}" ClipToBounds="True" Background="{DynamicResource Surface0Brush}">
      <Grid>
        <!-- Poster (Medium Quality for scroll performance) -->
        <Border Background="{DynamicResource Surface1Brush}">
          <controls:RemoteImage Stretch="UniformToFill" Url="{Binding CoverUrl}" RenderOptions.BitmapInterpolationMode="MediumQuality"/>
        </Border>
        
        <!-- Hover Overlay -->
        <Border Classes="HoverOverlay" Background="#4D000000" />
        
        <!-- Bottom Section: Info + Progress -->
        <StackPanel VerticalAlignment="Bottom">
          <!-- Bottom Solid Overlay (Replaced Gradient for GPU Performance) -->
          <Border Background="#CC000000" Padding="8">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding ReleaseYear}" Foreground="#A6FFFFFF" FontSize="10" IsVisible="{Binding ReleaseYear, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Ellipse Width="3" Height="3" Fill="#66FFFFFF" VerticalAlignment="Center" IsVisible="{Binding ReleaseYear, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <TextBlock Text="{Binding GroupTitle}" Foreground="#A6FFFFFF" FontSize="10" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Progress Bar -->
          <ProgressBar Height="4" CornerRadius="0" Minimum="0" Maximum="100" Value="{Binding WatchedPercentage}"
                       Foreground="{DynamicResource AccentBrush}" Background="#4D000000" BorderThickness="0"
                       IsVisible="{Binding ., Converter={StaticResource WatchedProgressVisibilityConverter}}" />
        </StackPanel>

        <!-- Top Rating -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6" Background="#B3000000" CornerRadius="3" Padding="4,2"
                IsVisible="{Binding Rating, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}" Foreground="{DynamicResource SuccessBrush}" FontSize="10" FontWeight="Bold"/>
        </Border>
      </Grid>
    </Border>
  </Button>
</UserControl>