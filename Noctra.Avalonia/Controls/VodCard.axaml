<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:Noctra.Avalonia.Localization"
             x:Class="Noctra.Avalonia.Controls.VodCard"
             x:Name="VodCardControl"
             x:DataType="models:Channel"
             MinWidth="148" MinHeight="222"
             ClipToBounds="False">
  <UserControl.Styles>
    <Style Selector="controls|DesktopPressableCard.CardContainer">
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="controls|DesktopPressableCard.CardContainer:pointerover">
      <Setter Property="ZIndex" Value="10"/>
      <Setter Property="RenderTransform" Value="scale(1.035)"/>
    </Style>
    <Style Selector="controls|DesktopPressableCard.CardContainer:focus">
      <Setter Property="ZIndex" Value="10"/>
      <Setter Property="RenderTransform" Value="scale(1.035)"/>
    </Style>
    <Style Selector="controls|DesktopPressableCard.CardContainer:pointerover Border.HoverOverlay">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="controls|DesktopPressableCard.CardContainer:focus Border.HoverOverlay">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="controls|DesktopPressableCard.CardContainer:pressed">
      <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>
    <Style Selector="controls|DesktopPressableCard.CardContainer:command-disabled">
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="Border.HoverOverlay">
      <Setter Property="Opacity" Value="0"/>
    </Style>
  </UserControl.Styles>
  <controls:DesktopPressableCard Classes="CardContainer"
                                   CardRightTapped="OnCardRightTapped"
                                   Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                                   CommandParameter="{Binding}"
                                   AutomationProperties.Name="{Binding Name}"
                                   Padding="0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  MinWidth="148" MinHeight="222">
    <Border CornerRadius="0" ClipToBounds="True" Background="{DynamicResource PlaceHolderBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0">
      <Grid>
        <Border Background="{DynamicResource PlaceHolderBrush}">
        <Image Grid.ColumnSpan="2"
                       Source="{Binding ActualThemeVariant, RelativeSource={RelativeSource Self}, Converter={StaticResource LogoThemeConverter}, ConverterParameter=Full}}"
                       Width="72" Height="72"
                       Stretch="Uniform"
                       Opacity="0.12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" /> 
          <Border.IsVisible><Binding Path="#PosterImage.IsImageLoaded" Converter="{StaticResource InverseBoolConverter}"/></Border.IsVisible>
        </Border>
        <controls:RemoteImage x:Name="PosterImage" Stretch="UniformToFill" Url="{Binding CoverUrl}" RenderOptions.BitmapInterpolationMode="MediumQuality"/>
        <Border Classes="HoverOverlay" Background="#45000000"/>
        <StackPanel VerticalAlignment="Bottom">
          <Border Background="#D9000000" Padding="10,9">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding ReleaseYear}" Foreground="#B3FFFFFF" FontSize="10" IsVisible="{Binding ReleaseYear, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <TextBlock Text="{Binding GroupTitle}" Foreground="#B3FFFFFF" FontSize="10" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <ProgressBar Height="5" CornerRadius="0" Minimum="0" Maximum="100" Value="{Binding WatchedPercentage}"
                       Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ThemePreviewDarkText}" BorderThickness="0"
                       IsVisible="{Binding ., Converter={StaticResource WatchedProgressVisibilityConverter}}">

            <ProgressBar.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="#VodCardControl.ShowHistoryMenu" />
                <Binding Path="." Converter="{StaticResource WatchedProgressVisibilityConverter}" />
              </MultiBinding>
            </ProgressBar.IsVisible>
          </ProgressBar>               
        </StackPanel>
      </Grid>
    </Border>
  </controls:DesktopPressableCard>
</UserControl>
