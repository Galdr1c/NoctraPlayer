<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:Noctra.Avalonia.Localization"
             x:Class="Noctra.Avalonia.Controls.LiveTvCard"
             x:Name="LiveTvCardControl"
             x:DataType="models:Channel"
             MinWidth="260" MinHeight="85"
             HorizontalAlignment="Stretch" ClipToBounds="False">
  <UserControl.Styles>
    <Style Selector="Button.CardContainer">
      <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
      <Style Selector="Button.CardContainer:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.FavoriteBtn">
      <Setter Property="Opacity" Value="0.55"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.FavoriteBtn:pointerover">
      
    </Style>
    <Style Selector="Button.FavoriteBtn.active">
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </UserControl.Styles>
  <Button Classes="CardContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
          CommandParameter="{Binding}">
    <Button.ContextFlyout>
      <MenuFlyout>
        <MenuItem Header="{loc:Translate Context.MyList.Toggle}" Click="Context_AddToMyList_Click"/>
        <MenuItem Header="{loc:Translate Context.Favorite.Toggle}" Click="Context_ToggleFavorite_Click"/>
        <MenuItem Header="{loc:Translate History.Remove}" Click="Context_RemoveFromHistory_Click"
                  IsVisible="{Binding #LiveTvCardControl.ShowHistoryMenu}"/>
        <MenuItem Header="{loc:Translate History.Remove}" Click="Context_RemoveFromFavorites_Click"
                  IsVisible="{Binding #LiveTvCardControl.ShowRemoveFavoriteMenu}"/>
        <MenuItem Header="{loc:Translate History.Remove}" Click="Context_RemoveFromMyList_Click"
                  IsVisible="{Binding #LiveTvCardControl.ShowRemoveMyListMenu}"/>
      </MenuFlyout>
    </Button.ContextFlyout>
    <Grid RowDefinitions="*,Auto,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="48,*,Auto" VerticalAlignment="Center">
        <Border Grid.Column="0" Width="46" Height="46" Background="{DynamicResource PlaceHolderBrush}">
          <Grid>
            <Border Background="{DynamicResource PlaceHolderBrush}">
              <Border.IsVisible>
                <Binding Path="#ChannelLogo.IsImageLoaded" Converter="{StaticResource InverseBoolConverter}"/>
              </Border.IsVisible>
            </Border>
            <controls:RemoteImage x:Name="ChannelLogo" Width="46" Height="46" Stretch="Uniform" Url="{Binding CoverUrl}" RenderOptions.BitmapInterpolationMode="MediumQuality"/>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0" Spacing="3">
          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button Grid.Column="2" Classes="FavoriteBtn" Background="Transparent" BorderThickness="0" Padding="7"
                Classes.active="{Binding IsFavorite}"
                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                CommandParameter="{Binding}">
          <Panel>
            <materialIcons:MaterialIcon Kind="Heart" Width="20" Height="20" Foreground="#E50914" IsVisible="{Binding IsFavorite}"/>
            <materialIcons:MaterialIcon Kind="HeartOutline" Width="20" Height="20" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsFavorite}"/>
          </Panel>
        </Button>
      </Grid>
      <TextBlock Grid.Row="1" Text="{Binding CurrentProgramTitle}" Foreground="{DynamicResource TextMutedBrush}"
                 FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,4,0,4"
                 IsVisible="{Binding CurrentProgramTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
      <ProgressBar Grid.Row="2" Value="{Binding EpgProgress}" Minimum="0" Maximum="100" Height="3"
                   Background="{DynamicResource SurfaceLightBrush}" Foreground="{DynamicResource AccentBrush}" CornerRadius="1"
                   IsVisible="{Binding CurrentProgramTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
    </Grid>
  </Button>
</UserControl>
