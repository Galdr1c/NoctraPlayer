<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctra.Models"
             xmlns:controls="using:Noctra.Avalonia.Controls"
             xmlns:vm="using:Noctra.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:Noctra.Avalonia.Localization"
             x:Class="Noctra.Avalonia.Controls.LiveTvCard"
             x:Name="LiveTvCardControl"
             x:DataType="models:Channel"
             MinWidth="260" MinHeight="85"
             HorizontalAlignment="Stretch" ClipToBounds="False">
  <UserControl.Styles>
    <Style Selector="controls|DesktopPressableCard.CardContainer">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="controls|DesktopPressableCard.CardContainer:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="controls|DesktopPressableCard.CardContainer:pressed">
      <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>
    <Style Selector="Button.CardContentBtn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.CardContentBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.CardContentBtn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
    </Style>
    <Style Selector="Button.FavoriteBtn">
      <Setter Property="Opacity" Value="0.55"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.FavoriteBtn:pointerover">
      
    </Style>
    <Style Selector="Button.FavoriteBtn.active">
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </UserControl.Styles>
  <controls:DesktopPressableCard Classes="CardContainer"
                                   CardRightTapped="OnCardRightTapped"
                                   Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                                   CommandParameter="{Binding}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch">
    <Grid RowDefinitions="*,Auto,Auto">
      <Button x:Name="PlaybackButton"
              Grid.RowSpan="3"
              Classes="CardContentBtn"
              Margin="0"
              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMediaCommand}"
              CommandParameter="{Binding}"/>

      <Grid Grid.RowSpan="3"
            RowDefinitions="*,Auto,Auto"
            IsHitTestVisible="False">
        <Grid Grid.Row="0"
              ColumnDefinitions="48,*,48"
              VerticalAlignment="Center">
          <Border Grid.Column="0"
                  Width="46"
                  Height="46"
                  Background="{DynamicResource PlaceHolderBrush}">
            <Grid>
              <Border Background="{DynamicResource PlaceHolderBrush}">
                <Border.IsVisible>
                  <Binding Path="#ChannelLogo.IsImageLoaded"
                           Converter="{StaticResource InverseBoolConverter}"/>
                </Border.IsVisible>
              </Border>
              <controls:RemoteImage x:Name="ChannelLogo"
                                    Width="46"
                                    Height="46"
                                    Stretch="Uniform"
                                    Url="{Binding CoverUrl}"
                                    RenderOptions.BitmapInterpolationMode="MediumQuality"/>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1"
                      Margin="14,0,0,0"
                      VerticalAlignment="Center"
                      Spacing="3">
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding CurrentProgramTitle}" Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Opacity="0.85"
                   IsVisible="{Binding CurrentProgramTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
        <ProgressBar Grid.Row="2" Value="{Binding EpgProgress}" Minimum="0" Maximum="100" Height="3"
                     Background="{DynamicResource SurfaceLightBrush}" Foreground="{DynamicResource AccentBrush}" CornerRadius="1.5"
                     IsVisible="{Binding CurrentProgramTitle, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
      </Grid>

      <Button Grid.Row="0"
              Classes="FavoriteBtn"
              Width="44"
              Height="44"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Background="Transparent"
              BorderThickness="0"
              Padding="7"
              Classes.active="{Binding IsFavorite}"
              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
              CommandParameter="{Binding}">
        <Panel>
          <materialIcons:MaterialIcon Kind="Heart" Width="20" Height="20" Foreground="#E50914" IsVisible="{Binding IsFavorite}"/>
          <materialIcons:MaterialIcon Kind="HeartOutline" Width="20" Height="20" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsFavorite}"/>
        </Panel>
      </Button>
    </Grid>
  </controls:DesktopPressableCard>
</UserControl>
