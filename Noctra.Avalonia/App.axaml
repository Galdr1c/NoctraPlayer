<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.Avalonia.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://Noctra.UI/Resources/Themes/DarkTheme.axaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://Noctra.UI/Resources/Themes/DarkTheme.axaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://Noctra.UI/Resources/Themes/LightTheme.axaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Noctra.UI/Resources/Tokens.axaml" />
        <ResourceInclude Source="avares://Noctra.UI/Resources/Colors.axaml" />
        <ResourceInclude Source="avares://Noctra/Resources/DesktopAdaptiveTokens.axaml" />
        <ResourceInclude Source="avares://Noctra/Resources/Converters.axaml" />
        <ResourceInclude Source="avares://Noctra.UI/Resources/Styles.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <materialIcons:MaterialIconStyles />
    <FluentTheme />
    <StyleInclude Source="avares://Noctra.UI/Controls/PremiumSpinner.axaml" />
    <StyleInclude Source="avares://Noctra.UI/Resources/CommonStyles.axaml" />
    <StyleInclude Source="avares://Noctra.UI/Resources/SettingsStyles.axaml" />
    <StyleInclude Source="avares://Noctra/Resources/DesktopStyleOverrides.axaml" />
    <StyleInclude Source="avares://Noctra/Controls/PremiumSpinner.axaml" />
  </Application.Styles>
</Application>
