## Ignore Visual Studio temporary files, build results, local secrets, and
## generated project artifacts.

# Local secrets and environment files
.env
.env.*
!.env.example
*.local.env
local.settings.json
appsettings.Development.json
appsettings.Local.json
secrets.json
*.pem
*.pfx
*.key
*.crt
*.cer
Noctra.Mobile/Services/MobileAppConfig.cs

# Vercel / Upstash / TMDB proxy local state
.vercel/
vercel.json.local
.upstash/
upstash.json
tmdb-proxy/.env
tmdb-proxy/.env.*
**/tmdb-proxy/.env
**/tmdb-proxy/.env.*

# Provider playlists and generated metadata
*.MetadataService.cs
*.m3u
*.m3u8
*.xmltv
*.epg.xml
providers.json

# Local-only assets and MSIX packaging (never push)
Noctra.Avalonia/Assets/
Noctra.Packaging/

