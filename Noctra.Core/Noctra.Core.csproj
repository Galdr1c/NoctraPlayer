<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Noctra.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Noctra</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Noctra.Mobile</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Noctra.PromoEndpoint" Value="$(NOCTRA_PROMO_CODES_URL)" Condition="'$(NOCTRA_PROMO_CODES_URL)' != ''" />
    <AssemblyMetadata Include="Noctra.BillingVerifyUrl" Value="$(NOCTRA_BILLING_VERIFY_URL)" Condition="'$(NOCTRA_BILLING_VERIFY_URL)' != ''" />
    <AssemblyMetadata Include="Noctra.BillingApiKey" Value="$(NOCTRA_BILLING_API_KEY)" Condition="'$(NOCTRA_BILLING_API_KEY)' != ''" />
  </ItemGroup>

  <Target Name="LoadPromoEndpointFromDotEnv" BeforeTargets="GetAssemblyAttributes" Condition="'$(Configuration)' == 'Release' and '$(NOCTRA_PROMO_CODES_URL)' == '' and Exists('$(MSBuildThisFileDirectory)..\.env')">
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)..\.env">
      <Output TaskParameter="Lines" ItemName="_PromoEnvLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"
                         Condition="$([System.String]::Copy('%(_PromoEnvLine.Identity)').StartsWith('NOCTRA_PROMO_CODES_URL='))">
        <_Parameter1>Noctra.PromoEndpoint</_Parameter1>
        <_Parameter2>$([System.String]::Copy('%(_PromoEnvLine.Identity)').Remove(0, 23))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <Target Name="LoadBillingEndpointFromDotEnv" BeforeTargets="GetAssemblyAttributes" Condition="'$(Configuration)' == 'Release' and '$(NOCTRA_BILLING_VERIFY_URL)' == '' and Exists('$(MSBuildThisFileDirectory)..\.env')">
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)..\.env">
      <Output TaskParameter="Lines" ItemName="_BillingEnvLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"
                         Condition="$([System.String]::Copy('%(_BillingEnvLine.Identity)').StartsWith('NOCTRA_BILLING_VERIFY_URL='))">
        <_Parameter1>Noctra.BillingVerifyUrl</_Parameter1>
        <_Parameter2>$([System.String]::Copy('%(_BillingEnvLine.Identity)').Remove(0, 26))</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"
                         Condition="$([System.String]::Copy('%(_BillingEnvLine.Identity)').StartsWith('NOCTRA_BILLING_API_KEY='))">
        <_Parameter1>Noctra.BillingApiKey</_Parameter1>
        <_Parameter2>$([System.String]::Copy('%(_BillingEnvLine.Identity)').Remove(0, 23))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LibVLCSharp" Version="3.9.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Translations\*.json" />
  </ItemGroup>

</Project>

