[TEMPLATE]
# Build-time promosyon kodu JSON adresi (release). Deger bos birakilabilir;
# bos ise Release build'lerinde promosyon kodu akisi "yapilandirma bulunamadi"
# hatasiyla kapanir. DEBUG build'lerinde calisma zamaninda da okunur.
NOCTRA_PROMO_CODES_URL=

# Play Billing dogrulama backend'i (Noctra.Billing.Api) adresi (release).
# deploy-billing.sh / deploy-billing.ps1 burayi otomatik doldurur.
# Bos ise Release build'lerinde magaza dogrulamasi devre disi kalir.
NOCTRA_BILLING_VERIFY_URL=

# Opsiyonel paylasilan anahtar (backend'de NOCTRA_BILLING_API_KEY ile eslesmeli).
NOCTRA_BILLING_API_KEY=
