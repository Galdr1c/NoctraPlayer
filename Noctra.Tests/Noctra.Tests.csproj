<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- HotAvalonia's Debug-only dependency graph brings both the .NET 8 and
         .NET 9 System.Reflection.Metadata reference assemblies into this test
         host. The test binary uses the primary .NET 8 reference; MSBuild's
         duplicate-reference diagnostic is an upstream tooling conflict. -->
    <!-- Test doubles deliberately pass nulls, expose legacy compatibility
         properties, and declare interface-only events; these are exercised
         fixture shapes rather than production diagnostics. xUnit analyzer
         rules also flag intentional synchronous command probes. -->
    <NoWarn>$(NoWarn);MSB3277;CS0067;CS0168;CS0618;CS8601;CS8602;CS8604;CS8625;Xunit1031;Xunit1026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noctra.Core\Noctra.Core.csproj" />
    <ProjectReference Include="..\Noctra.UI\Noctra.UI.csproj" />
    <ProjectReference Include="..\Noctra.Avalonia\Noctra.Avalonia.csproj" />
    <ProjectReference Include="..\tools\Noctra.Performance\Noctra.Performance.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure overscroll math is linked so it can be tested without referencing
         the Android/Avalonia mobile application project. -->
    <Compile Include="..\Noctra.Mobile\Behaviors\MobileOverscrollPhysics.cs"
             Link="Behaviors\MobileOverscrollPhysics.cs" />
    <!-- Pure EPG geometry stays in the mobile presentation layer while remaining
         directly testable from the Core test project. -->
    <Compile Include="..\Noctra.Mobile\ViewModels\MobileEpgTimelineGeometry.cs"
             Link="ViewModels\MobileEpgTimelineGeometry.cs" />
    <!-- The guide presentation state is pure C# and is linked into the test
         project so selection/focus behavior can be exercised without an
         Android visual tree. -->
    <Compile Include="..\Noctra.Mobile\ViewModels\MobileEpgGuidePresentation.cs"
             Link="ViewModels\MobileEpgGuidePresentation.cs" />
<Compile Include="..\Noctra.Mobile\Services\MobileInputModeService.cs"
             Link="Services\MobileInputModeService.cs" />
    <Compile Include="..\Noctra.Mobile\Services\IMobileAdvertisingService.cs"
             Link="Services\IMobileAdvertisingService.cs" />
    <Compile Include="..\Noctra.Mobile\Services\BannerAdPresentationState.cs"
             Link="Services\BannerAdPresentationState.cs" />
    <Compile Include="..\Noctra.Mobile\Services\MobileAdvertisingBootstrapper.cs"
             Link="Services\MobileAdvertisingBootstrapper.cs" />
    <Compile Include="..\Noctra.Mobile\Services\MobileAppLifecycle.cs"
             Link="Services\MobileAppLifecycle.cs" />
    <Compile Include="..\Noctra.Mobile\Services\SharedImageLoadCoordinator.cs"
             Link="Services\SharedImageLoadCoordinator.cs" />
    <Compile Include="..\Noctra.Mobile\Services\MobileImageLoadPolicy.cs"
             Link="Services\MobileImageLoadPolicy.cs" />
    <Compile Include="..\Noctra.Mobile\Services\MobileImageDecodePolicy.cs"
             Link="Services\MobileImageDecodePolicy.cs" />
    <Compile Include="..\Noctra.Mobile\Controls\MobileRemoteImage.cs"
             Link="Controls\MobileRemoteImage.cs" />
    <Compile Include="..\Noctra.Mobile\Navigation\MobilePageNavigationStateStore.cs"
             Link="Navigation\MobilePageNavigationStateStore.cs" />
  </ItemGroup>

</Project>

