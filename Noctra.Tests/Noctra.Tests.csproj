<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noctra.Core\Noctra.Core.csproj" />
    <ProjectReference Include="..\Noctra.Avalonia\Noctra.Avalonia.csproj" />
    <ProjectReference Include="..\tools\Noctra.Performance\Noctra.Performance.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure overscroll math is linked so it can be tested without referencing
         the Android/Avalonia mobile application project. -->
    <Compile Include="..\Noctra.Mobile\Behaviors\MobileOverscrollPhysics.cs"
             Link="Behaviors\MobileOverscrollPhysics.cs" />
    <!-- Pure EPG geometry stays in the mobile presentation layer while remaining
         directly testable from the Core test project. -->
    <Compile Include="..\Noctra.Mobile\ViewModels\MobileEpgTimelineGeometry.cs"
             Link="ViewModels\MobileEpgTimelineGeometry.cs" />
    <!-- The guide presentation state is pure C# and is linked into the test
         project so selection/focus behavior can be exercised without an
         Android visual tree. -->
    <Compile Include="..\Noctra.Mobile\ViewModels\MobileEpgGuidePresentation.cs"
             Link="ViewModels\MobileEpgGuidePresentation.cs" />
    <Compile Include="..\Noctra.Mobile\Services\MobileInputModeService.cs"
             Link="Services\MobileInputModeService.cs" />
  </ItemGroup>

</Project>

