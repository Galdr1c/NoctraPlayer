<Window x:Class="IPTVPlayer.Views.GlobalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:IPTVPlayer.ViewModels;assembly=IPTVPlayer.Core"
        Title="Ayarlar" 
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#141414" 
            CornerRadius="12" 
            BorderBrush="#333333" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- ==========================================
                 HEADER
                 ========================================== -->
            <Grid Grid.Row="0" 
                  Margin="32,24,32,24"
                  Height="48">
                <TextBlock Text="Ayarlar" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
                
                <!-- Close Button -->
                <Button Content="×"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click"
                        FontSize="32"
                        Foreground="#999999"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="48" Height="48"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="24">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"
                                                Margin="0,-4,0,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#1A1A1A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ==========================================
                 CONTENT
                 ========================================== -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         Padding="32,0,32,32">
                <StackPanel MaxWidth="650">

                    <!-- APPEARANCE SECTION -->
                    <Border Background="#1A1A1A" 
                            CornerRadius="8" 
                            Padding="24"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Görünüm" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="White"
                                       Margin="0,0,0,20"/>

                            <!-- Theme Selection -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Tema"
                                               FontSize="16"
                                               Foreground="White"/>
                                    <TextBlock Text="Uygulamanın renklerini değiştirin"
                                               FontSize="13"
                                               Foreground="#808080"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Theme Options -->
                                <StackPanel Grid.Column="1" 
                                           Orientation="Horizontal">
                                    
                                    <!-- Dark Theme Button -->
                                    <Border x:Name="DarkThemeButton"
                                            Width="120" Height="80"
                                            CornerRadius="8"
                                            BorderThickness="3"
                                            BorderBrush="#7C3AED"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="DarkTheme_Click"
                                            Margin="0,0,12,0">
                                        <Grid>
                                            <Border Background="#141414" CornerRadius="5">
                                                <Grid>
                                                    <!-- Mini UI Preview -->
                                                    <Border Background="#1A1A1A" 
                                                           Width="90" Height="50"
                                                           CornerRadius="4"
                                                           Margin="15,15,15,15">
                                                        <StackPanel Margin="8">
                                                            <Rectangle Fill="White" Height="4" Width="40" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                            <Rectangle Fill="#666666" Height="3" Width="50" HorizontalAlignment="Left" Margin="0,0,0,3"/>
                                                            <Rectangle Fill="#666666" Height="3" Width="45" HorizontalAlignment="Left"/>
                                                        </StackPanel>
                                                    </Border>
                                                    
                                                    <!-- Checkmark -->
                                                    <Border Width="24" Height="24"
                                                           Background="#7C3AED"
                                                           CornerRadius="12"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top"
                                                           Margin="8">
                                                        <Path Data="M9,16.2L4.8,12l-1.4,1.4L9,19L21,7l-1.4-1.4L9,16.2z"
                                                             Fill="White"
                                                             Stretch="Uniform"
                                                             Width="14" Height="14"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="Koyu"
                                                      FontSize="12"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Bottom"
                                                      Margin="0,0,0,8"/>
                                        </Grid>
                                    </Border>

                                    <!-- Light Theme Button -->
                                    <Border x:Name="LightThemeButton"
                                            Width="120" Height="80"
                                            CornerRadius="8"
                                            BorderThickness="3"
                                            BorderBrush="Transparent"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="LightTheme_Click">
                                        <Grid>
                                            <Border Background="#F5F5F5" CornerRadius="5">
                                                <Grid>
                                                    <!-- Mini UI Preview -->
                                                    <Border Background="White" 
                                                           Width="90" Height="50"
                                                           CornerRadius="4"
                                                           Margin="15,15,15,15">
                                                        <StackPanel Margin="8">
                                                            <Rectangle Fill="#141414" Height="4" Width="40" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                            <Rectangle Fill="#999999" Height="3" Width="50" HorizontalAlignment="Left" Margin="0,0,0,3"/>
                                                            <Rectangle Fill="#999999" Height="3" Width="45" HorizontalAlignment="Left"/>
                                                        </StackPanel>
                                                    </Border>
                                                    
                                                    <!-- Checkmark (hidden by default) -->
                                                    <Border x:Name="LightCheckmark"
                                                           Width="24" Height="24"
                                                           Background="#7C3AED"
                                                           CornerRadius="12"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top"
                                                           Margin="8"
                                                           Visibility="Collapsed">
                                                        <Path Data="M9,16.2L4.8,12l-1.4,1.4L9,19L21,7l-1.4-1.4L9,16.2z"
                                                             Fill="White"
                                                             Stretch="Uniform"
                                                             Width="14" Height="14"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="Açık"
                                                      FontSize="12"
                                                      Foreground="#666666"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Bottom"
                                                      Margin="0,0,0,8"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" 
                                      Fill="#333333" 
                                      Margin="0,16"/>

                            <!-- Language Selection -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Uygulama Dili"
                                               FontSize="16"
                                               Foreground="White"/>
                                    <TextBlock Text="Arayüz dilini değiştirin"
                                               FontSize="13"
                                               Foreground="#808080"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                         SelectedIndex="0"
                                         Style="{StaticResource ModernComboBox}"
                                         Width="180">
                                    <ComboBoxItem Content="Türkçe 🇹🇷"/>
                                    <ComboBoxItem Content="English 🇺🇸"/>
                                    <ComboBoxItem Content="Deutsch 🇩🇪"/>
                                    <ComboBoxItem Content="Français 🇫🇷"/>
                                    <ComboBoxItem Content="Español 🇪🇸"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GENERAL SECTION -->
                    <Border Background="#1A1A1A" 
                            CornerRadius="8" 
                            Padding="24"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Genel" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="White"
                                       Margin="0,0,0,20"/>

                            <!-- Auto-update -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Otomatik güncellemeler"
                                               FontSize="16"
                                               Foreground="White"/>
                                    <TextBlock Text="Yeni sürümler otomatik indirilsin"
                                               FontSize="13"
                                               Foreground="#808080"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <ToggleButton Grid.Column="1"
                                             IsChecked="{Binding Settings.AutoUpdate}"
                                             Style="{StaticResource ModernToggleSwitch}"/>
                            </Grid>

                            <!-- Hardware acceleration -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Donanım hızlandırma"
                                               FontSize="16"
                                               Foreground="White"/>
                                    <TextBlock Text="GPU ile video kodlama (önerilir)"
                                               FontSize="13"
                                               Foreground="#808080"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <ToggleButton Grid.Column="1"
                                             IsChecked="{Binding Settings.HardwareAcceleration}"
                                             Style="{StaticResource ModernToggleSwitch}"/>
                            </Grid>

                            <!-- Analytics -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Kullanım istatistikleri"
                                               FontSize="16"
                                               Foreground="White"/>
                                    <TextBlock Text="Uygulamayı geliştirmemize yardımcı olun"
                                               FontSize="13"
                                               Foreground="#808080"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <ToggleButton Grid.Column="1"
                                             IsChecked="{Binding Settings.Analytics}"
                                             Style="{StaticResource ModernToggleSwitch}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- DATA & CACHE SECTION -->
                    <Border Background="#1A1A1A" 
                            CornerRadius="8" 
                            Padding="24"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Veri ve Önbellek" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="White"
                                       Margin="0,0,0,20"/>

                            <!-- Cache info -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Önbellek boyutu"
                                               FontSize="16"
                                               Foreground="White"/>
                                    <TextBlock Text="Geçici dosyalar ve görüntüler"
                                               FontSize="13"
                                               Foreground="#808080"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                          Text="234 MB"
                                          FontSize="16"
                                          Foreground="#808080"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Clear cache button -->
                            <Button Command="{Binding ClearCacheCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="20,12"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border"
                                                Background="Transparent"
                                                BorderBrush="#333333"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                      Fill="#E87C03"
                                                      Stretch="Uniform"
                                                      Width="18" Height="18"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                                <TextBlock Text="Önbelleği Temizle"
                                                          FontSize="15"
                                                          Foreground="#E87C03"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#1A0D0D0D"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#E87C03"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ABOUT SECTION -->
                    <Border Background="#1A1A1A" 
                            CornerRadius="8" 
                            Padding="24">
                        <StackPanel>
                            <TextBlock Text="Hakkında" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="White"
                                       Margin="0,0,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- App Icon -->
                                <Border Width="64" Height="64"
                                        Background="{StaticResource PrimaryGradientBrush}"
                                        CornerRadius="12"
                                        Margin="0,0,20,0">
                                    <TextBlock Text="📺"
                                               FontSize="32"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- App Info -->
                                <StackPanel Grid.Column="1" 
                                           VerticalAlignment="Center">
                                    <TextBlock Text="IPTV Player"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="Sürüm 1.0.0"
                                               FontSize="14"
                                               Foreground="#808080"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="© 2026 Tüm Hakları Saklıdır"
                                               FontSize="13"
                                               Foreground="#666666"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" 
                                      Fill="#333333" 
                                      Margin="0,20"/>

                            <!-- Links -->
                            <StackPanel Orientation="Horizontal"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0">
                                <Button Content="Gizlilik Politikası"
                                       Style="{StaticResource TextButtonStyle}"
                                       Foreground="#7C3AED"
                                       FontSize="14"
                                       Cursor="Hand"/>
                                <TextBlock Text=" • " 
                                          Foreground="#404040" 
                                          VerticalAlignment="Center"
                                          Margin="8,0"/>
                                <Button Content="Kullanım Şartları"
                                       Style="{StaticResource TextButtonStyle}"
                                       Foreground="#7C3AED"
                                       FontSize="14"
                                       Cursor="Hand"/>
                                <TextBlock Text=" • " 
                                          Foreground="#404040" 
                                          VerticalAlignment="Center"
                                          Margin="8,0"/>
                                <Button Content="Destek"
                                       Style="{StaticResource TextButtonStyle}"
                                       Foreground="#7C3AED"
                                       FontSize="14"
                                       Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
