<Window x:Class="IPTVPlayer.Views.AddProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:IPTVPlayer.ViewModels;assembly=IPTVPlayer.Core"
        xmlns:converters="clr-namespace:IPTVPlayer.Converters"
        xmlns:helper="clr-namespace:IPTVPlayer.Helpers"
        mc:Ignorable="d"
        Title="Profil Ayarları" Height="700" Width="950"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="{StaticResource Bg0Brush}" 
        FontFamily="Segoe UI">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:ProfileColorConverter x:Key="ProfileColorConverter"/>
            <converters:AvatarExpressionConverter x:Key="AvatarExpressionConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:ErrorColorConverter x:Key="ErrorColorConverter"/>
            <converters:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter"/>
            <converters:AvatarPathConverter x:Key="AvatarPathConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,40">
            <TextBlock x:Name="TitleText" FontSize="56" FontWeight="Medium" Foreground="White" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Profil Ekle"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EditingProfile, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                <Setter Property="Text" Value="Profili Düzenle"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Noctra izleyen başka bir kişi için profil ekleyin." FontSize="18" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,30,0,0" Width="800"/>
        </StackPanel>

        <!-- Main Content (Horizontal Split: Avatar | Info) -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Avatar -->
                <ColumnDefinition Width="500"/> <!-- Info Stack -->
            </Grid.ColumnDefinitions>

            <!-- Avatar Column -->
            <Button Style="{StaticResource ImageButtonStyle}" Command="{Binding OpenAvatarPickerCommand}" 
                    Cursor="Hand" VerticalAlignment="Top" Margin="0,0,60,0"
                    Background="Transparent" BorderThickness="0">
                <Grid Width="200" Height="200">
                    <!-- Glow Effect -->
                    <Border x:Name="AvatarGlow"
                            Background="{Binding SelectedAvatar, Converter={StaticResource ProfileColorConverter}}"
                            CornerRadius="100"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <BlurEffect Radius="35"/>
                        </Border.Effect>
                    </Border>
                    
                    <!-- Avatar -->
                    <Border Width="200" Height="200" CornerRadius="14" ClipToBounds="True"
                            Background="{Binding SelectedAvatar, Converter={StaticResource ProfileColorConverter}, FallbackValue='#E50914'}">
                        <Grid>
                            <Image Source="{Binding SelectedAvatar, Converter={StaticResource AvatarPathConverter}}" 
                                   Stretch="UniformToFill" 
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,200,200" RadiusX="14" RadiusY="14"/>
                                </Image.Clip>
                            </Image>

                            <!-- Edit Icon -->
                            <Border Width="56" Height="56"
                                    Background="#DD000000"
                                    CornerRadius="28"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="12">
                                <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                      Fill="White"
                                      Stretch="Uniform"
                                      Width="24" Height="24"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                
                <Button.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="AvatarGlow"
                                               Storyboard.TargetProperty="Opacity"
                                               To="0.4" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="AvatarGlow"
                                               Storyboard.TargetProperty="Opacity"
                                               To="0" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>

            <!-- Info Column -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <!-- Profile Name -->
                <TextBlock Text="Profil Adı" Foreground="#AAAAAA" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold"/>
                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" 
                         Height="52"
                         helper:TextBoxHelper.Watermark="İsim girin"/>

                <CheckBox Content="Çocuk Profili" 
                          IsChecked="{Binding IsChild}"
                          Style="{StaticResource NoctraCheckBox}"
                          Margin="4,16,0,0"/>
                
                <Separator Height="1" Background="#333" Margin="0,32"/>
                
                <!-- Provider Account -->
                <TextBlock Text="Hesap Ayarları" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                

                <!-- Connection Details -->
                <!-- Connection Details Section -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsNewAccount}" Value="False"/>
                                        <Condition Binding="{Binding IsEditingAccount}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- URL Field with Smart Label -->
                    <TextBlock Foreground="#AAAAAA" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Sunucu URL"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsM3U}" Value="True">
                                        <Setter Property="Text" Value="M3U Link"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" 
                             Height="52" Margin="0,0,0,20">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                                <Setter Property="helper:TextBoxHelper.Watermark" Value="http://server.com:8080"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsM3U}" Value="True">
                                        <Setter Property="helper:TextBoxHelper.Watermark" 
                                                Value="http://server.com:8080/get.php?username=...&amp;password=..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    
                    <!-- Credentials Grid - Shows for both Xtream and M3U with get.php -->
                    <Grid Margin="0,0,0,20">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <!-- Show if Xtream selected -->
                                    <DataTrigger Binding="{Binding IsXtream}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <!-- OR if M3U with get.php in URL -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsM3U}" Value="True"/>
                                            <Condition Binding="{Binding Url, Converter={StaticResource StringContainsConverter}, ConverterParameter='get.php'}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Kullanıcı Adı" Foreground="#AAAAAA" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" Height="52"
                                     helper:TextBoxHelper.Watermark="Kullanıcı adı"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Şifre" Foreground="#AAAAAA" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" Height="52"
                                     helper:TextBoxHelper.Watermark="Şifre"/>
                        </StackPanel>
                    </Grid>

                    <!-- Format Type Toggle -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton GroupName="ProfileType" Content="Xtream Codes" 
                                     IsChecked="{Binding IsXtream}" 
                                     Style="{StaticResource TabRadioButtonStyle}" 
                                     Margin="0,0,12,0" Padding="20,10"/>
                        <RadioButton GroupName="ProfileType" Content="M3U Playlist" 
                                     IsChecked="{Binding IsM3U}" 
                                     Style="{StaticResource TabRadioButtonStyle}" 
                                     Padding="20,10"/>
                    </StackPanel>
                    
                    <!-- ✨ Info Banner - M3U → Xtream Conversion -->
                    <Border Background="#1A7C3AED" BorderBrush="{StaticResource AccentBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <!-- Show when switching from M3U with get.php to Xtream -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsXtream}" Value="True"/>
                                            <Condition Binding="{Binding Username, Converter={StaticResource StringToVisibilityConverter}}" Value="Visible"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                                <Run Text="M3U linkiniz Xtream formatına dönüştürüldü."/>
                                <Run Text="Sunucu, kullanıcı adı ve şifre otomatik ayrıştırıldı." FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Footer Actions - Netflix Style -->
        <Grid Grid.Row="2" Margin="0,32,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left: Delete Button (only in edit mode) -->
            <Button Command="{Binding DeleteProfileCommand}"
                    CommandParameter="{Binding EditingProfile}"
                    Visibility="{Binding EditingProfile, Converter={StaticResource NullToVisibilityConverter}}"
                    HorizontalAlignment="Left"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <StackPanel x:Name="DeletePanel" Orientation="Horizontal" Opacity="1">
                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                  Fill="#E87C03"
                                  Stretch="Uniform"
                                  Width="20" Height="20"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="Profili Sil"
                                       FontSize="16"
                                       Foreground="#E87C03"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DeletePanel" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <!-- Right: Cancel & Save -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="{Binding HasError, Converter={StaticResource ErrorColorConverter}}" 
                           FontSize="14" VerticalAlignment="Center" Margin="0,0,24,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                
                <!-- Cancel Button -->
                <Button Click="CancelButton_Click" Cursor="Hand" Width="120" Height="48" Margin="0,0,16,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CancelBorder"
                                    Background="Transparent"
                                    BorderBrush="#555555"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <TextBlock Text="İptal" FontSize="16" Foreground="#B3B3B3"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CancelBorder" Property="BorderBrush" Value="White"/>
                                    <Setter TargetName="CancelBorder" Property="TextBlock.Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <!-- Save Button -->
                <Button Command="{Binding SaveCommand}" Cursor="Hand" Width="140" Height="48">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SaveBorder"
                                    Background="White"
                                    CornerRadius="4">
                                <TextBlock Text="Kaydet" FontSize="16" FontWeight="SemiBold" 
                                           Foreground="Black"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SaveBorder" Property="Background" Value="#E5E5E5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="SaveBorder" Property="Background" Value="#404040"/>
                                    <Setter TargetName="SaveBorder" Property="TextBlock.Foreground" Value="#808080"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
        </Grid>
    </ScrollViewer>
</Window>
