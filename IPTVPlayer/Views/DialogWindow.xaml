<Window x:Class="IPTVPlayer.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="220" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Topmost="True">
    
    <Border Background="{DynamicResource BackgroundBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Path x:Name="IconPath" 
                      Width="32" Height="32" 
                      Stretch="Uniform"
                      Fill="{DynamicResource TextPrimaryBrush}"
                      VerticalAlignment="Center" 
                      Margin="0,0,20,0"/>

                <!-- Message -->
                <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{DynamicResource TextMutedBrush}" 
                           FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="SecondaryButton" Content="İPTAL" Width="100" Height="40" 
                        Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"
                        Click="SecondaryButton_Click" Visibility="Collapsed"/>
                
                <Button x:Name="PrimaryButton" Content="TAMAM" Width="120" Height="40" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Click="PrimaryButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
