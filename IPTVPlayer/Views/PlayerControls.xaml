<UserControl x:Class="IPTVPlayer.Views.PlayerControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Converters.xaml"/>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#AA000000" Padding="24" CornerRadius="16">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding ChannelName}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding PositionText}"
                           FontSize="12"
                           Foreground="#B3B3B3"
                           VerticalAlignment="Center"/>
            </Grid>

            <Slider Minimum="0" Maximum="1"
                    Value="{Binding Position, Mode=TwoWay}"
                    IsEnabled="{Binding IsLiveContent, Converter={StaticResource InverseBoolConverter}}"/>
            <TextBlock Text="{Binding DurationText}"
                       FontSize="12"
                       Foreground="#B3B3B3"
                       HorizontalAlignment="Right"
                       Margin="0,8,0,0"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Command="{Binding SkipBackwardCommand}"
                        Content="⏪"
                        Style="{StaticResource WindowControlButton}"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="1"
                        Command="{Binding PlayPauseCommand}"
                        Content="{Binding IsPlaying, Converter={StaticResource BoolToPlayPauseIconConverter}}"
                        Style="{StaticResource WindowControlButton}"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="2"
                        Command="{Binding SkipForwardCommand}"
                        Content="⏩"
                        Style="{StaticResource WindowControlButton}"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Command="{Binding ToggleMuteCommand}"
                            Content="🔊"
                            Style="{StaticResource WindowControlButton}"
                            Margin="0,0,8,0"/>
                    <Slider Width="120"
                            Minimum="0" Maximum="100"
                            Value="{Binding Volume, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
