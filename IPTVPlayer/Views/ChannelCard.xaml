<!-- Views/ChannelCard.xaml - NETFLIX CHANNEL CARD -->
<UserControl x:Class="IPTVPlayer.Views.ChannelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="CardRoot"
             MouseEnter="Card_MouseEnter"
             MouseLeave="Card_MouseLeave"
             Cursor="Hand">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Converters.xaml"/>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Hover Scale Animation -->
            <Storyboard x:Key="HoverIn">
                <DoubleAnimation Storyboard.TargetName="CardTransform"
                               Storyboard.TargetProperty="ScaleX"
                               To="1.1" Duration="0:0:0.3"
                               EasingFunction="{StaticResource QuadraticEaseOut}"/>
                <DoubleAnimation Storyboard.TargetName="CardTransform"
                               Storyboard.TargetProperty="ScaleY"
                               To="1.1" Duration="0:0:0.3"
                               EasingFunction="{StaticResource QuadraticEaseOut}"/>
                <DoubleAnimation Storyboard.TargetName="MetadataOverlay"
                               Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.2"/>
            </Storyboard>
            
            <Storyboard x:Key="HoverOut">
                <DoubleAnimation Storyboard.TargetName="CardTransform"
                               Storyboard.TargetProperty="ScaleX"
                               To="1.0" Duration="0:0:0.2"
                               EasingFunction="{StaticResource QuadraticEaseOut}"/>
                <DoubleAnimation Storyboard.TargetName="CardTransform"
                               Storyboard.TargetProperty="ScaleY"
                               To="1.0" Duration="0:0:0.2"
                               EasingFunction="{StaticResource QuadraticEaseOut}"/>
                <DoubleAnimation Storyboard.TargetName="MetadataOverlay"
                               Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.2"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="CardContainer"
          Width="{Binding Width, ElementName=CardRoot}"
          Height="{Binding Height, ElementName=CardRoot}"
          RenderTransformOrigin="0.5,0.5">
        
        <Grid.RenderTransform>
            <ScaleTransform x:Name="CardTransform" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <!-- Main Card Border -->
        <Border x:Name="CardBorder"
                CornerRadius="4"
                ClipToBounds="True"
                Background="#1A1A1A">
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow"
                                 BlurRadius="15"
                                 ShadowDepth="8"
                                 Direction="270"
                                 Color="Black"
                                 Opacity="0"/>
            </Border.Effect>

            <Grid>
                <!-- Background Image -->
                <Image x:Name="BackdropImage"
                      Source="{Binding Channel.BackdropUrl, ElementName=CardRoot}"
                      Stretch="UniformToFill"
                      RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Fallback: Logo on colored background -->
                <Grid x:Name="FallbackContent"
                     Background="{Binding Channel.Name, ElementName=CardRoot, Converter={StaticResource ProfileColorConverter}}"
                     Visibility="{Binding Channel.BackdropUrl, ElementName=CardRoot, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                    <Image Source="{Binding Channel.LogoUrl, ElementName=CardRoot}"
                          Width="120"
                          Height="120"
                          Stretch="Uniform"
                          RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>

                <!-- Gradient Overlay (always visible) -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#99000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Title (always visible) -->
                <TextBlock Text="{Binding Channel.Name, ElementName=CardRoot}"
                          FontSize="16"
                          FontWeight="SemiBold"
                          Foreground="White"
                          TextWrapping="Wrap"
                          TextTrimming="CharacterEllipsis"
                          MaxHeight="48"
                          VerticalAlignment="Bottom"
                          Margin="12,0,12,12"
                          Effect="{StaticResource TextDropShadow}"/>

                <!-- Progress Bar (Continue Watching) -->
                <Grid VerticalAlignment="Bottom"
                     Height="4"
                     Visibility="{Binding Channel.WatchedPercentage, ElementName=CardRoot, Converter={StaticResource ProgressToVisibilityConverter}}">
                    <Rectangle Fill="#333333"/>
                    <Rectangle Fill="#E50914"
                              HorizontalAlignment="Left">
                        <Rectangle.Width>
                            <MultiBinding Converter="{StaticResource ProgressToWidthConverter}">
                                <Binding Path="Channel.WatchedPercentage" ElementName="CardRoot"/>
                                <Binding ElementName="CardContainer" Path="ActualWidth"/>
                            </MultiBinding>
                        </Rectangle.Width>
                    </Rectangle>
                </Grid>

                <!-- LIVE Badge -->
                <Border Background="#E50914"
                       CornerRadius="3"
                       Padding="8,4"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="8"
                       Visibility="{Binding Channel.Type, ElementName=CardRoot, Converter={StaticResource ChannelTypeToVisibilityConverter}, ConverterParameter=Live}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="White" Margin="0,0,4,0"/>
                        <TextBlock Text="CANLI"
                                  FontSize="10"
                                  FontWeight="Bold"
                                  Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- HD Badge -->
                <Border Background="#141414"
                       BorderBrush="#808080"
                       BorderThickness="1"
                       CornerRadius="2"
                       Padding="4,2"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="8"
                       Opacity="0.9">
                    <TextBlock Text="HD"
                              FontSize="10"
                              FontWeight="Bold"
                              Foreground="White"/>
                </Border>

                <!-- ==========================================
                     METADATA OVERLAY (Hover Only)
                     ========================================== -->
                <Grid x:Name="MetadataOverlay"
                     Background="#EE141414"
                     Opacity="0">
                    
                    <StackPanel VerticalAlignment="Bottom"
                               Margin="12">
                        
                        <!-- Title -->
                        <TextBlock Text="{Binding Channel.Name, ElementName=CardRoot}"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  TextWrapping="Wrap"
                                  MaxHeight="60"
                                  TextTrimming="CharacterEllipsis"
                                  Margin="0,0,0,8"/>

                        <!-- Metadata Row -->
                        <StackPanel Orientation="Horizontal"
                                   Margin="0,0,0,12">
                            <TextBlock Text="2024"
                                      FontSize="13"
                                      Foreground="#B3B3B3"/>
                            <TextBlock Text="•" 
                                      FontSize="13"
                                      Foreground="#808080"
                                      Margin="8,0"/>
                            <TextBlock Text="{Binding Channel.GroupTitle, ElementName=CardRoot}"
                                      FontSize="13"
                                      Foreground="#B3B3B3"/>
                        </StackPanel>

                        <!-- Description -->
                        <TextBlock Text="{Binding Channel.Description, ElementName=CardRoot}"
                                  FontSize="13"
                                  Foreground="#E5E5E5"
                                  TextWrapping="Wrap"
                                  MaxHeight="40"
                                  TextTrimming="CharacterEllipsis"
                                  LineHeight="18"
                                  Margin="0,0,0,12"
                                  Visibility="{Binding Channel.Description, ElementName=CardRoot, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal">
                            
                            <!-- Play Button -->
                            <Button Click="PlayButton_Click"
                                   Width="36" Height="36"
                                   Style="{StaticResource CircleIconButton}">
                                <Path Data="M8 5v14l11-7z"
                                     Fill="Black"
                                     Stretch="Uniform"
                                     Width="16" Height="16"/>
                            </Button>

                            <!-- Add to List Button -->
                            <Button Click="AddToListButton_Click"
                                   Width="36" Height="36"
                                   Style="{StaticResource CircleIconButton}"
                                   ToolTip="Listeme Ekle"
                                   Margin="8,0,0,0">
                                <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                     Fill="White"
                                     Stretch="Uniform"
                                     Width="18" Height="18"/>
                            </Button>

                            <!-- More Info Button -->
                            <Button Click="MoreInfoButton_Click"
                                   Width="36" Height="36"
                                   Style="{StaticResource CircleIconButton}"
                                   ToolTip="Daha Fazla Bilgi"
                                   Margin="8,0,0,0">
                                <Path Data="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"
                                     Fill="White"
                                     Stretch="Uniform"
                                     Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
