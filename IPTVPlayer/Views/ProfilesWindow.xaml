<Window x:Class="IPTVPlayer.Views.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:IPTVPlayer.ViewModels;assembly=IPTVPlayer.Core"
        xmlns:converters="clr-namespace:IPTVPlayer.Converters"
        mc:Ignorable="d"
        Title="Kim izliyor?" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
             <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:ProfileColorConverter x:Key="ProfileColorConverter"/>
            <converters:AvatarPathConverter x:Key="AvatarPathConverter"/>
        
            <!-- Profile Card Hover Animation -->
            <Storyboard x:Key="CardHoverIn">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                 To="1.05" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 To="1.05" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="CardHoverOut">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                 To="1.0" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 To="1.0" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="{StaticResource RadiusMedium}" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Bg0Color}" Offset="0.0"/>
                <GradientStop Color="{StaticResource Bg1Color}" Offset="0.6"/>
                <GradientStop Color="#1a0a2e" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="*"/>     <!-- Content -->
                <RowDefinition Height="Auto"/>  <!-- Footer -->
            </Grid.RowDefinitions>
            
            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Logo.png" Height="24" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="Noctra" FontSize="18" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextMutedBrush}" 
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                
                <!-- Right: Close -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="×" Click="CloseButton_Click"
                            Foreground="#CCCCCC" Background="Transparent" BorderThickness="0"
                            FontSize="32" Width="48" Height="48" Cursor="Hand" ToolTip="Kapat">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="24">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="#333333"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- MAIN CONTENT -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                
                <!-- Titles -->
                <TextBlock Text="Kim izliyor?" 
                           FontSize="64" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Profil seçin" 
                           FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,48"/>

                <!-- Profile Grid -->
                <WrapPanel HorizontalAlignment="Center" MaxWidth="960">
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="192" ItemHeight="220"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand" Margin="16,0,16,32" Focusable="True">
                                    <Button.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Button.RenderTransform>
                                    <Button.RenderTransformOrigin>0.5,0.5</Button.RenderTransformOrigin>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Width="192">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Avatar -->
                                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                                    <Grid x:Name="AvatarRoot" Width="160" Height="160">
                                                        <!-- Background Border (Gradient) -->
                                                        <Border Background="{Binding Avatar, Converter={StaticResource ProfileColorConverter}}"
                                                                CornerRadius="14"
                                                                ClipToBounds="True"/>
                                                        
                                                        <!-- Image Container with Clip -->
                                                        <Border CornerRadius="14" ClipToBounds="True">
                                                            <Image Source="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}"
                                                                   Stretch="UniformToFill"
                                                                   Width="160" Height="160"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>
                                                        
                                                        <!-- Selection Border (shows on hover/focus) -->
                                                        <Border x:Name="SelectionBorder"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="3"
                                                                CornerRadius="14"
                                                                IsHitTestVisible="False"/>
                                                        
                                                        <!-- Edit Icon Overlay (Manage Mode) -->
                                                        <Border Background="#E6000000" 
                                                                CornerRadius="14"
                                                                Visibility="{Binding DataContext.IsManageMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border Width="48" Height="48" 
                                                                        CornerRadius="24"
                                                                        Background="Transparent"
                                                                        BorderBrush="White"
                                                                        BorderThickness="2">
                                                                    <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                                          Fill="White"
                                                                          Stretch="Uniform"
                                                                          Width="20" Height="20"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="Düzenle" 
                                                                           FontSize="14" 
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,8,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>

                                                <!-- Name -->
                                                <TextBlock x:Name="ProfileName" Grid.Row="1" Text="{Binding Name}" 
                                                           Foreground="{StaticResource TextMutedBrush}" 
                                                           FontSize="15" FontWeight="Medium"
                                                           HorizontalAlignment="Center" 
                                                           TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="White"/>
                                                    <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="4"/>
                                                    <Setter TargetName="ProfileName" Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <!-- Focus State (Keyboard) -->
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                                    <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="4"/>
                                                    <Setter TargetName="ProfileName" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                    <!-- Focus glow effect -->
                                                    <Setter TargetName="SelectionBorder" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="{StaticResource Accent500Color}" 
                                                                              BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard Storyboard="{StaticResource CardHoverIn}"/>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard Storyboard="{StaticResource CardHoverOut}"/>
                                        </EventTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add Profile Button -->
                    <Button Command="{Binding AddProfileCommand}" Cursor="Hand" Margin="16,0,16,32" Focusable="True">
                         <Button.Visibility>
                            <Binding Path="IsManageMode" Converter="{StaticResource BoolToVisibilityConverter}" ConverterParameter="Invert"/>
                         </Button.Visibility>
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <Button.RenderTransformOrigin>0.5,0.5</Button.RenderTransformOrigin>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="192">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Plus Icon Box (Dashed Border) -->
                                    <Grid Width="160" Height="160" Grid.Row="0" Margin="0,0,0,12">
                                        <Rectangle x:Name="DashedBorder"
                                                  Stroke="#666666"
                                                  StrokeThickness="2"
                                                  StrokeDashArray="4 2"
                                                  RadiusX="14" RadiusY="14"/>
                                        
                                        <!-- Plus Icon -->
                                        <Grid>
                                            <Ellipse x:Name="PlusCircle"
                                                    Width="60" Height="60"
                                                    Stroke="#666666"
                                                    StrokeThickness="2"
                                                    Fill="Transparent"/>
                                            <Path x:Name="PlusIcon"
                                                  Data="M12,2 L12,22 M2,12 L22,12"
                                                  Stroke="#666666"
                                                  StrokeThickness="2"
                                                  Stretch="Uniform"
                                                  Width="24" Height="24"/>
                                        </Grid>
                                    </Grid>
                                    
                                    <!-- Label -->
                                    <TextBlock x:Name="AddLabel" Grid.Row="1" Text="Profil Ekle" 
                                               Foreground="{StaticResource TextMutedBrush}" 
                                               FontSize="15" FontWeight="Medium"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DashedBorder" Property="Stroke" Value="White"/>
                                        <Setter TargetName="PlusCircle" Property="Stroke" Value="White"/>
                                        <Setter TargetName="PlusCircle" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="PlusIcon" Property="Stroke" Value="White"/>
                                        <Setter TargetName="AddLabel" Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard Storyboard="{StaticResource CardHoverIn}"/>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard Storyboard="{StaticResource CardHoverOut}"/>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- FOOTER -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,40">
                <Button x:Name="ManageProfilesButton" Content="{Binding IsManageMode, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Bitti|Profilleri Yönet'}" 
                        Command="{Binding ToggleManageModeCommand}"
                        Background="Transparent" BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="14" FontWeight="Medium" Padding="24,12" Cursor="Hand"
                        Visibility="{Binding Profiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PlainButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsManageMode}" Value="True">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
