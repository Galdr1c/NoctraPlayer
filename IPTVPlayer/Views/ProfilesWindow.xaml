<Window x:Class="IPTVPlayer.Views.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:IPTVPlayer.ViewModels;assembly=IPTVPlayer.Core"
        xmlns:converters="clr-namespace:IPTVPlayer.Converters"
        mc:Ignorable="d"
        Title="Kim izliyor?" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
             <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
            <!-- Profile Card Hover Animation -->
            <Storyboard x:Key="CardHoverIn">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                 To="1.04" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 To="1.04" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="CardHoverOut">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                 To="1.0" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 To="1.0" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="{StaticResource RadiusMedium}" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Bg0Color}" Offset="0.0"/>
                <GradientStop Color="{StaticResource Bg1Color}" Offset="0.6"/>
                <GradientStop Color="#1a0a2e" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="*"/>     <!-- Content -->
                <RowDefinition Height="Auto"/>  <!-- Footer -->
            </Grid.RowDefinitions>
            
            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Logo (optional) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="8,6">
                        <TextBlock Text="📺" FontSize="16"/>
                    </Border>
                    <TextBlock Text="IPTV Player" FontSize="18" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextMutedBrush}" 
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                
                <!-- Right: Close -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="✕" Click="CloseButton_Click"
                            Foreground="{StaticResource TextMutedBrush}" Background="Transparent" BorderThickness="0"
                            FontSize="18" Padding="12,10" Cursor="Hand" ToolTip="Kapat">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- MAIN CONTENT -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                
                <!-- Titles -->
                <TextBlock Text="Kim izliyor?" 
                           FontSize="48" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Profil seçin" 
                           FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,48"/>

                <!-- Profile Grid -->
                <WrapPanel HorizontalAlignment="Center" MaxWidth="800">
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand" Margin="16" Focusable="True">
                                    <Button.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Button.RenderTransform>
                                    <Button.RenderTransformOrigin>0.5,0.5</Button.RenderTransformOrigin>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Width="110">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Avatar -->
                                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                                                <Border x:Name="AvatarBorder" Width="110" Height="110" 
                                                                        CornerRadius="{StaticResource RadiusMedium}" 
                                                                        BorderThickness="3" BorderBrush="Transparent"
                                                                        UseLayoutRounding="True">
                                                                    <!-- Robust Clipping on the Border itself -->
                                                                    <Border.Clip>
                                                                        <RectangleGeometry Rect="0,0,110,110" RadiusX="14" RadiusY="14"/>
                                                                    </Border.Clip>
                                                                    <Grid>
                                                                        <!-- Background inside mask to prevent "ears" -->
                                                                        <Border Background="{StaticResource SurfaceBrush}" 
                                                                                CornerRadius="{StaticResource RadiusMedium}"/>
                                                                                
                                                                        <!-- Actual Avatar Image -->
                                                                        <Image Source="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}"
                                                                               Stretch="UniformToFill" 
                                                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                                                        <!-- Manage Mode Overlay (Edit Icon) -->
                                                                        <Border Background="#B0000000" CornerRadius="{StaticResource RadiusMedium}"
                                                                                Visibility="{Binding DataContext.IsManageMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                           <TextBlock Text="✏️" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White">
                                                                               <TextBlock.Effect>
                                                                                   <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black"/>
                                                                               </TextBlock.Effect>
                                                                           </TextBlock>
                                                                       </Border>
                                                                    </Grid>
                                                                </Border>
                                                    </Grid>

                                                <!-- Name -->
                                                <TextBlock x:Name="ProfileName" Grid.Row="1" Text="{Binding Name}" 
                                                           Foreground="{StaticResource TextMutedBrush}" 
                                                           FontSize="15" FontWeight="Medium"
                                                           HorizontalAlignment="Center" 
                                                           TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <!-- Focus State (Keyboard) -->
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="AvatarBorder" Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                                    <Setter TargetName="AvatarBorder" Property="BorderThickness" Value="3"/>
                                                    <Setter TargetName="ProfileName" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard Storyboard="{StaticResource CardHoverIn}"/>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard Storyboard="{StaticResource CardHoverOut}"/>
                                        </EventTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add Profile Button -->
                    <Button Command="{Binding AddProfileCommand}" Cursor="Hand" Margin="16" Focusable="True">
                         <Button.Visibility>
                            <Binding Path="IsManageMode" Converter="{StaticResource BoolToVisibilityConverter}" ConverterParameter="Invert"/>
                         </Button.Visibility>
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <Button.RenderTransformOrigin>0.5,0.5</Button.RenderTransformOrigin>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="110">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Plus Icon Box (Dashed Border) -->
                                    <Border x:Name="AddBorder" Width="110" Height="110" CornerRadius="{StaticResource RadiusMedium}" 
                                            Grid.Row="0" Margin="0,0,0,12" 
                                            Background="Transparent"
                                            BorderThickness="2">
                                        <Border.BorderBrush>
                                            <VisualBrush>
                                                <VisualBrush.Visual>
                                                    <Rectangle StrokeDashArray="4 2" 
                                                               Stroke="{StaticResource BorderBrush}" 
                                                               StrokeThickness="2"
                                                               Width="110" Height="110"
                                                               RadiusX="14" RadiusY="14"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Border.BorderBrush>
                                        
                                        <!-- Circle with Plus -->
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse x:Name="PlusCircle" Width="60" Height="60" 
                                                     Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2" Fill="Transparent"/>
                                            <TextBlock x:Name="PlusIcon" Text="+" FontSize="36" FontWeight="Light"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-4,0,0"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Label -->
                                    <TextBlock x:Name="AddLabel" Grid.Row="1" Text="Profil Ekle" 
                                               Foreground="{StaticResource TextMutedBrush}" 
                                               FontSize="15" FontWeight="Medium"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="PlusCircle" Property="Stroke" Value="{StaticResource AccentLightBrush}"/>
                                        <Setter TargetName="PlusCircle" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="PlusIcon" Property="Foreground" Value="White"/>
                                        <Setter TargetName="AddLabel" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard Storyboard="{StaticResource CardHoverIn}"/>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard Storyboard="{StaticResource CardHoverOut}"/>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- FOOTER -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,40">
                <Button x:Name="ManageProfilesButton" Content="{Binding IsManageMode, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Bitti|Profilleri Yönet'}" 
                        Command="{Binding ToggleManageModeCommand}"
                        Background="Transparent" BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="14" FontWeight="Medium" Padding="24,12" Cursor="Hand"
                        Visibility="{Binding Profiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PlainButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsManageMode}" Value="True">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
