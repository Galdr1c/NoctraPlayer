<Window x:Class="IPTVPlayer.Views.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:IPTVPlayer.ViewModels;assembly=IPTVPlayer.Core"
        xmlns:converters="clr-namespace:IPTVPlayer.Converters"
        mc:Ignorable="d"
        Title="Kim izliyor?" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
             <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:ProfileColorConverter x:Key="ProfileColorConverter"/>
            <converters:AvatarPathConverter x:Key="AvatarPathConverter"/>
        
            <!-- Profile Card Hover Animation -->
            <Storyboard x:Key="CardHoverIn">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                 To="1.04" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 To="1.04" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="CardHoverOut">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                 To="1.0" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 To="1.0" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="{DynamicResource RadiusMedium}" ClipToBounds="True"
            Background="{DynamicResource BackgroundGradientBrush}">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="*"/>     <!-- Content -->
                <RowDefinition Height="Auto"/>  <!-- Footer -->
            </Grid.RowDefinitions>
            
            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Logo.png" Height="24" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="Noctra" FontSize="18" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextMutedBrush}" 
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                
                <!-- Right: Settings & Close -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    
                    <!-- Settings Button -->
                    <Button Click="SettingsButton_Click" Cursor="Hand" ToolTip="Ayarlar"
                            Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SettingsBg" Background="Transparent" CornerRadius="24">
                                    <Path x:Name="SettingsIcon"
                                          Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                                          Fill="{DynamicResource TextMutedBrush}"
                                          Stretch="Uniform"
                                          Width="22" Height="22"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="GearRotation" Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SettingsBg" Property="Background" Value="{DynamicResource Surface1Brush}"/>
                                        <Setter TargetName="SettingsIcon" Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GearRotation"
                                                               Storyboard.TargetProperty="Angle"
                                                               To="90" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GearRotation"
                                                               Storyboard.TargetProperty="Angle"
                                                               To="0" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Close Button -->
                    <Button Click="CloseButton_Click" Cursor="Hand" ToolTip="Kapat"
                            Width="48" Height="48" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBg" Background="Transparent" CornerRadius="24">
                                    <TextBlock Text="×" FontSize="32" FontWeight="Light"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,-4,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBg" Property="Background" Value="{DynamicResource Surface1Brush}"/>
                                        <Setter TargetName="CloseBg" Property="TextBlock.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- MAIN CONTENT -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                
                <!-- Titles -->
                <TextBlock Text="Kim izliyor?" 
                           FontSize="64" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Profil seçin" 
                           FontSize="18" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,56"/>

                <!-- Profile Grid -->
                <WrapPanel HorizontalAlignment="Center" MaxWidth="900">
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="192" ItemHeight="200"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand" Margin="16,16,16,24" Focusable="True">
                                    <Button.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Button.RenderTransform>
                                    <Button.RenderTransformOrigin>0.5,0.5</Button.RenderTransformOrigin>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Width="{StaticResource RatioSquareSize}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Avatar -->
                                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                                    <Grid x:Name="AvatarRoot" Width="{StaticResource RatioSquareSize}" Height="{StaticResource RatioSquareSize}">
                                                        <!-- 1. Background & Content (Clipped) -->
                                                        <Border CornerRadius="14" ClipToBounds="True"
                                                                Background="{DynamicResource IconGradientBrush}">
                                                            <Grid>
                                                                <!-- Actual Avatar (Using ImageBrush for perfect rounded corners) -->
                                                                <Border CornerRadius="14">
                                                                    <Border.Background>
                                                                        <ImageBrush ImageSource="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}"
                                                                                    Stretch="UniformToFill"
                                                                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    </Border.Background>
                                                                </Border>

                                                                <!-- Manage Mode Overlay (Reduced opacity to 60% for better visibility) -->
                                                                <Border Background="#99000000" CornerRadius="14"
                                                                        Visibility="{Binding DataContext.IsManageMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <!-- Pencil Icon in Circle -->
                                                                        <Border Width="48" Height="48" 
                                                                                CornerRadius="24"
                                                                                Background="Transparent"
                                                                                BorderBrush="White"
                                                                                BorderThickness="2">
                                                                            <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                                                  Fill="White"
                                                                                  Stretch="Uniform"
                                                                                  Width="20" Height="20"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <TextBlock Text="Düzenle" 
                                                                                   FontSize="14" 
                                                                                   Foreground="White"
                                                                                   HorizontalAlignment="Center"
                                                                                   Margin="0,8,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- 2. Selection/Focus Frame (On Top) -->
                                                        <Border x:Name="AvatarBorder" CornerRadius="14" 
                                                                BorderThickness="3" BorderBrush="Transparent"
                                                                Background="Transparent" IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Grid>

                                                <!-- Name -->
                                                <TextBlock x:Name="ProfileName" Grid.Row="1" Text="{Binding Name}" 
                                                           Foreground="{DynamicResource TextMutedBrush}" 
                                                           FontSize="15" FontWeight="Medium"
                                                           HorizontalAlignment="Center" 
                                                           TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <!-- Focus State (Keyboard) -->
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="AvatarBorder" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
                                                    <Setter TargetName="AvatarBorder" Property="BorderThickness" Value="3"/>
                                                    <Setter TargetName="ProfileName" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <!-- Focus glow effect -->
                                                    <Setter TargetName="AvatarBorder" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="{DynamicResource Accent500Color}" 
                                                                              BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard Storyboard="{StaticResource CardHoverIn}"/>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard Storyboard="{StaticResource CardHoverOut}"/>
                                        </EventTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add Profile Button -->
                    <Button Command="{Binding AddProfileCommand}" Cursor="Hand" Margin="16,16,16,24" Focusable="True">
                         <Button.Visibility>
                            <Binding Path="IsManageMode" Converter="{StaticResource BoolToVisibilityConverter}" ConverterParameter="Invert"/>
                         </Button.Visibility>
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <Button.RenderTransformOrigin>0.5,0.5</Button.RenderTransformOrigin>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="{StaticResource RatioSquareSize}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Plus Icon Box (Dashed Border) -->
                                    <Border x:Name="AddBorder" Width="{StaticResource RatioSquareSize}" Height="{StaticResource RatioSquareSize}" CornerRadius="{DynamicResource RadiusMedium}" 
                                            Grid.Row="0" Margin="0,0,0,12" 
                                            Background="Transparent"
                                            BorderThickness="2">
                                        <Border.BorderBrush>
                                            <VisualBrush>
                                                <VisualBrush.Visual>
                                                    <Rectangle StrokeDashArray="4 2" 
                                                               Stroke="{DynamicResource BorderBrush}" 
                                                               StrokeThickness="2"
                                                               Width="{StaticResource RatioSquareSize}" Height="{StaticResource RatioSquareSize}"
                                                               RadiusX="14" RadiusY="14"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Border.BorderBrush>
                                        
                                        <!-- Circle with Plus -->
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse x:Name="PlusCircle" Width="60" Height="60" 
                                                     Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2" Fill="Transparent"/>
                                            <TextBlock x:Name="PlusIcon" Text="+" FontSize="36" FontWeight="Light"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-4,0,0"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Label -->
                                    <TextBlock x:Name="AddLabel" Grid.Row="1" Text="Profil Ekle" 
                                               Foreground="{DynamicResource TextMutedBrush}" 
                                               FontSize="15" FontWeight="Medium"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="AddBorder" Property="BorderBrush">
                                            <Setter.Value>
                                                <VisualBrush>
                                                    <VisualBrush.Visual>
                                                        <Rectangle StrokeDashArray="4 2" 
                                                                   Stroke="{DynamicResource TextPrimaryBrush}" 
                                                                   StrokeThickness="2"
                                                                   Width="{StaticResource RatioSquareSize}" Height="{StaticResource RatioSquareSize}"
                                                                   RadiusX="14" RadiusY="14"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="PlusCircle" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter TargetName="PlusCircle" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="PlusIcon" Property="Foreground" Value="White"/>
                                        <Setter TargetName="AddLabel" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard Storyboard="{StaticResource CardHoverIn}"/>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard Storyboard="{StaticResource CardHoverOut}"/>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- FOOTER -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,40">
                <Button x:Name="ManageProfilesButton" Content="{Binding IsManageMode, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Bitti|Profilleri Yönet'}" 
                        Command="{Binding ToggleManageModeCommand}"
                        Background="Transparent" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        FontSize="14" FontWeight="Medium" Padding="24,12" Cursor="Hand"
                        Visibility="{Binding Profiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PlainButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsManageMode}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Bg0Brush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
