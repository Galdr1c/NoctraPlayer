<Window x:Class="IPTVPlayer.Views.AvatarPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:IPTVPlayer.ViewModels;assembly=IPTVPlayer.Core"
        mc:Ignorable="d"
        Title="Avatar Seç" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Converters.xaml"/>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Avatars -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Profil Resmi Seç" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <Button HorizontalAlignment="Right" Content="✕" 
                        Click="CloseButton_Click"
                        FontSize="20"
                        Style="{StaticResource IconButton}" 
                        Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- Avatar Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <ItemsControl ItemsSource="{Binding Avatars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="12"
                                    Command="{Binding DataContext.SelectAvatarCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource ImageButtonStyle}"
                                    Width="120" Height="120">
                                <Grid>
                                    <Border Width="120" Height="120"
                                            CornerRadius="12"
                                            ClipToBounds="True"
                                            Background="{Binding Converter={StaticResource ProfileColorConverter}}">
                                        <Image Source="{Binding Converter={StaticResource AvatarPathConverter}}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    
                                    <Border x:Name="SelectionBorder"
                                            BorderBrush="Transparent"
                                            BorderThickness="4"
                                            CornerRadius="12"/>
                                    
                                    <Border x:Name="Checkmark"
                                            Width="32" Height="32"
                                            Background="#7C3AED"
                                            CornerRadius="16"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="8"
                                            Visibility="Collapsed">
                                        <Path Data="M9,16.2L4.8,12l-1.4,1.4L9,19L21,7l-1.4-1.4L9,16.2z"
                                              Fill="White"
                                              Stretch="Uniform"
                                              Width="16" Height="16"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                            
                            <DataTemplate.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}">
                                            <Binding/>
                                            <Binding Path="DataContext.SelectedAvatar" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#7C3AED"/>
                                    <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="4"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <TextBlock Grid.Row="2" Text="İpucu: İstediğiniz avatarın üzerine tıklayın." Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </Grid>
    </Border>
</Window>
