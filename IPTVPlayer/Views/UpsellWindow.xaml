<Window x:Class="IPTVPlayer.Views.UpsellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Premium'a Yükselt" Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="16" Background="{DynamicResource BackgroundGradientBrush}" 
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
        <Grid>
            <!-- Decorative Elements -->
            <Ellipse Width="400" Height="400" Fill="{DynamicResource AccentBrush}" Opacity="0.08" 
                     VerticalAlignment="Top" HorizontalAlignment="Right" Margin="-100"/>
            <Ellipse Width="300" Height="300" Fill="{DynamicResource GlowBrush}" Opacity="0.04" 
                     VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-50"/>

            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <TextBlock Text="👑 PREMIUM" FontSize="16" FontWeight="Bold" 
                               Foreground="{StaticResource AccentLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Sınırları Kaldırın" FontSize="36" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Tüm özelliklere erişin ve IPTV deneyiminizi yükseltin" 
                               FontSize="16" Foreground="{DynamicResource TextMutedBrush}" 
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- COMPARISON -->
                <Grid Grid.Row="1" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FREE CARD -->
                    <Border Grid.Column="0" Background="{DynamicResource Surface0Brush}" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Free" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Temel Kullanım" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>
                            
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="✓ 1 Profil" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4"/>
                                <TextBlock Text="✓ 1 M3U Hesabı" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4"/>
                                <TextBlock Text="✓ 24 Saatlik EPG" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4"/>
                                <TextBlock Text="✓ 50 Favori Kanal" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4"/>
                                <TextBlock Text="✗ Kynora Filigranı" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4"/>
                                <TextBlock Text="✗ Kanal Yönetimi Yok" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PREMIUM CARD -->
                    <Border Grid.Column="2" CornerRadius="12" Padding="24" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                            Background="{DynamicResource PremiumCardBackgroundBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource GlowColor}" BlurRadius="30" Opacity="0.2" ShadowDepth="0"/>
                        </Border.Effect>
                        
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Premium" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PremiumCardForegroundBrush}"/>
                                    <TextBlock Text="Lifetime Lisans" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                                        Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="EN İYİ DEĞER" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                            
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="✓ Sınırsız Profil" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Text="✓ Sınırsız M3U Hesabı" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Text="✓ 2 Haftalık EPG + Grid" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Text="✓ Filigransız İzleme" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Text="✓ Kanal Gizleme/Sıralama" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Text="✓ Tüm Temalar &amp; Animasyonlar" Foreground="{DynamicResource PremiumCardForegroundBrush}" FontWeight="SemiBold" Margin="0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- FOOTER / ACTIONS -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                    <Button x:Name="BuyButton" Click="BuyButton_Click" Cursor="Hand" Width="320" Height="56">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" CornerRadius="28" Background="{StaticResource PrimaryGradientBrush}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Premium Satın Al" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text=" - 480 TL (Tek Sefer)" FontSize="16" FontWeight="Normal" Foreground="White" Opacity="0.9"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Content="Hayır, teşekkürler" Click="ContinueFree_Click"
                            Foreground="{DynamicResource TextMutedBrush}" Background="Transparent" 
                            BorderThickness="0" Margin="0,20,0,0" Cursor="Hand" FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlainButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
            
            <!-- Close Button -->
            <Button Content="✕" Click="CloseButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20"
                    Foreground="{DynamicResource TextMutedBrush}" Background="Transparent" BorderThickness="0"
                    FontSize="20" Padding="10" Cursor="Hand">
                <Button.Style>
                     <Style TargetType="Button" BasedOn="{StaticResource PlainButton}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
