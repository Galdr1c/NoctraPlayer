<Window x:Class="IPTVPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:views="clr-namespace:IPTVPlayer.Views"
        xmlns:vm="clr-namespace:IPTVPlayer.ViewModels;assembly=IPTVPlayer.Core"
        mc:Ignorable="d"
        Title="Noctra" 
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource Bg0Brush}"
        FontFamily="Segoe UI Variable, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      GlassFrameThickness="0"
                      CornerRadius="12"
                      ResizeBorderThickness="8"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SkeletonCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientBrush.GradientStops>
                            <GradientStop Color="#1E1636" Offset="0"/>
                            <GradientStop Color="#2D1B4E" Offset="0.5"/>
                            <GradientStop Color="#1E1636" Offset="1"/>
                        </GradientBrush.GradientStops>
                        <LinearGradientBrush.Transform>
                            <TranslateTransform X="-300"/>
                        </LinearGradientBrush.Transform>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(Border.Background).(Brush.Transform).(TranslateTransform.X)"
                                           From="-300" To="300"
                                           Duration="0:0:1.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="{StaticResource RadiusMedium}" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>   <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="48"/>   <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- Video Player Area (Hidden by default) -->
            <Grid x:Name="PlayerArea" Background="Black" Visibility="Collapsed" Grid.RowSpan="3" Panel.ZIndex="2000">
                <vlc:VideoView x:Name="VideoView"/>
                
                <!-- Watermark Overlay (Free Tier Only) -->
                <views:WatermarkView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WatermarkViewModel}" Panel.ZIndex="999" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,100"/>
                
                <!-- Player Controls Overlay -->
                <!-- Video Overlay (Controls, Scrim, Info) -->
                <views:VideoOverlayView x:Name="OverlayView" Panel.ZIndex="2000"/>

                <!-- Next Episode Prompt -->
                <Border x:Name="NextEpisodePrompt"
                        Background="#DD000000"
                        CornerRadius="12"
                        Padding="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,40,40"
                        Width="350"
                        Visibility="Collapsed">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNextEpisodePromptVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                               To="1" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                               To="0" Duration="0:0:0.3"/>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="Collapsed"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Sonraki Bölüm" 
                                   FontSize="14" 
                                   Foreground="#B3B3B3"
                                   Margin="0,0,0,8"/>
                        
                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="{Binding NextEpisode.Name}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding NextEpisode.Plot}"
                                       FontSize="14"
                                       Foreground="#B3B3B3"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="40"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <Button Grid.Row="2"
                                Content="▶ Şimdi İzle"
                                Command="{Binding PlayNextEpisodeCommand}"
                                Background="White"
                                Foreground="Black"
                                FontSize="16"
                                FontWeight="Bold"
                                Padding="20,12"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Skip Intro Button -->
                <Button x:Name="SkipIntroButton"
                        Command="{Binding SkipIntroCommand}"
                        Content="İntro'yu Geç ›"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,100,120"
                        Padding="24,12"
                        Background="#E5E5E5"
                        Foreground="Black"
                        FontSize="16"
                        FontWeight="Bold"
                        BorderThickness="0"

                        Cursor="Hand"
                        Opacity="0"
                        Visibility="Collapsed">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIntroDetected}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                               To="1" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                               To="0" Duration="0:0:0.3"/>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="Collapsed"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- ==========================================
                 HEADER BAR
                 ========================================== -->
            <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" CornerRadius="12,12,0,0">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Image Source="Assets/Logo.png" Height="32" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Noctra" 
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- Search Box -->
                    <!-- Search Button -->
                    <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,24,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Command="{Binding OpenSearchCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="8"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="18" Foreground="#B3B3B3" Margin="0,0,8,0"/>
                                <TextBlock Text="Ara" FontSize="16" FontWeight="SemiBold" Foreground="#B3B3B3"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Border>

                    <!-- Header Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Content="⚙️" FontSize="18" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource TextMutedBrush}" 
                                Padding="12" Cursor="Hand" Click="SettingsButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="ThemeButton" Content="🌙" FontSize="18" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource TextMutedBrush}" 
                                Padding="12" Cursor="Hand" Click="ThemeButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,12"/>
                        <Button x:Name="MinimizeButton" Content="─" FontSize="14" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource TextMutedBrush}" 
                                Padding="14,12" Cursor="Hand" Click="MinimizeButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaximizeButton" Content="□" FontSize="14" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource TextMutedBrush}" 
                                Padding="14,12" Cursor="Hand" Click="MaximizeButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="CloseButton" Content="✕" FontSize="14" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource ErrorBrush}" 
                                Padding="14,12" Cursor="Hand" Click="CloseButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==========================================
                 MAIN CONTENT AREA
                 ========================================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>  <!-- Sidebar -->
                    <ColumnDefinition Width="*"/>    <!-- Content -->
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="{StaticResource Bg1Brush}" CornerRadius="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Category Navigation -->
                        <StackPanel Grid.Row="0" Margin="16,24,16,16">
                            <!-- Home -->
                            <Border x:Name="HomeNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Home}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.Home}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🏠" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Ana Sayfa" Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Live TV -->
                            <Border x:Name="LiveNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Live}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.Live}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📺" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Canlı TV" Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- Films VOD -->
                            <Border x:Name="MoviesNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Movies}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.Movies}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎬" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Filmler" Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- Series -->
                            <Border x:Name="SeriesNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Series}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.Series}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📺" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Diziler" Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- My List -->
                            <Border x:Name="ListNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.MyList}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.MyList}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="➕" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Listem" Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20"/>

                            <!-- Favorites -->
                            <Border Background="Transparent" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand" MouseLeftButtonDown="Favorites_Click">
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⭐" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Favoriler" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- History -->
                            <Border Background="Transparent" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand">
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📜" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Geçmiş" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Groups Header -->
                        <TextBlock Grid.Row="1" Text="GRUPLAR" 
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="20,8,16,12"/>

                        <!-- Groups List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12">
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" CornerRadius="6" Margin="0,2" Cursor="Hand"
                                                MouseLeftButtonDown="GroupItem_Click">
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextMutedBrush}" 
                                                       FontSize="13" Padding="12,10" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- MAIN CONTENT -->
                <Grid Grid.Column="1">
                    <!-- 1. HOME VIEW (Hero + Rails) -->
                    <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="HomeView_ScrollChanged"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Home}}">
                        <StackPanel Margin="24">
                            <StackPanel.Resources>
                                <!-- Global styles from Styles.xaml are used instead -->
                            </StackPanel.Resources>
                            <!-- HERO SECTION -->
                            <Border Height="500" CornerRadius="16" Margin="0,0,0,40" ClipToBounds="True">
                                <Grid x:Name="HeroGrid">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="ParallaxTransform"/>
                                            <ScaleTransform x:Name="HeroZoomTransform" CenterX="600" CenterY="250"/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <!-- Hero Background Image -->
                                    <Image x:Name="HeroImage" 
                                           Stretch="UniformToFill"
                                           Source="{Binding FeaturedChannel.CoverUrl}"/>
                                    
                                    <!-- Gradient Overlay -->
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="Transparent" Offset="0.0"/>
                                                <GradientStop Color="#AA0B0614" Offset="0.5"/>
                                                <GradientStop Color="#0B0614" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    
                                    <!-- Hero Content -->
                                    <StackPanel VerticalAlignment="Bottom" Margin="60,0,60,60">
                                        <!-- Title -->
                                        <TextBlock Text="{Binding FeaturedChannel.Name}"
                                                   FontSize="56" FontWeight="Bold" 
                                                   Foreground="White"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="600"
                                                   HorizontalAlignment="Left"/>
                                        
                                        <!-- Metadata -->
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,24">
                                            <Border Background="#7C3AED" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                                                <TextBlock Text="LIVE" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding FeaturedChannel.GroupTitle}" 
                                                       FontSize="16" Foreground="#C4B5FD" VerticalAlignment="Center"/>
                                            <TextBlock Text=" • " FontSize="16" Foreground="#666" Margin="8,0"/>
                                            <TextBlock Text="HD" FontSize="16" Foreground="#22C55E" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Description -->
                                        <TextBlock Text="{Binding FeaturedChannel.Description}"
                                                   FontSize="16" Foreground="#E5E5E5"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="600"
                                                   LineHeight="24"
                                                   Margin="0,0,0,24"/>
                                        
                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Play Button -->
                                            <Button Command="{Binding PlayFeaturedCommand}"
                                                    Height="56" Padding="32,0"
                                                    Background="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="▶" FontSize="20" Foreground="Black" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="İzle" FontSize="18" Foreground="Black" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Border" 
                                                                            Background="{TemplateBinding Background}"
                                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Border" Property="Background" Value="#E5E5E5"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            
                                            <!-- My List Button -->
                                            <Button Command="{Binding DataContext.AddToMyListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding FeaturedChannel}"
                                                    Height="56" Width="56"
                                                    Background="#A06D6D6E"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,16,0"
                                                    ToolTip="Listem'e Ekle">
                                                <TextBlock Text="{Binding FeaturedChannel.IsInMyList, Converter={StaticResource BoolToIconConverter}}" 
                                                           FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Border" 
                                                                            Background="{TemplateBinding Background}"
                                                                            CornerRadius="28">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Border" Property="Background" Value="#505050"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- More Info Button -->
                                            <Button Height="56" Padding="32,0"
                                                    Background="#A06D6D6E"
                                                    BorderThickness="0"
                                                    Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="ℹ" FontSize="20" Foreground="White" Margin="0,0,12,0"/>
                                                    <TextBlock Text="Daha Fazla Bilgi" FontSize="18" Foreground="White"/>
                                                </StackPanel>
                                                 <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Border" 
                                                                            Background="{TemplateBinding Background}"
                                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Border" Property="Background" Value="#505050"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>



                            <!-- Rail: İzlemeye Devam Et -->
                            <StackPanel Visibility="{Binding ContinueWatching.Count, Converter={StaticResource CountToVisibilityConverter}}" Margin="0,0,0,40">
                                <TextBlock Text="İzlemeye Devam Et" 
                                           FontSize="24" FontWeight="SemiBold" 
                                           Foreground="White"
                                           Margin="0,0,0,16"/>
                                <ListBox ItemsSource="{Binding ContinueWatching}"
                                         Style="{StaticResource RailListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Width="{StaticResource RatioLandscapeWidth}" Height="{StaticResource RatioLandscapeHeight}" 
                                                    Style="{StaticResource NoctraCard}" ClipToBounds="True" Cursor="Hand"
                                                    MouseEnter="MediaCard_MouseEnter" MouseLeave="MediaCard_MouseLeave">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Image Source="{Binding LogoUrl}" Stretch="UniformToFill" Opacity="0.8"/>
                                                    <Border Background="{StaticResource HeroOverlayBrush}"/>
                                                    
                                                    <!-- Preview Container -->
                                                    <Border x:Name="PreviewContainer" Background="Black" Visibility="Collapsed">
                                                        <vlc:VideoView x:Name="PreviewVideoView" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <StackPanel VerticalAlignment="Bottom" Margin="12">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding GroupTitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Rail: Şu An Trend -->
                            <StackPanel Margin="0,0,0,40">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="Şu An Trend" 
                                               FontSize="24" FontWeight="SemiBold" 
                                               Foreground="White"/>
                                    <TextBlock Text=" ›" 
                                               FontSize="24" 
                                               Foreground="#7C3AED" 
                                               Margin="8,0,0,0"
                                               Cursor="Hand"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding TrendingChannels}"
                                         Style="{StaticResource RailListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Width="{StaticResource RatioLandscapeWidth}" Height="{StaticResource RatioLandscapeHeight}" 
                                                    Style="{StaticResource NoctraCard}" ClipToBounds="True" Cursor="Hand"
                                                    MouseEnter="MediaCard_MouseEnter" MouseLeave="MediaCard_MouseLeave">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Image Source="{Binding LogoUrl}" Stretch="UniformToFill" Opacity="0.8"/>
                                                    <Border Background="{StaticResource HeroOverlayBrush}"/>
                                                    
                                                    <Border x:Name="PreviewContainer" Background="Black" Visibility="Collapsed">
                                                        <vlc:VideoView x:Name="PreviewVideoView" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <StackPanel VerticalAlignment="Bottom" Margin="12">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding GroupTitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Rail: Popüler Filmler -->
                            <StackPanel Margin="0,0,0,40">
                                <TextBlock Text="Popüler Filmler" 
                                           FontSize="24" FontWeight="SemiBold" 
                                           Foreground="White"
                                           Margin="0,0,0,16"/>
                                <ListBox ItemsSource="{Binding LatestMovies}"
                                         Style="{StaticResource SeriesRailListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Width="{StaticResource RatioPortraitWidth}" Height="{StaticResource RatioPortraitHeight}" 
                                                    Style="{StaticResource NoctraCard}" ClipToBounds="True" Cursor="Hand"
                                                    MouseEnter="MediaCard_MouseEnter" MouseLeave="MediaCard_MouseLeave">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Image Source="{Binding CoverUrl}" Stretch="UniformToFill"/>
                                                    <Border Background="{StaticResource HeroOverlayBrush}"/>
                                                    
                                                    <Border x:Name="PreviewContainer" Background="Black" Visibility="Collapsed">
                                                        <vlc:VideoView x:Name="PreviewVideoView" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <StackPanel VerticalAlignment="Bottom" Margin="12">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Genre}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Rail: Yeni Diziler -->
                            <StackPanel Margin="0,0,0,40">
                                <TextBlock Text="Yeni Diziler" 
                                           FontSize="24" FontWeight="SemiBold" 
                                           Foreground="White"
                                           Margin="0,0,0,16"/>
                                <ListBox ItemsSource="{Binding LatestSeries}"
                                         Style="{StaticResource SeriesRailListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Width="{StaticResource RatioPortraitWidth}" Height="{StaticResource RatioPortraitHeight}" 
                                                    Style="{StaticResource NoctraCard}" ClipToBounds="True" Cursor="Hand"
                                                    MouseEnter="MediaCard_MouseEnter" MouseLeave="MediaCard_MouseLeave">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Image Source="{Binding CoverUrl}" Stretch="UniformToFill"/>
                                                    <Border Background="{StaticResource HeroOverlayBrush}"/>
                                                    
                                                    <Border x:Name="PreviewContainer" Background="Black" Visibility="Collapsed">
                                                        <vlc:VideoView x:Name="PreviewVideoView" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <StackPanel VerticalAlignment="Bottom" Margin="12">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Genre}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2. MOVIES VIEW -->
                    <ScrollViewer x:Name="MoviesView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Movies}}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Filmler" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,24"/>
                            <ListBox ItemsSource="{Binding FilteredChannels}" Style="{StaticResource GridListBoxStyle}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. SERIES VIEW -->
                    <ScrollViewer x:Name="SeriesView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Series}}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Diziler" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,24"/>
                            <ListBox ItemsSource="{Binding FilteredChannels}" Style="{StaticResource GridListBoxStyle}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 4. SEARCH VIEW -->
                    <ScrollViewer x:Name="SearchView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Search}}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Arama Sonuçları" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,24"/>
                            <ListBox ItemsSource="{Binding FilteredChannels}" Style="{StaticResource GridListBoxStyle}"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- 3. LIVE TV VIEW (Specialized for EPG) -->
                    <Grid x:Name="LiveView" Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Live}}">
                        <!-- EPG + Channel List specialized for Live -->
                        <TextBlock Text="Canlı TV Modu (EPG Yakında)" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Loading Skeleton State -->
                    <Grid x:Name="LoadingSkeletons" 
                          Background="{StaticResource Bg0Brush}"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                          d:IsHidden="True">
                        <StackPanel Margin="24">
                            <!-- Skeleton Hero -->
                            <Border Height="500" 
                                    Style="{StaticResource SkeletonCard}"
                                    CornerRadius="16"
                                    Margin="0,0,0,32"/>
                            
                            <!-- Skeleton Rail -->
                            <StackPanel>
                                <Border Width="200" Height="24" 
                                        Style="{StaticResource SkeletonCard}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,16"/>
                                
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="300" Height="169" 
                                            Style="{StaticResource SkeletonCard}"
                                            CornerRadius="8"
                                            Margin="0,0,12,0"/>
                                    <Border Width="300" Height="169" 
                                            Style="{StaticResource SkeletonCard}"
                                            CornerRadius="8"
                                            Margin="0,0,12,0"/>
                                    <Border Width="300" Height="169" 
                                            Style="{StaticResource SkeletonCard}"
                                            CornerRadius="8"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ==========================================
                 STATUS BAR
                 ========================================== -->
            <Border Grid.Row="2" Background="{StaticResource HeaderGradientBrush}" CornerRadius="0,0,12,12">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusPill}" 
                                Padding="14,6">
                            <TextBlock Text="{Binding FilteredChannels.Count, StringFormat='{}{0} kanal'}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        <!-- Use a separate grid for overlays to sit on top of everything (RowSpan=3) -->
        <!-- Enhanced Search Overlay -->
        <Grid x:Name="SearchOverlay" 
              Grid.RowSpan="3"
              Background="#EE141414"
              Visibility="{Binding IsSearchOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="1000">
            
            <StackPanel MaxWidth="800" 
                        VerticalAlignment="Top"
                        Margin="0,100,0,0">
                
                <!-- Search Input -->
                <Border Background="#2A2A2A" 
                        CornerRadius="8"
                        BorderBrush="#7C3AED"
                        BorderThickness="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:Name="SearchInput"
                                 FontSize="24"
                                 Foreground="White"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="20"
                                 CaretBrush="White"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchInput_KeyDown"
                                 AcceptsReturn="False">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CommitSearchCommand}"/>
                                <KeyBinding Key="Escape" Command="{Binding CloseSearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        
                        <TextBlock Text="Film, dizi veya kanal ara..."
                                   FontSize="24"
                                   Foreground="#666"
                                   Padding="20"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=invert}"/>

                        <Button Grid.Column="1"
                                Command="{Binding CommitSearchCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20"
                                Cursor="Hand"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="🔍" FontSize="24" Foreground="#7C3AED"/>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- Search Results -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              MaxHeight="500"
                              Margin="0,20,0,0">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2A2A2A"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,12"
                                    Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                                  Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Thumbnail -->
                                    <Border Width="100" Height="56"
                                            CornerRadius="4"
                                            Background="{StaticResource Surface1Brush}">
                                        <Image Source="{Binding Converter={StaticResource MediaThumbnailConverter}}" Stretch="UniformToFill"/>
                                    </Border>
                                    
                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                        <TextBlock Text="{Binding GroupTitle}"
                                                   FontSize="14"
                                                   Foreground="#B3B3B3"
                                                   Margin="0,4,0,0"/>

                                        <!-- Progress Bar -->
                                        <Border Height="3" Background="#33FFFFFF" Margin="0,12,0,0"
                                                Visibility="{Binding WatchedPercentage, Converter={StaticResource CountToVisibilityConverter}}">
                                            <Border Width="{Binding WatchedPercentage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=640}"
                                                    Background="#E50914"
                                                    HorizontalAlignment="Left"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
            
            <!-- Close Button -->
            <Button Content="✕"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="40"
                    FontSize="24"
                    Foreground="White"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding CloseSearchCommand}"
                    Cursor="Hand"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <!-- Series Detail Overlay -->
            <Grid x:Name="SeriesDetailOverlay" 
                  Grid.RowSpan="3"
                  Background="#F2141414"
                  Visibility="{Binding IsSeriesDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                  Panel.ZIndex="998">
                
                <Grid Margin="60,100">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,40">
                         <Button Command="{Binding CloseSeriesDetailCommand}" 
                                Style="{StaticResource CircleButtonStyle}" 
                                Content="←" FontSize="20" HorizontalAlignment="Left" Margin="0,0,0,24"/>
                        <TextBlock Text="{Binding SelectedSeries.Name}" FontSize="48" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding SelectedSeries.Genre}" FontSize="18" Foreground="#B3B3B3" Margin="0,8,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedSeries.Seasons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,40">
                                        <TextBlock Text="{Binding SeasonNumber, StringFormat='Sezon {0}'}" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,20"/>
                                        <ItemsControl ItemsSource="{Binding Episodes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,16,24" Background="#1A1A1A" CornerRadius="8" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" 
                                                                          Command="{Binding DataContext.PlayEpisodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            
                                                            <Border Height="100" CornerRadius="8,8,0,0" ClipToBounds="True">
                                                                <Grid>
                                                                    <Image Source="{Binding CoverUrl}" Stretch="UniformToFill"/>
                                                                    <Border Background="#44000000"/>
                                                                    <TextBlock Text="▶" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                                                </Grid>
                                                            </Border>
                                                            
                                                            <Border Grid.Row="1" Padding="12">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                                    
                                                                    <!-- Episode Progress Bar -->
                                                                    <Border Height="3" Background="#33FFFFFF" Margin="0,12,0,0"
                                                                            Visibility="{Binding WatchedPercentage, Converter={StaticResource CountToVisibilityConverter}}">
                                                                        <Border Width="{Binding WatchedPercentage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=150}"
                                                                                Background="#E50914"
                                                                                HorizontalAlignment="Left"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <!-- Mini Player (Picture-in-Picture) -->
            <Border x:Name="MiniPlayer"
                    Width="320" Height="180"
                    CornerRadius="12"
                    Background="Black"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="24"
                    Visibility="Collapsed"
                    Panel.ZIndex="999"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <vlc:VideoView x:Name="MiniVideoView"/>
                    
                    <!-- Gradient Overlay for controls visibility -->
                    <Border Background="{StaticResource HeroOverlayBrush}" IsHitTestVisible="False"/>

                    <!-- Close Button -->
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="8"
                            Width="28" Height="28"
                            Background="#AA000000"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseMiniPlayer_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                    <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
