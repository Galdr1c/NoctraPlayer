<Window x:Class="IPTVPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:cache="clr-namespace:IPTVPlayer.Behaviors"
        xmlns:views="clr-namespace:IPTVPlayer.Views"
        xmlns:vm="clr-namespace:IPTVPlayer.ViewModels;assembly=IPTVPlayer.Core"
        mc:Ignorable="d"
        Title="Noctra" 
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="{DynamicResource Bg0Brush}"
        FontFamily="Segoe UI Variable, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      ResizeBorderThickness="8"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BitmapImage x:Key="DefaultRemoteImagePlaceholder" UriSource="/Assets/Logo.png"/>

        <Style TargetType="{x:Type vlc:VideoView}">
            <Setter Property="RenderOptions.BitmapScalingMode" Value="LowQuality"/>
            <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
            <Setter Property="CacheMode">
                <Setter.Value>
                    <BitmapCache RenderAtScale="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkeletonCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientBrush.GradientStops>
                            <GradientStop Color="{DynamicResource Bg1Color}" Offset="0"/>
                            <GradientStop Color="{DynamicResource Surface0Color}" Offset="0.5"/>
                            <GradientStop Color="{DynamicResource Bg1Color}" Offset="1"/>
                        </GradientBrush.GradientStops>
                        <LinearGradientBrush.Transform>
                            <TranslateTransform X="-300"/>
                        </LinearGradientBrush.Transform>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="SkeletonShimmerStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(Border.Background).(Brush.Transform).(TranslateTransform.X)"
                                               From="-300" To="300"
                                               Duration="0:0:1.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SkeletonShimmerStoryboard"/>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Window Control Style -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Background="{DynamicResource Bg0Brush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>   <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="48"/>   <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- ==========================================
                 HEADER BAR
                 ========================================== -->
            <Border x:Name="HeaderBar"
                    Grid.Row="0"
                    Background="{DynamicResource HeaderGradientBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Image Source="Assets/Logo.png" Height="32" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Noctra" 
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- Search Box -->
                    <!-- Search Button -->
                    <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,24,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Command="{Binding OpenSearchCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="8"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="18" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Ara" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Border>

                    <!-- Header Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Settings Button -->
                    <Button Click="SettingsButton_Click" Cursor="Hand" ToolTip="Ayarlar"
                            Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SettingsBg" Background="Transparent" CornerRadius="24">
                                    <Path x:Name="SettingsIcon"
                                          Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                                          Fill="{DynamicResource TextMutedBrush}"
                                          Stretch="Uniform"
                                          Width="22" Height="22"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="GearRotation" Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SettingsBg" Property="Background" Value="{DynamicResource Surface1Brush}"/>
                                        <Setter TargetName="SettingsIcon" Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GearRotation"
                                                               Storyboard.TargetProperty="Angle"
                                                               To="90" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GearRotation"
                                                               Storyboard.TargetProperty="Angle"
                                                               To="0" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="8,8" Opacity="0.5"/>
                        
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButtonStyle}" Click="MinimizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Küçült">
                            <Path x:Name="MinimizeIcon" Data="M0,8 H12 V10 H0 Z" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="10" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>

                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButtonStyle}" Click="MaximizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Ekranı Kapla">
                            <Grid>
                                <Path x:Name="MaximizeIcon" Data="M1,1 H11 V11 H1 V1 M1,1 H11 V2 H1 V1" Fill="{DynamicResource TextMutedBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path x:Name="RestoreIcon" Data="M3,3 H11 V11 H3 V3 M5,3 V1 H13 V9 H11" Fill="Transparent" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>

                        <Button x:Name="CloseButton" Style="{StaticResource WindowCloseButtonStyle}" Click="CloseButton_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Kapat">
                            <Path x:Name="CloseIcon" Data="M1.1,1.1 L10.9,10.9 M10.9,1.1 L1.1,10.9" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==========================================
                 MAIN CONTENT AREA
                 ========================================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>  <!-- Sidebar -->
                    <ColumnDefinition Width="*"/>    <!-- Content -->
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="{DynamicResource Bg1Brush}" CornerRadius="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Category Navigation -->
                        <StackPanel Grid.Row="0" Margin="16,24,16,16">
                            <!-- Home -->
                            <Border x:Name="HomeNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Home}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.Home}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🏠" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Ana Sayfa" Foreground="{DynamicResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Live TV -->
                            <Border x:Name="LiveNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Live}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.Live}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📺" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Canlı TV" Foreground="{DynamicResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- Films VOD -->
                            <Border x:Name="MoviesNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Movies}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.Movies}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎬" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Filmler" Foreground="{DynamicResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- Series -->
                            <Border x:Name="SeriesNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Series}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.Series}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📺" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Diziler" Foreground="{DynamicResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- My List -->
                            <Border x:Name="ListNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.MyList}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.MyList}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="➕" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Listem" Foreground="{DynamicResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20"/>

                            <!-- Favorites -->
                            <Border Background="Transparent" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand" MouseLeftButtonDown="Favorites_Click">
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⭐" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Favoriler" Foreground="{DynamicResource TextSecondaryBrush}" 
                                               FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- History -->
                            <Border Background="Transparent" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand">
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📜" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Geçmiş" Foreground="{DynamicResource TextSecondaryBrush}" 
                                               FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- MAIN CONTENT -->
                <Grid Grid.Column="1">


                    <!-- 1. HOME VIEW (Hero + Rails) -->
                    <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="HomeView_ScrollChanged"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Home}}">
                        <StackPanel Margin="24">
                            <StackPanel.Resources>
                                <!-- Global styles from Styles.xaml are used instead -->
                            </StackPanel.Resources>
                            <!-- HERO SECTION -->
                            <Border Height="500" CornerRadius="16" Margin="0,0,0,40" ClipToBounds="True">
                                <Grid x:Name="HeroGrid">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="ParallaxTransform"/>
                                            <ScaleTransform x:Name="HeroZoomTransform" CenterX="600" CenterY="250"/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <!-- Hero Background Image -->
                                    <Image x:Name="HeroImage" 
                                           Stretch="UniformToFill"
                                           cache:CachedImage.SourceUrl="{Binding FeaturedChannel.CoverUrl}"
                                           cache:CachedImage.DecodePixelWidth="1400"
                                           cache:CachedImage.PlaceholderSource="{StaticResource DefaultRemoteImagePlaceholder}"/>
                                    
                                    <!-- Gradient Overlay -->
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="Transparent" Offset="0.0"/>
                                                <GradientStop Color="#AA0B0614" Offset="0.5"/>
                                                <GradientStop Color="#0B0614" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    
                                    <!-- Hero Content -->
                                    <StackPanel VerticalAlignment="Bottom" Margin="60,0,60,60">
                                        <!-- Title -->
                                        <TextBlock Text="{Binding FeaturedChannel.Name}"
                                                   FontSize="56" FontWeight="Bold" 
                                                   Foreground="White"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="600"
                                                   HorizontalAlignment="Left"/>
                                        
                                        <!-- Metadata -->
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,24">
                                            <Border Background="#7C3AED" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                                                <TextBlock Text="LIVE" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding FeaturedChannel.GroupTitle}" 
                                                       FontSize="16" Foreground="#C4B5FD" VerticalAlignment="Center"/>
                                            <TextBlock Text=" • " FontSize="16" Foreground="#666" Margin="8,0"/>
                                            <TextBlock Text="HD" FontSize="16" Foreground="#22C55E" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Description -->
                                        <TextBlock Text="{Binding FeaturedChannel.Description}"
                                                   FontSize="16" Foreground="#E5E5E5"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="600"
                                                   LineHeight="24"
                                                   Margin="0,0,0,24"/>
                                        
                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Play Button -->
                                            <Button Command="{Binding PlayFeaturedCommand}"
                                                    Height="56" Padding="32,0"
                                                    Background="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="▶" FontSize="20" Foreground="Black" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="İzle" FontSize="18" Foreground="Black" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Border" 
                                                                            Background="{TemplateBinding Background}"
                                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Border" Property="Background" Value="#E5E5E5"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            
                                            <!-- My List Button -->
                                            <Button Command="{Binding DataContext.AddToMyListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding FeaturedChannel}"
                                                    Height="56" Width="56"
                                                    Background="#A06D6D6E"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,16,0"
                                                    ToolTip="Listem'e Ekle">
                                                <TextBlock Text="{Binding FeaturedChannel.IsInMyList, Converter={StaticResource BoolToIconConverter}}" 
                                                           FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Border" 
                                                                            Background="{TemplateBinding Background}"
                                                                            CornerRadius="28">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Border" Property="Background" Value="#505050"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- More Info Button -->
                                            <Button Height="56" Padding="32,0"
                                                    Background="#A06D6D6E"
                                                    BorderThickness="0"
                                                    Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="ℹ" FontSize="20" Foreground="White" Margin="0,0,12,0"/>
                                                    <TextBlock Text="Daha Fazla Bilgi" FontSize="18" Foreground="White"/>
                                                </StackPanel>
                                                 <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Border" 
                                                                            Background="{TemplateBinding Background}"
                                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Border" Property="Background" Value="#505050"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>



                            <!-- Rail: İzlemeye Devam Et -->
                            <StackPanel Visibility="{Binding ContinueWatching.Count, Converter={StaticResource CountToVisibilityConverter}}" Margin="0,0,0,40">
                                <TextBlock Text="İzlemeye Devam Et" 
                                           FontSize="24" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,16"/>
                                <ListBox ItemsSource="{Binding ContinueWatching}"
                                         Style="{StaticResource RailListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Width="{StaticResource RatioLandscapeWidth}" Height="{StaticResource RatioLandscapeHeight}" 
                                                    Style="{StaticResource NoctraCard}" ClipToBounds="True" Cursor="Hand"
                                                    MouseEnter="MediaCard_MouseEnter" MouseLeave="MediaCard_MouseLeave">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Image Stretch="UniformToFill" Opacity="0.8"
                                                           cache:CachedImage.SourceUrl="{Binding LogoUrl}"
                                                           cache:CachedImage.DecodePixelWidth="320"
                                                           cache:CachedImage.PlaceholderSource="{StaticResource DefaultRemoteImagePlaceholder}"/>
                                                    <Border Background="{StaticResource HeroOverlayBrush}"/>
                                                    
                                                    <!-- Preview Container -->
                                                    <Border x:Name="PreviewContainer" Background="Black" Visibility="Collapsed">
                                                        <vlc:VideoView x:Name="PreviewVideoView" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <StackPanel VerticalAlignment="Bottom" Margin="12">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Rail: Şu An Trend -->
                            <StackPanel Margin="0,0,0,40">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="Şu An Trend" 
                                               FontSize="24" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text=" ›" 
                                               FontSize="24" 
                                               Foreground="#7C3AED" 
                                               Margin="8,0,0,0"
                                               Cursor="Hand"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding TrendingChannels}"
                                         Style="{StaticResource RailListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Width="{StaticResource RatioLandscapeWidth}" Height="{StaticResource RatioLandscapeHeight}" 
                                                    Style="{StaticResource NoctraCard}" ClipToBounds="True" Cursor="Hand"
                                                    MouseEnter="MediaCard_MouseEnter" MouseLeave="MediaCard_MouseLeave"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Listem'e Ekle/Çıkar" Command="{Binding PlacementTarget.Tag.AddToMyListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Favorilere Ekle/Çıkar" Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Düzenle..." Command="{Binding PlacementTarget.Tag.EditChannelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Image Stretch="UniformToFill" Opacity="0.8"
                                                           cache:CachedImage.SourceUrl="{Binding LogoUrl}"
                                                           cache:CachedImage.DecodePixelWidth="320"
                                                           cache:CachedImage.PlaceholderSource="{StaticResource DefaultRemoteImagePlaceholder}"/>
                                                    <Border Background="{StaticResource HeroOverlayBrush}"/>
                                                    
                                                    <Border x:Name="PreviewContainer" Background="Black" Visibility="Collapsed">
                                                        <vlc:VideoView x:Name="PreviewVideoView" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <StackPanel VerticalAlignment="Bottom" Margin="12">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Rail: Popüler Filmler -->
                            <StackPanel Margin="0,0,0,40">
                                <TextBlock Text="Popüler Filmler" 
                                           FontSize="24" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,16"/>
                                <ListBox ItemsSource="{Binding LatestMovies}"
                                         Style="{StaticResource SeriesRailListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Width="{StaticResource RatioPortraitWidth}" Height="{StaticResource RatioPortraitHeight}" 
                                                    Style="{StaticResource NoctraCard}" ClipToBounds="True" Cursor="Hand"
                                                    MouseEnter="MediaCard_MouseEnter" MouseLeave="MediaCard_MouseLeave">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Listem'e Ekle/Çıkar" Command="{Binding DataContext.AddToMyListCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Favorilere Ekle/Çıkar" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Düzenle..." Command="{Binding DataContext.EditChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Image Stretch="UniformToFill"
                                                           cache:CachedImage.SourceUrl="{Binding CoverUrl}"
                                                           cache:CachedImage.DecodePixelWidth="220"
                                                           cache:CachedImage.PlaceholderSource="{StaticResource DefaultRemoteImagePlaceholder}"/>
                                                    <Border Background="{StaticResource HeroOverlayBrush}"/>
                                                    
                                                    <Border x:Name="PreviewContainer" Background="Black" Visibility="Collapsed">
                                                        <vlc:VideoView x:Name="PreviewVideoView" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <StackPanel VerticalAlignment="Bottom" Margin="12">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Genre}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Rail: Yeni Diziler -->
                            <StackPanel Margin="0,0,0,40">
                                <TextBlock Text="Yeni Diziler" 
                                           FontSize="24" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,16"/>
                                <ListBox ItemsSource="{Binding LatestSeries}"
                                         Style="{StaticResource SeriesRailListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Width="{StaticResource RatioPortraitWidth}" Height="{StaticResource RatioPortraitHeight}" 
                                                    Style="{StaticResource NoctraCard}" ClipToBounds="True" Cursor="Hand"
                                                    MouseEnter="MediaCard_MouseEnter" MouseLeave="MediaCard_MouseLeave"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Listem'e Ekle/Çıkar" Command="{Binding PlacementTarget.Tag.AddToMyListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Favorilere Ekle/Çıkar" Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Düzenle..." Command="{Binding PlacementTarget.Tag.EditChannelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Image Stretch="UniformToFill"
                                                           cache:CachedImage.SourceUrl="{Binding CoverUrl}"
                                                           cache:CachedImage.DecodePixelWidth="220"
                                                           cache:CachedImage.PlaceholderSource="{StaticResource DefaultRemoteImagePlaceholder}"/>
                                                    <Border Background="{StaticResource HeroOverlayBrush}"/>
                                                    
                                                    <Border x:Name="PreviewContainer" Background="Black" Visibility="Collapsed">
                                                        <vlc:VideoView x:Name="PreviewVideoView" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <StackPanel VerticalAlignment="Bottom" Margin="12">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Genre}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2. MOVIES VIEW -->
                    <ScrollViewer x:Name="MoviesView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="ContentView_ScrollChanged"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Movies}}">
                        <StackPanel Margin="24">
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Filmler" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox Width="260"
                                              Margin="0,0,10,0"
                                              ItemsSource="{Binding Groups}"
                                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"/>
                                    <Button Content="Tümü"
                                            Width="64"
                                            Margin="0,0,10,0"
                                            Click="ClearGroupSelection_Click"/>
                                    <ComboBox Width="240"
                                              ItemsSource="{Binding SortOptions}"
                                              SelectedValue="{Binding SelectedSortOrder, Mode=TwoWay}"
                                              SelectedValuePath="Key"
                                              DisplayMemberPath="Value"/>
                                </StackPanel>
                            </Grid>
                            <ListBox ItemsSource="{Binding FilteredChannels}" Style="{StaticResource GridListBoxStyle}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. SERIES VIEW -->
                    <ScrollViewer x:Name="SeriesView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="ContentView_ScrollChanged"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Series}}">
                        <StackPanel Margin="24">
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Diziler" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox Width="260"
                                              Margin="0,0,10,0"
                                              ItemsSource="{Binding Groups}"
                                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"/>
                                    <Button Content="Tümü"
                                            Width="64"
                                            Margin="0,0,10,0"
                                            Click="ClearGroupSelection_Click"/>
                                    <ComboBox Width="240"
                                              ItemsSource="{Binding SortOptions}"
                                              SelectedValue="{Binding SelectedSortOrder, Mode=TwoWay}"
                                              SelectedValuePath="Key"
                                              DisplayMemberPath="Value"/>
                                </StackPanel>
                            </Grid>
                            <ListBox ItemsSource="{Binding FilteredChannels}" Style="{StaticResource GridListBoxStyle}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 4. SEARCH VIEW -->
                    <ScrollViewer x:Name="SearchView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="ContentView_ScrollChanged"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Search}}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Arama Sonuçları" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                            <ListBox ItemsSource="{Binding FilteredChannels}" Style="{StaticResource GridListBoxStyle}"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- 5. MY LIST VIEW -->
                    <ScrollViewer x:Name="MyListView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.MyList}}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Listem" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                            <ListBox ItemsSource="{Binding MyList}" Style="{StaticResource GridListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Card" Margin="0,0,16,16" Background="{DynamicResource Surface0Brush}" 
                                                CornerRadius="{StaticResource RadiusMedium}" Cursor="Hand"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Listem'e Ekle/Çıkar" Command="{Binding PlacementTarget.Tag.AddToMyListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Favorilere Ekle/Çıkar" Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Düzenle..." Command="{Binding PlacementTarget.Tag.EditChannelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <StackPanel Margin="12">
                                                <Border Height="100" Background="{StaticResource IconGradientBrush}" CornerRadius="{StaticResource RadiusSmall}" Margin="0,0,0,12">
                                                    <Image Width="60" Stretch="Uniform"
                                                           cache:CachedImage.SourceUrl="{Binding LogoUrl}"
                                                           cache:CachedImage.DecodePixelWidth="120"
                                                           cache:CachedImage.PlaceholderSource="{StaticResource DefaultRemoteImagePlaceholder}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0"
                                        Visibility="{Binding MyList.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}">
                                <TextBlock Text="Henüz listenize bir şey eklemediniz." 
                                           FontSize="16" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. LIVE TV VIEW (Specialized for EPG) -->
                    <!-- 3. LIVE TV VIEW -->
                    <ScrollViewer x:Name="LiveView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="ContentView_ScrollChanged"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Live}}">
                        <StackPanel Margin="24">
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Canlı TV" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox Width="260"
                                              Margin="0,0,10,0"
                                              ItemsSource="{Binding Groups}"
                                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"/>
                                    <Button Content="Tümü"
                                            Width="64"
                                            Margin="0,0,10,0"
                                            Click="ClearGroupSelection_Click"/>
                                    <ComboBox Width="240"
                                              ItemsSource="{Binding SortOptions}"
                                              SelectedValue="{Binding SelectedSortOrder, Mode=TwoWay}"
                                              SelectedValuePath="Key"
                                              DisplayMemberPath="Value"/>
                                </StackPanel>
                            </Grid>
                            <ListBox ItemsSource="{Binding FilteredChannels}" Style="{StaticResource GridListBoxStyle}"/>
                            
                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0"
                                        Visibility="{Binding FilteredChannels.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}">
                                <TextBlock Text="Bu kategoride kanal bulunamadı." 
                                           FontSize="16" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Loading Skeleton State -->
                    <Grid x:Name="LoadingSkeletons" 
                          Background="{DynamicResource Bg0Brush}"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                          d:IsHidden="True">
                        <StackPanel Margin="24">
                            <!-- Skeleton Hero -->
                            <Border Height="500" 
                                    Style="{StaticResource SkeletonCard}"
                                    CornerRadius="16"
                                    Margin="0,0,0,32"/>
                            
                            <!-- Skeleton Rail -->
                            <StackPanel>
                                <Border Width="200" Height="24" 
                                        Style="{StaticResource SkeletonCard}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,16"/>
                                
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="300" Height="169" 
                                            Style="{StaticResource SkeletonCard}"
                                            CornerRadius="8"
                                            Margin="0,0,12,0"/>
                                    <Border Width="300" Height="169" 
                                            Style="{StaticResource SkeletonCard}"
                                            CornerRadius="8"
                                            Margin="0,0,12,0"/>
                                    <Border Width="300" Height="169" 
                                            Style="{StaticResource SkeletonCard}"
                                            CornerRadius="8"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ==========================================
                 STATUS BAR
                 ========================================== -->
            <Border Grid.Row="2" Background="{DynamicResource HeaderGradientBrush}" CornerRadius="0,0,12,12">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="{DynamicResource RadiusPill}" 
                                Padding="14,6">
                            <TextBlock Text="{Binding FilteredChannels.Count, StringFormat='{}{0} kanal'}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        <!-- Use a separate grid for overlays to sit on top of everything (RowSpan=3) -->
        <!-- Enhanced Search Overlay -->
        <Grid x:Name="SearchOverlay" 
              Grid.RowSpan="3"
              Background="{DynamicResource HeroOverlayBrush}"
              Visibility="{Binding IsSearchOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="1000">
            
            <StackPanel MaxWidth="800" 
                        VerticalAlignment="Top"
                        Margin="0,100,0,0">
                
                <!-- Search Input -->
                <Border Background="{DynamicResource Bg1Brush}" 
                        CornerRadius="8"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:Name="SearchInput"
                                 FontSize="24"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="20"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchInput_KeyDown"
                                 AcceptsReturn="False"/>
                        
                        <TextBlock Text="Film, dizi veya kanal ara..."
                                   FontSize="24"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Padding="20"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchInput, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=invert}"/>

                        <Button Grid.Column="1"
                                Command="{Binding CommitSearchCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20"
                                Cursor="Hand"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="🔍" FontSize="24" Foreground="#7C3AED"/>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- Search Results -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              MaxHeight="500"
                              Margin="0,20,0,0">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface1Brush}"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,12"
                                    Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                                  Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Thumbnail -->
                                    <Border Width="100" Height="56"
                                            CornerRadius="4"
                                            Background="{DynamicResource Surface1Brush}">
                                        <Image Stretch="UniformToFill"
                                               cache:CachedImage.SourceUrl="{Binding Converter={StaticResource MediaThumbnailConverter}}"
                                               cache:CachedImage.DecodePixelWidth="200"
                                               cache:CachedImage.PlaceholderSource="{StaticResource DefaultRemoteImagePlaceholder}"/>
                                    </Border>
                                    
                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding GroupTitle}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,4,0,0"/>

                                        <!-- Progress Bar -->
                                        <Border Height="3" Background="#33FFFFFF" Margin="0,12,0,0"
                                                Visibility="{Binding WatchedPercentage, Converter={StaticResource CountToVisibilityConverter}}">
                                            <Border Width="{Binding WatchedPercentage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=640}"
                                                    Background="#E50914"
                                                    HorizontalAlignment="Left"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
            
            <!-- Close Button -->
            <Button Content="✕"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="40"
                    FontSize="24"
                    Foreground="White"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding CloseSearchCommand}"
                    Cursor="Hand"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <!-- Series Detail Overlay -->
            <Grid x:Name="SeriesDetailOverlay" 
                  Grid.RowSpan="3"
                  Background="{DynamicResource BackgroundGradientBrush}"
                  Visibility="{Binding IsSeriesDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                  Panel.ZIndex="998">
                
                <Grid Margin="60,100">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,40">
                         <Button Command="{Binding CloseSeriesDetailCommand}" 
                                Style="{StaticResource CircleButtonStyle}" 
                                Content="←" FontSize="20" HorizontalAlignment="Left" Margin="0,0,0,24"/>
                        <TextBlock Text="{Binding SelectedSeries.Name}" FontSize="48" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SelectedSeries.Genre}" FontSize="18" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedSeries.Seasons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,40">
                                        <TextBlock Text="{Binding SeasonNumber, StringFormat='Sezon {0}'}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                        <ItemsControl ItemsSource="{Binding Episodes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,16,24" Background="{DynamicResource Bg1Brush}" CornerRadius="8" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" 
                                                                          Command="{Binding DataContext.PlayEpisodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            
                                                            <Border Height="100" CornerRadius="8,8,0,0" ClipToBounds="True">
                                                                <Grid>
                                                                    <Image Stretch="UniformToFill"
                                                                           cache:CachedImage.SourceUrl="{Binding CoverUrl}"
                                                                           cache:CachedImage.DecodePixelWidth="240"
                                                                           cache:CachedImage.PlaceholderSource="{StaticResource DefaultRemoteImagePlaceholder}"/>
                                                                    <Border Background="#44000000"/>
                                                                    <TextBlock Text="▶" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                                                </Grid>
                                                            </Border>
                                                            
                                                            <Border Grid.Row="1" Padding="12">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                                    
                                                                    <!-- Episode Progress Bar -->
                                                                    <Border Height="3" Background="#33FFFFFF" Margin="0,12,0,0"
                                                                            Visibility="{Binding WatchedPercentage, Converter={StaticResource CountToVisibilityConverter}}">
                                                                        <Border Width="{Binding WatchedPercentage, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=150}"
                                                                                Background="#E50914"
                                                                                HorizontalAlignment="Left"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <!-- Mini Player (Picture-in-Picture) -->
            <Border x:Name="MiniPlayer"
                    Width="320" Height="180"
                    CornerRadius="12"
                    Background="Black"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="24"
                    Visibility="Collapsed"
                    Panel.ZIndex="999"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <vlc:VideoView x:Name="MiniVideoView"/>
                    
                    <!-- Gradient Overlay for controls visibility -->
                    <Border Background="{StaticResource HeroOverlayBrush}" IsHitTestVisible="False"/>

                    <!-- Close Button -->
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="8"
                            Width="28" Height="28"
                            Background="#AA000000"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseMiniPlayer_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                    <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>

            <!-- ==========================================
                 PLAYER AREA (FULL WINDOW)
                 ========================================== -->
            <Grid x:Name="PlayerArea" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
                  Background="Black" Visibility="Collapsed" ClipToBounds="True" Panel.ZIndex="2000">

                <vlc:VideoView x:Name="VideoView" Panel.ZIndex="1"/>

                <views:WatermarkView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WatermarkViewModel}"
                                     Panel.ZIndex="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,100"/>

                <Popup x:Name="OverlayPopup"
                       Placement="Relative"
                       PlacementTarget="{Binding ElementName=PlayerArea}"
                       IsOpen="{Binding ElementName=PlayerArea, Path=IsVisible, Mode=OneWay}"
                       AllowsTransparency="True"
                       StaysOpen="True">
                    <views:VideoOverlayView x:Name="VideoOverlay"
                                            DataContext="{Binding DataContext, ElementName=PlayerArea}"
                                            Width="{Binding ActualWidth, ElementName=PlayerArea}"
                                            Height="{Binding ActualHeight, ElementName=PlayerArea}"/>
                </Popup>

                <!-- Next Episode Prompt -->
                <Border x:Name="NextEpisodePrompt"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="12"
                        Padding="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,40,40"
                        Width="350"
                        Visibility="Collapsed"
                        Panel.ZIndex="3000">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNextEpisodePromptVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                               To="1" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                               To="0" Duration="0:0:0.3"/>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="Collapsed"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Sonraki Bölüm" 
                                   FontSize="14" 
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,8"/>
                        
                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="{Binding NextEpisode.Name}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding NextEpisode.Plot}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="40"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <Button Grid.Row="2"
                                Content="▶ Şimdi İzle"
                                Command="{Binding PlayNextEpisodeCommand}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                FontSize="16"
                                FontWeight="Bold"
                                Padding="20,12"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Skip Intro Button -->
                <Button x:Name="SkipIntroButton"
                        Command="{Binding SkipIntroCommand}"
                        Content="İntro'yu Geç ›"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,100,120"
                        Padding="24,12"
                        Background="{DynamicResource Surface1Brush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        FontSize="16"
                        FontWeight="Bold"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Cursor="Hand"
                        Opacity="0"
                        Visibility="Collapsed"
                        Panel.ZIndex="3000">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIntroDetected}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                               To="1" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                               To="0" Duration="0:0:0.3"/>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="Collapsed"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
    </Grid>
    </Border>
</Window>
