<Window x:Class="IPTVPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:views="clr-namespace:IPTVPlayer.Views"
        mc:Ignorable="d"
        Title="IPTV Player" 
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Border CornerRadius="{StaticResource RadiusMedium}" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>   <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="48"/>   <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- ==========================================
                 HEADER BAR
                 ========================================== -->
            <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" CornerRadius="12,12,0,0">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusSmall}" 
                                Padding="10,8" Margin="0,0,12,0">
                            <TextBlock Text="📺" FontSize="18" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="IPTV Player" 
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Search Box -->
                    <Border Grid.Column="1" CornerRadius="{StaticResource RadiusPill}" Background="{StaticResource Surface0Brush}"
                            Margin="80,12" MaxWidth="500" MinWidth="300" HorizontalAlignment="Center"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="16" Foreground="{StaticResource TextMutedBrush}" 
                                       VerticalAlignment="Center" Margin="18,0,10,0"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                                     VerticalContentAlignment="Center"
                                     Padding="8,14"
                                     FontSize="14"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Escape" Command="{Binding ClearFiltersCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- Header Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Content="⚙️" FontSize="18" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource TextMutedBrush}" 
                                Padding="12" Cursor="Hand" Click="SettingsButton_Click"/>
                        <Button x:Name="ThemeButton" Content="🌙" FontSize="18" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource TextMutedBrush}" 
                                Padding="12" Cursor="Hand" Click="ThemeButton_Click"/>
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,12"/>
                        <Button x:Name="MinimizeButton" Content="─" FontSize="14" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource TextMutedBrush}" 
                                Padding="14,12" Cursor="Hand" Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton" Content="□" FontSize="14" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource TextMutedBrush}" 
                                Padding="14,12" Cursor="Hand" Click="MaximizeButton_Click"/>
                        <Button x:Name="CloseButton" Content="✕" FontSize="14" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource ErrorBrush}" 
                                Padding="14,12" Cursor="Hand" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==========================================
                 MAIN CONTENT AREA
                 ========================================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>  <!-- Sidebar -->
                    <ColumnDefinition Width="*"/>    <!-- Content -->
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="{StaticResource Bg1Brush}" CornerRadius="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Category Navigation -->
                        <StackPanel Grid.Row="0" Margin="16,24,16,16">
                            <!-- Live TV -->
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand" MouseLeftButtonDown="LiveTV_Click">
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📺" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Canlı TV" Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- Films VOD -->
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand" MouseLeftButtonDown="VOD_Click">
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎬" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Filmler" Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- Series -->
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand" MouseLeftButtonDown="Series_Click">
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📺" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Diziler" Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20"/>

                            <!-- Favorites -->
                            <Border Background="Transparent" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand" MouseLeftButtonDown="Favorites_Click">
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⭐" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Favoriler" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- History -->
                            <Border Background="Transparent" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand">
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📜" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Geçmiş" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Groups Header -->
                        <TextBlock Grid.Row="1" Text="GRUPLAR" 
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="20,8,16,12"/>

                        <!-- Groups List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12">
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" CornerRadius="6" Margin="0,2" Cursor="Hand"
                                                MouseLeftButtonDown="GroupItem_Click">
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextMutedBrush}" 
                                                       FontSize="13" Padding="12,10" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- MAIN CONTENT -->
                <Grid Grid.Column="1">
                    <!-- Video Player Area (Hidden by default) -->
                    <Grid x:Name="PlayerArea" Background="Black" Visibility="Collapsed">
                        <vlc:VideoView x:Name="VideoView"/>
                        
                        <!-- Watermark Overlay (Free Tier Only) -->
                        <views:WatermarkView DataContext="{Binding WatermarkViewModel}" Panel.ZIndex="999" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,100"/>
                        
                        <!-- Player Controls Overlay -->
                        <Border x:Name="PlayerControls" 
                                VerticalAlignment="Bottom"
                                Background="#DD0B0614"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Margin="24">
                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Progress Bar -->
                                <Slider x:Name="ProgressSlider" Grid.Row="0"
                                        Style="{StaticResource ModernSlider}"
                                        Minimum="0" Maximum="{Binding Duration}"
                                        Value="{Binding Position}"
                                        Margin="0,0,0,16"/>

                                <!-- Control Buttons -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="⏮" FontSize="20" Background="Transparent" BorderThickness="0" 
                                            Foreground="{StaticResource TextPrimaryBrush}" Padding="12,8" Cursor="Hand"
                                            Command="{Binding SkipBackwardCommand}"/>
                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusPill}" 
                                            Margin="16,0" Cursor="Hand">
                                        <Button Content="⏸" FontSize="28" Background="Transparent" BorderThickness="0" 
                                                Foreground="{StaticResource TextPrimaryBrush}" Padding="24,12"
                                                Command="{Binding PlayPauseCommand}"/>
                                    </Border>
                                    <Button Content="⏭" FontSize="20" Background="Transparent" BorderThickness="0" 
                                            Foreground="{StaticResource TextPrimaryBrush}" Padding="12,8" Cursor="Hand"
                                            Command="{Binding SkipForwardCommand}"/>
                                    
                                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="24,4"/>
                                    
                                    <Button Content="🔊" FontSize="18" Background="Transparent" BorderThickness="0" 
                                            Foreground="{StaticResource TextPrimaryBrush}" Padding="12,8" Cursor="Hand"/>
                                    <Slider Style="{StaticResource ModernSlider}" Width="100"
                                            Minimum="0" Maximum="100"
                                            Value="{Binding Volume}"
                                            VerticalAlignment="Center"/>
                                    
                                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="24,4"/>
                                    
                                    <Button Content="⛶" FontSize="18" Background="Transparent" BorderThickness="0" 
                                            Foreground="{StaticResource TextPrimaryBrush}" Padding="12,8" Cursor="Hand"
                                            Command="{Binding ToggleFullScreenCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Now Playing Info -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                Background="#CC0B0614"
                                CornerRadius="0,0,12,0"
                                Padding="24,18">
                            <StackPanel>
                                <TextBlock x:Name="NowPlayingTitle" 
                                           Text="{Binding CurrentChannel.Name}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="NowPlayingProgram"
                                           Text="{Binding CurrentProgram.Title}"
                                           FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- HOME CONTENT (Hero + Rails) -->
                    <ScrollViewer x:Name="ChannelScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24">
                            
                            <!-- HERO SECTION -->
                            <Border Height="320" CornerRadius="{StaticResource RadiusLarge}" Margin="0,0,0,32" ClipToBounds="True">
                                <Grid>
                                    <!-- Hero Background (Placeholder) -->
                                    <Border Background="{StaticResource Surface0Brush}">
                                        <Grid>
                                            <Border>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#1E1636" Offset="0.0"/>
                                                        <GradientStop Color="#2D1B4E" Offset="0.5"/>
                                                        <GradientStop Color="#0B0614" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- Decorative elements -->
                                            <TextBlock Text="🎬" FontSize="120" Opacity="0.1" 
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="60"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Hero Overlay Gradient -->
                                    <Border Background="{StaticResource HeroOverlayBrush}"/>
                                    
                                    <!-- Hero Content -->
                                    <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,40">
                                        <!-- NOW PLAYING Badge -->
                                        <Border Background="{StaticResource LiveRedBrush}" CornerRadius="{StaticResource RadiusSmall}"
                                                HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,16">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,8,0"/>
                                                <TextBlock Text="ŞİMDİ YAYINDA" FontSize="11" FontWeight="Bold" 
                                                           Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <TextBlock Text="IPTV Player'a Hoş Geldiniz" 
                                                   FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Binlerce canlı TV kanalı, film ve dizi içeriğine erişin"
                                                   FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,24"/>
                                        
                                        <!-- Hero Actions -->
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusSmall}"
                                                    Cursor="Hand" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" Margin="20,12">
                                                    <TextBlock Text="▶" FontSize="14" Foreground="White" Margin="0,0,8,0"/>
                                                    <TextBlock Text="İzlemeye Başla" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusSmall}" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal" Margin="20,12">
                                                    <TextBlock Text="ℹ" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Daha Fazla Bilgi" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- CHANNEL RAILS -->
                            <!-- Rail: All Channels -->
                            <StackPanel Margin="0,0,0,32">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="Tüm Kanallar" FontSize="20" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusPill}"
                                            Padding="12,4" Margin="12,0">
                                        <TextBlock Text="{Binding FilteredChannels.Count}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                
                                <ListBox ItemsSource="{Binding FilteredChannels}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         VirtualizingStackPanel.CacheLengthUnit="Item"
                                         VirtualizingStackPanel.CacheLength="10,10">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="200" Background="{StaticResource Surface0Brush}" 
                                                    CornerRadius="{StaticResource RadiusMedium}" 
                                                    Margin="0,0,16,16" Cursor="Hand"
                                                    BorderThickness="1" BorderBrush="Transparent"
                                                    MouseLeftButtonDown="ChannelCard_Click">
                                                <Grid>
                                                    <StackPanel Margin="16">
                                                        <!-- Logo -->
                                                        <Border Background="{StaticResource Surface1Brush}" 
                                                                CornerRadius="{StaticResource RadiusSmall}" 
                                                                Width="80" Height="80" Margin="0,0,0,12"
                                                                HorizontalAlignment="Center">
                                                            <Image Source="{Binding LogoUrl}" 
                                                                   Width="60" Height="60"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                                        </Border>
                                                        
                                                        <!-- Info -->
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextAlignment="Center"
                                                                   MaxHeight="40"/>
                                                        <TextBlock Text="{Binding GroupTitle}"
                                                                   FontSize="12" Margin="0,4,0,0"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Live Badge -->
                                                    <Border Background="{StaticResource LiveRedBrush}" 
                                                            CornerRadius="4" Padding="6,3"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="8">
                                                        <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Loading Indicator -->
                    <Border x:Name="LoadingOverlay" Grid.Row="0"
                            Background="#EE0B0614" CornerRadius="{StaticResource RadiusMedium}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="30" Width="60" Height="60" Margin="0,0,0,16">
                                <TextBlock Text="⏳" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Yükleniyor..." 
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==========================================
                 STATUS BAR
                 ========================================== -->
            <Border Grid.Row="2" Background="{StaticResource HeaderGradientBrush}" CornerRadius="0,0,12,12">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusPill}" 
                                Padding="14,6">
                            <TextBlock Text="{Binding FilteredChannels.Count, StringFormat='{}{0} kanal'}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
