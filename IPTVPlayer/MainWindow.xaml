<Window x:Class="IPTVPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:views="clr-namespace:IPTVPlayer.Views"
        xmlns:vm="clr-namespace:IPTVPlayer.ViewModels;assembly=IPTVPlayer.Core"
        mc:Ignorable="d"
        Title="Noctra" 
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource Bg0Brush}"
        FontFamily="Segoe UI Variable, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      GlassFrameThickness="0"
                      CornerRadius="12"
                      ResizeBorderThickness="8"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="{StaticResource RadiusMedium}" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>   <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="48"/>   <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- ==========================================
                 HEADER BAR
                 ========================================== -->
            <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" CornerRadius="12,12,0,0">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Image Source="Assets/Logo.png" Height="32" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Noctra" 
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- Search Box -->
                    <Border Grid.Column="1" CornerRadius="{StaticResource RadiusPill}" Background="{StaticResource Surface0Brush}"
                            Margin="80,12" MaxWidth="500" MinWidth="300" HorizontalAlignment="Center"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="16" Foreground="{StaticResource TextMutedBrush}" 
                                       VerticalAlignment="Center" Margin="18,0,10,0"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                                     VerticalContentAlignment="Center"
                                     Padding="8,14"
                                     FontSize="14"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Escape" Command="{Binding ClearFiltersCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- Header Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Content="⚙️" FontSize="18" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource TextMutedBrush}" 
                                Padding="12" Cursor="Hand" Click="SettingsButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="ThemeButton" Content="🌙" FontSize="18" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource TextMutedBrush}" 
                                Padding="12" Cursor="Hand" Click="ThemeButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,12"/>
                        <Button x:Name="MinimizeButton" Content="─" FontSize="14" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource TextMutedBrush}" 
                                Padding="14,12" Cursor="Hand" Click="MinimizeButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaximizeButton" Content="□" FontSize="14" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource TextMutedBrush}" 
                                Padding="14,12" Cursor="Hand" Click="MaximizeButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="CloseButton" Content="✕" FontSize="14" 
                                Background="Transparent" BorderThickness="0" 
                                Foreground="{StaticResource ErrorBrush}" 
                                Padding="14,12" Cursor="Hand" Click="CloseButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==========================================
                 MAIN CONTENT AREA
                 ========================================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>  <!-- Sidebar -->
                    <ColumnDefinition Width="*"/>    <!-- Content -->
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="{StaticResource Bg1Brush}" CornerRadius="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Category Navigation -->
                        <StackPanel Grid.Row="0" Margin="16,24,16,16">
                            <!-- Home -->
                            <Border x:Name="HomeNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Home}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.Home}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🏠" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Ana Sayfa" Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Live TV -->
                            <Border x:Name="LiveNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Live}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.Live}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📺" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Canlı TV" Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- Films VOD -->
                            <Border x:Name="MoviesNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Movies}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.Movies}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎬" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Filmler" Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- Series -->
                            <Border x:Name="SeriesNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.Series}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.Series}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📺" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Diziler" Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- My List -->
                            <Border x:Name="ListNav" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand"
                                    Background="{Binding ActiveView, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter={x:Static vm:AppView.MyList}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" 
                                                  CommandParameter="{x:Static vm:AppView.MyList}"/>
                                </Border.InputBindings>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="➕" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Listem" Foreground="{StaticResource TextPrimaryBrush}" 
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20"/>

                            <!-- Favorites -->
                            <Border Background="Transparent" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand" MouseLeftButtonDown="Favorites_Click">
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⭐" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Favoriler" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- History -->
                            <Border Background="Transparent" CornerRadius="{StaticResource RadiusSmall}" 
                                    Margin="0,4" Cursor="Hand">
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📜" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Geçmiş" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Groups Header -->
                        <TextBlock Grid.Row="1" Text="GRUPLAR" 
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="20,8,16,12"/>

                        <!-- Groups List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12">
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" CornerRadius="6" Margin="0,2" Cursor="Hand"
                                                MouseLeftButtonDown="GroupItem_Click">
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextMutedBrush}" 
                                                       FontSize="13" Padding="12,10" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- MAIN CONTENT -->
                <Grid Grid.Column="1">
                    <!-- Video Player Area (Hidden by default) -->
                    <Grid x:Name="PlayerArea" Background="Black" Visibility="Collapsed">
                        <vlc:VideoView x:Name="VideoView"/>
                        
                        <!-- Watermark Overlay (Free Tier Only) -->
                        <views:WatermarkView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WatermarkViewModel}" Panel.ZIndex="999" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,100"/>
                        
                        <!-- Player Controls Overlay -->
                        <!-- Video Overlay (Controls, Scrim, Info) -->
                        <views:VideoOverlayView x:Name="OverlayView" />
                    </Grid>

                    <!-- 1. HOME VIEW (Hero + Rails) -->
                    <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Home}}">
                        <StackPanel Margin="24">
                            <!-- HERO SECTION (Existing) -->
                            <Border Height="320" CornerRadius="{StaticResource RadiusLarge}" Margin="0,0,0,32" ClipToBounds="True">
                                <Grid>
                                    <Border Background="{StaticResource Surface0Brush}">
                                        <Grid>
                                            <Border Background="{StaticResource HeaderGradientBrush}"/>
                                            <TextBlock Text="🎬" FontSize="120" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="60"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{StaticResource HeroOverlayBrush}"/>
                                    <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,40">
                                        <Border Background="{StaticResource LiveRedBrush}" CornerRadius="{StaticResource RadiusSmall}" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,16">
                                            <TextBlock Text="Popüler İçerik" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="Sizin İçin Seçtiklerimiz" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="En sevdiğiniz kanalları ve filmleri tek bir yerden izleyin." FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,24"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Rail: İzlemeye Devam Et (Conditional) -->
                            <StackPanel Visibility="{Binding ContinueWatching.Count, Converter={StaticResource CountToVisibilityConverter}}" Margin="0,0,0,32">
                                <TextBlock Text="İzlemeye Devam Et" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <ListBox ItemsSource="{Binding ContinueWatching}" Style="{StaticResource RailListBoxStyle}"/>
                            </StackPanel>

                            <!-- Rail: Canlı Şu An Popüler -->
                            <StackPanel Margin="0,0,0,32">
                                <TextBlock Text="Canlı Yayında Popüler" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <ListBox ItemsSource="{Binding TrendingChannels}" Style="{StaticResource RailListBoxStyle}"/>
                            </StackPanel>

                            <!-- Rail: Yeni Filmler -->
                            <StackPanel Margin="0,0,0,32">
                                <TextBlock Text="Son Eklenen Filmler" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <ListBox ItemsSource="{Binding LatestMovies}" Style="{StaticResource RailListBoxStyle}"/>
                            </StackPanel>

                            <!-- Rail: Yeni Diziler -->
                            <StackPanel Margin="0,0,0,32">
                                <TextBlock Text="Yeni Diziler" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <ListBox ItemsSource="{Binding LatestSeries}" Style="{StaticResource SeriesRailListBoxStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2. MOVIES VIEW -->
                    <ScrollViewer x:Name="MoviesView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Movies}}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Filmler" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,24"/>
                            <ListBox ItemsSource="{Binding FilteredChannels}" Style="{StaticResource GridListBoxStyle}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. SERIES VIEW -->
                    <ScrollViewer x:Name="SeriesView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Series}}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Diziler" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,24"/>
                            <ListBox ItemsSource="{Binding FilteredChannels}" Style="{StaticResource GridListBoxStyle}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 4. SEARCH VIEW -->
                    <ScrollViewer x:Name="SearchView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Search}}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Arama Sonuçları" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,24"/>
                            <ListBox ItemsSource="{Binding FilteredChannels}" Style="{StaticResource GridListBoxStyle}"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- 3. LIVE TV VIEW (Specialized for EPG) -->
                    <Grid x:Name="LiveView" Visibility="{Binding ActiveView, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static vm:AppView.Live}}">
                        <!-- EPG + Channel List specialized for Live -->
                        <TextBlock Text="Canlı TV Modu (EPG Yakında)" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Loading Indicator -->
                    <Border x:Name="LoadingOverlay" Grid.Row="0"
                            Background="#EE0B0614" CornerRadius="{StaticResource RadiusMedium}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="30" Width="60" Height="60" Margin="0,0,0,16">
                                <TextBlock Text="⏳" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Yükleniyor..." 
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==========================================
                 STATUS BAR
                 ========================================== -->
            <Border Grid.Row="2" Background="{StaticResource HeaderGradientBrush}" CornerRadius="0,0,12,12">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusPill}" 
                                Padding="14,6">
                            <TextBlock Text="{Binding FilteredChannels.Count, StringFormat='{}{0} kanal'}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
