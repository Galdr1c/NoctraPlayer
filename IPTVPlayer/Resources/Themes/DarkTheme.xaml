<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    
    <!-- ==========================================
         NOCTRA PREMIUM DARK THEME - Purple Accent
         ========================================== -->
    
    <!-- BASE COLORS (Dark) -->
    <Color x:Key="Bg0Color">#141414</Color>        <!-- Netflix exact bg -->
    <Color x:Key="Bg1Color">#1A1A1A</Color>
    <Color x:Key="Surface0Color">#2A2A2A</Color>
    <Color x:Key="Surface1Color">#333333</Color>
    <Color x:Key="BorderColor">#404040</Color>
    
    <!-- ACCENT COLORS (Purple) -->
    <Color x:Key="Accent300Color">#C4B5FD</Color>  <!-- Extra light purple (Glow) -->
    <Color x:Key="Accent500Color">#A78BFA</Color>  <!-- Light purple -->
    <Color x:Key="Accent600Color">#8B5CF6</Color>  <!-- Main purple -->
    <Color x:Key="Accent700Color">#7C3AED</Color>  <!-- Deep purple -->
    <Color x:Key="GlowColor">#C4B5FD</Color>       <!-- Light glow -->
    
    <!-- TEXT COLORS -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#E5E5E5</Color>
    <Color x:Key="TextMutedColor">#B3B3B3</Color>
    <Color x:Key="TextDisabledColor">#808080</Color>
    
    <!-- STATUS COLORS -->
    <Color x:Key="SuccessColor">#46D369</Color>
    <Color x:Key="WarningColor">#FFA00A</Color>
    <Color x:Key="ErrorColor">#E50914</Color>      <!-- Netflix red -->
    <Color x:Key="InfoColor">#54B4D3</Color>
    <Color x:Key="LiveRedColor">#E50914</Color>
    
    <!-- ==========================================
         SOLID COLOR BRUSHES
         ========================================== -->
    
    <!-- Base -->
    <SolidColorBrush po:Freeze="True" x:Key="Bg0Brush" Color="{StaticResource Bg0Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="Bg1Brush" Color="{StaticResource Bg1Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="Surface0Brush" Color="{StaticResource Surface0Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="Surface1Brush" Color="{StaticResource Surface1Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    
    <!-- Accent -->
    <SolidColorBrush po:Freeze="True" x:Key="AccentBrush" Color="{StaticResource Accent500Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="AccentHoverBrush" Color="{StaticResource Accent600Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="AccentLightBrush" Color="{StaticResource Accent300Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="GlowBrush" Color="{StaticResource GlowColor}"/>
    
    <!-- Text -->
    <SolidColorBrush po:Freeze="True" x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    
    <!-- Status -->
    <SolidColorBrush po:Freeze="True" x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="LiveRedBrush" Color="{StaticResource LiveRedColor}"/>
    
    <!-- Legacy Compatibility -->
    <SolidColorBrush po:Freeze="True" x:Key="BackgroundBrush" Color="{StaticResource Bg0Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="SurfaceBrush" Color="{StaticResource Surface0Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="SurfaceLightBrush" Color="{StaticResource Surface1Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="CardBackgroundBrush" Color="{StaticResource Surface0Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="InputBackgroundBrush" Color="{StaticResource Surface1Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="InputBorderBrush" Color="{StaticResource BorderColor}"/>
    
    <!-- ==========================================
         GRADIENT BRUSHES
         ========================================== -->
    
    <!-- Primary Accent Gradient -->
    <LinearGradientBrush po:Freeze="True" x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0.0"/>
        <GradientStop Color="#7C3AED" Offset="1.0"/>
    </LinearGradientBrush>
    
    <!-- Background Gradient (for windows) -->
    <LinearGradientBrush po:Freeze="True" x:Key="BackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Bg0Color}" Offset="0.0"/>
        <GradientStop Color="#1a0a2e" Offset="1.0"/>
    </LinearGradientBrush>
    
    <!-- Header/Footer Gradient -->
    <LinearGradientBrush po:Freeze="True" x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Bg1Color}" Offset="0.0"/>
        <GradientStop Color="#2D1B4E" Offset="1.0"/>
    </LinearGradientBrush>
    
    <!-- Glow Gradient (for hover effects) -->
    <LinearGradientBrush po:Freeze="True" x:Key="GlowGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource GlowColor}" Offset="0.0"/>
        <GradientStop Color="{StaticResource Accent500Color}" Offset="1.0"/>
    </LinearGradientBrush>
    
    <!-- Hero Overlay Gradient -->
    <LinearGradientBrush po:Freeze="True" x:Key="HeroOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="Transparent" Offset="0.0"/>
        <GradientStop Color="#99141414" Offset="0.5"/>
        <GradientStop Color="#141414" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Premium Icon Gradient (#6D28D9 → #A855F7 diagonal) -->
    <LinearGradientBrush po:Freeze="True" x:Key="IconGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Accent600Color}" Offset="0.0"/>
        <GradientStop Color="{StaticResource GlowColor}" Offset="1.0"/>
    </LinearGradientBrush>
    
    <!-- Card Hover Gradient -->
    <LinearGradientBrush po:Freeze="True" x:Key="CardHoverGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#333333" Offset="0.0"/>
        <GradientStop Color="#404040" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Premium Card Brushes -->
    <LinearGradientBrush po:Freeze="True" x:Key="PremiumCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Surface0Color}" Offset="0.0"/>
        <GradientStop Color="#1E1636" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush po:Freeze="True" x:Key="PremiumCardForegroundBrush" Color="White"/>
    
    <!-- ==========================================
         EFFECTS
         ========================================== -->
    
    <!-- Shadows -->
    <DropShadowEffect x:Key="DefaultShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.5"/>
    <DropShadowEffect x:Key="CardShadow" 
                      BlurRadius="24" 
                      ShadowDepth="8" 
                      Direction="270" 
                      Color="#000000" 
                      Opacity="0.5"/>
    <DropShadowEffect x:Key="HeroShadow" BlurRadius="40" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.6"/>
    
    <!-- Glow Effects -->
    <DropShadowEffect x:Key="AccentGlow" 
                      BlurRadius="20" 
                      ShadowDepth="0" 
                      Color="#A78BFA" 
                      Opacity="0.4"/>
    <DropShadowEffect x:Key="FocusGlow" BlurRadius="15" ShadowDepth="0" Direction="0" Color="{StaticResource Accent500Color}" Opacity="0.6"/>
    
    <!-- ==========================================
         TYPOGRAPHY
         ========================================== -->
    
    <!-- Font Family -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    
    <!-- Font Sizes -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeH1">32</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeH2">24</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeH3">20</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeBody">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeBodyLarge">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeSmall">11</sys:Double>
    
    <!-- ==========================================
         SPACING (8px Grid)
         ========================================== -->
    
    <Thickness x:Key="PagePadding">32</Thickness>
    <Thickness x:Key="SectionPadding">24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ItemPadding">12</Thickness>
    <Thickness x:Key="SmallPadding">8</Thickness>
    
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="CardGap">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="RailGap">24</sys:Double>
    
    <!-- Border Radius -->
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">24</CornerRadius>
    <CornerRadius x:Key="RadiusPill">100</CornerRadius>
    
</ResourceDictionary>
