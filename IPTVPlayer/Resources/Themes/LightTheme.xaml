<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Modern Gradient (Shared) -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#651FFF" Offset="0.0"/>
        <GradientStop Color="#7C4DFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Light Theme -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F6FA"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="#F1F2F6"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="White"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2D3436"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#636E72"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DFE6E9"/>
    
    <!-- Input Alanları -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F1F2F6"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CED6E0"/>
    
    <!-- Gölgeler -->
    <DropShadowEffect x:Key="DefaultShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.05"/>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="5" Direction="270" Color="#2D3436" Opacity="0.08"/>
</ResourceDictionary>
