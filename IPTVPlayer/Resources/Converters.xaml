<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:IPTVPlayer.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Standard Converters -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:FavoriteConverter x:Key="FavoriteConverter"/>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    <converters:ProfileColorConverter x:Key="ProfileColorConverter"/>
    
    <!-- New Converters -->
    <converters:WidthToColumnsConverter x:Key="WidthToColumnsConverter"/>
    <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
    <converters:EqualityToBoolConverter x:Key="EqualityToBoolConverter"/>
    <converters:EqualityToBrushConverter x:Key="EqualityToBrushConverter" TrueBrush="{StaticResource AccentBrush}" FalseBrush="Transparent"/>
    <converters:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter"/>
    <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <converters:AvatarPathConverter x:Key="AvatarPathConverter"/>
    <converters:EqualityToBoolMultiConverter x:Key="EqualityToBoolMultiConverter"/>
    <converters:AvatarExpressionConverter x:Key="AvatarExpressionConverter"/>
    <converters:StringContainsConverter x:Key="StringContainsConverter"/>
    <converters:BoolToPlayPauseIconConverter x:Key="BoolToPlayPauseIconConverter"/>
    <converters:StringToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
    <converters:MediaThumbnailConverter x:Key="MediaThumbnailConverter"/>
    <converters:BoolToIconConverter x:Key="BoolToIconConverter"/>
    <converters:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
    <converters:DoubleToFloatConverter x:Key="DoubleToFloatConverter"/>
    <converters:ProgressToVisibilityConverter x:Key="ProgressToVisibilityConverter"/>
    <converters:ProgressToWidthConverter x:Key="ProgressToWidthConverter"/>
    <converters:ChannelTypeToVisibilityConverter x:Key="ChannelTypeToVisibilityConverter"/>
    <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    <converters:PercentToOpacityConverter x:Key="PercentToOpacityConverter"/>

</ResourceDictionary>
