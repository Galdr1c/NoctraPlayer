<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NoctraProviderTester</AssemblyName>
    <RootNamespace>NoctraProviderTester</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    LibVLCSharp: Noctra projenizle aynı sürüm (Noctra.csproj'dan kontrol edin).
    VLC kurulu olmalı:
      Windows : https://www.videolan.org/vlc/  (64-bit)
      Linux   : sudo apt install vlc libvlc-dev
      macOS   : brew install vlc
  -->
  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.*" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.*"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="VideoLAN.LibVLC.Linux.x64" Version="3.*"
                      Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

</Project>
