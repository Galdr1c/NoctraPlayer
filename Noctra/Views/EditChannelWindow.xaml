<Window x:Class="Noctra.Views.EditChannelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Noctra.ViewModels"
        xmlns:helper="clr-namespace:Noctra.Helpers"
        mc:Ignorable="d"
        Title="Kanal Düzenle" Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundGradientBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusSmall}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="Transparent">
                <TextBlock Text="Kanal Düzenle" 
                           Foreground="{DynamicResource TextPrimaryBrush}" 
                           FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" 
                           Margin="24,0"/>
                
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8"
                        Command="{Binding CancelCommand}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource IconButtonStyle}"
                        Content="✕" FontSize="16"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    
                    <!-- Metadata Search Section -->
                    <Border Background="{DynamicResource Surface1Brush}" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Otomatik Bilgi Getir (TMDb)" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MetadataSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"
                                         Tag="Film veya Dizi adı ara..."/>
                                <Button Grid.Column="1" Command="{Binding SearchMetadataCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        Margin="8,0,0,0"
                                        Padding="16,10">
                                    <TextBlock Text="Ara" Foreground="White" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                            
                            <!-- Search Results List -->
                            <ListBox ItemsSource="{Binding SearchResults}" 
                                     Margin="0,12,0,0" MaxHeight="250"
                                     Background="Transparent" BorderThickness="0"
                                     Visibility="{Binding SearchResults.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface0Brush}" CornerRadius="4" Padding="8" Margin="0,0,0,4" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ApplyMetadataCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding PosterPath, Converter={StaticResource TmdbImageConverter}}" Stretch="Uniform" Height="60"/>
                                                <StackPanel Grid.Column="1" Margin="12,0">
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ReleaseDate}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Seç" Style="{StaticResource TextButtonStyle}" 
                                                        Command="{Binding DataContext.ApplyMetadataCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock Text="Kanal Adı" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="Grup" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding GroupTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="Kanal Türü" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <ComboBox SelectedItem="{Binding Type}" ItemsSource="{Binding ChannelTypes}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="Logo URL" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding LogoUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="EPG ID (TvgId)" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding TvgId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Surface1Brush}" Padding="16" CornerRadius="0,0,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="İptal" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Width="100"/>
                    <Button Content="Kaydet" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="100"/>
                </StackPanel>
            </Border>
            
            <!-- Loading Overlay -->
            <Grid Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" Panel.ZIndex="100">
                <Border Background="{DynamicResource Surface1Brush}" CornerRadius="8" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <!-- Simple Spinner representation -->
                        <TextBlock Text="⌛" FontSize="32" HorizontalAlignment="Center" RenderTransformOrigin="0.5, 0.5">
                             <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                            <TextBlock.RenderTransform>
                                <RotateTransform/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="İşleniyor..." Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>


