<UserControl x:Class="Noctra.Views.VideoOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Noctra.Views"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <Storyboard x:Key="ShowOverlayAnim">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.25"/>
        </Storyboard>
        <Storyboard x:Key="HideOverlayAnim">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.35"/>
        </Storyboard>

        <!-- Side Sheet Animations -->
        <Storyboard x:Key="ShowSideSheetAnim">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="360" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase Exponent="6" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        
        <!-- Add other converters if needed or rely on App.xaml -->
    </UserControl.Resources>

    <Grid Background="Transparent"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseMove="Root_MouseMove">

        <!-- ==========================================
             OVERLAY CONTENT (Visible when interacting) 
             ========================================== -->
        <Grid x:Name="OverlayRoot" IsHitTestVisible="{Binding IsVisible}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource ShowOverlayAnim}"/>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource HideOverlayAnim}"/>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- 1. Gradient Scrims (Readability Layer) -->
            <Grid IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="160"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="240"/>
                </Grid.RowDefinitions>
                
                <!-- Top Gradient -->
                <Border Grid.Row="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#CC000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                
                <!-- Bottom Gradient -->
                <Border Grid.Row="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.0"/>
                            <GradientStop Color="#88000000" Offset="0.4"/>
                            <GradientStop Color="#EE000000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- 2. Top Bar (Back, Title, Time) -->
            <Grid VerticalAlignment="Top" Margin="32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Action -->
                <Button Command="{Binding ClosePlayerCommand}" Style="{StaticResource CircleButtonStyle}" 
                        Content="&#x2190;" FontSize="20" Margin="0,0,24,0"/>

                <!-- Content Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentChannel.Name}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding OverlaySecondaryText}" FontSize="16" Foreground="#DDDDDD"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="760"
                               Visibility="{Binding OverlaySecondaryText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                </StackPanel>

                <!-- System Info (Clock/Network) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NetworkStatus}" FontSize="12" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding CurrentTimeStr}" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 3. Bottom Control Bar -->
            <Grid VerticalAlignment="Bottom" Margin="48,0,48,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Timeline -->
                    <RowDefinition Height="Auto"/> <!-- Controls -->
                </Grid.RowDefinitions>

                <!-- Timeline Slider -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="{Binding PositionText}" Foreground="#CCCCCC" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center"
                               Visibility="{Binding IsLiveContent, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                    
                    <Slider Grid.Column="1" 
                            Style="{StaticResource MediaSliderStyle}" 
                            Minimum="0" Maximum="{Binding Duration}" 
                            Value="{Binding Position}"
                            IsMoveToPointEnabled="True"
                            PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="Slider_PreviewMouseLeftButtonUp"
                            Thumb.DragStarted="Slider_DragStarted"
                            Thumb.DragCompleted="Slider_DragCompleted"
                            Visibility="{Binding IsLiveContent, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>

                    <!-- LIVE Badge for Live Streams -->
                    <!-- LIVE Badge for Live Streams -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Visibility="{Binding IsLiveContent, Converter={StaticResource BoolToVisibilityConverter}}">
                        
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#8d09e5" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <Trigger Property="IsVisible" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard x:Name="LivePulseStoryboard">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="1" To="0.4"
                                                                                     Duration="0:0:1"
                                                                                     AutoReverse="True"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="LivePulseStoryboard"/>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="CANLI" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ChannelName}" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- EPG Info -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding CurrentProgram.Title}" Foreground="#E0E0E0" FontSize="14" FontWeight="Normal" 
                                       Visibility="{Binding CurrentProgram.Title, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding CurrentProgram.TimeRange, StringFormat='{} • {0}'}" Foreground="#AAAAAA" FontSize="13" Margin="8,1,0,0" VerticalAlignment="Bottom"
                                       Visibility="{Binding CurrentProgram.Title, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                            
                    <TextBlock Grid.Column="2" Text="{Binding RemainingTime}" Foreground="#CCCCCC" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsLiveContent, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                </Grid>

                <!-- Transport Controls -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Left: Volume/Mute -->
                        <ColumnDefinition Width="*"/>    <!-- Center: Play/Pause -->
                        <ColumnDefinition Width="Auto"/> <!-- Right: Settings/Fullscreen -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Volume -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding ToggleMuteCommand}" Style="{StaticResource IconButtonStyle}" Content="&#x1F50A;" FontSize="20"/>
                        <Slider Width="100" Margin="12,0,0,0" VerticalAlignment="Center"
                                Minimum="0" Maximum="100" Value="{Binding Volume}"
                                Style="{StaticResource VolumeSliderStyle}"/>
                    </StackPanel>

                    <!-- Center: Play/Pause (Noctra style large button) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding SkipBackwardCommand}" CommandParameter="10" 
                                Style="{StaticResource IconButtonStyle}" Content="&#x23EA;" Margin="0,0,32,0"
                                Visibility="{Binding IsLiveContent, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                        
                        <Button Command="{Binding PlayPauseCommand}" 
                                Style="{StaticResource PlayPauseButtonStyle}"
                                Width="64" Height="64">
                            <TextBlock Text="{Binding IsPlaying, Converter={StaticResource BoolToPlayPauseIconConverter}}" FontSize="28"/>
                        </Button>
                        
                        <Button Command="{Binding SkipForwardCommand}" CommandParameter="10"
                                Style="{StaticResource IconButtonStyle}" Content="&#x23E9;" Margin="32,0,0,0"
                                Visibility="{Binding IsLiveContent, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                    </StackPanel>

                    <!-- Right: Options -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding OpenEpisodesCommand}" 
                                Style="{StaticResource PremiumTextButtonStyle}" Content="Bölümler" Margin="0,0,16,0"
                                Visibility="{Binding IsSeriesContent, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        
                        <Button Command="{Binding PlayNextEpisodeCommand}"
                                Style="{StaticResource PremiumTextButtonStyle}" Content="Sıradaki Bölüm" Margin="0,0,24,0"
                                Visibility="{Binding IsSeriesContent, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <Button Command="{Binding OpenInfoPanelCommand}" Style="{StaticResource IconButtonStyle}" Content="&#x2139;" Margin="0,0,16,0"/> <!-- Info -->
                        <Button Command="{Binding OpenAudioSettingsCommand}" Style="{StaticResource IconButtonStyle}" Content="&#x266B;" Margin="0,0,16,0"/> <!-- Audio/Sub -->
                        <Button Command="{Binding OpenQualitySettingsCommand}" Style="{StaticResource IconButtonStyle}" Content="&#x2699;" Margin="0,0,16,0"/> <!-- Quality -->
                        <Button Command="{Binding ToggleFullScreenCommand}" Style="{StaticResource IconButtonStyle}" Content="&#x26F6;"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 4. Side Sheets (Info) -->
            <Grid x:Name="InfoPanel" 
                  Width="400" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Background="#F20A0A0A"
                  Visibility="{Binding IsInfoPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <TranslateTransform X="400"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="32,48,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Hakkında" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                        <Border Height="1" Background="#33FFFFFF"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding OpenInfoPanelCommand}"
                            Content="&#x2715;"
                            Style="{StaticResource PremiumTextButtonStyle}"
                            Padding="12,6"
                            Height="36"
                            Margin="16,0,0,0"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,48">
                    <StackPanel>
                        <!-- Title & Year -->
                        <TextBlock Text="{Binding CurrentChannel.Name}" FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                            <Border Background="#33FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                    Visibility="{Binding CurrentChannel.ReleaseYear, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentChannel.ReleaseYear}" Foreground="White" FontSize="12"/>
                            </Border>
                            <Border Background="#E50914" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                    Visibility="{Binding CurrentChannel.Rating, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentChannel.Rating, StringFormat='★ {0:F1}'}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding DurationText}" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Current Program -->
                        <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,20"
                                Visibility="{Binding IsLiveContent, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="ŞU AN YAYINDA" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF"/>
                                <TextBlock Text="{Binding CurrentProgram.Title}" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,0"
                                           Visibility="{Binding CurrentProgram.Title, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding CurrentProgram.TimeRange}" Foreground="#A8A8A8" FontSize="12" Margin="0,4,0,0"
                                           Visibility="{Binding CurrentProgram.Title, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding CurrentProgram.Description}" Foreground="#D0D0D0" FontSize="13" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0"
                                           Visibility="{Binding CurrentProgram.Description, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Plot -->
                        <TextBlock Text="{Binding CurrentChannel.Plot}" Foreground="#DDDDDD" FontSize="14" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,24"
                                   Visibility="{Binding CurrentChannel.Plot, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                        
                        <!-- Cast & Crew -->
                        <StackPanel Visibility="{Binding CurrentChannel.Director, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <TextBlock Text="YÖNETMEN" FontSize="12" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CurrentChannel.Director}" Foreground="White" FontSize="14" Margin="0,0,0,16"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding CurrentChannel.Cast, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <TextBlock Text="OYUNCULAR" FontSize="12" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CurrentChannel.Cast}" Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 5. Side Sheets (Audio/Subtitles) - Hidden by default -->
            <Grid x:Name="AudioSettingsPanel" 
                  Width="360" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Background="#F20A0A0A"
                  Visibility="{Binding IsAudioSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <TranslateTransform X="360"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="32,48,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Ses ve Altyazı" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                        <Border Height="1" Background="#33FFFFFF"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding ClosePanelsCommand}"
                            Content="&#x2715;"
                            Style="{StaticResource PremiumTextButtonStyle}"
                            Padding="12,6"
                            Height="36"
                            Margin="16,0,0,0"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,48">
                    <StackPanel>
                        <!-- Audio Tracks -->
                        <TextBlock Text="SES" FontSize="12" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding AudioTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SetAudioTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource PremiumTextButtonStyle}"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,0,0,8"
                                            Content="{Binding Name}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Subtitle Tracks -->
                        <TextBlock Text="ALTYAZI" FontSize="12" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,24,0,16"/>
                        <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SetSubtitleTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource PremiumTextButtonStyle}"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,0,0,8"
                                            Content="{Binding Name}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Close via hitting background / ESC handled by VM -->
            </Grid>

            <!-- 5. Side Sheets (Quality) -->
            <Grid x:Name="QualitySettingsPanel" 
                  Width="360" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Background="#F20A0A0A"
                  Visibility="{Binding IsQualitySettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <TranslateTransform X="360"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="32,48,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Kalite" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                        <Border Height="1" Background="#33FFFFFF"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding ClosePanelsCommand}"
                            Content="&#x2715;"
                            Style="{StaticResource PremiumTextButtonStyle}"
                            Padding="12,6"
                            Height="36"
                            Margin="16,0,0,0"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,48">
                    <StackPanel>
                        <!-- Detected Quality -->
                        <TextBlock Text="MEVCUT KALİTE" FontSize="12" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,16"/>

                        <!-- Resolution Badge -->
                        <Border Background="#1A8d09e5" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding StreamQuality.ResolutionLabel, FallbackValue='Tespit ediliyor...'}" 
                                               FontSize="28" FontWeight="Bold" Foreground="White"/>
                                    <Border Background="#8d09e5" CornerRadius="4" Padding="8,2" Margin="12,4,0,0" VerticalAlignment="Top"
                                            Visibility="{Binding StreamQuality.QualityTier, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                        <TextBlock Text="{Binding StreamQuality.QualityTier}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding StreamQuality.DetailLabel, FallbackValue=''}" 
                                           FontSize="13" Foreground="#AAAAAA"
                                           Visibility="{Binding IsLiveContent, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding StreamQuality.VideoCodec, FallbackValue=''}" 
                                           FontSize="13" Foreground="#AAAAAA"
                                           Visibility="{Binding IsLiveContent, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                            </StackPanel>
                        </Border>

                        <!-- Video Info -->
                        <TextBlock Text="VİDEO" FontSize="12" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Çözünürlük" Foreground="#88FFFFFF" FontSize="13" Margin="0,0,16,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Foreground="White" FontSize="13" Margin="0,0,0,6">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}x{1}">
                                        <Binding Path="StreamQuality.Width" FallbackValue="-"/>
                                        <Binding Path="StreamQuality.Height" FallbackValue=""/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="FPS" Foreground="#88FFFFFF" FontSize="13" Margin="0,0,16,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StreamQuality.Fps, StringFormat='{}{0} fps', FallbackValue='-'}" Foreground="White" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Codec" Foreground="#88FFFFFF" FontSize="13" Margin="0,0,16,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StreamQuality.VideoCodec, FallbackValue='-'}" Foreground="White" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Bit Rate" Foreground="#88FFFFFF" FontSize="13" Margin="0,0,16,6"
                                       Visibility="{Binding IsLiveContent, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StreamQuality.VideoBitrate, Converter={StaticResource BitrateDisplayConverter}}" Foreground="White" FontSize="13"
                                       Visibility="{Binding IsLiveContent, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>

                        <!-- Audio Info -->
                        <TextBlock Text="SES" FontSize="12" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,16,0,12"/>
                        <Border Background="#0DFFFFFF" CornerRadius="8" Padding="16,12">
                            <TextBlock Text="{Binding StreamQuality.AudioDetailLabel, FallbackValue='Tespit ediliyor...'}" 
                                       FontSize="14" Foreground="White"/>
                        </Border>

                        <!-- Playback Speed (Only for VOD/Series) -->
                        <StackPanel Visibility="{Binding IsLiveContent, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <TextBlock Text="OYNATMA HIZI" FontSize="12" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,24,0,16"/>
                            <UniformGrid Columns="3">
                                <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.5}"
                                        Style="{StaticResource PremiumTextButtonStyle}" Content="0.5x" HorizontalContentAlignment="Center" Margin="0,0,4,8"/>
                                <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=0.75}"
                                        Style="{StaticResource PremiumTextButtonStyle}" Content="0.75x" HorizontalContentAlignment="Center" Margin="4,0,4,8"/>
                                <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.0}"
                                        Style="{StaticResource PremiumTextButtonStyle}" Content="Normal" HorizontalContentAlignment="Center" Margin="4,0,0,8"/>
                                <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.25}"
                                        Style="{StaticResource PremiumTextButtonStyle}" Content="1.25x" HorizontalContentAlignment="Center" Margin="0,0,4,0"/>
                                <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=1.5}"
                                        Style="{StaticResource PremiumTextButtonStyle}" Content="1.5x" HorizontalContentAlignment="Center" Margin="4,0,4,0"/>
                                <Button Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{Binding Converter={StaticResource DoubleToFloatConverter}, ConverterParameter=2.0}"
                                        Style="{StaticResource PremiumTextButtonStyle}" Content="2.0x" HorizontalContentAlignment="Center" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 6. Zapping / Mini Info Overlay (Appears when changing channels) -->
            <Grid VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="48,0,0,160"
                  Visibility="{Binding IsZappingVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#F20A0A0A" CornerRadius="16" Padding="24,20" BorderBrush="#22FFFFFF" BorderThickness="1"
                        MinWidth="400">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Orientation="Horizontal">
                            <Border Width="72" Height="72" Background="#1AFFFFFF" CornerRadius="12" Margin="0,0,20,0">
                                <Image Source="{Binding ChannelLogo}" Stretch="Uniform" Margin="10"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ChannelName}" FontSize="28" FontWeight="Bold" Foreground="White"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="15" Foreground="#FF999999"/>
                                    <TextBlock Text=" • " Foreground="#44FFFFFF" Margin="8,0"/>
                                    <TextBlock Text="{Binding StreamInfo}" FontSize="15" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Buffering Progress -->
                        <Grid Grid.Row="1" Margin="0,20,0,0">
                            <ProgressBar Value="{Binding BufferingProgress}" Height="4" 
                                         Background="#1AFFFFFF" Foreground="#8D09E5" 
                                         BorderThickness="0"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            
        </Grid>
        
        <!-- 6. Volume Toast Indicator -->
        <Border x:Name="VolumeToast"
                Background="#DD000000"
                CornerRadius="12"
                Padding="32,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Panel.ZIndex="1000"
                Opacity="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVolumeToastVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.8" To="1.0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.5" EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.8" To="1.0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.5" EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform>
                <ScaleTransform CenterX="60" CenterY="60"/>
            </Border.RenderTransform>
            <StackPanel>
                <TextBlock Text="SES" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding Volume, StringFormat='{}{0}%'}" 
                           FontSize="28" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 5. Ephemeral UI (Always visible/floating) -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBuffering}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ProgressBar Style="{StaticResource CircularProgressStyle}" Foreground="#8D09E5" Width="60" Height="60"/>
            <TextBlock Text="Yükleniyor..." Foreground="White" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>

    </Grid>
</UserControl>



