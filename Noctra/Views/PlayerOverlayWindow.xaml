<Window x:Class="Noctra.Views.PlayerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Noctra.Views"
        Title="PlayerOverlayWindow"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False">
    <Grid Background="Transparent">
        <views:VideoOverlayView x:Name="OverlayViewControl"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
    </Grid>
</Window>
