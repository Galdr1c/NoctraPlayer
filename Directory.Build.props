<Project>
  <PropertyGroup>
    <NoctraVersionPrefix Condition="'$(NoctraVersionPrefix)' == ''">1.0.0</NoctraVersionPrefix>
    <NoctraPackageVersion Condition="'$(NoctraPackageVersion)' == ''">1.0.0.0</NoctraPackageVersion>
    <NoctraPublisherDisplayName Condition="'$(NoctraPublisherDisplayName)' == ''">Noctra</NoctraPublisherDisplayName>
    <NoctraAppDisplayName Condition="'$(NoctraAppDisplayName)' == ''">Noctra</NoctraAppDisplayName>
    <NoctraAuthors Condition="'$(NoctraAuthors)' == ''">Noctra</NoctraAuthors>
    <NoctraCompany Condition="'$(NoctraCompany)' == ''">Noctra</NoctraCompany>
    <NoctraEdition Condition="'$(NoctraEdition)' == ''">Free</NoctraEdition>
    <NoctraEditionDisplayName Condition="'$(NoctraEditionDisplayName)' == ''">Noctra</NoctraEditionDisplayName>
    <NoctraPremiumStoreProductId Condition="'$(NoctraPremiumStoreProductId)' == ''">9PLACEHOLDERID</NoctraPremiumStoreProductId>
    <NoctraPremiumStoreLaunchUri Condition="'$(NoctraPremiumStoreLaunchUri)' == ''">ms-windows-store://pdp/?productid=$(NoctraPremiumStoreProductId)</NoctraPremiumStoreLaunchUri>
    <NoctraPremiumStoreWebUri Condition="'$(NoctraPremiumStoreWebUri)' == ''">https://apps.microsoft.com/detail/$(NoctraPremiumStoreProductId)</NoctraPremiumStoreWebUri>
  </PropertyGroup>
</Project>
