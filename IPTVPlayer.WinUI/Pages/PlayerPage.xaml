<Page
    x:Class="IPTVPlayer.WinUI.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IPTVPlayer.WinUI.Controls">

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Video Player -->
        <controls:FFmpegVideoPlayer x:Name="VideoPlayer" Grid.Row="0"/>
        
        <!-- Statistics Overlay (Debug) -->
        <controls:PlayerStatistics x:Name="Statistics" 
                                    Grid.Row="0"
                                    Visibility="Collapsed"/>
        
        <!-- Subtitle Overlay -->
        <Border Grid.Row="0"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Background="#AA000000"
                CornerRadius="4"
                Padding="16,8"
                Margin="0,0,0,80"
                Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}">
            <TextBlock x:Name="SubtitleText"
                       Foreground="White"
                       FontSize="18"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="800"/>
        </Border>

        <!-- Controls -->
        <Grid Grid.Row="1" Background="#DD000000" Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Progress Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="CurrentTimeText" 
                           Foreground="White" 
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                
                <Slider x:Name="ProgressSlider"
                        Grid.Column="1"
                        ValueChanged="ProgressSlider_ValueChanged"
                        PointerPressed="ProgressSlider_PointerPressed"
                        PointerReleased="ProgressSlider_PointerReleased"/>
                
                <TextBlock x:Name="DurationText" 
                           Grid.Column="2"
                           Foreground="White" 
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>

            <!-- Control Buttons -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Playback Controls -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="PlayPauseButton" 
                            Click="PlayPauseButton_Click"
                            Width="44" Height="44"
                            CornerRadius="22"
                            Background="#7C3AED">
                        <SymbolIcon Symbol="Play"/>
                    </Button>
                    
                    <Button x:Name="StopButton" 
                            Click="StopButton_Click"
                            Width="40" Height="40">
                        <SymbolIcon Symbol="Stop"/>
                    </Button>
                    
                    <Button Click="SkipBackward_Click" Width="40" Height="40">
                        <FontIcon Glyph="&#xE100;" FontSize="16"/>
                    </Button>
                    
                    <Button Click="SkipForward_Click" Width="40" Height="40">
                        <FontIcon Glyph="&#xE101;" FontSize="16"/>
                    </Button>
                </StackPanel>

                <!-- Track Selection -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            Spacing="10"
                            HorizontalAlignment="Center">
                    
                    <ComboBox x:Name="AudioTrackComboBox"
                              PlaceholderText="Audio Track"
                              SelectionChanged="AudioTrackComboBox_SelectionChanged"
                              MinWidth="150"/>
                    
                    <ComboBox x:Name="SubtitleTrackComboBox"
                              PlaceholderText="Subtitles"
                              SelectionChanged="SubtitleTrackComboBox_SelectionChanged"
                              MinWidth="150"/>
                    
                    <ToggleButton x:Name="StatsToggle"
                                  Click="StatsToggle_Click"
                                  Width="40" Height="40"
                                  ToolTipService.ToolTip="Show Statistics">
                        <FontIcon Glyph="&#xE9D9;" FontSize="16"/>
                    </ToggleButton>
                </StackPanel>

                <!-- Volume & Fullscreen -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            Spacing="10">
                    <Button x:Name="MuteButton"
                            Click="MuteButton_Click"
                            Width="40" Height="40">
                        <SymbolIcon x:Name="VolumeIcon" Symbol="Volume"/>
                    </Button>
                    
                    <Slider x:Name="VolumeSlider"
                            Width="100"
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                    
                    <Button Click="FullscreenButton_Click"
                            Width="40" Height="40">
                        <SymbolIcon Symbol="FullScreen"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
