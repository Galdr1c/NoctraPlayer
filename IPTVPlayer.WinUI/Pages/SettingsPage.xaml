<Page
    x:Class="IPTVPlayer.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="20" Spacing="10">
        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>
        
        <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,10,0,0"/>
        <ToggleSwitch Header="Dark Theme" IsOn="True" />
        
        <TextBlock Text="Premium" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,10,0,0"/>
        <TextBlock x:Name="PremiumStatus" Text="Status: Free" Foreground="Gray"/>
        <Button Content="Buy Premium Lifetime" />
    </StackPanel>
</Page>
