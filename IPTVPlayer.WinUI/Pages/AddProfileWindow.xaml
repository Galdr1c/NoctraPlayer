<Window x:Class="IPTVPlayer.Views.AddProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:IPTVPlayer.ViewModels;assembly=IPTVPlayer.Core"
        xmlns:converters="clr-namespace:IPTVPlayer.Converters"
        xmlns:helper="clr-namespace:IPTVPlayer.Helpers"
        mc:Ignorable="d"
        Title="Profil Ayarları" Height="750" Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource Bg0Brush}" 
        FontFamily="Segoe UI">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:ProfileColorConverter x:Key="ProfileColorConverter"/>
            <converters:AvatarExpressionConverter x:Key="AvatarExpressionConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:ErrorColorConverter x:Key="ErrorColorConverter"/>
            <converters:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter"/>
            <converters:AvatarPathConverter x:Key="AvatarPathConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,40">
            <TextBlock x:Name="TitleText" FontSize="56" FontWeight="Medium" Foreground="White" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Profil Ekle"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EditingProfile, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                <Setter Property="Text" Value="Profili Düzenle"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="IPTV Player izleyen başka bir kişi için profil ekleyin." FontSize="18" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,30,0,0" Width="800"/>
        </StackPanel>

        <!-- Main Content (Horizontal Split: Avatar | Info) -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Avatar -->
                <ColumnDefinition Width="500"/> <!-- Info Stack -->
            </Grid.ColumnDefinitions>

            <!-- Avatar Column -->
            <Button Style="{StaticResource ImageButtonStyle}" Command="{Binding OpenAvatarPickerCommand}" 
                    Cursor="Hand" VerticalAlignment="Top" Margin="0,0,50,0"
                    Background="Transparent" BorderThickness="0">
                <Border Width="180" Height="180" CornerRadius="{StaticResource RadiusMedium}" UseLayoutRounding="True">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,180,180" RadiusX="14" RadiusY="14"/>
                    </Border.Clip>
                    <Grid>
                        <!-- Background -->
                        <Border Background="{Binding SelectedAvatar, Converter={StaticResource ProfileColorConverter}, FallbackValue='#E50914'}" 
                                CornerRadius="{StaticResource RadiusMedium}"/>
                                
                        <Image Source="{Binding SelectedAvatar, Converter={StaticResource AvatarPathConverter}}" 
                               Stretch="UniformToFill" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border Background="#CC000000" Width="44" Height="44" 
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                CornerRadius="22" Margin="10">
                            <TextBlock Text="✎" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Margin="0,0,0,2"/>
                        </Border>
                    </Grid>
                </Border>
            </Button>

            <!-- Info Column -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <!-- Profile Name -->
                <TextBlock Text="Profil Adı" Foreground="#AAAAAA" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold"/>
                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" 
                         Height="52"
                         helper:TextBoxHelper.Watermark="İsim girin"/>
                
                <Separator Height="1" Background="#333" Margin="0,32"/>
                
                <!-- Provider Account -->
                <TextBlock Text="Hesap Ayarları" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                
                <StackPanel Margin="0,0,0,24">
                    <CheckBox Content="Mevcut bir hesabı kullan" 
                              IsChecked="{Binding IsNewAccount, Converter={StaticResource InverseBoolConverter}}"
                              Style="{StaticResource NetflixCheckBox}"
                              Visibility="{Binding ExistingAccounts.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                    
                    <Grid Margin="0,12,0,0" Visibility="{Binding IsNewAccount, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Invert'}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ExistingAccounts}" 
                                  SelectedItem="{Binding SelectedAccount}"
                                  Style="{StaticResource ModernComboBox}"
                                  Height="52">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Margin="12,0,0,0" Padding="12"
                                Command="{Binding ToggleEditAccountCommand}" 
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="✎" FontSize="20" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Connection Details -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsNewAccount}" Value="False"/>
                                        <Condition Binding="{Binding IsEditingAccount}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Sunucu URL / M3U Link" Foreground="#AAAAAA" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" 
                             Height="52" Margin="0,0,0,20"
                             helper:TextBoxHelper.Watermark="Sunucu adresi veya M3U URL"/>
                    
                    <Grid Margin="0,0,0,20" Visibility="{Binding IsXtream, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Kullanıcı Adı" Foreground="#AAAAAA" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" Height="52"
                                     helper:TextBoxHelper.Watermark="Kullanıcı"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Şifre" Foreground="#AAAAAA" FontSize="14" Margin="4,0,0,8" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" Height="52"
                                     helper:TextBoxHelper.Watermark="Şifre"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton GroupName="ProfileType" Content="Xtream Codes" IsChecked="{Binding IsXtream}" 
                                     Style="{StaticResource TabRadioButtonStyle}" Margin="0,0,12,0" Padding="20,10"/>
                        <RadioButton GroupName="ProfileType" Content="M3U Playlist" IsChecked="{Binding IsM3U}" 
                                     Style="{StaticResource TabRadioButtonStyle}" Padding="20,10"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="{Binding HasError, Converter={StaticResource ErrorColorConverter}}" 
                       FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,20"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="PROFİLİ SİL" 
                        Command="{Binding DeleteProfileCommand}"
                        Visibility="{Binding EditingProfile, Converter={StaticResource NullToVisibilityConverter}}"
                        Background="Transparent" BorderBrush="#333" BorderThickness="1" Foreground="#666"
                        Padding="25,0" Height="52" Cursor="Hand" Margin="0,0,80,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PlainButton}">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="26"/></Style>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#E50914"/>
                                    <Setter Property="BorderBrush" Value="#E50914"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="KAYDET" Command="{Binding SaveCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" Width="160" Height="56" FontSize="16" FontWeight="Bold"/>
                <Button Content="İPTAL" Click="CancelButton_Click" 
                        Style="{StaticResource SecondaryButton}" Width="140" Height="56" FontSize="16" FontWeight="Bold" Margin="20,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
