<UserControl
    x:Class="IPTVPlayer.WinUI.Controls.PlayerStatistics"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Border Background="#AA000000" 
            CornerRadius="8"
            Padding="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="12">
        
        <StackPanel Spacing="4">
            <TextBlock Foreground="White" FontSize="12" FontWeight="Bold">
                Player Statistics
            </TextBlock>
            
            <TextBlock x:Name="FpsText" Foreground="#90EE90" FontSize="11"/>
            <TextBlock x:Name="DroppedText" Foreground="#FFB6C1" FontSize="11"/>
            <TextBlock x:Name="BufferText" Foreground="#87CEEB" FontSize="11"/>
            <TextBlock x:Name="ResolutionText" Foreground="#F0E68C" FontSize="11"/>
            <TextBlock x:Name="BitrateText" Foreground="#DDA0DD" FontSize="11"/>
        </StackPanel>
    </Border>
</UserControl>
