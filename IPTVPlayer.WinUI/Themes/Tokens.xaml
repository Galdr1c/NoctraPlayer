<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Tokens -->
    <Color x:Key="BrandPurpleColor">#6200EA</Color>
    <Color x:Key="BrandNebulaColor">#311B92</Color>
    
    <SolidColorBrush x:Key="BrandPurpleBrush" Color="{StaticResource BrandPurpleColor}"/>
    <SolidColorBrush x:Key="BrandNebulaBrush" Color="{StaticResource BrandNebulaColor}"/>
    
    <!-- Typography Tokens -->
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    
    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="Gray"/>
    </Style>
</ResourceDictionary>
