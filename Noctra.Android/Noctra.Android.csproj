<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>28</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>studio.kynora.noctra</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers Condition="'$(Configuration)' == 'Debug'">android-arm64;android-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">android-arm64</RuntimeIdentifier>
    <AndroidPackageFormat Condition="'$(Configuration)' == 'Debug'">apk</AndroidPackageFormat>
    <AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormat>
    <AndroidEnableAssemblyCompression Condition="'$(Configuration)' == 'Debug'">false</AndroidEnableAssemblyCompression>
    <AndroidStoreUncompressedFileExtensions Condition="'$(Configuration)' == 'Debug'">.so;$(AndroidStoreUncompressedFileExtensions)</AndroidStoreUncompressedFileExtensions>
    <EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Debug'">true</EmbedAssembliesIntoApk>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>

    <!--
      AdMob production identifiers. Defaults are the production values; override
      any of them per-build with -p:NoctraAdMobAppId=... (or the unit IDs) when
      building a test/QA flavor. The App ID is injected into AndroidManifest.xml
      through AndroidManifestPlaceholders and the ad-unit IDs are embedded as
      AssemblyMetadata for the Android advertising provider.

      NoctraAdMobTestDeviceIds lists the AdMob test-device hashed IDs (from
      logcat). Test devices receive TEST ads from the real unit IDs so real
      (non-emulator) serving still pays out and the emulator/dev machine sees
      working ads in every build configuration. Semicolon-separated.

      NoctraAdMobDebugGeography optionally forces UMP's debug geography for the
      listed test devices ONLY (EEA to see the consent form on a non-EEA
      device). Leave empty for production-correct behavior.
    -->
    <NoctraAdMobAppId Condition="'$(NoctraAdMobAppId)' == ''">ca-app-pub-4557682582400970~9852101527</NoctraAdMobAppId>
    <NoctraBannerAdUnitId Condition="'$(NoctraBannerAdUnitId)' == ''">ca-app-pub-4557682582400970/5775345477</NoctraBannerAdUnitId>
    <NoctraInterstitialAdUnitId Condition="'$(NoctraInterstitialAdUnitId)' == ''">ca-app-pub-4557682582400970/6102598203</NoctraInterstitialAdUnitId>
    <NoctraAdMobTestDeviceIds Condition="'$(NoctraAdMobTestDeviceIds)' == ''">B3EEABB8EE11C2BE770B684D95219ECB</NoctraAdMobTestDeviceIds>
    <NoctraAdMobDebugGeography Condition="'$(NoctraAdMobDebugGeography)' == ''"></NoctraAdMobDebugGeography>
    <AndroidManifestPlaceholders>$(AndroidManifestPlaceholders);noctraAdMobAppId=$(NoctraAdMobAppId)</AndroidManifestPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Noctra.AdMob.AppId" Value="$(NoctraAdMobAppId)" />
    <AssemblyMetadata Include="Noctra.AdMob.BannerAdUnitId" Value="$(NoctraBannerAdUnitId)" />
    <AssemblyMetadata Include="Noctra.AdMob.InterstitialAdUnitId" Value="$(NoctraInterstitialAdUnitId)" />
    <AssemblyMetadata Include="Noctra.AdMob.TestDeviceIds" Value="$(NoctraAdMobTestDeviceIds)" />
    <AssemblyMetadata Include="Noctra.AdMob.DebugGeography" Value="$(NoctraAdMobDebugGeography)" Condition="'$(NoctraAdMobDebugGeography)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Remove="Resources\PlayStore_Assets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <JavaLibrary Include="libs\ffmpeg\ffmpeg-extension.jar" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" PrivateAssets="All" Publish="True" />
    <PackageReference Include="HotAvalonia" Version="3.*" PrivateAssets="All" Publish="True" />
  </ItemGroup>

  <!--
    Geliştirme (.env) dosyası yalnızca DEBUG APK'larına paketlenir; uygulama
    açılışında (Application.OnCreate) yalnızca NOCTRA_* endpoint değişkenleri
    süreç ortamına aktarılır (bkz. Application.cs). Masaüstünde .env runtime'da
    çalışma dizininden okunur; Android'de dosya sistemi olmadığı için asset
    olarak gömülür. Release'de URL'ler build-time AssemblyMetadata ile gömülür,
    bu yüzden bu asset yalnızca DEBUG içindir.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug' and Exists('$(MSBuildThisFileDirectory)..\.env')">
    <AndroidAsset Include="..\.env" Link="env/noctra-dev.env" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <HotAvalonia>true</HotAvalonia>
    <HotAvaloniaAutoEnable>true</HotAvaloniaAutoEnable>
    <HotAvaloniaRemote>true</HotAvaloniaRemote>
    <HotAvaloniaMode>Balanced</HotAvaloniaMode>
    <HotAvaloniaTimeout>5000</HotAvaloniaTimeout>
    <HotAvaloniaInitialPatching>enable</HotAvaloniaInitialPatching>
    <HarfsAddress>127.0.0.1</HarfsAddress>
    <HarfsPort>20158</HarfsPort>
    <HarfsSecret>NoctraSecret123!</HarfsSecret>
    <HarfsExitOnDisconnect>false</HarfsExitOnDisconnect>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
    <PackageReference Include="Xamarin.Google.Android.Play.Review" Version="2.0.2.8" />
    <PackageReference Include="Xamarin.Google.Android.Play.App.Update" Version="2.1.0.19" />
    <PackageReference Include="Xamarin.Android.Google.BillingClient" Version="9.1.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.4.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Hls" Version="1.4.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Dash" Version="1.4.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.SmoothStreaming" Version="1.4.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Rtsp" Version="1.4.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Session" Version="1.4.1.1" />
    <PackageReference Include="Xamarin.GooglePlayServices.Ads" Version="125.4.0.2" />
    <PackageReference Include="Xamarin.Google.UserMessagingPlatform" Version="4.0.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noctra.Mobile\Noctra.Mobile.csproj" />
    <ProjectReference Include="..\Noctra.Core\Noctra.Core.csproj" />
  </ItemGroup>
</Project>
