<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>28</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>studio.kynora.noctra</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers Condition="'$(Configuration)' == 'Debug'">android-arm64;android-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">android-arm64</RuntimeIdentifier>
    <AndroidPackageFormat Condition="'$(Configuration)' == 'Debug'">apk</AndroidPackageFormat>
    <AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormat>
    <AndroidEnableAssemblyCompression Condition="'$(Configuration)' == 'Debug'">false</AndroidEnableAssemblyCompression>
    <AndroidStoreUncompressedFileExtensions Condition="'$(Configuration)' == 'Debug'">.so;$(AndroidStoreUncompressedFileExtensions)</AndroidStoreUncompressedFileExtensions>
    <EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Debug'">true</EmbedAssembliesIntoApk>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Remove="Resources\PlayStore_Assets\**\*" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" PrivateAssets="All" Publish="True" />
    <PackageReference Include="HotAvalonia" Version="3.*" PrivateAssets="All" Publish="True" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <HotAvalonia>true</HotAvalonia>
    <HotAvaloniaAutoEnable>true</HotAvaloniaAutoEnable>
    <HotAvaloniaRemote>true</HotAvaloniaRemote>
    <HotAvaloniaMode>Balanced</HotAvaloniaMode>
    <HotAvaloniaTimeout>5000</HotAvaloniaTimeout>
    <HotAvaloniaInitialPatching>enable</HotAvaloniaInitialPatching>
    <HarfsAddress>127.0.0.1</HarfsAddress>
    <HarfsPort>20158</HarfsPort>
    <HarfsSecret>NoctraSecret123!</HarfsSecret>
    <HarfsExitOnDisconnect>false</HarfsExitOnDisconnect>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
    <PackageReference Include="Xamarin.Google.Android.Play.Review" Version="2.0.2.8" />
    <PackageReference Include="Xamarin.Google.Android.Play.App.Update" Version="2.1.0.19" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.4.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Hls" Version="1.4.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Dash" Version="1.4.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.SmoothStreaming" Version="1.4.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Rtsp" Version="1.4.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Session" Version="1.4.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noctra.Mobile\Noctra.Mobile.csproj" />
    <ProjectReference Include="..\Noctra.Core\Noctra.Core.csproj" />
  </ItemGroup>
</Project>
