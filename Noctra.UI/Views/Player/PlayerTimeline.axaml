<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             x:Class="Noctra.UI.Views.Player.PlayerTimeline"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False"
             Focusable="True"
             FocusAdorner="{x:Null}"
             AutomationProperties.Name="{Binding TimelineAccessibilityName}">
  <UserControl.Styles>
    <Style Selector="UserControl:focus-visible Border#FocusRing">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource FocusGlow}" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="RootGrid" Height="40" Background="Transparent" ClipToBounds="False">
    <Border x:Name="FocusRing" Margin="1" CornerRadius="8" BorderBrush="Transparent" BorderThickness="2" IsHitTestVisible="False" />
    <Grid x:Name="TrackGrid" Height="4" Margin="7,0" VerticalAlignment="Center">
      <Border CornerRadius="2" Background="{DynamicResource PlayerOverlaySecondaryTextBrush}" Opacity="0.24" />
      <Border x:Name="BufferBar" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.35" IsVisible="False" />
      <Border x:Name="FillBar" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
    </Grid>
    <Ellipse x:Name="Thumb" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" IsVisible="{Binding !IsLiveContent}" />
  </Grid>
</UserControl>
