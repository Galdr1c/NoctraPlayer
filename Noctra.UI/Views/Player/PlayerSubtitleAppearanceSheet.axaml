<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.UI.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:player="using:Noctra.UI.Views.Player"
             x:Class="Noctra.UI.Views.Player.PlayerSubtitleAppearanceSheet"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="Button.SelectionSheetOption">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource PlayerOverlaySheetBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1.5" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.SelectionSheetOption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlayerOverlaySheetHoverBrush}" />
    </Style>
    <Style Selector="Button.SelectionSheetOption:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlayerOverlaySheetPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <TextBlock Grid.Column="1"
                 Text="{loc:Translate Player.Settings.SubtitleAppearance}"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource PlayerOverlaySheetTextBrush}"
                 VerticalAlignment="Center" />
      <Button Grid.Column="2"
              Command="{Binding BackFromPlayerPanelCommand}"
              Width="40" Height="40" Padding="0"
              Background="Transparent" BorderThickness="0">
        <icons:MaterialIcon Kind="Close" Width="22" Height="22"
                            Foreground="{DynamicResource PlayerOverlaySheetMutedTextBrush}" />
      </Button>
    </Grid>

    <ScrollViewer MaxHeight="{DynamicResource SheetMaxHeight}">
      <StackPanel Spacing="12">
        <StackPanel Spacing="8">
          <TextBlock Text="{loc:Translate Player.Settings.SubtitleAppearance.Preview}"
                     FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource PlayerOverlaySheetSecondaryTextBrush}"
                     LetterSpacing="1" />
          <Border MinHeight="150" MaxHeight="270" ClipToBounds="True">
            <Grid>
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#2A2640" />
                    <GradientStop Offset="0.48" Color="#363252" />
                    <GradientStop Offset="1" Color="#1E1636" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Ellipse Width="180" Height="180"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,-70,-45,0" Fill="#26FFFFFF" />
              <player:SubtitlePreviewOverlay
                  Text="{loc:Translate Player.Settings.SubtitleAppearance.Sample}"
                  FontSize="{Binding EffectiveSubtitleFontSize}"
                  BackgroundOpacity="{Binding SubtitleBackgroundOpacity}"
                  Position="{Binding SubtitlePosition}" />
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="{loc:Translate Player.Settings.SubtitleSize}"
                     FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource PlayerOverlaySheetSecondaryTextBrush}"
                     LetterSpacing="1" />
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Button Classes="SelectionSheetOption" Command="{Binding SetSubtitleSizeCommand}" CommandParameter="Small">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="Small" /><Binding Path="SubtitleTextSize" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Translate Player.Settings.SubtitleSize.Small}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="20" Height="20" Margin="4,0" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="Small" /><Binding Path="SubtitleTextSize" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
            <Button Grid.Column="1" Classes="SelectionSheetOption" Command="{Binding SetSubtitleSizeCommand}" CommandParameter="Medium">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="Medium" /><Binding Path="SubtitleTextSize" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Translate Player.Settings.SubtitleSize.Normal}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="20" Height="20" Margin="4,0" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="Medium" /><Binding Path="SubtitleTextSize" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
            <Button Grid.Column="2" Classes="SelectionSheetOption" Command="{Binding SetSubtitleSizeCommand}" CommandParameter="Large">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="Large" /><Binding Path="SubtitleTextSize" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Translate Player.Settings.SubtitleSize.Large}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="20" Height="20" Margin="4,0" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="Large" /><Binding Path="SubtitleTextSize" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
            <Button Grid.Column="3" Classes="SelectionSheetOption" Command="{Binding SetSubtitleSizeCommand}" CommandParameter="ExtraLarge">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="ExtraLarge" /><Binding Path="SubtitleTextSize" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Translate Player.Settings.SubtitleSize.ExtraLarge}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="20" Height="20" Margin="4,0" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="ExtraLarge" /><Binding Path="SubtitleTextSize" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
          </Grid>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="{loc:Translate Player.Settings.SubtitleBackground}"
                     FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource PlayerOverlaySheetSecondaryTextBrush}"
                     LetterSpacing="1" />
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Button Classes="SelectionSheetOption" Command="{Binding SetSubtitleBackgroundCommand}" CommandParameter="0">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="0" /><Binding Path="SubtitleBackgroundOpacity" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Translate Player.Settings.SubtitleBackground.Off}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="20" Height="20" Margin="4,0" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="0" /><Binding Path="SubtitleBackgroundOpacity" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
            <Button Grid.Column="1" Classes="SelectionSheetOption" Command="{Binding SetSubtitleBackgroundCommand}" CommandParameter="30">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="30" /><Binding Path="SubtitleBackgroundOpacity" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Translate Player.Settings.SubtitleBackground.Light}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="20" Height="20" Margin="4,0" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="30" /><Binding Path="SubtitleBackgroundOpacity" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
            <Button Grid.Column="2" Classes="SelectionSheetOption" Command="{Binding SetSubtitleBackgroundCommand}" CommandParameter="60">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="60" /><Binding Path="SubtitleBackgroundOpacity" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Translate Player.Settings.SubtitleBackground.Medium}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="20" Height="20" Margin="4,0" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="60" /><Binding Path="SubtitleBackgroundOpacity" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
            <Button Grid.Column="3" Classes="SelectionSheetOption" Command="{Binding SetSubtitleBackgroundCommand}" CommandParameter="85">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="85" /><Binding Path="SubtitleBackgroundOpacity" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Translate Player.Settings.SubtitleBackground.Dark}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="20" Height="20" Margin="4,0" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="85" /><Binding Path="SubtitleBackgroundOpacity" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
          </Grid>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="{loc:Translate Player.Settings.SubtitlePosition}"
                     FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource PlayerOverlaySheetSecondaryTextBrush}"
                     LetterSpacing="1" />
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <Button Classes="SelectionSheetOption" Command="{Binding SetSubtitlePositionCommand}" CommandParameter="Bottom">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="Bottom" /><Binding Path="SubtitlePosition" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Translate Player.Settings.SubtitlePosition.Bottom}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="20" Height="20" Margin="4,0" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="Bottom" /><Binding Path="SubtitlePosition" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
            <Button Grid.Column="1" Classes="SelectionSheetOption" Command="{Binding SetSubtitlePositionCommand}" CommandParameter="LowerMiddle">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="LowerMiddle" /><Binding Path="SubtitlePosition" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Translate Player.Settings.SubtitlePosition.LowerMiddle}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="20" Height="20" Margin="4,0" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="LowerMiddle" /><Binding Path="SubtitlePosition" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
            <Button Grid.Row="1" Classes="SelectionSheetOption" Command="{Binding SetSubtitlePositionCommand}" CommandParameter="UpperMiddle">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="UpperMiddle" /><Binding Path="SubtitlePosition" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Translate Player.Settings.SubtitlePosition.UpperMiddle}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="20" Height="20" Margin="4,0" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="UpperMiddle" /><Binding Path="SubtitlePosition" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
            <Button Grid.Row="1" Grid.Column="1" Classes="SelectionSheetOption" Command="{Binding SetSubtitlePositionCommand}" CommandParameter="Top">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="Top" /><Binding Path="SubtitlePosition" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Translate Player.Settings.SubtitlePosition.Top}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="20" Height="20" Margin="4,0" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Source="Top" /><Binding Path="SubtitlePosition" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
          </Grid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </StackPanel>
</UserControl>
