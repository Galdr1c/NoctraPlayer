<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.UI.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.UI.Views.Player.PlayerQualitySheet"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="Button.selectionSheetOption">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource PlayerOverlaySheetBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1.5" /><Setter Property="Padding" Value="8,4" /><Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="6" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.selectionSheetOption:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PlayerOverlaySheetHoverBrush}" /></Style>
    <Style Selector="Button.selectionSheetOption:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PlayerOverlaySheetPressedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  </UserControl.Styles>
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{loc:Translate Player.Quality.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Command="{Binding BackFromPlayerPanelCommand}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0"><icons:MaterialIcon Kind="Close" Width="22" Height="22" Foreground="{DynamicResource PlayerOverlaySheetMutedTextBrush}" /></Button>
    </Grid>
    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
      <StackPanel Spacing="2"><TextBlock Text="{loc:Translate Player.Quality.Resolution}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PlayerOverlaySheetSecondaryTextBrush}" /><TextBlock Text="{Binding QualityResolutionText}" FontSize="16" LetterSpacing="2.5" Foreground="{DynamicResource AccentBrush}" /></StackPanel>
      <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{loc:Translate Player.Quality.Fps}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PlayerOverlaySheetSecondaryTextBrush}" /><TextBlock Text="{Binding QualityFpsText}" FontSize="16" LetterSpacing="2.5" Foreground="{DynamicResource AccentBrush}" /></StackPanel>
      <StackPanel Grid.Row="1" Spacing="2"><TextBlock Text="{loc:Translate Player.Quality.Codec}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PlayerOverlaySheetSecondaryTextBrush}" /><TextBlock Text="{Binding QualityVideoCodecText}" FontSize="16" LetterSpacing="2.5" Foreground="{DynamicResource AccentBrush}" /></StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2"><TextBlock Text="{loc:Translate Player.Quality.Bitrate}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PlayerOverlaySheetSecondaryTextBrush}" /><TextBlock Text="{Binding QualityVideoBitrateText}" FontSize="16" LetterSpacing="2.5" Foreground="{DynamicResource AccentBrush}" /></StackPanel>
    </Grid>
    <TextBlock Text="{loc:Translate Player.Mobile.Speed}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PlayerOverlaySheetSecondaryTextBrush}" />
    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
      <Button Classes="selectionSheetOption" Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{x:Static vm:PlayerViewModel.PlaybackRateHalf}" Content="0.5x" HorizontalContentAlignment="Center" />
      <Button Grid.Column="1" Classes="selectionSheetOption" Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{x:Static vm:PlayerViewModel.PlaybackRateThreeQuarters}" Content="0.75x" HorizontalContentAlignment="Center" />
      <Button Grid.Column="2" Classes="selectionSheetOption" Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{x:Static vm:PlayerViewModel.PlaybackRateNormal}" Content="1.0x" HorizontalContentAlignment="Center" />
      <Button Grid.Row="1" Classes="selectionSheetOption" Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{x:Static vm:PlayerViewModel.PlaybackRateOneAndQuarter}" Content="1.25x" HorizontalContentAlignment="Center" />
      <Button Grid.Row="1" Grid.Column="1" Classes="selectionSheetOption" Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{x:Static vm:PlayerViewModel.PlaybackRateOneAndHalf}" Content="1.5x" HorizontalContentAlignment="Center" />
      <Button Grid.Row="1" Grid.Column="2" Classes="selectionSheetOption" Command="{Binding SetPlaybackSpeedCommand}" CommandParameter="{x:Static vm:PlayerViewModel.PlaybackRateDouble}" Content="2.0x" HorizontalContentAlignment="Center" />
    </Grid>
  </StackPanel>
</UserControl>
