<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.UI.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.UI.Views.Player.PlayerTrackSheet"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="Button.selectionSheetOption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource PlayerOverlaySheetBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1.5" />
      <Setter Property="Padding" Value="16,4,48,4" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.selectionSheetOption:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayerOverlaySheetPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.selectionSheetOption:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayerOverlaySheetPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{loc:Translate Player.Mobile.AudioSubtitles}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Command="{Binding BackFromPlayerPanelCommand}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0">
        <icons:MaterialIcon Kind="Close" Width="22" Height="22" Foreground="{DynamicResource PlayerOverlaySheetMutedTextBrush}" />
      </Button>
    </Grid>
    <Button Classes="selectionSheetOption" Command="{Binding OpenSubtitleAppearanceSettingsCommand}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsHitTestVisible="False">
        <TextBlock Text="{loc:Translate Player.Settings.SubtitleAppearance}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" FontSize="{DynamicResource FBodyL}" VerticalAlignment="Center" />
        <icons:MaterialIcon Grid.Column="1" Kind="ChevronRight" Width="22" Height="22" Foreground="{DynamicResource PlayerOverlaySheetMutedTextBrush}" />
      </Grid>
    </Button>
    <StackPanel Spacing="8">
      <TextBlock Text="{loc:Translate Player.Settings.Audio}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PlayerOverlaySheetSecondaryTextBrush}" LetterSpacing="1" />
      <ItemsControl ItemsSource="{Binding AudioTracks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Classes="selectionSheetOption" Command="{Binding $parent[ItemsControl].DataContext.SetAudioTrackCommand}" CommandParameter="{Binding Id}">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Path="Id" /><Binding Path="$parent[ItemsControl].DataContext.SelectedAudioTrack" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" FontSize="{DynamicResource FBodyL}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Path="Id" /><Binding Path="$parent[ItemsControl].DataContext.SelectedAudioTrack" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <StackPanel Spacing="8">
      <TextBlock Text="{loc:Translate Player.Settings.Subtitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PlayerOverlaySheetSecondaryTextBrush}" LetterSpacing="1" />
      <ItemsControl ItemsSource="{Binding SubtitleTracks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Classes="selectionSheetOption" Command="{Binding $parent[ItemsControl].DataContext.SetSubtitleTrackCommand}" CommandParameter="{Binding Id}">
              <Grid IsHitTestVisible="False">
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8">
                  <Border.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Path="Id" /><Binding Path="$parent[ItemsControl].DataContext.SelectedSubtitleTrack" /></MultiBinding></Border.IsVisible>
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PlayerOverlaySheetTextBrush}" FontSize="{DynamicResource FBodyL}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="RadioboxMarked" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}">
                    <icons:MaterialIcon.IsVisible><MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}"><Binding Path="Id" /><Binding Path="$parent[ItemsControl].DataContext.SelectedSubtitleTrack" /></MultiBinding></icons:MaterialIcon.IsVisible>
                  </icons:MaterialIcon>
                </Grid>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
