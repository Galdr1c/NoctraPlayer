<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Noctra.UI.Views.Player.SubtitlePreviewOverlay"
             x:CompileBindings="False">
  <Grid x:Name="LayoutGrid" RowDefinitions="*,*,*,*">
    <Border x:Name="SubtitleBorder"
            HorizontalAlignment="Center"
            MaxWidth="280"
            Padding="14,8"
            CornerRadius="8"
            IsHitTestVisible="False">
      <TextBlock x:Name="SubtitleText"
                 Foreground="White"
                 FontWeight="SemiBold"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
