<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.UI.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:player="using:Noctra.UI.Views.Player"
             x:Class="Noctra.UI.Views.Player.PlayerTransportBar"
             x:Name="Root"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="False">
  <UserControl.Resources>
    <!-- Match PlayerTimeline's 4px rail and 8px accent thumb, while retaining
         Slider's native keyboard, automation and drag behavior. -->
    <ControlTheme x:Key="PlayerVolumeSliderTheme" TargetType="Slider">
      <Setter Property="Height" Value="40" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="Transparent">
            <Border x:Name="VolumeFocusRing" Margin="1" CornerRadius="8"
                    BorderBrush="Transparent" BorderThickness="2" IsHitTestVisible="False" />
            <Border Height="4" Margin="8,0" CornerRadius="2"
                    VerticalAlignment="Center" IsHitTestVisible="False"
                    Background="{DynamicResource PlayerOverlaySecondaryTextBrush}" Opacity="0.24" />
            <Track x:Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                   Orientation="Horizontal">
              <Track.DecreaseButton>
                <RepeatButton Focusable="False" Background="Transparent" ClipToBounds="False"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <RepeatButton.Template>
                    <ControlTemplate>
                      <Grid Background="Transparent">
                        <Border Height="4" Margin="8,0,-8,0" CornerRadius="2"
                                VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" />
                      </Grid>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Focusable="False" Background="Transparent"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <RepeatButton.Template>
                    <ControlTemplate>
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseButton>
              <Thumb x:Name="PART_Thumb" Width="16" Height="40">
                <Thumb.Template>
                  <ControlTemplate>
                    <Grid Background="Transparent">
                      <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:focus-visible /template/ Border#VolumeFocusRing">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource FocusGlow}" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.playerTransport, Button.playerAction">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.playerTransport:pointerover /template/ ContentPresenter, Button.playerAction:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlayerIconHoverBrush}" />
    </Style>
    <Style Selector="Button.playerTransport:pressed, Button.playerAction:pressed">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.playerTransport:focus-visible /template/ ContentPresenter, Button.playerAction:focus-visible /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlayerIconHoverBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource FocusGlow}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto"
        Margin="16,0,16,14"
        IsVisible="{Binding IsBottomControlsVisible}">
    <StackPanel Grid.Row="0" Spacing="2" Margin="12,4">
      <TextBlock Text="{Binding CurrentChannel.Name}"
                 Foreground="{DynamicResource PlayerOverlayTextBrush}"
                 FontSize="16" FontWeight="Bold"
                 TextTrimming="CharacterEllipsis" MaxLines="1" />
      <TextBlock Text="{Binding OverlaySecondaryText}"
                 Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                 FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" Opacity="0.85" />
    </StackPanel>

    <player:PlayerTimeline Grid.Row="1" />

    <Grid x:Name="VodTimingRow" Grid.Row="2" Margin="12,0" ColumnDefinitions="*,Auto" IsVisible="{Binding !IsLiveContent}">
      <TextBlock Text="{Binding DisplayedPositionText}" FontSize="14" FontWeight="SemiBold"
                 Foreground="{DynamicResource PlayerOverlayTextBrush}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="14"
                 Foreground="{DynamicResource PlayerOverlaySecondaryTextBrush}"
                 VerticalAlignment="Center" Opacity="0.70" />
    </Grid>

    <Grid Grid.Row="3" Height="56" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
      <Button Classes="playerTransport" Command="{Binding SkipBackwardCommand}" CommandParameter="10"
              IsVisible="{Binding !IsLiveContent}" AutomationProperties.Name="{loc:Translate Player.Overlay.Backward}">
        <icons:MaterialIcon Kind="Rewind10" Width="24" Height="24" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
      </Button>
      <Button Classes="playerTransport" Command="{Binding PlayPreviousLiveChannelCommand}"
              IsVisible="{Binding IsLiveContent}" AutomationProperties.Name="{loc:Translate Player.Overlay.PreviousChannel}">
        <icons:MaterialIcon Kind="SkipPrevious" Width="24" Height="24" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
      </Button>

      <Button x:Name="PlayPauseButton" Grid.Column="1" Classes="playerTransport"
              Command="{Binding PlayPauseCommand}" AutomationProperties.Name="{Binding PlayPauseAccessibilityName}">
        <Panel Width="28" Height="28">
          <icons:MaterialIcon Kind="Play" Width="28" Height="28" Foreground="{DynamicResource PlayerOverlayTextBrush}"
                              IsVisible="{Binding IsPlaying, Converter={StaticResource InverseBoolConverter}}" />
          <icons:MaterialIcon Kind="Pause" Width="28" Height="28" Foreground="{DynamicResource PlayerOverlayTextBrush}"
                              IsVisible="{Binding IsPlaying}" />
        </Panel>
      </Button>

      <Button Grid.Column="2" Classes="playerTransport" Command="{Binding SkipForwardCommand}" CommandParameter="10"
              IsVisible="{Binding !IsLiveContent}" AutomationProperties.Name="{loc:Translate Player.Overlay.Forward}">
        <icons:MaterialIcon Kind="FastForward10" Width="24" Height="24" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
      </Button>
      <Button Grid.Column="2" Classes="playerTransport" Command="{Binding PlayNextLiveChannelCommand}"
              IsVisible="{Binding IsLiveContent}" AutomationProperties.Name="{loc:Translate Player.Overlay.NextChannel}">
        <icons:MaterialIcon Kind="SkipNext" Width="24" Height="24" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
      </Button>

      <!-- Mobile keeps the single mute action. Desktop opts into the pointer-volume
           reveal through ShowPointerVolumeControl on PlayerChromeView. -->
      <Grid x:Name="VolumeCluster"
            Grid.Column="3"
            ColumnDefinitions="Auto,Auto"
            PointerEntered="VolumeCluster_PointerEntered"
            PointerExited="VolumeCluster_PointerExited"
            GotFocus="VolumeCluster_GotFocus"
            LostFocus="VolumeCluster_LostFocus"
            PointerWheelChanged="VolumeCluster_PointerWheelChanged">
        <Button x:Name="MuteButton"
                Grid.Column="0"
                Classes="playerTransport"
                Command="{Binding ToggleMuteCommand}"
                AutomationProperties.Name="{Binding MuteAccessibilityName}">
          <Panel Width="24" Height="24">
            <icons:MaterialIcon Kind="VolumeOff" Width="24" Height="24"
                                Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                IsVisible="{Binding IsMuted}" />
            <icons:MaterialIcon Kind="VolumeHigh" Width="24" Height="24"
                                Foreground="{DynamicResource PlayerOverlayTextBrush}"
                                IsVisible="{Binding IsMuted, Converter={StaticResource InverseBoolConverter}}" />
          </Panel>
        </Button>

        <Border x:Name="PointerVolumeReveal"
                Grid.Column="1"
                Width="0"
                Height="40"
                Opacity="0"
                IsHitTestVisible="False"
                ClipToBounds="True"
                VerticalAlignment="Center"
                Margin="2,0,0,0"
                Padding="10,0"
                Background="Transparent">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
              <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
            </Transitions>
          </Border.Transitions>
          <Slider x:Name="PointerVolumeSlider"
                  Theme="{StaticResource PlayerVolumeSliderTheme}"
                  Width="112"
                  Minimum="0"
                  Maximum="100"
                  SmallChange="1"
                  LargeChange="5"
                  Value="{Binding Volume, Mode=TwoWay}"
                  VerticalAlignment="Center" />
        </Border>
      </Grid>

      <Button Grid.Column="5" Classes="playerAction" IsVisible="{Binding IsLiveContent}"
              Command="{Binding ToggleEpgPanelCommand}" ToolTip.Tip="{loc:Translate Player.Epg.GuideTooltip}"
              AutomationProperties.Name="{loc:Translate Player.Epg.GuideTooltip}">
        <icons:MaterialIcon Kind="CalendarClock" Width="24" Height="24" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
      </Button>

      <Button x:Name="TuneActionButton" Grid.Column="6" Classes="playerAction"
              Command="{Binding OpenActionsPanelCommand}" ToolTip.Tip="{loc:Translate Mobile.Nav.More}"
              AutomationProperties.Name="{loc:Translate Mobile.Nav.More}">
        <icons:MaterialIcon Kind="Tune" Width="24" Height="24" Foreground="{DynamicResource PlayerOverlayTextBrush}" />
      </Button>
    </Grid>
  </Grid>
</UserControl>
