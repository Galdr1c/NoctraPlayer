<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.UI.Localization"
             xmlns:views="using:Noctra.UI.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.UI.Views.AdaptiveSettingsOverviewView"
             x:Name="Root"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="False">
  <Grid Background="{DynamicResource Bg0Brush}">
    <ScrollViewer x:Name="SettingsScrollViewer"
                  BringIntoViewOnFocusChange="True"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="LayoutRoot"
                  Margin="24,18,24,28"
                  Spacing="20"
                  MaxWidth="880"
                  HorizontalAlignment="Stretch">
        <TextBlock Text="{loc:Translate Settings.Title}"
                   FontSize="{DynamicResource FDisplaySmall}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <views:SettingsCommonSectionsView x:Name="CommonSections" />

        <Border Classes="SettingsSectionCard">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:MaterialIcon Kind="BrushVariant" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{loc:Translate GlobalSettings.Appearance.Title}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="{DynamicResource FTitleL}"
                         FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{loc:Translate GlobalSettings.Theme.Description}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="{DynamicResource FCaption}"
                       TextWrapping="Wrap" />
            <views:SettingsThemePickerView />
          </StackPanel>
        </Border>

        <Border Classes="SettingsSectionCard">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:MaterialIcon Kind="PlayBoxOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{loc:Translate Settings.Nav.Playback}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="{DynamicResource FTitleL}"
                         FontWeight="SemiBold" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{loc:Translate Settings.Playback.AutoPlayNext}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="Medium" />
                <TextBlock Text="{loc:Translate Settings.Playback.AutoPlayDescription}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource FCaption}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding AutoPlayNext, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <ContentControl Content="{Binding PlatformContent, ElementName=Root}"
                        HorizontalContentAlignment="Stretch"
                        IsVisible="{Binding HasPlatformContent, ElementName=Root}" />

        <Button Classes="SettingsActionButton"
                Click="AdvancedSettings_Click"
                IsVisible="{Binding ShowAdvancedSettingsAction, ElementName=Root}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <icons:MaterialIcon Kind="CogOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{loc:Translate Settings.Title}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontWeight="SemiBold" />
              <TextBlock Text="{loc:Translate Mobile.Nav.More}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="{DynamicResource FCaption}" />
            </StackPanel>
            <icons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource TextMutedBrush}" />
          </Grid>
        </Button>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
