<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.UI.Localization"
             xmlns:views="using:Noctra.UI.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.UI.Views.AdaptiveSettingsOverviewView"
             x:Name="Root"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="False">
  <Grid Background="{DynamicResource Bg0Brush}">
    <ScrollViewer x:Name="SettingsScrollViewer"
                  BringIntoViewOnFocusChange="True"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="LayoutRoot"
                  Margin="24,18,24,28"
                  Spacing="20"
                  MaxWidth="880"
                  HorizontalAlignment="Stretch">
        <TextBlock Text="{loc:Translate Settings.Title}"
                   FontSize="{DynamicResource FDisplaySmall}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <!-- Canonical cross-platform settings content. Mobile owns the visual language. -->
        <views:SettingsCommonSectionsView x:Name="CommonSections" />

        <!-- Platform-only settings stay outside the shared canonical sections. -->
        <ContentControl Content="{Binding PlatformContent, ElementName=Root}"
                        HorizontalContentAlignment="Stretch"
                        IsVisible="{Binding HasPlatformContent, ElementName=Root}" />

        <!-- Temporary bridge until every legacy desktop settings section is migrated. -->
        <Button Classes="SettingsActionButton"
                Click="AdvancedSettings_Click"
                IsVisible="{Binding ShowAdvancedSettingsAction, ElementName=Root}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <icons:MaterialIcon Kind="CogOutline"
                                Width="20" Height="20"
                                Foreground="{DynamicResource AccentBrush}" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{loc:Translate Settings.Title}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontWeight="SemiBold" />
              <TextBlock Text="{loc:Translate Mobile.Nav.More}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="{DynamicResource FCaption}" />
            </StackPanel>
            <icons:MaterialIcon Grid.Column="2" Kind="ChevronRight"
                                Width="20" Height="20"
                                Foreground="{DynamicResource TextMutedBrush}" />
          </Grid>
        </Button>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
