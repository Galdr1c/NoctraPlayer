<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noctra.ViewModels;assembly=Noctra.Core"
             xmlns:loc="using:Noctra.UI.Localization"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Noctra.UI.Views.SettingsCommonSectionsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="False">
  <StackPanel Spacing="20">
    <!-- These sections are structurally identical on mobile and desktop. -->
    <Border Classes="SettingsSectionCard">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <Border Width="64" Height="64" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}">
          <icons:MaterialIcon Kind="AccountBoxOutline" Width="34" Height="34"
                              Foreground="{DynamicResource AccentBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
          <TextBlock Text="{loc:Translate Settings.Profile.ActiveProfile}"
                     Foreground="{DynamicResource AccentBrush}"
                     FontSize="{DynamicResource FTitleM}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CurrentProfileName}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="{DynamicResource FBodyL}" FontWeight="Bold"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="SettingsSectionCard">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <icons:MaterialIcon Kind="AccountSwitchOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{loc:Translate Settings.Profile.Management}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="{DynamicResource FTitleL}" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock Text="{loc:Translate Settings.Profile.ManagementDetail}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="{DynamicResource FCaption}" TextWrapping="Wrap" />
        <Button Classes="SettingsActionButton" Click="BackToProfiles_Click">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <icons:MaterialIcon Kind="AccountSwitchOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Grid.Column="1" Text="{loc:Translate Settings.Profile.BackToProfiles}"
                       Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <icons:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource TextMutedBrush}" />
          </Grid>
        </Button>
      </StackPanel>
    </Border>

    <Border Classes="SettingsSectionCard">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <icons:MaterialIcon Kind="AccountBoxOutline" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{loc:Translate Settings.Account.Title}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="{DynamicResource FTitleL}" FontWeight="SemiBold" />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <TextBlock Text="{Binding ProviderUrlLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FCaption}" />
          <TextBlock Grid.Column="1" Text="{Binding ProviderUrl}" Foreground="{DynamicResource TextPrimaryBrush}"
                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding ShowProviderIdentity}">
          <TextBlock Text="{Binding ProviderIdentityLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FCaption}" />
          <TextBlock Grid.Column="1" Text="{Binding ProviderUsername}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding ShowProviderPassword}">
          <TextBlock Text="{loc:Translate Settings.Account.Password}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FCaption}" />
          <TextBlock Grid.Column="1" Text="{Binding ProviderPassword}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Grid>
        <StackPanel Spacing="3" IsVisible="{Binding ShowProviderExpiration}">
          <TextBlock Text="{loc:Translate Settings.Account.Expiry}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FCaption}" />
          <TextBlock Text="{Binding ExpirationDate}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ExpirationStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="{DynamicResource FCaption}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
