<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        
  <Style Selector="Border.SettingsSectionCard">
    <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="{DynamicResource DefaultShadow}" />
  </Style>

  <Style Selector="Border.SettingsStatusBadge">
    <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <Style Selector="Border.CategoryRow">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

  <Style Selector="Button.SettingsActionButton">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.SettingsActionButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource InteractivePressedBrush}" />
  </Style>

  <Style Selector="Button.SettingsSelectionButton">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.SortIconButton">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.SortIconButton:pressed">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.SettingsPrimaryActionButton">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.SettingsPrimaryActionButton:pressed /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.80" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.UpgradeButton">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Margin" Value="0,0,0,16"/>
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource PremiumBadgeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PremiumBadgeTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.UpgradeButton:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.95" />
    <Setter Property="Background" Value="{DynamicResource PremiumBadgeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PremiumBadgeTextBrush}" />
  </Style>
  <Style Selector="Button.UpgradeButton:pressed /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.80" />
    <Setter Property="Background" Value="{DynamicResource PremiumBadgeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PremiumBadgeTextBrush}" />
  </Style>

  <!-- Aylık / Kalıcı plan seçim kartları (MobileUpsellView) -->
  <Style Selector="Button.PlanCardButton">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource PremiumBadgeBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.PlanCardButton:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource PremiumBadgeBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
  </Style>
  <Style Selector="Button.PlanCardButton:pressed /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource PremiumBadgeBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
</Styles>
